000170r 2  20           
000171r 2               
000171r 2               ; --- Level -> reagent probability band (SPEC 5.3) ----------------------------
000171r 2               ;   Indexed by (level - 1), clamped to 15. Bands are 1-3, 4-6, 7-9, 10-12, 13+.
000171r 2               LevelBand:
000171r 2  00 00 00 01    .byte 0, 0, 0, 1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 4
000175r 2  01 01 02 02  
000179r 2  02 03 03 03  
000181r 2               
000181r 2               ; --- Chance a piece carries a reagent, out of 256 (SPEC 5.3) -----------------
000181r 2               ;   Indexed by band.                        15%  22%  27%  32%  36%
000181r 2               PSpecial:
000181r 2  26 38 45 52    .byte  38,  56,  69,  82,  92
000185r 2  5C           
000186r 2               
000186r 2               ; --- Reagent type, cumulative thresholds out of 256 (SPEC 5.3) ---------------
000186r 2               ;   Four thresholds per band; a roll at or above the last one is a Prism.
000186r 2               ;       roll <  [0] -> Fireball
000186r 2               ;       roll <  [1] -> Bolt
000186r 2               ;       roll <  [2] -> Bomb
000186r 2               ;       roll <  [3] -> Star
000186r 2               ;       else        -> Prism
000186r 2               ReagentThresholds:
000186r 2  4D 8A C3 EC    .byte  77, 138, 195, 236             ; band 0   levels  1-3
00018Ar 2  4D 8D C0 EE    .byte  77, 141, 192, 238             ; band 1   levels  4-6
00018Er 2  52 92 C5 EE    .byte  82, 146, 197, 238             ; band 2   levels  7-9
000192r 2  4F 8D C3 EE    .byte  79, 141, 195, 238             ; band 3   levels 10-12
000196r 2  4F 8F C7 F0    .byte  79, 143, 199, 240             ; band 4   levels 13+
00019Ar 2               
00019Ar 2               ; --- Reagent trigger bonuses, indexed by glyph (SPEC 9.5) --------------------
00019Ar 2               ;   Glyph 0 potion and 4 star award nothing here (the star multiplies instead).
00019Ar 2               TriggerBonusLo:
00019Ar 2  00 00 00 00    .byte $00, $00, $00, $00, $00, $00, $00, $00
00019Er 2  00 00 00 00  
0001A2r 2               TriggerBonusHi:
0001A2r 2  00 05 03 03    .byte $00, $05, $03, $03, $00, $00, $00, $00
0001A6r 2  00 00 00 00  
0001AAr 2               
0001AAr 2               ; --- The twelve sound effects (SPEC 16) --------------------------------------
0001AAr 2               ;   An effect is a list of STEPS and a step is three bytes: how many FRAMES it
0001AAr 2               ;   lasts, its TIMBRE, and its NOTE in semitones above C3 (constants.inc). A
0001AAr 2               ;   zero frame count ends the list. Nothing here is a register value: a note
0001AAr 2               ;   means the same pitch on both sound chips and each platform turns it into
0001AAr 2               ;   whatever its own hardware wants (audio.asm, hal.inc).
0001AAr 2               ;
0001AAr 2               ;   SPEC 16 gives each effect a CHARACTER and not a tune — "short blip",
0001AAr 2               ;   "dull thunk", "descending noise sweep" — and the notes below are the
0001AAr 2               ;   reading of it. What is not a choice is the range: the VIC-I's oscillator
0001AAr 2               ;   value runs out of resolution above C5, where consecutive semitones start
0001AAr 2               ;   landing on the same number, so everything melodic is WRITTEN inside C3-C5
0001AAr 2               ;   and lifted by its timbre instead. TIMBRE_BRIGHT is already an octave up.
0001AAr 2               ;
0001AAr 2               ;   SfxStepIdx is a byte offset into SfxSteps, so this table has to stay under
0001AAr 2               ;   256 bytes. It is 171 — 144 for SPEC 16's twelve, and 27 for the three at
0001AAr 2               ;   the bottom that belong to the title screen's ambience rather than to the
0001AAr 2               ;   game (constants.inc, ambience.asm).
0001AAr 2               
0001AAr 2               SfxOffsets:                             ; Indexed by (SFX_* id - 1)
0001AAr 2  00             .byte SfxMove     - SfxSteps
0001ABr 2  04             .byte SfxRotate   - SfxSteps
0001ACr 2  0B             .byte SfxLock     - SfxSteps
0001ADr 2  12             .byte SfxMatch    - SfxSteps
0001AEr 2  19             .byte SfxFireball - SfxSteps
0001AFr 2  29             .byte SfxBolt     - SfxSteps
0001B0r 2  2D             .byte SfxBomb     - SfxSteps
0001B1r 2  34             .byte SfxStar     - SfxSteps
0001B2r 2  41             .byte SfxPrism    - SfxSteps
0001B3r 2  54             .byte SfxLevelUp  - SfxSteps
0001B4r 2  61             .byte SfxHighScore- SfxSteps
0001B5r 2  77             .byte SfxGameOver - SfxSteps
0001B6r 2  90             .byte SfxBubble   - SfxSteps          ; 13-15 are the title screen's, and are
0001B7r 2  9A             .byte SfxGloop    - SfxSteps          ;   not events — see the ambience at the
0001B8r 2  A1             .byte SfxSeethe   - SfxSteps          ;   bottom of this file
0001B9r 2               
0001B9r 2               SfxSteps:
0001B9r 2               
0001B9r 2               SfxMove:                                ; 1 — short blip                2 frames
0001B9r 2  02 03 13       .byte  2, TIMBRE_BRIGHT, OCT_4 + SEMI_G
0001BCr 2  00             .byte  0
0001BDr 2               
0001BDr 2               SfxRotate:                              ; 2 — rising two-step           6 frames
0001BDr 2  03 03 0C       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_C
0001C0r 2  03 03 13       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_G
0001C3r 2  00             .byte  0
0001C4r 2               
0001C4r 2               SfxLock:                                ; 3 — dull thunk                6 frames
0001C4r 2  02 04 0C       .byte  2, TIMBRE_NOISE,  OCT_4 + SEMI_C
0001C7r 2  04 01 0C       .byte  4, TIMBRE_SOFT,   OCT_4 + SEMI_C
0001CAr 2  00             .byte  0
0001CBr 2               
0001CBr 2               SfxMatch:                               ; 4 — bright chime              9 frames
0001CBr 2  03 03 0C       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_C   ; ...and the whole thing is
0001CEr 2  06 03 10       .byte  6, TIMBRE_BRIGHT, OCT_4 + SEMI_E   ;   transposed up by the chain
0001D1r 2  00             .byte  0                                  ;   (SPEC 16, audio.asm)
0001D2r 2               
0001D2r 2               SfxFireball:                            ; 5 — descending noise sweep   10 frames
0001D2r 2  02 04 24       .byte  2, TIMBRE_NOISE,  OCT_6 + SEMI_C
0001D5r 2  02 04 1F       .byte  2, TIMBRE_NOISE,  OCT_5 + SEMI_G
0001D8r 2  02 04 1A       .byte  2, TIMBRE_NOISE,  OCT_5 + SEMI_D
0001DBr 2  02 04 15       .byte  2, TIMBRE_NOISE,  OCT_4 + SEMI_A
0001DEr 2  02 04 10       .byte  2, TIMBRE_NOISE,  OCT_4 + SEMI_E
0001E1r 2  00             .byte  0
0001E2r 2               
0001E2r 2               SfxBolt:                                ; 6 — fast noise crack          3 frames
0001E2r 2  03 04 21       .byte  3, TIMBRE_NOISE,  OCT_5 + SEMI_A
0001E5r 2  00             .byte  0
0001E6r 2               
0001E6r 2               SfxBomb:                                ; 7 — low noise thump          10 frames
0001E6r 2  02 04 0E       .byte  2, TIMBRE_NOISE,  OCT_4 + SEMI_D
0001E9r 2  08 04 04       .byte  8, TIMBRE_NOISE,  OCT_3 + SEMI_E
0001ECr 2  00             .byte  0
0001EDr 2               
0001EDr 2               SfxStar:                                ; 8 — sparkle arpeggio          8 frames
0001EDr 2  02 03 0C       .byte  2, TIMBRE_BRIGHT, OCT_4 + SEMI_C
0001F0r 2  02 03 10       .byte  2, TIMBRE_BRIGHT, OCT_4 + SEMI_E
0001F3r 2  02 03 13       .byte  2, TIMBRE_BRIGHT, OCT_4 + SEMI_G
0001F6r 2  02 03 18       .byte  2, TIMBRE_BRIGHT, OCT_5 + SEMI_C
0001F9r 2  00             .byte  0
0001FAr 2               
0001FAr 2               SfxPrism:                               ; 9 — shimmer                  12 frames
0001FAr 2  02 02 18       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_C   ; The one effect that wants an edge
0001FDr 2  02 02 1C       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_E   ;   to it rather than a bell: a
000200r 2  02 02 18       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_C   ;   sawtooth beating between two
000203r 2  02 02 1C       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_E   ;   notes six times in a fifth of
000206r 2  02 02 18       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_C   ;   a second
000209r 2  02 02 1C       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_E
00020Cr 2  00             .byte  0
00020Dr 2               
00020Dr 2               SfxLevelUp:                             ; 10 — fanfare                 25 frames
00020Dr 2  05 03 0C       .byte  5, TIMBRE_BRIGHT, OCT_4 + SEMI_C
000210r 2  05 03 10       .byte  5, TIMBRE_BRIGHT, OCT_4 + SEMI_E
000213r 2  05 03 13       .byte  5, TIMBRE_BRIGHT, OCT_4 + SEMI_G
000216r 2  0A 03 18       .byte 10, TIMBRE_BRIGHT, OCT_5 + SEMI_C
000219r 2  00             .byte  0
00021Ar 2               
00021Ar 2               SfxHighScore:                           ; 11 — longer fanfare          40 frames
00021Ar 2  04 03 0C       .byte  4, TIMBRE_BRIGHT, OCT_4 + SEMI_C
00021Dr 2  04 03 10       .byte  4, TIMBRE_BRIGHT, OCT_4 + SEMI_E
000220r 2  04 03 13       .byte  4, TIMBRE_BRIGHT, OCT_4 + SEMI_G
000223r 2  04 03 18       .byte  4, TIMBRE_BRIGHT, OCT_5 + SEMI_C
000226r 2  04 03 13       .byte  4, TIMBRE_BRIGHT, OCT_4 + SEMI_G
000229r 2  04 03 18       .byte  4, TIMBRE_BRIGHT, OCT_5 + SEMI_C
00022Cr 2  10 03 1C       .byte 16, TIMBRE_BRIGHT, OCT_5 + SEMI_E
00022Fr 2  00             .byte  0
000230r 2               
000230r 2               SfxGameOver:                            ; 12 — descending minor run    58 frames
000230r 2  06 01 15       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_A
000233r 2  06 01 13       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_G
000236r 2  06 01 11       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_F
000239r 2  06 01 10       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_E
00023Cr 2  06 01 0E       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_D
00023Fr 2  06 01 0C       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_C
000242r 2  06 01 0B       .byte  6, TIMBRE_SOFT,   OCT_3 + SEMI_B
000245r 2  10 01 09       .byte 16, TIMBRE_SOFT,   OCT_3 + SEMI_A
000248r 2  00             .byte  0
000249r 2               
000249r 2               ; --- The cauldron (constants.inc) --------------------------------------------
000249r 2               ;   Three more step lists, in the same table and read by the same driver, and
000249r 2               ;   the only things about them that are not effects are that no event asks for
000249r 2               ;   one and that the ambience pitches each one up by a random 0-7 semitones
000249r 2               ;   before it plays. That transposition is what turns three lists into a boil:
000249r 2               ;   a bubble is a bubble whatever size it is, and a cauldron of one size sounds
000249r 2               ;   like a machine.
000249r 2               ;
000249r 2               ;   All three are TIMBRE_SOFT or TIMBRE_NOISE and all three are written in the
000249r 2               ;   bottom octave and a half, because everything up here has to sit UNDER the
000249r 2               ;   title screen rather than on top of it. Nothing bright bubbles.
000249r 2               
000249r 2               SfxBubble:                              ; 13 — a bloop, rising      8 frames
000249r 2  03 01 0C       .byte  3, TIMBRE_SOFT,   OCT_4 + SEMI_C   ; TIMBRE_SOFT sounds an octave
00024Cr 2  03 01 13       .byte  3, TIMBRE_SOFT,   OCT_4 + SEMI_G   ;   below what is written, so this
00024Fr 2  02 01 18       .byte  2, TIMBRE_SOFT,   OCT_5 + SEMI_C   ;   is C3 to C4 (constants.inc)
000252r 2  00             .byte  0
000253r 2               
000253r 2               SfxGloop:                               ; 14 — a heavier one, falling  6 frames
000253r 2  02 01 13       .byte  2, TIMBRE_SOFT,   OCT_4 + SEMI_G
000256r 2  04 01 0C       .byte  4, TIMBRE_SOFT,   OCT_4 + SEMI_C
000259r 2  00             .byte  0
00025Ar 2               
00025Ar 2               SfxSeethe:                              ; 15 — the churn under both    9 frames
00025Ar 2  03 04 07       .byte  3, TIMBRE_NOISE,  OCT_3 + SEMI_G   ; Low noise, dropping: the sound a
00025Dr 2  04 04 00       .byte  4, TIMBRE_NOISE,  OCT_3 + SEMI_C   ;   pot makes between bubbles
000260r 2  02 00 00       .byte  2, TIMBRE_OFF,    0                ; A REST, and a legal step — the
000263r 2  00             .byte  0                                  ;   driver hands TIMBRE_OFF to the
000264r 2                                                           ;   platform like any other timbre
000264r 2                                                           ;   and gets silence for a beat,
000264r 2                                                           ;   which keeps the churn from
000264r 2                                                           ;   running straight into whatever
000264r 2                                                           ;   the next roll deals
000264r 2               
000264r 2               ; --- The mix (ambience.asm) --------------------------------------------------
000264r 2               ;   Rolled once per sound, indexed by a random nibble, so the shape of the
000264r 2               ;   ambience is this table and nothing else: eleven bubbles of one kind or
000264r 2               ;   another to five borrowed effects, which is roughly one thing happening in
000264r 2               ;   the lab for every three the cauldron does. Change the balance by changing
000264r 2               ;   the entries — there is no other knob and no code to edit.
000264r 2               ;
000264r 2               ;   The five borrowed ones are the game's own sounds (SPEC 16), played half
000264r 2               ;   volume and out of context: the prism's shimmer and the star's arpeggio read
000264r 2               ;   as apparatus, the bolt's crack as a spark somewhere off to the side, the
000264r 2               ;   lock's thunk as something heavy being set down, and the match chime as a
000264r 2               ;   phial being touched. Nothing louder than those — a game-over run drifting
000264r 2               ;   past the title screen would sound like a fault, not a laboratory.
000264r 2               
000264r 2               AmbTable:
000264r 2  0D 0F 0D 09    .byte SFX_BUBBLE, SFX_SEETHE, SFX_BUBBLE, SFX_PRISM
000268r 2  0E 0D 06 0D    .byte SFX_GLOOP,  SFX_BUBBLE, SFX_BOLT,   SFX_BUBBLE
00026Cr 2  0F 0E 04 0D    .byte SFX_SEETHE, SFX_GLOOP,  SFX_MATCH,  SFX_BUBBLE
000270r 2  0D 08 0E 03    .byte SFX_BUBBLE, SFX_STAR,   SFX_GLOOP,  SFX_LOCK
000274r 2               
000274r 2               
000274r 1               .include "../src/strings.inc"
000274r 2               ; =============================================================================
000274r 2               ;   strings.inc — Wizards Lab, tile-encoded text
000274r 2               ; =============================================================================
000274r 2               ;   Strings are stored as TILE numbers, not ASCII, terminated by TEXT_END, so
000274r 2               ;   TextDraw is a copy with no translation at run time (see text.asm). The
000274r 2               ;   translation happens here instead, at assembly time, in TileStr.
000274r 2               ;
000274r 2               ;   Hand-authored, never overwritten by an editor export (D3). Included once,
000274r 2               ;   from each platform's RODATA segment.
000274r 2               ; =============================================================================
000274r 2               
000274r 2               ; -----------------------------------------------------------------------------
000274r 2               ;   TileChar / TileStr — ASCII source, tile bytes out
000274r 2               ;   The font is forty glyphs in one run from FONT_BASE:
000274r 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
000274r 2               ;   and a space is TILE_BLANK. Anything else is not in the tileset and is an
000274r 2               ;   assembly error rather than a wrong glyph on the screen.
000274r 2               ; -----------------------------------------------------------------------------
000274r 2               .macro TileChar c
000274r 2                 .if c = ' '
000274r 2                   .byte TILE_BLANK
000274r 2                 .elseif (c >= '0') .and (c <= '9')
000274r 2                   .byte FONT_DIGIT_0 + (c - '0')
000274r 2                 .elseif (c >= 'A') .and (c <= 'Z')
000274r 2                   .byte FONT_LETTER_A + (c - 'A')
000274r 2                 .elseif c = '.'
000274r 2                   .byte FONT_DOT
000274r 2                 .elseif c = 'x'
000274r 2                   .byte FONT_TIMES
000274r 2                 .elseif c = '!'
000274r 2                   .byte FONT_BANG
000274r 2                 .elseif c = '~'
000274r 2                   .byte FONT_TILDE
000274r 2                 .else
000274r 2                   .error "strings.inc: no tile for this character"
000274r 2                 .endif
000274r 2               .endmacro
000274r 2               
000274r 2               .macro TileStr s
000274r 2                 .repeat .strlen(s), I
000274r 2                   TileChar {.strat(s, I)}
000274r 2                 .endrepeat
000274r 2                 .byte TEXT_END
000274r 2               .endmacro
000274r 2               
000274r 2               ; -----------------------------------------------------------------------------
000274r 2               ;   Banners — SPEC 12.2, 13.3
000274r 2               ;   Even length, so (PANEL_W - length) / 2 centres exactly. The band is 18
000274r 2               ;   cells of backdrop between two shelf tiles either side, so a banner has 18
000274r 2               ;   to play with before it starts overwriting the artwork.
000274r 2               ;
000274r 2               ;   MsgPaused matches the play screen image byte for byte on purpose: the
000274r 2               ;   artwork ships with the band already reading `~~ PAUSED ~~` (see SPEC 12.1),
000274r 2               ;   so entering play clears the band and pausing draws this straight back.
000274r 2               ; -----------------------------------------------------------------------------
000274r 2               MsgPaused:
000274r 2  37 37 00 29    TileStr "~~ PAUSED ~~"                 ; 12 cells, centres at panel column 5
000278r 2  1A 2E 2C 1E  
00027Cr 2  1D 00 37 37  
000281r 2               
000281r 2               MsgLevelUp:
000281r 2  37 37 00 25    TileStr "~~ LEVEL UP ~~"               ; 14 cells, centres at panel column 4
000285r 2  1E 2F 1E 25  
000289r 2  00 2E 29 00  
000290r 2               
000290r 2               ; `GAME OVER` is nine characters, so a symmetric ornament around it is always
000290r 2               ; an ODD length and would sit half a cell left of centre. The bang makes it
000290r 2               ; even and is the reason it is there; SPEC 13.4 records the wording.
000290r 2               MsgGameOver:
000290r 2  37 37 00 20    TileStr "~~ GAME OVER! ~~"             ; 16 cells, centres at panel column 3
000294r 2  1A 26 1E 00  
000298r 2  28 2F 1E 2B  
0002A1r 2               
0002A1r 2               ; The chain banner carries a number, and TextDraw copies bytes rather than
0002A1r 2               ; formatting them, so the digit is a placeholder that CascadeSettle overwrites
0002A1r 2               ; with one RenderMark at CHAIN_DIGIT_X (constants.inc). Keeping the length at
0002A1r 2               ; MSG_CHAIN_LEN is what makes that column a constant instead of a measurement.
0002A1r 2               MsgChain:
0002A1r 2  37 37 00 1C    TileStr "~~ CHAIN x0 ~~"               ; 14 cells; the `0` is panel column 14
0002A5r 2  21 1A 22 27  
0002A9r 2  00 35 10 00  
0002B0r 2               
0002B0r 2               ; -----------------------------------------------------------------------------
0002B0r 2               ;   The title screen's prompt (SPEC 13.1)
0002B0r 2               ;   Not a banner: it is ten cells of the DRAWN title image, and the only reason
0002B0r 2               ;   the string exists at all is that blinking it means putting it back. It must
0002B0r 2               ;   match data/screen-title-*.bin at PROMPT_X, PROMPT_Y byte for byte, or the
0002B0r 2               ;   first blink would redraw the screen slightly differently from the way the
0002B0r 2               ;   artist drew it.
0002B0r 2               ; -----------------------------------------------------------------------------
0002B0r 2               MsgPressFire:
0002B0r 2  29 2B 1E 2C    TileStr "PRESS FIRE"                   ; PROMPT_LEN cells (constants.inc)
0002B4r 2  2C 00 1F 22  
0002B8r 2  2B 1E FF     
0002BBr 2               
0002BBr 1               
0002BBr 1               ; --- Sound: which oscillator a timbre uses (constants.inc) -------------------
0002BBr 1               ;   Offsets from VIC_CRA, indexed 1..4: TIMBRE_SOFT, BUZZ, BRIGHT, NOISE.
0002BBr 1               VicOsc:
0002BBr 1  00 01 02 03    .byte 0, 1, 2, 3
0002BFr 1               
0002BFr 1               ; --- Note table: semitones above C3, C3 to C6 (NOTE_MAX) ---------------------
0002BFr 1               ;   Register value = round(128 - phi2 / (128 * Hz)) for the ALTO oscillator,
0002BFr 1               ;   equal temperament from A4 = 440 Hz, phi2 = 1,022,727 Hz. The bass and
0002BFr 1               ;   soprano read the same numbers an octave down and up, which is what makes a
0002BFr 1               ;   timbre free here (HalSfx above).
0002BFr 1               ;
0002BFr 1               ;   PAL clocks the chip 8% faster and every note with it, which is a uniform
0002BFr 1               ;   1.4-semitone transposition and not a tuning error — one table, and nothing
0002BFr 1               ;   in the sound path reads Region.
0002BFr 1               ;
0002BFr 1               ;   The value is 7 bits for a frequency that goes as 1/(128 - value), so the
0002BFr 1               ;   resolution runs out at the top: above C5 consecutive semitones start
0002BFr 1               ;   landing on the same number, which is why tables.inc writes everything
0002BFr 1               ;   melodic inside C3-C5 and lifts it with a timbre instead.
0002BFr 1               VicNotes:
0002BFr 1  43 46 4A 4D    .byte  67,  70,  74,  77,  80,  82,  85,  87,  90,  92,  94,  96   ; C3-B3
0002C3r 1  50 52 55 57  
0002C7r 1  5A 5C 5E 60  
0002CBr 1  61 63 65 66    .byte  97,  99, 101, 102, 104, 105, 106, 108, 109, 110, 111, 112   ; C4-B4
0002CFr 1  68 69 6A 6C  
0002D3r 1  6D 6E 6F 70  
0002D7r 1  71 72 72 73    .byte 113, 114, 114, 115, 116, 117, 117, 118, 118, 119, 119, 120   ; C5-B5
0002DBr 1  74 75 75 76  
0002DFr 1  76 77 77 78  
0002E3r 1  78             .byte 120                                                          ; C6
0002E4r 1               
0002E4r 1               ; --- Screen row start addresses ----------------------------------------------
0002E4r 1               RowLo:
0002E4r 1  00 16 2C 42    .repeat SCR_ROWS, i
0002E8r 1  58 6E 84 9A  
0002ECr 1  B0 C6 DC F2  
0002FBr 1                   .byte <(SCREEN + i * SCR_COLS)
0002FBr 1                 .endrepeat
0002FBr 1               RowHi:
0002FBr 1  1E 1E 1E 1E    .repeat SCR_ROWS, i
0002FFr 1  1E 1E 1E 1E  
000303r 1  1E 1E 1E 1E  
000312r 1                   .byte >(SCREEN + i * SCR_COLS)
000312r 1                 .endrepeat
000312r 1               
000312r 1               .segment "TILES"
