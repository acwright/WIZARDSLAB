000100r 1               .include "../src/tables.inc"
000100r 2               ; =============================================================================
000100r 2               ;   tables.inc — Wizards Lab, spec-derived lookup tables
000100r 2               ; =============================================================================
000100r 2               ;   Straight out of SPEC.md sections 5.3, 9, 10, 14 and 16. Hand-authored,
000100r 2               ;   never overwritten by an editor export. Included once, from the RODATA
000100r 2               ;   segment.
000100r 2               ;
000100r 2               ;   Score values above 99 do not fit in a byte, so every scoring table is a
000100r 2               ;   pair of parallel arrays — low BCD byte and high BCD byte — indexed by the
000100r 2               ;   same value.
000100r 2               ; =============================================================================
000100r 2               
000100r 2               ; --- Gravity, frames per row (SPEC 10.2) -------------------------------------
000100r 2               ;   Indexed by (level - 1), clamped to LEVEL_SPEED_CAP - 1.
000100r 2               ;   PAL is round(NTSC * 50/60), so wall-clock speed matches across regions.
000100r 2               
000100r 2               SpeedNTSC:
000100r 2  30 2B 26 22    .byte  48, 43, 38, 34, 30, 26, 23, 20   ; levels  1- 8   0.800s .. 0.333s
000104r 2  1E 1A 17 14  
000108r 2  11 0F 0D 0B    .byte  17, 15, 13, 11,  9,  8,  7,  6   ; levels  9-16   0.283s .. 0.100s
00010Cr 2  09 08 07 06  
000110r 2               
000110r 2               SpeedPAL:
000110r 2  28 24 20 1C    .byte  40, 36, 32, 28, 25, 22, 19, 17   ; levels  1- 8   0.800s .. 0.340s
000114r 2  19 16 13 11  
000118r 2  0E 0D 0B 09    .byte  14, 13, 11,  9,  8,  7,  6,  5   ; levels  9-16   0.280s .. 0.100s
00011Cr 2  08 07 06 05  
000120r 2               
000120r 2               ; --- Frame counts that differ by region (SPEC 5.6, 11.3, 14) -----------------
000120r 2               ;   Indexed by Region: 0 = NTSC, 1 = PAL. PAL is round(NTSC * 50/60) wherever
000120r 2               ;   the difference is worth a frame, so a piece takes the same number of
000120r 2               ;   SECONDS to lock on both machines rather than the same number of frames.
000120r 2               ;
000120r 2               ;   Two bytes each rather than one table of pairs, because every read is
000120r 2               ;   `ldx Region / lda Name,x` and a pair table would need the index doubled.
000120r 2               
000120r 2               LockDelay:                              ; SPEC 5.6
000120r 2  10 0E          .byte 16, 14
000122r 2               AreDelay:                               ; Entry delay after a cascade settles
000122r 2  0C 0A          .byte 12, 10
000124r 2               DasInitial:                             ; SPEC 11.3 — first repeat
000124r 2  0C 0A          .byte 12, 10
000126r 2               DasRepeat:                              ; ...and every one after it
000126r 2  04 03          .byte  4,  3
000128r 2               SoftDropRate:                           ; Frames per row while DOWN is held.
000128r 2  03 02          .byte  3,  2                          ;   Never used when gravity is faster.
00012Ar 2               BlinkHalf:                              ; SPEC 14 — half of the 30 / 25 frame
00012Ar 2  0F 0D          .byte 15, 13                          ;   blink period, which is what a
00012Cr 2                                                       ;   blinking field actually counts
00012Cr 2               GlowFrames:                             ; SPEC 14 — the GLOW window: the match
00012Cr 2  06 05          .byte  6,  5                          ;   glow and the bolt's beams
00012Er 2               FlashFrames:                            ; ...and what the window grows to when
00012Er 2  08 07          .byte  8,  7                          ;   a fireball fired, because its flash
000130r 2                                                       ;   is the longer of the two and both
000130r 2                                                       ;   are showing at once (constants.inc)
000130r 2               BannerFrames:                           ; SPEC 14 — how long LEVEL UP and
000130r 2  2D 26          .byte 45, 38                          ;   CHAIN xN stay in the message band
000132r 2               SecondFrames:                           ; One second, which is the unit the
000132r 2  3C 32          .byte 60, 50                          ;   game-over timeout is counted in
000134r 2                                                       ;   (SPEC 13.4). The only entry here
000134r 2                                                       ;   that is not a duration out of
000134r 2                                                       ;   SPEC 14 but the frame rate itself
000134r 2               
000134r 2               ; --- The two removal animations (SPEC 14, Appendix A.3) ----------------------
000134r 2               ;   One ring, run in both directions. Indexed by AnimStep, which advances every
000134r 2               ;   VFX_FRAMES frames.
000134r 2               ;
000134r 2               ;   Potions, reagents, the bomb blast and the star all open OUTWARD and are
000134r 2               ;   gone in SHATTER_STEPS frames; the fourth entry only ever comes up when a
000134r 2               ;   marked prism is blipping out beside them and holding the window open, and
000134r 2               ;   it blanks the cell rather than leaving the last ring frame sitting there
000134r 2               ;   for four more frames.
000134r 2               
000134r 2               VfxShatter:
000134r 2  38 39 3A 00    .byte VFX_REMOVE1, VFX_REMOVE2, VFX_REMOVE3, TILE_EMPTY
000138r 2               
000138r 2               ;   The prism closes INWARD, and does not pass through the glow (SPEC A.3 —
000138r 2               ;   group 14 has no glyph +6). Five frames, so a step that clears one runs
000138r 2               ;   BLIP_STEPS rather than SHATTER_STEPS.
000138r 2               
000138r 2               VfxBlip:
000138r 2  74 75 39 38    .byte PRISM_BLIP, PRISM_BLIP + 1, VFX_REMOVE2, VFX_REMOVE1, FONT_DOT
00013Cr 2  34           
00013Dr 2               
00013Dr 2               ; --- Per-tile value for MATCH removals (SPEC 9.1) ----------------------------
00013Dr 2               ;   Indexed by (chain - 1), clamped to 7.   20 50 100 200 300 400 500 600
00013Dr 2               TileValueLo:
00013Dr 2  20 50 00 00    .byte $20, $50, $00, $00, $00, $00, $00, $00
000141r 2  00 00 00 00  
000145r 2               TileValueHi:
000145r 2  00 00 01 02    .byte $00, $00, $01, $02, $03, $04, $05, $06
000149r 2  03 04 05 06  
00014Dr 2               
00014Dr 2               ; --- Per-tile value for EFFECT removals (SPEC 9.2) ---------------------------
00014Dr 2               ;   Indexed by (chain - 1), clamped to 7.   30 60 120 240 350 450 550 650
00014Dr 2               EffectValueLo:
00014Dr 2  30 60 20 40    .byte $30, $60, $20, $40, $50, $50, $50, $50
000151r 2  50 50 50 50  
000155r 2               EffectValueHi:
000155r 2  00 00 01 02    .byte $00, $00, $01, $02, $03, $04, $05, $06
000159r 2  03 04 05 06  
00015Dr 2               
00015Dr 2               ; --- Run length bonus (SPEC 9.3) ---------------------------------------------
00015Dr 2               ;   Indexed by (length - 3), clamped to 4.  0 100 300 600 1000
00015Dr 2               LengthBonusLo:
00015Dr 2  00 00 00 00    .byte $00, $00, $00, $00, $00
000161r 2  00           
000162r 2               LengthBonusHi:
000162r 2  00 01 03 06    .byte $00, $01, $03, $06, $10
000166r 2  10           
000167r 2               
000167r 2               ; --- Simultaneous run bonus (SPEC 9.4) ---------------------------------------
000167r 2               ;   Indexed by (runs - 1), clamped to 4.    0 200 500 1000 2000
000167r 2               MultiBonusLo:
000167r 2  00 00 00 00    .byte $00, $00, $00, $00, $00
00016Br 2  00           
00016Cr 2               MultiBonusHi:
00016Cr 2  00 02 05 10    .byte $00, $02, $05, $10, $20
000170r 2  20           
000171r 2               
000171r 2               ; --- Level -> reagent probability band (SPEC 5.3) ----------------------------
000171r 2               ;   Indexed by (level - 1), clamped to 15. Bands are 1-3, 4-6, 7-9, 10-12, 13+.
000171r 2               LevelBand:
000171r 2  00 00 00 01    .byte 0, 0, 0, 1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 4
000175r 2  01 01 02 02  
000179r 2  02 03 03 03  
000181r 2               
000181r 2               ; --- Chance a piece carries a reagent, out of 256 (SPEC 5.3) -----------------
000181r 2               ;   Indexed by band.                        15%  22%  27%  32%  36%
000181r 2               PSpecial:
000181r 2  26 38 45 52    .byte  38,  56,  69,  82,  92
000185r 2  5C           
000186r 2               
000186r 2               ; --- Reagent type, cumulative thresholds out of 256 (SPEC 5.3) ---------------
000186r 2               ;   Four thresholds per band; a roll at or above the last one is a Prism.
000186r 2               ;       roll <  [0] -> Fireball
000186r 2               ;       roll <  [1] -> Bolt
000186r 2               ;       roll <  [2] -> Bomb
000186r 2               ;       roll <  [3] -> Star
000186r 2               ;       else        -> Prism
000186r 2               ReagentThresholds:
000186r 2  4D 8A C3 EC    .byte  77, 138, 195, 236             ; band 0   levels  1-3
00018Ar 2  4D 8D C0 EE    .byte  77, 141, 192, 238             ; band 1   levels  4-6
00018Er 2  52 92 C5 EE    .byte  82, 146, 197, 238             ; band 2   levels  7-9
000192r 2  4F 8D C3 EE    .byte  79, 141, 195, 238             ; band 3   levels 10-12
000196r 2  4F 8F C7 F0    .byte  79, 143, 199, 240             ; band 4   levels 13+
00019Ar 2               
00019Ar 2               ; --- Reagent trigger bonuses, indexed by glyph (SPEC 9.5) --------------------
00019Ar 2               ;   Glyph 0 potion and 4 star award nothing here (the star multiplies instead).
00019Ar 2               TriggerBonusLo:
00019Ar 2  00 00 00 00    .byte $00, $00, $00, $00, $00, $00, $00, $00
00019Er 2  00 00 00 00  
0001A2r 2               TriggerBonusHi:
0001A2r 2  00 05 03 03    .byte $00, $05, $03, $03, $00, $00, $00, $00
0001A6r 2  00 00 00 00  
0001AAr 2               
0001AAr 2               ; --- The twelve sound effects (SPEC 16) --------------------------------------
0001AAr 2               ;   An effect is a list of STEPS and a step is three bytes: how many FRAMES it
0001AAr 2               ;   lasts, its TIMBRE, and its NOTE in semitones above C3 (constants.inc). A
0001AAr 2               ;   zero frame count ends the list. Nothing here is a register value: a note
0001AAr 2               ;   means the same pitch on both sound chips and each platform turns it into
0001AAr 2               ;   whatever its own hardware wants (audio.asm, hal.inc).
0001AAr 2               ;
0001AAr 2               ;   SPEC 16 gives each effect a CHARACTER and not a tune — "short blip",
0001AAr 2               ;   "dull thunk", "descending noise sweep" — and the notes below are the
0001AAr 2               ;   reading of it. What is not a choice is the range: the VIC-I's oscillator
0001AAr 2               ;   value runs out of resolution above C5, where consecutive semitones start
0001AAr 2               ;   landing on the same number, so everything melodic is WRITTEN inside C3-C5
0001AAr 2               ;   and lifted by its timbre instead. TIMBRE_BRIGHT is already an octave up.
0001AAr 2               ;
0001AAr 2               ;   SfxStepIdx is a byte offset into SfxSteps, so this table has to stay under
0001AAr 2               ;   256 bytes. It is 144.
0001AAr 2               
0001AAr 2               SfxOffsets:                             ; Indexed by (SFX_* id - 1)
0001AAr 2  00             .byte SfxMove     - SfxSteps
0001ABr 2  04             .byte SfxRotate   - SfxSteps
0001ACr 2  0B             .byte SfxLock     - SfxSteps
0001ADr 2  12             .byte SfxMatch    - SfxSteps
0001AEr 2  19             .byte SfxFireball - SfxSteps
0001AFr 2  29             .byte SfxBolt     - SfxSteps
0001B0r 2  2D             .byte SfxBomb     - SfxSteps
0001B1r 2  34             .byte SfxStar     - SfxSteps
0001B2r 2  41             .byte SfxPrism    - SfxSteps
0001B3r 2  54             .byte SfxLevelUp  - SfxSteps
0001B4r 2  61             .byte SfxHighScore- SfxSteps
0001B5r 2  77             .byte SfxGameOver - SfxSteps
0001B6r 2               
0001B6r 2               SfxSteps:
0001B6r 2               
0001B6r 2               SfxMove:                                ; 1 — short blip                2 frames
0001B6r 2  02 03 13       .byte  2, TIMBRE_BRIGHT, OCT_4 + SEMI_G
0001B9r 2  00             .byte  0
0001BAr 2               
0001BAr 2               SfxRotate:                              ; 2 — rising two-step           6 frames
0001BAr 2  03 03 0C       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_C
0001BDr 2  03 03 13       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_G
0001C0r 2  00             .byte  0
0001C1r 2               
0001C1r 2               SfxLock:                                ; 3 — dull thunk                6 frames
0001C1r 2  02 04 0C       .byte  2, TIMBRE_NOISE,  OCT_4 + SEMI_C
0001C4r 2  04 01 0C       .byte  4, TIMBRE_SOFT,   OCT_4 + SEMI_C
0001C7r 2  00             .byte  0
0001C8r 2               
0001C8r 2               SfxMatch:                               ; 4 — bright chime              9 frames
0001C8r 2  03 03 0C       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_C   ; ...and the whole thing is
0001CBr 2  06 03 10       .byte  6, TIMBRE_BRIGHT, OCT_4 + SEMI_E   ;   transposed up by the chain
0001CEr 2  00             .byte  0                                  ;   (SPEC 16, audio.asm)
0001CFr 2               
0001CFr 2               SfxFireball:                            ; 5 — descending noise sweep   10 frames
0001CFr 2  02 04 24       .byte  2, TIMBRE_NOISE,  OCT_6 + SEMI_C
0001D2r 2  02 04 1F       .byte  2, TIMBRE_NOISE,  OCT_5 + SEMI_G
0001D5r 2  02 04 1A       .byte  2, TIMBRE_NOISE,  OCT_5 + SEMI_D
0001D8r 2  02 04 15       .byte  2, TIMBRE_NOISE,  OCT_4 + SEMI_A
0001DBr 2  02 04 10       .byte  2, TIMBRE_NOISE,  OCT_4 + SEMI_E
0001DEr 2  00             .byte  0
0001DFr 2               
0001DFr 2               SfxBolt:                                ; 6 — fast noise crack          3 frames
0001DFr 2  03 04 21       .byte  3, TIMBRE_NOISE,  OCT_5 + SEMI_A
0001E2r 2  00             .byte  0
0001E3r 2               
0001E3r 2               SfxBomb:                                ; 7 — low noise thump          10 frames
0001E3r 2  02 04 0E       .byte  2, TIMBRE_NOISE,  OCT_4 + SEMI_D
0001E6r 2  08 04 04       .byte  8, TIMBRE_NOISE,  OCT_3 + SEMI_E
0001E9r 2  00             .byte  0
0001EAr 2               
0001EAr 2               SfxStar:                                ; 8 — sparkle arpeggio          8 frames
0001EAr 2  02 03 0C       .byte  2, TIMBRE_BRIGHT, OCT_4 + SEMI_C
0001EDr 2  02 03 10       .byte  2, TIMBRE_BRIGHT, OCT_4 + SEMI_E
0001F0r 2  02 03 13       .byte  2, TIMBRE_BRIGHT, OCT_4 + SEMI_G
0001F3r 2  02 03 18       .byte  2, TIMBRE_BRIGHT, OCT_5 + SEMI_C
0001F6r 2  00             .byte  0
0001F7r 2               
0001F7r 2               SfxPrism:                               ; 9 — shimmer                  12 frames
0001F7r 2  02 02 18       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_C   ; The one effect that wants an edge
0001FAr 2  02 02 1C       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_E   ;   to it rather than a bell: a
0001FDr 2  02 02 18       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_C   ;   sawtooth beating between two
000200r 2  02 02 1C       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_E   ;   notes six times in a fifth of
000203r 2  02 02 18       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_C   ;   a second
000206r 2  02 02 1C       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_E
000209r 2  00             .byte  0
00020Ar 2               
00020Ar 2               SfxLevelUp:                             ; 10 — fanfare                 25 frames
00020Ar 2  05 03 0C       .byte  5, TIMBRE_BRIGHT, OCT_4 + SEMI_C
00020Dr 2  05 03 10       .byte  5, TIMBRE_BRIGHT, OCT_4 + SEMI_E
000210r 2  05 03 13       .byte  5, TIMBRE_BRIGHT, OCT_4 + SEMI_G
000213r 2  0A 03 18       .byte 10, TIMBRE_BRIGHT, OCT_5 + SEMI_C
000216r 2  00             .byte  0
000217r 2               
000217r 2               SfxHighScore:                           ; 11 — longer fanfare          40 frames
000217r 2  04 03 0C       .byte  4, TIMBRE_BRIGHT, OCT_4 + SEMI_C
00021Ar 2  04 03 10       .byte  4, TIMBRE_BRIGHT, OCT_4 + SEMI_E
00021Dr 2  04 03 13       .byte  4, TIMBRE_BRIGHT, OCT_4 + SEMI_G
000220r 2  04 03 18       .byte  4, TIMBRE_BRIGHT, OCT_5 + SEMI_C
000223r 2  04 03 13       .byte  4, TIMBRE_BRIGHT, OCT_4 + SEMI_G
000226r 2  04 03 18       .byte  4, TIMBRE_BRIGHT, OCT_5 + SEMI_C
000229r 2  10 03 1C       .byte 16, TIMBRE_BRIGHT, OCT_5 + SEMI_E
00022Cr 2  00             .byte  0
00022Dr 2               
00022Dr 2               SfxGameOver:                            ; 12 — descending minor run    58 frames
00022Dr 2  06 01 15       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_A
000230r 2  06 01 13       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_G
000233r 2  06 01 11       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_F
000236r 2  06 01 10       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_E
000239r 2  06 01 0E       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_D
00023Cr 2  06 01 0C       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_C
00023Fr 2  06 01 0B       .byte  6, TIMBRE_SOFT,   OCT_3 + SEMI_B
000242r 2  10 01 09       .byte 16, TIMBRE_SOFT,   OCT_3 + SEMI_A
000245r 2  00             .byte  0
000246r 2               
000246r 1               .include "../src/strings.inc"
000246r 2               ; =============================================================================
000246r 2               ;   strings.inc — Wizards Lab, tile-encoded text
000246r 2               ; =============================================================================
000246r 2               ;   Strings are stored as TILE numbers, not ASCII, terminated by TEXT_END, so
000246r 2               ;   TextDraw is a copy with no translation at run time (see text.asm). The
000246r 2               ;   translation happens here instead, at assembly time, in TileStr.
000246r 2               ;
000246r 2               ;   Hand-authored, never overwritten by an editor export (D3). Included once,
000246r 2               ;   from each platform's RODATA segment.
000246r 2               ; =============================================================================
000246r 2               
000246r 2               ; -----------------------------------------------------------------------------
000246r 2               ;   TileChar / TileStr — ASCII source, tile bytes out
000246r 2               ;   The font is forty glyphs in one run from FONT_BASE:
000246r 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
000246r 2               ;   and a space is TILE_BLANK. Anything else is not in the tileset and is an
000246r 2               ;   assembly error rather than a wrong glyph on the screen.
000246r 2               ; -----------------------------------------------------------------------------
000246r 2               .macro TileChar c
000246r 2                 .if c = ' '
000246r 2                   .byte TILE_BLANK
000246r 2                 .elseif (c >= '0') .and (c <= '9')
000246r 2                   .byte FONT_DIGIT_0 + (c - '0')
000246r 2                 .elseif (c >= 'A') .and (c <= 'Z')
000246r 2                   .byte FONT_LETTER_A + (c - 'A')
000246r 2                 .elseif c = '.'
000246r 2                   .byte FONT_DOT
000246r 2                 .elseif c = 'x'
000246r 2                   .byte FONT_TIMES
000246r 2                 .elseif c = '!'
000246r 2                   .byte FONT_BANG
000246r 2                 .elseif c = '~'
000246r 2                   .byte FONT_TILDE
000246r 2                 .else
000246r 2                   .error "strings.inc: no tile for this character"
000246r 2                 .endif
000246r 2               .endmacro
000246r 2               
000246r 2               .macro TileStr s
000246r 2                 .repeat .strlen(s), I
000246r 2                   TileChar {.strat(s, I)}
000246r 2                 .endrepeat
000246r 2                 .byte TEXT_END
000246r 2               .endmacro
000246r 2               
000246r 2               ; -----------------------------------------------------------------------------
000246r 2               ;   Banners — SPEC 12.2, 13.3
000246r 2               ;   Even length, so (PANEL_W - length) / 2 centres exactly. The band is 18
000246r 2               ;   cells of backdrop between two shelf tiles either side, so a banner has 18
000246r 2               ;   to play with before it starts overwriting the artwork.
000246r 2               ;
000246r 2               ;   MsgPaused matches the play screen image byte for byte on purpose: the
000246r 2               ;   artwork ships with the band already reading `~~ PAUSED ~~` (see SPEC 12.1),
000246r 2               ;   so entering play clears the band and pausing draws this straight back.
000246r 2               ; -----------------------------------------------------------------------------
000246r 2               MsgPaused:
000246r 2  37 37 00 29    TileStr "~~ PAUSED ~~"                 ; 12 cells, centres at panel column 5
00024Ar 2  1A 2E 2C 1E  
00024Er 2  1D 00 37 37  
000253r 2               
000253r 2               MsgLevelUp:
000253r 2  37 37 00 25    TileStr "~~ LEVEL UP ~~"               ; 14 cells, centres at panel column 4
000257r 2  1E 2F 1E 25  
00025Br 2  00 2E 29 00  
000262r 2               
000262r 2               ; `GAME OVER` is nine characters, so a symmetric ornament around it is always
000262r 2               ; an ODD length and would sit half a cell left of centre. The bang makes it
000262r 2               ; even and is the reason it is there; SPEC 13.4 records the wording.
000262r 2               MsgGameOver:
000262r 2  37 37 00 20    TileStr "~~ GAME OVER! ~~"             ; 16 cells, centres at panel column 3
000266r 2  1A 26 1E 00  
00026Ar 2  28 2F 1E 2B  
000273r 2               
000273r 2               ; The chain banner carries a number, and TextDraw copies bytes rather than
000273r 2               ; formatting them, so the digit is a placeholder that CascadeSettle overwrites
000273r 2               ; with one RenderMark at CHAIN_DIGIT_X (constants.inc). Keeping the length at
000273r 2               ; MSG_CHAIN_LEN is what makes that column a constant instead of a measurement.
000273r 2               MsgChain:
000273r 2  37 37 00 1C    TileStr "~~ CHAIN x0 ~~"               ; 14 cells; the `0` is panel column 14
000277r 2  21 1A 22 27  
00027Br 2  00 35 10 00  
000282r 2               
000282r 2               ; -----------------------------------------------------------------------------
000282r 2               ;   The title screen's prompt (SPEC 13.1)
000282r 2               ;   Not a banner: it is ten cells of the DRAWN title image, and the only reason
000282r 2               ;   the string exists at all is that blinking it means putting it back. It must
000282r 2               ;   match data/screen-title-*.bin at PROMPT_X, PROMPT_Y byte for byte, or the
000282r 2               ;   first blink would redraw the screen slightly differently from the way the
000282r 2               ;   artist drew it.
000282r 2               ; -----------------------------------------------------------------------------
000282r 2               MsgPressFire:
000282r 2  29 2B 1E 2C    TileStr "PRESS FIRE"                   ; PROMPT_LEN cells (constants.inc)
000286r 2  2C 00 1F 22  
00028Ar 2  2B 1E FF     
00028Dr 2               
00028Dr 1               
00028Dr 1               ; --- Sound: which oscillator a timbre uses (constants.inc) -------------------
00028Dr 1               ;   Offsets from VIC_CRA, indexed 1..4: TIMBRE_SOFT, BUZZ, BRIGHT, NOISE.
00028Dr 1               VicOsc:
00028Dr 1  00 01 02 03    .byte 0, 1, 2, 3
000291r 1               
000291r 1               ; --- Note table: semitones above C3, C3 to C6 (NOTE_MAX) ---------------------
000291r 1               ;   Register value = round(128 - phi2 / (128 * Hz)) for the ALTO oscillator,
000291r 1               ;   equal temperament from A4 = 440 Hz, phi2 = 1,022,727 Hz. The bass and
000291r 1               ;   soprano read the same numbers an octave down and up, which is what makes a
000291r 1               ;   timbre free here (HalSfx above).
000291r 1               ;
000291r 1               ;   PAL clocks the chip 8% faster and every note with it, which is a uniform
000291r 1               ;   1.4-semitone transposition and not a tuning error — one table, and nothing
000291r 1               ;   in the sound path reads Region.
000291r 1               ;
000291r 1               ;   The value is 7 bits for a frequency that goes as 1/(128 - value), so the
000291r 1               ;   resolution runs out at the top: above C5 consecutive semitones start
000291r 1               ;   landing on the same number, which is why tables.inc writes everything
000291r 1               ;   melodic inside C3-C5 and lifts it with a timbre instead.
000291r 1               VicNotes:
000291r 1  43 46 4A 4D    .byte  67,  70,  74,  77,  80,  82,  85,  87,  90,  92,  94,  96   ; C3-B3
000295r 1  50 52 55 57  
000299r 1  5A 5C 5E 60  
00029Dr 1  61 63 65 66    .byte  97,  99, 101, 102, 104, 105, 106, 108, 109, 110, 111, 112   ; C4-B4
0002A1r 1  68 69 6A 6C  
0002A5r 1  6D 6E 6F 70  
0002A9r 1  71 72 72 73    .byte 113, 114, 114, 115, 116, 117, 117, 118, 118, 119, 119, 120   ; C5-B5
0002ADr 1  74 75 75 76  
0002B1r 1  76 77 77 78  
0002B5r 1  78             .byte 120                                                          ; C6
0002B6r 1               
0002B6r 1               ; --- Screen row start addresses ----------------------------------------------
0002B6r 1               RowLo:
0002B6r 1  00 16 2C 42    .repeat SCR_ROWS, i
0002BAr 1  58 6E 84 9A  
0002BEr 1  B0 C6 DC F2  
0002CDr 1                   .byte <(SCREEN + i * SCR_COLS)
0002CDr 1                 .endrepeat
0002CDr 1               RowHi:
0002CDr 1  1E 1E 1E 1E    .repeat SCR_ROWS, i
0002D1r 1  1E 1E 1E 1E  
0002D5r 1  1E 1E 1E 1E  
0002E4r 1                   .byte >(SCREEN + i * SCR_COLS)
0002E4r 1                 .endrepeat
0002E4r 1               
0002E4r 1               .segment "TILES"
000000r 1               
000000r 1               ; --- PLACEHOLDER ART — replace via VIC-EDITOR, see data/README.md ------------
000000r 1  00 00 00 00  Tileset:      .incbin "../data/tileset.bin"
000004r 1  00 00 00 00  
000008r 1  00 00 7E AB  
000800r 1  00 00 00 00  TitleScreen:  .incbin "../data/screen-title-vic20.bin"
000804r 1  00 00 00 00  
000808r 1  00 00 00 00  
0009FAr 1  01 01 01 01  TitleColor:   .incbin "../data/screen-title-vic20-color.bin"
0009FEr 1  01 01 01 01  
000A02r 1  01 01 01 01  
000BF4r 1  7E 7E 7E 7E  PlayScreen:   .incbin "../data/screen-play-vic20.bin"
000BF8r 1  7E 7E 7E 7E  
000BFCr 1  7E 7E 7E 7E  
000DEEr 1  02 02 02 02  PlayColor:    .incbin "../data/screen-play-vic20-color.bin"
000DF2r 1  02 02 02 02  
000DF6r 1  02 02 02 02  
000DEEr 1               
