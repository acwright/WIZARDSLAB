000000r 1               ; =============================================================================
000000r 1               ;   Wizards Lab — VIC-20
000000r 1               ; =============================================================================
000000r 1               ;   A 16 K cartridge for an unexpanded VIC-20: BLK5 ($A000) carries the
000000r 1               ;   autostart header and the code, BLK3 ($6000) carries the tileset and screen
000000r 1               ;   images.
000000r 1               ;
000000r 1               ;   This machine sets the shape of the whole game. Its 22 x 23 screen is
000000r 1               ;   exactly the panel every platform draws, and its eight hi-res foreground
000000r 1               ;   colours are what cap the potion palette at six plus white. Designing
000000r 1               ;   against it first is what lets one layout serve all three.
000000r 1               ;
000000r 1               ;   The VIC chip cannot see cartridge ROM, so the character set is copied out
000000r 1               ;   of BLK3 into RAM at $1400 during boot.
000000r 1               ;
000000r 1               ;   Built with VIC20-16K.cfg.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               .include "../include/vic20.inc"
000000r 2               ; VIC-20 Include File for ca65
000000r 2               ; Memory addresses, KERNAL routines, and hardware registers
000000r 2               ; Compatible with both NTSC and PAL VIC-20 systems
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Zero Page Locations
000000r 2               ;=============================================================================
000000r 2               VARTAB          = $2D           ; Pointer to start of BASIC variables
000000r 2               ARYTAB          = $2F           ; Pointer to start of BASIC arrays
000000r 2               STREND          = $31           ; Pointer to end of BASIC arrays
000000r 2               FRETOP          = $33           ; Pointer to bottom of string space
000000r 2               MEMSIZ          = $37           ; Pointer to top of BASIC memory
000000r 2               TIME            = $A0           ; Jiffy clock (3 bytes)
000000r 2               TIMER           = $A0           ; Same as TIME
000000r 2               STATUS          = $90           ; I/O status byte
000000r 2               STKEY           = $91           ; STOP key flag
000000r 2               MSGFLG          = $9D           ; Kernal message control flag
000000r 2               FNLEN           = $B7           ; Length of filename
000000r 2               LA              = $B8           ; Logical file number
000000r 2               SA              = $B9           ; Secondary address
000000r 2               FA              = $BA           ; Device number
000000r 2               FNADR           = $BB           ; Pointer to filename (2 bytes)
000000r 2               STAL            = $C1           ; Pointer for tape I/O (2 bytes)
000000r 2               EAL             = $C3           ; Pointer for tape I/O (2 bytes)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Screen and Color Memory (Unexpanded VIC-20)
000000r 2               ;=============================================================================
000000r 2               SCREEN          = $1E00         ; Screen memory start (22x23 default)
000000r 2               COLRAM          = $9600         ; Color RAM start
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; User BASIC Memory
000000r 2               ;=============================================================================
000000r 2               BASIC_START     = $1001         ; Start of BASIC program area
000000r 2               BASIC_END       = $1E00         ; End of BASIC (screen memory starts)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; VIC Chip Registers (6560/6561 Video Interface Chip)
000000r 2               ;=============================================================================
000000r 2               VIC             = $9000         ; Base address of VIC chip
000000r 2               
000000r 2               ; Individual VIC registers
000000r 2               VIC_CR0         = $9000         ; Horizontal centering (bit 7 = interlace)
000000r 2               VIC_CR1         = $9001         ; Vertical centering
000000r 2               VIC_CR2         = $9002         ; Video matrix columns (bits 0-6, bit 7=raster)
000000r 2               VIC_CR3         = $9003         ; Raster value (bits 1-7 = rows*2, bit 0=character size)
000000r 2               VIC_CR4         = $9004         ; TV raster beam location (read only)
000000r 2               VIC_CR5         = $9005         ; Video matrix start address (bits 4-7)
000000r 2               VIC_CRA         = $900A         ; Bass frequency
000000r 2               VIC_CRB         = $900B         ; Alto frequency
000000r 2               VIC_CRC         = $900C         ; Soprano frequency
000000r 2               VIC_CRD         = $900D         ; Noise frequency
000000r 2               VIC_CRE         = $900E         ; Auxiliary color / Volume
000000r 2               VIC_CRF         = $900F         ; Screen & border colors / reverse mode
000000r 2               
000000r 2               ; VIC register aliases
000000r 2               VIC_HORZ        = VIC_CR0       ; Horizontal position
000000r 2               VIC_VERT        = VIC_CR1       ; Vertical position
000000r 2               VIC_COLUMNS     = VIC_CR2       ; Number of columns
000000r 2               VIC_ROWS        = VIC_CR3       ; Number of rows
000000r 2               VIC_RASTER      = VIC_CR4       ; Raster position
000000r 2               VIC_ORIGIN      = VIC_CR5       ; Screen memory location
000000r 2               VIC_BASS        = VIC_CRA       ; Sound: Bass voice
000000r 2               VIC_ALTO        = VIC_CRB       ; Sound: Alto voice
000000r 2               VIC_SOPRANO     = VIC_CRC       ; Sound: Soprano voice
000000r 2               VIC_NOISE       = VIC_CRD       ; Sound: Noise voice
000000r 2               VIC_VOLUME      = VIC_CRE       ; Volume control (bits 0-3)
000000r 2               VIC_AUX_COLOR   = VIC_CRE       ; Auxiliary color (bits 4-7)
000000r 2               VIC_BACKGROUND  = VIC_CRF       ; Background color (bits 4-7)
000000r 2               VIC_BORDER      = VIC_CRF       ; Border color (bits 0-2)
000000r 2               VIC_REVERSE     = VIC_CRF       ; Reverse mode (bit 3)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; VIA Chip #1 Registers (6522 VIA - Keyboard, Joystick)
000000r 2               ;=============================================================================
000000r 2               VIA1            = $9110         ; Base address of VIA1
000000r 2               VIA1_PB         = $9110         ; Port B (keyboard row select, joystick)
000000r 2               VIA1_PA1        = $9111         ; Port A (keyboard column read)
000000r 2               VIA1_DDRB       = $9112         ; Data direction register B
000000r 2               VIA1_DDRA       = $9113         ; Data direction register A
000000r 2               VIA1_T1CL       = $9114         ; Timer 1 counter low
000000r 2               VIA1_T1CH       = $9115         ; Timer 1 counter high
000000r 2               VIA1_T1LL       = $9116         ; Timer 1 latch low
000000r 2               VIA1_T1LH       = $9117         ; Timer 1 latch high
000000r 2               VIA1_T2CL       = $9118         ; Timer 2 counter low
000000r 2               VIA1_T2CH       = $9119         ; Timer 2 counter high
000000r 2               VIA1_SR         = $911A         ; Shift register
000000r 2               VIA1_ACR        = $911B         ; Auxiliary control register
000000r 2               VIA1_PCR        = $911C         ; Peripheral control register
000000r 2               VIA1_IFR        = $911D         ; Interrupt flag register
000000r 2               VIA1_IER        = $911E         ; Interrupt enable register
000000r 2               VIA1_PA2        = $911F         ; Port A (no handshake)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; VIA Chip #2 Registers (6522 VIA - Serial, Tape, Joystick)
000000r 2               ;=============================================================================
000000r 2               VIA2            = $9120         ; Base address of VIA2
000000r 2               VIA2_PB         = $9120         ; Port B (serial bus, tape control, joystick)
000000r 2               VIA2_PA1        = $9121         ; Port A (serial bus)
000000r 2               VIA2_DDRB       = $9122         ; Data direction register B
000000r 2               VIA2_DDRA       = $9123         ; Data direction register A
000000r 2               VIA2_T1CL       = $9124         ; Timer 1 counter low
000000r 2               VIA2_T1CH       = $9125         ; Timer 1 counter high
000000r 2               VIA2_T1LL       = $9126         ; Timer 1 latch low
000000r 2               VIA2_T1LH       = $9127         ; Timer 1 latch high
000000r 2               VIA2_T2CL       = $9128         ; Timer 2 counter low
000000r 2               VIA2_T2CH       = $9129         ; Timer 2 counter high
000000r 2               VIA2_SR         = $912A         ; Shift register
000000r 2               VIA2_ACR        = $912B         ; Auxiliary control register
000000r 2               VIA2_PCR        = $912C         ; Peripheral control register
000000r 2               VIA2_IFR        = $912D         ; Interrupt flag register
000000r 2               VIA2_IER        = $912E         ; Interrupt enable register
000000r 2               VIA2_PA2        = $912F         ; Port A (no handshake)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Joystick (VIA1 Port A = $9111, VIA2 Port B = $9120)
000000r 2               ; Active-low: bit is 0 when the switch is closed (direction/fire pressed)
000000r 2               ;=============================================================================
000000r 2               JOY_UP          = %00000100     ; VIA1_PA1 bit 2
000000r 2               JOY_DOWN        = %00001000     ; VIA1_PA1 bit 3
000000r 2               JOY_LEFT        = %00010000     ; VIA1_PA1 bit 4
000000r 2               JOY_FIRE        = %00100000     ; VIA1_PA1 bit 5
000000r 2               JOY_RIGHT       = %10000000     ; VIA2_PB bit 7
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Color Codes
000000r 2               ;=============================================================================
000000r 2               BLACK           = $00
000000r 2               WHITE           = $01
000000r 2               RED             = $02
000000r 2               CYAN            = $03
000000r 2               PURPLE          = $04
000000r 2               GREEN           = $05
000000r 2               BLUE            = $06
000000r 2               YELLOW          = $07
000000r 2               ORANGE          = $08
000000r 2               LIGHT_ORANGE    = $09
000000r 2               PINK            = $0A
000000r 2               LIGHT_CYAN      = $0B
000000r 2               LIGHT_PURPLE    = $0C
000000r 2               LIGHT_GREEN     = $0D
000000r 2               LIGHT_BLUE      = $0E
000000r 2               LIGHT_YELLOW    = $0F
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Character Codes (PETSCII)
000000r 2               ;=============================================================================
000000r 2               CHR_RETURN      = $0D
000000r 2               CHR_SPACE       = $20
000000r 2               CHR_DELETE      = $14
000000r 2               CHR_INSERT      = $94
000000r 2               CHR_HOME        = $13
000000r 2               CHR_CLEAR       = $93
000000r 2               CHR_RVSON       = $12           ; Reverse on
000000r 2               CHR_RVSOFF      = $92           ; Reverse off
000000r 2               CHR_DOWN        = $11
000000r 2               CHR_UP          = $91
000000r 2               CHR_RIGHT       = $1D
000000r 2               CHR_LEFT        = $9D
000000r 2               CHR_BLACK       = $90
000000r 2               CHR_WHITE       = $05
000000r 2               CHR_RED         = $1C
000000r 2               CHR_CYAN        = $9F
000000r 2               CHR_PURPLE      = $9C
000000r 2               CHR_GREEN       = $1E
000000r 2               CHR_BLUE        = $9E
000000r 2               CHR_YELLOW      = $9B
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; ROM Addresses
000000r 2               ;=============================================================================
000000r 2               CHARROM         = $8000         ; Character ROM
000000r 2               BASIC_ROM       = $C000         ; BASIC ROM start
000000r 2               KERNAL_ROM      = $E000         ; KERNAL ROM start
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; KERNAL Routines
000000r 2               ;=============================================================================
000000r 2               ; Internal KERNAL routines (address may vary by ROM version)
000000r 2               CINT            = $E518         ; Initialize screen editor
000000r 2               IOINIT          = $FDF9         ; Initialize I/O
000000r 2               RAMTAS          = $FD8D         ; Initialize RAM
000000r 2               RESTOR          = $FD52         ; Restore default I/O vectors
000000r 2               VECTOR          = $FD1A         ; Manage RAM vectors
000000r 2               
000000r 2               ; KERNAL Jump Table (standard across all VIC-20s)
000000r 2               SETMSG          = $FF90         ; Control KERNAL messages
000000r 2               SECOND          = $FF93         ; Send secondary address
000000r 2               TKSA            = $FF96         ; Send secondary address for talk
000000r 2               MEMTOP          = $FF99         ; Read/set top of memory
000000r 2               MEMBOT          = $FF9C         ; Read/set bottom of memory
000000r 2               SCNKEY          = $FF9F         ; Scan keyboard
000000r 2               SETTMO          = $FFA2         ; Set timeout for serial bus
000000r 2               ACPTR           = $FFA5         ; Input byte from serial bus
000000r 2               CIOUT           = $FFA8         ; Output byte to serial bus
000000r 2               UNTLK           = $FFAB         ; Send UNTALK to serial bus
000000r 2               UNLSN           = $FFAE         ; Send UNLISTEN to serial bus
000000r 2               LISTEN          = $FFB1         ; Send LISTEN to serial bus
000000r 2               TALK            = $FFB4         ; Send TALK to serial bus
000000r 2               READST          = $FFB7         ; Read I/O status word
000000r 2               SETLFS          = $FFBA         ; Set logical file parameters
000000r 2               SETNAM          = $FFBD         ; Set filename
000000r 2               OPEN            = $FFC0         ; Open a logical file
000000r 2               CLOSE           = $FFC3         ; Close a logical file
000000r 2               CHKIN           = $FFC6         ; Define file as default input
000000r 2               CHKOUT          = $FFC9         ; Define file as default output
000000r 2               CLRCHN          = $FFCC         ; Restore default I/O devices
000000r 2               CHRIN           = $FFCF         ; Input character from channel
000000r 2               CHROUT          = $FFD2         ; Output character to channel
000000r 2               LOAD            = $FFD5         ; Load RAM from device
000000r 2               SAVE            = $FFD8         ; Save RAM to device
000000r 2               SETTIM          = $FFDB         ; Set 24-hour clock
000000r 2               RDTIM           = $FFDE         ; Read 24-hour clock
000000r 2               STOP            = $FFE1         ; Check STOP key
000000r 2               GETIN           = $FFE4         ; Get character from keyboard
000000r 2               CLALL           = $FFE7         ; Close all channels and files
000000r 2               UDTIM           = $FFEA         ; Increment 24-hour clock
000000r 2               SCREEN_ORG      = $FFED         ; Return screen organization
000000r 2               PLOT            = $FFF0         ; Read/set cursor X/Y position
000000r 2               IOBASE          = $FFF3         ; Return I/O base address
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; IRQ/NMI Vectors
000000r 2               ;=============================================================================
000000r 2               IRQ_VECTOR      = $0314         ; IRQ vector (2 bytes)
000000r 2               BRK_VECTOR      = $0316         ; BRK vector (2 bytes)
000000r 2               NMI_VECTOR      = $0318         ; NMI vector (2 bytes)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Hardware Vectors (in ROM)
000000r 2               ;=============================================================================
000000r 2               HW_NMI          = $FFFA         ; NMI vector
000000r 2               HW_RESET        = $FFFC         ; Reset vector
000000r 2               HW_IRQ          = $FFFE         ; IRQ/BRK vector
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Useful Constants
000000r 2               ;=============================================================================
000000r 2               SCREEN_COLS     = 22            ; Default screen columns
000000r 2               SCREEN_ROWS     = 23            ; Default screen rows
000000r 2               JIFFY_PAL       = 50            ; Jiffies per second (PAL)
000000r 2               JIFFY_NTSC      = 60            ; Jiffies per second (NTSC)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Memory Expansion Configurations
000000r 2               ;=============================================================================
000000r 2               ; RAM Block 0 (BLK0) = $0400-$0FFF (3K)
000000r 2               ; RAM Block 1 (BLK1) = $2000-$3FFF (8K)
000000r 2               ; RAM Block 2 (BLK2) = $4000-$5FFF (8K)
000000r 2               ; RAM Block 3 (BLK3) = $6000-$7FFF (8K)
000000r 2               ; RAM Block 5 (BLK5) = $A000-$BFFF (8K)
000000r 2               
000000r 2               BLK0            = $0400         ; 3K expansion
000000r 2               BLK1            = $2000         ; 8K expansion
000000r 2               BLK2            = $4000         ; 8K expansion
000000r 2               BLK3            = $6000         ; 8K expansion
000000r 2               BLK5            = $A000         ; 8K expansion
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; End of VIC20.inc
000000r 2               ;=============================================================================
000000r 2               
000000r 1               
000000r 1               ; --- Platform constants (hal.inc) --------------------------------------------
000000r 1               SCR_COLS         = 22
000000r 1               SCR_ROWS         = 23
000000r 1               SCR_CELLS        = 506           ; 22 x 23
000000r 1               PANEL_X             = 0             ; The screen IS the panel
000000r 1               PANEL_Y             = 0
000000r 1               HAS_COLOR_RAM       = 1
000000r 1               
000000r 1               CHARSET_RAM         = $1400         ; 2 K, $1400-$1BFF
000000r 1               
000000r 1               .include "../src/constants.inc"
000000r 2               ; =============================================================================
000000r 2               ;   constants.inc — Wizards Lab, shared game constants
000000r 2               ; =============================================================================
000000r 2               ;   Everything here comes straight out of SPEC.md. If a number changes there,
000000r 2               ;   it changes here, and nowhere else. Nothing in this file is platform
000000r 2               ;   specific — see the per-platform WizardsLab.asm for PANEL_X / PANEL_Y and
000000r 2               ;   the hardware addresses.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Board (SPEC 3) ----------------------------------------------------------
000000r 2               BOARD_W             = 6         ; Playfield columns
000000r 2               BOARD_H             = 16        ; Playfield rows
000000r 2               BOARD_STRIDE        = 8         ; Bytes per row — two wasted, on purpose
000000r 2               BOARD_ROWS_ALLOC    = 20        ; 16 playfield + 2 floor sentinels + 2 reserved
000000r 2               BOARD_BYTES         = BOARD_ROWS_ALLOC * BOARD_STRIDE    ; 160
000000r 2               SPAWN_COL           = 2         ; 0-indexed, left of centre
000000r 2               MATCH_MIN           = 3         ; Run length that clears
000000r 2               
000000r 2               ; --- Tile encoding (SPEC 4) --------------------------------------------------
000000r 2               ;   tile = COLOR_BASE + (color << 3) + glyph
000000r 2               ;   The board byte IS the tile index. No translation on the way to the screen.
000000r 2               TILE_EMPTY          = $00
000000r 2               TILE_WALL           = $FF
000000r 2               COLOR_BASE          = $40
000000r 2               COLOR_MASK          = $F8       ; AND this and you have the colour key
000000r 2               GLYPH_MASK          = $07
000000r 2               WILD_BASE           = $70       ; Colour 6 — the prism
000000r 2               NUM_COLORS          = 6
000000r 2               
000000r 2               COLOR_RED           = 0
000000r 2               COLOR_YELLOW        = 1
000000r 2               COLOR_GREEN         = 2
000000r 2               COLOR_CYAN          = 3
000000r 2               COLOR_BLUE          = 4
000000r 2               COLOR_PURPLE        = 5
000000r 2               COLOR_WILD          = 6
000000r 2               
000000r 2               GLYPH_POTION        = 0
000000r 2               GLYPH_FIREBALL      = 1
000000r 2               GLYPH_BOLT          = 2
000000r 2               GLYPH_BOMB          = 3
000000r 2               GLYPH_STAR          = 4
000000r 2               GLYPH_GLOW          = 6         ; Match-flash frame. Potion colours only —
000000r 2                                               ;   WILD_BASE + GLYPH_GLOW is an arrow, not a
000000r 2                                               ;   glow, so the prism never takes this path.
000000r 2                                               ;   See PRISM_BLIP below and SPEC 4.4.
000000r 2               
000000r 2               ; --- Named tiles -------------------------------------------------------------
000000r 2               TILE_BLANK          = 0
000000r 2               TILE_BAR_H          = 1
000000r 2               TILE_BAR_V          = 2
000000r 2               TILE_COR_TL         = 3
000000r 2               TILE_COR_TR         = 4
000000r 2               TILE_COR_BL         = 5
000000r 2               TILE_COR_BR         = 6
000000r 2               TILE_WASH           = 7         ; PAUSE / dim wash, white
000000r 2               FONT_BASE           = 16        ; '0'..'9' then 'A'..'Z' then . x ! ~
000000r 2               FONT_DIGIT_0        = 16
000000r 2               FONT_LETTER_A       = 26
000000r 2               FONT_DOT            = 52        ; A CENTRED dot, not a baseline period — it is
000000r 2                                               ;   also frame 0 of the removal ring below
000000r 2               FONT_TIMES          = 53
000000r 2               FONT_BANG           = 54
000000r 2               FONT_TILDE          = 55        ; The banner ornament, ~~~LIKE THIS~~~
000000r 2               TEXT_END            = $FF       ; String terminator. Shares its value with
000000r 2                                               ;   TILE_WALL, which costs nothing: no string
000000r 2                                               ;   ever contains tile 255.
000000r 2               
000000r 2               ; The removal ring (SPEC 14). One animation, used for every removal there is:
000000r 2               ; the match shatter, the bomb blast, the star. It opens outward
000000r 2               ;
000000r 2               ;       FONT_DOT -> VFX_REMOVE1 -> VFX_REMOVE2 -> VFX_REMOVE3 -> empty
000000r 2               ;
000000r 2               ; and the prism's blip-out runs the same tiles closed inward (PRISM_BLIP).
000000r 2               VFX_REMOVE1         = 56
000000r 2               VFX_REMOVE2         = 57
000000r 2               VFX_REMOVE3         = 58
000000r 2               VFX_BEAM_H          = 59        ; The bolt's row
000000r 2               VFX_BEAM_V          = 60        ; The bolt's column
000000r 2               VFX_BEAM_CROSS      = 61        ; Drawn once, at the bolt's own cell
000000r 2               ARROW_UP            = 62        ; The title screen's controls (SPEC 13.1).
000000r 2               ARROW_DOWN          = 63        ;   Up and down live in group 7, left and
000000r 2               ARROW_LEFT          = 118       ;   right in group 14 — whichever white group
000000r 2               ARROW_RIGHT         = 119       ;   had a slot spare. Nothing indexes them.
000000r 2               
000000r 2               ; Group 14 is the prism's. Slots +0..+3 are its idle rotation and +4..+5 its
000000r 2               ; blip-out; there is no glow slot (SPEC A.3).
000000r 2               PRISM_SPIN          = WILD_BASE ; Four frames, WILD_BASE + 0..3
000000r 2               PRISM_SPIN_FRAMES   = 4
000000r 2               PRISM_BLIP          = WILD_BASE + 4     ; Two frames, then VFX_REMOVE2,
000000r 2                                                       ;   VFX_REMOVE1, FONT_DOT, empty
000000r 2               
000000r 2               ; Group 15 is the stone group: the petrified glyph set at the same offsets the
000000r 2               ; potions use, so a cell petrifies into its own shape —
000000r 2               ;
000000r 2               ;       petrified = PETRIFY_BASE + (tile & GLYPH_MASK)     for glyphs 0-4
000000r 2               ;
000000r 2               ; — and then the two tiles the margins are built from.
000000r 2               PETRIFY_BASE        = 120       ; +0 potion, +1 fireball, +2 bolt,
000000r 2                                               ;   +3 bomb, +4 star
000000r 2               TILE_RESERVED       = 125       ; Held for a sixth glyph, if one is ever added
000000r 2               TILE_SHELF          = 126       ; The shelf the panel stands on
000000r 2               TILE_BRICK          = 127       ; Brick — the margin fill
000000r 2               FRAME_DIM           = 8         ; Group 1 is group 0 byte for byte, one colour
000000r 2                                               ;   quieter, so frame_tile + FRAME_DIM is any
000000r 2                                               ;   frame piece's dim twin (SPEC A.3)
000000r 2               ART_BASE            = 128       ; Groups 16-31 — one hatch in sixteen colours,
000000r 2                                               ;   the title screen's magic field (SPEC 13.1)
000000r 2               ART_TILES           = 128
000000r 2               
000000r 2               ; --- Panel geometry (SPEC 12) ------------------------------------------------
000000r 2               ;   One 22 x 24 panel, rendered identically on all three machines. PANEL_Y is
000000r 2               ;   0 everywhere; only PANEL_X differs. The panel is vertically symmetric —
000000r 2               ;   backdrop row, band row, backdrop row, eighteen rows of frame, backdrop row,
000000r 2               ;   band row, backdrop row — which is why 24 is the height. The AC6502 is the
000000r 2               ;   exact fit; the VIC-20 clips panel row 23 off the bottom and the C64 has one
000000r 2               ;   spare screen row (24) below the panel. See SPEC 12.4.
000000r 2               PANEL_W             = 22
000000r 2               PANEL_H             = 24
000000r 2               
000000r 2               WELL_ORIGIN_X       = 1         ; Panel-relative: board (0,0) lives here
000000r 2               WELL_ORIGIN_Y       = 4
000000r 2               
000000r 2               SCORE_X             = 12        ; 7 digits, cols 12-18
000000r 2               SCORE_Y             = 5
000000r 2               HIGH_X              = 12        ; 7 digits, cols 12-18
000000r 2               HIGH_Y              = 10
000000r 2               HIGHLVL_X           = 15        ; Level the high score was set on, 2 digits;
000000r 2                                               ;   the 'L' at col 14 is in the static image
000000r 2               HIGHLVL_Y           = 11
000000r 2               LEVEL_X             = 18        ; Single column: tens above units
000000r 2               LEVEL_Y             = 17        ; Tens at LEVEL_Y, units at LEVEL_Y + 1
000000r 2               NEXT_X              = 11        ; Single tile column
000000r 2               NEXT_Y              = 16        ; Cells A, B, C at NEXT_Y, +1, +2
000000r 2               MSG_X               = 2         ; The band's OWNED cells. Panel columns 0-1 and
000000r 2               MSG_W               = 18        ;   20-21 of row 22 are shelf in the static
000000r 2               MSG_Y               = 22        ;   image and code never touches them; the
000000r 2                                               ;   banner still centres on the full PANEL_W,
000000r 2                                               ;   which lands in the same place for an
000000r 2                                               ;   even-length string (SPEC 12.2).
000000r 2               
000000r 2               SCORE_DIGITS        = 7         ; Always all 7 drawn, zero padded
000000r 2               LEVEL_DIGITS        = 2         ; Always zero padded — level 5 draws "0" / "5"
000000r 2               
000000r 2               ; --- Piece and timing (SPEC 5.6, 11.3, 14) -----------------------------------
000000r 2               ;   Every duration in the game is a frame count, and most of them differ
000000r 2               ;   between NTSC and PAL so that wall-clock speed matches. Those live in
000000r 2               ;   tables.inc as two-entry tables indexed by Region, not here — a constant
000000r 2               ;   that is not one number is not a constant. The ones below are the same on
000000r 2               ;   both machines.
000000r 2               LOCK_RESET_MAX      = 4         ; Horizontal moves that may reset the lock
000000r 2                                               ;   delay, per piece. Rotation never resets it.
000000r 2               FALL_FRAMES         = 2         ; Frames a row while the pile falls into the
000000r 2                                               ;   holes a clear left (SPEC 14). The one
000000r 2                                               ;   duration in the game that is the same on
000000r 2                                               ;   both regions, because SPEC 14 says so: at
000000r 2                                               ;   two frames there is nothing to round.
000000r 2               
000000r 2               ; --- Levels (SPEC 10) --------------------------------------------------------
000000r 2               LEVEL_TILES         = 30        ; Tiles cleared per level
000000r 2               LEVEL_SPEED_CAP     = 16        ; Speed stops improving here
000000r 2               LEVEL_MAX_SHOWN     = 99
000000r 2               
000000r 2               ; --- Scoring (SPEC 9) --------------------------------------------------------
000000r 2               BONUS_FIREBALL      = $0500     ; BCD
000000r 2               BONUS_BOLT          = $0300
000000r 2               BONUS_BOMB          = $0300
000000r 2               BONUS_PRISM         = $0400
000000r 2               BONUS_LEVELUP       = $1000
000000r 2               STAR_SHIFT_CAP      = 3         ; Three doublings — x8
000000r 2               HIGH_FLASH_BLINKS   = 6         ; Half-blinks of the HIGH field when the score
000000r 2                                               ;   overtakes it (SPEC 9.8) — three dark, three
000000r 2                                               ;   lit, ending lit. At SPEC 14's 30-frame
000000r 2                                               ;   blink period that is about a second and a
000000r 2                                               ;   half, and play never stops for it.
000000r 2               SCORE_BYTES         = 4         ; 8 nibbles packed BCD; the top one stays 0,
000000r 2                                               ;   so 7 digits show and the score wraps at
000000r 2                                               ;   10,000,000.
000000r 2               HIGH_INIT_LO        = $00       ; 0010000
000000r 2               HIGH_INIT_MID       = $00
000000r 2               HIGH_INIT_HI        = $01
000000r 2               HIGH_INIT_TOP       = $00
000000r 2               
000000r 2               ; --- Reagent probability, out of 256 (SPEC 5.3) ------------------------------
000000r 2               PSPECIAL_BANDS      = 5
000000r 2               
000000r 2               ; --- Input bitmask (SPEC 11.1) -----------------------------------------------
000000r 2               ;   Active HIGH. Each platform inverts and remaps its own hardware into this.
000000r 2               INPUT_UP            = %00000001 ; Rotate forward
000000r 2               INPUT_DOWN          = %00000010 ; Soft drop
000000r 2               INPUT_LEFT          = %00000100
000000r 2               INPUT_RIGHT         = %00001000
000000r 2               INPUT_FIRE          = %00010000 ; Rotate reverse / confirm
000000r 2               INPUT_PAUSE         = %00100000
000000r 2               INPUT_MASK          = %00111111 ; Everything the game reads. Bits 6-7 are free
000000r 2                                               ;   for a platform to use as scratch inside
000000r 2                                               ;   HalReadInput, as long as it strips them.
000000r 2               
000000r 2               ; --- Game states (SPEC 13) ---------------------------------------------------
000000r 2               STATE_TITLE         = 0
000000r 2               STATE_PLAY          = 1
000000r 2               STATE_PAUSE         = 2
000000r 2               STATE_GAMEOVER      = 3
000000r 2               
000000r 2               ; --- Play sub-states (SPEC 8) ------------------------------------------------
000000r 2               PLAY_FALLING        = 0
000000r 2               PLAY_LOCKING        = 1
000000r 2               PLAY_GLOW           = 2
000000r 2               PLAY_SHATTER        = 3
000000r 2               PLAY_GRAVITY        = 4
000000r 2               PLAY_ARE            = 5
000000r 2               
000000r 2               ; --- Buffer sizes (SPEC 17.1) ------------------------------------------------
000000r 2               MARKS_BYTES         = 16        ; One byte per row, bits 0-5
000000r 2               EFFECTQ_ENTRIES     = 48        ; ONE byte each — the board index of a pending
000000r 2               EFFECTQ_BYTES       = EFFECTQ_ENTRIES   ;   detonation, and nothing else.
000000r 2                                               ;   SPEC 8 budgeted two bytes for a packed
000000r 2                                               ;   glyph/row/column, which is a copy of what
000000r 2                                               ;   the board already holds: cells are not
000000r 2                                               ;   zeroed until step 6 and the queue is drained
000000r 2                                               ;   in step 4, so the tile is still there when
000000r 2                                               ;   the effect pops and its glyph and colour are
000000r 2                                               ;   one `lda Board,x` away. Half the RAM for
000000r 2                                               ;   nothing (SPEC 17.1).
000000r 2                                               ;   A ring keeps one slot free, so 47 pending
000000r 2                                               ;   detonations. On overflow an effect is
000000r 2                                               ;   dropped rather than growing the buffer (D6);
000000r 2                                               ;   at one reagent a piece it is not reachable.
000000r 2               DIRTY_ENTRIES       = 64        ; 3 bytes each: offset lo, offset hi, tile
000000r 2               DIRTY_BYTES         = DIRTY_ENTRIES * 3
000000r 2               DIRTY_FLUSH_MAX     = 24        ; Cells pushed to the screen per frame.
000000r 2                                               ;   MEASURED, not estimated (PLAN.md S1). A
000000r 2                                               ;   flush costs 165 cycles a cell on the
000000r 2                                               ;   AC6502 and about 132 on the Commodores, so
000000r 2                                               ;   24 cells is 3965 cycles — inside vertical
000000r 2                                               ;   blank on all three, and tightest on the
000000r 2                                               ;   AC6502 at 1 MHz, whose 70 blank lines are
000000r 2                                               ;   roughly 4450. It is also a quarter of the
000000r 2                                               ;   96-cell well, so a full redraw is exactly
000000r 2                                               ;   four frames.
000000r 2                                               ;   Overrunning vblank is not dangerous on any
000000r 2                                               ;   of the three — no VRAM write spacing is
000000r 2                                               ;   anywhere near violated (S1) — it only
000000r 2                                               ;   risks a cell landing a frame late. This is
000000r 2                                               ;   a budget, not a hardware limit.
000000r 2               
000000r 1               .include "../src/zeropage.inc"
000000r 2               ; =============================================================================
000000r 2               ;   zeropage.inc — Wizards Lab, zero page allocation
000000r 2               ; =============================================================================
000000r 2               ;   The ZEROPAGE segment is placed at $40 on every platform. That window is
000000r 2               ;   free on all three:
000000r 2               ;
000000r 2               ;     AC6502   $003A-$00FF free for user programs (6502.inc memory map)
000000r 2               ;     VIC-20   all of page zero, once the cartridge stops calling the KERNAL
000000r 2               ;     C64      all of page zero EXCEPT $00/$01, which are the processor port
000000r 2               ;
000000r 2               ;   Starting at $40 clears the C64's port bytes and the AC6502's system
000000r 2               ;   scratch with room to spare, and keeps one number in three linker configs.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               .segment "ZEROPAGE"
000000r 2               
000000r 2  xx xx        Ptr1:           .res 2      ; General pointer — free across any call boundary
000002r 2  xx xx        Ptr2:           .res 2      ; General pointer
000004r 2  xx xx        SrcPtr:         .res 2      ; Block copy source
000006r 2  xx xx        DstPtr:         .res 2      ; Block copy destination
000008r 2  xx xx        ScreenPtr:      .res 2      ; Current screen row base
00000Ar 2  xx xx        ColorPtr:       .res 2      ; Current colour RAM row base (Commodore only)
00000Cr 2               
00000Cr 2  xx           RngLo:          .res 1      ; 16-bit LFSR state — never both zero
00000Dr 2  xx           RngHi:          .res 1
00000Er 2               
00000Er 2  xx           Tmp0:           .res 1      ; Scratch. Never live across a JSR.
00000Fr 2  xx           Tmp1:           .res 1
000010r 2  xx           Tmp2:           .res 1
000011r 2  xx           Tmp3:           .res 1
000012r 2               
000012r 2               ; --- The match scanner (SPEC 6.2) --------------------------------------------
000012r 2               ;   One line of one pass at a time. The cursor is a BOARD INDEX rather than a
000012r 2               ;   row and a column, because all four passes are the same walk with a
000012r 2               ;   different step: +1 horizontal, +8 vertical, +9 diagonal, +7 anti-diagonal.
000012r 2  xx           ScanIdx:        .res 1      ; Where the cursor was when a run ended: ScanLine
000013r 2                                           ;   keeps it in X and spills it only here
000013r 2  xx           ScanStep:       .res 1      ; What to add to reach the next cell of this line
000014r 2  xx           ScanColor:      .res 1      ; Colour key of the run in progress ($FF = unset)
000015r 2  xx           ScanLen:        .res 1      ; Cells in it so far, wildcards included
000016r 2  xx           ScanEnd:        .res 1      ; Walk-back cursor while a finished run is marked
000017r 2  xx           ScanTop:        .res 1      ; Row base of the top of the pile. Every pass
000018r 2                                           ;   starts there rather than at row 0, which is
000018r 2                                           ;   most of the cost of a scan (match.asm)
000018r 2               
000018r 2               ; --- Board walks that call the renderer (SPEC 8 steps 6 and 8) ---------------
000018r 2               ;   RenderCell clobbers A, X and Y, so a walk that marks what it changes
000018r 2               ;   cannot keep its cursor in a register. GravIdx also has to survive from one
000018r 2               ;   frame to the next: a row of falling is a cursor and not a bulk enqueue,
000018r 2               ;   because a full well is more cells than the dirty ring holds (D12,
000018r 2               ;   SPEC 12.6).
000018r 2  xx           GravIdx:        .res 1      ; Cell the fall is walking up from, $FF when the
000019r 2                                           ;   row is finished
000019r 2  xx           GravMoved:      .res 1      ; Non-zero if this row of falling moved anything
00001Ar 2  xx           CellCount:      .res 1      ; Cells CascadeRemove has taken off the board
00001Br 2               
00001Br 2               ; --- Reagent effects (SPEC 7.3, SPEC 8 step 4) -------------------------------
00001Br 2               ;   EffectHit marks a cell, scores it and enqueues whatever it holds, so it
00001Br 2               ;   clobbers A, X and Y — which means a walk that offers it cells cannot keep
00001Br 2               ;   its cursor in a register either. Same reason GravIdx exists, and the same
00001Br 2               ;   reason these are not Tmp0-Tmp3: those are dead across a JSR.
00001Br 2  xx           EffectIdx:      .res 1      ; The cell the walk in progress is on
00001Cr 2  xx           EffectEnd:      .res 1      ; Where it stops. The bolt's row end, or the bomb's
00001Dr 2                                           ;   last row
00001Dr 2  xx           EffectRow:      .res 1      ; First cell of the bomb's current row
00001Er 2  xx           EffectArg:      .res 1      ; What the walk is looking for: the fireball's
00001Fr 2                                           ;   colour key, or the bomb's last column
00001Fr 2               
00001Fr 2               ; --- Render and text scratch -------------------------------------------------
00001Fr 2               ;   These ARE live across a JSR, unlike Tmp0-Tmp3, because text.asm calls
00001Fr 2               ;   RenderMark once per cell and has to remember where it is. That is safe
00001Fr 2               ;   only because RenderMark touches nothing here: it clobbers A, X and the
00001Fr 2               ;   stack and nothing else (see render.asm). Do not call anything else from a
00001Fr 2               ;   loop that holds one of these.
00001Fr 2  xx           TextCol:        .res 1      ; Panel column the next glyph goes in
000020r 2  xx           TextRow:        .res 1      ; Panel row the string is drawn on
000021r 2  xx           TextIdx:        .res 1      ; Cursor within the string, or the BCD byte index
000022r 2  xx           TextByte:       .res 1      ; The BCD byte being split into two digits
000023r 2  xx           TextSkip:       .res 1      ; Non-zero while the first high nibble is skipped
000024r 2  xx           FlushLeft:      .res 1      ; Cells left in this frame's flush budget
000025r 2  xx           RedrawCol:      .res 1      ; Panel column of the cell being marked. Shared by
000026r 2                                           ;   every routine that marks a run of cells in one
000026r 2                                           ;   column, because RenderMark clobbers X.
000026r 2               
000026r 1               .include "../src/ram.inc"
000026r 2               ; =============================================================================
000026r 2               ;   ram.inc — Wizards Lab, work RAM
000026r 2               ; =============================================================================
000026r 2               ;   SPEC.md section 17.1. Around 530 bytes, which is what lets the whole game
000026r 2               ;   fit the VIC-20's 1 KB of usable work RAM — the tightest of the three
000026r 2               ;   targets, and therefore the one the layout is designed against.
000026r 2               ;
000026r 2               ;   Every platform places the BSS segment somewhere different (see each
000026r 2               ;   linker config); nothing in this file cares where.
000026r 2               ; =============================================================================
000026r 2               
000026r 2               .segment "BSS"
000000r 2               
000000r 2               ; --- The board (SPEC 3.2) ----------------------------------------------------
000000r 2               ;   20 rows x 8 stride. Columns 6-7 of every row and rows 16-19 entirely are
000000r 2               ;   permanent $FF sentinels, so scans walk off the edge and stop by themselves.
000000r 2               ;   Page-align it: address(row,col) = Board + (row << 3) + col.
000000r 2               .align 256
000000r 2  xx xx xx xx  Board:          .res BOARD_BYTES
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
0000A0r 2               
0000A0r 2               ; --- Match / cascade state (SPEC 6.2, 8) -------------------------------------
0000A0r 2  xx xx xx xx  Marks:          .res MARKS_BYTES        ; One byte per row, bits 0-5 = columns
0000A4r 2  xx xx xx xx  
0000A8r 2  xx xx xx xx  
0000B0r 2  xx xx xx xx  EffectQ:        .res EFFECTQ_BYTES      ; Ring of pending reagent detonations —
0000B4r 2  xx xx xx xx  
0000B8r 2  xx xx xx xx  
0000E0r 2                                                       ;   the board INDEX of each, one byte,
0000E0r 2                                                       ;   because the tile is still on the
0000E0r 2                                                       ;   board when the entry pops
0000E0r 2                                                       ;   (constants.inc, SPEC 8)
0000E0r 2  xx           EffectQHead:    .res 1
0000E1r 2  xx           EffectQTail:    .res 1
0000E2r 2  xx           RunCount:       .res 1                  ; Runs resolved in the current step
0000E3r 2  xx           ChainStep:      .res 1                  ; 1 on the first step of a cascade
0000E4r 2  xx           StarCount:      .res 1                  ; Doublings pending, capped at 3
0000E5r 2  xx           CascadeLo:      .res 1                  ; Cascade point accumulator, packed BCD
0000E6r 2  xx           CascadeMid:     .res 1
0000E7r 2  xx           CascadeHi:      .res 1
0000E8r 2               
0000E8r 2               ; --- Render (SPEC 12.6) ------------------------------------------------------
0000E8r 2               ;   A ring of DIRTY_ENTRIES cells waiting to be pushed to the screen, three
0000E8r 2               ;   bytes each: SCREEN column, SCREEN row, tile. Not a 16-bit screen offset —
0000E8r 2               ;   HalPlotCell takes a column and a row (hal.inc), and every platform reaches
0000E8r 2               ;   a cell through a per-row pointer table (SPEC 12.3), so an offset would only
0000E8r 2               ;   have to be taken apart again at the far end.
0000E8r 2               ;
0000E8r 2               ;   A ring rather than a list with a resume index, because a frame that flushes
0000E8r 2               ;   its cap leaves a remainder and the next frame's marks have to go somewhere.
0000E8r 2               ;   Head and tail are BYTE offsets into Dirty, not entry numbers, so stepping
0000E8r 2               ;   one entry is an add of 3 and never a multiply.
0000E8r 2  xx xx xx xx  Dirty:          .res DIRTY_BYTES        ; screen col, screen row, tile
0000ECr 2  xx xx xx xx  
0000F0r 2  xx xx xx xx  
0001A8r 2  xx           DirtyCount:     .res 1                  ; Entries pending, 0..DIRTY_ENTRIES
0001A9r 2  xx           DirtyHead:      .res 1                  ; Byte offset of the oldest pending
0001AAr 2  xx           DirtyTail:      .res 1                  ; Byte offset the next mark goes to
0001ABr 2  xx           RedrawIdx:      .res 1                  ; Board index RenderBoardStep resumes
0001ACr 2                                                       ;   at, or $FF when no redraw is
0001ACr 2                                                       ;   outstanding
0001ACr 2               
0001ACr 2               ; --- The falling piece (SPEC 5) ----------------------------------------------
0001ACr 2  xx           PieceCol:       .res 1
0001ADr 2  xx           PieceRow:       .res 1                  ; Row of cell A (the top cell)
0001AEr 2  xx           PieceA:         .res 1                  ; Tile bytes, top to bottom
0001AFr 2  xx           PieceB:         .res 1
0001B0r 2  xx           PieceC:         .res 1
0001B1r 2  xx           NextA:          .res 1                  ; The preview piece
0001B2r 2  xx           NextB:          .res 1
0001B3r 2  xx           NextC:          .res 1
0001B4r 2  xx           PieceDirty:     .res 1                  ; Non-zero when the three cells need
0001B5r 2                                                       ;   drawing. Not drawn on the spot,
0001B5r 2                                                       ;   because a full-board redraw may be
0001B5r 2                                                       ;   in flight and would paint over
0001B5r 2                                                       ;   them — see StatePlay (D14).
0001B5r 2               
0001B5r 2               ; --- Progress (SPEC 9, 10) ---------------------------------------------------
0001B5r 2  xx           ScoreLo:        .res 1                  ; 7 digits packed BCD, low byte first;
0001B6r 2  xx           ScoreMid:       .res 1                  ;   the top nibble of ScoreTop stays 0
0001B7r 2  xx           ScoreHi:        .res 1
0001B8r 2  xx           ScoreTop:       .res 1
0001B9r 2  xx           HighLo:         .res 1
0001BAr 2  xx           HighMid:        .res 1
0001BBr 2  xx           HighHi:         .res 1
0001BCr 2  xx           HighTop:        .res 1
0001BDr 2  xx           HighLevel:      .res 1                  ; Level the high score was set on, BCD
0001BEr 2  xx           HighOwned:      .res 1                  ; Non-zero once THIS game has taken the
0001BFr 2                                                       ;   high score. From the overtake on,
0001BFr 2                                                       ;   score and high score are equal and
0001BFr 2                                                       ;   every bank copies again, so without
0001BFr 2                                                       ;   this the one-shot fanfare and flash
0001BFr 2                                                       ;   would fire on every one (SPEC 9.8)
0001BFr 2  xx           HighFlash:      .res 1                  ; Half-blinks of the HIGH field left to
0001C0r 2                                                       ;   run. Odd = dark, even = lit, and it
0001C0r 2                                                       ;   ends at zero, so the field is always
0001C0r 2                                                       ;   left readable
0001C0r 2  xx           HighTimer:      .res 1                  ; Frames until the next half-blink
0001C1r 2  xx           Level:          .res 1                  ; Binary, 1-99
0001C2r 2  xx           TilesCleared:   .res 1                  ; Toward the next level, carries past 30
0001C3r 2               
0001C3r 2               ; --- Timers, all in frames (SPEC 14) -----------------------------------------
0001C3r 2  xx           GravityTimer:   .res 1
0001C4r 2  xx           LockTimer:      .res 1
0001C5r 2  xx           LockResets:     .res 1
0001C6r 2  xx           DasTimer:       .res 1
0001C7r 2  xx           DasDir:         .res 1
0001C8r 2  xx           AreTimer:       .res 1
0001C9r 2  xx           AnimTimer:      .res 1
0001CAr 2  xx           BannerTimer:    .res 1
0001CBr 2  xx           FrameCounter:   .res 1                  ; Free-running from power-on; seeds RNG
0001CCr 2               
0001CCr 2               ; --- Input (SPEC 11.1) -------------------------------------------------------
0001CCr 2  xx           InputNow:       .res 1
0001CDr 2  xx           InputPrev:      .res 1
0001CEr 2  xx           InputEdge:      .res 1                  ; Newly pressed this frame
0001CFr 2               
0001CFr 2               ; --- State machine (SPEC 13) -------------------------------------------------
0001CFr 2  xx           GameState:      .res 1                  ; STATE_*
0001D0r 2  xx           PlayState:      .res 1                  ; PLAY_*
0001D1r 2  xx           TitlePage:      .res 1
0001D2r 2  xx           Region:         .res 1                  ; 0 = NTSC, 1 = PAL
0001D3r 2  xx           NeedsRedraw:    .res 1
0001D4r 2               
0001D4r 2               ; --- Audio (SPEC 16) ---------------------------------------------------------
0001D4r 2  xx           SfxRequest:     .res 1                  ; Written by logic, consumed by AudioTick
0001D5r 2  xx           SfxTimer:       .res 1
0001D6r 2  xx xx xx xx  SfxState:       .res 14
0001DAr 2  xx xx xx xx  
0001DEr 2  xx xx xx xx  
0001E4r 2               
0001E4r 1               .include "../src/hal.inc"
0001E4r 2               ; =============================================================================
0001E4r 2               ;   hal.inc — Wizards Lab, the platform contract
0001E4r 2               ; =============================================================================
0001E4r 2               ;   Everything in src/ is shared, unmodified, by all three machines. The only
0001E4r 2               ;   things that differ are collected here: each platform's WizardsLab.asm must
0001E4r 2               ;   define these constants and implement these seven routines, and nothing
0001E4r 2               ;   else in src/ may touch hardware directly.
0001E4r 2               ;
0001E4r 2               ;   This file declares nothing. It is the documentation for the boundary, kept
0001E4r 2               ;   next to the code it constrains so it cannot drift out of date unnoticed.
0001E4r 2               ;
0001E4r 2               ;   CONSTANTS the platform must define BEFORE including the shared sources
0001E4r 2               ;   ---------------------------------------------------------------------
0001E4r 2               ;     PANEL_X, PANEL_Y      Where the 22 x 24 panel sits on this screen.
0001E4r 2               ;                             AC6502  5, 0      VIC-20  0, 0      C64  9, 0
0001E4r 2               ;                           PANEL_Y is 0 everywhere; the VIC-20 clips panel
0001E4r 2               ;                           row 23 and the C64 has one spare row below it.
0001E4r 2               ;     SCR_COLS           32 / 22 / 40
0001E4r 2               ;     SCR_ROWS           24 / 23 / 25
0001E4r 2               ;     HAS_COLOR_RAM         1 on the Commodores, 0 on the AC6502, whose colour
0001E4r 2               ;                           lives in the VDP colour table instead.
0001E4r 2               ;
0001E4r 2               ;   ROUTINES the platform must implement
0001E4r 2               ;   ------------------------------------
0001E4r 2               ;     HalInitVideo      Bring up the video hardware: black background and
0001E4r 2               ;                       border, the correct text/tile mode, tileset in place,
0001E4r 2               ;                       colours configured, screen cleared. Called once.
0001E4r 2               ;                       In:  nothing        Out: nothing
0001E4r 2               ;
0001E4r 2               ;     HalWaitFrame      Block until the start of the next vertical blank.
0001E4r 2               ;                       Everything below is called only between frames.
0001E4r 2               ;                       In:  nothing        Out: nothing
0001E4r 2               ;
0001E4r 2               ;     HalPlotCell       Write one cell, colour included where the platform has
0001E4r 2               ;                       per-cell colour.
0001E4r 2               ;                       In:  A = tile, X = screen column, Y = screen row
0001E4r 2               ;                       Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
0001E4r 2               ;
0001E4r 2               ;     HalBlitScreen     Draw a whole static screen from a name-table image in
0001E4r 2               ;                       ROM: SCR_COLS * SCR_ROWS bytes, row-major, plus
0001E4r 2               ;                       the matching colour image where the platform needs one.
0001E4r 2               ;                       In:  SrcPtr -> name table, Ptr1 -> colour table
0001E4r 2               ;                       Out: nothing
0001E4r 2               ;
0001E4r 2               ;     HalReadInput      Read stick and keyboard, fold both into one mask.
0001E4r 2               ;                       In:  nothing
0001E4r 2               ;                       Out: A = INPUT_* bits, ACTIVE HIGH
0001E4r 2               ;
0001E4r 2               ;     HalDetectRegion   Decide NTSC or PAL so the timing tables can be picked.
0001E4r 2               ;                       In:  nothing        Out: A = 0 NTSC, 1 PAL
0001E4r 2               ;
0001E4r 2               ;     HalSfx            Start a sound effect. May be a bare RTS until audio
0001E4r 2               ;                       exists.
0001E4r 2               ;                       In:  A = effect id (SPEC 16)
0001E4r 2               ;                       Out: nothing
0001E4r 2               ;
0001E4r 2               ;   The shared code assumes nothing about interrupts. Each platform may drive
0001E4r 2               ;   HalWaitFrame from a raster IRQ, a timer, or a status-register poll.
0001E4r 2               ; =============================================================================
0001E4r 2               
0001E4r 1               
0001E4r 1               ; =============================================================================
0001E4r 1               ;   Cartridge header — BLK5, $A000
0001E4r 1               ; =============================================================================
0001E4r 1               
0001E4r 1               .segment "CARTHDR"
000000r 1               
000000r 1  rr rr        .addr ColdStart                 ; Cold start vector
000002r 1  rr rr        .addr ColdStart                 ; Warm start vector (RESTORE = full restart)
000004r 1  41 30 C3 C2  .byte $41, $30, $C3, $C2, $CD   ; "A0CBM" autostart signature
000008r 1  CD           
000009r 1               
000009r 1               ; =============================================================================
000009r 1               ;   Entry
000009r 1               ; =============================================================================
000009r 1               
000009r 1               .segment "CODE"
000000r 1               
000000r 1               ColdStart:
000000r 1  78             sei
000001r 1  D8             cld
000002r 1  A2 FF          ldx #$FF
000004r 1  9A             txs                           ; Nothing did this for us
000005r 1               
000005r 1  20 rr rr       jsr GameInit                  ; Never returns
000008r 1               
000008r 1               ; --- Shared game code --------------------------------------------------------
000008r 1               .include "../src/main.asm"
000008r 2               ; =============================================================================
000008r 2               ;   main.asm — Wizards Lab, shared entry point and main loop
000008r 2               ; =============================================================================
000008r 2               ;   Included by every platform's WizardsLab.asm after that file has defined
000008r 2               ;   PANEL_X / PANEL_Y and its half of the HAL (see hal.inc). Nothing below
000008r 2               ;   touches hardware.
000008r 2               ;
000008r 2               ;   BUILD STATUS
000008r 2               ;   ------------
000008r 2               ;   Pieces spawn, steer, rotate, fall and lock, runs of three or more clear,
000008r 2               ;   the pile falls into the holes, chains keep going until nothing matches, all
000008r 2               ;   of it scores and ramps the level, and the five reagents fire and set each
000008r 2               ;   other off (PLAN.md P2, P3, P4, P5). The clear is still instant: GLOW and
000008r 2               ;   SHATTER are P6's, and slot into CascadeEnter between the scan and the fall.
000008r 2               ; =============================================================================
000008r 2               
000008r 2               ; -----------------------------------------------------------------------------
000008r 2               ;   GameInit — one-time setup, called from the cartridge entry point
000008r 2               ; -----------------------------------------------------------------------------
000008r 2               GameInit:
000008r 2  20 rr rr       jsr HalDetectRegion
00000Br 2  8D rr rr       sta Region
00000Er 2               
00000Er 2  20 rr rr       jsr HalInitVideo              ; Tiles in place, screen black and cleared
000011r 2  20 rr rr       jsr AudioInit
000014r 2  20 rr rr       jsr RenderDirtyReset
000017r 2               
000017r 2  A9 00          lda #0
000019r 2  8D rr rr       sta FrameCounter
00001Cr 2  20 rr rr       jsr RngSeed                   ; A zero LFSR state sticks at zero forever, and
00001Fr 2                                               ;   BSS is not cleared on all three machines, so
00001Fr 2                                               ;   seed it once here just to get it out of that
00001Fr 2                                               ;   hole. This is NOT the game's seed — SPEC 15
00001Fr 2                                               ;   forbids a constant one, and StateTitle
00001Fr 2                                               ;   reseeds from the player's reaction time
00001Fr 2                                               ;   before the first piece is ever rolled.
00001Fr 2  A9 00          lda #0
000021r 2  8D rr rr       sta InputNow
000024r 2  8D rr rr       sta InputPrev
000027r 2  8D rr rr       sta InputEdge
00002Ar 2  8D rr rr       sta TitlePage
00002Dr 2               
00002Dr 2  20 rr rr       jsr ScoreHighInit             ; Once a session, before the first ScoreReset
000030r 2  20 rr rr       jsr ScoreReset
000033r 2  20 rr rr       jsr BoardClear
000036r 2               
000036r 2               .ifdef WL_DEBUG
000036r 2                 jsr GameStart                 ; TEMPORARY: skip the title and start playing,
000036r 2                                               ;   because a headless machine has no input
000036r 2                                               ;   attached and would sit on the title screen
000036r 2                                               ;   forever. Nothing else about the build
000036r 2                                               ;   differs any more (PLAN.md section 3).
000036r 2               .else
000036r 2  A9 00          lda #STATE_TITLE
000038r 2  8D rr rr       sta GameState
00003Br 2  A9 01          lda #1
00003Dr 2  8D rr rr       sta NeedsRedraw
000040r 2               .endif
000040r 2                 ; falls through into GameLoop
000040r 2               
000040r 2               ; -----------------------------------------------------------------------------
000040r 2               ;   GameLoop — never returns
000040r 2               ; -----------------------------------------------------------------------------
000040r 2               GameLoop:
000040r 2  20 rr rr       jsr HalWaitFrame
000043r 2  EE rr rr       inc FrameCounter              ; Free-running from power-on; seeds the RNG
000046r 2               
000046r 2  20 rr rr       jsr RenderFlush               ; Screen writes happen in vertical blank only
000049r 2  20 rr rr       jsr InputPoll
00004Cr 2               
00004Cr 2  AD rr rr       lda GameState                 ; Dispatch on the current screen state
00004Fr 2  C9 00          cmp #STATE_TITLE
000051r 2  F0 0E          beq @Title
000053r 2  C9 01          cmp #STATE_PLAY
000055r 2  F0 10          beq @Play
000057r 2  C9 02          cmp #STATE_PAUSE
000059r 2  F0 12          beq @Pause
00005Br 2  20 rr rr       jsr StateGameOver             ; JSR, not JMP — every state handler ends in an
00005Er 2  4C rr rr       jmp @Audio                    ;   RTS, and a JMP here would hand that RTS the
000061r 2                                               ;   return address of the JSR GameInit that the
000061r 2                                               ;   cart entry point never expects back. The
000061r 2                                               ;   first loss unwound the loop into GameInit;
000061r 2                                               ;   the second pulled from an empty stack.
000061r 2               
000061r 2               @Title:
000061r 2  20 rr rr       jsr StateTitle
000064r 2  4C rr rr       jmp @Audio
000067r 2               @Play:
000067r 2  20 rr rr       jsr StatePlay
00006Ar 2  4C rr rr       jmp @Audio
00006Dr 2               @Pause:
00006Dr 2  20 rr rr       jsr StatePause
000070r 2               
000070r 2               @Audio:
000070r 2  20 rr rr       jsr AudioTick
000073r 2  4C rr rr       jmp GameLoop
000076r 2               
000076r 2               ; =============================================================================
000076r 2               ;   States (SPEC 13)
000076r 2               ; =============================================================================
000076r 2               
000076r 2               ; -----------------------------------------------------------------------------
000076r 2               ;   StateTitle — blinking prompt over the drawn screen, and the magic field
000076r 2               ;   SPEC 13.1. There are no help pages: the controls are part of the screen
000076r 2               ;   image, so the only things moving here are the prompt and the field.
000076r 2               ; -----------------------------------------------------------------------------
000076r 2               StateTitle:
000076r 2  AD rr rr       lda NeedsRedraw
000079r 2  F0 0B          beq @Live
00007Br 2  A9 00          lda #0
00007Dr 2  8D rr rr       sta NeedsRedraw
000080r 2  20 rr rr       jsr DrawTitleScreen
000083r 2  20 rr rr       jsr RenderDirtyReset          ; A full blit went behind the renderer's back
000086r 2               
000086r 2               @Live:
000086r 2                 ; TODO: blink the prompt every 30 frames, and shimmer the magic field —
000086r 2                 ; one NextRandom for a cell in the 14 x 2 block, one for a tile in
000086r 2                 ; ART_BASE..ART_BASE+ART_TILES-1, one RenderMark.
000086r 2  AD rr rr       lda InputEdge
000089r 2  29 11          and #(INPUT_FIRE | INPUT_UP)  ; Fire, or SPACE, which the keyboards fold
00008Br 2  F0 06          beq @Done                     ;   into UP so it can rotate in play (D15)
00008Dr 2               
00008Dr 2  20 rr rr       jsr RngSeed                   ; SPEC 15 — seed from reaction time, not a constant
000090r 2  20 rr rr       jsr GameStart
000093r 2               @Done:
000093r 2  60             rts
000094r 2               
000094r 2               ; -----------------------------------------------------------------------------
000094r 2               ;   GameStart — enter play from the title screen
000094r 2               ; -----------------------------------------------------------------------------
000094r 2               GameStart:
000094r 2  20 rr rr       jsr ScoreReset
000097r 2  20 rr rr       jsr BoardClear
00009Ar 2               
00009Ar 2  A9 01          lda #1
00009Cr 2  8D rr rr       sta Level
00009Fr 2  A9 00          lda #0
0000A1r 2  8D rr rr       sta TilesCleared
0000A4r 2  8D rr rr       sta DasDir                    ; No direction is held into a new game
0000A7r 2  8D rr rr       sta DasTimer
0000AAr 2  8D rr rr       sta PieceDirty
0000ADr 2               
0000ADr 2  20 rr rr       jsr DrawPlayScreen            ; The whole screen at once, behind the
0000B0r 2  20 rr rr       jsr RenderDirtyReset          ;   renderer's back — so drop anything queued
0000B3r 2                                               ;   against the screen that just went away
0000B3r 2               
0000B3r 2  20 rr rr       jsr TextBannerClear           ; The play image ships with the band reading
0000B6r 2                                               ;   `~~ PAUSED ~~` (SPEC 12.1); play owns it
0000B6r 2  20 rr rr       jsr RenderScore               ; The panel fields are code's, not the image's
0000B9r 2  20 rr rr       jsr RenderHigh
0000BCr 2  20 rr rr       jsr RenderLevel
0000BFr 2  20 rr rr       jsr RenderBoard               ; Queued across as many frames as it takes
0000C2r 2               
0000C2r 2  20 rr rr       jsr PieceGenerateNext         ; Fill the preview...
0000C5r 2  20 rr rr       jsr PieceSpawn                ; ...then promote it and refill. The board is
0000C8r 2  20 rr rr       jsr PieceGenerateNext         ;   empty, so the spawn cannot be blocked.
0000CBr 2  20 rr rr       jsr RenderNext
0000CEr 2               
0000CEr 2  A9 00          lda #PLAY_FALLING
0000D0r 2  8D rr rr       sta PlayState
0000D3r 2  A9 01          lda #STATE_PLAY
0000D5r 2  8D rr rr       sta GameState
0000D8r 2  60             rts
0000D9r 2               
0000D9r 2               ; -----------------------------------------------------------------------------
0000D9r 2               ;   StatePlay — the game
0000D9r 2               ;   SPEC 13.2. One frame is: advance whatever the play sub-state is doing,
0000D9r 2               ;   then queue whatever changed. Cascades run as sub-states rather than in a
0000D9r 2               ;   blocking loop so animation stays on the frame clock.
0000D9r 2               ; -----------------------------------------------------------------------------
0000D9r 2               StatePlay:
0000D9r 2  20 rr rr       jsr ScoreFlashTick            ; SPEC 9.8 — the HIGH field blinking after an
0000DCr 2                                               ;   overtake. Play never stops for it, so it
0000DCr 2                                               ;   ticks alongside whatever the sub-state is
0000DCr 2                                               ;   doing rather than inside one.
0000DCr 2  AD rr rr       lda InputEdge
0000DFr 2  29 20          and #INPUT_PAUSE
0000E1r 2  D0 3E          bne @ToPause
0000E3r 2               
0000E3r 2  AD rr rr       lda PlayState
0000E6r 2  C9 00          cmp #PLAY_FALLING
0000E8r 2  F0 0F          beq @Falling
0000EAr 2  C9 01          cmp #PLAY_LOCKING
0000ECr 2  F0 11          beq @Locking
0000EEr 2  C9 04          cmp #PLAY_GRAVITY
0000F0r 2  F0 13          beq @Gravity
0000F2r 2  C9 05          cmp #PLAY_ARE
0000F4r 2  F0 15          beq @Are
0000F6r 2  4C rr rr       jmp @Draw                     ; GLOW and SHATTER are P6's
0000F9r 2               
0000F9r 2               @Falling:
0000F9r 2  20 rr rr       jsr PlayFalling
0000FCr 2  4C rr rr       jmp @Draw
0000FFr 2               @Locking:
0000FFr 2  20 rr rr       jsr PlayLocking
000102r 2  4C rr rr       jmp @Draw
000105r 2               @Gravity:
000105r 2  20 rr rr       jsr PlayGravity
000108r 2  4C rr rr       jmp @Draw
00010Br 2               @Are:
00010Br 2  20 rr rr       jsr PlayAre
00010Er 2               
00010Er 2                 ; --- draw the piece, once whatever else wanted the screen has finished ----
00010Er 2                 ;   D14. RenderBoard is a cursor that feeds the ring over several frames
00010Er 2                 ;   (D12), so marks made while one is outstanding are drawn BEFORE the
00010Er 2                 ;   redraw reaches those cells and are then painted over. Holding the piece
00010Er 2                 ;   back until the redraw has finished is one byte and always right; the
00010Er 2                 ;   alternative is a piece that vanishes for four frames after every pause.
00010Er 2               @Draw:
00010Er 2  AD rr rr       lda PieceDirty
000111r 2  F0 0D          beq @Done
000113r 2  AD rr rr       lda RedrawIdx
000116r 2  10 08          bpl @Done                     ; A board redraw is still in flight
000118r 2  A9 00          lda #0
00011Ar 2  8D rr rr       sta PieceDirty
00011Dr 2  20 rr rr       jsr RenderPiece
000120r 2               @Done:
000120r 2  60             rts
000121r 2               
000121r 2               @ToPause:
000121r 2  A9 02          lda #STATE_PAUSE
000123r 2  8D rr rr       sta GameState
000126r 2  A9 rr          lda #<MsgPaused               ; SPEC 12.2 — without this the screen does not
000128r 2  85 rr          sta Ptr1                      ;   change at all on a pause, and a paused game
00012Ar 2  A9 rr          lda #>MsgPaused               ;   is indistinguishable from a hung one
00012Cr 2  85 rr          sta Ptr1+1
00012Er 2  20 rr rr       jsr TextBanner
000131r 2                 ; TODO (P7): wash the well with TILE_WASH so a pause cannot be used to study
000131r 2                 ; the board (13.3). A wash, not a blank — a blanked well reads as crashed.
000131r 2  60             rts
000132r 2               
000132r 2               ; -----------------------------------------------------------------------------
000132r 2               ;   PlayFalling — steer the piece, and drop it a row when the timer runs out
000132r 2               ;   SPEC 5.5, 5.6, 11.3
000132r 2               ; -----------------------------------------------------------------------------
000132r 2               PlayFalling:
000132r 2  20 rr rr       jsr PieceControl              ; Rotation and DAS; the result is ignored here
000135r 2                                               ;   because there is no lock delay to reset yet
000135r 2  20 rr rr       jsr PieceFallRate
000138r 2  85 rr          sta Tmp0
00013Ar 2  AD rr rr       lda GravityTimer              ; Pressing DOWN mid-wait must shorten the wait
00013Dr 2  C5 rr          cmp Tmp0                      ;   in progress, not just the next one
00013Fr 2  90 05          bcc @Tick
000141r 2  A5 rr          lda Tmp0
000143r 2  8D rr rr       sta GravityTimer
000146r 2               @Tick:
000146r 2  CE rr rr       dec GravityTimer
000149r 2  D0 1E          bne @Done
00014Br 2  20 rr rr       jsr PieceStep
00014Er 2  B0 0B          bcs @Land
000150r 2  20 rr rr       jsr PieceFallRate             ; ...and C tells us whose rate the row that
000153r 2  8D rr rr       sta GravityTimer              ;   just fell used. STA leaves it alone.
000156r 2  B0 11          bcs @Done
000158r 2  4C rr rr       jmp ScoreSoftDrop             ; SPEC 9.6 — one point, one row
00015Br 2               
00015Br 2               @Land:
00015Br 2  AE rr rr       ldx Region
00015Er 2  BD rr rr       lda LockDelay,x
000161r 2  8D rr rr       sta LockTimer
000164r 2  A9 01          lda #PLAY_LOCKING
000166r 2  8D rr rr       sta PlayState
000169r 2               @Done:
000169r 2  60             rts
00016Ar 2               
00016Ar 2               ; -----------------------------------------------------------------------------
00016Ar 2               ;   PlayLocking — the lock delay, and the moves that may reset it
00016Ar 2               ;   SPEC 5.6 — a horizontal move resets the delay LOCK_RESET_MAX times; after
00016Ar 2               ;   that it runs out regardless. Rotation never resets it. A move that opens a
00016Ar 2               ;   gap underneath resumes falling, and the reset count carries.
00016Ar 2               ; -----------------------------------------------------------------------------
00016Ar 2               PlayLocking:
00016Ar 2  20 rr rr       jsr PieceControl
00016Dr 2  90 13          bcc @Settled
00016Fr 2  AD rr rr       lda LockResets
000172r 2  C9 04          cmp #LOCK_RESET_MAX
000174r 2  B0 0C          bcs @Settled
000176r 2  EE rr rr       inc LockResets
000179r 2  AE rr rr       ldx Region
00017Cr 2  BD rr rr       lda LockDelay,x
00017Fr 2  8D rr rr       sta LockTimer
000182r 2               
000182r 2               @Settled:
000182r 2  20 rr rr       jsr PieceCanFall
000185r 2  90 0C          bcc @Tick
000187r 2  A9 00          lda #PLAY_FALLING             ; It moved over a hole — fall again. SPEC 5.6
000189r 2  8D rr rr       sta PlayState                 ;   says the lock counter clears here and the
00018Cr 2                                               ;   reset count does not; nothing reads
00018Cr 2                                               ;   LockTimer while falling and the next
00018Cr 2                                               ;   landing loads it fresh, so it is already
00018Cr 2                                               ;   clear in every sense that matters.
00018Cr 2  20 rr rr       jsr PieceFallRate
00018Fr 2  8D rr rr       sta GravityTimer
000192r 2  60             rts
000193r 2               
000193r 2               @Tick:
000193r 2  CE rr rr       dec LockTimer
000196r 2  D0 09          bne @Done
000198r 2  20 rr rr       jsr PieceLock
00019Br 2  20 rr rr       jsr CascadeBegin              ; SPEC 8 — the cascade starts the moment the
00019Er 2  4C rr rr       jmp CascadeEnter              ;   piece is board, and runs as sub-states
0001A1r 2               @Done:
0001A1r 2  60             rts
0001A2r 2               
0001A2r 2               ; -----------------------------------------------------------------------------
0001A2r 2               ;   CascadeEnter — run one cascade step and choose the sub-state after it
0001A2r 2               ;   In:  ChainStep set        Out: PlayState set.  Modifies: A, X, Y
0001A2r 2               ;   SPEC 8, D4. Called from the lock, and again from the bottom of every fall.
0001A2r 2               ;
0001A2r 2               ;   A step that clears something hands over to PLAY_GRAVITY; a step that finds
0001A2r 2               ;   nothing is where the cascade settles and the next piece is queued. P6
0001A2r 2               ;   inserts PLAY_GLOW and PLAY_SHATTER ahead of the fall without changing
0001A2r 2               ;   either branch.
0001A2r 2               ; -----------------------------------------------------------------------------
0001A2r 2               CascadeEnter:
0001A2r 2  20 rr rr       jsr CascadeStep
0001A5r 2  90 09          bcc @Settle
0001A7r 2               
0001A7r 2  20 rr rr       jsr BoardGravityBegin         ; Something went; let what was above it fall
0001AAr 2  A9 04          lda #PLAY_GRAVITY
0001ACr 2  8D rr rr       sta PlayState
0001AFr 2  60             rts
0001B0r 2               
0001B0r 2               @Settle:
0001B0r 2  20 rr rr       jsr CascadeSettle             ; The star multiplier and the bank (SPEC 8
0001B3r 2                                               ;   SETTLE); P6 raises the chain banner
0001B3r 2  AE rr rr       ldx Region
0001B6r 2  BD rr rr       lda AreDelay,x
0001B9r 2  8D rr rr       sta AreTimer
0001BCr 2  A9 05          lda #PLAY_ARE
0001BEr 2  8D rr rr       sta PlayState
0001C1r 2  60             rts
0001C2r 2               
0001C2r 2               ; -----------------------------------------------------------------------------
0001C2r 2               ;   PlayGravity — the pile falls into the holes the clear left
0001C2r 2               ;   SPEC 8 step 8, SPEC 14 — a row every FALL_FRAMES, and when a row moves
0001C2r 2               ;   nothing the board has settled and the next step scans it.
0001C2r 2               ;
0001C2r 2               ;   The row itself may take more than one frame: BoardGravityStep is a cursor
0001C2r 2               ;   that stops when the dirty ring is full (board.asm). The beat only starts
0001C2r 2               ;   once the row has actually landed, so a heavy board falls a little slower
0001C2r 2               ;   rather than losing cells off the screen.
0001C2r 2               ; -----------------------------------------------------------------------------
0001C2r 2               PlayGravity:
0001C2r 2  A5 rr          lda GravIdx
0001C4r 2  10 0C          bpl @Working                  ; A row is still coming down
0001C6r 2               
0001C6r 2  CE rr rr       dec AnimTimer
0001C9r 2  D0 11          bne @Done
0001CBr 2  A5 rr          lda GravMoved
0001CDr 2  F0 0E          beq @Landed                   ; The last row moved nothing: everything is
0001CFr 2  20 rr rr       jsr BoardGravityBegin         ;   resting on something
0001D2r 2               
0001D2r 2               @Working:
0001D2r 2  20 rr rr       jsr BoardGravityStep
0001D5r 2  90 05          bcc @Done                     ; The ring filled — the rest waits for a flush
0001D7r 2  A9 02          lda #FALL_FRAMES              ; The row is down; hold it there for the beat
0001D9r 2  8D rr rr       sta AnimTimer
0001DCr 2               @Done:
0001DCr 2  60             rts
0001DDr 2               
0001DDr 2               @Landed:
0001DDr 2  EE rr rr       inc ChainStep                 ; SPEC 8 step 9
0001E0r 2  4C rr rr       jmp CascadeEnter
0001E3r 2               
0001E3r 2               ; -----------------------------------------------------------------------------
0001E3r 2               ;   PlayAre — the entry delay, then the next piece
0001E3r 2               ;   SPEC 5.6, 13.4 — a blocked spawn is game over.
0001E3r 2               ; -----------------------------------------------------------------------------
0001E3r 2               PlayAre:
0001E3r 2  CE rr rr       dec AreTimer
0001E6r 2  D0 10          bne @Done
0001E8r 2  20 rr rr       jsr PieceSpawn
0001EBr 2  B0 0C          bcs @Over
0001EDr 2  20 rr rr       jsr PieceGenerateNext
0001F0r 2  20 rr rr       jsr RenderNext
0001F3r 2  A9 00          lda #PLAY_FALLING
0001F5r 2  8D rr rr       sta PlayState
0001F8r 2               @Done:
0001F8r 2  60             rts
0001F9r 2               
0001F9r 2               @Over:
0001F9r 2  A9 03          lda #STATE_GAMEOVER           ; P7 owns the petrify animation; for now the
0001FBr 2  8D rr rr       sta GameState                 ;   game simply stops
0001FEr 2  60             rts
0001FFr 2               
0001FFr 2               ; -----------------------------------------------------------------------------
0001FFr 2               ;   StatePause
0001FFr 2               ; -----------------------------------------------------------------------------
0001FFr 2               StatePause:
0001FFr 2  AD rr rr       lda InputEdge
000202r 2  29 30          and #(INPUT_PAUSE | INPUT_FIRE)
000204r 2  F0 17          beq @Done
000206r 2  A9 01          lda #STATE_PLAY
000208r 2  8D rr rr       sta GameState
00020Br 2  20 rr rr       jsr TextBannerClear           ; The banner comes down...
00020Er 2  20 rr rr       jsr RenderBoard               ; ...the board goes back up...
000211r 2  AD rr rr       lda PlayState                 ;   ...and the piece on top of it, once the
000214r 2  C9 02          cmp #PLAY_GLOW                ;   redraw has gone by (D14) — but only while
000216r 2  B0 05          bcs @Done                     ;   there IS one. From GLOW on up the piece is
000218r 2  A9 01          lda #1                        ;   in the board and PieceA-C are stale; the
00021Ar 2  8D rr rr       sta PieceDirty                ;   cascade may have taken those cells away
00021Dr 2               @Done:                          ;   entirely.
00021Dr 2  60             rts
00021Er 2               
00021Er 2               ; -----------------------------------------------------------------------------
00021Er 2               ;   StateGameOver — petrify, banner, back to the title
00021Er 2               ;   SPEC 13.4
00021Er 2               ; -----------------------------------------------------------------------------
00021Er 2               StateGameOver:
00021Er 2                 ; TODO: petrify the well from the bottom up, 2 frames a row, then the banner
00021Er 2                 ; and a 10 second timeout. Each cell keeps its own shape —
00021Er 2                 ;   PETRIFY_BASE + (tile & GLYPH_MASK)
00021Er 2                 ; — and empty cells stay empty (13.4).
00021Er 2  AD rr rr       lda InputEdge
000221r 2  29 11          and #(INPUT_FIRE | INPUT_UP)  ; Fire, or SPACE (D15)
000223r 2  F0 0A          beq @Done
000225r 2  A9 00          lda #STATE_TITLE
000227r 2  8D rr rr       sta GameState
00022Ar 2  A9 01          lda #1
00022Cr 2  8D rr rr       sta NeedsRedraw
00022Fr 2               @Done:
00022Fr 2  60             rts
000230r 2               
000230r 2               ; =============================================================================
000230r 2               ;   Static screen drawing
000230r 2               ; =============================================================================
000230r 2               ;   The whole static layout — panel frame, labels, and the margin artwork that
000230r 2               ;   fills the screen either side of it — comes out of the editors as one
000230r 2               ;   name-table image per platform. Code only ever draws over the top of it:
000230r 2               ;   the well, the score and level digits, the preview, and the message band.
000230r 2               ;
000230r 2               ;   All six images are real. They come out of artwork/WizardsLab.tms9918 —
000230r 2               ;   the master — by way of `make artwork`. See data/README.md.
000230r 2               ; =============================================================================
000230r 2               
000230r 2               DrawTitleScreen:
000230r 2  A9 rr          lda #<TitleScreen
000232r 2  85 rr          sta SrcPtr
000234r 2  A9 rr          lda #>TitleScreen
000236r 2  85 rr          sta SrcPtr+1
000238r 2  A9 rr          lda #<TitleColor
00023Ar 2  85 rr          sta Ptr1
00023Cr 2  A9 rr          lda #>TitleColor
00023Er 2  85 rr          sta Ptr1+1
000240r 2  4C rr rr       jmp HalBlitScreen
000243r 2               
000243r 2               DrawPlayScreen:
000243r 2  A9 rr          lda #<PlayScreen
000245r 2  85 rr          sta SrcPtr
000247r 2  A9 rr          lda #>PlayScreen
000249r 2  85 rr          sta SrcPtr+1
00024Br 2  A9 rr          lda #<PlayColor
00024Dr 2  85 rr          sta Ptr1
00024Fr 2  A9 rr          lda #>PlayColor
000251r 2  85 rr          sta Ptr1+1
000253r 2  4C rr rr       jmp HalBlitScreen
000256r 2               
000256r 1               .include "../src/rng.asm"
000256r 2               ; =============================================================================
000256r 2               ;   rng.asm — Wizards Lab, random numbers
000256r 2               ; =============================================================================
000256r 2               ;   A 16-bit Galois LFSR with the conventional $B400 taps, which is maximal
000256r 2               ;   length: it visits all 65535 non-zero states before repeating. Eight shifts
000256r 2               ;   per call, one whole byte out.
000256r 2               ;
000256r 2               ;   Seeding matters more than the generator does. A fixed seed would deal the
000256r 2               ;   same first three pieces every session and the game would feel dead, so the
000256r 2               ;   seed is taken from the free-running frame counter at the moment the player
000256r 2               ;   presses fire on the title screen — human reaction time is the entropy.
000256r 2               ;
000256r 2               ;   SPEC.md section 15.
000256r 2               ; =============================================================================
000256r 2               
000256r 2               ; -----------------------------------------------------------------------------
000256r 2               ;   RngSeed — seed from the frame counter
000256r 2               ;   In:  nothing (reads FrameCounter)
000256r 2               ;   Out: nothing.  Modifies: A
000256r 2               ; -----------------------------------------------------------------------------
000256r 2               RngSeed:
000256r 2  AD rr rr       lda FrameCounter
000259r 2  09 01          ora #$01                      ; Never let the state reach zero — it sticks
00025Br 2  85 rr          sta RngLo
00025Dr 2  49 5A          eor #$5A                      ; Spread one byte of entropy over both halves
00025Fr 2  85 rr          sta RngHi
000261r 2  60             rts
000262r 2               
000262r 2               ; -----------------------------------------------------------------------------
000262r 2               ;   RngNext — next pseudo-random byte
000262r 2               ;   In:  nothing
000262r 2               ;   Out: A = random 0-255.  Modifies: A, X, flags
000262r 2               ; -----------------------------------------------------------------------------
000262r 2               RngNext:
000262r 2  A2 08          ldx #8                        ; Eight shifts give one whole output byte
000264r 2               @Bit:
000264r 2  46 rr          lsr RngHi                     ; Shift the 16-bit state right one place,
000266r 2  66 rr          ror RngLo                     ;   the bit falling out of bit 0 lands in C
000268r 2  90 06          bcc @NoTap
00026Ar 2  A5 rr          lda RngHi
00026Cr 2  49 B4          eor #$B4                      ; Galois feedback mask $B400
00026Er 2  85 rr          sta RngHi
000270r 2               @NoTap:
000270r 2  CA             dex
000271r 2  D0 F1          bne @Bit
000273r 2  A5 rr          lda RngLo
000275r 2  60             rts
000276r 2               
000276r 2               ; -----------------------------------------------------------------------------
000276r 2               ;   RngRange — a random number below a small limit
000276r 2               ;   In:  A = limit, 1-128
000276r 2               ;   Out: A = 0 .. limit-1.  Modifies: A, X, Tmp0, Tmp1.  PRESERVES Y.
000276r 2               ;
000276r 2               ;   Not a modulo. `random % 6` throws four of the 256 outcomes into the low
000276r 2               ;   values and leaves colours 0-3 a shade likelier than 4-5; this takes the
000276r 2               ;   HIGH byte of (random * limit) instead, which spreads the remainder evenly
000276r 2               ;   across the range and costs a fixed eight shifts either way.
000276r 2               ;
000276r 2               ;   The eight-bit multiply keeps only the high byte: the low half falls out of
000276r 2               ;   the accumulator one bit at a time and is never wanted.
000276r 2               ;
000276r 2               ;   Y is preserved so a caller can loop over the three cells of a piece with
000276r 2               ;   it (piece.asm does).
000276r 2               ; -----------------------------------------------------------------------------
000276r 2               RngRange:
000276r 2  48             pha                           ; The limit — RngNext wants A
000277r 2  20 rr rr       jsr RngNext
00027Ar 2  85 rr          sta Tmp0                      ; The random byte
00027Cr 2  68             pla
00027Dr 2  85 rr          sta Tmp1                      ; The limit, shifted out one bit at a time
00027Fr 2  A9 00          lda #0
000281r 2  A2 08          ldx #8
000283r 2               @Bit:
000283r 2  46 rr          lsr Tmp1                      ; Next multiplier bit into C
000285r 2  90 03          bcc @NoAdd
000287r 2  18             clc
000288r 2  65 rr          adc Tmp0                      ; Partial product, carry out into C
00028Ar 2               @NoAdd:
00028Ar 2  6A             ror a                         ; Shift the accumulator down, carry in at bit 7
00028Br 2  CA             dex
00028Cr 2  D0 F5          bne @Bit
00028Er 2  60             rts
00028Fr 2               
00028Fr 1               .include "../src/input.asm"
00028Fr 2               ; =============================================================================
00028Fr 2               ;   input.asm — Wizards Lab, input conditioning
00028Fr 2               ; =============================================================================
00028Fr 2               ;   SPEC.md section 11. HalReadInput hands back one active-high mask however
00028Fr 2               ;   the platform likes; everything above this line works on that mask and
00028Fr 2               ;   never touches hardware.
00028Fr 2               ;
00028Fr 2               ;   Auto-repeat applies to LEFT and RIGHT only. Rotate does NOT repeat — up
00028Fr 2               ;   must be released and pressed again. That is not a preference: a repeating
00028Fr 2               ;   rotate makes a three-cell Columns piece impossible to aim.
00028Fr 2               ; =============================================================================
00028Fr 2               
00028Fr 2               ; -----------------------------------------------------------------------------
00028Fr 2               ;   InputPoll — read the hardware and work out what is newly pressed
00028Fr 2               ;   In:  nothing
00028Fr 2               ;   Out: InputNow, InputPrev, InputEdge updated.  Modifies: A
00028Fr 2               ; -----------------------------------------------------------------------------
00028Fr 2               InputPoll:
00028Fr 2  AD rr rr       lda InputNow
000292r 2  8D rr rr       sta InputPrev
000295r 2  20 rr rr       jsr HalReadInput
000298r 2  8D rr rr       sta InputNow
00029Br 2  4D rr rr       eor InputPrev                 ; Bits that changed
00029Er 2  2D rr rr       and InputNow                  ; ...and are now down = newly pressed
0002A1r 2  8D rr rr       sta InputEdge
0002A4r 2  60             rts
0002A5r 2               
0002A5r 2               ; -----------------------------------------------------------------------------
0002A5r 2               ;   InputShift — LEFT/RIGHT with delayed auto shift
0002A5r 2               ;   Out: A = INPUT_LEFT, INPUT_RIGHT, or 0 if no move should happen this frame.
0002A5r 2               ;        Modifies: A, X
0002A5r 2               ;   SPEC 11.3 — initial delay 12 frames NTSC / 10 PAL, then 4 / 3.
0002A5r 2               ;
0002A5r 2               ;   A fresh press fires on the same frame it arrives; the delay is what comes
0002A5r 2               ;   after it, not before it, so a tap is always exactly one column.
0002A5r 2               ;
0002A5r 2               ;   Holding both directions at once is not something a stick can do, but two
0002A5r 2               ;   keys can. LEFT wins, and it wins consistently, so the piece sits still
0002A5r 2               ;   rather than shivering between the two.
0002A5r 2               ; -----------------------------------------------------------------------------
0002A5r 2               InputShift:
0002A5r 2  AD rr rr       lda InputNow
0002A8r 2  29 04          and #INPUT_LEFT
0002AAr 2  D0 07          bne @Dir
0002ACr 2  AD rr rr       lda InputNow
0002AFr 2  29 08          and #INPUT_RIGHT
0002B1r 2  F0 2A          beq @None
0002B3r 2               
0002B3r 2               @Dir:
0002B3r 2  CD rr rr       cmp DasDir
0002B6r 2  F0 10          beq @Held
0002B8r 2               
0002B8r 2  8D rr rr       sta DasDir                    ; A new direction: fire now, then wait
0002BBr 2  AE rr rr       ldx Region
0002BEr 2  BD rr rr       lda DasInitial,x
0002C1r 2  8D rr rr       sta DasTimer
0002C4r 2  AD rr rr       lda DasDir
0002C7r 2  60             rts
0002C8r 2               
0002C8r 2               @Held:
0002C8r 2  CE rr rr       dec DasTimer                  ; Always loaded non-zero, so this cannot wrap
0002CBr 2  D0 0D          bne @Wait
0002CDr 2  AE rr rr       ldx Region
0002D0r 2  BD rr rr       lda DasRepeat,x
0002D3r 2  8D rr rr       sta DasTimer
0002D6r 2  AD rr rr       lda DasDir
0002D9r 2  60             rts
0002DAr 2               
0002DAr 2               @Wait:
0002DAr 2  A9 00          lda #0
0002DCr 2  60             rts
0002DDr 2               
0002DDr 2               @None:
0002DDr 2  8D rr rr       sta DasDir                    ; A is already 0 — release, so the next press
0002E0r 2  60             rts                           ;   counts as fresh
0002E1r 2               
0002E1r 1               .include "../src/board.asm"
0002E1r 2               ; =============================================================================
0002E1r 2               ;   board.asm — Wizards Lab, the playfield
0002E1r 2               ; =============================================================================
0002E1r 2               ;   SPEC.md section 3. The board is 20 rows of 8 bytes, page-aligned, with
0002E1r 2               ;   columns 6-7 and rows 16-19 held permanently at $FF. Those sentinels are
0002E1r 2               ;   what let every scan in match.asm run without a bounds check.
0002E1r 2               ;
0002E1r 2               ;   address(row, col) = Board + (row << 3) + col
0002E1r 2               ; =============================================================================
0002E1r 2               
0002E1r 2               ; -----------------------------------------------------------------------------
0002E1r 2               ;   BoardClear — empty the playfield and lay the sentinels back down
0002E1r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X
0002E1r 2               ;
0002E1r 2               ;   Walls first over the whole 160 bytes, then the six playfield columns of
0002E1r 2               ;   the sixteen playfield rows punched back out to empty. Doing it in that
0002E1r 2               ;   order means the sentinels can never be forgotten: everything that is not
0002E1r 2               ;   explicitly playfield is a wall.
0002E1r 2               ;
0002E1r 2               ;   The wall loop counts UP and ends on a CPX. Counting down from 159 to a BPL
0002E1r 2               ;   looks tidier and is wrong: 159 is $9F, bit 7 already set, so the branch
0002E1r 2               ;   falls through after the first store and the other 159 bytes keep whatever
0002E1r 2               ;   the machine powered up with. That went unnoticed for a whole phase,
0002E1r 2               ;   because nothing read a sentinel until the falling piece needed a floor.
0002E1r 2               ; -----------------------------------------------------------------------------
0002E1r 2               BoardClear:
0002E1r 2  A9 FF          lda #TILE_WALL
0002E3r 2  A2 00          ldx #0
0002E5r 2               @Wall:
0002E5r 2  9D rr rr       sta Board,x
0002E8r 2  E8             inx
0002E9r 2  E0 A0          cpx #BOARD_BYTES
0002EBr 2  D0 F8          bne @Wall
0002EDr 2               
0002EDr 2  A2 00          ldx #0                        ; X walks the row bases, 0, 8, 16, ...
0002EFr 2               @Row:
0002EFr 2  A9 00          lda #TILE_EMPTY               ; Reloaded every row: the TXA below eats it
0002F1r 2  9D rr rr 9D    .repeat BOARD_W, COL
0002F5r 2  rr rr 9D rr  
0002F9r 2  rr 9D rr rr  
000303r 2                   sta Board + COL, x
000303r 2                 .endrepeat
000303r 2  8A             txa
000304r 2  18             clc
000305r 2  69 08          adc #BOARD_STRIDE
000307r 2  AA             tax
000308r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
00030Ar 2  90 E3          bcc @Row
00030Cr 2  60             rts
00030Dr 2               
00030Dr 2               ; -----------------------------------------------------------------------------
00030Dr 2               ;   BoardRowPtr — point Ptr1 at the start of a board row
00030Dr 2               ;   In:  A = row        Out: Ptr1 = &Board[row][0].  Modifies: A, Ptr1
00030Dr 2               ;
00030Dr 2               ;   Board is page-aligned and 160 bytes, so row * 8 is at most 152 and the low
00030Dr 2               ;   byte can never carry into the high one.
00030Dr 2               ; -----------------------------------------------------------------------------
00030Dr 2               BoardRowPtr:
00030Dr 2  0A             asl a
00030Er 2  0A             asl a
00030Fr 2  0A             asl a
000310r 2  18             clc
000311r 2  69 rr          adc #<Board
000313r 2  85 rr          sta Ptr1
000315r 2  A9 rr          lda #>Board
000317r 2  85 rr          sta Ptr1+1
000319r 2  60             rts
00031Ar 2               
00031Ar 2               ; -----------------------------------------------------------------------------
00031Ar 2               ;   BoardGravityBegin / BoardGravityStep — the pile falls, one row at a time
00031Ar 2               ;   SPEC 8 step 8, SPEC 14: tiles descend one row every FALL_FRAMES.
00031Ar 2               ;
00031Ar 2               ;   A row of falling is one pass over the board, bottom to top, moving every
00031Ar 2               ;   tile that has an empty cell under it down into it. Repeat until a pass
00031Ar 2               ;   moves nothing and the columns are compacted — but repeat it a row at a
00031Ar 2               ;   time, because the fall is animated and a column that dropped four rows in
00031Ar 2               ;   one frame would read as a teleport.
00031Ar 2               ;
00031Ar 2               ;   Walking BOTTOM TO TOP is what makes a whole column fall together rather
00031Ar 2               ;   than one tile a frame: by the time the pass reaches a tile, the tile below
00031Ar 2               ;   it has already moved and left the gap.
00031Ar 2               ;
00031Ar 2               ;   The pass is a CURSOR, not a loop that runs to completion (D12, SPEC 12.6).
00031Ar 2               ;   Sixty tiles falling is a hundred-odd changed cells and the dirty ring holds
00031Ar 2               ;   64, so the pass stops when the ring is full and picks up where it stopped
00031Ar 2               ;   next frame. Nothing is dropped and the board is a legal board at every
00031Ar 2               ;   point it stops — one frame's worth of columns has fallen a row and the
00031Ar 2               ;   rest has not, which is a stagger nobody can see.
00031Ar 2               ;
00031Ar 2               ;   The two sentinel columns need no special case: a wall's "cell below" is
00031Ar 2               ;   another wall, so columns 6 and 7 never move.
00031Ar 2               ; -----------------------------------------------------------------------------
00031Ar 2               GRAV_TOP = (BOARD_H - 1) * BOARD_STRIDE - 1     ; The last cell of row 14, the
00031Ar 2                                                               ;   lowest row that can fall at
00031Ar 2                                                               ;   all. Row 15 is on the floor
00031Ar 2               BoardGravityBegin:
00031Ar 2  A9 77          lda #GRAV_TOP
00031Cr 2  85 rr          sta GravIdx
00031Er 2  A9 00          lda #0
000320r 2  85 rr          sta GravMoved
000322r 2  60             rts
000323r 2               
000323r 2               ; -----------------------------------------------------------------------------
000323r 2               ;   BoardGravityStep — carry on with the current row of falling
000323r 2               ;   In:  nothing
000323r 2               ;   Out: C set when the row is finished; GravMoved non-zero if it moved
000323r 2               ;        anything. Modifies: A, X, Y, GravIdx, GravMoved, RedrawCol
000323r 2               ; -----------------------------------------------------------------------------
000323r 2               BoardGravityStep:
000323r 2  A5 rr          lda GravIdx
000325r 2  30 3F          bmi @Finished                 ; $FF — the row is already done
000327r 2               
000327r 2               @Cell:
000327r 2  AD rr rr       lda DirtyCount                ; Room for both cells of a move, or wait for
00032Ar 2  C9 3E          cmp #(DIRTY_ENTRIES - 2)      ;   the flush. A mark dropped here would never
00032Cr 2  B0 3A          bcs @Later                    ;   be marked again (D6 is survivable only
00032Er 2                                               ;   because nothing that MUST land uses it)
00032Er 2               
00032Er 2  A6 rr          ldx GravIdx
000330r 2  BD rr rr       lda Board,x
000333r 2  F0 2D          beq @Next                     ; Nothing here to fall
000335r 2  BD rr rr       lda Board + BOARD_STRIDE,x
000338r 2  D0 28          bne @Next                     ; Something under it — a tile, or the floor
00033Ar 2               
00033Ar 2  BD rr rr       lda Board,x                   ; Move it down one row
00033Dr 2  9D rr rr       sta Board + BOARD_STRIDE,x
000340r 2  A9 00          lda #TILE_EMPTY
000342r 2  9D rr rr       sta Board,x
000345r 2  E6 rr          inc GravMoved
000347r 2               
000347r 2  A5 rr          lda GravIdx                   ; The cell it LEFT only needs redrawing if it
000349r 2  C9 08          cmp #BOARD_STRIDE             ;   is going to stay empty. If there is a tile
00034Br 2  90 07          bcc @Vacated                  ;   above it, that tile lands here later in
00034Dr 2  A6 rr          ldx GravIdx                   ;   this same pass and its own arrival mark
00034Fr 2  BD rr rr       lda Board - BOARD_STRIDE,x    ;   covers the cell. Half the marks of a
000352r 2  D0 05          bne @Arrived                  ;   sliding column, which is what the ring
000354r 2               @Vacated:                       ;   pressure is made of.
000354r 2  A6 rr          ldx GravIdx
000356r 2  20 rr rr       jsr RenderCell
000359r 2               @Arrived:
000359r 2  A5 rr          lda GravIdx
00035Br 2  18             clc
00035Cr 2  69 08          adc #BOARD_STRIDE
00035Er 2  AA             tax
00035Fr 2  20 rr rr       jsr RenderCell
000362r 2               
000362r 2               @Next:
000362r 2  C6 rr          dec GravIdx                   ; Down to 0, then $FF, which ends the pass —
000364r 2  10 C1          bpl @Cell                     ;   GRAV_TOP is 119, so bit 7 starts clear
000366r 2                                               ;   (see PLAN.md section 3)
000366r 2               @Finished:
000366r 2  38             sec
000367r 2  60             rts
000368r 2               
000368r 2               @Later:
000368r 2  18             clc                           ; Ring full: the rest of this row waits a frame
000369r 2  60             rts
00036Ar 2               
00036Ar 1               .include "../src/piece.asm"
00036Ar 2               ; =============================================================================
00036Ar 2               ;   piece.asm — Wizards Lab, the falling piece
00036Ar 2               ; =============================================================================
00036Ar 2               ;   SPEC.md section 5. A piece is three independently generated cells stacked
00036Ar 2               ;   vertically, A on top. At most one of the three carries a reagent, which is
00036Ar 2               ;   enforced by rolling once for the piece rather than once per cell.
00036Ar 2               ;
00036Ar 2               ;   The piece is NOT in the board while it falls. Board cells under it stay
00036Ar 2               ;   empty until PieceLock writes them, which is what makes the movement tests
00036Ar 2               ;   below a plain read of the three target cells and what lets the erase be
00036Ar 2               ;   three blanks rather than three board reads.
00036Ar 2               ;
00036Ar 2               ;   Nothing here draws. Every routine that changes where the piece is or what
00036Ar 2               ;   it holds sets PieceDirty and lets StatePlay pick the moment (D14).
00036Ar 2               ; =============================================================================
00036Ar 2               
00036Ar 2               ; -----------------------------------------------------------------------------
00036Ar 2               ;   PieceIndex — board index of the piece's top cell
00036Ar 2               ;   In:  nothing
00036Ar 2               ;   Out: A = X = PieceRow * BOARD_STRIDE + PieceCol.  Modifies: A, X
00036Ar 2               ;
00036Ar 2               ;   Cells B and C are one and two strides on from it, and the cell below C is
00036Ar 2               ;   three — which is the only address arithmetic the rest of this file needs.
00036Ar 2               ;   Row 16 and beyond is a wall row, so "below C" is always a legal read.
00036Ar 2               ; -----------------------------------------------------------------------------
00036Ar 2               PieceIndex:
00036Ar 2  AD rr rr       lda PieceRow
00036Dr 2  0A             asl a
00036Er 2  0A             asl a
00036Fr 2  0A             asl a                         ; row * 8
000370r 2  18             clc
000371r 2  6D rr rr       adc PieceCol
000374r 2  AA             tax
000375r 2  60             rts
000376r 2               
000376r 2               ; -----------------------------------------------------------------------------
000376r 2               ;   PieceGenerateNext — roll the preview piece into NextA/NextB/NextC
000376r 2               ;   In:  nothing (reads Level)
000376r 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0, Tmp1
000376r 2               ;   SPEC 5.2, 5.3 — colours uniform over 0-5, then one reagent roll.
000376r 2               ; -----------------------------------------------------------------------------
000376r 2               PieceGenerateNext:
000376r 2  A0 00          ldy #0                        ; RngRange preserves Y, so it can index the
000378r 2               @Color:                         ;   three cells across the call
000378r 2  A9 06          lda #NUM_COLORS
00037Ar 2  20 rr rr       jsr RngRange                  ; 0-5, uniform (SPEC 5.2)
00037Dr 2  0A             asl a
00037Er 2  0A             asl a
00037Fr 2  0A             asl a                         ; colour << 3 ...
000380r 2  18             clc
000381r 2  69 40          adc #COLOR_BASE               ;   ... + base, glyph 0, so it is a potion
000383r 2  99 rr rr       sta NextA,y                   ; NextA/B/C are three consecutive bytes
000386r 2  C8             iny
000387r 2  C0 03          cpy #3
000389r 2  90 ED          bcc @Color
00038Br 2               
00038Br 2                 ; --- does this piece carry a reagent at all? (SPEC 5.3) -------------------
00038Br 2                 ;   One roll for the whole piece, which both caps it at one reagent and
00038Br 2                 ;   costs three rolls fewer than asking each cell.
00038Br 2  20 rr rr       jsr RngNext
00038Er 2  85 rr          sta Tmp0                      ; The roll. Nothing below calls out until it
000390r 2                                               ;   has been compared, so Tmp0 is safe.
000390r 2  AE rr rr       ldx Level
000393r 2  CA             dex                           ; LevelBand is indexed by level - 1 ...
000394r 2  E0 10          cpx #16
000396r 2  90 02          bcc @Band
000398r 2  A2 0F          ldx #15                       ;   ... and clamped: band 4 is "13 and up"
00039Ar 2               @Band:
00039Ar 2  BD rr rr       lda LevelBand,x
00039Dr 2  AA             tax                           ; X = band 0-4
00039Er 2  A5 rr          lda Tmp0
0003A0r 2  DD rr rr       cmp PSpecial,x                ; C clear = the roll came in under the chance
0003A3r 2  B0 2E          bcs @Done
0003A5r 2               
0003A5r 2                 ; --- which cell, and which reagent ----------------------------------------
0003A5r 2  8A             txa
0003A6r 2  48             pha                           ; The band, across the cell roll
0003A7r 2  A9 03          lda #3
0003A9r 2  20 rr rr       jsr RngRange                  ; 0, 1 or 2 — uniform over A, B and C
0003ACr 2  A8             tay                           ; Y survives the type roll below
0003ADr 2  68             pla
0003AEr 2  0A             asl a
0003AFr 2  0A             asl a                         ; band * 4 — ReagentThresholds is four
0003B0r 2  48             pha                           ;   thresholds per band
0003B1r 2  20 rr rr       jsr RngNext
0003B4r 2  85 rr          sta Tmp0                      ; The type roll
0003B6r 2  68             pla
0003B7r 2  AA             tax
0003B8r 2  A5 rr          lda Tmp0
0003BAr 2               
0003BAr 2  DD rr rr       cmp ReagentThresholds+0,x     ; The cumulative-weight compare chain SPEC 5.3
0003BDr 2  90 15          bcc @Fireball                 ;   recommends over a 1280-byte lookup
0003BFr 2  DD rr rr       cmp ReagentThresholds+1,x
0003C2r 2  90 14          bcc @Bolt
0003C4r 2  DD rr rr       cmp ReagentThresholds+2,x
0003C7r 2  90 13          bcc @Bomb
0003C9r 2  DD rr rr       cmp ReagentThresholds+3,x
0003CCr 2  90 12          bcc @Star
0003CEr 2               
0003CEr 2  A9 70          lda #WILD_BASE                ; A Prism discards the colour it rolled and
0003D0r 2  99 rr rr       sta NextA,y                   ;   joins group 14 (SPEC 5.2)
0003D3r 2               @Done:
0003D3r 2  60             rts
0003D4r 2               
0003D4r 2               @Fireball:
0003D4r 2  A9 01          lda #GLYPH_FIREBALL
0003D6r 2  D0 0A          bne @Apply                    ; Always — every glyph below is non-zero
0003D8r 2               @Bolt:
0003D8r 2  A9 02          lda #GLYPH_BOLT
0003DAr 2  D0 06          bne @Apply
0003DCr 2               @Bomb:
0003DCr 2  A9 03          lda #GLYPH_BOMB
0003DEr 2  D0 02          bne @Apply
0003E0r 2               @Star:
0003E0r 2  A9 04          lda #GLYPH_STAR
0003E2r 2               @Apply:
0003E2r 2  19 rr rr       ora NextA,y                   ; The cell's glyph nibble is 0, so an ORA sets
0003E5r 2  99 rr rr       sta NextA,y                   ;   the reagent and keeps the rolled colour
0003E8r 2  60             rts
0003E9r 2               
0003E9r 2               ; -----------------------------------------------------------------------------
0003E9r 2               ;   PieceSpawn — promote the preview to the falling piece
0003E9r 2               ;   In:  nothing
0003E9r 2               ;   Out: C set if the spawn cells were occupied (game over)
0003E9r 2               ;        Modifies: A, X
0003E9r 2               ;   SPEC 5.4 — spawn column SPAWN_COL, rows 0-2, visible immediately.
0003E9r 2               ;
0003E9r 2               ;   The preview is copied whether or not the spawn succeeds; on a blocked
0003E9r 2               ;   spawn nothing looks at the piece again.
0003E9r 2               ; -----------------------------------------------------------------------------
0003E9r 2               PieceSpawn:
0003E9r 2  AD rr rr       lda NextA
0003ECr 2  8D rr rr       sta PieceA
0003EFr 2  AD rr rr       lda NextB
0003F2r 2  8D rr rr       sta PieceB
0003F5r 2  AD rr rr       lda NextC
0003F8r 2  8D rr rr       sta PieceC
0003FBr 2               
0003FBr 2  A9 02          lda #SPAWN_COL
0003FDr 2  8D rr rr       sta PieceCol
000400r 2  A9 00          lda #0
000402r 2  8D rr rr       sta PieceRow
000405r 2  8D rr rr       sta LockTimer
000408r 2  8D rr rr       sta LockResets                ; The reset allowance is per piece (SPEC 5.6)
00040Br 2               
00040Br 2  AD rr rr       lda Board + 0 * BOARD_STRIDE + SPAWN_COL
00040Er 2  0D rr rr       ora Board + 1 * BOARD_STRIDE + SPAWN_COL
000411r 2  0D rr rr       ora Board + 2 * BOARD_STRIDE + SPAWN_COL
000414r 2  D0 0D          bne @Blocked
000416r 2               
000416r 2  20 rr rr       jsr ScoreGravity
000419r 2  8D rr rr       sta GravityTimer
00041Cr 2  A9 01          lda #1
00041Er 2  8D rr rr       sta PieceDirty                ; Drawn immediately — there is no off-screen
000421r 2  18             clc                           ;   entry (SPEC 5.4)
000422r 2  60             rts
000423r 2               
000423r 2               @Blocked:
000423r 2  38             sec
000424r 2  60             rts
000425r 2               
000425r 2               ; -----------------------------------------------------------------------------
000425r 2               ;   PieceMoveLeft / PieceMoveRight — one column, if all three cells are free
000425r 2               ;   Out: C set if the move happened (the caller resets the lock timer).
000425r 2               ;        Modifies: A, X
000425r 2               ;   SPEC 5.5 — no wall kicks; a 1-wide piece has nothing to kick off.
000425r 2               ;
000425r 2               ;   The right edge needs no bounds check: column 6 is a permanent $FF sentinel
000425r 2               ;   and fails the emptiness test on its own (SPEC 3.2). The LEFT edge does,
000425r 2               ;   because column -1 of row 0 is the byte before a page-aligned Board and
000425r 2               ;   belongs to nobody.
000425r 2               ; -----------------------------------------------------------------------------
000425r 2               PieceMoveLeft:
000425r 2  AD rr rr       lda PieceCol
000428r 2  F0 18          beq @No                       ; Column 0 — there is no sentinel to the left
00042Ar 2  20 rr rr       jsr PieceIndex
00042Dr 2  CA             dex
00042Er 2  BD rr rr       lda Board + 0 * BOARD_STRIDE,x
000431r 2  1D rr rr       ora Board + 1 * BOARD_STRIDE,x
000434r 2  1D rr rr       ora Board + 2 * BOARD_STRIDE,x
000437r 2  D0 09          bne @No
000439r 2  20 rr rr       jsr RenderPieceErase
00043Cr 2  CE rr rr       dec PieceCol
00043Fr 2  4C rr rr       jmp PieceMoved
000442r 2               
000442r 2               @No:
000442r 2  18             clc
000443r 2  60             rts
000444r 2               
000444r 2               PieceMoveRight:
000444r 2  20 rr rr       jsr PieceIndex
000447r 2  E8             inx
000448r 2  BD rr rr       lda Board + 0 * BOARD_STRIDE,x
00044Br 2  1D rr rr       ora Board + 1 * BOARD_STRIDE,x
00044Er 2  1D rr rr       ora Board + 2 * BOARD_STRIDE,x
000451r 2  D0 09          bne @No
000453r 2  20 rr rr       jsr RenderPieceErase
000456r 2  EE rr rr       inc PieceCol
000459r 2  4C rr rr       jmp PieceMoved
00045Cr 2               @No:
00045Cr 2  18             clc
00045Dr 2  60             rts
00045Er 2               
00045Er 2               ; -----------------------------------------------------------------------------
00045Er 2               ;   PieceMoved — mark the piece for redraw and report success
00045Er 2               ;   Out: C set.  Modifies: A
00045Er 2               ; -----------------------------------------------------------------------------
00045Er 2               PieceMoved:
00045Er 2  A9 01          lda #1
000460r 2  8D rr rr       sta PieceDirty
000463r 2  38             sec
000464r 2  60             rts
000465r 2               
000465r 2               ; -----------------------------------------------------------------------------
000465r 2               ;   PieceRotate / PieceRotateBack — cycle the three cells
000465r 2               ;   Out: nothing.  Modifies: A, X
000465r 2               ;   SPEC 5.5 — (A,B,C) -> (B,C,A) forward, (C,A,B) back. Always succeeds: the
000465r 2               ;   footprint never changes, so there is nothing to test and nothing to erase.
000465r 2               ;   Rotation does not reset the lock delay (SPEC 5.6).
000465r 2               ; -----------------------------------------------------------------------------
000465r 2               PieceRotate:
000465r 2  AD rr rr       lda PieceA
000468r 2  AE rr rr       ldx PieceB
00046Br 2  8E rr rr       stx PieceA
00046Er 2  AE rr rr       ldx PieceC
000471r 2  8E rr rr       stx PieceB
000474r 2  8D rr rr       sta PieceC
000477r 2  A9 01          lda #1
000479r 2  8D rr rr       sta PieceDirty
00047Cr 2  60             rts
00047Dr 2               
00047Dr 2               PieceRotateBack:
00047Dr 2  AD rr rr       lda PieceC
000480r 2  AE rr rr       ldx PieceB
000483r 2  8E rr rr       stx PieceC
000486r 2  AE rr rr       ldx PieceA
000489r 2  8E rr rr       stx PieceB
00048Cr 2  8D rr rr       sta PieceA
00048Fr 2  A9 01          lda #1
000491r 2  8D rr rr       sta PieceDirty
000494r 2  60             rts
000495r 2               
000495r 2               ; -----------------------------------------------------------------------------
000495r 2               ;   PieceCanFall — is the cell below C free?
000495r 2               ;   Out: C set if the piece can descend one row.  Modifies: A, X
000495r 2               ;   Three strides past cell A. With C on row 15 that reads row 18, which is a
000495r 2               ;   permanent wall row, so the floor needs no special case (SPEC 3.2).
000495r 2               ; -----------------------------------------------------------------------------
000495r 2               PieceCanFall:
000495r 2  20 rr rr       jsr PieceIndex
000498r 2  BD rr rr       lda Board + 3 * BOARD_STRIDE,x
00049Br 2  D0 02          bne @No
00049Dr 2  38             sec
00049Er 2  60             rts
00049Fr 2               @No:
00049Fr 2  18             clc
0004A0r 2  60             rts
0004A1r 2               
0004A1r 2               ; -----------------------------------------------------------------------------
0004A1r 2               ;   PieceStep — one row of gravity
0004A1r 2               ;   Out: C set if the piece has landed and the lock delay should start.
0004A1r 2               ;        Modifies: A, X
0004A1r 2               ; -----------------------------------------------------------------------------
0004A1r 2               PieceStep:
0004A1r 2  20 rr rr       jsr PieceCanFall
0004A4r 2  90 0B          bcc @Landed
0004A6r 2  20 rr rr       jsr RenderPieceErase
0004A9r 2  EE rr rr       inc PieceRow
0004ACr 2  20 rr rr       jsr PieceMoved
0004AFr 2  18             clc                           ; Moved, so it has not landed
0004B0r 2  60             rts
0004B1r 2               @Landed:
0004B1r 2  38             sec
0004B2r 2  60             rts
0004B3r 2               
0004B3r 2               ; -----------------------------------------------------------------------------
0004B3r 2               ;   PieceLock — write the three cells into the board
0004B3r 2               ;   Out: nothing.  Modifies: A, X, Y
0004B3r 2               ;   SPEC 5.6 — after this the caller runs a cascade.
0004B3r 2               ;
0004B3r 2               ;   Once the board holds the piece, drawing the piece and drawing those three
0004B3r 2               ;   board cells are the same three writes, so RenderPiece does the queueing.
0004B3r 2               ; -----------------------------------------------------------------------------
0004B3r 2               PieceLock:
0004B3r 2  20 rr rr       jsr PieceIndex
0004B6r 2  AD rr rr       lda PieceA
0004B9r 2  9D rr rr       sta Board + 0 * BOARD_STRIDE,x
0004BCr 2  AD rr rr       lda PieceB
0004BFr 2  9D rr rr       sta Board + 1 * BOARD_STRIDE,x
0004C2r 2  AD rr rr       lda PieceC
0004C5r 2  9D rr rr       sta Board + 2 * BOARD_STRIDE,x
0004C8r 2               
0004C8r 2  20 rr rr       jsr RenderPiece
0004CBr 2  A9 00          lda #0
0004CDr 2  8D rr rr       sta PieceDirty                ; It is board now; nothing owes it a redraw
0004D0r 2  60             rts
0004D1r 2               
0004D1r 2               ; -----------------------------------------------------------------------------
0004D1r 2               ;   PieceFallRate — frames per row for this frame
0004D1r 2               ;   Out: A = frame count, C CLEAR if that rate is the soft drop's.
0004D1r 2               ;        Modifies: A, X, Tmp0
0004D1r 2               ;   SPEC 5.5, 11.3 — soft drop substitutes its own rate and is ignored when
0004D1r 2               ;   gravity is already the faster of the two (levels 14+ on NTSC).
0004D1r 2               ;
0004D1r 2               ;   The carry is what pays for the soft drop: SPEC 9.6 gives a point per row
0004D1r 2               ;   "descended under soft drop", and a row that fell at gravity's rate with
0004D1r 2               ;   DOWN held down was not one, so holding DOWN at level 16 earns nothing.
0004D1r 2               ;   Working it out here costs nothing — the comparison has already happened.
0004D1r 2               ; -----------------------------------------------------------------------------
0004D1r 2               PieceFallRate:
0004D1r 2  20 rr rr       jsr ScoreGravity              ; Speed[level] for this region
0004D4r 2  85 rr          sta Tmp0
0004D6r 2  AD rr rr       lda InputNow
0004D9r 2  29 02          and #INPUT_DOWN
0004DBr 2  F0 0A          beq @Gravity
0004DDr 2  AE rr rr       ldx Region
0004E0r 2  BD rr rr       lda SoftDropRate,x
0004E3r 2  C5 rr          cmp Tmp0                      ; C clear = soft drop is the faster
0004E5r 2  90 04          bcc @Soft
0004E7r 2               @Gravity:
0004E7r 2  A5 rr          lda Tmp0
0004E9r 2  38             sec
0004EAr 2  60             rts
0004EBr 2               @Soft:
0004EBr 2  18             clc
0004ECr 2  60             rts
0004EDr 2               
0004EDr 2               ; -----------------------------------------------------------------------------
0004EDr 2               ;   PieceControl — apply this frame's input to the piece
0004EDr 2               ;   Out: C set if a horizontal move succeeded (the caller may reset the lock
0004EDr 2               ;        delay).  Modifies: A, X, Y
0004EDr 2               ;
0004EDr 2               ;   Rotation is edge triggered and never repeats: UP has to be released and
0004EDr 2               ;   pressed again. SPEC 11.3 calls that non-negotiable and it is — a
0004EDr 2               ;   repeating rotate makes a three-cell piece impossible to aim. Left and
0004EDr 2               ;   right go through InputShift, which is where the repeat lives.
0004EDr 2               ; -----------------------------------------------------------------------------
0004EDr 2               PieceControl:
0004EDr 2  AD rr rr       lda InputEdge
0004F0r 2  29 01          and #INPUT_UP
0004F2r 2  F0 03          beq @NoRotate
0004F4r 2  20 rr rr       jsr PieceRotate
0004F7r 2               @NoRotate:
0004F7r 2  AD rr rr       lda InputEdge
0004FAr 2  29 10          and #INPUT_FIRE
0004FCr 2  F0 03          beq @NoBack
0004FEr 2  20 rr rr       jsr PieceRotateBack
000501r 2               @NoBack:
000501r 2  20 rr rr       jsr InputShift
000504r 2  C9 04          cmp #INPUT_LEFT
000506r 2  F0 06          beq @Left
000508r 2  C9 08          cmp #INPUT_RIGHT
00050Ar 2  F0 05          beq @Right
00050Cr 2  18             clc
00050Dr 2  60             rts
00050Er 2               @Left:
00050Er 2  4C rr rr       jmp PieceMoveLeft
000511r 2               @Right:
000511r 2  4C rr rr       jmp PieceMoveRight
000514r 2               
000514r 1               .include "../src/match.asm"
000514r 2               ; =============================================================================
000514r 2               ;   match.asm — Wizards Lab, the match scanner
000514r 2               ; =============================================================================
000514r 2               ;   SPEC.md section 6. Four passes — horizontal, vertical, and both diagonals —
000514r 2               ;   each walking its axis and tracking a run colour and length. A run of three
000514r 2               ;   or more sets the MARK bit for each of its cells.
000514r 2               ;
000514r 2               ;   Colour comparison is the whole trick:
000514r 2               ;
000514r 2               ;       lda cell
000514r 2               ;       and #COLOR_MASK         ; the low three bits are the glyph, ignore them
000514r 2               ;       cmp ScanColor
000514r 2               ;
000514r 2               ;   which is why a red potion, a red fireball and a red star all match. The
000514r 2               ;   glyph decides what happens on removal, never whether cells match.
000514r 2               ;
000514r 2               ;   Wildcards (SPEC 6.3): a WILD cell continues any run. If the run has no
000514r 2               ;   colour yet it stays unset and is adopted from the first non-wild cell, so
000514r 2               ;   one prism can close a red horizontal run and a blue vertical run at once.
000514r 2               ;
000514r 2               ;   THE FOUR PASSES ARE ONE LOOP. A line is a start cell and a step, and the
000514r 2               ;   step is the only thing that differs: +1 across, +8 down, +9 down-right,
000514r 2               ;   +7 down-left. Every one of them ends on a sentinel rather than on a bounds
000514r 2               ;   check, which is what the 8-byte stride was bought for (SPEC 3.2):
000514r 2               ;
000514r 2               ;     across   from column 5, +1 lands on column 6      — wall
000514r 2               ;     down     from row 15,   +8 lands on row 16        — wall row
000514r 2               ;     down-r   from column 5, +9 lands on row+1 col 6   — wall
000514r 2               ;     down-l   from column 0, +7 lands on THIS row's column 7 — wall
000514r 2               ;
000514r 2               ;   The last one is the reason the left edge needs no test either: the byte
000514r 2               ;   before column 0 belongs to the row above, and it is already a wall.
000514r 2               ; =============================================================================
000514r 2               
000514r 2               ; -----------------------------------------------------------------------------
000514r 2               ;   MatchScan — find every run on the board
000514r 2               ;   In:  nothing
000514r 2               ;   Out: Marks filled, RunCount set, Z set if nothing matched.
000514r 2               ;        Modifies: A, X, Y, Scan*
000514r 2               ; -----------------------------------------------------------------------------
000514r 2               MatchScan:
000514r 2  20 rr rr       jsr MarksClear
000517r 2  A9 00          lda #0
000519r 2  8D rr rr       sta RunCount
00051Cr 2               
00051Cr 2  20 rr rr       jsr ScanFindTop               ; Everything below skips the empty air above
00051Fr 2  A5 rr          lda ScanTop                   ;   the pile, which on most boards is most of
000521r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE) ;   the board
000523r 2  B0 0C          bcs @Done                     ; Nothing on the board at all
000525r 2               
000525r 2  20 rr rr       jsr MatchScanHorizontal
000528r 2  20 rr rr       jsr MatchScanVertical
00052Br 2  20 rr rr       jsr MatchScanDiagonal
00052Er 2  20 rr rr       jsr MatchScanAntiDiagonal
000531r 2               @Done:
000531r 2  AD rr rr       lda RunCount                  ; Z set when nothing matched
000534r 2  60             rts
000535r 2               
000535r 2               ; -----------------------------------------------------------------------------
000535r 2               ;   ScanFindTop — board index of the first row that holds anything
000535r 2               ;   Out: ScanTop = row base, or BOARD_H * BOARD_STRIDE if the board is empty.
000535r 2               ;        Modifies: A, X, ScanTop
000535r 2               ;
000535r 2               ;   Every pass below starts here instead of at row 0. A pile six rows deep is
000535r 2               ;   scanned as six rows: 178 cells against 448, and the four passes come in
000535r 2               ;   under a third of the frame instead of over two whole ones. Finding it costs
000535r 2               ;   about 45 cycles a row of empty air, which is the cheapest part of the scan.
000535r 2               ;
000535r 2               ;   Correct as well as quick, and for a reason worth writing down: a line that
000535r 2               ;   reaches the pile at all must CROSS the pile's top row, because every one of
000535r 2               ;   the four steps moves down at most one row at a time. Starting the diagonals
000535r 2               ;   on that row rather than on row 0 therefore misses nothing.
000535r 2               ; -----------------------------------------------------------------------------
000535r 2               ScanFindTop:
000535r 2  A2 00          ldx #0
000537r 2               @Row:
000537r 2  BD rr rr       lda Board + 0,x               ; The six playfield columns; the two sentinel
00053Ar 2  1D rr rr       ora Board + 1,x               ;   ones would make every row look occupied
00053Dr 2  1D rr rr       ora Board + 2,x
000540r 2  1D rr rr       ora Board + 3,x
000543r 2  1D rr rr       ora Board + 4,x
000546r 2  1D rr rr       ora Board + 5,x
000549r 2  D0 09          bne @Found
00054Br 2  8A             txa
00054Cr 2  18             clc
00054Dr 2  69 08          adc #BOARD_STRIDE
00054Fr 2  AA             tax
000550r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
000552r 2  90 E3          bcc @Row
000554r 2               @Found:
000554r 2  86 rr          stx ScanTop
000556r 2  60             rts
000557r 2               
000557r 2               ; -----------------------------------------------------------------------------
000557r 2               ;   The four passes (SPEC 6.2). Each sets a step and hands ScanLine its start
000557r 2               ;   cells; the start cell rides the stack because ScanLine needs both index
000557r 2               ;   registers and the scratch bytes below it.
000557r 2               ; -----------------------------------------------------------------------------
000557r 2               MatchScanHorizontal:            ; Every row of the pile, column 0 rightward
000557r 2  A9 01          lda #1
000559r 2  85 rr          sta ScanStep
00055Br 2  A5 rr          lda ScanTop
00055Dr 2               @Line:
00055Dr 2  48             pha
00055Er 2  20 rr rr       jsr ScanLine
000561r 2  68             pla
000562r 2  18             clc
000563r 2  69 08          adc #BOARD_STRIDE
000565r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000567r 2  90 F4          bcc @Line
000569r 2  60             rts
00056Ar 2               
00056Ar 2               MatchScanVertical:              ; 6 columns, top of the pile downward
00056Ar 2  A9 08          lda #BOARD_STRIDE
00056Cr 2  85 rr          sta ScanStep
00056Er 2  4C rr rr       jmp ScanTopRow
000571r 2               
000571r 2               MatchScanDiagonal:              ; down-right: the top row, then the left edge
000571r 2  A9 09          lda #(BOARD_STRIDE + 1)
000573r 2  85 rr          sta ScanStep
000575r 2  20 rr rr       jsr ScanTopRow
000578r 2  A9 00          lda #0
00057Ar 2  4C rr rr       jmp ScanEdgeColumn
00057Dr 2               
00057Dr 2               MatchScanAntiDiagonal:          ; down-left: the top row, then the right edge
00057Dr 2  A9 07          lda #(BOARD_STRIDE - 1)
00057Fr 2  85 rr          sta ScanStep
000581r 2  20 rr rr       jsr ScanTopRow
000584r 2  A9 05          lda #(BOARD_W - 1)
000586r 2  4C rr rr       jmp ScanEdgeColumn
000589r 2               
000589r 2               ; -----------------------------------------------------------------------------
000589r 2               ;   ScanTopRow — scan a line from each of the six cells of the pile's top row
000589r 2               ;   ScanEdgeColumn — and from the rows below it, in the column in A
000589r 2               ;   In:  ScanStep set, ScanTop set; A = column (ScanEdgeColumn only)
000589r 2               ;
000589r 2               ;   Between them those are every start cell a diagonal needs, and the top row
000589r 2               ;   alone is every start cell the vertical pass needs. The top row is scanned
000589r 2               ;   by the first, so the second skips it rather than scanning the longest
000589r 2               ;   diagonal twice.
000589r 2               ; -----------------------------------------------------------------------------
000589r 2               ScanTopRow:
000589r 2  A5 rr          lda ScanTop
00058Br 2               @Line:
00058Br 2  48             pha
00058Cr 2  20 rr rr       jsr ScanLine
00058Fr 2  68             pla
000590r 2  18             clc
000591r 2  69 01          adc #1
000593r 2  48             pha                           ; Six columns of that row, whichever row it
000594r 2  29 07          and #(BOARD_STRIDE - 1)       ;   is, so it is the COLUMN that ends the loop
000596r 2  C9 06          cmp #BOARD_W                  ;   and not the index
000598r 2  68             pla                           ; PLA leaves C alone
000599r 2  90 F0          bcc @Line
00059Br 2  60             rts
00059Cr 2               
00059Cr 2               ScanEdgeColumn:
00059Cr 2  18             clc
00059Dr 2  65 rr          adc ScanTop                   ; That column, on the pile's top row...
00059Fr 2  18             clc
0005A0r 2  69 08          adc #BOARD_STRIDE             ;   ...and then the row below it
0005A2r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
0005A4r 2  B0 0C          bcs @Done                     ; The pile is one row deep — there is no below
0005A6r 2               @Line:
0005A6r 2  48             pha
0005A7r 2  20 rr rr       jsr ScanLine
0005AAr 2  68             pla
0005ABr 2  18             clc
0005ACr 2  69 08          adc #BOARD_STRIDE
0005AEr 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
0005B0r 2  90 F4          bcc @Line
0005B2r 2               @Done:
0005B2r 2  60             rts
0005B3r 2               
0005B3r 2               ; -----------------------------------------------------------------------------
0005B3r 2               ;   ScanLine — walk one line, marking every run of MATCH_MIN or more
0005B3r 2               ;   In:  A = start board index, ScanStep = direction
0005B3r 2               ;   Out: nothing.  Modifies: A, X, Scan*, Marks, RunCount
0005B3r 2               ;
0005B3r 2               ;   ONLY A WALL ENDS THE LINE. A hole in the middle of a row breaks the run
0005B3r 2               ;   and the walk carries on past it, because the cells beyond it are a run of
0005B3r 2               ;   their own — a line that stopped at the first empty cell would never look
0005B3r 2               ;   below the top of the pile at all, which is very nearly the whole board.
0005B3r 2               ;
0005B3r 2               ;   A colour change ends the run and starts a new one at the cell that broke
0005B3r 2               ;   it — the cell that broke a red run is the first cell of the blue one, and
0005B3r 2               ;   any prisms that were riding the red run stay with the red run. SPEC 6.3
0005B3r 2               ;   gives a wildcard to the run it is already in, not to both.
0005B3r 2               ; -----------------------------------------------------------------------------
0005B3r 2               ScanLine:
0005B3r 2  AA             tax                           ; The cursor lives in X for the whole line:
0005B4r 2  A9 FF          lda #$FF                      ;   this loop runs about four hundred times a
0005B6r 2  85 rr          sta ScanColor                 ;   scan and every cycle in it is four hundred
0005B8r 2  A9 00          lda #0                        ;   cycles of the frame
0005BAr 2  85 rr          sta ScanLen
0005BCr 2               
0005BCr 2               @Cell:
0005BCr 2  BD rr rr       lda Board,x
0005BFr 2  F0 41          beq @Gap                      ; A hole breaks the run, not the line
0005C1r 2  C9 FF          cmp #TILE_WALL
0005C3r 2  F0 52          beq @End                      ; A wall is where the line stops
0005C5r 2  29 F8          and #COLOR_MASK               ; The colour key, glyph discarded (SPEC 4.2)
0005C7r 2  C5 rr          cmp ScanColor
0005C9r 2  F0 19          beq @Grow                     ; Same colour — the commonest case, first
0005CBr 2  C9 70          cmp #WILD_BASE
0005CDr 2  F0 15          beq @Grow                     ; A prism continues any run (SPEC 6.3)
0005CFr 2               
0005CFr 2  A8             tay                           ; A different colour. Park it: everything
0005D0r 2  A5 rr          lda ScanColor                 ;   below either adopts it or starts a run
0005D2r 2  30 0E          bmi @Adopt                    ;   with it. $FF is the only value here with
0005D4r 2                                               ;   bit 7 set — colours are $40 to $70
0005D4r 2  A5 rr          lda ScanLen
0005D6r 2  C9 03          cmp #MATCH_MIN
0005D8r 2  B0 14          bcs @Close                    ; The run it broke was long enough to mark
0005DAr 2               
0005DAr 2  84 rr          sty ScanColor                 ; It was not, so no call and no marking: this
0005DCr 2  A9 01          lda #1                        ;   cell is simply the start of the next run.
0005DEr 2  85 rr          sta ScanLen                   ;   Five adjacent cells in six differ in
0005E0r 2  D0 04          bne @Advance                  ;   colour, so this is the path that decides
0005E2r 2                                               ;   what a scan costs
0005E2r 2               @Adopt:
0005E2r 2  84 rr          sty ScanColor
0005E4r 2               @Grow:
0005E4r 2  E6 rr          inc ScanLen
0005E6r 2               @Advance:
0005E6r 2  8A             txa
0005E7r 2  18             clc
0005E8r 2  65 rr          adc ScanStep
0005EAr 2  AA             tax
0005EBr 2  4C rr rr       jmp @Cell
0005EEr 2               
0005EEr 2               @Close:
0005EEr 2  86 rr          stx ScanIdx
0005F0r 2  20 rr rr       jsr MatchEmit                 ; Mark it — and MatchEmit leaves ScanLen zero
0005F3r 2  A6 rr          ldx ScanIdx
0005F5r 2  BD rr rr       lda Board,x
0005F8r 2  29 F8          and #COLOR_MASK
0005FAr 2  85 rr          sta ScanColor
0005FCr 2  A9 01          lda #1
0005FEr 2  85 rr          sta ScanLen
000600r 2  D0 E4          bne @Advance                  ; Always
000602r 2               
000602r 2               @Gap:
000602r 2  A5 rr          lda ScanLen
000604r 2  F0 E0          beq @Advance                  ; Nothing running — step over the hole. This
000606r 2                                               ;   is the cell the scan meets most often, so
000606r 2                                               ;   it is the one that must not call anything
000606r 2  86 rr          stx ScanIdx
000608r 2  20 rr rr       jsr MatchEmit                 ; Close the run the hole broke...
00060Br 2  A6 rr          ldx ScanIdx
00060Dr 2  A9 FF          lda #$FF
00060Fr 2  85 rr          sta ScanColor                 ;   ...and start again on the far side of it
000611r 2  A9 00          lda #0
000613r 2  85 rr          sta ScanLen
000615r 2  F0 CF          beq @Advance                  ; Always
000617r 2               
000617r 2               @End:
000617r 2  A5 rr          lda ScanLen
000619r 2  F0 05          beq @Nothing                  ; The line ran out with nothing in hand
00061Br 2  86 rr          stx ScanIdx
00061Dr 2  4C rr rr       jmp MatchEmit                 ; Whatever was running ends with the line
000620r 2               @Nothing:
000620r 2  60             rts
000621r 2               
000621r 2               ; -----------------------------------------------------------------------------
000621r 2               ;   MatchEmit — a run has ended; mark it if it was long enough
000621r 2               ;   In:  ScanIdx = one cell PAST the run's last, ScanLen, ScanColor, ScanStep
000621r 2               ;   Out: nothing.  Modifies: A, X, Y, ScanEnd, ScanLen, RunCount, Marks
000621r 2               ;
000621r 2               ;   Runs are marked, not removed: a cell can be in a horizontal run and a
000621r 2               ;   vertical one at once, and it clears once while both runs score (SPEC 6.1).
000621r 2               ;   The union is what the MARKS bitmap is for.
000621r 2               ;
000621r 2               ;   SCORING HAPPENS HERE, before the mark loop and for the same reason the
000621r 2               ;   comment above used to promise it would: ScanLen still describes the run at
000621r 2               ;   this point and nowhere else, because the mark loop counts it down to zero
000621r 2               ;   on its way back along the line. MatchScoreRun leaves it alone.
000621r 2               ; -----------------------------------------------------------------------------
000621r 2               MatchEmit:
000621r 2  A5 rr          lda ScanLen
000623r 2  C9 03          cmp #MATCH_MIN
000625r 2  90 1D          bcc @Done                     ; Two in a row is not a run
000627r 2               
000627r 2  EE rr rr       inc RunCount
00062Ar 2  20 rr rr       jsr MatchScoreRun             ; SPEC 8 step 2, per run
00062Dr 2  A5 rr          lda ScanIdx
00062Fr 2  38             sec
000630r 2  E5 rr          sbc ScanStep                  ; Back onto the run's last cell
000632r 2  85 rr          sta ScanEnd
000634r 2               @Mark:
000634r 2  A5 rr          lda ScanEnd
000636r 2  20 rr rr       jsr MarkSet
000639r 2  A5 rr          lda ScanEnd
00063Br 2  38             sec
00063Cr 2  E5 rr          sbc ScanStep
00063Er 2  85 rr          sta ScanEnd
000640r 2  C6 rr          dec ScanLen
000642r 2  D0 F0          bne @Mark
000644r 2               @Done:
000644r 2  60             rts
000645r 2               
000645r 2               ; -----------------------------------------------------------------------------
000645r 2               ;   MatchScoreRun — the two per-run awards of SPEC 8 step 2
000645r 2               ;   In:  ScanLen = run length, ChainStep = the cascade step this is
000645r 2               ;   Out: nothing.  Modifies: A, X, Y.  Leaves ScanLen and ScanColor alone.
000645r 2               ;
000645r 2               ;       cascade_pts += length * TileValue[chain]
000645r 2               ;       cascade_pts += LengthBonus[length]
000645r 2               ;
000645r 2               ;   A cell in a horizontal run AND a vertical one is scored by both, and
000645r 2               ;   removed once (SPEC 6.1) — which is why this is per run and not per marked
000645r 2               ;   cell, and why it runs before the union in MARKS has anything to say.
000645r 2               ;
000645r 2               ;   MultiBonus is NOT here: it is per step, not per run, and CascadeStep adds
000645r 2               ;   it once the four passes have finished counting.
000645r 2               ; -----------------------------------------------------------------------------
000645r 2               MatchScoreRun:
000645r 2  AE rr rr       ldx ChainStep
000648r 2  CA             dex                           ; TileValue is indexed by chain - 1 ...
000649r 2  E0 08          cpx #8
00064Br 2  90 02          bcc @Chain
00064Dr 2  A2 07          ldx #7                        ;   ... and flattens out at 8 (SPEC 9.1)
00064Fr 2               @Chain:
00064Fr 2  A4 rr          ldy ScanLen                   ; The multiply is Y additions (score.asm)
000651r 2  BD rr rr       lda TileValueLo,x
000654r 2  48             pha
000655r 2  BD rr rr       lda TileValueHi,x
000658r 2  AA             tax
000659r 2  68             pla
00065Ar 2  20 rr rr       jsr CascadeAddTimes
00065Dr 2               
00065Dr 2  A6 rr          ldx ScanLen
00065Fr 2  CA             dex
000660r 2  CA             dex
000661r 2  CA             dex                           ; LengthBonus is indexed by length - 3 ...
000662r 2  E0 05          cpx #5
000664r 2  90 02          bcc @Length
000666r 2  A2 04          ldx #4                        ;   ... and flattens out at 7 (SPEC 9.3). A
000668r 2               @Length:                        ;   vertical run can be all sixteen rows long
000668r 2  BD rr rr       lda LengthBonusLo,x
00066Br 2  48             pha
00066Cr 2  BD rr rr       lda LengthBonusHi,x
00066Fr 2  AA             tax
000670r 2  68             pla
000671r 2  4C rr rr       jmp CascadeAdd
000674r 2               
000674r 2               ; -----------------------------------------------------------------------------
000674r 2               ;   MarksClear / MarkSet / MarkTest — the 16-byte bitmap
000674r 2               ;   One byte per row, bits 0-5 = columns 0-5. Union of runs is a free ORA.
000674r 2               ;
000674r 2               ;   MarkBits has eight entries rather than six so that the two sentinel
000674r 2               ;   columns index it harmlessly: bits 6 and 7 of a Marks byte are never set,
000674r 2               ;   so a walk over the whole 8-byte stride can test every cell it meets
000674r 2               ;   without first asking whether the cell is a wall.
000674r 2               ; -----------------------------------------------------------------------------
000674r 2               MarkBits:
000674r 2  01 02 04 08    .byte $01, $02, $04, $08, $10, $20, $40, $80
000678r 2  10 20 40 80  
00067Cr 2               
00067Cr 2               MarksClear:
00067Cr 2  A9 00          lda #0
00067Er 2  A2 00          ldx #0
000680r 2               @Row:
000680r 2  9D rr rr       sta Marks,x
000683r 2  E8             inx
000684r 2  E0 10          cpx #MARKS_BYTES
000686r 2  D0 F8          bne @Row
000688r 2  60             rts
000689r 2               
000689r 2               MarkSet:                        ; In: A = board index.  Modifies: A, X, Y
000689r 2  AA             tax
00068Ar 2  29 07          and #(BOARD_STRIDE - 1)
00068Cr 2  A8             tay                           ; Y = column
00068Dr 2  8A             txa
00068Er 2  4A             lsr a
00068Fr 2  4A             lsr a
000690r 2  4A             lsr a
000691r 2  AA             tax                           ; X = row
000692r 2  BD rr rr       lda Marks,x
000695r 2  19 rr rr       ora MarkBits,y
000698r 2  9D rr rr       sta Marks,x
00069Br 2  60             rts
00069Cr 2               
00069Cr 2               MarkTest:                       ; In: A = board index.  Out: C set if marked
00069Cr 2  AA             tax                           ;     Modifies: A, X, Y
00069Dr 2  29 07          and #(BOARD_STRIDE - 1)
00069Fr 2  A8             tay
0006A0r 2  8A             txa
0006A1r 2  4A             lsr a
0006A2r 2  4A             lsr a
0006A3r 2  4A             lsr a
0006A4r 2  AA             tax
0006A5r 2  BD rr rr       lda Marks,x
0006A8r 2  39 rr rr       and MarkBits,y
0006ABr 2  F0 02          beq @No
0006ADr 2  38             sec
0006AEr 2  60             rts
0006AFr 2               @No:
0006AFr 2  18             clc
0006B0r 2  60             rts
0006B1r 2               
0006B1r 1               .include "../src/cascade.asm"
0006B1r 2               ; =============================================================================
0006B1r 2               ;   cascade.asm — Wizards Lab, clear resolution
0006B1r 2               ; =============================================================================
0006B1r 2               ;   SPEC.md section 8. A cascade runs from the moment a piece locks until no
0006B1r 2               ;   further matches exist, one step per iteration, with ChainStep counting the
0006B1r 2               ;   steps. The step order is fixed:
0006B1r 2               ;
0006B1r 2               ;       scan -> score matches -> enqueue reagents -> resolve queue
0006B1r 2               ;            -> animate -> remove -> level check -> gravity -> repeat
0006B1r 2               ;
0006B1r 2               ;   The effect queue always drains. Effects only ever remove tiles, never add
0006B1r 2               ;   them, and each cell can be marked at most once, so the queue is bounded by
0006B1r 2               ;   the 96 cells of the playfield.
0006B1r 2               ; =============================================================================
0006B1r 2               
0006B1r 2               ; -----------------------------------------------------------------------------
0006B1r 2               ;   CascadeBegin — called immediately after PieceLock
0006B1r 2               ;   Out: nothing.  Modifies: A
0006B1r 2               ; -----------------------------------------------------------------------------
0006B1r 2               CascadeBegin:
0006B1r 2  A9 01          lda #1
0006B3r 2  8D rr rr       sta ChainStep                 ; The step about to run is step 1 (SPEC 8)
0006B6r 2  A9 00          lda #0
0006B8r 2  8D rr rr       sta CascadeLo
0006BBr 2  8D rr rr       sta CascadeMid
0006BEr 2  8D rr rr       sta CascadeHi
0006C1r 2  8D rr rr       sta StarCount
0006C4r 2  8D rr rr       sta RunCount
0006C7r 2  4C rr rr       jmp EffectQClear
0006CAr 2               
0006CAr 2               ; -----------------------------------------------------------------------------
0006CAr 2               ;   CascadeStep — run one step's scan and take what it found off the board
0006CAr 2               ;   In:  nothing
0006CAr 2               ;   Out: C set if anything matched, and the caller should let the pile fall.
0006CAr 2               ;        C clear when nothing matched and the cascade has settled.
0006CAr 2               ;        Modifies: A, X, Y, Scan*, CellCount, Marks, RunCount
0006CAr 2               ;
0006CAr 2               ;   Steps 3 and 4 are the reagents, and they run between the scan and the
0006CAr 2               ;   removal because everything they do is add cells to Marks: by the time
0006CAr 2               ;   CascadeRemove walks the bitmap it cannot tell a cell the scan found from
0006CAr 2               ;   a cell a fireball took, and does not need to. Step 5 is still to come —
0006CAr 2               ;   P6 puts the glow and the shatter here, which is the reason the step is
0006CAr 2               ;   split into a scan and a removal that a sub-state can sit between.
0006CAr 2               ;
0006CAr 2               ;   Step 2's per-run half is in MatchEmit, which is the one moment a run's
0006CAr 2               ;   length and colour are both in hand; what is left of it here is the bonus
0006CAr 2               ;   for having found several at once, which nothing knows until all four
0006CAr 2               ;   passes have finished.
0006CAr 2               ; -----------------------------------------------------------------------------
0006CAr 2               CascadeStep:
0006CAr 2  20 rr rr       jsr MatchScan
0006CDr 2  F0 26          beq @Settled                  ; RunCount is zero — nothing left to clear
0006CFr 2               
0006CFr 2  AE rr rr       ldx RunCount                  ; SPEC 8 step 2, last line, and SPEC 9.4
0006D2r 2  CA             dex                           ; MultiBonus is indexed by runs - 1 ...
0006D3r 2  E0 05          cpx #5
0006D5r 2  90 02          bcc @Multi
0006D7r 2  A2 04          ldx #4                        ;   ... and flattens out at 5
0006D9r 2               @Multi:
0006D9r 2  BD rr rr       lda MultiBonusLo,x
0006DCr 2  48             pha
0006DDr 2  BD rr rr       lda MultiBonusHi,x
0006E0r 2  AA             tax
0006E1r 2  68             pla
0006E2r 2  20 rr rr       jsr CascadeAdd
0006E5r 2               
0006E5r 2  20 rr rr       jsr EffectEnqueueMarked       ; SPEC 8 step 3
0006E8r 2  20 rr rr       jsr EffectResolve             ; SPEC 8 step 4
0006EBr 2               
0006EBr 2  20 rr rr       jsr CascadeRemove             ; SPEC 8 step 6
0006EEr 2  A5 rr          lda CellCount
0006F0r 2  20 rr rr       jsr ScoreLevelCheck           ; SPEC 8 step 7 — match and effect removals
0006F3r 2  38             sec                           ;   both count, and by here they are the same
0006F4r 2  60             rts                           ;   cells
0006F5r 2               @Settled:
0006F5r 2  18             clc
0006F6r 2  60             rts
0006F7r 2               
0006F7r 2               ; -----------------------------------------------------------------------------
0006F7r 2               ;   CascadeRemove — empty every marked cell and queue it for redraw
0006F7r 2               ;   In:  Marks
0006F7r 2               ;   Out: CellCount = cells removed.  Modifies: A, X, Y, CellCount, RedrawCol
0006F7r 2               ;   SPEC 8 step 6.
0006F7r 2               ;
0006F7r 2               ;   Every marked cell is zeroed in one go, because the gravity that follows
0006F7r 2               ;   needs a board that is finished changing. Only the REDRAW is rationed: at
0006F7r 2               ;   most 96 cells can be marked and the dirty ring holds 64, and P5 made that
0006F7r 2               ;   reachable — a bolt is 21 cells on its own and a chain of them is most of
0006F7r 2               ;   the well. A mark dropped by a full ring is never made again (D6), so
0006F7r 2               ;   rather than drop one this falls back to RenderBoard, the whole-well cursor
0006F7r 2               ;   RenderFlush already feeds a frame at a time (D12). Four frames of redraw
0006F7r 2               ;   instead of a hole in the screen, and only on the rare huge step: a plain
0006F7r 2               ;   three-in-a-row never comes near the cap.
0006F7r 2               ;
0006F7r 2               ;   CellCount goes to ScoreLevelCheck — thirty cleared tiles is a level
0006F7r 2               ;   (SPEC 10.1) — and P6 will have animated these cells before they go.
0006F7r 2               ; -----------------------------------------------------------------------------
0006F7r 2               CascadeRemove:
0006F7r 2  A9 00          lda #0
0006F9r 2  85 rr          sta CellCount
0006FBr 2  AA             tax                           ; X = board index, walked a row at a time
0006FCr 2               @Row:
0006FCr 2  8A             txa
0006FDr 2  4A             lsr a
0006FEr 2  4A             lsr a
0006FFr 2  4A             lsr a
000700r 2  A8             tay
000701r 2  B9 rr rr       lda Marks,y
000704r 2  F0 38          beq @NextRow                  ; Nothing marked in this row, and most rows
000706r 2                                               ;   hold nothing marked
000706r 2               @Cell:
000706r 2  8A             txa
000707r 2  48             pha
000708r 2  20 rr rr       jsr MarkTest
00070Br 2  68             pla
00070Cr 2  AA             tax                           ; MarkTest needs X, so the cursor comes back
00070Dr 2  90 1F          bcc @NextCell                 ;   through A. Neither PLA nor TAX touches C.
00070Fr 2  A9 00          lda #TILE_EMPTY
000711r 2  9D rr rr       sta Board,x
000714r 2  E6 rr          inc CellCount
000716r 2               
000716r 2  AD rr rr       lda DirtyCount                ; Room to mark this one?
000719r 2  C9 40          cmp #DIRTY_ENTRIES
00071Br 2  B0 0A          bcs @Bulk                     ; No — redraw the lot instead of losing it
00071Dr 2  8A             txa
00071Er 2  48             pha
00071Fr 2  20 rr rr       jsr RenderCell
000722r 2  68             pla
000723r 2  AA             tax
000724r 2  4C rr rr       jmp @NextCell
000727r 2               @Bulk:
000727r 2  8A             txa
000728r 2  48             pha
000729r 2  20 rr rr       jsr RenderBoard               ; Sets the cursor and nothing else, so the
00072Cr 2  68             pla                           ;   cells already queued still land and the
00072Dr 2  AA             tax                           ;   redraw overwrites them with the same values
00072Er 2               @NextCell:
00072Er 2  E8             inx
00072Fr 2  8A             txa
000730r 2  29 07          and #(BOARD_STRIDE - 1)
000732r 2  C9 06          cmp #BOARD_W
000734r 2  90 D0          bcc @Cell
000736r 2               
000736r 2  8A             txa                           ; X is on the row's first sentinel column;
000737r 2  18             clc                           ;   step over both of them
000738r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
00073Ar 2  AA             tax
00073Br 2  4C rr rr       jmp @Test
00073Er 2               
00073Er 2               @NextRow:
00073Er 2  8A             txa
00073Fr 2  18             clc
000740r 2  69 08          adc #BOARD_STRIDE
000742r 2  AA             tax
000743r 2               @Test:
000743r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
000745r 2  90 B5          bcc @Row
000747r 2  60             rts
000748r 2               
000748r 2               ; -----------------------------------------------------------------------------
000748r 2               ;   CascadeSettle — apply the star multiplier and bank the points
000748r 2               ;   SPEC 8 SETTLE, SPEC 9.6 — the doubling covers the WHOLE cascade, including
000748r 2               ;   points scored before the star cleared.
000748r 2               ; -----------------------------------------------------------------------------
000748r 2               CascadeSettle:
000748r 2  AD rr rr       lda StarCount
00074Br 2  C9 03          cmp #STAR_SHIFT_CAP
00074Dr 2  90 02          bcc @Shift
00074Fr 2  A9 03          lda #STAR_SHIFT_CAP           ; x8 and no further, however many were caught
000751r 2               @Shift:
000751r 2  AA             tax
000752r 2  F0 06          beq @Bank
000754r 2               @Double:
000754r 2  20 rr rr       jsr CascadeDouble             ; A doubling in BCD is one self-addition
000757r 2  CA             dex
000758r 2  D0 FA          bne @Double
00075Ar 2               @Bank:
00075Ar 2  4C rr rr       jmp ScoreAdd                  ; Its carry is not read: ScoreHighCheck has
00075Dr 2                                               ;   already raised the fanfare and the flash
00075Dr 2                                               ;   itself, and does so exactly once
00075Dr 2               
00075Dr 2               
00075Dr 2               ; =============================================================================
00075Dr 2               ;   The reagents (SPEC 7)
00075Dr 2               ; =============================================================================
00075Dr 2               ;   Steps 3 and 4 of SPEC 8, and the five effects between them. The shape is:
00075Dr 2               ;
00075Dr 2               ;     EffectEnqueueMarked   walks MARKS once the scan has finished, and offers
00075Dr 2               ;                           every matched cell to EffectEnqueue
00075Dr 2               ;     EffectEnqueue         decides what a cell being removed is worth — a
00075Dr 2               ;                           prism pays, a star counts, a fireball/bolt/bomb
00075Dr 2               ;                           queues
00075Dr 2               ;     EffectResolve         drains the queue, detonating each in turn
00075Dr 2               ;     EffectFireball/Bolt/  list the cells a detonation reaches, and offer each
00075Dr 2               ;       Bomb                one to EffectHit
00075Dr 2               ;     EffectHit             marks it, scores it, and offers it to
00075Dr 2               ;                           EffectEnqueue in its turn — which is the whole of
00075Dr 2               ;                           SPEC 7.2's chain reaction, in one routine
00075Dr 2               ;
00075Dr 2               ;   TERMINATION IS STRUCTURAL, not a limit. An effect only ever MARKS cells and
00075Dr 2               ;   never adds one, and EffectHit refuses a cell that is already marked, so a
00075Dr 2               ;   cell can be pushed at most once and the loop is bounded by the 96 cells of
00075Dr 2               ;   the well.
00075Dr 2               ;
00075Dr 2               ;   Nothing here touches the board. Marked cells are still sitting there,
00075Dr 2               ;   readable, until CascadeRemove zeroes them in step 6 — which is what lets a
00075Dr 2               ;   queue entry be a board index and nothing else (constants.inc).
00075Dr 2               ; =============================================================================
00075Dr 2               
00075Dr 2               ; -----------------------------------------------------------------------------
00075Dr 2               ;   EffectEnqueueMarked — SPEC 8 step 3
00075Dr 2               ;   In:  Marks, as MatchScan left it
00075Dr 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectQ, StarCount, Cascade*
00075Dr 2               ;
00075Dr 2               ;   Nothing called from here marks anything, so the bitmap being walked cannot
00075Dr 2               ;   change underneath the walk. Step 4 is where marking starts, and the cells
00075Dr 2               ;   it marks enqueue themselves as they are marked (EffectHit) rather than
00075Dr 2               ;   waiting for a second pass over MARKS.
00075Dr 2               ;
00075Dr 2               ;   It has to be a pass over the union rather than part of MatchEmit's mark
00075Dr 2               ;   loop: a cell in a horizontal run AND a vertical one is marked twice and
00075Dr 2               ;   would then detonate twice (SPEC 6.1).
00075Dr 2               ; -----------------------------------------------------------------------------
00075Dr 2               EffectEnqueueMarked:
00075Dr 2  A9 00          lda #0
00075Fr 2  85 rr          sta EffectIdx
000761r 2               @Row:
000761r 2  A5 rr          lda EffectIdx
000763r 2  4A             lsr a
000764r 2  4A             lsr a
000765r 2  4A             lsr a
000766r 2  A8             tay
000767r 2  B9 rr rr       lda Marks,y
00076Ar 2  F0 20          beq @NextRow                  ; Nothing marked in this row, which is most
00076Cr 2                                               ;   rows of most steps
00076Cr 2               @Cell:
00076Cr 2  A5 rr          lda EffectIdx
00076Er 2  20 rr rr       jsr MarkTest
000771r 2  90 05          bcc @NextCell
000773r 2  A6 rr          ldx EffectIdx
000775r 2  20 rr rr       jsr EffectEnqueue
000778r 2               @NextCell:
000778r 2  E6 rr          inc EffectIdx
00077Ar 2  A5 rr          lda EffectIdx
00077Cr 2  29 07          and #(BOARD_STRIDE - 1)
00077Er 2  C9 06          cmp #BOARD_W
000780r 2  90 EA          bcc @Cell
000782r 2               
000782r 2  A5 rr          lda EffectIdx                 ; On the row's first sentinel column; step
000784r 2  18             clc                           ;   over both of them
000785r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000787r 2  85 rr          sta EffectIdx
000789r 2  4C rr rr       jmp @Test
00078Cr 2               
00078Cr 2               @NextRow:
00078Cr 2  A5 rr          lda EffectIdx
00078Er 2  18             clc
00078Fr 2  69 08          adc #BOARD_STRIDE
000791r 2  85 rr          sta EffectIdx
000793r 2               @Test:
000793r 2  A5 rr          lda EffectIdx
000795r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000797r 2  90 C8          bcc @Row
000799r 2  60             rts
00079Ar 2               
00079Ar 2               ; -----------------------------------------------------------------------------
00079Ar 2               ;   EffectEnqueue — a marked cell is going; make what it holds count
00079Ar 2               ;   In:  X = board index of a cell that is ALREADY marked
00079Ar 2               ;   Out: nothing.  Modifies: A, X, Y
00079Ar 2               ;
00079Ar 2               ;   Called exactly once per removed cell — from step 3 for the cells the scan
00079Ar 2               ;   found, and from EffectHit for every cell an effect takes. Three outcomes:
00079Ar 2               ;
00079Ar 2               ;     a prism   pays BONUS_PRISM here and now and is never queued: it has no
00079Ar 2               ;               effect to fire, only a bonus (SPEC 7.3)
00079Ar 2               ;     a star    counts into StarCount and is never queued either — SPEC 8
00079Ar 2               ;               step 3 is explicit that stars are counted, not queued
00079Ar 2               ;     the rest  go on the queue, and pay their trigger bonus when they pop
00079Ar 2               ;
00079Ar 2               ;   THE COLOUR IS TESTED BEFORE THE GLYPH, and that order is not cosmetic. A
00079Ar 2               ;   prism is glyph 0 of colour 6, indistinguishable from a plain potion by its
00079Ar 2               ;   glyph alone — and from P6 onward the board may hold any of the prism's four
00079Ar 2               ;   idle rotation frames, whose low three bits read as a bolt or a bomb and
00079Ar 2               ;   would detonate one. Colour 6 is the only test that stays true.
00079Ar 2               ; -----------------------------------------------------------------------------
00079Ar 2               EffectEnqueue:
00079Ar 2  BD rr rr       lda Board,x
00079Dr 2  29 F8          and #COLOR_MASK
00079Fr 2  C9 70          cmp #WILD_BASE
0007A1r 2  F0 12          beq @Prism
0007A3r 2  BD rr rr       lda Board,x
0007A6r 2  29 07          and #GLYPH_MASK
0007A8r 2  F0 0A          beq @Done                     ; A plain potion, which is most of the board
0007AAr 2  C9 04          cmp #GLYPH_STAR
0007ACr 2  F0 0A          beq @Star
0007AEr 2  B0 04          bcs @Done                     ; Glyphs 5-7 are animation frames (SPEC 4.4),
0007B0r 2                                               ;   never reagents
0007B0r 2  8A             txa
0007B1r 2  4C rr rr       jmp EffectQPush               ; Fireball, bolt or bomb — glyphs 1 to 3
0007B4r 2               @Done:
0007B4r 2  60             rts
0007B5r 2               @Prism:
0007B5r 2  4C rr rr       jmp EffectPrism               ; Both of these are the far side of the three
0007B8r 2               @Star:                          ;   detonations below, well out of branch range
0007B8r 2  4C rr rr       jmp EffectStar
0007BBr 2               
0007BBr 2               ; -----------------------------------------------------------------------------
0007BBr 2               ;   EffectHit — one cell of one detonation
0007BBr 2               ;   In:  X = board index
0007BBr 2               ;   Out: nothing.  Modifies: A, X, Y
0007BBr 2               ;
0007BBr 2               ;   The whole of SPEC 8 step 4's inner loop, which is why every effect below
0007BBr 2               ;   is nothing but a list of cells to offer it.
0007BBr 2               ;
0007BBr 2               ;   A cell that is empty, a wall, or already marked is not a target. "Not
0007BBr 2               ;   already marked" is what makes the queue terminate and what stops a cell
0007BBr 2               ;   being paid for twice; testing the WALL here is what lets the walks above
0007BBr 2               ;   run over the two sentinel columns without bounds checks of their own. A
0007BBr 2               ;   marked sentinel would be zeroed by CascadeRemove and the well would grow
0007BBr 2               ;   a hole in its floor.
0007BBr 2               ; -----------------------------------------------------------------------------
0007BBr 2               EffectHit:
0007BBr 2  BD rr rr       lda Board,x
0007BEr 2  F0 1A          beq @Done                     ; Empty
0007C0r 2  C9 FF          cmp #TILE_WALL
0007C2r 2  F0 16          beq @Done                     ; A sentinel is never a target
0007C4r 2  8A             txa
0007C5r 2  48             pha
0007C6r 2  20 rr rr       jsr MarkTest
0007C9r 2  68             pla
0007CAr 2  AA             tax                           ; Neither PLA nor TAX touches C
0007CBr 2  B0 0D          bcs @Done                     ; Already going
0007CDr 2               
0007CDr 2  8A             txa
0007CEr 2  48             pha                           ; MarkSet takes the index in A, which PHA left
0007CFr 2  20 rr rr       jsr MarkSet                   ;   alone
0007D2r 2  20 rr rr       jsr EffectScoreCell           ; SPEC 9.2, per cell an effect took
0007D5r 2  68             pla
0007D6r 2  AA             tax
0007D7r 2  4C rr rr       jmp EffectEnqueue             ; ...and if it was a reagent, it fires too
0007DAr 2               @Done:
0007DAr 2  60             rts
0007DBr 2               
0007DBr 2               ; -----------------------------------------------------------------------------
0007DBr 2               ;   EffectScoreCell — EffectValue[chain] for one cell taken by an effect
0007DBr 2               ;   Out: nothing.  Modifies: A, X, Y
0007DBr 2               ;   SPEC 9.2 — deliberately dearer than a matched tile at low chain depth, so
0007DBr 2               ;   that the first reagent a player ever sets off feels better than plain play.
0007DBr 2               ; -----------------------------------------------------------------------------
0007DBr 2               EffectScoreCell:
0007DBr 2  AE rr rr       ldx ChainStep
0007DEr 2  CA             dex                           ; Indexed by chain - 1 ...
0007DFr 2  E0 08          cpx #8
0007E1r 2  90 02          bcc @Chain
0007E3r 2  A2 07          ldx #7                        ;   ... and flattens out at 8
0007E5r 2               @Chain:
0007E5r 2  BD rr rr       lda EffectValueLo,x
0007E8r 2  48             pha
0007E9r 2  BD rr rr       lda EffectValueHi,x
0007ECr 2  AA             tax
0007EDr 2  68             pla
0007EEr 2  4C rr rr       jmp CascadeAdd
0007F1r 2               
0007F1r 2               ; -----------------------------------------------------------------------------
0007F1r 2               ;   EffectResolve — drain the queue (SPEC 8 step 4)
0007F1r 2               ;   Out: nothing.  Modifies: A, X, Y, Effect*, Marks, Cascade*, StarCount
0007F1r 2               ;
0007F1r 2               ;   The detonation runs first and the trigger bonus is paid on the way back,
0007F1r 2               ;   which is the order SPEC 8 step 4 sets out. It makes no difference to the
0007F1r 2               ;   total — everything lands in the same accumulator — but it does mean the
0007F1r 2               ;   glyph has to survive a routine that clobbers all three registers, and the
0007F1r 2               ;   stack is the cheapest place to put it.
0007F1r 2               ; -----------------------------------------------------------------------------
0007F1r 2               EffectResolve:
0007F1r 2               @Loop:
0007F1r 2  20 rr rr       jsr EffectQPop
0007F4r 2  90 40          bcc @Done                     ; Empty — the step is finished
0007F6r 2               
0007F6r 2  AA             tax                           ; X = the detonating cell
0007F7r 2  BD rr rr       lda Board,x                   ; Still on the board: step 6 has not run
0007FAr 2  29 07          and #GLYPH_MASK
0007FCr 2  48             pha
0007FDr 2  C9 01          cmp #GLYPH_FIREBALL
0007FFr 2  F0 0F          beq @Fireball
000801r 2  C9 02          cmp #GLYPH_BOLT
000803r 2  F0 1B          beq @Bolt
000805r 2               
000805r 2  A9 07          lda #SFX_BOMB                 ; Glyph 3 — nothing else ever reaches here
000807r 2  8D rr rr       sta SfxRequest
00080Ar 2  20 rr rr       jsr EffectBomb
00080Dr 2  4C rr rr       jmp @Bonus
000810r 2               
000810r 2               @Fireball:
000810r 2  A9 05          lda #SFX_FIREBALL
000812r 2  8D rr rr       sta SfxRequest
000815r 2  BD rr rr       lda Board,x
000818r 2  29 F8          and #COLOR_MASK               ; Its own colour, which can never be wild
00081Ar 2  20 rr rr       jsr EffectFireball
00081Dr 2  4C rr rr       jmp @Bonus
000820r 2               
000820r 2               @Bolt:
000820r 2  A9 06          lda #SFX_BOLT
000822r 2  8D rr rr       sta SfxRequest
000825r 2  20 rr rr       jsr EffectBolt
000828r 2               
000828r 2               @Bonus:
000828r 2  68             pla
000829r 2  A8             tay                           ; TriggerBonus is indexed by glyph (SPEC 9.5),
00082Ar 2  B9 rr rr       lda TriggerBonusLo,y          ;   and is paid however the reagent was removed
00082Dr 2  BE rr rr       ldx TriggerBonusHi,y
000830r 2  20 rr rr       jsr CascadeAdd
000833r 2  4C rr rr       jmp @Loop
000836r 2               @Done:
000836r 2  60             rts
000837r 2               
000837r 2               ; -----------------------------------------------------------------------------
000837r 2               ;   The five reagents (SPEC 7.3). Each lists the cells it reaches and leaves
000837r 2               ;   the marking, the scoring and the chain reaction to EffectHit.
000837r 2               ; -----------------------------------------------------------------------------
000837r 2               
000837r 2               ; -----------------------------------------------------------------------------
000837r 2               ;   EffectFireball — every remaining tile of one colour, board wide
000837r 2               ;   In:  A = the colour key ($40 to $68)
000837r 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectArg, Marks, Cascade*
000837r 2               ;   SPEC 7.3 — the signature reagent, and the reason a chain goes three deep.
000837r 2               ;
000837r 2               ;   PRISMS ARE IMMUNE AND IT COSTS NOTHING TO MAKE THEM SO (SPEC 7.4). A prism
000837r 2               ;   is colour 6 and a fireball's colour never is, so the compare below is the
000837r 2               ;   immunity — there is no special case to forget. An empty cell and a wall
000837r 2               ;   fail it for the same reason, which is why this walks all eight columns of
000837r 2               ;   every row rather than stepping over the sentinels.
000837r 2               ;
000837r 2               ;   The fireball's own cell is already marked, so it is not a target of itself,
000837r 2               ;   and a second fireball of the same colour in the same step finds nothing
000837r 2               ;   left to take — and still pays its trigger bonus (SPEC 7.3).
000837r 2               ; -----------------------------------------------------------------------------
000837r 2               EffectFireball:
000837r 2  85 rr          sta EffectArg                 ; The colour it is hunting
000839r 2  A9 00          lda #0
00083Br 2  85 rr          sta EffectIdx
00083Dr 2               @Cell:
00083Dr 2  A6 rr          ldx EffectIdx
00083Fr 2  BD rr rr       lda Board,x
000842r 2  29 F8          and #COLOR_MASK
000844r 2  C5 rr          cmp EffectArg
000846r 2  D0 03          bne @Next
000848r 2  20 rr rr       jsr EffectHit
00084Br 2               @Next:
00084Br 2  E6 rr          inc EffectIdx
00084Dr 2  A5 rr          lda EffectIdx
00084Fr 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000851r 2  90 EA          bcc @Cell
000853r 2  60             rts
000854r 2               
000854r 2               ; -----------------------------------------------------------------------------
000854r 2               ;   EffectBolt — the whole row and the whole column through the bolt's cell
000854r 2               ;   In:  X = board index
000854r 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectEnd, EffectArg, Marks
000854r 2               ;   SPEC 7.3 — up to 6 + 16 - 1 = 21 cells, and the only reagent that reaches
000854r 2               ;   something buried at the bottom of a column.
000854r 2               ;
000854r 2               ;   Neither walk needs clipping: a row is six cells wherever it is, and a
000854r 2               ;   column is sixteen. The bolt's own cell is offered twice, once by each, and
000854r 2               ;   is refused both times because it was marked before this was called.
000854r 2               ; -----------------------------------------------------------------------------
000854r 2               EffectBolt:
000854r 2  8A             txa
000855r 2  29 07          and #(BOARD_STRIDE - 1)
000857r 2  85 rr          sta EffectArg                 ; Its column, for the second walk
000859r 2  8A             txa
00085Ar 2  29 F8          and #(256 - BOARD_STRIDE)     ; $F8 — its row base
00085Cr 2  85 rr          sta EffectIdx
00085Er 2  18             clc
00085Fr 2  69 06          adc #BOARD_W
000861r 2  85 rr          sta EffectEnd                 ; One past the row's last playfield cell
000863r 2               @Row:
000863r 2  A6 rr          ldx EffectIdx
000865r 2  20 rr rr       jsr EffectHit
000868r 2  E6 rr          inc EffectIdx
00086Ar 2  A5 rr          lda EffectIdx
00086Cr 2  C5 rr          cmp EffectEnd
00086Er 2  90 F3          bcc @Row
000870r 2               
000870r 2  A5 rr          lda EffectArg                 ; The column, row 0 downward
000872r 2  85 rr          sta EffectIdx
000874r 2               @Col:
000874r 2  A6 rr          ldx EffectIdx
000876r 2  20 rr rr       jsr EffectHit
000879r 2  A5 rr          lda EffectIdx
00087Br 2  18             clc
00087Cr 2  69 08          adc #BOARD_STRIDE
00087Er 2  85 rr          sta EffectIdx
000880r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000882r 2  90 F0          bcc @Col
000884r 2  60             rts
000885r 2               
000885r 2               ; -----------------------------------------------------------------------------
000885r 2               ;   EffectBomb — the 3 x 3 block centred on the bomb, clipped at the edges
000885r 2               ;   In:  X = board index
000885r 2               ;   Out: nothing.  Modifies: A, X, Y, Effect*, Tmp0, Tmp1, Marks, Cascade*
000885r 2               ;   SPEC 7.3 — up to 9 cells, and the reagent most likely to catch another.
000885r 2               ;
000885r 2               ;   BOTH SPANS ARE CLIPPED, and the row span has to be: row 0 minus one row is
000885r 2               ;   index minus 8, which underflows a byte and reads the BSS in front of a
000885r 2               ;   page-aligned Board. The column span could lean on the sentinels the way
000885r 2               ;   every other walk in the game does — except at row 0, column 0, where
000885r 2               ;   "one to the left" is index $FF and off the end of the board. Clipping both
000885r 2               ;   is smaller than special-casing one corner.
000885r 2               ;
000885r 2               ;   Tmp0 and Tmp1 are finished with before the first JSR, which is what the
000885r 2               ;   rule about them says (zeropage.inc).
000885r 2               ; -----------------------------------------------------------------------------
000885r 2               EffectBomb:
000885r 2  8A             txa                           ; --- the column span ---
000886r 2  29 07          and #(BOARD_STRIDE - 1)
000888r 2  A8             tay
000889r 2  F0 01          beq @Left                     ; Column 0 — the block starts there
00088Br 2  88             dey
00088Cr 2               @Left:
00088Cr 2  84 rr          sty Tmp0                      ; First column of the block
00088Er 2  8A             txa
00088Fr 2  29 07          and #(BOARD_STRIDE - 1)
000891r 2  C9 05          cmp #(BOARD_W - 1)
000893r 2  B0 02          bcs @Right                    ; Already against the right wall
000895r 2  69 01          adc #1                        ; C is clear — the CMP above failed
000897r 2               @Right:
000897r 2  85 rr          sta EffectArg                 ; Last column of the block
000899r 2               
000899r 2  8A             txa                           ; --- the row span ---
00089Ar 2  29 F8          and #(256 - BOARD_STRIDE)
00089Cr 2  85 rr          sta Tmp1                      ; The bomb's own row base
00089Er 2  F0 03          beq @Top                      ; Row 0 — the block starts there
0008A0r 2  38             sec
0008A1r 2  E9 08          sbc #BOARD_STRIDE
0008A3r 2               @Top:
0008A3r 2  18             clc
0008A4r 2  65 rr          adc Tmp0
0008A6r 2  85 rr          sta EffectRow                 ; First cell of the block's first row
0008A8r 2               
0008A8r 2  A5 rr          lda Tmp1
0008AAr 2  C9 78          cmp #((BOARD_H - 1) * BOARD_STRIDE)
0008ACr 2  B0 03          bcs @Bottom                   ; Row 15 — the block ends there
0008AEr 2  18             clc
0008AFr 2  69 08          adc #BOARD_STRIDE
0008B1r 2               @Bottom:
0008B1r 2  18             clc
0008B2r 2  65 rr          adc Tmp0
0008B4r 2  85 rr          sta EffectEnd                 ; First cell of the block's LAST row
0008B6r 2               
0008B6r 2               @Rows:
0008B6r 2  A5 rr          lda EffectRow
0008B8r 2  85 rr          sta EffectIdx
0008BAr 2               @Cell:
0008BAr 2  A6 rr          ldx EffectIdx
0008BCr 2  20 rr rr       jsr EffectHit
0008BFr 2  A5 rr          lda EffectIdx
0008C1r 2  29 07          and #(BOARD_STRIDE - 1)
0008C3r 2  C5 rr          cmp EffectArg
0008C5r 2  E6 rr          inc EffectIdx                 ; INC touches N and Z only, so the CMP's carry
0008C7r 2  90 F1          bcc @Cell                     ;   is still the one being branched on
0008C9r 2               
0008C9r 2  A5 rr          lda EffectRow
0008CBr 2  C5 rr          cmp EffectEnd
0008CDr 2  B0 07          bcs @Done                     ; That was the last row of the block
0008CFr 2  18             clc
0008D0r 2  69 08          adc #BOARD_STRIDE
0008D2r 2  85 rr          sta EffectRow
0008D4r 2  D0 E0          bne @Rows                     ; Always — a row base past the first is >= 8
0008D6r 2               @Done:
0008D6r 2  60             rts
0008D7r 2               
0008D7r 2               ; -----------------------------------------------------------------------------
0008D7r 2               ;   EffectStar — removes nothing; it multiplies (SPEC 7.3)
0008D7r 2               ;   Out: nothing.  Modifies: A
0008D7r 2               ;
0008D7r 2               ;   The cap is not applied here. SPEC 9.6 doubles the WHOLE cascade up to three
0008D7r 2               ;   times at the end, so the count has to survive to CascadeSettle, which is
0008D7r 2               ;   where min(StarCount, STAR_SHIFT_CAP) is taken. A cascade cannot remove more
0008D7r 2               ;   than the 96 cells of the well, so the count cannot wrap on its way there.
0008D7r 2               ; -----------------------------------------------------------------------------
0008D7r 2               EffectStar:
0008D7r 2  EE rr rr       inc StarCount
0008DAr 2  A9 08          lda #SFX_STAR
0008DCr 2  8D rr rr       sta SfxRequest
0008DFr 2  60             rts
0008E0r 2               
0008E0r 2               ; -----------------------------------------------------------------------------
0008E0r 2               ;   EffectPrism — removes nothing; a flat bonus per prism cleared (SPEC 9.5)
0008E0r 2               ;   Out: nothing.  Modifies: A, X
0008E0r 2               ;
0008E0r 2               ;   It goes through CascadeAdd and not ScoreAward, so a star in the same
0008E0r 2               ;   cascade doubles it: SPEC 9.6 exempts only the soft drop and the level
0008E0r 2               ;   bonus from the multiplier (D5, D18).
0008E0r 2               ; -----------------------------------------------------------------------------
0008E0r 2               EffectPrism:
0008E0r 2  A9 09          lda #SFX_PRISM
0008E2r 2  8D rr rr       sta SfxRequest
0008E5r 2  A9 00          lda #<BONUS_PRISM
0008E7r 2  A2 04          ldx #>BONUS_PRISM
0008E9r 2  4C rr rr       jmp CascadeAdd
0008ECr 2               
0008ECr 2               ; -----------------------------------------------------------------------------
0008ECr 2               ;   The effect queue — a ring of board indices, one byte an entry.
0008ECr 2               ;
0008ECr 2               ;   The board still holds every pending reagent when its entry pops, because
0008ECr 2               ;   nothing is zeroed until step 6, so the glyph and the colour SPEC 8 packs
0008ECr 2               ;   into the entry are one `lda Board,x` away and storing them again would be
0008ECr 2               ;   storing a copy of the board (constants.inc).
0008ECr 2               ;
0008ECr 2               ;   Head and tail are entry numbers; the ring keeps one slot free, so it holds
0008ECr 2               ;   EFFECTQ_ENTRIES - 1. On overflow the effect is DROPPED and the cascade
0008ECr 2               ;   carries on (D6) — the cell is still marked, still scored and still removed,
0008ECr 2               ;   it simply does not detonate. With at most one reagent a piece, 47 pending
0008ECr 2               ;   detonations is not somewhere a real board goes.
0008ECr 2               ; -----------------------------------------------------------------------------
0008ECr 2               EffectQClear:
0008ECr 2  A9 00          lda #0
0008EEr 2  8D rr rr       sta EffectQHead
0008F1r 2  8D rr rr       sta EffectQTail
0008F4r 2  60             rts
0008F5r 2               
0008F5r 2               ; -----------------------------------------------------------------------------
0008F5r 2               ;   EffectQPush — In: A = board index.  Modifies: A, X, Y
0008F5r 2               ; -----------------------------------------------------------------------------
0008F5r 2               EffectQPush:
0008F5r 2  AE rr rr       ldx EffectQTail
0008F8r 2  AC rr rr       ldy EffectQTail
0008FBr 2  C8             iny
0008FCr 2  C0 30          cpy #EFFECTQ_ENTRIES
0008FEr 2  90 02          bcc @Store
000900r 2  A0 00          ldy #0                        ; Wrap
000902r 2               @Store:
000902r 2  CC rr rr       cpy EffectQHead
000905r 2  F0 06          beq @Full                     ; One slot free is the ring being full
000907r 2  9D rr rr       sta EffectQ,x
00090Ar 2  8C rr rr       sty EffectQTail
00090Dr 2               @Full:
00090Dr 2  60             rts
00090Er 2               
00090Er 2               ; -----------------------------------------------------------------------------
00090Er 2               ;   EffectQPop — Out: C set and A = board index; C clear when empty
00090Er 2               ;   Modifies: A, X
00090Er 2               ; -----------------------------------------------------------------------------
00090Er 2               EffectQPop:
00090Er 2  AE rr rr       ldx EffectQHead
000911r 2  EC rr rr       cpx EffectQTail
000914r 2  F0 0F          beq @Empty
000916r 2  BD rr rr       lda EffectQ,x
000919r 2  E8             inx
00091Ar 2  E0 30          cpx #EFFECTQ_ENTRIES
00091Cr 2  90 02          bcc @Store
00091Er 2  A2 00          ldx #0                        ; Wrap
000920r 2               @Store:
000920r 2  8E rr rr       stx EffectQHead
000923r 2  38             sec
000924r 2  60             rts
000925r 2               @Empty:
000925r 2  18             clc
000926r 2  60             rts
000927r 2               
000927r 1               .include "../src/score.asm"
000927r 2               ; =============================================================================
000927r 2               ;   score.asm — Wizards Lab, scoring
000927r 2               ; =============================================================================
000927r 2               ;   SPEC.md section 9. Seven digits of packed BCD in four bytes, low byte
000927r 2               ;   first; the top nibble of ScoreTop is held at zero. Every value in
000927r 2               ;   tables.inc is a multiple of ten, so scoring is a SED / ADC chain and never
000927r 2               ;   a multiply — the one place a tile count has to be multiplied by a table
000927r 2               ;   value, it is done as a loop of BCD additions, and the count is at most 21.
000927r 2               ;
000927r 2               ;   The score clamps at 9999999. It never wraps.
000927r 2               ;
000927r 2               ;   Display is always all seven digits, zero padded — see TextBcd. Nothing
000927r 2               ;   here strips a leading zero, and nothing downstream may either.
000927r 2               ;
000927r 2               ;   TWO WAYS IN, AND THEY ARE NOT INTERCHANGEABLE (D5):
000927r 2               ;
000927r 2               ;     CascadeAdd / CascadeAddTimes    points scored INSIDE a cascade. They go
000927r 2               ;                                     into Cascade{Lo,Mid,Hi} and stay there
000927r 2               ;                                     until CascadeSettle, because a star
000927r 2               ;                                     caught anywhere in the cascade doubles
000927r 2               ;                                     everything it scored, retroactively
000927r 2               ;                                     (SPEC 9.6).
000927r 2               ;     ScoreAward                      the awards SPEC 9.6 gives outside a
000927r 2               ;                                     cascade — the soft drop and the level-up
000927r 2               ;                                     bonus. These reach Score at once and a
000927r 2               ;                                     star never touches them.
000927r 2               ;
000927r 2               ;   Both funnel through ScoreBank, which is the only routine that writes
000927r 2               ;   Score, the only one that clamps, and the only one that can hand the high
000927r 2               ;   score over to the player.
000927r 2               ; =============================================================================
000927r 2               
000927r 2               ; -----------------------------------------------------------------------------
000927r 2               ;   ScoreHighInit — seed the session high score, once, at power-on
000927r 2               ;   SPEC 9.8 — the high score is not persisted; it starts at 0010000 on every
000927r 2               ;   power-on, which is the target the first game is played against. It then
000927r 2               ;   survives every game in the session, so this is deliberately NOT part of
000927r 2               ;   ScoreReset. Nothing may infer "cold boot" from the value being zero: BSS
000927r 2               ;   is not cleared on all three machines.
000927r 2               ;   Out: nothing.  Modifies: A
000927r 2               ; -----------------------------------------------------------------------------
000927r 2               ScoreHighInit:
000927r 2  A9 00          lda #HIGH_INIT_LO
000929r 2  8D rr rr       sta HighLo
00092Cr 2  A9 00          lda #HIGH_INIT_MID
00092Er 2  8D rr rr       sta HighMid
000931r 2  A9 01          lda #HIGH_INIT_HI
000933r 2  8D rr rr       sta HighHi
000936r 2  A9 00          lda #HIGH_INIT_TOP
000938r 2  8D rr rr       sta HighTop
00093Br 2  A9 01          lda #$01                      ; BCD — the level the target was "set" on
00093Dr 2  8D rr rr       sta HighLevel
000940r 2  60             rts
000941r 2               
000941r 2               ; -----------------------------------------------------------------------------
000941r 2               ;   ScoreReset — zero the score for a new game
000941r 2               ;   Out: nothing.  Modifies: A
000941r 2               ;
000941r 2               ;   The high score itself is NOT reset (SPEC 9.8) — but the two flags that say
000941r 2               ;   what this game has done about it are, or the second game of a session
000941r 2               ;   would never flash.
000941r 2               ; -----------------------------------------------------------------------------
000941r 2               ScoreReset:
000941r 2  A9 00          lda #0
000943r 2  8D rr rr       sta ScoreLo
000946r 2  8D rr rr       sta ScoreMid
000949r 2  8D rr rr       sta ScoreHi
00094Cr 2  8D rr rr       sta ScoreTop
00094Fr 2  8D rr rr       sta CascadeLo
000952r 2  8D rr rr       sta CascadeMid
000955r 2  8D rr rr       sta CascadeHi
000958r 2  8D rr rr       sta StarCount
00095Br 2  8D rr rr       sta HighOwned
00095Er 2  8D rr rr       sta HighFlash
000961r 2  8D rr rr       sta HighTimer
000964r 2  60             rts
000965r 2               
000965r 2               ; -----------------------------------------------------------------------------
000965r 2               ;   CascadeAdd — add a 16-bit BCD value to the cascade accumulator
000965r 2               ;   In:  A = low BCD byte, X = high BCD byte
000965r 2               ;   Out: nothing.  Modifies: A, flags.  PRESERVES X and Y.
000965r 2               ;
000965r 2               ;   Preserving X and Y is what lets CascadeAddTimes loop over this without
000965r 2               ;   spilling anything, and Tmp0-Tmp3 may not be held across a JSR anyway
000965r 2               ;   (zeropage.inc).
000965r 2               ; -----------------------------------------------------------------------------
000965r 2               CascadeAdd:
000965r 2  F8             sed
000966r 2  18             clc
000967r 2  6D rr rr       adc CascadeLo
00096Ar 2  8D rr rr       sta CascadeLo
00096Dr 2  8A             txa
00096Er 2  6D rr rr       adc CascadeMid
000971r 2  8D rr rr       sta CascadeMid
000974r 2  AD rr rr       lda CascadeHi
000977r 2  69 00          adc #0
000979r 2  8D rr rr       sta CascadeHi
00097Cr 2  D8             cld                           ; CLD leaves the carry alone
00097Dr 2  B0 01          bcs CascadeClamp
00097Fr 2  60             rts
000980r 2               
000980r 2               ; -----------------------------------------------------------------------------
000980r 2               ;   CascadeClamp — six nines, when an accumulate would have wrapped
000980r 2               ;   Out: nothing.  Modifies: A.  PRESERVES X and Y.
000980r 2               ;
000980r 2               ;   Not reachable by playing: nothing is ever ADDED to the board during a
000980r 2               ;   cascade, so one cascade can never remove more than the 96 cells the well
000980r 2               ;   holds, and 96 cells at the dearest tile value there is (650, SPEC 9.2)
000980r 2               ;   plus every bonus in section 9 comes to a little over 200,000 — a fifth of
000980r 2               ;   what three bytes hold, and an eighth of what it would take to wrap after
000980r 2               ;   the star cap has doubled it three times. It is here because "never wraps"
000980r 2               ;   in SPEC 9 has to be true of every accumulator on the path, not just of the
000980r 2               ;   one the player can see.
000980r 2               ; -----------------------------------------------------------------------------
000980r 2               CascadeClamp:
000980r 2  A9 99          lda #$99
000982r 2  8D rr rr       sta CascadeLo
000985r 2  8D rr rr       sta CascadeMid
000988r 2  8D rr rr       sta CascadeHi
00098Br 2  60             rts
00098Cr 2               
00098Cr 2               ; -----------------------------------------------------------------------------
00098Cr 2               ;   CascadeAddTimes — add a value N times (the tiles-cleared multiply)
00098Cr 2               ;   In:  A = low BCD, X = high BCD, Y = count
00098Cr 2               ;   Out: nothing.  Modifies: A, Y, flags.  PRESERVES X.
00098Cr 2               ;
00098Cr 2               ;   SPEC 9 chose values that are all multiples of ten so that scoring is an
00098Cr 2               ;   ADC chain, but `length * TileValue[chain]` is still a multiply. The count
00098Cr 2               ;   is a run length — three to sixteen — so a loop of BCD additions is both
00098Cr 2               ;   smaller and, at these counts, faster than any multiply routine worth
00098Cr 2               ;   writing.
00098Cr 2               ; -----------------------------------------------------------------------------
00098Cr 2               CascadeAddTimes:
00098Cr 2  48             pha                           ; The low byte rides the stack, because
00098Dr 2               @Loop:                          ;   CascadeAdd returns in A
00098Dr 2  C0 00          cpy #0
00098Fr 2  F0 08          beq @Done
000991r 2  68             pla
000992r 2  48             pha
000993r 2  20 rr rr       jsr CascadeAdd
000996r 2  88             dey
000997r 2  D0 F4          bne @Loop
000999r 2               @Done:
000999r 2  68             pla
00099Ar 2  60             rts
00099Br 2               
00099Br 2               ; -----------------------------------------------------------------------------
00099Br 2               ;   CascadeDouble — one BCD doubling of the cascade accumulator
00099Br 2               ;   Out: nothing.  Modifies: A, flags.  PRESERVES X and Y.
00099Br 2               ;   A doubling in BCD is a self-addition; three of them is the star cap.
00099Br 2               ; -----------------------------------------------------------------------------
00099Br 2               CascadeDouble:
00099Br 2  F8             sed
00099Cr 2  18             clc
00099Dr 2  AD rr rr       lda CascadeLo
0009A0r 2  6D rr rr       adc CascadeLo
0009A3r 2  8D rr rr       sta CascadeLo
0009A6r 2  AD rr rr       lda CascadeMid
0009A9r 2  6D rr rr       adc CascadeMid
0009ACr 2  8D rr rr       sta CascadeMid
0009AFr 2  AD rr rr       lda CascadeHi
0009B2r 2  6D rr rr       adc CascadeHi
0009B5r 2  8D rr rr       sta CascadeHi
0009B8r 2  D8             cld
0009B9r 2  B0 C5          bcs CascadeClamp
0009BBr 2  60             rts
0009BCr 2               
0009BCr 2               ; -----------------------------------------------------------------------------
0009BCr 2               ;   ScoreAdd — bank the cascade accumulator into Score, clamped
0009BCr 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
0009BCr 2               ;   SPEC 9.8 — the high score updates live, so the player watches the overtake.
0009BCr 2               ; -----------------------------------------------------------------------------
0009BCr 2               ScoreAdd:
0009BCr 2  AD rr rr       lda CascadeLo
0009BFr 2  85 rr          sta Tmp0
0009C1r 2  AD rr rr       lda CascadeMid
0009C4r 2  85 rr          sta Tmp1
0009C6r 2  AD rr rr       lda CascadeHi
0009C9r 2  85 rr          sta Tmp2
0009CBr 2  4C rr rr       jmp ScoreBank
0009CEr 2               
0009CEr 2               ; -----------------------------------------------------------------------------
0009CEr 2               ;   ScoreAward — add a 16-bit BCD value straight to Score
0009CEr 2               ;   In:  A = low BCD byte, X = high BCD byte
0009CEr 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
0009CEr 2               ;
0009CEr 2               ;   The two awards SPEC 9.6 gives outside a cascade: one point a row for a
0009CEr 2               ;   soft drop, and BONUS_LEVELUP when the level advances. Neither is a cascade
0009CEr 2               ;   point and neither is doubled by a star, which is the whole reason they do
0009CEr 2               ;   not go through CascadeAdd.
0009CEr 2               ; -----------------------------------------------------------------------------
0009CEr 2               ScoreAward:
0009CEr 2  85 rr          sta Tmp0
0009D0r 2  86 rr          stx Tmp1
0009D2r 2  A9 00          lda #0
0009D4r 2  85 rr          sta Tmp2
0009D6r 2                 ; falls through into ScoreBank
0009D6r 2               
0009D6r 2               ; -----------------------------------------------------------------------------
0009D6r 2               ;   ScoreBank — Score += the three BCD bytes in Tmp0-Tmp2, clamped at 9999999
0009D6r 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
0009D6r 2               ;
0009D6r 2               ;   The only writer of Score. It redraws the field itself, because there is no
0009D6r 2               ;   other moment at which the score is known to have changed (SPEC 12.6 —
0009D6r 2               ;   nothing polls).
0009D6r 2               ; -----------------------------------------------------------------------------
0009D6r 2               ScoreBank:
0009D6r 2  F8             sed
0009D7r 2  18             clc
0009D8r 2  AD rr rr       lda ScoreLo
0009DBr 2  65 rr          adc Tmp0
0009DDr 2  8D rr rr       sta ScoreLo
0009E0r 2  AD rr rr       lda ScoreMid
0009E3r 2  65 rr          adc Tmp1
0009E5r 2  8D rr rr       sta ScoreMid
0009E8r 2  AD rr rr       lda ScoreHi
0009EBr 2  65 rr          adc Tmp2
0009EDr 2  8D rr rr       sta ScoreHi
0009F0r 2  AD rr rr       lda ScoreTop
0009F3r 2  69 00          adc #0
0009F5r 2  8D rr rr       sta ScoreTop
0009F8r 2  D8             cld                           ; CLD leaves the carry alone
0009F9r 2  B0 07          bcs @Clamp
0009FBr 2  AD rr rr       lda ScoreTop                  ; The eighth digit is held at zero (SPEC 9),
0009FEr 2  C9 10          cmp #$10                      ;   so anything that reached it has overflowed
000A00r 2  90 10          bcc @Drawn                    ;   the seven the panel shows
000A02r 2               @Clamp:
000A02r 2  A9 99          lda #$99
000A04r 2  8D rr rr       sta ScoreLo
000A07r 2  8D rr rr       sta ScoreMid
000A0Ar 2  8D rr rr       sta ScoreHi
000A0Dr 2  A9 09          lda #$09
000A0Fr 2  8D rr rr       sta ScoreTop
000A12r 2               @Drawn:
000A12r 2  20 rr rr       jsr RenderScore
000A15r 2                 ; falls through into ScoreHighCheck
000A15r 2               
000A15r 2               ; -----------------------------------------------------------------------------
000A15r 2               ;   ScoreHighCheck — hand the high score over the moment the score reaches it
000A15r 2               ;   Out: C set if the score is level with or past the high score — which, once
000A15r 2               ;        it has been taken, is EVERY call. The one-shot is HighOwned below, not
000A15r 2               ;        this flag; nothing currently reads it.  Modifies: A, X, Y, Tmp0
000A15r 2               ;
000A15r 2               ;   SPEC 9.8. The copy happens on every call once the score is level with the
000A15r 2               ;   high score, not just on the first — that is what keeps HighLevel tracking
000A15r 2               ;   the live level while a run is holding its own record, which is the point of
000A15r 2               ;   the number: it says how deep you have to get to beat it.
000A15r 2               ;
000A15r 2               ;   The fanfare and the flash are the one-shot half, and HighOwned is what
000A15r 2               ;   makes them one: without it every subsequent bank would fire them again,
000A15r 2               ;   because from the overtake onward the score and the high score are equal.
000A15r 2               ; -----------------------------------------------------------------------------
000A15r 2               ScoreHighCheck:
000A15r 2  AD rr rr       lda HighTop                   ; Four-byte compare, most significant first
000A18r 2  CD rr rr       cmp ScoreTop
000A1Br 2  D0 16          bne @Test
000A1Dr 2  AD rr rr       lda HighHi
000A20r 2  CD rr rr       cmp ScoreHi
000A23r 2  D0 0E          bne @Test
000A25r 2  AD rr rr       lda HighMid
000A28r 2  CD rr rr       cmp ScoreMid
000A2Br 2  D0 06          bne @Test
000A2Dr 2  AD rr rr       lda HighLo
000A30r 2  CD rr rr       cmp ScoreLo
000A33r 2               @Test:
000A33r 2  90 02          bcc @Take                     ; high < score
000A35r 2  D0 3E          bne @Behind                   ; high > score — nothing to do
000A37r 2                                               ; equal: still copy, so HighLevel tracks
000A37r 2               @Take:
000A37r 2  AD rr rr       lda ScoreLo
000A3Ar 2  8D rr rr       sta HighLo
000A3Dr 2  AD rr rr       lda ScoreMid
000A40r 2  8D rr rr       sta HighMid
000A43r 2  AD rr rr       lda ScoreHi
000A46r 2  8D rr rr       sta HighHi
000A49r 2  AD rr rr       lda ScoreTop
000A4Cr 2  8D rr rr       sta HighTop
000A4Fr 2  20 rr rr       jsr ScoreLevelBcd             ; The level box under the digits is BCD; Level
000A52r 2  8D rr rr       sta HighLevel                 ;   itself is binary (SPEC 12.2)
000A55r 2  20 rr rr       jsr RenderHigh
000A58r 2               
000A58r 2  AD rr rr       lda HighOwned
000A5Br 2  D0 16          bne @Owned
000A5Dr 2  EE rr rr       inc HighOwned
000A60r 2  A9 0B          lda #SFX_HIGHSCORE            ; SPEC 9.8 — a longer fanfare, once
000A62r 2  8D rr rr       sta SfxRequest
000A65r 2  A9 06          lda #HIGH_FLASH_BLINKS
000A67r 2  8D rr rr       sta HighFlash
000A6Ar 2  AE rr rr       ldx Region
000A6Dr 2  BD rr rr       lda BlinkHalf,x
000A70r 2  8D rr rr       sta HighTimer
000A73r 2               @Owned:
000A73r 2  38             sec
000A74r 2  60             rts
000A75r 2               
000A75r 2               @Behind:
000A75r 2  18             clc
000A76r 2  60             rts
000A77r 2               
000A77r 2               ; -----------------------------------------------------------------------------
000A77r 2               ;   ScoreLevelBcd — Level (binary 1-99) as one packed BCD byte
000A77r 2               ;   Out: A = the level in BCD.  Modifies: A, X, Tmp0
000A77r 2               ; -----------------------------------------------------------------------------
000A77r 2               ScoreLevelBcd:
000A77r 2  AD rr rr       lda Level
000A7Ar 2  A2 00          ldx #0
000A7Cr 2               @Tens:
000A7Cr 2  C9 0A          cmp #10
000A7Er 2  90 05          bcc @Split
000A80r 2  E9 0A          sbc #10                       ; Carry is set by the CMP that got us here
000A82r 2  E8             inx
000A83r 2  D0 F7          bne @Tens                     ; Always — X tops out at 9
000A85r 2               @Split:
000A85r 2  85 rr          sta Tmp0                      ; Units
000A87r 2  8A             txa
000A88r 2  0A             asl a
000A89r 2  0A             asl a
000A8Ar 2  0A             asl a
000A8Br 2  0A             asl a
000A8Cr 2  05 rr          ora Tmp0
000A8Er 2  60             rts
000A8Fr 2               
000A8Fr 2               ; -----------------------------------------------------------------------------
000A8Fr 2               ;   ScoreSoftDrop — one point for one row descended under soft drop (SPEC 9.6)
000A8Fr 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0-Tmp2
000A8Fr 2               ;
000A8Fr 2               ;   The one award in the game that is not a multiple of ten. BCD does not care.
000A8Fr 2               ; -----------------------------------------------------------------------------
000A8Fr 2               ScoreSoftDrop:
000A8Fr 2  A9 01          lda #$01
000A91r 2  A2 00          ldx #$00
000A93r 2  4C rr rr       jmp ScoreAward
000A96r 2               
000A96r 2               ; -----------------------------------------------------------------------------
000A96r 2               ;   ScoreLevelCheck — advance the level when 30 tiles have gone
000A96r 2               ;   In:  A = tiles removed this step
000A96r 2               ;   Out: C set if the level advanced.  Modifies: A, X, Y, Tmp0-Tmp2
000A96r 2               ;   SPEC 10.1 — at most one advance per step, surplus carries over, so a big
000A96r 2               ;   fireball chain can never skip a level. Match and effect removals both
000A96r 2               ;   count, which is why the count comes from CascadeRemove and not from the
000A96r 2               ;   scan: by then the two are the same cells.
000A96r 2               ; -----------------------------------------------------------------------------
000A96r 2               ScoreLevelCheck:
000A96r 2  18             clc
000A97r 2  6D rr rr       adc TilesCleared
000A9Ar 2  8D rr rr       sta TilesCleared              ; A whole step can clear far more than thirty;
000A9Dr 2  C9 1E          cmp #LEVEL_TILES              ;   the surplus stays here and buys the next
000A9Fr 2  90 20          bcc @No                       ;   level on the next step
000AA1r 2  E9 1E          sbc #LEVEL_TILES              ; Carry is set by the CMP that got us here
000AA3r 2  8D rr rr       sta TilesCleared
000AA6r 2               
000AA6r 2  AD rr rr       lda Level
000AA9r 2  C9 63          cmp #LEVEL_MAX_SHOWN
000AABr 2  B0 14          bcs @No                       ; The box is two digits wide (SPEC 10.1), and
000AADr 2  EE rr rr       inc Level                     ;   nothing about level 100 is reachable in a
000AB0r 2  20 rr rr       jsr RenderLevel               ;   session anyway
000AB3r 2  A9 0A          lda #SFX_LEVELUP
000AB5r 2  8D rr rr       sta SfxRequest
000AB8r 2  A9 00          lda #<BONUS_LEVELUP           ; SPEC 9.6 — an award, not a cascade point, so
000ABAr 2  A2 10          ldx #>BONUS_LEVELUP           ;   a star in the same cascade does not double
000ABCr 2  20 rr rr       jsr ScoreAward                ;   it (D5)
000ABFr 2  38             sec
000AC0r 2  60             rts
000AC1r 2               @No:
000AC1r 2  18             clc
000AC2r 2  60             rts
000AC3r 2               
000AC3r 2               ; -----------------------------------------------------------------------------
000AC3r 2               ;   ScoreFlashTick — one frame of the HIGH field's overtake flash
000AC3r 2               ;   Out: nothing.  Modifies: A, X, Y
000AC3r 2               ;   SPEC 9.8, SPEC 14 — the blink period is 30 frames NTSC / 25 PAL, shared
000AC3r 2               ;   with the title screen's prompt, so HighFlash counts HALF blinks and
000AC3r 2               ;   HighTimer counts the frames of one.
000AC3r 2               ;
000AC3r 2               ;   HighFlash is odd on the dark half and even on the lit one, and it ends at
000AC3r 2               ;   zero, so the field is always left readable however the count is set.
000AC3r 2               ; -----------------------------------------------------------------------------
000AC3r 2               ScoreFlashTick:
000AC3r 2  AD rr rr       lda HighFlash
000AC6r 2  F0 1F          beq @Done
000AC8r 2  CE rr rr       dec HighTimer
000ACBr 2  D0 1A          bne @Done
000ACDr 2  CE rr rr       dec HighFlash
000AD0r 2  F0 12          beq @Show                     ; Out of blinks — end lit
000AD2r 2  AE rr rr       ldx Region
000AD5r 2  BD rr rr       lda BlinkHalf,x
000AD8r 2  8D rr rr       sta HighTimer
000ADBr 2  AD rr rr       lda HighFlash
000ADEr 2  4A             lsr a
000ADFr 2  90 03          bcc @Show
000AE1r 2  4C rr rr       jmp RenderHighBlank
000AE4r 2               @Show:
000AE4r 2  4C rr rr       jmp RenderHigh
000AE7r 2               @Done:
000AE7r 2  60             rts
000AE8r 2               
000AE8r 2               ; -----------------------------------------------------------------------------
000AE8r 2               ;   ScoreGravity — frames per row for the current level
000AE8r 2               ;   Out: A = frame count, from SpeedNTSC or SpeedPAL per Region.
000AE8r 2               ;        Modifies: A, X
000AE8r 2               ;   SPEC 10.2. Strictly this module is P4's, but the falling piece cannot fall
000AE8r 2               ;   without it, so it is real ahead of the rest of the file — the same reason
000AE8r 2               ;   ScoreHighInit landed here in P1.
000AE8r 2               ; -----------------------------------------------------------------------------
000AE8r 2               ScoreGravity:
000AE8r 2  AE rr rr       ldx Level
000AEBr 2  CA             dex                           ; The table is indexed by level - 1 ...
000AECr 2  E0 10          cpx #LEVEL_SPEED_CAP
000AEEr 2  90 02          bcc @Level
000AF0r 2  A2 0F          ldx #LEVEL_SPEED_CAP - 1      ;   ... and stops improving at the cap
000AF2r 2               @Level:
000AF2r 2  AD rr rr       lda Region
000AF5r 2  D0 04          bne @Pal
000AF7r 2  BD rr rr       lda SpeedNTSC,x
000AFAr 2  60             rts
000AFBr 2               @Pal:
000AFBr 2  BD rr rr       lda SpeedPAL,x
000AFEr 2  60             rts
000AFFr 2               
000AFFr 1               .include "../src/render.asm"
000AFFr 2               ; =============================================================================
000AFFr 2               ;   render.asm — Wizards Lab, the dirty-cell renderer
000AFFr 2               ; =============================================================================
000AFFr 2               ;   SPEC.md section 12.6. The screen is never fully redrawn during play.
000AFFr 2               ;   Changed cells are appended to a ring and flushed once a frame, at most
000AFFr 2               ;   DIRTY_FLUSH_MAX per frame with the remainder carried over.
000AFFr 2               ;
000AFFr 2               ;   The cap is NOT a hardware write-spacing limit. S1 measured this loop at
000AFFr 2               ;   165 cycles a cell on the AC6502, which puts two VRAM data writes 165 us
000AFFr 2               ;   apart at 1 MHz and the closest two VDP PORT accesses 8 cycles apart —
000AFFr 2               ;   inside even a real TMS9918A's 8 us and 2 us windows with two orders of
000AFFr 2               ;   magnitude to spare, and further inside a pico9918's, which emulates VRAM
000AFFr 2               ;   in RP2040 memory and has no display contention at all. A 6502 at this
000AFFr 2               ;   clock cannot write a TMS9918 too fast however hard it tries.
000AFFr 2               ;
000AFFr 2               ;   The cap is a TIME BUDGET: DIRTY_FLUSH_MAX cells is what fits in vertical
000AFFr 2               ;   blank on the tightest of the three. See constants.inc and PLAN.md S1.
000AFFr 2               ;
000AFFr 2               ;   All screen access goes through HalPlotCell (see hal.inc). Nothing in this
000AFFr 2               ;   file knows where screen memory is.
000AFFr 2               ; =============================================================================
000AFFr 2               
000AFFr 2               ; -----------------------------------------------------------------------------
000AFFr 2               ;   RenderDirtyReset — empty the ring and cancel any outstanding board redraw
000AFFr 2               ;   Call this after anything that draws the whole screen behind the renderer's
000AFFr 2               ;   back (HalBlitScreen), because every queued cell then describes a screen
000AFFr 2               ;   that no longer exists.
000AFFr 2               ;   In:  nothing        Out: nothing.  Modifies: A
000AFFr 2               ; -----------------------------------------------------------------------------
000AFFr 2               RenderDirtyReset:
000AFFr 2  A9 00          lda #0
000B01r 2  8D rr rr       sta DirtyCount
000B04r 2  8D rr rr       sta DirtyHead
000B07r 2  8D rr rr       sta DirtyTail
000B0Ar 2  A9 FF          lda #$FF
000B0Cr 2  8D rr rr       sta RedrawIdx
000B0Fr 2  60             rts
000B10r 2               
000B10r 2               ; -----------------------------------------------------------------------------
000B10r 2               ;   RenderMark — queue one panel cell
000B10r 2               ;   In:  A = tile, X = panel column, Y = panel row
000B10r 2               ;   Out: nothing.  Modifies: A, X.  PRESERVES Y and every byte of zero page.
000B10r 2               ;
000B10r 2               ;   The PANEL_X / PANEL_Y offset is applied here, once, so nothing upstream
000B10r 2               ;   has to know which machine it is running on.
000B10r 2               ;
000B10r 2               ;   Preserving Y and zero page is a contract, not an accident: text.asm holds
000B10r 2               ;   its string cursor across this call (see zeropage.inc). The three values
000B10r 2               ;   ride the stack rather than scratch bytes because A, X and Y are all live
000B10r 2               ;   at once and there is no fourth register to index the ring with.
000B10r 2               ;
000B10r 2               ;   A mark that arrives with the ring full is DROPPED, silently (D6).
000B10r 2               ; -----------------------------------------------------------------------------
000B10r 2               RenderMark:
000B10r 2  48             pha                           ; Tile
000B11r 2  98             tya
000B12r 2  18             clc
000B13r 2  69 00          adc #PANEL_Y                  ; Panel row -> screen row
000B15r 2  48             pha
000B16r 2  8A             txa
000B17r 2  18             clc
000B18r 2  69 00          adc #PANEL_X                  ; Panel column -> screen column
000B1Ar 2  48             pha
000B1Br 2               
000B1Br 2  AD rr rr       lda DirtyCount
000B1Er 2  C9 40          cmp #DIRTY_ENTRIES
000B20r 2  B0 1F          bcs @Full
000B22r 2  EE rr rr       inc DirtyCount
000B25r 2               
000B25r 2  AE rr rr       ldx DirtyTail
000B28r 2  68             pla
000B29r 2  9D rr rr       sta Dirty+0,x                 ; Screen column
000B2Cr 2  68             pla
000B2Dr 2  9D rr rr       sta Dirty+1,x                 ; Screen row
000B30r 2  68             pla
000B31r 2  9D rr rr       sta Dirty+2,x                 ; Tile
000B34r 2               
000B34r 2  E8             inx                           ; Step one entry, wrapping the ring
000B35r 2  E8             inx
000B36r 2  E8             inx
000B37r 2  E0 C0          cpx #DIRTY_BYTES
000B39r 2  90 02          bcc @Store
000B3Br 2  A2 00          ldx #0
000B3Dr 2               @Store:
000B3Dr 2  8E rr rr       stx DirtyTail
000B40r 2  60             rts
000B41r 2               
000B41r 2               @Full:
000B41r 2  68             pla                           ; Unwind and drop it. The cell is wrong until
000B42r 2  68             pla                           ;   something marks it again.
000B43r 2  68             pla
000B44r 2  60             rts
000B45r 2               
000B45r 2               ; -----------------------------------------------------------------------------
000B45r 2               ;   RenderFlush — push up to DIRTY_FLUSH_MAX queued cells to the screen
000B45r 2               ;   Called once per frame, from the top of the main loop.
000B45r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
000B45r 2               ; -----------------------------------------------------------------------------
000B45r 2               RenderFlush:
000B45r 2  20 rr rr       jsr RenderBoardStep           ; Top the ring up from a board redraw, if one
000B48r 2                                               ;   is outstanding, so it always makes progress
000B48r 2  AD rr rr       lda DirtyCount
000B4Br 2  F0 31          beq @Done
000B4Dr 2  C9 18          cmp #DIRTY_FLUSH_MAX
000B4Fr 2  90 02          bcc @Budget
000B51r 2  A9 18          lda #DIRTY_FLUSH_MAX
000B53r 2               @Budget:
000B53r 2  85 rr          sta FlushLeft
000B55r 2               
000B55r 2               @Cell:
000B55r 2  AE rr rr       ldx DirtyHead
000B58r 2  BD rr rr       lda Dirty+1,x
000B5Br 2  A8             tay                           ; Y = screen row
000B5Cr 2  BD rr rr       lda Dirty+2,x
000B5Fr 2  48             pha                           ; Tile
000B60r 2  BD rr rr       lda Dirty+0,x
000B63r 2  AA             tax                           ; X = screen column
000B64r 2  68             pla                           ; A = tile
000B65r 2  20 rr rr       jsr HalPlotCell
000B68r 2               
000B68r 2  AD rr rr       lda DirtyHead                 ; Step one entry, wrapping the ring
000B6Br 2  18             clc
000B6Cr 2  69 03          adc #3
000B6Er 2  C9 C0          cmp #DIRTY_BYTES
000B70r 2  90 02          bcc @Store
000B72r 2  A9 00          lda #0
000B74r 2               @Store:
000B74r 2  8D rr rr       sta DirtyHead
000B77r 2  CE rr rr       dec DirtyCount
000B7Ar 2  C6 rr          dec FlushLeft
000B7Cr 2  D0 D7          bne @Cell
000B7Er 2               @Done:
000B7Er 2  60             rts
000B7Fr 2               
000B7Fr 2               ; -----------------------------------------------------------------------------
000B7Fr 2               ;   RenderBoard — ask for the whole 6 x 16 well to be redrawn
000B7Fr 2               ;   Used on state entry and after a pause, not per frame.
000B7Fr 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000B7Fr 2               ;
000B7Fr 2               ;   The well is 96 cells and the ring holds DIRTY_ENTRIES; a redraw therefore
000B7Fr 2               ;   cannot be queued in one go. This only sets the cursor. RenderBoardStep,
000B7Fr 2               ;   which RenderFlush calls every frame, feeds the ring as fast as it drains,
000B7Fr 2               ;   so the redraw spreads over as many frames as it needs and never drops a
000B7Fr 2               ;   cell.
000B7Fr 2               ; -----------------------------------------------------------------------------
000B7Fr 2               RenderBoard:
000B7Fr 2  A9 00          lda #0
000B81r 2  8D rr rr       sta RedrawIdx                 ; Board index 0 = row 0, column 0
000B84r 2  60             rts                           ; And nothing else. Falling through into the
000B85r 2                                               ;   step below would fill the ring here and
000B85r 2                                               ;   drop whatever the caller marks next.
000B85r 2               
000B85r 2               ; -----------------------------------------------------------------------------
000B85r 2               ;   RenderBoardStep — queue as much of an outstanding board redraw as fits
000B85r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000B85r 2               ;   Does nothing when RedrawIdx is $FF.
000B85r 2               ; -----------------------------------------------------------------------------
000B85r 2               RenderBoardStep:
000B85r 2  AD rr rr       lda RedrawIdx
000B88r 2  30 41          bmi @Done                     ; $FF — nothing outstanding
000B8Ar 2               
000B8Ar 2               @Cell:
000B8Ar 2  AD rr rr       lda DirtyCount
000B8Dr 2  C9 40          cmp #DIRTY_ENTRIES
000B8Fr 2  B0 3A          bcs @Done                     ; Ring full — pick this cell up next frame
000B91r 2               
000B91r 2  AE rr rr       ldx RedrawIdx
000B94r 2  8A             txa
000B95r 2  29 07          and #(BOARD_STRIDE - 1)
000B97r 2  18             clc
000B98r 2  69 01          adc #WELL_ORIGIN_X
000B9Ar 2  85 rr          sta RedrawCol
000B9Cr 2  8A             txa
000B9Dr 2  4A             lsr a                         ; Board index >> 3 is the row (stride 8)
000B9Er 2  4A             lsr a
000B9Fr 2  4A             lsr a
000BA0r 2  18             clc
000BA1r 2  69 04          adc #WELL_ORIGIN_Y
000BA3r 2  A8             tay                           ; Y = panel row
000BA4r 2  BD rr rr       lda Board,x                   ; The board byte IS the tile — empty is $00,
000BA7r 2  A6 rr          ldx RedrawCol                 ;   which is TILE_BLANK (SPEC 3.3, 4.2)
000BA9r 2  20 rr rr       jsr RenderMark
000BACr 2               
000BACr 2  AE rr rr       ldx RedrawIdx                 ; Advance, stepping over the two sentinel
000BAFr 2  E8             inx                           ;   columns at the end of each row
000BB0r 2  8A             txa
000BB1r 2  29 07          and #(BOARD_STRIDE - 1)
000BB3r 2  C9 06          cmp #BOARD_W
000BB5r 2  90 05          bcc @Save
000BB7r 2  8A             txa
000BB8r 2  18             clc
000BB9r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000BBBr 2  AA             tax
000BBCr 2               @Save:
000BBCr 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
000BBEr 2  B0 06          bcs @Finish
000BC0r 2  8E rr rr       stx RedrawIdx
000BC3r 2  4C rr rr       jmp @Cell
000BC6r 2               
000BC6r 2               @Finish:
000BC6r 2  A9 FF          lda #$FF
000BC8r 2  8D rr rr       sta RedrawIdx
000BCBr 2               @Done:
000BCBr 2  60             rts
000BCCr 2               
000BCCr 2               ; -----------------------------------------------------------------------------
000BCCr 2               ;   RenderCell — queue one board cell by board index
000BCCr 2               ;   In:  X = board index (row * BOARD_STRIDE + column)
000BCCr 2               ;   Out: nothing.  Modifies: A, X, Y
000BCCr 2               ;   The single-cell form of RenderBoardStep, for the phases that move one tile
000BCCr 2               ;   at a time.
000BCCr 2               ; -----------------------------------------------------------------------------
000BCCr 2               RenderCell:
000BCCr 2  8A             txa
000BCDr 2  29 07          and #(BOARD_STRIDE - 1)
000BCFr 2  18             clc
000BD0r 2  69 01          adc #WELL_ORIGIN_X
000BD2r 2  85 rr          sta RedrawCol
000BD4r 2  8A             txa
000BD5r 2  4A             lsr a
000BD6r 2  4A             lsr a
000BD7r 2  4A             lsr a
000BD8r 2  18             clc
000BD9r 2  69 04          adc #WELL_ORIGIN_Y
000BDBr 2  A8             tay
000BDCr 2  BD rr rr       lda Board,x
000BDFr 2  A6 rr          ldx RedrawCol
000BE1r 2  4C rr rr       jmp RenderMark
000BE4r 2               
000BE4r 2               ; -----------------------------------------------------------------------------
000BE4r 2               ;   RenderPiece — queue the three falling cells at where the piece is now
000BE4r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000BE4r 2               ;
000BE4r 2               ;   RenderMark clobbers X and keeps Y, so the panel column is parked in
000BE4r 2               ;   RedrawCol and the panel row rides Y down the three cells. Cell C can never
000BE4r 2               ;   be lower than board row 15, so all three are always inside the well and
000BE4r 2               ;   there is nothing to clip.
000BE4r 2               ; -----------------------------------------------------------------------------
000BE4r 2               RenderPiece:
000BE4r 2  AD rr rr       lda PieceCol
000BE7r 2  18             clc
000BE8r 2  69 01          adc #WELL_ORIGIN_X
000BEAr 2  85 rr          sta RedrawCol
000BECr 2  AD rr rr       lda PieceRow
000BEFr 2  18             clc
000BF0r 2  69 04          adc #WELL_ORIGIN_Y
000BF2r 2  A8             tay
000BF3r 2  AD rr rr       lda PieceA
000BF6r 2  A6 rr          ldx RedrawCol
000BF8r 2  20 rr rr       jsr RenderMark
000BFBr 2  C8             iny
000BFCr 2  AD rr rr       lda PieceB
000BFFr 2  A6 rr          ldx RedrawCol
000C01r 2  20 rr rr       jsr RenderMark
000C04r 2  C8             iny
000C05r 2  AD rr rr       lda PieceC
000C08r 2  A6 rr          ldx RedrawCol
000C0Ar 2  4C rr rr       jmp RenderMark
000C0Dr 2               
000C0Dr 2               ; -----------------------------------------------------------------------------
000C0Dr 2               ;   RenderPieceErase — blank the three cells the piece is leaving
000C0Dr 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000C0Dr 2               ;
000C0Dr 2               ;   Three blanks rather than three board reads, because the cells under a
000C0Dr 2               ;   falling piece are always empty: every move and every gravity step tests
000C0Dr 2               ;   the target cells before it happens, and the one thing that writes them is
000C0Dr 2               ;   PieceLock, after which nothing erases the piece again (piece.asm).
000C0Dr 2               ; -----------------------------------------------------------------------------
000C0Dr 2               RenderPieceErase:
000C0Dr 2  AD rr rr       lda PieceCol
000C10r 2  18             clc
000C11r 2  69 01          adc #WELL_ORIGIN_X
000C13r 2  85 rr          sta RedrawCol
000C15r 2  AD rr rr       lda PieceRow
000C18r 2  18             clc
000C19r 2  69 04          adc #WELL_ORIGIN_Y
000C1Br 2  A8             tay
000C1Cr 2  A9 00          lda #TILE_EMPTY
000C1Er 2  A6 rr          ldx RedrawCol
000C20r 2  20 rr rr       jsr RenderMark
000C23r 2  C8             iny
000C24r 2  A9 00          lda #TILE_EMPTY
000C26r 2  A6 rr          ldx RedrawCol
000C28r 2  20 rr rr       jsr RenderMark
000C2Br 2  C8             iny
000C2Cr 2  A9 00          lda #TILE_EMPTY
000C2Er 2  A6 rr          ldx RedrawCol
000C30r 2  4C rr rr       jmp RenderMark
000C33r 2               
000C33r 2               ; -----------------------------------------------------------------------------
000C33r 2               ;   RenderNext — the preview, panel column NEXT_X, rows NEXT_Y..NEXT_Y+2
000C33r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000C33r 2               ;
000C33r 2               ;   All three cells every time. The play screen image ships with a piece
000C33r 2               ;   already drawn in the NEXT box (SPEC 12.1), so this has to overwrite rather
000C33r 2               ;   than assume it is drawing onto backdrop.
000C33r 2               ; -----------------------------------------------------------------------------
000C33r 2               RenderNext:
000C33r 2  A0 10          ldy #NEXT_Y
000C35r 2  AD rr rr       lda NextA
000C38r 2  A2 0B          ldx #NEXT_X
000C3Ar 2  20 rr rr       jsr RenderMark
000C3Dr 2  C8             iny
000C3Er 2  AD rr rr       lda NextB
000C41r 2  A2 0B          ldx #NEXT_X
000C43r 2  20 rr rr       jsr RenderMark
000C46r 2  C8             iny
000C47r 2  AD rr rr       lda NextC
000C4Ar 2  A2 0B          ldx #NEXT_X
000C4Cr 2  4C rr rr       jmp RenderMark
000C4Fr 2               
000C4Fr 2               ; -----------------------------------------------------------------------------
000C4Fr 2               ;   RenderScore / RenderHigh / RenderLevel — only called when a value changes
000C4Fr 2               ;   Nothing here compares anything: the caller knows when it changed a value
000C4Fr 2               ;   and these are not cheap enough to run every frame. SCORE_DIGITS cells is
000C4Fr 2               ;   most of a frame's flush budget on its own.
000C4Fr 2               ; -----------------------------------------------------------------------------
000C4Fr 2               RenderScore:
000C4Fr 2  A9 rr          lda #<ScoreLo
000C51r 2  85 rr          sta Ptr1
000C53r 2  A9 rr          lda #>ScoreLo
000C55r 2  85 rr          sta Ptr1+1
000C57r 2  A2 0C          ldx #SCORE_X
000C59r 2  A0 05          ldy #SCORE_Y
000C5Br 2  A9 07          lda #SCORE_DIGITS
000C5Dr 2  4C rr rr       jmp TextBcd
000C60r 2               
000C60r 2               RenderHigh:
000C60r 2  A9 rr          lda #<HighLo
000C62r 2  85 rr          sta Ptr1
000C64r 2  A9 rr          lda #>HighLo
000C66r 2  85 rr          sta Ptr1+1
000C68r 2  A2 0C          ldx #HIGH_X
000C6Ar 2  A0 0A          ldy #HIGH_Y
000C6Cr 2  A9 07          lda #SCORE_DIGITS
000C6Er 2  20 rr rr       jsr TextBcd
000C71r 2               
000C71r 2  A9 rr          lda #<HighLevel               ; The level it was set on, under the digits
000C73r 2  85 rr          sta Ptr1
000C75r 2  A9 rr          lda #>HighLevel
000C77r 2  85 rr          sta Ptr1+1
000C79r 2  A2 0F          ldx #HIGHLVL_X
000C7Br 2  A0 0B          ldy #HIGHLVL_Y
000C7Dr 2  A9 02          lda #LEVEL_DIGITS
000C7Fr 2  4C rr rr       jmp TextBcd
000C82r 2               
000C82r 2               ; -----------------------------------------------------------------------------
000C82r 2               ;   RenderHighBlank — the dark half of the HIGH field's overtake flash
000C82r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y, TextCol
000C82r 2               ;   SPEC 9.8. The seven digits only; the level under them stays put, so the
000C82r 2               ;   box never looks empty and the flash costs seven cells of the budget.
000C82r 2               ; -----------------------------------------------------------------------------
000C82r 2               RenderHighBlank:
000C82r 2  A9 0C          lda #HIGH_X
000C84r 2  85 rr          sta TextCol                   ; Not X: RenderMark clobbers it
000C86r 2               @Cell:
000C86r 2  A9 00          lda #TILE_BLANK
000C88r 2  A6 rr          ldx TextCol
000C8Ar 2  A0 0A          ldy #HIGH_Y
000C8Cr 2  20 rr rr       jsr RenderMark
000C8Fr 2  E6 rr          inc TextCol
000C91r 2  A5 rr          lda TextCol
000C93r 2  C9 13          cmp #(HIGH_X + SCORE_DIGITS)
000C95r 2  90 EF          bcc @Cell
000C97r 2  60             rts
000C98r 2               
000C98r 2               RenderLevel:
000C98r 2  AD rr rr       lda Level
000C9Br 2  4C rr rr       jmp TextLevel
000C9Er 2               
000C9Er 1               .include "../src/text.asm"
000C9Er 2               ; =============================================================================
000C9Er 2               ;   text.asm — Wizards Lab, text and numbers on the panel
000C9Er 2               ; =============================================================================
000C9Er 2               ;   The font lives in tile groups 2-6, forty glyphs in the order
000C9Er 2               ;
000C9Er 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
000C9Er 2               ;
000C9Er 2               ;   starting at FONT_BASE, so a digit is FONT_DIGIT_0 + value and a letter is
000C9Er 2               ;   FONT_LETTER_A + (letter - 'A'). Strings are stored pre-converted to tile
000C9Er 2               ;   numbers, terminated by TEXT_END, so drawing one is a copy with no
000C9Er 2               ;   translation. src/strings.inc holds them and the macro that encodes them.
000C9Er 2               ;
000C9Er 2               ;   Everything here draws through RenderMark, never to the screen: text is
000C9Er 2               ;   panel cells like any other and goes through the same one flush a frame.
000C9Er 2               ;   That is also why the cursor state lives in the zero-page block RenderMark
000C9Er 2               ;   promises not to touch (zeropage.inc) rather than in Tmp0-Tmp3.
000C9Er 2               ; =============================================================================
000C9Er 2               
000C9Er 2               ; -----------------------------------------------------------------------------
000C9Er 2               ;   TextDraw — draw a tile-encoded string
000C9Er 2               ;   In:  Ptr1 -> string (TEXT_END terminated), X = panel column, Y = panel row
000C9Er 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx
000C9Er 2               ; -----------------------------------------------------------------------------
000C9Er 2               TextDraw:
000C9Er 2  86 rr          stx TextCol
000CA0r 2  84 rr          sty TextRow
000CA2r 2  A9 00          lda #0
000CA4r 2  85 rr          sta TextIdx
000CA6r 2               @Char:
000CA6r 2  A4 rr          ldy TextIdx
000CA8r 2  B1 rr          lda (Ptr1),y
000CAAr 2  C9 FF          cmp #TEXT_END
000CACr 2  F0 0D          beq @Done
000CAEr 2  A6 rr          ldx TextCol
000CB0r 2  A4 rr          ldy TextRow
000CB2r 2  20 rr rr       jsr RenderMark
000CB5r 2  E6 rr          inc TextCol
000CB7r 2  E6 rr          inc TextIdx
000CB9r 2  D0 EB          bne @Char                     ; Always — a string is never 256 tiles long
000CBBr 2               @Done:
000CBBr 2  60             rts
000CBCr 2               
000CBCr 2               ; -----------------------------------------------------------------------------
000CBCr 2               ;   TextBcd — draw a packed-BCD number, zero padded
000CBCr 2               ;   In:  Ptr1 -> BCD bytes (low first), A = digit count,
000CBCr 2               ;        X = panel column, Y = panel row
000CBCr 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx, TextByte,
000CBCr 2               ;        TextSkip
000CBCr 2               ;
000CBCr 2               ;   SCORE_DIGITS (7) for the score and the high score, 2 for the high score's
000CBCr 2               ;   level. The LEVEL box is not drawn with this — see TextLevel.
000CBCr 2               ;
000CBCr 2               ;   The count is in DIGITS, not bytes, because the score is seven digits in
000CBCr 2               ;   four bytes: the top nibble of the most significant byte is held at zero
000CBCr 2               ;   (SPEC 9) and must not be drawn, or the field would be eight cells wide and
000CBCr 2               ;   no longer centred. An odd count starts at the LOW nibble of the top byte.
000CBCr 2               ;
000CBCr 2               ;   **Every digit is drawn, every time.** A leading zero is a zero glyph, not
000CBCr 2               ;   a blank: 1250 draws as 0001250. There is no suppression pass and no
000CBCr 2               ;   right-alignment — the field is fixed width so a digit never changes
000CBCr 2               ;   column while the player is watching it (SPEC 9). This also makes the
000CBCr 2               ;   routine branchless, and lets RenderScore mark a fixed run of cells dirty.
000CBCr 2               ; -----------------------------------------------------------------------------
000CBCr 2               TextBcd:
000CBCr 2  86 rr          stx TextCol
000CBEr 2  84 rr          sty TextRow
000CC0r 2  48             pha                           ; Digit count
000CC1r 2  29 01          and #$01
000CC3r 2  85 rr          sta TextSkip                  ; Odd count: the top high nibble is not drawn
000CC5r 2  68             pla
000CC6r 2  18             clc
000CC7r 2  69 01          adc #1                        ; Bytes = (digits + 1) / 2
000CC9r 2  4A             lsr a
000CCAr 2  AA             tax
000CCBr 2  CA             dex
000CCCr 2  86 rr          stx TextIdx                   ; Start at the most significant byte
000CCEr 2               
000CCEr 2               @Byte:
000CCEr 2  A4 rr          ldy TextIdx
000CD0r 2  B1 rr          lda (Ptr1),y
000CD2r 2  85 rr          sta TextByte
000CD4r 2               
000CD4r 2  A5 rr          lda TextSkip
000CD6r 2  D0 09          bne @Low
000CD8r 2  A5 rr          lda TextByte
000CDAr 2  4A             lsr a
000CDBr 2  4A             lsr a
000CDCr 2  4A             lsr a
000CDDr 2  4A             lsr a
000CDEr 2  20 rr rr       jsr TextDigit
000CE1r 2               @Low:
000CE1r 2  A9 00          lda #0
000CE3r 2  85 rr          sta TextSkip
000CE5r 2  A5 rr          lda TextByte
000CE7r 2  29 0F          and #$0F
000CE9r 2  20 rr rr       jsr TextDigit
000CECr 2               
000CECr 2  C6 rr          dec TextIdx
000CEEr 2  10 DE          bpl @Byte
000CF0r 2  60             rts
000CF1r 2               
000CF1r 2               ; -----------------------------------------------------------------------------
000CF1r 2               ;   TextDigit — draw one digit at the cursor and step it right
000CF1r 2               ;   In:  A = value 0-9      Modifies: A, X, Y, TextCol
000CF1r 2               ; -----------------------------------------------------------------------------
000CF1r 2               TextDigit:
000CF1r 2  18             clc
000CF2r 2  69 10          adc #FONT_DIGIT_0
000CF4r 2  A6 rr          ldx TextCol
000CF6r 2  A4 rr          ldy TextRow
000CF8r 2  20 rr rr       jsr RenderMark
000CFBr 2  E6 rr          inc TextCol
000CFDr 2  60             rts
000CFEr 2               
000CFEr 2               ; -----------------------------------------------------------------------------
000CFEr 2               ;   TextBanner — centre a string in the one-row message band
000CFEr 2               ;   In:  Ptr1 -> string
000CFEr 2               ;   Out: nothing.  Modifies: A, X, Y and the text cursor
000CFEr 2               ;
000CFEr 2               ;   SPEC 12.2 — the band is panel row MSG_Y, full width, one row only. The
000CFEr 2               ;   string arrives already wrapped as `~~ TEXT ~~` — two FONT_TILDE, a blank,
000CFEr 2               ;   the text, a blank, two FONT_TILDE. Centring is (PANEL_W - length) / 2,
000CFEr 2               ;   which is why banner strings are drawn even-length.
000CFEr 2               ; -----------------------------------------------------------------------------
000CFEr 2               TextBanner:
000CFEr 2  A0 00          ldy #0
000D00r 2               @Len:
000D00r 2  B1 rr          lda (Ptr1),y
000D02r 2  C9 FF          cmp #TEXT_END
000D04r 2  F0 03          beq @Got
000D06r 2  C8             iny
000D07r 2  D0 F7          bne @Len
000D09r 2               @Got:
000D09r 2  98             tya
000D0Ar 2  85 rr          sta TextIdx
000D0Cr 2  A9 16          lda #PANEL_W
000D0Er 2  38             sec
000D0Fr 2  E5 rr          sbc TextIdx
000D11r 2  4A             lsr a                         ; (PANEL_W - length) / 2
000D12r 2  AA             tax
000D13r 2  A0 16          ldy #MSG_Y
000D15r 2  4C rr rr       jmp TextDraw
000D18r 2               
000D18r 2               ; -----------------------------------------------------------------------------
000D18r 2               ;   TextBannerClear — blank the message band back to backdrop
000D18r 2               ;   Out: nothing.  Modifies: A, X, Y
000D18r 2               ;
000D18r 2               ;   Columns MSG_X .. MSG_X + MSG_W - 1 only. The shelf tiles at either end of
000D18r 2               ;   the band belong to the static screen image and are never redrawn.
000D18r 2               ; -----------------------------------------------------------------------------
000D18r 2               TextBannerClear:
000D18r 2  A9 02          lda #MSG_X
000D1Ar 2  85 rr          sta TextCol                   ; Not X: RenderMark clobbers it
000D1Cr 2               @Cell:
000D1Cr 2  A9 00          lda #TILE_BLANK
000D1Er 2  A6 rr          ldx TextCol
000D20r 2  A0 16          ldy #MSG_Y
000D22r 2  20 rr rr       jsr RenderMark
000D25r 2  E6 rr          inc TextCol
000D27r 2  A5 rr          lda TextCol
000D29r 2  C9 14          cmp #(MSG_X + MSG_W)
000D2Br 2  90 EF          bcc @Cell
000D2Dr 2  60             rts
000D2Er 2               
000D2Er 2               ; -----------------------------------------------------------------------------
000D2Er 2               ;   TextLevel — the LEVEL box, tens above units in one column
000D2Er 2               ;   In:  A = level (binary, 1-99)
000D2Er 2               ;   Out: nothing.  Modifies: A, X, Y, TextByte
000D2Er 2               ;   SPEC 12.2 — LEVEL_X, tens at LEVEL_Y and units at LEVEL_Y + 1. Always two
000D2Er 2               ;   digits: level 5 draws "0" over "5".
000D2Er 2               ; -----------------------------------------------------------------------------
000D2Er 2               TextLevel:
000D2Er 2  A2 00          ldx #0
000D30r 2               @Tens:
000D30r 2  C9 0A          cmp #10
000D32r 2  90 05          bcc @Split
000D34r 2  E9 0A          sbc #10                       ; Carry is set by the CMP that got us here
000D36r 2  E8             inx
000D37r 2  D0 F7          bne @Tens                     ; Always — X tops out at 9
000D39r 2               @Split:
000D39r 2  85 rr          sta TextByte                  ; Units
000D3Br 2  8A             txa
000D3Cr 2  18             clc
000D3Dr 2  69 10          adc #FONT_DIGIT_0
000D3Fr 2  A2 12          ldx #LEVEL_X
000D41r 2  A0 11          ldy #LEVEL_Y
000D43r 2  20 rr rr       jsr RenderMark
000D46r 2  A5 rr          lda TextByte
000D48r 2  18             clc
000D49r 2  69 10          adc #FONT_DIGIT_0
000D4Br 2  A2 12          ldx #LEVEL_X
000D4Dr 2  A0 12          ldy #LEVEL_Y + 1
000D4Fr 2  4C rr rr       jmp RenderMark
000D52r 2               
000D52r 1               .include "../src/audio.asm"
000D52r 2               ; =============================================================================
000D52r 2               ;   audio.asm — Wizards Lab, sound
000D52r 2               ; =============================================================================
000D52r 2               ;   SPEC.md section 16. Out of scope for the first playable build, but the
000D52r 2               ;   hook is here from the start so game logic never has to be revisited to add
000D52r 2               ;   it: logic writes an effect id to SfxRequest and forgets about it.
000D52r 2               ;
000D52r 2               ;   The AC6502 and the C64 both have a SID and can share a driver — only the
000D52r 2               ;   register base differs ($9800 against $D400). The VIC-20 needs its own,
000D52r 2               ;   against $900A-$900E.
000D52r 2               ; =============================================================================
000D52r 2               
000D52r 2               SFX_MOVE        = 1
000D52r 2               SFX_ROTATE      = 2
000D52r 2               SFX_LOCK        = 3
000D52r 2               SFX_MATCH       = 4
000D52r 2               SFX_FIREBALL    = 5
000D52r 2               SFX_BOLT        = 6
000D52r 2               SFX_BOMB        = 7
000D52r 2               SFX_STAR        = 8
000D52r 2               SFX_PRISM       = 9
000D52r 2               SFX_LEVELUP     = 10
000D52r 2               SFX_HIGHSCORE   = 11
000D52r 2               SFX_GAMEOVER    = 12
000D52r 2               
000D52r 2               ; -----------------------------------------------------------------------------
000D52r 2               ;   AudioInit — silence everything
000D52r 2               ; -----------------------------------------------------------------------------
000D52r 2               AudioInit:
000D52r 2  A9 00          lda #0
000D54r 2  8D rr rr       sta SfxRequest
000D57r 2  8D rr rr       sta SfxTimer
000D5Ar 2  60             rts
000D5Br 2               
000D5Br 2               ; -----------------------------------------------------------------------------
000D5Br 2               ;   AudioTick — called once per frame, consumes SfxRequest
000D5Br 2               ; -----------------------------------------------------------------------------
000D5Br 2               AudioTick:
000D5Br 2                 ; TODO: start a new effect when SfxRequest is non-zero, then advance the
000D5Br 2                 ; envelope of whatever is playing. Calls HalSfx for the register writes.
000D5Br 2  A9 00          lda #0
000D5Dr 2  8D rr rr       sta SfxRequest
000D60r 2  60             rts
000D61r 2               
000D61r 1               
000D61r 1               ; =============================================================================
000D61r 1               ;   HAL — VIC-I, hi-res text
000D61r 1               ; =============================================================================
000D61r 1               
000D61r 1               ; -----------------------------------------------------------------------------
000D61r 1               ;   HalInitVideo — 22 x 23 cells, custom charset in RAM, everything black
000D61r 1               ; -----------------------------------------------------------------------------
000D61r 1               HalInitVideo:
000D61r 1                 ; Screen centring. The KERNAL normally sets these, but an autostart cart
000D61r 1                 ; takes over before it gets that far, so they are still at their power-on
000D61r 1                 ; values and the picture sits in the wrong place. The right pair depends on
000D61r 1                 ; the region, which is why HalDetectRegion runs before this.
000D61r 1  A2 05          ldx #$05                      ; NTSC
000D63r 1  A0 19          ldy #$19
000D65r 1  AD rr rr       lda Region
000D68r 1  F0 04          beq @Centre
000D6Ar 1  A2 0C          ldx #$0C                      ; PAL
000D6Cr 1  A0 26          ldy #$26
000D6Er 1               @Centre:
000D6Er 1  8E 00 90       stx VIC_CR0                   ; Horizontal centring (bit 7 = interlace, off)
000D71r 1  8C 01 90       sty VIC_CR1                   ; Vertical centring
000D74r 1               
000D74r 1  A9 96          lda #$96                      ; 22 columns, video matrix bit 9 set -> $1E00
000D76r 1  8D 02 90       sta VIC_CR2
000D79r 1  A9 2E          lda #$2E                      ; 23 rows (46 half-lines), 8-pixel characters
000D7Br 1  8D 03 90       sta VIC_CR3
000D7Er 1  A9 FD          lda #$FD                      ; Screen $1E00, character set $1400
000D80r 1  8D 05 90       sta VIC_CR5
000D83r 1  A9 08          lda #$08                      ; Black background, black border, normal video
000D85r 1  8D 0F 90       sta VIC_CRF
000D88r 1               
000D88r 1  20 rr rr       jsr LoadTileset
000D8Br 1                 ; falls through
000D8Br 1               
000D8Br 1               ; -----------------------------------------------------------------------------
000D8Br 1               ;   HalClearScreen — blank tiles, white colour RAM
000D8Br 1               ; -----------------------------------------------------------------------------
000D8Br 1               HalClearScreen:
000D8Br 1  A2 00          ldx #0                        ; 506 cells = one full page plus 250
000D8Dr 1               @Page0:
000D8Dr 1  A9 00          lda #TILE_BLANK
000D8Fr 1  9D 00 1E       sta SCREEN + $0000,x
000D92r 1  A9 01          lda #1                        ; White
000D94r 1  9D 00 96       sta COLRAM + $0000,x
000D97r 1  E8             inx
000D98r 1  D0 F3          bne @Page0
000D9Ar 1               @Page1:
000D9Ar 1  A9 00          lda #TILE_BLANK
000D9Cr 1  9D 00 1F       sta SCREEN + $0100,x
000D9Fr 1  A9 01          lda #1
000DA1r 1  9D 00 97       sta COLRAM + $0100,x
000DA4r 1  E8             inx
000DA5r 1  E0 FA          cpx #250                      ; $1E00 + 506 = $1FFA, the end of the matrix
000DA7r 1  D0 F1          bne @Page1
000DA9r 1  60             rts
000DAAr 1               
000DAAr 1               ; -----------------------------------------------------------------------------
000DAAr 1               ;   LoadTileset — copy 2 K of patterns from BLK3 into RAM at $1400
000DAAr 1               ;   The VIC chip cannot see cartridge ROM, so this copy is not optional.
000DAAr 1               ;   PLACEHOLDER ART: Tileset is data/tileset.bin. See data/README.md.
000DAAr 1               ; -----------------------------------------------------------------------------
000DAAr 1               LoadTileset:
000DAAr 1  A9 rr          lda #<Tileset
000DACr 1  85 rr          sta SrcPtr
000DAEr 1  A9 rr          lda #>Tileset
000DB0r 1  85 rr          sta SrcPtr+1
000DB2r 1  A9 00          lda #<CHARSET_RAM
000DB4r 1  85 rr          sta DstPtr
000DB6r 1  A9 14          lda #>CHARSET_RAM
000DB8r 1  85 rr          sta DstPtr+1
000DBAr 1               
000DBAr 1  A2 08          ldx #8                        ; 8 x 256 = 2048 bytes
000DBCr 1  A0 00          ldy #0
000DBEr 1               @Byte:
000DBEr 1  B1 rr          lda (SrcPtr),y
000DC0r 1  91 rr          sta (DstPtr),y
000DC2r 1  C8             iny
000DC3r 1  D0 F9          bne @Byte
000DC5r 1  E6 rr          inc SrcPtr+1
000DC7r 1  E6 rr          inc DstPtr+1
000DC9r 1  CA             dex
000DCAr 1  D0 F2          bne @Byte
000DCCr 1  60             rts
000DCDr 1               
000DCDr 1               ; -----------------------------------------------------------------------------
000DCDr 1               ;   HalWaitFrame — sync on the top of the raster
000DCDr 1               ; -----------------------------------------------------------------------------
000DCDr 1               HalWaitFrame:
000DCDr 1               @NotTop:
000DCDr 1  AD 04 90       lda VIC_CR4                   ; Raster line / 2
000DD0r 1  F0 FB          beq @NotTop                   ; Leave the top of the frame first...
000DD2r 1               @Top:
000DD2r 1  AD 04 90       lda VIC_CR4
000DD5r 1  D0 FB          bne @Top                      ; ...then wait for it to come round again
000DD7r 1  60             rts
000DD8r 1               
000DD8r 1               ; -----------------------------------------------------------------------------
000DD8r 1               ;   HalPlotCell — In: A = tile, X = screen column, Y = screen row
000DD8r 1               ; -----------------------------------------------------------------------------
000DD8r 1               HalPlotCell:
000DD8r 1  48             pha                           ; Hold the tile; RowPtrs needs A
000DD9r 1  20 rr rr       jsr RowPtrs                   ; ScreenPtr / ColorPtr = start of row Y
000DDCr 1  8A             txa
000DDDr 1  A8             tay                           ; Y = column
000DDEr 1  68             pla                           ; A = tile
000DDFr 1  91 rr          sta (ScreenPtr),y
000DE1r 1  AA             tax                           ; The tile is its own colour lookup index
000DE2r 1  BD rr rr       lda TileColorVIC,x
000DE5r 1  91 rr          sta (ColorPtr),y
000DE7r 1  60             rts
000DE8r 1               
000DE8r 1               ; -----------------------------------------------------------------------------
000DE8r 1               ;   RowPtrs — In: Y = screen row.  Out: ScreenPtr, ColorPtr at that row
000DE8r 1               ; -----------------------------------------------------------------------------
000DE8r 1               RowPtrs:
000DE8r 1  B9 rr rr       lda RowLo,y
000DEBr 1  85 rr          sta ScreenPtr
000DEDr 1  85 rr          sta ColorPtr
000DEFr 1  B9 rr rr       lda RowHi,y
000DF2r 1  85 rr          sta ScreenPtr+1
000DF4r 1  18             clc
000DF5r 1  69 78          adc #(>COLRAM - >SCREEN)      ; Colour RAM mirrors the matrix, page-offset
000DF7r 1  85 rr          sta ColorPtr+1
000DF9r 1  60             rts
000DFAr 1               
000DFAr 1               ; -----------------------------------------------------------------------------
000DFAr 1               ;   HalBlitScreen — draw a full 506-byte screen plus its colour image
000DFAr 1               ;   In: SrcPtr -> name table, Ptr1 -> colour table
000DFAr 1               ; -----------------------------------------------------------------------------
000DFAr 1               HalBlitScreen:
000DFAr 1  A0 00          ldy #0                        ; 506 cells = one full page plus 250
000DFCr 1               @Page0:
000DFCr 1  B1 rr          lda (SrcPtr),y
000DFEr 1  99 00 1E       sta SCREEN + $0000,y
000E01r 1  B1 rr          lda (Ptr1),y
000E03r 1  99 00 96       sta COLRAM + $0000,y
000E06r 1  C8             iny
000E07r 1  D0 F3          bne @Page0
000E09r 1               
000E09r 1  E6 rr          inc SrcPtr+1
000E0Br 1  E6 rr          inc Ptr1+1
000E0Dr 1  A0 00          ldy #0
000E0Fr 1               @Page1:
000E0Fr 1  B1 rr          lda (SrcPtr),y
000E11r 1  99 00 1F       sta SCREEN + $0100,y
000E14r 1  B1 rr          lda (Ptr1),y
000E16r 1  99 00 97       sta COLRAM + $0100,y
000E19r 1  C8             iny
000E1Ar 1  C0 FA          cpy #250                      ; Anything past here is not screen memory
000E1Cr 1  D0 F1          bne @Page1
000E1Er 1  60             rts
000E1Fr 1               
000E1Fr 1               ; -----------------------------------------------------------------------------
000E1Fr 1               ;   HalReadInput — joystick and keyboard, folded into one active-high mask
000E1Fr 1               ;
000E1Fr 1               ;   The VIC splits its stick across two chips: up, down, left and fire are on
000E1Fr 1               ;   VIA1 $9111, but RIGHT is on VIA2 $9120 bit 7 — which is also the last of
000E1Fr 1               ;   the eight keyboard row lines. That collision is PLAN.md S4, and it turns
000E1Fr 1               ;   out not to be one:
000E1Fr 1               ;
000E1Fr 1               ;     Every key this game reads lives in matrix rows 1-6. Row 0 is the top
000E1Fr 1               ;     number row and row 7 the rest of it, and the game wants neither. So DDRB
000E1Fr 1               ;     is set ONCE to $7F and never touched again — PB0-PB6 drive the six rows
000E1Fr 1               ;     that matter, PB7 stays an input for the RIGHT switch, and the two never
000E1Fr 1               ;     take turns.
000E1Fr 1               ;
000E1Fr 1               ;   That is better than flipping the DDR twice a frame, and not only because
000E1Fr 1               ;   it is shorter: driving PB7 high while a closed RIGHT switch pulls it to
000E1Fr 1               ;   ground puts the VIA's output stage against the joystick, and never
000E1Fr 1               ;   configuring PB7 as an output means that cannot happen at all.
000E1Fr 1               ; -----------------------------------------------------------------------------
000E1Fr 1               HalReadInput:
000E1Fr 1  AD 13 91       lda $9113                     ; VIA1 DDR: the joystick lines are inputs
000E22r 1  29 C3          and #%11000011
000E24r 1  8D 13 91       sta $9113
000E27r 1               
000E27r 1  A9 7F          lda #%01111111                ; VIA2 DDRB: rows 0-6 out, RIGHT switch in
000E29r 1  8D 22 91       sta $9122
000E2Cr 1  A9 00          lda #$00                      ; VIA2 DDRA: the column lines are inputs
000E2Er 1  8D 23 91       sta $9123
000E31r 1               
000E31r 1  AD 11 91       lda $9111                     ; Active low: bit2 U, bit3 D, bit4 L, bit5 fire
000E34r 1  49 FF          eor #$FF
000E36r 1  29 3C          and #%00111100                ; Only those four; PA7 here is not the stick
000E38r 1  85 rr          sta Tmp0
000E3Ar 1               
000E3Ar 1  AD 20 91       lda $9120
000E3Dr 1  49 FF          eor #$FF
000E3Fr 1  29 80          and #$80                      ; Fold RIGHT in as bit 7 of the same byte
000E41r 1  05 rr          ora Tmp0
000E43r 1  85 rr          sta Tmp0
000E45r 1               
000E45r 1  A9 00          lda #0
000E47r 1  85 rr          sta Tmp1
000E49r 1               
000E49r 1  A5 rr          lda Tmp0
000E4Br 1  29 04          and #%00000100                  ; VIA1 bit 2
000E4Dr 1  F0 06          beq @NoUp
000E4Fr 1  A5 rr          lda Tmp1
000E51r 1  09 01          ora #INPUT_UP
000E53r 1  85 rr          sta Tmp1
000E55r 1               @NoUp:
000E55r 1  A5 rr          lda Tmp0
000E57r 1  29 08          and #%00001000                  ; VIA1 bit 3
000E59r 1  F0 06          beq @NoDown
000E5Br 1  A5 rr          lda Tmp1
000E5Dr 1  09 02          ora #INPUT_DOWN
000E5Fr 1  85 rr          sta Tmp1
000E61r 1               @NoDown:
000E61r 1  A5 rr          lda Tmp0
000E63r 1  29 10          and #%00010000                  ; VIA1 bit 4
000E65r 1  F0 06          beq @NoLeft
000E67r 1  A5 rr          lda Tmp1
000E69r 1  09 04          ora #INPUT_LEFT
000E6Br 1  85 rr          sta Tmp1
000E6Dr 1               @NoLeft:
000E6Dr 1  A5 rr          lda Tmp0
000E6Fr 1  29 80          and #%10000000                  ; VIA2 PB7, folded in above
000E71r 1  F0 06          beq @NoRight
000E73r 1  A5 rr          lda Tmp1
000E75r 1  09 08          ora #INPUT_RIGHT
000E77r 1  85 rr          sta Tmp1
000E79r 1               @NoRight:
000E79r 1  A5 rr          lda Tmp0
000E7Br 1  29 20          and #%00100000                  ; VIA1 bit 5
000E7Dr 1  F0 06          beq @NoFire
000E7Fr 1  A5 rr          lda Tmp1
000E81r 1  09 10          ora #INPUT_FIRE
000E83r 1  85 rr          sta Tmp1
000E85r 1               @NoFire:
000E85r 1               
000E85r 1  20 rr rr       jsr ScanKeys
000E88r 1  05 rr          ora Tmp1
000E8Ar 1  60             rts
000E8Br 1               
000E8Br 1               ; -----------------------------------------------------------------------------
000E8Br 1               ;   ScanKeys — the keyboard matrix, as the same active-high mask
000E8Br 1               ;   Out: A = INPUT_* bits.  Modifies: A, X, Tmp2
000E8Br 1               ;
000E8Br 1               ;   VIA2 $9120 drives the rows (one bit LOW selects one row) and $9121 reads
000E8Br 1               ;   the columns, active low. Every key the game uses is in KeyTable below;
000E8Br 1               ;   the two cursor keys come after it because SHIFT turns them around, and
000E8Br 1               ;   knowing whether SHIFT is down means having scanned the table first.
000E8Br 1               ; -----------------------------------------------------------------------------
000E8Br 1               KEY_SHIFT           = %01000000 ; Scratch inside this file only — INPUT_MASK
000E8Br 1                                               ;   strips it before the mask leaves here
000E8Br 1               
000E8Br 1               ScanKeys:
000E8Br 1  A9 00          lda #0
000E8Dr 1  85 rr          sta Tmp2
000E8Fr 1  A2 00          ldx #0
000E91r 1               @Key:
000E91r 1  BD rr rr       lda KeyTable,x
000E94r 1  F0 19          beq @Cursors                  ; $00 drives every row at once — the
000E96r 1  8D 20 91       sta $9120                     ;   terminator, because it is not a row mask
000E99r 1  AD 21 91       lda $9121
000E9Cr 1  49 FF          eor #$FF                      ; Active low in, active high out
000E9Er 1  3D rr rr       and KeyTable+1,x
000EA1r 1  F0 07          beq @Next
000EA3r 1  A5 rr          lda Tmp2
000EA5r 1  1D rr rr       ora KeyTable+2,x
000EA8r 1  85 rr          sta Tmp2
000EAAr 1               @Next:
000EAAr 1  E8             inx
000EABr 1  E8             inx
000EACr 1  E8             inx
000EADr 1  D0 E2          bne @Key                      ; Always — the table is far shorter than 256
000EAFr 1               
000EAFr 1                 ; --- the two cursor keys, which SHIFT turns around (SPEC 11.2) ------------
000EAFr 1                 ;   Unshifted they are RIGHT and DOWN, shifted LEFT and UP, which is exactly
000EAFr 1                 ;   the four the game wants and the reason for reading the matrix rather
000EAFr 1                 ;   than letting the KERNAL translate a keystroke into one character.
000EAFr 1               @Cursors:
000EAFr 1  A9 FB          lda #%11111011                ; Row 2 — CRSR RIGHT shares it with A and D
000EB1r 1  8D 20 91       sta $9120
000EB4r 1  AD 21 91       lda $9121
000EB7r 1  29 80          and #%10000000                ; Column 7
000EB9r 1  D0 0F          bne @NoLeftRight              ; Still high, so not pressed
000EBBr 1  A2 08          ldx #INPUT_RIGHT
000EBDr 1  A5 rr          lda Tmp2
000EBFr 1  29 40          and #KEY_SHIFT
000EC1r 1  F0 02          beq @LeftRight
000EC3r 1  A2 04          ldx #INPUT_LEFT
000EC5r 1               @LeftRight:
000EC5r 1  8A             txa
000EC6r 1  05 rr          ora Tmp2
000EC8r 1  85 rr          sta Tmp2
000ECAr 1               @NoLeftRight:
000ECAr 1               
000ECAr 1  A9 F7          lda #%11110111                ; Row 3 — CRSR DOWN, next to LSHIFT
000ECCr 1  8D 20 91       sta $9120
000ECFr 1  AD 21 91       lda $9121
000ED2r 1  29 80          and #%10000000
000ED4r 1  D0 0F          bne @NoUpDown
000ED6r 1  A2 02          ldx #INPUT_DOWN
000ED8r 1  A5 rr          lda Tmp2
000EDAr 1  29 40          and #KEY_SHIFT
000EDCr 1  F0 02          beq @UpDown
000EDEr 1  A2 01          ldx #INPUT_UP
000EE0r 1               @UpDown:
000EE0r 1  8A             txa
000EE1r 1  05 rr          ora Tmp2
000EE3r 1  85 rr          sta Tmp2
000EE5r 1               @NoUpDown:
000EE5r 1               
000EE5r 1  A5 rr          lda Tmp2
000EE7r 1  29 3F          and #INPUT_MASK               ; Drop KEY_SHIFT — it is not an input
000EE9r 1  60             rts
000EEAr 1               
000EEAr 1               ; -----------------------------------------------------------------------------
000EEAr 1               ;   KeyTable — row mask, column mask, input bit.  Terminated by $00.
000EEAr 1               ;   Rows 1-6 only; see HalReadInput above for why that matters.
000EEAr 1               ; -----------------------------------------------------------------------------
000EEAr 1               KeyTable:
000EEAr 1  FD 02 01       .byte %11111101, %00000010, INPUT_UP      ; W        row 1, col 1
000EEDr 1  FB 02 04       .byte %11111011, %00000010, INPUT_LEFT    ; A        row 2, col 1
000EF0r 1  DF 02 02       .byte %11011111, %00000010, INPUT_DOWN    ; S        row 5, col 1
000EF3r 1  FB 04 08       .byte %11111011, %00000100, INPUT_RIGHT   ; D        row 2, col 2
000EF6r 1  BF 01 10       .byte %10111111, %00000001, INPUT_FIRE    ; Q        row 6, col 0
000EF9r 1  FD 20 20       .byte %11111101, %00100000, INPUT_PAUSE   ; P        row 1, col 5
000EFCr 1  EF 01 01       .byte %11101111, %00000001, INPUT_UP      ; SPACE    row 4, col 0
000EFFr 1  FD 80 10       .byte %11111101, %10000000, INPUT_FIRE    ; RETURN   row 1, col 7
000F02r 1  F7 02 40       .byte %11110111, %00000010, KEY_SHIFT     ; LSHIFT   row 3, col 1
000F05r 1  EF 40 40       .byte %11101111, %01000000, KEY_SHIFT     ; RSHIFT   row 4, col 6
000F08r 1  00             .byte $00
000F09r 1               
000F09r 1               ; -----------------------------------------------------------------------------
000F09r 1               ;   HalDetectRegion — NTSC has 261 raster lines, PAL 312
000F09r 1               ;   $9004 carries the line number halved, so the highest value it reaches is
000F09r 1               ;   about $82 on NTSC and $9C on PAL. Sample it and take the maximum.
000F09r 1               ; -----------------------------------------------------------------------------
000F09r 1               HalDetectRegion:
000F09r 1  A9 00          lda #0
000F0Br 1  85 rr          sta Tmp0                      ; Highest line seen
000F0Dr 1  A2 00          ldx #0
000F0Fr 1  A0 00          ldy #0
000F11r 1               @Sample:
000F11r 1  AD 04 90       lda VIC_CR4
000F14r 1  C5 rr          cmp Tmp0
000F16r 1  90 02          bcc @Next
000F18r 1  85 rr          sta Tmp0
000F1Ar 1               @Next:
000F1Ar 1  C8             iny
000F1Br 1  D0 F4          bne @Sample
000F1Dr 1  E8             inx
000F1Er 1  E0 40          cpx #64                       ; 16384 samples — comfortably over one frame
000F20r 1  D0 EF          bne @Sample
000F22r 1               
000F22r 1  A5 rr          lda Tmp0
000F24r 1  C9 90          cmp #$90
000F26r 1  90 03          bcc @Ntsc
000F28r 1  A9 01          lda #1                        ; PAL
000F2Ar 1  60             rts
000F2Br 1               @Ntsc:
000F2Br 1  A9 00          lda #0
000F2Dr 1  60             rts
000F2Er 1               
000F2Er 1               ; -----------------------------------------------------------------------------
000F2Er 1               ;   HalSfx — TODO: VIC-I sound, $900A-$900E. Its own driver; no SID here.
000F2Er 1               ; -----------------------------------------------------------------------------
000F2Er 1               HalSfx:
000F2Er 1  60             rts
000F2Fr 1               
000F2Fr 1               ; =============================================================================
000F2Fr 1               ;   Data
000F2Fr 1               ; =============================================================================
000F2Fr 1               
000F2Fr 1               .segment "RODATA"
000000r 1               
000000r 1               .include "../data/tilecolor-vic20.inc"
000000r 2               ; =============================================================================
000000r 2               ;   tilecolor-vic20.inc — VIC-20 tile -> colour RAM table
000000r 2               ; =============================================================================
000000r 2               ;   Generated from SPEC.md section 4.3 and Appendix A. Spec-derived data, not
000000r 2               ;   artwork: edit this file by hand, it is never overwritten by an editor
000000r 2               ;   export. Tile groups 16-31 (tiles 128-255) are the margin artwork and their
000000r 2               ;   colours are the artist's to choose.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               
000000r 2               ;   256 bytes, indexed by tile number. Render is:
000000r 2               ;       SCREEN,x = tile   /   COLRAM,x = TileColor,tile
000000r 2               ;   VIC-20 hi-res text mode: colours 0-7 only (bit 3 selects
000000r 2               ;   multicolor and must stay clear).
000000r 2               
000000r 2               TileColorVIC:
000000r 2  01 01 01 01    .res 8, $01                      ; tiles   0-7    group 0  UI / well frame        white
000004r 2  01 01 01 01  
000008r 2  01 01 01 01    .res 8, $01                      ; tiles   8-15   group 1  UI accents             gray
00000Cr 2  01 01 01 01  
000010r 2  01 01 01 01    .res 8, $01                      ; tiles  16-23   group 2  Font  0 1 2 3 4 5 6 7  white
000014r 2  01 01 01 01  
000018r 2  01 01 01 01    .res 8, $01                      ; tiles  24-31   group 3  Font  8 9 A B C D E F  white
00001Cr 2  01 01 01 01  
000020r 2  01 01 01 01    .res 8, $01                      ; tiles  32-39   group 4  Font  G H I J K L M N  white
000024r 2  01 01 01 01  
000028r 2  01 01 01 01    .res 8, $01                      ; tiles  40-47   group 5  Font  O P Q R S T U V  white
00002Cr 2  01 01 01 01  
000030r 2  01 01 01 01    .res 8, $01                      ; tiles  48-55   group 6  Font  W X Y Z . x ! -  white
000034r 2  01 01 01 01  
000038r 2  01 01 01 01    .res 8, $01                      ; tiles  56-63   group 7  VFX                    white
00003Cr 2  01 01 01 01  
000040r 2  02 02 02 02    .res 8, $02                      ; tiles  64-71   group 8  POTION 0  RED
000044r 2  02 02 02 02  
000048r 2  07 07 07 07    .res 8, $07                      ; tiles  72-79   group 9  POTION 1  YELLOW
00004Cr 2  07 07 07 07  
000050r 2  05 05 05 05    .res 8, $05                      ; tiles  80-87   group 10 POTION 2  GREEN
000054r 2  05 05 05 05  
000058r 2  03 03 03 03    .res 8, $03                      ; tiles  88-95   group 11 POTION 3  CYAN
00005Cr 2  03 03 03 03  
000060r 2  06 06 06 06    .res 8, $06                      ; tiles  96-103  group 12 POTION 4  BLUE
000064r 2  06 06 06 06  
000068r 2  04 04 04 04    .res 8, $04                      ; tiles 104-111  group 13 POTION 5  PURPLE
00006Cr 2  04 04 04 04  
000070r 2  01 01 01 01    .res 8, $01                      ; tiles 112-119  group 14 POTION 6  WILD / prism white
000074r 2  01 01 01 01  
000078r 2  02 02 02 02    .res 8, $02                      ; tiles 120-127  group 15 Wall / stone           red
00007Cr 2  02 02 02 02  
000080r 2  01 01 01 01    .res 8, $01                      ; tiles 128-135  group 16 artwork
000084r 2  01 01 01 01  
000088r 2  02 02 02 02    .res 8, $02                      ; tiles 136-143  group 17 artwork
00008Cr 2  02 02 02 02  
000090r 2  05 05 05 05    .res 8, $05                      ; tiles 144-151  group 18 artwork
000094r 2  05 05 05 05  
000098r 2  07 07 07 07    .res 8, $07                      ; tiles 152-159  group 19 artwork
00009Cr 2  07 07 07 07  
0000A0r 2  06 06 06 06    .res 8, $06                      ; tiles 160-167  group 20 artwork
0000A4r 2  06 06 06 06  
0000A8r 2  05 05 05 05    .res 8, $05                      ; tiles 168-175  group 21 artwork
0000ACr 2  05 05 05 05  
0000B0r 2  02 02 02 02    .res 8, $02                      ; tiles 176-183  group 22 artwork
0000B4r 2  02 02 02 02  
0000B8r 2  03 03 03 03    .res 8, $03                      ; tiles 184-191  group 23 artwork
0000BCr 2  03 03 03 03  
0000C0r 2  07 07 07 07    .res 8, $07                      ; tiles 192-199  group 24 artwork
0000C4r 2  07 07 07 07  
0000C8r 2  06 06 06 06    .res 8, $06                      ; tiles 200-207  group 25 artwork
0000CCr 2  06 06 06 06  
0000D0r 2  04 04 04 04    .res 8, $04                      ; tiles 208-215  group 26 artwork
0000D4r 2  04 04 04 04  
0000D8r 2  05 05 05 05    .res 8, $05                      ; tiles 216-223  group 27 artwork
0000DCr 2  05 05 05 05  
0000E0r 2  02 02 02 02    .res 8, $02                      ; tiles 224-231  group 28 artwork
0000E4r 2  02 02 02 02  
0000E8r 2  01 01 01 01    .res 8, $01                      ; tiles 232-239  group 29 artwork
0000ECr 2  01 01 01 01  
0000F0r 2  01 01 01 01    .res 8, $01                      ; tiles 240-247  group 30 artwork
0000F4r 2  01 01 01 01  
0000F8r 2  01 01 01 01    .res 8, $01                      ; tiles 248-255  group 31 artwork
0000FCr 2  01 01 01 01  
000100r 2               
000100r 1               .include "../src/tables.inc"
000100r 2               ; =============================================================================
000100r 2               ;   tables.inc — Wizards Lab, spec-derived lookup tables
000100r 2               ; =============================================================================
000100r 2               ;   Straight out of SPEC.md sections 5.3, 9 and 10. Hand-authored, never
000100r 2               ;   overwritten by an editor export. Included once, from the RODATA segment.
000100r 2               ;
000100r 2               ;   Score values above 99 do not fit in a byte, so every scoring table is a
000100r 2               ;   pair of parallel arrays — low BCD byte and high BCD byte — indexed by the
000100r 2               ;   same value.
000100r 2               ; =============================================================================
000100r 2               
000100r 2               ; --- Gravity, frames per row (SPEC 10.2) -------------------------------------
000100r 2               ;   Indexed by (level - 1), clamped to LEVEL_SPEED_CAP - 1.
000100r 2               ;   PAL is round(NTSC * 50/60), so wall-clock speed matches across regions.
000100r 2               
000100r 2               SpeedNTSC:
