000000r 1               ; =============================================================================
000000r 1               ;   Wizards Lab — VIC-20
000000r 1               ; =============================================================================
000000r 1               ;   A 16 K cartridge for an unexpanded VIC-20: BLK5 ($A000) carries the
000000r 1               ;   autostart header and the code, BLK3 ($6000) carries the tileset and screen
000000r 1               ;   images.
000000r 1               ;
000000r 1               ;   This machine sets the shape of the whole game. Its 22 x 23 screen is
000000r 1               ;   exactly the panel every platform draws, and its eight hi-res foreground
000000r 1               ;   colours are what cap the potion palette at six plus white. Designing
000000r 1               ;   against it first is what lets one layout serve all three.
000000r 1               ;
000000r 1               ;   The VIC chip cannot see cartridge ROM, so the character set is copied out
000000r 1               ;   of BLK3 into RAM at $1400 during boot.
000000r 1               ;
000000r 1               ;   Built with VIC20-16K.cfg.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               .include "../include/vic20.inc"
000000r 2               ; VIC-20 Include File for ca65
000000r 2               ; Memory addresses, KERNAL routines, and hardware registers
000000r 2               ; Compatible with both NTSC and PAL VIC-20 systems
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Zero Page Locations
000000r 2               ;=============================================================================
000000r 2               VARTAB          = $2D           ; Pointer to start of BASIC variables
000000r 2               ARYTAB          = $2F           ; Pointer to start of BASIC arrays
000000r 2               STREND          = $31           ; Pointer to end of BASIC arrays
000000r 2               FRETOP          = $33           ; Pointer to bottom of string space
000000r 2               MEMSIZ          = $37           ; Pointer to top of BASIC memory
000000r 2               TIME            = $A0           ; Jiffy clock (3 bytes)
000000r 2               TIMER           = $A0           ; Same as TIME
000000r 2               STATUS          = $90           ; I/O status byte
000000r 2               STKEY           = $91           ; STOP key flag
000000r 2               MSGFLG          = $9D           ; Kernal message control flag
000000r 2               FNLEN           = $B7           ; Length of filename
000000r 2               LA              = $B8           ; Logical file number
000000r 2               SA              = $B9           ; Secondary address
000000r 2               FA              = $BA           ; Device number
000000r 2               FNADR           = $BB           ; Pointer to filename (2 bytes)
000000r 2               STAL            = $C1           ; Pointer for tape I/O (2 bytes)
000000r 2               EAL             = $C3           ; Pointer for tape I/O (2 bytes)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Screen and Color Memory (Unexpanded VIC-20)
000000r 2               ;=============================================================================
000000r 2               SCREEN          = $1E00         ; Screen memory start (22x23 default)
000000r 2               COLRAM          = $9600         ; Color RAM start
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; User BASIC Memory
000000r 2               ;=============================================================================
000000r 2               BASIC_START     = $1001         ; Start of BASIC program area
000000r 2               BASIC_END       = $1E00         ; End of BASIC (screen memory starts)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; VIC Chip Registers (6560/6561 Video Interface Chip)
000000r 2               ;=============================================================================
000000r 2               VIC             = $9000         ; Base address of VIC chip
000000r 2               
000000r 2               ; Individual VIC registers
000000r 2               VIC_CR0         = $9000         ; Horizontal centering (bit 7 = interlace)
000000r 2               VIC_CR1         = $9001         ; Vertical centering
000000r 2               VIC_CR2         = $9002         ; Video matrix columns (bits 0-6, bit 7=raster)
000000r 2               VIC_CR3         = $9003         ; Raster value (bits 1-7 = rows*2, bit 0=character size)
000000r 2               VIC_CR4         = $9004         ; TV raster beam location (read only)
000000r 2               VIC_CR5         = $9005         ; Video matrix start address (bits 4-7)
000000r 2               VIC_CRA         = $900A         ; Bass frequency
000000r 2               VIC_CRB         = $900B         ; Alto frequency
000000r 2               VIC_CRC         = $900C         ; Soprano frequency
000000r 2               VIC_CRD         = $900D         ; Noise frequency
000000r 2               VIC_CRE         = $900E         ; Auxiliary color / Volume
000000r 2               VIC_CRF         = $900F         ; Screen & border colors / reverse mode
000000r 2               
000000r 2               ; VIC register aliases
000000r 2               VIC_HORZ        = VIC_CR0       ; Horizontal position
000000r 2               VIC_VERT        = VIC_CR1       ; Vertical position
000000r 2               VIC_COLUMNS     = VIC_CR2       ; Number of columns
000000r 2               VIC_ROWS        = VIC_CR3       ; Number of rows
000000r 2               VIC_RASTER      = VIC_CR4       ; Raster position
000000r 2               VIC_ORIGIN      = VIC_CR5       ; Screen memory location
000000r 2               VIC_BASS        = VIC_CRA       ; Sound: Bass voice
000000r 2               VIC_ALTO        = VIC_CRB       ; Sound: Alto voice
000000r 2               VIC_SOPRANO     = VIC_CRC       ; Sound: Soprano voice
000000r 2               VIC_NOISE       = VIC_CRD       ; Sound: Noise voice
000000r 2               VIC_VOLUME      = VIC_CRE       ; Volume control (bits 0-3)
000000r 2               VIC_AUX_COLOR   = VIC_CRE       ; Auxiliary color (bits 4-7)
000000r 2               VIC_BACKGROUND  = VIC_CRF       ; Background color (bits 4-7)
000000r 2               VIC_BORDER      = VIC_CRF       ; Border color (bits 0-2)
000000r 2               VIC_REVERSE     = VIC_CRF       ; Reverse mode (bit 3)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; VIA Chip #1 Registers (6522 VIA - Keyboard, Joystick)
000000r 2               ;=============================================================================
000000r 2               VIA1            = $9110         ; Base address of VIA1
000000r 2               VIA1_PB         = $9110         ; Port B (keyboard row select, joystick)
000000r 2               VIA1_PA1        = $9111         ; Port A (keyboard column read)
000000r 2               VIA1_DDRB       = $9112         ; Data direction register B
000000r 2               VIA1_DDRA       = $9113         ; Data direction register A
000000r 2               VIA1_T1CL       = $9114         ; Timer 1 counter low
000000r 2               VIA1_T1CH       = $9115         ; Timer 1 counter high
000000r 2               VIA1_T1LL       = $9116         ; Timer 1 latch low
000000r 2               VIA1_T1LH       = $9117         ; Timer 1 latch high
000000r 2               VIA1_T2CL       = $9118         ; Timer 2 counter low
000000r 2               VIA1_T2CH       = $9119         ; Timer 2 counter high
000000r 2               VIA1_SR         = $911A         ; Shift register
000000r 2               VIA1_ACR        = $911B         ; Auxiliary control register
000000r 2               VIA1_PCR        = $911C         ; Peripheral control register
000000r 2               VIA1_IFR        = $911D         ; Interrupt flag register
000000r 2               VIA1_IER        = $911E         ; Interrupt enable register
000000r 2               VIA1_PA2        = $911F         ; Port A (no handshake)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; VIA Chip #2 Registers (6522 VIA - Serial, Tape, Joystick)
000000r 2               ;=============================================================================
000000r 2               VIA2            = $9120         ; Base address of VIA2
000000r 2               VIA2_PB         = $9120         ; Port B (serial bus, tape control, joystick)
000000r 2               VIA2_PA1        = $9121         ; Port A (serial bus)
000000r 2               VIA2_DDRB       = $9122         ; Data direction register B
000000r 2               VIA2_DDRA       = $9123         ; Data direction register A
000000r 2               VIA2_T1CL       = $9124         ; Timer 1 counter low
000000r 2               VIA2_T1CH       = $9125         ; Timer 1 counter high
000000r 2               VIA2_T1LL       = $9126         ; Timer 1 latch low
000000r 2               VIA2_T1LH       = $9127         ; Timer 1 latch high
000000r 2               VIA2_T2CL       = $9128         ; Timer 2 counter low
000000r 2               VIA2_T2CH       = $9129         ; Timer 2 counter high
000000r 2               VIA2_SR         = $912A         ; Shift register
000000r 2               VIA2_ACR        = $912B         ; Auxiliary control register
000000r 2               VIA2_PCR        = $912C         ; Peripheral control register
000000r 2               VIA2_IFR        = $912D         ; Interrupt flag register
000000r 2               VIA2_IER        = $912E         ; Interrupt enable register
000000r 2               VIA2_PA2        = $912F         ; Port A (no handshake)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Joystick (VIA1 Port A = $9111, VIA2 Port B = $9120)
000000r 2               ; Active-low: bit is 0 when the switch is closed (direction/fire pressed)
000000r 2               ;=============================================================================
000000r 2               JOY_UP          = %00000100     ; VIA1_PA1 bit 2
000000r 2               JOY_DOWN        = %00001000     ; VIA1_PA1 bit 3
000000r 2               JOY_LEFT        = %00010000     ; VIA1_PA1 bit 4
000000r 2               JOY_FIRE        = %00100000     ; VIA1_PA1 bit 5
000000r 2               JOY_RIGHT       = %10000000     ; VIA2_PB bit 7
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Color Codes
000000r 2               ;=============================================================================
000000r 2               BLACK           = $00
000000r 2               WHITE           = $01
000000r 2               RED             = $02
000000r 2               CYAN            = $03
000000r 2               PURPLE          = $04
000000r 2               GREEN           = $05
000000r 2               BLUE            = $06
000000r 2               YELLOW          = $07
000000r 2               ORANGE          = $08
000000r 2               LIGHT_ORANGE    = $09
000000r 2               PINK            = $0A
000000r 2               LIGHT_CYAN      = $0B
000000r 2               LIGHT_PURPLE    = $0C
000000r 2               LIGHT_GREEN     = $0D
000000r 2               LIGHT_BLUE      = $0E
000000r 2               LIGHT_YELLOW    = $0F
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Character Codes (PETSCII)
000000r 2               ;=============================================================================
000000r 2               CHR_RETURN      = $0D
000000r 2               CHR_SPACE       = $20
000000r 2               CHR_DELETE      = $14
000000r 2               CHR_INSERT      = $94
000000r 2               CHR_HOME        = $13
000000r 2               CHR_CLEAR       = $93
000000r 2               CHR_RVSON       = $12           ; Reverse on
000000r 2               CHR_RVSOFF      = $92           ; Reverse off
000000r 2               CHR_DOWN        = $11
000000r 2               CHR_UP          = $91
000000r 2               CHR_RIGHT       = $1D
000000r 2               CHR_LEFT        = $9D
000000r 2               CHR_BLACK       = $90
000000r 2               CHR_WHITE       = $05
000000r 2               CHR_RED         = $1C
000000r 2               CHR_CYAN        = $9F
000000r 2               CHR_PURPLE      = $9C
000000r 2               CHR_GREEN       = $1E
000000r 2               CHR_BLUE        = $9E
000000r 2               CHR_YELLOW      = $9B
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; ROM Addresses
000000r 2               ;=============================================================================
000000r 2               CHARROM         = $8000         ; Character ROM
000000r 2               BASIC_ROM       = $C000         ; BASIC ROM start
000000r 2               KERNAL_ROM      = $E000         ; KERNAL ROM start
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; KERNAL Routines
000000r 2               ;=============================================================================
000000r 2               ; Internal KERNAL routines (address may vary by ROM version)
000000r 2               CINT            = $E518         ; Initialize screen editor
000000r 2               IOINIT          = $FDF9         ; Initialize I/O
000000r 2               RAMTAS          = $FD8D         ; Initialize RAM
000000r 2               RESTOR          = $FD52         ; Restore default I/O vectors
000000r 2               VECTOR          = $FD1A         ; Manage RAM vectors
000000r 2               
000000r 2               ; KERNAL Jump Table (standard across all VIC-20s)
000000r 2               SETMSG          = $FF90         ; Control KERNAL messages
000000r 2               SECOND          = $FF93         ; Send secondary address
000000r 2               TKSA            = $FF96         ; Send secondary address for talk
000000r 2               MEMTOP          = $FF99         ; Read/set top of memory
000000r 2               MEMBOT          = $FF9C         ; Read/set bottom of memory
000000r 2               SCNKEY          = $FF9F         ; Scan keyboard
000000r 2               SETTMO          = $FFA2         ; Set timeout for serial bus
000000r 2               ACPTR           = $FFA5         ; Input byte from serial bus
000000r 2               CIOUT           = $FFA8         ; Output byte to serial bus
000000r 2               UNTLK           = $FFAB         ; Send UNTALK to serial bus
000000r 2               UNLSN           = $FFAE         ; Send UNLISTEN to serial bus
000000r 2               LISTEN          = $FFB1         ; Send LISTEN to serial bus
000000r 2               TALK            = $FFB4         ; Send TALK to serial bus
000000r 2               READST          = $FFB7         ; Read I/O status word
000000r 2               SETLFS          = $FFBA         ; Set logical file parameters
000000r 2               SETNAM          = $FFBD         ; Set filename
000000r 2               OPEN            = $FFC0         ; Open a logical file
000000r 2               CLOSE           = $FFC3         ; Close a logical file
000000r 2               CHKIN           = $FFC6         ; Define file as default input
000000r 2               CHKOUT          = $FFC9         ; Define file as default output
000000r 2               CLRCHN          = $FFCC         ; Restore default I/O devices
000000r 2               CHRIN           = $FFCF         ; Input character from channel
000000r 2               CHROUT          = $FFD2         ; Output character to channel
000000r 2               LOAD            = $FFD5         ; Load RAM from device
000000r 2               SAVE            = $FFD8         ; Save RAM to device
000000r 2               SETTIM          = $FFDB         ; Set 24-hour clock
000000r 2               RDTIM           = $FFDE         ; Read 24-hour clock
000000r 2               STOP            = $FFE1         ; Check STOP key
000000r 2               GETIN           = $FFE4         ; Get character from keyboard
000000r 2               CLALL           = $FFE7         ; Close all channels and files
000000r 2               UDTIM           = $FFEA         ; Increment 24-hour clock
000000r 2               SCREEN_ORG      = $FFED         ; Return screen organization
000000r 2               PLOT            = $FFF0         ; Read/set cursor X/Y position
000000r 2               IOBASE          = $FFF3         ; Return I/O base address
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; IRQ/NMI Vectors
000000r 2               ;=============================================================================
000000r 2               IRQ_VECTOR      = $0314         ; IRQ vector (2 bytes)
000000r 2               BRK_VECTOR      = $0316         ; BRK vector (2 bytes)
000000r 2               NMI_VECTOR      = $0318         ; NMI vector (2 bytes)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Hardware Vectors (in ROM)
000000r 2               ;=============================================================================
000000r 2               HW_NMI          = $FFFA         ; NMI vector
000000r 2               HW_RESET        = $FFFC         ; Reset vector
000000r 2               HW_IRQ          = $FFFE         ; IRQ/BRK vector
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Useful Constants
000000r 2               ;=============================================================================
000000r 2               SCREEN_COLS     = 22            ; Default screen columns
000000r 2               SCREEN_ROWS     = 23            ; Default screen rows
000000r 2               JIFFY_PAL       = 50            ; Jiffies per second (PAL)
000000r 2               JIFFY_NTSC      = 60            ; Jiffies per second (NTSC)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Memory Expansion Configurations
000000r 2               ;=============================================================================
000000r 2               ; RAM Block 0 (BLK0) = $0400-$0FFF (3K)
000000r 2               ; RAM Block 1 (BLK1) = $2000-$3FFF (8K)
000000r 2               ; RAM Block 2 (BLK2) = $4000-$5FFF (8K)
000000r 2               ; RAM Block 3 (BLK3) = $6000-$7FFF (8K)
000000r 2               ; RAM Block 5 (BLK5) = $A000-$BFFF (8K)
000000r 2               
000000r 2               BLK0            = $0400         ; 3K expansion
000000r 2               BLK1            = $2000         ; 8K expansion
000000r 2               BLK2            = $4000         ; 8K expansion
000000r 2               BLK3            = $6000         ; 8K expansion
000000r 2               BLK5            = $A000         ; 8K expansion
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; End of VIC20.inc
000000r 2               ;=============================================================================
000000r 2               
000000r 1               
000000r 1               ; --- Platform constants (hal.inc) --------------------------------------------
000000r 1               SCR_COLS         = 22
000000r 1               SCR_ROWS         = 23
000000r 1               SCR_CELLS        = 506           ; 22 x 23
000000r 1               PANEL_X             = 0             ; The screen IS the panel
000000r 1               PANEL_Y             = 0
000000r 1               HAS_COLOR_RAM       = 1
000000r 1               COLOR_WHITE         = 1             ; The fireball flash (SPEC 4.6)
000000r 1               
000000r 1               CHARSET_RAM         = $1400         ; 2 K, $1400-$1BFF
000000r 1               
000000r 1               .include "../src/constants.inc"
000000r 2               ; =============================================================================
000000r 2               ;   constants.inc — Wizards Lab, shared game constants
000000r 2               ; =============================================================================
000000r 2               ;   Everything here comes straight out of SPEC.md. If a number changes there,
000000r 2               ;   it changes here, and nowhere else. Nothing in this file is platform
000000r 2               ;   specific — see the per-platform WizardsLab.asm for PANEL_X / PANEL_Y and
000000r 2               ;   the hardware addresses.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Board (SPEC 3) ----------------------------------------------------------
000000r 2               BOARD_W             = 6         ; Playfield columns
000000r 2               BOARD_H             = 16        ; Playfield rows
000000r 2               BOARD_STRIDE        = 8         ; Bytes per row — two wasted, on purpose
000000r 2               BOARD_ROWS_ALLOC    = 20        ; 16 playfield + 2 floor sentinels + 2 reserved
000000r 2               BOARD_BYTES         = BOARD_ROWS_ALLOC * BOARD_STRIDE    ; 160
000000r 2               SPAWN_COL           = 2         ; 0-indexed, left of centre
000000r 2               MATCH_MIN           = 3         ; Run length that clears
000000r 2               
000000r 2               ; --- Tile encoding (SPEC 4) --------------------------------------------------
000000r 2               ;   tile = COLOR_BASE + (color << 3) + glyph
000000r 2               ;   The board byte IS the tile index. No translation on the way to the screen.
000000r 2               TILE_EMPTY          = $00
000000r 2               TILE_WALL           = $FF
000000r 2               COLOR_BASE          = $40
000000r 2               COLOR_MASK          = $F8       ; AND this and you have the colour key
000000r 2               GLYPH_MASK          = $07
000000r 2               WILD_BASE           = $70       ; Colour 6 — the prism
000000r 2               NUM_COLORS          = 6
000000r 2               
000000r 2               COLOR_RED           = 0
000000r 2               COLOR_YELLOW        = 1
000000r 2               COLOR_GREEN         = 2
000000r 2               COLOR_CYAN          = 3
000000r 2               COLOR_BLUE          = 4
000000r 2               COLOR_PURPLE        = 5
000000r 2               COLOR_WILD          = 6
000000r 2               
000000r 2               GLYPH_POTION        = 0
000000r 2               GLYPH_FIREBALL      = 1
000000r 2               GLYPH_BOLT          = 2
000000r 2               GLYPH_BOMB          = 3
000000r 2               GLYPH_STAR          = 4
000000r 2               GLYPH_GLOW          = 6         ; Match-flash frame. Potion colours only —
000000r 2                                               ;   WILD_BASE + GLYPH_GLOW is an arrow, not a
000000r 2                                               ;   glow, so the prism never takes this path.
000000r 2                                               ;   See PRISM_BLIP below and SPEC 4.4.
000000r 2               
000000r 2               ; --- Named tiles -------------------------------------------------------------
000000r 2               TILE_BLANK          = 0
000000r 2               TILE_BAR_H          = 1
000000r 2               TILE_BAR_V          = 2
000000r 2               TILE_COR_TL         = 3
000000r 2               TILE_COR_TR         = 4
000000r 2               TILE_COR_BL         = 5
000000r 2               TILE_COR_BR         = 6
000000r 2               TILE_WASH           = 7         ; PAUSE / dim wash, white
000000r 2               FONT_BASE           = 16        ; '0'..'9' then 'A'..'Z' then . x ! ~
000000r 2               FONT_DIGIT_0        = 16
000000r 2               FONT_LETTER_A       = 26
000000r 2               FONT_DOT            = 52        ; A CENTRED dot, not a baseline period — it is
000000r 2                                               ;   also frame 0 of the removal ring below
000000r 2               FONT_TIMES          = 53
000000r 2               FONT_BANG           = 54
000000r 2               FONT_TILDE          = 55        ; The banner ornament, ~~~LIKE THIS~~~
000000r 2               TEXT_END            = $FF       ; String terminator. Shares its value with
000000r 2                                               ;   TILE_WALL, which costs nothing: no string
000000r 2                                               ;   ever contains tile 255.
000000r 2               
000000r 2               ; The removal ring (SPEC 14). One animation, used for every removal there is:
000000r 2               ; the match shatter, the bomb blast, the star. It opens outward
000000r 2               ;
000000r 2               ;       FONT_DOT -> VFX_REMOVE1 -> VFX_REMOVE2 -> VFX_REMOVE3 -> empty
000000r 2               ;
000000r 2               ; and the prism's blip-out runs the same tiles closed inward (PRISM_BLIP).
000000r 2               VFX_REMOVE1         = 56
000000r 2               VFX_REMOVE2         = 57
000000r 2               VFX_REMOVE3         = 58
000000r 2               VFX_BEAM_H          = 59        ; The bolt's row
000000r 2               VFX_BEAM_V          = 60        ; The bolt's column
000000r 2               VFX_BEAM_CROSS      = 61        ; Drawn once, at the bolt's own cell
000000r 2               ARROW_UP            = 62        ; The title screen's controls (SPEC 13.1).
000000r 2               ARROW_DOWN          = 63        ;   Up and down live in group 7, left and
000000r 2               ARROW_LEFT          = 118       ;   right in group 14 — whichever white group
000000r 2               ARROW_RIGHT         = 119       ;   had a slot spare. Nothing indexes them.
000000r 2               
000000r 2               ; Group 14 is the prism's. Slots +0..+3 are its idle rotation and +4..+5 its
000000r 2               ; blip-out; there is no glow slot (SPEC A.3).
000000r 2               PRISM_SPIN          = WILD_BASE ; Four frames, WILD_BASE + 0..3
000000r 2               PRISM_SPIN_FRAMES   = 4
000000r 2               PRISM_BLIP          = WILD_BASE + 4     ; Two frames, then VFX_REMOVE2,
000000r 2                                                       ;   VFX_REMOVE1, FONT_DOT, empty
000000r 2               
000000r 2               ; Group 15 is the stone group: the petrified glyph set at the same offsets the
000000r 2               ; potions use, so a cell petrifies into its own shape —
000000r 2               ;
000000r 2               ;       petrified = PETRIFY_BASE + (tile & GLYPH_MASK)     for glyphs 0-4
000000r 2               ;
000000r 2               ; — and then the two tiles the margins are built from.
000000r 2               PETRIFY_BASE        = 120       ; +0 potion, +1 fireball, +2 bolt,
000000r 2                                               ;   +3 bomb, +4 star
000000r 2               TILE_RESERVED       = 125       ; Held for a sixth glyph, if one is ever added
000000r 2               TILE_SHELF          = 126       ; The shelf the panel stands on
000000r 2               TILE_BRICK          = 127       ; Brick — the margin fill
000000r 2               FRAME_DIM           = 8         ; Group 1 is group 0 byte for byte, one colour
000000r 2                                               ;   quieter, so frame_tile + FRAME_DIM is any
000000r 2                                               ;   frame piece's dim twin (SPEC A.3)
000000r 2               ART_BASE            = 128       ; Groups 16-31 — one hatch in sixteen colours,
000000r 2                                               ;   the title screen's magic field (SPEC 13.1)
000000r 2               ART_TILES           = 128
000000r 2               
000000r 2               ; --- Panel geometry (SPEC 12) ------------------------------------------------
000000r 2               ;   One 22 x 24 panel, rendered identically on all three machines. PANEL_Y is
000000r 2               ;   0 everywhere; only PANEL_X differs. The panel is vertically symmetric —
000000r 2               ;   backdrop row, band row, backdrop row, eighteen rows of frame, backdrop row,
000000r 2               ;   band row, backdrop row — which is why 24 is the height. The AC6502 is the
000000r 2               ;   exact fit; the VIC-20 clips panel row 23 off the bottom and the C64 has one
000000r 2               ;   spare screen row (24) below the panel. See SPEC 12.4.
000000r 2               PANEL_W             = 22
000000r 2               PANEL_H             = 24
000000r 2               
000000r 2               WELL_ORIGIN_X       = 1         ; Panel-relative: board (0,0) lives here
000000r 2               WELL_ORIGIN_Y       = 4
000000r 2               
000000r 2               SCORE_X             = 12        ; 7 digits, cols 12-18
000000r 2               SCORE_Y             = 5
000000r 2               HIGH_X              = 12        ; 7 digits, cols 12-18
000000r 2               HIGH_Y              = 10
000000r 2               HIGHLVL_X           = 15        ; Level the high score was set on, 2 digits;
000000r 2                                               ;   the 'L' at col 14 is in the static image
000000r 2               HIGHLVL_Y           = 11
000000r 2               LEVEL_X             = 18        ; Single column: tens above units
000000r 2               LEVEL_Y             = 17        ; Tens at LEVEL_Y, units at LEVEL_Y + 1
000000r 2               NEXT_X              = 11        ; Single tile column
000000r 2               NEXT_Y              = 16        ; Cells A, B, C at NEXT_Y, +1, +2
000000r 2               MSG_X               = 2         ; The band's OWNED cells. Panel columns 0-1 and
000000r 2               MSG_W               = 18        ;   20-21 of row 22 are shelf in the static
000000r 2               MSG_Y               = 22        ;   image and code never touches them; the
000000r 2                                               ;   banner still centres on the full PANEL_W,
000000r 2                                               ;   which lands in the same place for an
000000r 2                                               ;   even-length string (SPEC 12.2).
000000r 2               
000000r 2               MSG_CHAIN_LEN       = 14        ; `~~ CHAIN x0 ~~` (strings.inc)
000000r 2               MSG_CHAIN_DIGIT     = 10        ; Where the digit sits inside it
000000r 2               CHAIN_DIGIT_X       = (PANEL_W - MSG_CHAIN_LEN) / 2 + MSG_CHAIN_DIGIT
000000r 2                                               ; TextBanner centres on PANEL_W, so the one
000000r 2                                               ;   cell the chain banner overwrites afterwards
000000r 2                                               ;   is worked out here rather than counted off
000000r 2                                               ;   the screen
000000r 2               CHAIN_MAX_SHOWN     = 9         ; One digit. A chain past 9 says 9 rather than
000000r 2                                               ;   drawing a glyph that is not a numeral
000000r 2               
000000r 2               SCORE_DIGITS        = 7         ; Always all 7 drawn, zero padded
000000r 2               LEVEL_DIGITS        = 2         ; Always zero padded — level 5 draws "0" / "5"
000000r 2               
000000r 2               ; --- Piece and timing (SPEC 5.6, 11.3, 14) -----------------------------------
000000r 2               ;   Every duration in the game is a frame count, and most of them differ
000000r 2               ;   between NTSC and PAL so that wall-clock speed matches. Those live in
000000r 2               ;   tables.inc as two-entry tables indexed by Region, not here — a constant
000000r 2               ;   that is not one number is not a constant. The ones below are the same on
000000r 2               ;   both machines.
000000r 2               LOCK_RESET_MAX      = 4         ; Horizontal moves that may reset the lock
000000r 2                                               ;   delay, per piece. Rotation never resets it.
000000r 2               FALL_FRAMES         = 2         ; Frames a row while the pile falls into the
000000r 2                                               ;   holes a clear left (SPEC 14). The one
000000r 2                                               ;   duration in the game that is the same on
000000r 2                                               ;   both regions, because SPEC 14 says so: at
000000r 2                                               ;   two frames there is nothing to round.
000000r 2               
000000r 2               ; --- Animation (SPEC 14) -----------------------------------------------------
000000r 2               ;   A clear step animates in two windows, and everything SPEC 14 lists happens
000000r 2               ;   inside one of them. A window lasts as long as the LONGEST thing in it:
000000r 2               ;
000000r 2               ;     GLOW      the matched cells' glow glyph, the bolt's beams and the
000000r 2               ;               fireball's white flash. GlowFrames, or the longer FlashFrames
000000r 2               ;               when a fireball fired (tables.inc)
000000r 2               ;     SHATTER   the removal ring, and the prism's blip-out running alongside
000000r 2               ;               it. SHATTER_STEPS ring frames, or BLIP_STEPS when a marked
000000r 2               ;               prism is winking out with them
000000r 2               ;
000000r 2               ;   The two counts below are the SAME on both regions, for the reason
000000r 2               ;   FALL_FRAMES is: they are a tile count times VFX_FRAMES, and two frames a
000000r 2               ;   tile does not round to 1.67. SPEC 14 says so.
000000r 2               VFX_FRAMES          = 2         ; Frames each tile of a removal ring holds
000000r 2               SHATTER_STEPS       = 3         ; VFX_REMOVE1..3           — 6 frames
000000r 2               BLIP_STEPS          = 5         ; PRISM_BLIP, +1, VFX_REMOVE2, VFX_REMOVE1,
000000r 2                                               ;   FONT_DOT               — 10 frames
000000r 2               PRISM_SPIN_RATE     = 8         ; Frames per idle rotation frame (SPEC 14).
000000r 2                                               ;   The only tile on the board that moves when
000000r 2                                               ;   nothing is happening
000000r 2               PETRIFY_FRAMES      = 2         ; Frames per row of the game-over petrify
000000r 2                                               ;   (SPEC 13.4). Same number as FALL_FRAMES
000000r 2                                               ;   and not the same thing, so it is its own
000000r 2                                               ;   constant
000000r 2               TINT_NONE           = $01       ; TintColor when nothing is flashing white.
000000r 2                                               ;   Every real colour key has its low three
000000r 2                                               ;   bits clear, so $01 is a value no masked
000000r 2                                               ;   tile can equal — which is what lets the
000000r 2                                               ;   Commodores' HalPlotCell test the tint with
000000r 2                                               ;   one CMP and no separate "is anything
000000r 2                                               ;   flashing at all" branch (SPEC 4.6)
000000r 2               
000000r 2               ; --- The title screen (SPEC 13.1) --------------------------------------------
000000r 2               ;   Panel-relative, and every one of them is a measurement off the drawn
000000r 2               ;   screen rather than a choice: `make artwork` owns data/screen-title-*.bin
000000r 2               ;   and the numbers below have to agree with it. The magic field is the block
000000r 2               ;   of hatch tiles at rows 8-9 and the prompt is the ten cells that say
000000r 2               ;   PRESS FIRE, which is the one string code redraws over its own image.
000000r 2               FIELD_X             = 4         ; The magic field, 14 x 2 (SPEC 13.1)
000000r 2               FIELD_Y             = 8
000000r 2               FIELD_W             = 14
000000r 2               FIELD_CELLS         = FIELD_W * 2       ; 28, and one of them changes a frame
000000r 2               PROMPT_X            = 6         ; `PRESS FIRE`, blinked at SPEC 14's period
000000r 2               PROMPT_Y            = 11
000000r 2               PROMPT_LEN          = 10
000000r 2               
000000r 2               ; --- Game over (SPEC 13.4) ---------------------------------------------------
000000r 2               GAMEOVER_SECS       = 10        ; Seconds on the game-over screen before it
000000r 2                                               ;   returns to the title by itself. SECONDS,
000000r 2                                               ;   not frames: 600 does not fit in a byte and
000000r 2                                               ;   would not be the same wall clock on both
000000r 2                                               ;   regions if it did, so the timeout counts
000000r 2                                               ;   seconds and SecondFrames counts the frames
000000r 2                                               ;   of one (tables.inc)
000000r 2               
000000r 2               ; --- Levels (SPEC 10) --------------------------------------------------------
000000r 2               LEVEL_TILES         = 30        ; Tiles cleared per level
000000r 2               LEVEL_SPEED_CAP     = 16        ; Speed stops improving here
000000r 2               LEVEL_MAX_SHOWN     = 99
000000r 2               
000000r 2               ; --- Scoring (SPEC 9) --------------------------------------------------------
000000r 2               BONUS_FIREBALL      = $0500     ; BCD
000000r 2               BONUS_BOLT          = $0300
000000r 2               BONUS_BOMB          = $0300
000000r 2               BONUS_PRISM         = $0400
000000r 2               BONUS_LEVELUP       = $1000
000000r 2               STAR_SHIFT_CAP      = 3         ; Three doublings — x8
000000r 2               HIGH_FLASH_BLINKS   = 6         ; Half-blinks of the HIGH field when the score
000000r 2                                               ;   overtakes it (SPEC 9.8) — three dark, three
000000r 2                                               ;   lit, ending lit. At SPEC 14's 30-frame
000000r 2                                               ;   blink period that is about a second and a
000000r 2                                               ;   half, and play never stops for it.
000000r 2               SCORE_BYTES         = 4         ; 8 nibbles packed BCD; the top one stays 0,
000000r 2                                               ;   so 7 digits show and the score wraps at
000000r 2                                               ;   10,000,000.
000000r 2               HIGH_INIT_LO        = $00       ; 0010000
000000r 2               HIGH_INIT_MID       = $00
000000r 2               HIGH_INIT_HI        = $01
000000r 2               HIGH_INIT_TOP       = $00
000000r 2               
000000r 2               ; --- Audio (SPEC 16) ---------------------------------------------------------
000000r 2               ;   Twelve effects, one channel. The id IS the priority: SPEC 16 lists them
000000r 2               ;   from the quietest event to the loudest, so a request takes the channel only
000000r 2               ;   when its id is at least the id of whatever is already playing, and a
000000r 2               ;   fireball is never talked over by the blip of the move that set it off
000000r 2               ;   (audio.asm).
000000r 2               SFX_MOVE            = 1
000000r 2               SFX_ROTATE          = 2
000000r 2               SFX_LOCK            = 3
000000r 2               SFX_MATCH           = 4
000000r 2               SFX_FIREBALL        = 5
000000r 2               SFX_BOLT            = 6
000000r 2               SFX_BOMB            = 7
000000r 2               SFX_STAR            = 8
000000r 2               SFX_PRISM           = 9
000000r 2               SFX_LEVELUP         = 10
000000r 2               SFX_HIGHSCORE       = 11
000000r 2               SFX_GAMEOVER        = 12
000000r 2               SFX_COUNT           = 12
000000r 2               
000000r 2               ;   ...and three that are NOT events. The title screen's ambience is built out
000000r 2               ;   of the same step lists as everything else (tables.inc), so its sounds need
000000r 2               ;   ids to be indexed by, and the ids have to sit above the twelve because that
000000r 2               ;   is where the table has room. They are therefore the LOUDEST ids in the game,
000000r 2               ;   which would be exactly wrong if anything ever asked for one: nothing may.
000000r 2               ;   The ambience calls SfxBeginShifted directly, on a frame where the channel
000000r 2               ;   is already known to be silent, and never goes near SfxPlay (ambience.asm).
000000r 2               SFX_BUBBLE          = 13        ; A bloop rising out of the cauldron
000000r 2               SFX_GLOOP           = 14        ; ...a heavier one turning over, and falling
000000r 2               SFX_SEETHE          = 15        ; ...and the churn underneath both
000000r 2               SFX_CAULDRON        = 13        ; The first of the three. An id below this one
000000r 2                                               ;   that the ambience plays was borrowed from
000000r 2                                               ;   the game and earns the longer gap after it
000000r 2                                               ;   (AMB_GAP_EVENT); one at or above it is the
000000r 2                                               ;   cauldron and does not
000000r 2               
000000r 2               SFX_STEP_BYTES      = 3         ; frames, timbre, note (tables.inc)
000000r 2               SFX_CHAIN_SHIFT     = 2         ; Semitones the match chime rises per chain
000000r 2               SFX_CHAIN_MAX       = 8         ;   link, and the most it ever rises (SPEC 16)
000000r 2               
000000r 2               ; --- The title screen's ambience ---------------------------------------------
000000r 2               ;   Sounds of the lab rather than a tune: a cauldron bubbling away under the
000000r 2               ;   title, and every so often one of the game's own effects drifting past at
000000r 2               ;   half volume, as though an experiment two benches over just went off.
000000r 2               ;   ambience.asm sequences it; AmbTable (tables.inc) is the mix.
000000r 2               AMB_ENTRIES         = 16        ; Rows in AmbTable. A power of two, so a random
000000r 2                                               ;   nibble picks one evenly with an AND
000000r 2               AMB_SHIFT_RANGE     = 8         ; Semitones a sound may be pitched up by, so no
000000r 2                                               ;   two bubbles are the same size. Every list
000000r 2                                               ;   below is written low enough that +7 stays
000000r 2                                               ;   inside NOTE_MAX.
000000r 2               AMB_GAP_MIN         = 7         ; Frames of quiet between one sound and the
000000r 2               AMB_GAP_RANGE       = 26        ;   next: 7 to 32, rolled every time
000000r 2               AMB_GAP_EVENT       = 40        ; ...and this much more after a borrowed game
000000r 2                                               ;   effect, so the lab goes back to simmering
000000r 2                                               ;   instead of chattering
000000r 2               
000000r 2               ;   A step names a TIMBRE, not a waveform, because the two sound chips have
000000r 2               ;   nothing in common below that level. A timbre is a voice AND an octave:
000000r 2               ;   SOFT sounds an octave below the written note, BUZZ at it, BRIGHT an octave
000000r 2               ;   above. On a SID that is a waveform plus a shift of the frequency; on the
000000r 2               ;   VIC-I it is a choice between three oscillators that are already an octave
000000r 2               ;   apart, so the octave costs nothing there at all (hal.inc).
000000r 2               TIMBRE_OFF          = 0         ; Silence — the note is ignored
000000r 2               TIMBRE_SOFT         = 1         ; triangle / VIC bass       — an octave down
000000r 2               TIMBRE_BUZZ         = 2         ; sawtooth / VIC alto       — as written
000000r 2               TIMBRE_BRIGHT       = 3         ; pulse    / VIC soprano    — an octave up
000000r 2               TIMBRE_NOISE        = 4         ; noise    / VIC noise
000000r 2               TIMBRE_COUNT        = 5
000000r 2               
000000r 2               ;   Bit 7 of the same byte is a LEVEL and not a voice. Both sound chips have
000000r 2               ;   one master volume and no per-voice one, so "quieter" cannot be a property
000000r 2               ;   of a note — it is a register the platform writes on its way past, and the
000000r 2               ;   cheapest place to carry the choice is the byte already going there. It is
000000r 2               ;   set for everything the title screen plays and clear for everything the game
000000r 2               ;   plays (audio.asm, hal.inc), which is the whole of its use.
000000r 2               TIMBRE_QUIET        = $80       ; ...OR it into a timbre
000000r 2               TIMBRE_MASK         = $7F       ; ...and AND it back off, which every HalSfx
000000r 2                                               ;   does first, so a quiet TIMBRE_OFF is still
000000r 2                                               ;   silence and not a fifth voice
000000r 2               
000000r 2               ;   A note is a count of semitones above C3, so one number means the same pitch
000000r 2               ;   on both sound chips and each platform keeps its own NOTE_MAX + 1 entry
000000r 2               ;   table to turn it into register values. Write a note as an octave plus a
000000r 2               ;   degree — OCT_4 + SEMI_G is G4.
000000r 2               OCT_3               = 0
000000r 2               OCT_4               = 12
000000r 2               OCT_5               = 24
000000r 2               OCT_6               = 36
000000r 2               SEMI_C              = 0
000000r 2               SEMI_D              = 2
000000r 2               SEMI_E              = 4
000000r 2               SEMI_F              = 5
000000r 2               SEMI_G              = 7
000000r 2               SEMI_A              = 9
000000r 2               SEMI_B              = 11
000000r 2               NOTE_MAX            = 36        ; C6, the top of both note tables. A chain
000000r 2                                               ;   transposing the match chime past it is
000000r 2                                               ;   clamped rather than allowed to index off
000000r 2                                               ;   the end (audio.asm)
000000r 2               
000000r 2               ; --- Reagent probability, out of 256 (SPEC 5.3) ------------------------------
000000r 2               PSPECIAL_BANDS      = 5
000000r 2               
000000r 2               ; --- Input bitmask (SPEC 11.1) -----------------------------------------------
000000r 2               ;   Active HIGH. Each platform inverts and remaps its own hardware into this.
000000r 2               INPUT_UP            = %00000001 ; Rotate forward
000000r 2               INPUT_DOWN          = %00000010 ; Soft drop
000000r 2               INPUT_LEFT          = %00000100
000000r 2               INPUT_RIGHT         = %00001000
000000r 2               INPUT_FIRE          = %00010000 ; Rotate reverse / confirm
000000r 2               INPUT_PAUSE         = %00100000
000000r 2               INPUT_MASK          = %00111111 ; Everything the game reads. Bits 6-7 are free
000000r 2                                               ;   for a platform to use as scratch inside
000000r 2                                               ;   HalReadInput, as long as it strips them.
000000r 2               
000000r 2               ; --- Game states (SPEC 13) ---------------------------------------------------
000000r 2               STATE_TITLE         = 0
000000r 2               STATE_PLAY          = 1
000000r 2               STATE_PAUSE         = 2
000000r 2               STATE_GAMEOVER      = 3
000000r 2               
000000r 2               ; --- Play sub-states (SPEC 8) ------------------------------------------------
000000r 2               PLAY_FALLING        = 0
000000r 2               PLAY_LOCKING        = 1
000000r 2               PLAY_GLOW           = 2
000000r 2               PLAY_SHATTER        = 3
000000r 2               PLAY_GRAVITY        = 4
000000r 2               PLAY_ARE            = 5
000000r 2               
000000r 2               ; --- Buffer sizes (SPEC 17.1) ------------------------------------------------
000000r 2               MARKS_BYTES         = 16        ; One byte per row, bits 0-5
000000r 2               EFFECTQ_ENTRIES     = 48        ; ONE byte each — the board index of a pending
000000r 2               EFFECTQ_BYTES       = EFFECTQ_ENTRIES   ;   detonation, and nothing else.
000000r 2                                               ;   SPEC 8 budgeted two bytes for a packed
000000r 2                                               ;   glyph/row/column, which is a copy of what
000000r 2                                               ;   the board already holds: cells are not
000000r 2                                               ;   zeroed until step 6 and the queue is drained
000000r 2                                               ;   in step 4, so the tile is still there when
000000r 2                                               ;   the effect pops and its glyph and colour are
000000r 2                                               ;   one `lda Board,x` away. Half the RAM for
000000r 2                                               ;   nothing (SPEC 17.1).
000000r 2                                               ;   A ring keeps one slot free, so 47 pending
000000r 2                                               ;   detonations. On overflow an effect is
000000r 2                                               ;   dropped rather than growing the buffer (D6);
000000r 2                                               ;   at one reagent a piece it is not reachable.
000000r 2               DIRTY_ENTRIES       = 64        ; 3 bytes each: offset lo, offset hi, tile
000000r 2               DIRTY_BYTES         = DIRTY_ENTRIES * 3
000000r 2               DIRTY_FLUSH_MAX     = 24        ; Cells pushed to the screen per frame.
000000r 2                                               ;   MEASURED, not estimated (PLAN.md S1). A
000000r 2                                               ;   flush costs 165 cycles a cell on the
000000r 2                                               ;   AC6502 and about 132 on the Commodores, so
000000r 2                                               ;   24 cells is 3965 cycles — inside vertical
000000r 2                                               ;   blank on all three, and tightest on the
000000r 2                                               ;   AC6502 at 1 MHz, whose 70 blank lines are
000000r 2                                               ;   roughly 4450. It is also a quarter of the
000000r 2                                               ;   96-cell well, so a full redraw is exactly
000000r 2                                               ;   four frames.
000000r 2                                               ;   Overrunning vblank is not dangerous on any
000000r 2                                               ;   of the three — no VRAM write spacing is
000000r 2                                               ;   anywhere near violated (S1) — it only
000000r 2                                               ;   risks a cell landing a frame late. This is
000000r 2                                               ;   a budget, not a hardware limit.
000000r 2               
000000r 1               .include "../src/zeropage.inc"
000000r 2               ; =============================================================================
000000r 2               ;   zeropage.inc — Wizards Lab, zero page allocation
000000r 2               ; =============================================================================
000000r 2               ;   The ZEROPAGE segment is placed at $40 on every platform. That window is
000000r 2               ;   free on all three:
000000r 2               ;
000000r 2               ;     AC6502   $003A-$00FF free for user programs (6502.inc memory map)
000000r 2               ;     VIC-20   all of page zero, once the cartridge stops calling the KERNAL
000000r 2               ;     C64      all of page zero EXCEPT $00/$01, which are the processor port
000000r 2               ;
000000r 2               ;   Starting at $40 clears the C64's port bytes and the AC6502's system
000000r 2               ;   scratch with room to spare, and keeps one number in three linker configs.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               .segment "ZEROPAGE"
000000r 2               
000000r 2  xx xx        Ptr1:           .res 2      ; General pointer — free across any call boundary
000002r 2  xx xx        Ptr2:           .res 2      ; General pointer
000004r 2  xx xx        SrcPtr:         .res 2      ; Block copy source
000006r 2  xx xx        DstPtr:         .res 2      ; Block copy destination
000008r 2  xx xx        ScreenPtr:      .res 2      ; Current screen row base
00000Ar 2  xx xx        ColorPtr:       .res 2      ; Current colour RAM row base (Commodore only)
00000Cr 2               
00000Cr 2  xx           RngLo:          .res 1      ; 16-bit LFSR state — never both zero
00000Dr 2  xx           RngHi:          .res 1
00000Er 2               
00000Er 2  xx           Tmp0:           .res 1      ; Scratch. Never live across a JSR.
00000Fr 2  xx           Tmp1:           .res 1
000010r 2  xx           Tmp2:           .res 1
000011r 2  xx           Tmp3:           .res 1
000012r 2               
000012r 2               ; --- The match scanner (SPEC 6.2) --------------------------------------------
000012r 2               ;   One line of one pass at a time. The cursor is a BOARD INDEX rather than a
000012r 2               ;   row and a column, because all four passes are the same walk with a
000012r 2               ;   different step: +1 horizontal, +8 vertical, +9 diagonal, +7 anti-diagonal.
000012r 2  xx           ScanIdx:        .res 1      ; Where the cursor was when a run ended: ScanLine
000013r 2                                           ;   keeps it in X and spills it only here
000013r 2  xx           ScanStep:       .res 1      ; What to add to reach the next cell of this line
000014r 2  xx           ScanColor:      .res 1      ; Colour key of the run in progress ($FF = unset)
000015r 2  xx           ScanLen:        .res 1      ; Cells in it so far, wildcards included
000016r 2  xx           ScanEnd:        .res 1      ; Walk-back cursor while a finished run is marked
000017r 2  xx           ScanTop:        .res 1      ; Row base of the top of the pile. Every pass
000018r 2                                           ;   starts there rather than at row 0, which is
000018r 2                                           ;   most of the cost of a scan (match.asm)
000018r 2               
000018r 2               ; --- Board walks that call the renderer (SPEC 8 steps 6 and 8) ---------------
000018r 2               ;   RenderCell clobbers A, X and Y, so a walk that marks what it changes
000018r 2               ;   cannot keep its cursor in a register. GravIdx also has to survive from one
000018r 2               ;   frame to the next: a row of falling is a cursor and not a bulk enqueue,
000018r 2               ;   because a full well is more cells than the dirty ring holds (D12,
000018r 2               ;   SPEC 12.6).
000018r 2  xx           GravIdx:        .res 1      ; Cell the fall is walking up from, $FF when the
000019r 2                                           ;   row is finished
000019r 2  xx           GravMoved:      .res 1      ; Non-zero if this row of falling moved anything
00001Ar 2  xx           CellCount:      .res 1      ; Cells CascadeRemove has taken off the board
00001Br 2               
00001Br 2               ; --- Reagent effects (SPEC 7.3, SPEC 8 step 4) -------------------------------
00001Br 2               ;   EffectHit marks a cell, scores it and enqueues whatever it holds, so it
00001Br 2               ;   clobbers A, X and Y — which means a walk that offers it cells cannot keep
00001Br 2               ;   its cursor in a register either. Same reason GravIdx exists, and the same
00001Br 2               ;   reason these are not Tmp0-Tmp3: those are dead across a JSR.
00001Br 2  xx           EffectIdx:      .res 1      ; The cell the walk in progress is on
00001Cr 2  xx           EffectEnd:      .res 1      ; Where it stops. The bolt's row end, or the bomb's
00001Dr 2                                           ;   last row
00001Dr 2  xx           EffectRow:      .res 1      ; First cell of the bomb's current row
00001Er 2  xx           EffectArg:      .res 1      ; What the walk is looking for: the fireball's
00001Fr 2                                           ;   colour key, or the bomb's last column
00001Fr 2               
00001Fr 2               ; --- Animation walks (SPEC 14) -----------------------------------------------
00001Fr 2               ;   The glow, the beams and the shatter all walk MARKS and mark what they find,
00001Fr 2               ;   so their cursors cannot live in registers either — RenderMark clobbers A
00001Fr 2               ;   and X. There are two of them because the beam pass NESTS: the outer walk is
00001Fr 2               ;   over the marked cells, looking for bolts, and the inner one is over the
00001Fr 2               ;   cross each bolt draws.
00001Fr 2  xx           AnimMode:       .res 1      ; Which of the four the walk is doing
000020r 2  xx           AnimIdx:        .res 1      ; Outer cursor — the marked cell being animated
000021r 2  xx           AnimCur:        .res 1      ; Inner cursor — the beam cell being drawn
000022r 2  xx           AnimEnd:        .res 1      ; Where the inner walk stops
000023r 2  xx           AnimArg:        .res 1      ; What it is drawing, or the bolt's own column
000024r 2               
000024r 2               ; --- Render and text scratch -------------------------------------------------
000024r 2               ;   These ARE live across a JSR, unlike Tmp0-Tmp3, because text.asm calls
000024r 2               ;   RenderMark once per cell and has to remember where it is. That is safe
000024r 2               ;   only because RenderMark touches nothing here: it clobbers A, X and the
000024r 2               ;   stack and nothing else (see render.asm). Do not call anything else from a
000024r 2               ;   loop that holds one of these.
000024r 2  xx           TextCol:        .res 1      ; Panel column the next glyph goes in
000025r 2  xx           TextRow:        .res 1      ; Panel row the string is drawn on
000026r 2  xx           TextIdx:        .res 1      ; Cursor within the string, or the BCD byte index
000027r 2  xx           TextByte:       .res 1      ; The BCD byte being split into two digits
000028r 2  xx           TextSkip:       .res 1      ; Non-zero while the first high nibble is skipped
000029r 2  xx           FlushLeft:      .res 1      ; Cells left in this frame's flush budget
00002Ar 2  xx           RedrawCol:      .res 1      ; Panel column of the cell being marked. Shared by
00002Br 2                                           ;   every routine that marks a run of cells in one
00002Br 2                                           ;   column, because RenderMark clobbers X.
00002Br 2               
00002Br 1               .include "../src/ram.inc"
00002Br 2               ; =============================================================================
00002Br 2               ;   ram.inc — Wizards Lab, work RAM
00002Br 2               ; =============================================================================
00002Br 2               ;   SPEC.md section 17.1. Around 530 bytes, which is what lets the whole game
00002Br 2               ;   fit the VIC-20's 1 KB of usable work RAM — the tightest of the three
00002Br 2               ;   targets, and therefore the one the layout is designed against.
00002Br 2               ;
00002Br 2               ;   Every platform places the BSS segment somewhere different (see each
00002Br 2               ;   linker config); nothing in this file cares where.
00002Br 2               ; =============================================================================
00002Br 2               
00002Br 2               .segment "BSS"
000000r 2               
000000r 2               ; --- The board (SPEC 3.2) ----------------------------------------------------
000000r 2               ;   20 rows x 8 stride. Columns 6-7 of every row and rows 16-19 entirely are
000000r 2               ;   permanent $FF sentinels, so scans walk off the edge and stop by themselves.
000000r 2               ;   Page-align it: address(row,col) = Board + (row << 3) + col.
000000r 2               .align 256
000000r 2  xx xx xx xx  Board:          .res BOARD_BYTES
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
0000A0r 2               
0000A0r 2               ; --- Match / cascade state (SPEC 6.2, 8) -------------------------------------
0000A0r 2  xx xx xx xx  Marks:          .res MARKS_BYTES        ; One byte per row, bits 0-5 = columns
0000A4r 2  xx xx xx xx  
0000A8r 2  xx xx xx xx  
0000B0r 2  xx xx xx xx  EffectQ:        .res EFFECTQ_BYTES      ; Ring of pending reagent detonations —
0000B4r 2  xx xx xx xx  
0000B8r 2  xx xx xx xx  
0000E0r 2                                                       ;   the board INDEX of each, one byte,
0000E0r 2                                                       ;   because the tile is still on the
0000E0r 2                                                       ;   board when the entry pops
0000E0r 2                                                       ;   (constants.inc, SPEC 8)
0000E0r 2  xx           EffectQHead:    .res 1
0000E1r 2  xx           EffectQTail:    .res 1
0000E2r 2  xx           RunCount:       .res 1                  ; Runs resolved in the current step
0000E3r 2  xx           ChainStep:      .res 1                  ; 1 on the first step of a cascade
0000E4r 2  xx           StarCount:      .res 1                  ; Doublings pending, capped at 3
0000E5r 2  xx           CascadeLo:      .res 1                  ; Cascade point accumulator, packed BCD
0000E6r 2  xx           CascadeMid:     .res 1
0000E7r 2  xx           CascadeHi:      .res 1
0000E8r 2               
0000E8r 2               ; --- Animation (SPEC 14) -----------------------------------------------------
0000E8r 2  xx           AnimStep:       .res 1                  ; Ring frame the shatter is showing,
0000E9r 2                                                       ;   0 .. AnimSteps - 1
0000E9r 2  xx           AnimSteps:      .res 1                  ; SHATTER_STEPS, or BLIP_STEPS when a
0000EAr 2                                                       ;   marked prism is blipping out along
0000EAr 2                                                       ;   with the rest (constants.inc)
0000EAr 2  xx           TintColor:      .res 1                  ; Colour key currently drawn WHITE — the
0000EBr 2                                                       ;   fireball flash (SPEC 4.6) — or
0000EBr 2                                                       ;   TINT_NONE. Read by HalPlotCell on
0000EBr 2                                                       ;   the Commodores and written to the
0000EBr 2                                                       ;   VDP colour table on the AC6502;
0000EBr 2                                                       ;   HalColorFlash is the only thing that
0000EBr 2                                                       ;   sets it (hal.inc)
0000EBr 2  xx           PrismFrame:     .res 1                  ; Idle rotation frame, 0-3
0000ECr 2  xx           PrismTimer:     .res 1                  ; Frames until the next one
0000EDr 2  xx           PetrifyRow:     .res 1                  ; Board row the game-over petrify is
0000EEr 2                                                       ;   working up from, $FF when it is done
0000EEr 2  xx           TitleTimer:     .res 1                  ; Frames until the title prompt's next
0000EFr 2                                                       ;   half-blink (SPEC 13.1, 14)
0000EFr 2  xx           TitlePhase:     .res 1                  ; 0 while it is lit, 1 while it is dark
0000F0r 2               
0000F0r 2               ; --- Render (SPEC 12.6) ------------------------------------------------------
0000F0r 2               ;   A ring of DIRTY_ENTRIES cells waiting to be pushed to the screen, three
0000F0r 2               ;   bytes each: SCREEN column, SCREEN row, tile. Not a 16-bit screen offset —
0000F0r 2               ;   HalPlotCell takes a column and a row (hal.inc), and every platform reaches
0000F0r 2               ;   a cell through a per-row pointer table (SPEC 12.3), so an offset would only
0000F0r 2               ;   have to be taken apart again at the far end.
0000F0r 2               ;
0000F0r 2               ;   A ring rather than a list with a resume index, because a frame that flushes
0000F0r 2               ;   its cap leaves a remainder and the next frame's marks have to go somewhere.
0000F0r 2               ;   Head and tail are BYTE offsets into Dirty, not entry numbers, so stepping
0000F0r 2               ;   one entry is an add of 3 and never a multiply.
0000F0r 2  xx xx xx xx  Dirty:          .res DIRTY_BYTES        ; screen col, screen row, tile
0000F4r 2  xx xx xx xx  
0000F8r 2  xx xx xx xx  
0001B0r 2  xx           DirtyCount:     .res 1                  ; Entries pending, 0..DIRTY_ENTRIES
0001B1r 2  xx           DirtyHead:      .res 1                  ; Byte offset of the oldest pending
0001B2r 2  xx           DirtyTail:      .res 1                  ; Byte offset the next mark goes to
0001B3r 2  xx           RedrawIdx:      .res 1                  ; Board index RenderBoardStep resumes
0001B4r 2                                                       ;   at, or $FF when no redraw is
0001B4r 2                                                       ;   outstanding
0001B4r 2  xx           RedrawWash:     .res 1                  ; TILE_WASH while the cursor above is
0001B5r 2                                                       ;   painting the PAUSE wash rather than
0001B5r 2                                                       ;   the board, zero otherwise. Both are
0001B5r 2                                                       ;   96 cells against a 64-entry ring, so
0001B5r 2                                                       ;   both have to be a cursor (D12) and
0001B5r 2                                                       ;   one byte is cheaper than a second
0001B5r 2                                                       ;   one (SPEC 13.3)
0001B5r 2               
0001B5r 2               ; --- The falling piece (SPEC 5) ----------------------------------------------
0001B5r 2  xx           PieceCol:       .res 1
0001B6r 2  xx           PieceRow:       .res 1                  ; Row of cell A (the top cell)
0001B7r 2  xx           PieceA:         .res 1                  ; Tile bytes, top to bottom
0001B8r 2  xx           PieceB:         .res 1
0001B9r 2  xx           PieceC:         .res 1
0001BAr 2  xx           NextA:          .res 1                  ; The preview piece
0001BBr 2  xx           NextB:          .res 1
0001BCr 2  xx           NextC:          .res 1
0001BDr 2  xx           PieceDirty:     .res 1                  ; Non-zero when the three cells need
0001BEr 2                                                       ;   drawing. Not drawn on the spot,
0001BEr 2                                                       ;   because a full-board redraw may be
0001BEr 2                                                       ;   in flight and would paint over
0001BEr 2                                                       ;   them — see StatePlay (D14).
0001BEr 2               
0001BEr 2               ; --- Progress (SPEC 9, 10) ---------------------------------------------------
0001BEr 2  xx           ScoreLo:        .res 1                  ; 7 digits packed BCD, low byte first;
0001BFr 2  xx           ScoreMid:       .res 1                  ;   the top nibble of ScoreTop stays 0
0001C0r 2  xx           ScoreHi:        .res 1
0001C1r 2  xx           ScoreTop:       .res 1
0001C2r 2  xx           HighLo:         .res 1
0001C3r 2  xx           HighMid:        .res 1
0001C4r 2  xx           HighHi:         .res 1
0001C5r 2  xx           HighTop:        .res 1
0001C6r 2  xx           HighLevel:      .res 1                  ; Level the high score was set on, BCD
0001C7r 2  xx           HighOwned:      .res 1                  ; Non-zero once THIS game has taken the
0001C8r 2                                                       ;   high score. From the overtake on,
0001C8r 2                                                       ;   score and high score are equal and
0001C8r 2                                                       ;   every bank copies again, so without
0001C8r 2                                                       ;   this the one-shot fanfare and flash
0001C8r 2                                                       ;   would fire on every one (SPEC 9.8)
0001C8r 2  xx           HighFlash:      .res 1                  ; Half-blinks of the HIGH field left to
0001C9r 2                                                       ;   run. Odd = dark, even = lit, and it
0001C9r 2                                                       ;   ends at zero, so the field is always
0001C9r 2                                                       ;   left readable
0001C9r 2  xx           HighTimer:      .res 1                  ; Frames until the next half-blink
0001CAr 2  xx           Level:          .res 1                  ; Binary, 1-99
0001CBr 2  xx           TilesCleared:   .res 1                  ; Toward the next level, carries past 30
0001CCr 2               
0001CCr 2               ; --- Timers, all in frames (SPEC 14) -----------------------------------------
0001CCr 2  xx           GravityTimer:   .res 1
0001CDr 2  xx           LockTimer:      .res 1
0001CEr 2  xx           LockResets:     .res 1
0001CFr 2  xx           DasTimer:       .res 1
0001D0r 2  xx           DasDir:         .res 1
0001D1r 2  xx           AreTimer:       .res 1
0001D2r 2  xx           AnimTimer:      .res 1
0001D3r 2  xx           BannerTimer:    .res 1
0001D4r 2  xx           FrameCounter:   .res 1                  ; Free-running from power-on; seeds RNG
0001D5r 2               
0001D5r 2               ; --- Input (SPEC 11.1) -------------------------------------------------------
0001D5r 2  xx           InputNow:       .res 1
0001D6r 2  xx           InputPrev:      .res 1
0001D7r 2  xx           InputEdge:      .res 1                  ; Newly pressed this frame
0001D8r 2               
0001D8r 2               ; --- State machine (SPEC 13) -------------------------------------------------
0001D8r 2  xx           GameState:      .res 1                  ; STATE_*
0001D9r 2  xx           PlayState:      .res 1                  ; PLAY_*
0001DAr 2  xx           OverSecs:       .res 1                  ; Seconds left on the game-over screen,
0001DBr 2                                                       ;   and ZERO until the petrify has
0001DBr 2                                                       ;   finished and the banner is up. That
0001DBr 2                                                       ;   double duty is what makes the setup
0001DBr 2                                                       ;   a one-shot without a second flag:
0001DBr 2                                                       ;   the count never rests at zero,
0001DBr 2                                                       ;   because reaching it returns to the
0001DBr 2                                                       ;   title in the same frame (SPEC 13.4)
0001DBr 2  xx           OverTimer:      .res 1                  ; Frames until the next second of it
0001DCr 2  xx           Region:         .res 1                  ; 0 = NTSC, 1 = PAL
0001DDr 2  xx           NeedsRedraw:    .res 1
0001DEr 2               
0001DEr 2               ; --- Audio (SPEC 16) ---------------------------------------------------------
0001DEr 2               ;   Seven bytes, not the sixteen SPEC 17.1 budgeted — five for SPEC 16's
0001DEr 2               ;   channel and two more for the title screen's ambience. The effect data is a
0001DEr 2               ;   step list in ROM (tables.inc) and the driver is a cursor into it, so the
0001DEr 2               ;   only thing RAM has to hold is where in that list the one playing channel is.
0001DEr 2  xx           SfxRequest:     .res 1                  ; Effect asked for THIS frame, or 0.
0001DFr 2                                                       ;   Logic writes it through SfxPlay,
0001DFr 2                                                       ;   which keeps the loudest of several
0001DFr 2                                                       ;   in one frame; AudioTick consumes and
0001DFr 2                                                       ;   clears it (audio.asm)
0001DFr 2  xx           SfxId:          .res 1                  ; Effect playing, or 0 for silence. It
0001E0r 2                                                       ;   is also the priority a new request
0001E0r 2                                                       ;   has to beat (constants.inc)
0001E0r 2  xx           SfxStepIdx:     .res 1                  ; Byte offset into SfxSteps of the NEXT
0001E1r 2                                                       ;   step — which is why that table has
0001E1r 2                                                       ;   to stay under 256 bytes
0001E1r 2  xx           SfxTimer:       .res 1                  ; Frames left in the step now sounding
0001E2r 2  xx           SfxShift:       .res 1                  ; Semitones added to every note of the
0001E3r 2                                                       ;   effect playing. Zero for eleven of
0001E3r 2                                                       ;   the twelve; the match chime sets it
0001E3r 2                                                       ;   from the chain (SPEC 16)
0001E3r 2  xx           SfxLevel:       .res 1                  ; TIMBRE_QUIET while the title screen
0001E4r 2                                                       ;   owns the channel, 0 while the game
0001E4r 2                                                       ;   does. ORed into every timbre on its
0001E4r 2                                                       ;   way to the platform (audio.asm), and
0001E4r 2                                                       ;   it doubles as the flag that says the
0001E4r 2                                                       ;   ambience is running at all — the two
0001E4r 2                                                       ;   are the same fact, because the title
0001E4r 2                                                       ;   screen is the only thing that turns
0001E4r 2                                                       ;   the volume down and the only thing
0001E4r 2                                                       ;   that bubbles (ambience.asm)
0001E4r 2  xx           AmbTimer:       .res 1                  ; Frames of quiet left before the lab
0001E5r 2                                                       ;   makes its next noise. Counted only
0001E5r 2                                                       ;   on frames where nothing is sounding,
0001E5r 2                                                       ;   so a long effect does not eat the gap
0001E5r 2                                                       ;   that follows it
0001E5r 2               
0001E5r 1               .include "../src/hal.inc"
0001E5r 2               ; =============================================================================
0001E5r 2               ;   hal.inc — Wizards Lab, the platform contract
0001E5r 2               ; =============================================================================
0001E5r 2               ;   Everything in src/ is shared, unmodified, by all three machines. The only
0001E5r 2               ;   things that differ are collected here: each platform's WizardsLab.asm must
0001E5r 2               ;   define these constants and implement these eight routines, and nothing
0001E5r 2               ;   else in src/ may touch hardware directly.
0001E5r 2               ;
0001E5r 2               ;   This file declares nothing. It is the documentation for the boundary, kept
0001E5r 2               ;   next to the code it constrains so it cannot drift out of date unnoticed.
0001E5r 2               ;
0001E5r 2               ;   CONSTANTS the platform must define BEFORE including the shared sources
0001E5r 2               ;   ---------------------------------------------------------------------
0001E5r 2               ;     PANEL_X, PANEL_Y      Where the 22 x 24 panel sits on this screen.
0001E5r 2               ;                             AC6502  5, 0      VIC-20  0, 0      C64  9, 0
0001E5r 2               ;                           PANEL_Y is 0 everywhere; the VIC-20 clips panel
0001E5r 2               ;                           row 23 and the C64 has one spare row below it.
0001E5r 2               ;     SCR_COLS           32 / 22 / 40
0001E5r 2               ;     SCR_ROWS           24 / 23 / 25
0001E5r 2               ;     HAS_COLOR_RAM         1 on the Commodores, 0 on the AC6502, whose colour
0001E5r 2               ;                           lives in the VDP colour table instead.
0001E5r 2               ;
0001E5r 2               ;   ROUTINES the platform must implement
0001E5r 2               ;   ------------------------------------
0001E5r 2               ;     HalInitVideo      Bring up the video hardware: black background and
0001E5r 2               ;                       border, the correct text/tile mode, tileset in place,
0001E5r 2               ;                       colours configured, screen cleared. Called once.
0001E5r 2               ;                       In:  nothing        Out: nothing
0001E5r 2               ;
0001E5r 2               ;     HalWaitFrame      Block until the start of the next vertical blank.
0001E5r 2               ;                       Everything below is called only between frames.
0001E5r 2               ;                       In:  nothing        Out: nothing
0001E5r 2               ;
0001E5r 2               ;     HalPlotCell       Write one cell, colour included where the platform has
0001E5r 2               ;                       per-cell colour — white instead, for any tile whose
0001E5r 2               ;                       colour key is TintColor (see HalColorFlash).
0001E5r 2               ;                       In:  A = tile, X = screen column, Y = screen row
0001E5r 2               ;                       Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
0001E5r 2               ;
0001E5r 2               ;     HalBlitScreen     Draw a whole static screen from a name-table image in
0001E5r 2               ;                       ROM: SCR_COLS * SCR_ROWS bytes, row-major, plus
0001E5r 2               ;                       the matching colour image where the platform needs one.
0001E5r 2               ;                       In:  SrcPtr -> name table, Ptr1 -> colour table
0001E5r 2               ;                       Out: nothing
0001E5r 2               ;
0001E5r 2               ;     HalReadInput      Read stick and keyboard, fold both into one mask.
0001E5r 2               ;                       In:  nothing
0001E5r 2               ;                       Out: A = INPUT_* bits, ACTIVE HIGH
0001E5r 2               ;
0001E5r 2               ;     HalDetectRegion   Decide NTSC or PAL so the timing tables can be picked.
0001E5r 2               ;                       In:  nothing        Out: A = 0 NTSC, 1 PAL
0001E5r 2               ;
0001E5r 2               ;     HalColorFlash     Draw every tile of one colour white, or stop doing so.
0001E5r 2               ;                       The fireball's detonation (SPEC 4.6, 14).
0001E5r 2               ;                       In:  A = colour key ($40..$68), or TINT_NONE for none
0001E5r 2               ;                       Out: nothing.  Modifies: A, X, Y, and TintColor, which
0001E5r 2               ;                            it OWNS: nothing else may write that byte.
0001E5r 2               ;                       The platform must handle the transition, not just the
0001E5r 2               ;                       new value — a second call with a different colour puts
0001E5r 2               ;                       the first one back before lighting the second.
0001E5r 2               ;                       On the AC6502 this is ONE byte in the VDP colour table,
0001E5r 2               ;                       because a tile's colour there belongs to its 8-pattern
0001E5r 2               ;                       group and not to the cell. On the Commodores colour is
0001E5r 2               ;                       per cell, so HalPlotCell reads TintColor instead and
0001E5r 2               ;                       substitutes white for any tile of that colour as it
0001E5r 2               ;                       draws it — which also means every tinted cell has to be
0001E5r 2               ;                       re-marked, and the animation is already marking all of
0001E5r 2               ;                       them (anim.asm).
0001E5r 2               ;
0001E5r 2               ;     HalSfx            Sound ONE note, in one timbre, at one of two levels,
0001E5r 2               ;                       until told otherwise.
0001E5r 2               ;                       In:  A = TIMBRE_* (constants.inc), optionally with
0001E5r 2               ;                            TIMBRE_QUIET (bit 7) set; X = note in semitones
0001E5r 2               ;                            above C3, 0..NOTE_MAX. TIMBRE_OFF ends whatever is
0001E5r 2               ;                            sounding and ignores X.
0001E5r 2               ;                       Out: nothing.  Modifies: A, X, Y, Tmp0-Tmp2
0001E5r 2               ;                       This is NOT "play effect 4". Which effect is playing,
0001E5r 2               ;                       which step of it, how long the step lasts and what
0001E5r 2               ;                       note it is are all shared code (audio.asm), because
0001E5r 2               ;                       none of that differs between a SID and a VIC-I; what
0001E5r 2               ;                       does differ is the register values one note comes out
0001E5r 2               ;                       as, and that is the whole of this routine. SPEC 16
0001E5r 2               ;                       expected the split one level lower — a SID driver
0001E5r 2               ;                       shared by two machines and a third written twice —
0001E5r 2               ;                       and this is the same code shared by three (D22).
0001E5r 2               ;                       A timbre is a voice AND an octave: SOFT sounds an
0001E5r 2               ;                       octave below the note it is given, BUZZ at it, BRIGHT
0001E5r 2               ;                       an octave above. On a SID that is a waveform and a
0001E5r 2               ;                       shift; on the VIC-I the three tone oscillators are
0001E5r 2               ;                       already an octave apart, so it is free.
0001E5r 2               ;                       Bit 7 is neither. It is a LEVEL — quiet, for the title
0001E5r 2               ;                       screen's ambience (src/ambience.asm) — and both chips
0001E5r 2               ;                       have only a master volume to put it in, so every
0001E5r 2               ;                       implementation must MASK IT OFF (TIMBRE_MASK) before it
0001E5r 2               ;                       compares or indexes anything. A quiet TIMBRE_OFF is
0001E5r 2               ;                       silence, not a fifth voice.
0001E5r 2               ;                       A machine with no sound card must still return: the
0001E5r 2               ;                       AC6502's is optional hardware and the game plays
0001E5r 2               ;                       silently on one that has none.
0001E5r 2               ;
0001E5r 2               ;   The shared code assumes nothing about interrupts. Each platform may drive
0001E5r 2               ;   HalWaitFrame from a raster IRQ, a timer, or a status-register poll.
0001E5r 2               ; =============================================================================
0001E5r 2               
0001E5r 1               
0001E5r 1               ; =============================================================================
0001E5r 1               ;   Cartridge header — BLK5, $A000
0001E5r 1               ; =============================================================================
0001E5r 1               
0001E5r 1               .segment "CARTHDR"
000000r 1               
000000r 1  rr rr        .addr ColdStart                 ; Cold start vector
000002r 1  rr rr        .addr ColdStart                 ; Warm start vector (RESTORE = full restart)
000004r 1  41 30 C3 C2  .byte $41, $30, $C3, $C2, $CD   ; "A0CBM" autostart signature
000008r 1  CD           
000009r 1               
000009r 1               ; =============================================================================
000009r 1               ;   Entry
000009r 1               ; =============================================================================
000009r 1               
000009r 1               .segment "CODE"
000000r 1               
000000r 1               ColdStart:
000000r 1  78             sei
000001r 1  D8             cld
000002r 1  A2 FF          ldx #$FF
000004r 1  9A             txs                           ; Nothing did this for us
000005r 1               
000005r 1  20 rr rr       jsr GameInit                  ; Never returns
000008r 1               
000008r 1               ; --- Shared game code --------------------------------------------------------
000008r 1               .include "../src/main.asm"
000008r 2               ; =============================================================================
000008r 2               ;   main.asm — Wizards Lab, shared entry point and main loop
000008r 2               ; =============================================================================
000008r 2               ;   Included by every platform's WizardsLab.asm after that file has defined
000008r 2               ;   PANEL_X / PANEL_Y and its half of the HAL (see hal.inc). Nothing below
000008r 2               ;   touches hardware.
000008r 2               ;
000008r 2               ;   BUILD STATUS
000008r 2               ;   ------------
000008r 2               ;   Pieces spawn, steer, rotate, fall and lock, runs of three or more clear,
000008r 2               ;   the pile falls into the holes, chains keep going until nothing matches, all
000008r 2               ;   of it scores and ramps the level, the five reagents fire and set each other
000008r 2               ;   off, a clear glows and shatters on the frame clock instead of happening
000008r 2               ;   between two frames, the arcade loop around all of it is closed — title,
000008r 2               ;   play, pause, game over, title — and every event of SPEC 16 makes a noise
000008r 2               ;   (PLAN.md P2 to P8). The game is complete; what is left is real hardware
000008r 2               ;   (P10).
000008r 2               ; =============================================================================
000008r 2               
000008r 2               ; -----------------------------------------------------------------------------
000008r 2               ;   GameInit — one-time setup, called from the cartridge entry point
000008r 2               ; -----------------------------------------------------------------------------
000008r 2               GameInit:
000008r 2  20 rr rr       jsr HalDetectRegion
00000Br 2  8D rr rr       sta Region
00000Er 2               
00000Er 2  20 rr rr       jsr HalInitVideo              ; Tiles in place, screen black and cleared
000011r 2  20 rr rr       jsr AudioInit
000014r 2  20 rr rr       jsr RenderDirtyReset
000017r 2               
000017r 2  A9 00          lda #0
000019r 2  8D rr rr       sta FrameCounter
00001Cr 2  20 rr rr       jsr RngSeed                   ; A zero LFSR state sticks at zero forever, and
00001Fr 2                                               ;   BSS is not cleared on all three machines, so
00001Fr 2                                               ;   seed it once here just to get it out of that
00001Fr 2                                               ;   hole. This is NOT the game's seed — SPEC 15
00001Fr 2                                               ;   forbids a constant one, and StateTitle
00001Fr 2                                               ;   reseeds from the player's reaction time
00001Fr 2                                               ;   before the first piece is ever rolled.
00001Fr 2  A9 00          lda #0
000021r 2  8D rr rr       sta InputNow
000024r 2  8D rr rr       sta InputPrev
000027r 2  8D rr rr       sta InputEdge
00002Ar 2  8D rr rr       sta TitlePhase                ; The title prompt starts lit, and the game-over
00002Dr 2  8D rr rr       sta OverSecs                  ;   screen starts un-entered. Both are BSS, and
000030r 2                                               ;   BSS is not cleared on all three machines.
000030r 2  A9 01          lda #1
000032r 2  8D rr rr       sta PrismTimer                ; A zero here would DEC to 255 and stall the
000035r 2                                               ;   prism's rotation for four seconds
000035r 2  A9 01          lda #TINT_NONE                ; BSS is not cleared on all three machines, and
000037r 2  8D rr rr       sta TintColor                 ;   a garbage colour key here would draw the
00003Ar 2                                               ;   title screen's tiles of that colour white
00003Ar 2                                               ;   on the Commodores. Set before anything
00003Ar 2                                               ;   plots a cell, not in HalColorFlash, which
00003Ar 2                                               ;   reads it to undo the last flash (hal.inc).
00003Ar 2               
00003Ar 2  20 rr rr       jsr ScoreHighInit             ; Once a session, before the first ScoreReset
00003Dr 2  20 rr rr       jsr ScoreReset
000040r 2  20 rr rr       jsr BoardClear
000043r 2               
000043r 2               .ifdef WL_DEBUG
000043r 2                 jsr GameStart                 ; TEMPORARY: skip the title and start playing,
000043r 2                                               ;   because a headless machine has no input
000043r 2                                               ;   attached and would sit on the title screen
000043r 2                                               ;   forever. Nothing else about the build
000043r 2                                               ;   differs any more (PLAN.md section 3).
000043r 2               .else
000043r 2  A9 00          lda #STATE_TITLE
000045r 2  8D rr rr       sta GameState
000048r 2  A9 01          lda #1
00004Ar 2  8D rr rr       sta NeedsRedraw
00004Dr 2               .endif
00004Dr 2                 ; falls through into GameLoop
00004Dr 2               
00004Dr 2               ; -----------------------------------------------------------------------------
00004Dr 2               ;   GameLoop — never returns
00004Dr 2               ; -----------------------------------------------------------------------------
00004Dr 2               GameLoop:
00004Dr 2  20 rr rr       jsr HalWaitFrame
000050r 2  EE rr rr       inc FrameCounter              ; Free-running from power-on; seeds the RNG
000053r 2               
000053r 2  20 rr rr       jsr RenderFlush               ; Screen writes happen in vertical blank only
000056r 2  20 rr rr       jsr InputPoll
000059r 2               
000059r 2  AD rr rr       lda GameState                 ; Dispatch on the current screen state
00005Cr 2  C9 00          cmp #STATE_TITLE
00005Er 2  F0 0E          beq @Title
000060r 2  C9 01          cmp #STATE_PLAY
000062r 2  F0 10          beq @Play
000064r 2  C9 02          cmp #STATE_PAUSE
000066r 2  F0 12          beq @Pause
000068r 2  20 rr rr       jsr StateGameOver             ; JSR, not JMP — every state handler ends in an
00006Br 2  4C rr rr       jmp @Audio                    ;   RTS, and a JMP here would hand that RTS the
00006Er 2                                               ;   return address of the JSR GameInit that the
00006Er 2                                               ;   cart entry point never expects back. The
00006Er 2                                               ;   first loss unwound the loop into GameInit;
00006Er 2                                               ;   the second pulled from an empty stack.
00006Er 2               
00006Er 2               @Title:
00006Er 2  20 rr rr       jsr StateTitle
000071r 2  4C rr rr       jmp @Audio
000074r 2               @Play:
000074r 2  20 rr rr       jsr StatePlay
000077r 2  4C rr rr       jmp @Audio
00007Ar 2               @Pause:
00007Ar 2  20 rr rr       jsr StatePause
00007Dr 2               
00007Dr 2               @Audio:
00007Dr 2  20 rr rr       jsr AudioTick
000080r 2  4C rr rr       jmp GameLoop
000083r 2               
000083r 2               ; =============================================================================
000083r 2               ;   States (SPEC 13)
000083r 2               ; =============================================================================
000083r 2               
000083r 2               ; -----------------------------------------------------------------------------
000083r 2               ;   StateTitle — blinking prompt over the drawn screen, and the magic field
000083r 2               ;   SPEC 13.1. There are no help pages: the controls are part of the screen
000083r 2               ;   image, so the only things moving here are the prompt and the field.
000083r 2               ;
000083r 2               ;   Nothing below ticks the sound. The title screen's ambience hangs off the
000083r 2               ;   silent branch of AudioTick instead, because what it is filling is the gaps
000083r 2               ;   between sounds and this routine cannot see them (ambience.asm).
000083r 2               ; -----------------------------------------------------------------------------
000083r 2               StateTitle:
000083r 2  AD rr rr       lda NeedsRedraw
000086r 2  F0 11          beq @Live
000088r 2  A9 00          lda #0
00008Ar 2  8D rr rr       sta NeedsRedraw
00008Dr 2  20 rr rr       jsr DrawTitleScreen
000090r 2  20 rr rr       jsr RenderDirtyReset          ; A full blit went behind the renderer's back
000093r 2               
000093r 2  20 rr rr       jsr AnimTitleBegin            ; ...and the prompt blinks from lit, so it never
000096r 2                                               ;   starts a second visit dark
000096r 2  20 rr rr       jsr AmbienceBegin             ; ...and the lab starts murmuring under it
000099r 2               @Live:
000099r 2  20 rr rr       jsr AnimTitleField            ; The two things that move here, and the whole
00009Cr 2  20 rr rr       jsr AnimTitleBlink            ;   of the screen's animation (SPEC 13.1)
00009Fr 2               
00009Fr 2  AD rr rr       lda InputEdge
0000A2r 2  29 11          and #(INPUT_FIRE | INPUT_UP)  ; Fire, or SPACE, which the keyboards fold
0000A4r 2  F0 06          beq @Done                     ;   into UP so it can rotate in play (D15)
0000A6r 2               
0000A6r 2  20 rr rr       jsr RngSeed                   ; SPEC 15 — seed from reaction time, not a constant
0000A9r 2  20 rr rr       jsr GameStart
0000ACr 2               @Done:
0000ACr 2  60             rts
0000ADr 2               
0000ADr 2               ; -----------------------------------------------------------------------------
0000ADr 2               ;   GameStart — enter play from the title screen
0000ADr 2               ; -----------------------------------------------------------------------------
0000ADr 2               GameStart:
0000ADr 2  20 rr rr       jsr AmbienceEnd               ; The cauldron stops HERE, mid-bubble if it has
0000B0r 2                                               ;   to: the next noise this machine makes
0000B0r 2                                               ;   belongs to the game (ambience.asm)
0000B0r 2  20 rr rr       jsr ScoreReset
0000B3r 2  20 rr rr       jsr BoardClear
0000B6r 2               
0000B6r 2  A9 01          lda #1
0000B8r 2  8D rr rr       sta Level
0000BBr 2  A9 00          lda #0
0000BDr 2  8D rr rr       sta TilesCleared
0000C0r 2  8D rr rr       sta DasDir                    ; No direction is held into a new game
0000C3r 2  8D rr rr       sta DasTimer
0000C6r 2  8D rr rr       sta PieceDirty
0000C9r 2  8D rr rr       sta BannerTimer               ; Nothing from the last game is still up
0000CCr 2  8D rr rr       sta PrismFrame
0000CFr 2  A9 01          lda #1
0000D1r 2  8D rr rr       sta PrismTimer
0000D4r 2  A9 01          lda #TINT_NONE                ; ...and no colour is still flashing white, on
0000D6r 2  20 rr rr       jsr HalColorFlash             ;   a machine where that is a VDP register and
0000D9r 2                                               ;   not a byte of RAM (SPEC 4.6)
0000D9r 2               
0000D9r 2  20 rr rr       jsr DrawPlayScreen            ; The whole screen at once, behind the
0000DCr 2  20 rr rr       jsr RenderDirtyReset          ;   renderer's back — so drop anything queued
0000DFr 2                                               ;   against the screen that just went away
0000DFr 2               
0000DFr 2  20 rr rr       jsr TextBannerClear           ; The play image ships with the band reading
0000E2r 2                                               ;   `~~ PAUSED ~~` (SPEC 12.1); play owns it,
0000E2r 2                                               ;   and so does whatever the last game left in
0000E2r 2                                               ;   it — GAME OVER stays up until here
0000E2r 2  20 rr rr       jsr RenderScore               ; The panel fields are code's, not the image's
0000E5r 2  20 rr rr       jsr RenderHigh
0000E8r 2  20 rr rr       jsr RenderLevel
0000EBr 2  20 rr rr       jsr RenderBoard               ; Queued across as many frames as it takes
0000EEr 2               
0000EEr 2  20 rr rr       jsr PieceGenerateNext         ; Fill the preview...
0000F1r 2  20 rr rr       jsr PieceSpawn                ; ...then promote it and refill. The board is
0000F4r 2  20 rr rr       jsr PieceGenerateNext         ;   empty, so the spawn cannot be blocked.
0000F7r 2  20 rr rr       jsr RenderNext
0000FAr 2               
0000FAr 2  A9 00          lda #PLAY_FALLING
0000FCr 2  8D rr rr       sta PlayState
0000FFr 2  A9 01          lda #STATE_PLAY
000101r 2  8D rr rr       sta GameState
000104r 2  60             rts
000105r 2               
000105r 2               ; -----------------------------------------------------------------------------
000105r 2               ;   StatePlay — the game
000105r 2               ;   SPEC 13.2. One frame is: advance whatever the play sub-state is doing,
000105r 2               ;   then queue whatever changed. Cascades run as sub-states rather than in a
000105r 2               ;   blocking loop so animation stays on the frame clock.
000105r 2               ; -----------------------------------------------------------------------------
000105r 2               StatePlay:
000105r 2  20 rr rr       jsr ScoreFlashTick            ; SPEC 9.8 — the HIGH field blinking after an
000108r 2                                               ;   overtake. Play never stops for it, so it
000108r 2                                               ;   ticks alongside whatever the sub-state is
000108r 2                                               ;   doing rather than inside one.
000108r 2  20 rr rr       jsr AnimBannerTick            ; ...and neither does it for a banner (SPEC 14)
00010Br 2  20 rr rr       jsr AnimPrismTick             ; ...nor for the one tile that moves at rest
00010Er 2               
00010Er 2  AD rr rr       lda InputEdge
000111r 2  29 20          and #INPUT_PAUSE
000113r 2  D0 52          bne @ToPause
000115r 2               
000115r 2  AD rr rr       lda PlayState
000118r 2  C9 00          cmp #PLAY_FALLING
00011Ar 2  F0 17          beq @Falling
00011Cr 2  C9 01          cmp #PLAY_LOCKING
00011Er 2  F0 19          beq @Locking
000120r 2  C9 02          cmp #PLAY_GLOW
000122r 2  F0 1B          beq @Glow
000124r 2  C9 03          cmp #PLAY_SHATTER
000126r 2  F0 1D          beq @Shatter
000128r 2  C9 04          cmp #PLAY_GRAVITY
00012Ar 2  F0 1F          beq @Gravity
00012Cr 2  C9 05          cmp #PLAY_ARE
00012Er 2  F0 21          beq @Are
000130r 2  4C rr rr       jmp @Draw                     ; Not a state anything sets
000133r 2               
000133r 2               @Falling:
000133r 2  20 rr rr       jsr PlayFalling
000136r 2  4C rr rr       jmp @Draw
000139r 2               @Locking:
000139r 2  20 rr rr       jsr PlayLocking
00013Cr 2  4C rr rr       jmp @Draw
00013Fr 2               @Glow:
00013Fr 2  20 rr rr       jsr PlayGlow
000142r 2  4C rr rr       jmp @Draw
000145r 2               @Shatter:
000145r 2  20 rr rr       jsr PlayShatter
000148r 2  4C rr rr       jmp @Draw
00014Br 2               @Gravity:
00014Br 2  20 rr rr       jsr PlayGravity
00014Er 2  4C rr rr       jmp @Draw
000151r 2               @Are:
000151r 2  20 rr rr       jsr PlayAre
000154r 2               
000154r 2                 ; --- draw the piece, once whatever else wanted the screen has finished ----
000154r 2                 ;   D14. RenderBoard is a cursor that feeds the ring over several frames
000154r 2                 ;   (D12), so marks made while one is outstanding are drawn BEFORE the
000154r 2                 ;   redraw reaches those cells and are then painted over. Holding the piece
000154r 2                 ;   back until the redraw has finished is one byte and always right; the
000154r 2                 ;   alternative is a piece that vanishes for four frames after every pause.
000154r 2               @Draw:
000154r 2  AD rr rr       lda PieceDirty
000157r 2  F0 0D          beq @Done
000159r 2  AD rr rr       lda RedrawIdx
00015Cr 2  10 08          bpl @Done                     ; A board redraw is still in flight
00015Er 2  A9 00          lda #0
000160r 2  8D rr rr       sta PieceDirty
000163r 2  20 rr rr       jsr RenderPiece
000166r 2               @Done:
000166r 2  60             rts
000167r 2               
000167r 2               @ToPause:
000167r 2  A9 02          lda #STATE_PAUSE
000169r 2  8D rr rr       sta GameState
00016Cr 2  A9 rr          lda #<MsgPaused               ; SPEC 12.2 — without this the screen does not
00016Er 2  85 rr          sta Ptr1                      ;   change at all on a pause, and a paused game
000170r 2  A9 rr          lda #>MsgPaused               ;   is indistinguishable from a hung one
000172r 2  85 rr          sta Ptr1+1
000174r 2  20 rr rr       jsr TextBanner
000177r 2  4C rr rr       jmp RenderWash                ; SPEC 13.3 — the well is covered, not blanked,
00017Ar 2                                               ;   so a pause cannot be used to study the
00017Ar 2                                               ;   board. Queued as a cursor because 96 cells
00017Ar 2                                               ;   do not fit the ring (render.asm, D12), and
00017Ar 2                                               ;   AFTER the banner, so the banner's marks are
00017Ar 2                                               ;   in the ring before the wash starts filling
00017Ar 2                                               ;   it
00017Ar 2               
00017Ar 2               ; -----------------------------------------------------------------------------
00017Ar 2               ;   PlayFalling — steer the piece, and drop it a row when the timer runs out
00017Ar 2               ;   SPEC 5.5, 5.6, 11.3
00017Ar 2               ; -----------------------------------------------------------------------------
00017Ar 2               PlayFalling:
00017Ar 2  20 rr rr       jsr PieceControl              ; Rotation and DAS; the result is ignored here
00017Dr 2                                               ;   because there is no lock delay to reset yet
00017Dr 2  20 rr rr       jsr PieceFallRate
000180r 2  85 rr          sta Tmp0
000182r 2  AD rr rr       lda GravityTimer              ; Pressing DOWN mid-wait must shorten the wait
000185r 2  C5 rr          cmp Tmp0                      ;   in progress, not just the next one
000187r 2  90 05          bcc @Tick
000189r 2  A5 rr          lda Tmp0
00018Br 2  8D rr rr       sta GravityTimer
00018Er 2               @Tick:
00018Er 2  CE rr rr       dec GravityTimer
000191r 2  D0 1E          bne @Done
000193r 2  20 rr rr       jsr PieceStep
000196r 2  B0 0B          bcs @Land
000198r 2  20 rr rr       jsr PieceFallRate             ; ...and C tells us whose rate the row that
00019Br 2  8D rr rr       sta GravityTimer              ;   just fell used. STA leaves it alone.
00019Er 2  B0 11          bcs @Done
0001A0r 2  4C rr rr       jmp ScoreSoftDrop             ; SPEC 9.6 — one point, one row
0001A3r 2               
0001A3r 2               @Land:
0001A3r 2  AE rr rr       ldx Region
0001A6r 2  BD rr rr       lda LockDelay,x
0001A9r 2  8D rr rr       sta LockTimer
0001ACr 2  A9 01          lda #PLAY_LOCKING
0001AEr 2  8D rr rr       sta PlayState
0001B1r 2               @Done:
0001B1r 2  60             rts
0001B2r 2               
0001B2r 2               ; -----------------------------------------------------------------------------
0001B2r 2               ;   PlayLocking — the lock delay, and the moves that may reset it
0001B2r 2               ;   SPEC 5.6 — a horizontal move resets the delay LOCK_RESET_MAX times; after
0001B2r 2               ;   that it runs out regardless. Rotation never resets it. A move that opens a
0001B2r 2               ;   gap underneath resumes falling, and the reset count carries.
0001B2r 2               ; -----------------------------------------------------------------------------
0001B2r 2               PlayLocking:
0001B2r 2  20 rr rr       jsr PieceControl
0001B5r 2  90 13          bcc @Settled
0001B7r 2  AD rr rr       lda LockResets
0001BAr 2  C9 04          cmp #LOCK_RESET_MAX
0001BCr 2  B0 0C          bcs @Settled
0001BEr 2  EE rr rr       inc LockResets
0001C1r 2  AE rr rr       ldx Region
0001C4r 2  BD rr rr       lda LockDelay,x
0001C7r 2  8D rr rr       sta LockTimer
0001CAr 2               
0001CAr 2               @Settled:
0001CAr 2  20 rr rr       jsr PieceCanFall
0001CDr 2  90 0C          bcc @Tick
0001CFr 2  A9 00          lda #PLAY_FALLING             ; It moved over a hole — fall again. SPEC 5.6
0001D1r 2  8D rr rr       sta PlayState                 ;   says the lock counter clears here and the
0001D4r 2                                               ;   reset count does not; nothing reads
0001D4r 2                                               ;   LockTimer while falling and the next
0001D4r 2                                               ;   landing loads it fresh, so it is already
0001D4r 2                                               ;   clear in every sense that matters.
0001D4r 2  20 rr rr       jsr PieceFallRate
0001D7r 2  8D rr rr       sta GravityTimer
0001DAr 2  60             rts
0001DBr 2               
0001DBr 2               @Tick:
0001DBr 2  CE rr rr       dec LockTimer
0001DEr 2  D0 09          bne @Done
0001E0r 2  20 rr rr       jsr PieceLock
0001E3r 2  20 rr rr       jsr CascadeBegin              ; SPEC 8 — the cascade starts the moment the
0001E6r 2  4C rr rr       jmp CascadeEnter              ;   piece is board, and runs as sub-states
0001E9r 2               @Done:
0001E9r 2  60             rts
0001EAr 2               
0001EAr 2               ; -----------------------------------------------------------------------------
0001EAr 2               ;   CascadeEnter — run one cascade step and choose the sub-state after it
0001EAr 2               ;   In:  ChainStep set        Out: PlayState set.  Modifies: A, X, Y
0001EAr 2               ;   SPEC 8, D4. Called from the lock, and again from the bottom of every fall.
0001EAr 2               ;
0001EAr 2               ;   A step that marks something hands over to PLAY_GLOW, and the removal and
0001EAr 2               ;   the fall follow it twelve frames later; a step that finds nothing is where
0001EAr 2               ;   the cascade settles and the next piece is queued.
0001EAr 2               ;
0001EAr 2               ;   Nothing has come off the board when CascadeScan returns — that is the whole
0001EAr 2               ;   point of the split (cascade.asm). CascadeFinish does the taking, at the far
0001EAr 2               ;   end of PLAY_SHATTER.
0001EAr 2               ; -----------------------------------------------------------------------------
0001EAr 2               CascadeEnter:
0001EAr 2  20 rr rr       jsr CascadeScan
0001EDr 2  90 08          bcc @Settle
0001EFr 2  A9 04          lda #SFX_MATCH                ; SPEC 16 effect 4, and the chime is pitched by
0001F1r 2  20 rr rr       jsr SfxPlay                   ;   ChainStep when AudioTick starts it. A
0001F4r 2                                               ;   reagent that fired inside the scan has
0001F4r 2                                               ;   already asked for a louder sound and keeps
0001F4r 2                                               ;   the channel (audio.asm)
0001F4r 2  4C rr rr       jmp AnimGlowBegin             ; SPEC 8 step 5
0001F7r 2               
0001F7r 2               @Settle:
0001F7r 2  20 rr rr       jsr CascadeSettle             ; The star multiplier and the bank (SPEC 8
0001FAr 2                                               ;   SETTLE)
0001FAr 2  AD rr rr       lda ChainStep                 ; SPEC 8 SETTLE, SPEC 14 — a chain of two links
0001FDr 2  38             sec                           ;   or more is worth saying out loud. ChainStep
0001FEr 2  E9 01          sbc #1                        ;   counts the step that found nothing as well,
000200r 2  C9 02          cmp #2                        ;   so the links are one fewer
000202r 2  90 03          bcc @Are
000204r 2  20 rr rr       jsr AnimBannerChain
000207r 2               
000207r 2               @Are:
000207r 2  AE rr rr       ldx Region
00020Ar 2  BD rr rr       lda AreDelay,x
00020Dr 2  8D rr rr       sta AreTimer
000210r 2  A9 05          lda #PLAY_ARE
000212r 2  8D rr rr       sta PlayState
000215r 2  60             rts
000216r 2               
000216r 2               ; -----------------------------------------------------------------------------
000216r 2               ;   PlayGlow — hold the glow, the beams and the fireball's flash (SPEC 14)
000216r 2               ;   The window is one timer however many things are showing inside it: they all
000216r 2               ;   start together and the longest decides how long it lasts (anim.asm).
000216r 2               ; -----------------------------------------------------------------------------
000216r 2               PlayGlow:
000216r 2  CE rr rr       dec AnimTimer
000219r 2  D0 03          bne @Done
00021Br 2  4C rr rr       jmp AnimGlowEnd               ; ...which starts the shatter
00021Er 2               @Done:
00021Er 2  60             rts
00021Fr 2               
00021Fr 2               ; -----------------------------------------------------------------------------
00021Fr 2               ;   PlayShatter — the removal ring, VFX_FRAMES a tile (SPEC 14)
00021Fr 2               ;   The board is finally emptied at the end of this, not at the start of it:
00021Fr 2               ;   every frame up to here has been drawing over cells that still hold their
00021Fr 2               ;   own tiles (cascade.asm).
00021Fr 2               ; -----------------------------------------------------------------------------
00021Fr 2               PlayShatter:
00021Fr 2  CE rr rr       dec AnimTimer
000222r 2  D0 20          bne @Done
000224r 2  EE rr rr       inc AnimStep
000227r 2  AD rr rr       lda AnimStep
00022Ar 2  CD rr rr       cmp AnimSteps
00022Dr 2  B0 0A          bcs @Over
00022Fr 2  A9 02          lda #VFX_FRAMES
000231r 2  8D rr rr       sta AnimTimer
000234r 2  A9 03          lda #ANIM_SHATTER
000236r 2  4C rr rr       jmp AnimMarked
000239r 2               
000239r 2               @Over:
000239r 2  20 rr rr       jsr CascadeFinish             ; SPEC 8 steps 6 and 7
00023Cr 2  20 rr rr       jsr BoardGravityBegin         ; ...and let what was above it fall
00023Fr 2  A9 04          lda #PLAY_GRAVITY
000241r 2  8D rr rr       sta PlayState
000244r 2               @Done:
000244r 2  60             rts
000245r 2               
000245r 2               ; -----------------------------------------------------------------------------
000245r 2               ;   PlayGravity — the pile falls into the holes the clear left
000245r 2               ;   SPEC 8 step 8, SPEC 14 — a row every FALL_FRAMES, and when a row moves
000245r 2               ;   nothing the board has settled and the next step scans it.
000245r 2               ;
000245r 2               ;   The row itself may take more than one frame: BoardGravityStep is a cursor
000245r 2               ;   that stops when the dirty ring is full (board.asm). The beat only starts
000245r 2               ;   once the row has actually landed, so a heavy board falls a little slower
000245r 2               ;   rather than losing cells off the screen.
000245r 2               ; -----------------------------------------------------------------------------
000245r 2               PlayGravity:
000245r 2  A5 rr          lda GravIdx
000247r 2  10 0C          bpl @Working                  ; A row is still coming down
000249r 2               
000249r 2  CE rr rr       dec AnimTimer
00024Cr 2  D0 11          bne @Done
00024Er 2  A5 rr          lda GravMoved
000250r 2  F0 0E          beq @Landed                   ; The last row moved nothing: everything is
000252r 2  20 rr rr       jsr BoardGravityBegin         ;   resting on something
000255r 2               
000255r 2               @Working:
000255r 2  20 rr rr       jsr BoardGravityStep
000258r 2  90 05          bcc @Done                     ; The ring filled — the rest waits for a flush
00025Ar 2  A9 02          lda #FALL_FRAMES              ; The row is down; hold it there for the beat
00025Cr 2  8D rr rr       sta AnimTimer
00025Fr 2               @Done:
00025Fr 2  60             rts
000260r 2               
000260r 2               @Landed:
000260r 2  EE rr rr       inc ChainStep                 ; SPEC 8 step 9
000263r 2  4C rr rr       jmp CascadeEnter
000266r 2               
000266r 2               ; -----------------------------------------------------------------------------
000266r 2               ;   PlayAre — the entry delay, then the next piece
000266r 2               ;   SPEC 5.6, 13.4 — a blocked spawn is game over.
000266r 2               ; -----------------------------------------------------------------------------
000266r 2               PlayAre:
000266r 2  CE rr rr       dec AreTimer
000269r 2  D0 10          bne @Done
00026Br 2  20 rr rr       jsr PieceSpawn
00026Er 2  B0 0C          bcs @Over
000270r 2  20 rr rr       jsr PieceGenerateNext
000273r 2  20 rr rr       jsr RenderNext
000276r 2  A9 00          lda #PLAY_FALLING
000278r 2  8D rr rr       sta PlayState
00027Br 2               @Done:
00027Br 2  60             rts
00027Cr 2               
00027Cr 2               @Over:
00027Cr 2  A9 0C          lda #SFX_GAMEOVER
00027Er 2  20 rr rr       jsr SfxPlay
000281r 2  20 rr rr       jsr AnimPetrifyBegin          ; The well turns to stone from the floor up
000284r 2  A9 00          lda #0                        ;   while StateGameOver holds the input off
000286r 2  8D rr rr       sta OverSecs                  ; The screen proper has not started yet — the
000289r 2                                               ;   petrify runs first (SPEC 13.4 step 2)
000289r 2  A9 03          lda #STATE_GAMEOVER
00028Br 2  8D rr rr       sta GameState
00028Er 2  60             rts
00028Fr 2               
00028Fr 2               ; -----------------------------------------------------------------------------
00028Fr 2               ;   StatePause
00028Fr 2               ; -----------------------------------------------------------------------------
00028Fr 2               StatePause:
00028Fr 2  AD rr rr       lda InputEdge
000292r 2  29 30          and #(INPUT_PAUSE | INPUT_FIRE)
000294r 2  F0 17          beq @Done
000296r 2  A9 01          lda #STATE_PLAY
000298r 2  8D rr rr       sta GameState
00029Br 2  20 rr rr       jsr TextBannerClear           ; The banner comes down...
00029Er 2  20 rr rr       jsr RenderBoard               ; ...the board goes back up...
0002A1r 2  AD rr rr       lda PlayState                 ;   ...and the piece on top of it, once the
0002A4r 2  C9 02          cmp #PLAY_GLOW                ;   redraw has gone by (D14) — but only while
0002A6r 2  B0 05          bcs @Done                     ;   there IS one. From GLOW on up the piece is
0002A8r 2  A9 01          lda #1                        ;   in the board and PieceA-C are stale; the
0002AAr 2  8D rr rr       sta PieceDirty                ;   cascade may have taken those cells away
0002ADr 2               @Done:                          ;   entirely.
0002ADr 2  60             rts
0002AEr 2               
0002AEr 2               ; -----------------------------------------------------------------------------
0002AEr 2               ;   StateGameOver — petrify, banner, fanfare, back to the title
0002AEr 2               ;   SPEC 13.4, in its own order: the well sets to stone, THEN the band says so,
0002AEr 2               ;   and only then does the screen start counting itself out.
0002AEr 2               ;
0002AEr 2               ;   OverSecs is the phase as well as the count. It is zero for the length of
0002AEr 2               ;   the petrify and never zero afterwards, because the frame it would reach
0002AEr 2               ;   zero is the frame this state ends — so the one-shot in the middle needs no
0002AEr 2               ;   flag of its own.
0002AEr 2               ;
0002AEr 2               ;   Nothing here ticks the banner down (AnimBannerTick is StatePlay's), which
0002AEr 2               ;   is what leaves GAME OVER up for the whole ten seconds rather than the 45
0002AEr 2               ;   frames every other banner gets. GameStart clears the band on the way out.
0002AEr 2               ; -----------------------------------------------------------------------------
0002AEr 2               StateGameOver:
0002AEr 2  20 rr rr       jsr AnimPetrifyTick           ; SPEC 13.4 step 2, a row every PETRIFY_FRAMES
0002B1r 2  B0 56          bcs @Done                     ; Still setting. A press during the petrify is
0002B3r 2                                               ;   ignored rather than queued: the animation
0002B3r 2                                               ;   is the game telling the player it is over
0002B3r 2                                               ;   and skipping it reads as a dropped input.
0002B3r 2  AD rr rr       lda OverSecs
0002B6r 2  D0 2A          bne @Waiting
0002B8r 2               
0002B8r 2  20 rr rr       jsr AnimBannerOver            ; SPEC 13.4 step 3
0002BBr 2  AD rr rr       lda HighOwned                 ; Step 4 — the fanfare and the flash, but only
0002BEr 2  F0 13          beq @Start                    ;   if THIS game took the record. HighOwned is
0002C0r 2                                               ;   what says so, and ScoreReset clears it for
0002C0r 2                                               ;   the next one (score.asm, SPEC 9.8)
0002C0r 2  A9 0B          lda #SFX_HIGHSCORE
0002C2r 2  20 rr rr       jsr SfxPlay
0002C5r 2  A9 06          lda #HIGH_FLASH_BLINKS
0002C7r 2  8D rr rr       sta HighFlash
0002CAr 2  AE rr rr       ldx Region
0002CDr 2  BD rr rr       lda BlinkHalf,x
0002D0r 2  8D rr rr       sta HighTimer
0002D3r 2               @Start:
0002D3r 2  A9 0A          lda #GAMEOVER_SECS
0002D5r 2  8D rr rr       sta OverSecs
0002D8r 2  AE rr rr       ldx Region
0002DBr 2  BD rr rr       lda SecondFrames,x
0002DEr 2  8D rr rr       sta OverTimer
0002E1r 2  60             rts
0002E2r 2               
0002E2r 2               @Waiting:
0002E2r 2  20 rr rr       jsr ScoreFlashTick            ; The HIGH field blinks here for the same
0002E5r 2                                               ;   reason it does in play — nothing else is
0002E5r 2                                               ;   calling it now that StatePlay has stopped
0002E5r 2  CE rr rr       dec OverTimer
0002E8r 2  D0 0E          bne @Input
0002EAr 2  AE rr rr       ldx Region
0002EDr 2  BD rr rr       lda SecondFrames,x
0002F0r 2  8D rr rr       sta OverTimer
0002F3r 2  CE rr rr       dec OverSecs
0002F6r 2  F0 07          beq @ToTitle                  ; SPEC 13.4 step 5 — ten seconds, unattended
0002F8r 2               @Input:
0002F8r 2  AD rr rr       lda InputEdge
0002FBr 2  29 11          and #(INPUT_FIRE | INPUT_UP)  ; Fire, or SPACE (D15)
0002FDr 2  F0 0A          beq @Done
0002FFr 2               @ToTitle:
0002FFr 2  A9 00          lda #STATE_TITLE
000301r 2  8D rr rr       sta GameState
000304r 2  A9 01          lda #1
000306r 2  8D rr rr       sta NeedsRedraw
000309r 2               @Done:
000309r 2  60             rts
00030Ar 2               
00030Ar 2               ; =============================================================================
00030Ar 2               ;   Static screen drawing
00030Ar 2               ; =============================================================================
00030Ar 2               ;   The whole static layout — panel frame, labels, and the margin artwork that
00030Ar 2               ;   fills the screen either side of it — comes out of the editors as one
00030Ar 2               ;   name-table image per platform. Code only ever draws over the top of it:
00030Ar 2               ;   the well, the score and level digits, the preview, and the message band.
00030Ar 2               ;
00030Ar 2               ;   All six images are real. They come out of artwork/WizardsLab.tms9918 —
00030Ar 2               ;   the master — by way of `make artwork`. See data/README.md.
00030Ar 2               ; =============================================================================
00030Ar 2               
00030Ar 2               DrawTitleScreen:
00030Ar 2  A9 rr          lda #<TitleScreen
00030Cr 2  85 rr          sta SrcPtr
00030Er 2  A9 rr          lda #>TitleScreen
000310r 2  85 rr          sta SrcPtr+1
000312r 2  A9 rr          lda #<TitleColor
000314r 2  85 rr          sta Ptr1
000316r 2  A9 rr          lda #>TitleColor
000318r 2  85 rr          sta Ptr1+1
00031Ar 2  4C rr rr       jmp HalBlitScreen
00031Dr 2               
00031Dr 2               DrawPlayScreen:
00031Dr 2  A9 rr          lda #<PlayScreen
00031Fr 2  85 rr          sta SrcPtr
000321r 2  A9 rr          lda #>PlayScreen
000323r 2  85 rr          sta SrcPtr+1
000325r 2  A9 rr          lda #<PlayColor
000327r 2  85 rr          sta Ptr1
000329r 2  A9 rr          lda #>PlayColor
00032Br 2  85 rr          sta Ptr1+1
00032Dr 2  4C rr rr       jmp HalBlitScreen
000330r 2               
000330r 1               .include "../src/rng.asm"
000330r 2               ; =============================================================================
000330r 2               ;   rng.asm — Wizards Lab, random numbers
000330r 2               ; =============================================================================
000330r 2               ;   A 16-bit Galois LFSR with the conventional $B400 taps, which is maximal
000330r 2               ;   length: it visits all 65535 non-zero states before repeating. Eight shifts
000330r 2               ;   per call, one whole byte out.
000330r 2               ;
000330r 2               ;   Seeding matters more than the generator does. A fixed seed would deal the
000330r 2               ;   same first three pieces every session and the game would feel dead, so the
000330r 2               ;   seed is taken from the free-running frame counter at the moment the player
000330r 2               ;   presses fire on the title screen — human reaction time is the entropy.
000330r 2               ;
000330r 2               ;   SPEC.md section 15.
000330r 2               ; =============================================================================
000330r 2               
000330r 2               ; -----------------------------------------------------------------------------
000330r 2               ;   RngSeed — seed from the frame counter
000330r 2               ;   In:  nothing (reads FrameCounter)
000330r 2               ;   Out: nothing.  Modifies: A
000330r 2               ; -----------------------------------------------------------------------------
000330r 2               RngSeed:
000330r 2  AD rr rr       lda FrameCounter
000333r 2  09 01          ora #$01                      ; Never let the state reach zero — it sticks
000335r 2  85 rr          sta RngLo
000337r 2  49 5A          eor #$5A                      ; Spread one byte of entropy over both halves
000339r 2  85 rr          sta RngHi
00033Br 2  60             rts
00033Cr 2               
00033Cr 2               ; -----------------------------------------------------------------------------
00033Cr 2               ;   RngNext — next pseudo-random byte
00033Cr 2               ;   In:  nothing
00033Cr 2               ;   Out: A = random 0-255.  Modifies: A, X, flags
00033Cr 2               ; -----------------------------------------------------------------------------
00033Cr 2               RngNext:
00033Cr 2  A2 08          ldx #8                        ; Eight shifts give one whole output byte
00033Er 2               @Bit:
00033Er 2  46 rr          lsr RngHi                     ; Shift the 16-bit state right one place,
000340r 2  66 rr          ror RngLo                     ;   the bit falling out of bit 0 lands in C
000342r 2  90 06          bcc @NoTap
000344r 2  A5 rr          lda RngHi
000346r 2  49 B4          eor #$B4                      ; Galois feedback mask $B400
000348r 2  85 rr          sta RngHi
00034Ar 2               @NoTap:
00034Ar 2  CA             dex
00034Br 2  D0 F1          bne @Bit
00034Dr 2  A5 rr          lda RngLo
00034Fr 2  60             rts
000350r 2               
000350r 2               ; -----------------------------------------------------------------------------
000350r 2               ;   RngRange — a random number below a small limit
000350r 2               ;   In:  A = limit, 1-128
000350r 2               ;   Out: A = 0 .. limit-1.  Modifies: A, X, Tmp0, Tmp1.  PRESERVES Y.
000350r 2               ;
000350r 2               ;   Not a modulo. `random % 6` throws four of the 256 outcomes into the low
000350r 2               ;   values and leaves colours 0-3 a shade likelier than 4-5; this takes the
000350r 2               ;   HIGH byte of (random * limit) instead, which spreads the remainder evenly
000350r 2               ;   across the range and costs a fixed eight shifts either way.
000350r 2               ;
000350r 2               ;   The eight-bit multiply keeps only the high byte: the low half falls out of
000350r 2               ;   the accumulator one bit at a time and is never wanted.
000350r 2               ;
000350r 2               ;   Y is preserved so a caller can loop over the three cells of a piece with
000350r 2               ;   it (piece.asm does).
000350r 2               ; -----------------------------------------------------------------------------
000350r 2               RngRange:
000350r 2  48             pha                           ; The limit — RngNext wants A
000351r 2  20 rr rr       jsr RngNext
000354r 2  85 rr          sta Tmp0                      ; The random byte
000356r 2  68             pla
000357r 2  85 rr          sta Tmp1                      ; The limit, shifted out one bit at a time
000359r 2  A9 00          lda #0
00035Br 2  A2 08          ldx #8
00035Dr 2               @Bit:
00035Dr 2  46 rr          lsr Tmp1                      ; Next multiplier bit into C
00035Fr 2  90 03          bcc @NoAdd
000361r 2  18             clc
000362r 2  65 rr          adc Tmp0                      ; Partial product, carry out into C
000364r 2               @NoAdd:
000364r 2  6A             ror a                         ; Shift the accumulator down, carry in at bit 7
000365r 2  CA             dex
000366r 2  D0 F5          bne @Bit
000368r 2  60             rts
000369r 2               
000369r 1               .include "../src/input.asm"
000369r 2               ; =============================================================================
000369r 2               ;   input.asm — Wizards Lab, input conditioning
000369r 2               ; =============================================================================
000369r 2               ;   SPEC.md section 11. HalReadInput hands back one active-high mask however
000369r 2               ;   the platform likes; everything above this line works on that mask and
000369r 2               ;   never touches hardware.
000369r 2               ;
000369r 2               ;   Auto-repeat applies to LEFT and RIGHT only. Rotate does NOT repeat — up
000369r 2               ;   must be released and pressed again. That is not a preference: a repeating
000369r 2               ;   rotate makes a three-cell Columns piece impossible to aim.
000369r 2               ; =============================================================================
000369r 2               
000369r 2               ; -----------------------------------------------------------------------------
000369r 2               ;   InputPoll — read the hardware and work out what is newly pressed
000369r 2               ;   In:  nothing
000369r 2               ;   Out: InputNow, InputPrev, InputEdge updated.  Modifies: A
000369r 2               ; -----------------------------------------------------------------------------
000369r 2               InputPoll:
000369r 2  AD rr rr       lda InputNow
00036Cr 2  8D rr rr       sta InputPrev
00036Fr 2  20 rr rr       jsr HalReadInput
000372r 2  8D rr rr       sta InputNow
000375r 2  4D rr rr       eor InputPrev                 ; Bits that changed
000378r 2  2D rr rr       and InputNow                  ; ...and are now down = newly pressed
00037Br 2  8D rr rr       sta InputEdge
00037Er 2  60             rts
00037Fr 2               
00037Fr 2               ; -----------------------------------------------------------------------------
00037Fr 2               ;   InputShift — LEFT/RIGHT with delayed auto shift
00037Fr 2               ;   Out: A = INPUT_LEFT, INPUT_RIGHT, or 0 if no move should happen this frame.
00037Fr 2               ;        Modifies: A, X
00037Fr 2               ;   SPEC 11.3 — initial delay 12 frames NTSC / 10 PAL, then 4 / 3.
00037Fr 2               ;
00037Fr 2               ;   A fresh press fires on the same frame it arrives; the delay is what comes
00037Fr 2               ;   after it, not before it, so a tap is always exactly one column.
00037Fr 2               ;
00037Fr 2               ;   Holding both directions at once is not something a stick can do, but two
00037Fr 2               ;   keys can. LEFT wins, and it wins consistently, so the piece sits still
00037Fr 2               ;   rather than shivering between the two.
00037Fr 2               ; -----------------------------------------------------------------------------
00037Fr 2               InputShift:
00037Fr 2  AD rr rr       lda InputNow
000382r 2  29 04          and #INPUT_LEFT
000384r 2  D0 07          bne @Dir
000386r 2  AD rr rr       lda InputNow
000389r 2  29 08          and #INPUT_RIGHT
00038Br 2  F0 2A          beq @None
00038Dr 2               
00038Dr 2               @Dir:
00038Dr 2  CD rr rr       cmp DasDir
000390r 2  F0 10          beq @Held
000392r 2               
000392r 2  8D rr rr       sta DasDir                    ; A new direction: fire now, then wait
000395r 2  AE rr rr       ldx Region
000398r 2  BD rr rr       lda DasInitial,x
00039Br 2  8D rr rr       sta DasTimer
00039Er 2  AD rr rr       lda DasDir
0003A1r 2  60             rts
0003A2r 2               
0003A2r 2               @Held:
0003A2r 2  CE rr rr       dec DasTimer                  ; Always loaded non-zero, so this cannot wrap
0003A5r 2  D0 0D          bne @Wait
0003A7r 2  AE rr rr       ldx Region
0003AAr 2  BD rr rr       lda DasRepeat,x
0003ADr 2  8D rr rr       sta DasTimer
0003B0r 2  AD rr rr       lda DasDir
0003B3r 2  60             rts
0003B4r 2               
0003B4r 2               @Wait:
0003B4r 2  A9 00          lda #0
0003B6r 2  60             rts
0003B7r 2               
0003B7r 2               @None:
0003B7r 2  8D rr rr       sta DasDir                    ; A is already 0 — release, so the next press
0003BAr 2  60             rts                           ;   counts as fresh
0003BBr 2               
0003BBr 1               .include "../src/board.asm"
0003BBr 2               ; =============================================================================
0003BBr 2               ;   board.asm — Wizards Lab, the playfield
0003BBr 2               ; =============================================================================
0003BBr 2               ;   SPEC.md section 3. The board is 20 rows of 8 bytes, page-aligned, with
0003BBr 2               ;   columns 6-7 and rows 16-19 held permanently at $FF. Those sentinels are
0003BBr 2               ;   what let every scan in match.asm run without a bounds check.
0003BBr 2               ;
0003BBr 2               ;   address(row, col) = Board + (row << 3) + col
0003BBr 2               ; =============================================================================
0003BBr 2               
0003BBr 2               ; -----------------------------------------------------------------------------
0003BBr 2               ;   BoardClear — empty the playfield and lay the sentinels back down
0003BBr 2               ;   In:  nothing        Out: nothing.  Modifies: A, X
0003BBr 2               ;
0003BBr 2               ;   Walls first over the whole 160 bytes, then the six playfield columns of
0003BBr 2               ;   the sixteen playfield rows punched back out to empty. Doing it in that
0003BBr 2               ;   order means the sentinels can never be forgotten: everything that is not
0003BBr 2               ;   explicitly playfield is a wall.
0003BBr 2               ;
0003BBr 2               ;   The wall loop counts UP and ends on a CPX. Counting down from 159 to a BPL
0003BBr 2               ;   looks tidier and is wrong: 159 is $9F, bit 7 already set, so the branch
0003BBr 2               ;   falls through after the first store and the other 159 bytes keep whatever
0003BBr 2               ;   the machine powered up with. That went unnoticed for a whole phase,
0003BBr 2               ;   because nothing read a sentinel until the falling piece needed a floor.
0003BBr 2               ; -----------------------------------------------------------------------------
0003BBr 2               BoardClear:
0003BBr 2  A9 FF          lda #TILE_WALL
0003BDr 2  A2 00          ldx #0
0003BFr 2               @Wall:
0003BFr 2  9D rr rr       sta Board,x
0003C2r 2  E8             inx
0003C3r 2  E0 A0          cpx #BOARD_BYTES
0003C5r 2  D0 F8          bne @Wall
0003C7r 2               
0003C7r 2  A2 00          ldx #0                        ; X walks the row bases, 0, 8, 16, ...
0003C9r 2               @Row:
0003C9r 2  A9 00          lda #TILE_EMPTY               ; Reloaded every row: the TXA below eats it
0003CBr 2  9D rr rr 9D    .repeat BOARD_W, COL
0003CFr 2  rr rr 9D rr  
0003D3r 2  rr 9D rr rr  
0003DDr 2                   sta Board + COL, x
0003DDr 2                 .endrepeat
0003DDr 2  8A             txa
0003DEr 2  18             clc
0003DFr 2  69 08          adc #BOARD_STRIDE
0003E1r 2  AA             tax
0003E2r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
0003E4r 2  90 E3          bcc @Row
0003E6r 2  60             rts
0003E7r 2               
0003E7r 2               ; -----------------------------------------------------------------------------
0003E7r 2               ;   BoardRowPtr — point Ptr1 at the start of a board row
0003E7r 2               ;   In:  A = row        Out: Ptr1 = &Board[row][0].  Modifies: A, Ptr1
0003E7r 2               ;
0003E7r 2               ;   Board is page-aligned and 160 bytes, so row * 8 is at most 152 and the low
0003E7r 2               ;   byte can never carry into the high one.
0003E7r 2               ; -----------------------------------------------------------------------------
0003E7r 2               BoardRowPtr:
0003E7r 2  0A             asl a
0003E8r 2  0A             asl a
0003E9r 2  0A             asl a
0003EAr 2  18             clc
0003EBr 2  69 rr          adc #<Board
0003EDr 2  85 rr          sta Ptr1
0003EFr 2  A9 rr          lda #>Board
0003F1r 2  85 rr          sta Ptr1+1
0003F3r 2  60             rts
0003F4r 2               
0003F4r 2               ; -----------------------------------------------------------------------------
0003F4r 2               ;   BoardGravityBegin / BoardGravityStep — the pile falls, one row at a time
0003F4r 2               ;   SPEC 8 step 8, SPEC 14: tiles descend one row every FALL_FRAMES.
0003F4r 2               ;
0003F4r 2               ;   A row of falling is one pass over the board, bottom to top, moving every
0003F4r 2               ;   tile that has an empty cell under it down into it. Repeat until a pass
0003F4r 2               ;   moves nothing and the columns are compacted — but repeat it a row at a
0003F4r 2               ;   time, because the fall is animated and a column that dropped four rows in
0003F4r 2               ;   one frame would read as a teleport.
0003F4r 2               ;
0003F4r 2               ;   Walking BOTTOM TO TOP is what makes a whole column fall together rather
0003F4r 2               ;   than one tile a frame: by the time the pass reaches a tile, the tile below
0003F4r 2               ;   it has already moved and left the gap.
0003F4r 2               ;
0003F4r 2               ;   The pass is a CURSOR, not a loop that runs to completion (D12, SPEC 12.6).
0003F4r 2               ;   Sixty tiles falling is a hundred-odd changed cells and the dirty ring holds
0003F4r 2               ;   64, so the pass stops when the ring is full and picks up where it stopped
0003F4r 2               ;   next frame. Nothing is dropped and the board is a legal board at every
0003F4r 2               ;   point it stops — one frame's worth of columns has fallen a row and the
0003F4r 2               ;   rest has not, which is a stagger nobody can see.
0003F4r 2               ;
0003F4r 2               ;   The two sentinel columns need no special case: a wall's "cell below" is
0003F4r 2               ;   another wall, so columns 6 and 7 never move.
0003F4r 2               ; -----------------------------------------------------------------------------
0003F4r 2               GRAV_TOP = (BOARD_H - 1) * BOARD_STRIDE - 1     ; The last cell of row 14, the
0003F4r 2                                                               ;   lowest row that can fall at
0003F4r 2                                                               ;   all. Row 15 is on the floor
0003F4r 2               BoardGravityBegin:
0003F4r 2  A9 77          lda #GRAV_TOP
0003F6r 2  85 rr          sta GravIdx
0003F8r 2  A9 00          lda #0
0003FAr 2  85 rr          sta GravMoved
0003FCr 2  60             rts
0003FDr 2               
0003FDr 2               ; -----------------------------------------------------------------------------
0003FDr 2               ;   BoardGravityStep — carry on with the current row of falling
0003FDr 2               ;   In:  nothing
0003FDr 2               ;   Out: C set when the row is finished; GravMoved non-zero if it moved
0003FDr 2               ;        anything. Modifies: A, X, Y, GravIdx, GravMoved, RedrawCol
0003FDr 2               ; -----------------------------------------------------------------------------
0003FDr 2               BoardGravityStep:
0003FDr 2  A5 rr          lda GravIdx
0003FFr 2  30 3F          bmi @Finished                 ; $FF — the row is already done
000401r 2               
000401r 2               @Cell:
000401r 2  AD rr rr       lda DirtyCount                ; Room for both cells of a move, or wait for
000404r 2  C9 3E          cmp #(DIRTY_ENTRIES - 2)      ;   the flush. A mark dropped here would never
000406r 2  B0 3A          bcs @Later                    ;   be marked again (D6 is survivable only
000408r 2                                               ;   because nothing that MUST land uses it)
000408r 2               
000408r 2  A6 rr          ldx GravIdx
00040Ar 2  BD rr rr       lda Board,x
00040Dr 2  F0 2D          beq @Next                     ; Nothing here to fall
00040Fr 2  BD rr rr       lda Board + BOARD_STRIDE,x
000412r 2  D0 28          bne @Next                     ; Something under it — a tile, or the floor
000414r 2               
000414r 2  BD rr rr       lda Board,x                   ; Move it down one row
000417r 2  9D rr rr       sta Board + BOARD_STRIDE,x
00041Ar 2  A9 00          lda #TILE_EMPTY
00041Cr 2  9D rr rr       sta Board,x
00041Fr 2  E6 rr          inc GravMoved
000421r 2               
000421r 2  A5 rr          lda GravIdx                   ; The cell it LEFT only needs redrawing if it
000423r 2  C9 08          cmp #BOARD_STRIDE             ;   is going to stay empty. If there is a tile
000425r 2  90 07          bcc @Vacated                  ;   above it, that tile lands here later in
000427r 2  A6 rr          ldx GravIdx                   ;   this same pass and its own arrival mark
000429r 2  BD rr rr       lda Board - BOARD_STRIDE,x    ;   covers the cell. Half the marks of a
00042Cr 2  D0 05          bne @Arrived                  ;   sliding column, which is what the ring
00042Er 2               @Vacated:                       ;   pressure is made of.
00042Er 2  A6 rr          ldx GravIdx
000430r 2  20 rr rr       jsr RenderCell
000433r 2               @Arrived:
000433r 2  A5 rr          lda GravIdx
000435r 2  18             clc
000436r 2  69 08          adc #BOARD_STRIDE
000438r 2  AA             tax
000439r 2  20 rr rr       jsr RenderCell
00043Cr 2               
00043Cr 2               @Next:
00043Cr 2  C6 rr          dec GravIdx                   ; Down to 0, then $FF, which ends the pass —
00043Er 2  10 C1          bpl @Cell                     ;   GRAV_TOP is 119, so bit 7 starts clear
000440r 2                                               ;   (see PLAN.md section 3)
000440r 2               @Finished:
000440r 2  38             sec
000441r 2  60             rts
000442r 2               
000442r 2               @Later:
000442r 2  18             clc                           ; Ring full: the rest of this row waits a frame
000443r 2  60             rts
000444r 2               
000444r 1               .include "../src/piece.asm"
000444r 2               ; =============================================================================
000444r 2               ;   piece.asm — Wizards Lab, the falling piece
000444r 2               ; =============================================================================
000444r 2               ;   SPEC.md section 5. A piece is three independently generated cells stacked
000444r 2               ;   vertically, A on top. At most one of the three carries a reagent, which is
000444r 2               ;   enforced by rolling once for the piece rather than once per cell.
000444r 2               ;
000444r 2               ;   The piece is NOT in the board while it falls. Board cells under it stay
000444r 2               ;   empty until PieceLock writes them, which is what makes the movement tests
000444r 2               ;   below a plain read of the three target cells and what lets the erase be
000444r 2               ;   three blanks rather than three board reads.
000444r 2               ;
000444r 2               ;   Nothing here draws. Every routine that changes where the piece is or what
000444r 2               ;   it holds sets PieceDirty and lets StatePlay pick the moment (D14).
000444r 2               ; =============================================================================
000444r 2               
000444r 2               ; -----------------------------------------------------------------------------
000444r 2               ;   PieceIndex — board index of the piece's top cell
000444r 2               ;   In:  nothing
000444r 2               ;   Out: A = X = PieceRow * BOARD_STRIDE + PieceCol.  Modifies: A, X
000444r 2               ;
000444r 2               ;   Cells B and C are one and two strides on from it, and the cell below C is
000444r 2               ;   three — which is the only address arithmetic the rest of this file needs.
000444r 2               ;   Row 16 and beyond is a wall row, so "below C" is always a legal read.
000444r 2               ; -----------------------------------------------------------------------------
000444r 2               PieceIndex:
000444r 2  AD rr rr       lda PieceRow
000447r 2  0A             asl a
000448r 2  0A             asl a
000449r 2  0A             asl a                         ; row * 8
00044Ar 2  18             clc
00044Br 2  6D rr rr       adc PieceCol
00044Er 2  AA             tax
00044Fr 2  60             rts
000450r 2               
000450r 2               ; -----------------------------------------------------------------------------
000450r 2               ;   PieceGenerateNext — roll the preview piece into NextA/NextB/NextC
000450r 2               ;   In:  nothing (reads Level)
000450r 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0, Tmp1
000450r 2               ;   SPEC 5.2, 5.3 — colours uniform over 0-5, then one reagent roll.
000450r 2               ; -----------------------------------------------------------------------------
000450r 2               PieceGenerateNext:
000450r 2  A0 00          ldy #0                        ; RngRange preserves Y, so it can index the
000452r 2               @Color:                         ;   three cells across the call
000452r 2  A9 06          lda #NUM_COLORS
000454r 2  20 rr rr       jsr RngRange                  ; 0-5, uniform (SPEC 5.2)
000457r 2  0A             asl a
000458r 2  0A             asl a
000459r 2  0A             asl a                         ; colour << 3 ...
00045Ar 2  18             clc
00045Br 2  69 40          adc #COLOR_BASE               ;   ... + base, glyph 0, so it is a potion
00045Dr 2  99 rr rr       sta NextA,y                   ; NextA/B/C are three consecutive bytes
000460r 2  C8             iny
000461r 2  C0 03          cpy #3
000463r 2  90 ED          bcc @Color
000465r 2               
000465r 2                 ; --- does this piece carry a reagent at all? (SPEC 5.3) -------------------
000465r 2                 ;   One roll for the whole piece, which both caps it at one reagent and
000465r 2                 ;   costs three rolls fewer than asking each cell.
000465r 2  20 rr rr       jsr RngNext
000468r 2  85 rr          sta Tmp0                      ; The roll. Nothing below calls out until it
00046Ar 2                                               ;   has been compared, so Tmp0 is safe.
00046Ar 2  AE rr rr       ldx Level
00046Dr 2  CA             dex                           ; LevelBand is indexed by level - 1 ...
00046Er 2  E0 10          cpx #16
000470r 2  90 02          bcc @Band
000472r 2  A2 0F          ldx #15                       ;   ... and clamped: band 4 is "13 and up"
000474r 2               @Band:
000474r 2  BD rr rr       lda LevelBand,x
000477r 2  AA             tax                           ; X = band 0-4
000478r 2  A5 rr          lda Tmp0
00047Ar 2  DD rr rr       cmp PSpecial,x                ; C clear = the roll came in under the chance
00047Dr 2  B0 2E          bcs @Done
00047Fr 2               
00047Fr 2                 ; --- which cell, and which reagent ----------------------------------------
00047Fr 2  8A             txa
000480r 2  48             pha                           ; The band, across the cell roll
000481r 2  A9 03          lda #3
000483r 2  20 rr rr       jsr RngRange                  ; 0, 1 or 2 — uniform over A, B and C
000486r 2  A8             tay                           ; Y survives the type roll below
000487r 2  68             pla
000488r 2  0A             asl a
000489r 2  0A             asl a                         ; band * 4 — ReagentThresholds is four
00048Ar 2  48             pha                           ;   thresholds per band
00048Br 2  20 rr rr       jsr RngNext
00048Er 2  85 rr          sta Tmp0                      ; The type roll
000490r 2  68             pla
000491r 2  AA             tax
000492r 2  A5 rr          lda Tmp0
000494r 2               
000494r 2  DD rr rr       cmp ReagentThresholds+0,x     ; The cumulative-weight compare chain SPEC 5.3
000497r 2  90 15          bcc @Fireball                 ;   recommends over a 1280-byte lookup
000499r 2  DD rr rr       cmp ReagentThresholds+1,x
00049Cr 2  90 14          bcc @Bolt
00049Er 2  DD rr rr       cmp ReagentThresholds+2,x
0004A1r 2  90 13          bcc @Bomb
0004A3r 2  DD rr rr       cmp ReagentThresholds+3,x
0004A6r 2  90 12          bcc @Star
0004A8r 2               
0004A8r 2  A9 70          lda #WILD_BASE                ; A Prism discards the colour it rolled and
0004AAr 2  99 rr rr       sta NextA,y                   ;   joins group 14 (SPEC 5.2)
0004ADr 2               @Done:
0004ADr 2  60             rts
0004AEr 2               
0004AEr 2               @Fireball:
0004AEr 2  A9 01          lda #GLYPH_FIREBALL
0004B0r 2  D0 0A          bne @Apply                    ; Always — every glyph below is non-zero
0004B2r 2               @Bolt:
0004B2r 2  A9 02          lda #GLYPH_BOLT
0004B4r 2  D0 06          bne @Apply
0004B6r 2               @Bomb:
0004B6r 2  A9 03          lda #GLYPH_BOMB
0004B8r 2  D0 02          bne @Apply
0004BAr 2               @Star:
0004BAr 2  A9 04          lda #GLYPH_STAR
0004BCr 2               @Apply:
0004BCr 2  19 rr rr       ora NextA,y                   ; The cell's glyph nibble is 0, so an ORA sets
0004BFr 2  99 rr rr       sta NextA,y                   ;   the reagent and keeps the rolled colour
0004C2r 2  60             rts
0004C3r 2               
0004C3r 2               ; -----------------------------------------------------------------------------
0004C3r 2               ;   PieceSpawn — promote the preview to the falling piece
0004C3r 2               ;   In:  nothing
0004C3r 2               ;   Out: C set if the spawn cells were occupied (game over)
0004C3r 2               ;        Modifies: A, X
0004C3r 2               ;   SPEC 5.4 — spawn column SPAWN_COL, rows 0-2, visible immediately.
0004C3r 2               ;
0004C3r 2               ;   The preview is copied whether or not the spawn succeeds; on a blocked
0004C3r 2               ;   spawn nothing looks at the piece again.
0004C3r 2               ; -----------------------------------------------------------------------------
0004C3r 2               PieceSpawn:
0004C3r 2  AD rr rr       lda NextA
0004C6r 2  8D rr rr       sta PieceA
0004C9r 2  AD rr rr       lda NextB
0004CCr 2  8D rr rr       sta PieceB
0004CFr 2  AD rr rr       lda NextC
0004D2r 2  8D rr rr       sta PieceC
0004D5r 2               
0004D5r 2  A9 02          lda #SPAWN_COL
0004D7r 2  8D rr rr       sta PieceCol
0004DAr 2  A9 00          lda #0
0004DCr 2  8D rr rr       sta PieceRow
0004DFr 2  8D rr rr       sta LockTimer
0004E2r 2  8D rr rr       sta LockResets                ; The reset allowance is per piece (SPEC 5.6)
0004E5r 2               
0004E5r 2  AD rr rr       lda Board + 0 * BOARD_STRIDE + SPAWN_COL
0004E8r 2  0D rr rr       ora Board + 1 * BOARD_STRIDE + SPAWN_COL
0004EBr 2  0D rr rr       ora Board + 2 * BOARD_STRIDE + SPAWN_COL
0004EEr 2  D0 0D          bne @Blocked
0004F0r 2               
0004F0r 2  20 rr rr       jsr ScoreGravity
0004F3r 2  8D rr rr       sta GravityTimer
0004F6r 2  A9 01          lda #1
0004F8r 2  8D rr rr       sta PieceDirty                ; Drawn immediately — there is no off-screen
0004FBr 2  18             clc                           ;   entry (SPEC 5.4)
0004FCr 2  60             rts
0004FDr 2               
0004FDr 2               @Blocked:
0004FDr 2  38             sec
0004FEr 2  60             rts
0004FFr 2               
0004FFr 2               ; -----------------------------------------------------------------------------
0004FFr 2               ;   PieceMoveLeft / PieceMoveRight — one column, if all three cells are free
0004FFr 2               ;   Out: C set if the move happened (the caller resets the lock timer).
0004FFr 2               ;        Modifies: A, X
0004FFr 2               ;   SPEC 5.5 — no wall kicks; a 1-wide piece has nothing to kick off.
0004FFr 2               ;
0004FFr 2               ;   The right edge needs no bounds check: column 6 is a permanent $FF sentinel
0004FFr 2               ;   and fails the emptiness test on its own (SPEC 3.2). The LEFT edge does,
0004FFr 2               ;   because column -1 of row 0 is the byte before a page-aligned Board and
0004FFr 2               ;   belongs to nobody.
0004FFr 2               ; -----------------------------------------------------------------------------
0004FFr 2               PieceMoveLeft:
0004FFr 2  AD rr rr       lda PieceCol
000502r 2  F0 18          beq @No                       ; Column 0 — there is no sentinel to the left
000504r 2  20 rr rr       jsr PieceIndex
000507r 2  CA             dex
000508r 2  BD rr rr       lda Board + 0 * BOARD_STRIDE,x
00050Br 2  1D rr rr       ora Board + 1 * BOARD_STRIDE,x
00050Er 2  1D rr rr       ora Board + 2 * BOARD_STRIDE,x
000511r 2  D0 09          bne @No
000513r 2  20 rr rr       jsr RenderPieceErase
000516r 2  CE rr rr       dec PieceCol
000519r 2  4C rr rr       jmp PieceShifted
00051Cr 2               
00051Cr 2               @No:
00051Cr 2  18             clc
00051Dr 2  60             rts
00051Er 2               
00051Er 2               PieceMoveRight:
00051Er 2  20 rr rr       jsr PieceIndex
000521r 2  E8             inx
000522r 2  BD rr rr       lda Board + 0 * BOARD_STRIDE,x
000525r 2  1D rr rr       ora Board + 1 * BOARD_STRIDE,x
000528r 2  1D rr rr       ora Board + 2 * BOARD_STRIDE,x
00052Br 2  D0 09          bne @No
00052Dr 2  20 rr rr       jsr RenderPieceErase
000530r 2  EE rr rr       inc PieceCol
000533r 2  4C rr rr       jmp PieceShifted
000536r 2               @No:
000536r 2  18             clc
000537r 2  60             rts
000538r 2               
000538r 2               ; -----------------------------------------------------------------------------
000538r 2               ;   PieceShifted — a horizontal move landed (SPEC 16 effect 1)
000538r 2               ;   Out: C set.  Modifies: A
000538r 2               ;   Separate from PieceMoved because gravity goes through THAT and a row of
000538r 2               ;   falling makes no noise: the blip belongs to the player's hand, not to the
000538r 2               ;   piece changing cells.
000538r 2               ; -----------------------------------------------------------------------------
000538r 2               PieceShifted:
000538r 2  A9 01          lda #SFX_MOVE
00053Ar 2  20 rr rr       jsr SfxPlay
00053Dr 2                 ; falls through
00053Dr 2               
00053Dr 2               ; -----------------------------------------------------------------------------
00053Dr 2               ;   PieceMoved — mark the piece for redraw and report success
00053Dr 2               ;   Out: C set.  Modifies: A
00053Dr 2               ; -----------------------------------------------------------------------------
00053Dr 2               PieceMoved:
00053Dr 2  A9 01          lda #1
00053Fr 2  8D rr rr       sta PieceDirty
000542r 2  38             sec
000543r 2  60             rts
000544r 2               
000544r 2               ; -----------------------------------------------------------------------------
000544r 2               ;   PieceRotate / PieceRotateBack — cycle the three cells
000544r 2               ;   Out: nothing.  Modifies: A, X
000544r 2               ;   SPEC 5.5 — (A,B,C) -> (B,C,A) forward, (C,A,B) back. Always succeeds: the
000544r 2               ;   footprint never changes, so there is nothing to test and nothing to erase.
000544r 2               ;   Rotation does not reset the lock delay (SPEC 5.6).
000544r 2               ; -----------------------------------------------------------------------------
000544r 2               PieceRotate:
000544r 2  AD rr rr       lda PieceA
000547r 2  AE rr rr       ldx PieceB
00054Ar 2  8E rr rr       stx PieceA
00054Dr 2  AE rr rr       ldx PieceC
000550r 2  8E rr rr       stx PieceB
000553r 2  8D rr rr       sta PieceC
000556r 2  A9 01          lda #1
000558r 2  8D rr rr       sta PieceDirty
00055Br 2  A9 02          lda #SFX_ROTATE               ; SPEC 16 effect 2 — both directions, one sound
00055Dr 2  4C rr rr       jmp SfxPlay
000560r 2               
000560r 2               PieceRotateBack:
000560r 2  AD rr rr       lda PieceC
000563r 2  AE rr rr       ldx PieceB
000566r 2  8E rr rr       stx PieceC
000569r 2  AE rr rr       ldx PieceA
00056Cr 2  8E rr rr       stx PieceB
00056Fr 2  8D rr rr       sta PieceA
000572r 2  A9 01          lda #1
000574r 2  8D rr rr       sta PieceDirty
000577r 2  A9 02          lda #SFX_ROTATE
000579r 2  4C rr rr       jmp SfxPlay
00057Cr 2               
00057Cr 2               ; -----------------------------------------------------------------------------
00057Cr 2               ;   PieceCanFall — is the cell below C free?
00057Cr 2               ;   Out: C set if the piece can descend one row.  Modifies: A, X
00057Cr 2               ;   Three strides past cell A. With C on row 15 that reads row 18, which is a
00057Cr 2               ;   permanent wall row, so the floor needs no special case (SPEC 3.2).
00057Cr 2               ; -----------------------------------------------------------------------------
00057Cr 2               PieceCanFall:
00057Cr 2  20 rr rr       jsr PieceIndex
00057Fr 2  BD rr rr       lda Board + 3 * BOARD_STRIDE,x
000582r 2  D0 02          bne @No
000584r 2  38             sec
000585r 2  60             rts
000586r 2               @No:
000586r 2  18             clc
000587r 2  60             rts
000588r 2               
000588r 2               ; -----------------------------------------------------------------------------
000588r 2               ;   PieceStep — one row of gravity
000588r 2               ;   Out: C set if the piece has landed and the lock delay should start.
000588r 2               ;        Modifies: A, X
000588r 2               ; -----------------------------------------------------------------------------
000588r 2               PieceStep:
000588r 2  20 rr rr       jsr PieceCanFall
00058Br 2  90 0B          bcc @Landed
00058Dr 2  20 rr rr       jsr RenderPieceErase
000590r 2  EE rr rr       inc PieceRow
000593r 2  20 rr rr       jsr PieceMoved
000596r 2  18             clc                           ; Moved, so it has not landed
000597r 2  60             rts
000598r 2               @Landed:
000598r 2  38             sec
000599r 2  60             rts
00059Ar 2               
00059Ar 2               ; -----------------------------------------------------------------------------
00059Ar 2               ;   PieceLock — write the three cells into the board
00059Ar 2               ;   Out: nothing.  Modifies: A, X, Y
00059Ar 2               ;   SPEC 5.6 — after this the caller runs a cascade.
00059Ar 2               ;
00059Ar 2               ;   Once the board holds the piece, drawing the piece and drawing those three
00059Ar 2               ;   board cells are the same three writes, so RenderPiece does the queueing.
00059Ar 2               ; -----------------------------------------------------------------------------
00059Ar 2               PieceLock:
00059Ar 2  20 rr rr       jsr PieceIndex
00059Dr 2  AD rr rr       lda PieceA
0005A0r 2  9D rr rr       sta Board + 0 * BOARD_STRIDE,x
0005A3r 2  AD rr rr       lda PieceB
0005A6r 2  9D rr rr       sta Board + 1 * BOARD_STRIDE,x
0005A9r 2  AD rr rr       lda PieceC
0005ACr 2  9D rr rr       sta Board + 2 * BOARD_STRIDE,x
0005AFr 2               
0005AFr 2  20 rr rr       jsr RenderPiece
0005B2r 2  A9 00          lda #0
0005B4r 2  8D rr rr       sta PieceDirty                ; It is board now; nothing owes it a redraw
0005B7r 2  A9 03          lda #SFX_LOCK                 ; SPEC 16 effect 3. A match in the same frame is
0005B9r 2  4C rr rr       jmp SfxPlay                   ;   louder and takes the channel off it
0005BCr 2                                               ;   (audio.asm)
0005BCr 2               
0005BCr 2               ; -----------------------------------------------------------------------------
0005BCr 2               ;   PieceFallRate — frames per row for this frame
0005BCr 2               ;   Out: A = frame count, C CLEAR if that rate is the soft drop's.
0005BCr 2               ;        Modifies: A, X, Tmp0
0005BCr 2               ;   SPEC 5.5, 11.3 — soft drop substitutes its own rate and is ignored when
0005BCr 2               ;   gravity is already the faster of the two (levels 14+ on NTSC).
0005BCr 2               ;
0005BCr 2               ;   The carry is what pays for the soft drop: SPEC 9.6 gives a point per row
0005BCr 2               ;   "descended under soft drop", and a row that fell at gravity's rate with
0005BCr 2               ;   DOWN held down was not one, so holding DOWN at level 16 earns nothing.
0005BCr 2               ;   Working it out here costs nothing — the comparison has already happened.
0005BCr 2               ; -----------------------------------------------------------------------------
0005BCr 2               PieceFallRate:
0005BCr 2  20 rr rr       jsr ScoreGravity              ; Speed[level] for this region
0005BFr 2  85 rr          sta Tmp0
0005C1r 2  AD rr rr       lda InputNow
0005C4r 2  29 02          and #INPUT_DOWN
0005C6r 2  F0 0A          beq @Gravity
0005C8r 2  AE rr rr       ldx Region
0005CBr 2  BD rr rr       lda SoftDropRate,x
0005CEr 2  C5 rr          cmp Tmp0                      ; C clear = soft drop is the faster
0005D0r 2  90 04          bcc @Soft
0005D2r 2               @Gravity:
0005D2r 2  A5 rr          lda Tmp0
0005D4r 2  38             sec
0005D5r 2  60             rts
0005D6r 2               @Soft:
0005D6r 2  18             clc
0005D7r 2  60             rts
0005D8r 2               
0005D8r 2               ; -----------------------------------------------------------------------------
0005D8r 2               ;   PieceControl — apply this frame's input to the piece
0005D8r 2               ;   Out: C set if a horizontal move succeeded (the caller may reset the lock
0005D8r 2               ;        delay).  Modifies: A, X, Y
0005D8r 2               ;
0005D8r 2               ;   Rotation is edge triggered and never repeats: UP has to be released and
0005D8r 2               ;   pressed again. SPEC 11.3 calls that non-negotiable and it is — a
0005D8r 2               ;   repeating rotate makes a three-cell piece impossible to aim. Left and
0005D8r 2               ;   right go through InputShift, which is where the repeat lives.
0005D8r 2               ; -----------------------------------------------------------------------------
0005D8r 2               PieceControl:
0005D8r 2  AD rr rr       lda InputEdge
0005DBr 2  29 01          and #INPUT_UP
0005DDr 2  F0 03          beq @NoRotate
0005DFr 2  20 rr rr       jsr PieceRotate
0005E2r 2               @NoRotate:
0005E2r 2  AD rr rr       lda InputEdge
0005E5r 2  29 10          and #INPUT_FIRE
0005E7r 2  F0 03          beq @NoBack
0005E9r 2  20 rr rr       jsr PieceRotateBack
0005ECr 2               @NoBack:
0005ECr 2  20 rr rr       jsr InputShift
0005EFr 2  C9 04          cmp #INPUT_LEFT
0005F1r 2  F0 06          beq @Left
0005F3r 2  C9 08          cmp #INPUT_RIGHT
0005F5r 2  F0 05          beq @Right
0005F7r 2  18             clc
0005F8r 2  60             rts
0005F9r 2               @Left:
0005F9r 2  4C rr rr       jmp PieceMoveLeft
0005FCr 2               @Right:
0005FCr 2  4C rr rr       jmp PieceMoveRight
0005FFr 2               
0005FFr 1               .include "../src/match.asm"
0005FFr 2               ; =============================================================================
0005FFr 2               ;   match.asm — Wizards Lab, the match scanner
0005FFr 2               ; =============================================================================
0005FFr 2               ;   SPEC.md section 6. Four passes — horizontal, vertical, and both diagonals —
0005FFr 2               ;   each walking its axis and tracking a run colour and length. A run of three
0005FFr 2               ;   or more sets the MARK bit for each of its cells.
0005FFr 2               ;
0005FFr 2               ;   Colour comparison is the whole trick:
0005FFr 2               ;
0005FFr 2               ;       lda cell
0005FFr 2               ;       and #COLOR_MASK         ; the low three bits are the glyph, ignore them
0005FFr 2               ;       cmp ScanColor
0005FFr 2               ;
0005FFr 2               ;   which is why a red potion, a red fireball and a red star all match. The
0005FFr 2               ;   glyph decides what happens on removal, never whether cells match.
0005FFr 2               ;
0005FFr 2               ;   Wildcards (SPEC 6.3): a WILD cell continues any run. If the run has no
0005FFr 2               ;   colour yet it stays unset and is adopted from the first non-wild cell, so
0005FFr 2               ;   one prism can close a red horizontal run and a blue vertical run at once.
0005FFr 2               ;
0005FFr 2               ;   THE FOUR PASSES ARE ONE LOOP. A line is a start cell and a step, and the
0005FFr 2               ;   step is the only thing that differs: +1 across, +8 down, +9 down-right,
0005FFr 2               ;   +7 down-left. Every one of them ends on a sentinel rather than on a bounds
0005FFr 2               ;   check, which is what the 8-byte stride was bought for (SPEC 3.2):
0005FFr 2               ;
0005FFr 2               ;     across   from column 5, +1 lands on column 6      — wall
0005FFr 2               ;     down     from row 15,   +8 lands on row 16        — wall row
0005FFr 2               ;     down-r   from column 5, +9 lands on row+1 col 6   — wall
0005FFr 2               ;     down-l   from column 0, +7 lands on THIS row's column 7 — wall
0005FFr 2               ;
0005FFr 2               ;   The last one is the reason the left edge needs no test either: the byte
0005FFr 2               ;   before column 0 belongs to the row above, and it is already a wall.
0005FFr 2               ; =============================================================================
0005FFr 2               
0005FFr 2               ; -----------------------------------------------------------------------------
0005FFr 2               ;   MatchScan — find every run on the board
0005FFr 2               ;   In:  nothing
0005FFr 2               ;   Out: Marks filled, RunCount set, Z set if nothing matched.
0005FFr 2               ;        Modifies: A, X, Y, Scan*
0005FFr 2               ; -----------------------------------------------------------------------------
0005FFr 2               MatchScan:
0005FFr 2  20 rr rr       jsr MarksClear
000602r 2  A9 00          lda #0
000604r 2  8D rr rr       sta RunCount
000607r 2               
000607r 2  20 rr rr       jsr ScanFindTop               ; Everything below skips the empty air above
00060Ar 2  A5 rr          lda ScanTop                   ;   the pile, which on most boards is most of
00060Cr 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE) ;   the board
00060Er 2  B0 0C          bcs @Done                     ; Nothing on the board at all
000610r 2               
000610r 2  20 rr rr       jsr MatchScanHorizontal
000613r 2  20 rr rr       jsr MatchScanVertical
000616r 2  20 rr rr       jsr MatchScanDiagonal
000619r 2  20 rr rr       jsr MatchScanAntiDiagonal
00061Cr 2               @Done:
00061Cr 2  AD rr rr       lda RunCount                  ; Z set when nothing matched
00061Fr 2  60             rts
000620r 2               
000620r 2               ; -----------------------------------------------------------------------------
000620r 2               ;   ScanFindTop — board index of the first row that holds anything
000620r 2               ;   Out: ScanTop = row base, or BOARD_H * BOARD_STRIDE if the board is empty.
000620r 2               ;        Modifies: A, X, ScanTop
000620r 2               ;
000620r 2               ;   Every pass below starts here instead of at row 0. A pile six rows deep is
000620r 2               ;   scanned as six rows: 178 cells against 448, and the four passes come in
000620r 2               ;   under a third of the frame instead of over two whole ones. Finding it costs
000620r 2               ;   about 45 cycles a row of empty air, which is the cheapest part of the scan.
000620r 2               ;
000620r 2               ;   Correct as well as quick, and for a reason worth writing down: a line that
000620r 2               ;   reaches the pile at all must CROSS the pile's top row, because every one of
000620r 2               ;   the four steps moves down at most one row at a time. Starting the diagonals
000620r 2               ;   on that row rather than on row 0 therefore misses nothing.
000620r 2               ; -----------------------------------------------------------------------------
000620r 2               ScanFindTop:
000620r 2  A2 00          ldx #0
000622r 2               @Row:
000622r 2  BD rr rr       lda Board + 0,x               ; The six playfield columns; the two sentinel
000625r 2  1D rr rr       ora Board + 1,x               ;   ones would make every row look occupied
000628r 2  1D rr rr       ora Board + 2,x
00062Br 2  1D rr rr       ora Board + 3,x
00062Er 2  1D rr rr       ora Board + 4,x
000631r 2  1D rr rr       ora Board + 5,x
000634r 2  D0 09          bne @Found
000636r 2  8A             txa
000637r 2  18             clc
000638r 2  69 08          adc #BOARD_STRIDE
00063Ar 2  AA             tax
00063Br 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
00063Dr 2  90 E3          bcc @Row
00063Fr 2               @Found:
00063Fr 2  86 rr          stx ScanTop
000641r 2  60             rts
000642r 2               
000642r 2               ; -----------------------------------------------------------------------------
000642r 2               ;   The four passes (SPEC 6.2). Each sets a step and hands ScanLine its start
000642r 2               ;   cells; the start cell rides the stack because ScanLine needs both index
000642r 2               ;   registers and the scratch bytes below it.
000642r 2               ; -----------------------------------------------------------------------------
000642r 2               MatchScanHorizontal:            ; Every row of the pile, column 0 rightward
000642r 2  A9 01          lda #1
000644r 2  85 rr          sta ScanStep
000646r 2  A5 rr          lda ScanTop
000648r 2               @Line:
000648r 2  48             pha
000649r 2  20 rr rr       jsr ScanLine
00064Cr 2  68             pla
00064Dr 2  18             clc
00064Er 2  69 08          adc #BOARD_STRIDE
000650r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000652r 2  90 F4          bcc @Line
000654r 2  60             rts
000655r 2               
000655r 2               MatchScanVertical:              ; 6 columns, top of the pile downward
000655r 2  A9 08          lda #BOARD_STRIDE
000657r 2  85 rr          sta ScanStep
000659r 2  4C rr rr       jmp ScanTopRow
00065Cr 2               
00065Cr 2               MatchScanDiagonal:              ; down-right: the top row, then the left edge
00065Cr 2  A9 09          lda #(BOARD_STRIDE + 1)
00065Er 2  85 rr          sta ScanStep
000660r 2  20 rr rr       jsr ScanTopRow
000663r 2  A9 00          lda #0
000665r 2  4C rr rr       jmp ScanEdgeColumn
000668r 2               
000668r 2               MatchScanAntiDiagonal:          ; down-left: the top row, then the right edge
000668r 2  A9 07          lda #(BOARD_STRIDE - 1)
00066Ar 2  85 rr          sta ScanStep
00066Cr 2  20 rr rr       jsr ScanTopRow
00066Fr 2  A9 05          lda #(BOARD_W - 1)
000671r 2  4C rr rr       jmp ScanEdgeColumn
000674r 2               
000674r 2               ; -----------------------------------------------------------------------------
000674r 2               ;   ScanTopRow — scan a line from each of the six cells of the pile's top row
000674r 2               ;   ScanEdgeColumn — and from the rows below it, in the column in A
000674r 2               ;   In:  ScanStep set, ScanTop set; A = column (ScanEdgeColumn only)
000674r 2               ;
000674r 2               ;   Between them those are every start cell a diagonal needs, and the top row
000674r 2               ;   alone is every start cell the vertical pass needs. The top row is scanned
000674r 2               ;   by the first, so the second skips it rather than scanning the longest
000674r 2               ;   diagonal twice.
000674r 2               ; -----------------------------------------------------------------------------
000674r 2               ScanTopRow:
000674r 2  A5 rr          lda ScanTop
000676r 2               @Line:
000676r 2  48             pha
000677r 2  20 rr rr       jsr ScanLine
00067Ar 2  68             pla
00067Br 2  18             clc
00067Cr 2  69 01          adc #1
00067Er 2  48             pha                           ; Six columns of that row, whichever row it
00067Fr 2  29 07          and #(BOARD_STRIDE - 1)       ;   is, so it is the COLUMN that ends the loop
000681r 2  C9 06          cmp #BOARD_W                  ;   and not the index
000683r 2  68             pla                           ; PLA leaves C alone
000684r 2  90 F0          bcc @Line
000686r 2  60             rts
000687r 2               
000687r 2               ScanEdgeColumn:
000687r 2  18             clc
000688r 2  65 rr          adc ScanTop                   ; That column, on the pile's top row...
00068Ar 2  18             clc
00068Br 2  69 08          adc #BOARD_STRIDE             ;   ...and then the row below it
00068Dr 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
00068Fr 2  B0 0C          bcs @Done                     ; The pile is one row deep — there is no below
000691r 2               @Line:
000691r 2  48             pha
000692r 2  20 rr rr       jsr ScanLine
000695r 2  68             pla
000696r 2  18             clc
000697r 2  69 08          adc #BOARD_STRIDE
000699r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
00069Br 2  90 F4          bcc @Line
00069Dr 2               @Done:
00069Dr 2  60             rts
00069Er 2               
00069Er 2               ; -----------------------------------------------------------------------------
00069Er 2               ;   ScanLine — walk one line, marking every run of MATCH_MIN or more
00069Er 2               ;   In:  A = start board index, ScanStep = direction
00069Er 2               ;   Out: nothing.  Modifies: A, X, Scan*, Marks, RunCount
00069Er 2               ;
00069Er 2               ;   ONLY A WALL ENDS THE LINE. A hole in the middle of a row breaks the run
00069Er 2               ;   and the walk carries on past it, because the cells beyond it are a run of
00069Er 2               ;   their own — a line that stopped at the first empty cell would never look
00069Er 2               ;   below the top of the pile at all, which is very nearly the whole board.
00069Er 2               ;
00069Er 2               ;   A colour change ends the run and starts a new one at the cell that broke
00069Er 2               ;   it — the cell that broke a red run is the first cell of the blue one, and
00069Er 2               ;   any prisms that were riding the red run stay with the red run. SPEC 6.3
00069Er 2               ;   gives a wildcard to the run it is already in, not to both.
00069Er 2               ; -----------------------------------------------------------------------------
00069Er 2               ScanLine:
00069Er 2  AA             tax                           ; The cursor lives in X for the whole line:
00069Fr 2  A9 FF          lda #$FF                      ;   this loop runs about four hundred times a
0006A1r 2  85 rr          sta ScanColor                 ;   scan and every cycle in it is four hundred
0006A3r 2  A9 00          lda #0                        ;   cycles of the frame
0006A5r 2  85 rr          sta ScanLen
0006A7r 2               
0006A7r 2               @Cell:
0006A7r 2  BD rr rr       lda Board,x
0006AAr 2  F0 41          beq @Gap                      ; A hole breaks the run, not the line
0006ACr 2  C9 FF          cmp #TILE_WALL
0006AEr 2  F0 52          beq @End                      ; A wall is where the line stops
0006B0r 2  29 F8          and #COLOR_MASK               ; The colour key, glyph discarded (SPEC 4.2)
0006B2r 2  C5 rr          cmp ScanColor
0006B4r 2  F0 19          beq @Grow                     ; Same colour — the commonest case, first
0006B6r 2  C9 70          cmp #WILD_BASE
0006B8r 2  F0 15          beq @Grow                     ; A prism continues any run (SPEC 6.3)
0006BAr 2               
0006BAr 2  A8             tay                           ; A different colour. Park it: everything
0006BBr 2  A5 rr          lda ScanColor                 ;   below either adopts it or starts a run
0006BDr 2  30 0E          bmi @Adopt                    ;   with it. $FF is the only value here with
0006BFr 2                                               ;   bit 7 set — colours are $40 to $70
0006BFr 2  A5 rr          lda ScanLen
0006C1r 2  C9 03          cmp #MATCH_MIN
0006C3r 2  B0 14          bcs @Close                    ; The run it broke was long enough to mark
0006C5r 2               
0006C5r 2  84 rr          sty ScanColor                 ; It was not, so no call and no marking: this
0006C7r 2  A9 01          lda #1                        ;   cell is simply the start of the next run.
0006C9r 2  85 rr          sta ScanLen                   ;   Five adjacent cells in six differ in
0006CBr 2  D0 04          bne @Advance                  ;   colour, so this is the path that decides
0006CDr 2                                               ;   what a scan costs
0006CDr 2               @Adopt:
0006CDr 2  84 rr          sty ScanColor
0006CFr 2               @Grow:
0006CFr 2  E6 rr          inc ScanLen
0006D1r 2               @Advance:
0006D1r 2  8A             txa
0006D2r 2  18             clc
0006D3r 2  65 rr          adc ScanStep
0006D5r 2  AA             tax
0006D6r 2  4C rr rr       jmp @Cell
0006D9r 2               
0006D9r 2               @Close:
0006D9r 2  86 rr          stx ScanIdx
0006DBr 2  20 rr rr       jsr MatchEmit                 ; Mark it — and MatchEmit leaves ScanLen zero
0006DEr 2  A6 rr          ldx ScanIdx
0006E0r 2  BD rr rr       lda Board,x
0006E3r 2  29 F8          and #COLOR_MASK
0006E5r 2  85 rr          sta ScanColor
0006E7r 2  A9 01          lda #1
0006E9r 2  85 rr          sta ScanLen
0006EBr 2  D0 E4          bne @Advance                  ; Always
0006EDr 2               
0006EDr 2               @Gap:
0006EDr 2  A5 rr          lda ScanLen
0006EFr 2  F0 E0          beq @Advance                  ; Nothing running — step over the hole. This
0006F1r 2                                               ;   is the cell the scan meets most often, so
0006F1r 2                                               ;   it is the one that must not call anything
0006F1r 2  86 rr          stx ScanIdx
0006F3r 2  20 rr rr       jsr MatchEmit                 ; Close the run the hole broke...
0006F6r 2  A6 rr          ldx ScanIdx
0006F8r 2  A9 FF          lda #$FF
0006FAr 2  85 rr          sta ScanColor                 ;   ...and start again on the far side of it
0006FCr 2  A9 00          lda #0
0006FEr 2  85 rr          sta ScanLen
000700r 2  F0 CF          beq @Advance                  ; Always
000702r 2               
000702r 2               @End:
000702r 2  A5 rr          lda ScanLen
000704r 2  F0 05          beq @Nothing                  ; The line ran out with nothing in hand
000706r 2  86 rr          stx ScanIdx
000708r 2  4C rr rr       jmp MatchEmit                 ; Whatever was running ends with the line
00070Br 2               @Nothing:
00070Br 2  60             rts
00070Cr 2               
00070Cr 2               ; -----------------------------------------------------------------------------
00070Cr 2               ;   MatchEmit — a run has ended; mark it if it was long enough
00070Cr 2               ;   In:  ScanIdx = one cell PAST the run's last, ScanLen, ScanColor, ScanStep
00070Cr 2               ;   Out: nothing.  Modifies: A, X, Y, ScanEnd, ScanLen, RunCount, Marks
00070Cr 2               ;
00070Cr 2               ;   Runs are marked, not removed: a cell can be in a horizontal run and a
00070Cr 2               ;   vertical one at once, and it clears once while both runs score (SPEC 6.1).
00070Cr 2               ;   The union is what the MARKS bitmap is for.
00070Cr 2               ;
00070Cr 2               ;   SCORING HAPPENS HERE, before the mark loop and for the same reason the
00070Cr 2               ;   comment above used to promise it would: ScanLen still describes the run at
00070Cr 2               ;   this point and nowhere else, because the mark loop counts it down to zero
00070Cr 2               ;   on its way back along the line. MatchScoreRun leaves it alone.
00070Cr 2               ; -----------------------------------------------------------------------------
00070Cr 2               MatchEmit:
00070Cr 2  A5 rr          lda ScanLen
00070Er 2  C9 03          cmp #MATCH_MIN
000710r 2  90 1D          bcc @Done                     ; Two in a row is not a run
000712r 2               
000712r 2  EE rr rr       inc RunCount
000715r 2  20 rr rr       jsr MatchScoreRun             ; SPEC 8 step 2, per run
000718r 2  A5 rr          lda ScanIdx
00071Ar 2  38             sec
00071Br 2  E5 rr          sbc ScanStep                  ; Back onto the run's last cell
00071Dr 2  85 rr          sta ScanEnd
00071Fr 2               @Mark:
00071Fr 2  A5 rr          lda ScanEnd
000721r 2  20 rr rr       jsr MarkSet
000724r 2  A5 rr          lda ScanEnd
000726r 2  38             sec
000727r 2  E5 rr          sbc ScanStep
000729r 2  85 rr          sta ScanEnd
00072Br 2  C6 rr          dec ScanLen
00072Dr 2  D0 F0          bne @Mark
00072Fr 2               @Done:
00072Fr 2  60             rts
000730r 2               
000730r 2               ; -----------------------------------------------------------------------------
000730r 2               ;   MatchScoreRun — the two per-run awards of SPEC 8 step 2
000730r 2               ;   In:  ScanLen = run length, ChainStep = the cascade step this is
000730r 2               ;   Out: nothing.  Modifies: A, X, Y.  Leaves ScanLen and ScanColor alone.
000730r 2               ;
000730r 2               ;       cascade_pts += length * TileValue[chain]
000730r 2               ;       cascade_pts += LengthBonus[length]
000730r 2               ;
000730r 2               ;   A cell in a horizontal run AND a vertical one is scored by both, and
000730r 2               ;   removed once (SPEC 6.1) — which is why this is per run and not per marked
000730r 2               ;   cell, and why it runs before the union in MARKS has anything to say.
000730r 2               ;
000730r 2               ;   MultiBonus is NOT here: it is per step, not per run, and CascadeScan adds
000730r 2               ;   it once the four passes have finished counting.
000730r 2               ; -----------------------------------------------------------------------------
000730r 2               MatchScoreRun:
000730r 2  AE rr rr       ldx ChainStep
000733r 2  CA             dex                           ; TileValue is indexed by chain - 1 ...
000734r 2  E0 08          cpx #8
000736r 2  90 02          bcc @Chain
000738r 2  A2 07          ldx #7                        ;   ... and flattens out at 8 (SPEC 9.1)
00073Ar 2               @Chain:
00073Ar 2  A4 rr          ldy ScanLen                   ; The multiply is Y additions (score.asm)
00073Cr 2  BD rr rr       lda TileValueLo,x
00073Fr 2  48             pha
000740r 2  BD rr rr       lda TileValueHi,x
000743r 2  AA             tax
000744r 2  68             pla
000745r 2  20 rr rr       jsr CascadeAddTimes
000748r 2               
000748r 2  A6 rr          ldx ScanLen
00074Ar 2  CA             dex
00074Br 2  CA             dex
00074Cr 2  CA             dex                           ; LengthBonus is indexed by length - 3 ...
00074Dr 2  E0 05          cpx #5
00074Fr 2  90 02          bcc @Length
000751r 2  A2 04          ldx #4                        ;   ... and flattens out at 7 (SPEC 9.3). A
000753r 2               @Length:                        ;   vertical run can be all sixteen rows long
000753r 2  BD rr rr       lda LengthBonusLo,x
000756r 2  48             pha
000757r 2  BD rr rr       lda LengthBonusHi,x
00075Ar 2  AA             tax
00075Br 2  68             pla
00075Cr 2  4C rr rr       jmp CascadeAdd
00075Fr 2               
00075Fr 2               ; -----------------------------------------------------------------------------
00075Fr 2               ;   MarksClear / MarkSet / MarkTest — the 16-byte bitmap
00075Fr 2               ;   One byte per row, bits 0-5 = columns 0-5. Union of runs is a free ORA.
00075Fr 2               ;
00075Fr 2               ;   MarkBits has eight entries rather than six so that the two sentinel
00075Fr 2               ;   columns index it harmlessly: bits 6 and 7 of a Marks byte are never set,
00075Fr 2               ;   so a walk over the whole 8-byte stride can test every cell it meets
00075Fr 2               ;   without first asking whether the cell is a wall.
00075Fr 2               ; -----------------------------------------------------------------------------
00075Fr 2               MarkBits:
00075Fr 2  01 02 04 08    .byte $01, $02, $04, $08, $10, $20, $40, $80
000763r 2  10 20 40 80  
000767r 2               
000767r 2               MarksClear:
000767r 2  A9 00          lda #0
000769r 2  A2 00          ldx #0
00076Br 2               @Row:
00076Br 2  9D rr rr       sta Marks,x
00076Er 2  E8             inx
00076Fr 2  E0 10          cpx #MARKS_BYTES
000771r 2  D0 F8          bne @Row
000773r 2  60             rts
000774r 2               
000774r 2               MarkSet:                        ; In: A = board index.  Modifies: A, X, Y
000774r 2  AA             tax
000775r 2  29 07          and #(BOARD_STRIDE - 1)
000777r 2  A8             tay                           ; Y = column
000778r 2  8A             txa
000779r 2  4A             lsr a
00077Ar 2  4A             lsr a
00077Br 2  4A             lsr a
00077Cr 2  AA             tax                           ; X = row
00077Dr 2  BD rr rr       lda Marks,x
000780r 2  19 rr rr       ora MarkBits,y
000783r 2  9D rr rr       sta Marks,x
000786r 2  60             rts
000787r 2               
000787r 2               MarkTest:                       ; In: A = board index.  Out: C set if marked
000787r 2  AA             tax                           ;     Modifies: A, X, Y
000788r 2  29 07          and #(BOARD_STRIDE - 1)
00078Ar 2  A8             tay
00078Br 2  8A             txa
00078Cr 2  4A             lsr a
00078Dr 2  4A             lsr a
00078Er 2  4A             lsr a
00078Fr 2  AA             tax
000790r 2  BD rr rr       lda Marks,x
000793r 2  39 rr rr       and MarkBits,y
000796r 2  F0 02          beq @No
000798r 2  38             sec
000799r 2  60             rts
00079Ar 2               @No:
00079Ar 2  18             clc
00079Br 2  60             rts
00079Cr 2               
00079Cr 1               .include "../src/cascade.asm"
00079Cr 2               ; =============================================================================
00079Cr 2               ;   cascade.asm — Wizards Lab, clear resolution
00079Cr 2               ; =============================================================================
00079Cr 2               ;   SPEC.md section 8. A cascade runs from the moment a piece locks until no
00079Cr 2               ;   further matches exist, one step per iteration, with ChainStep counting the
00079Cr 2               ;   steps. The step order is fixed:
00079Cr 2               ;
00079Cr 2               ;       scan -> score matches -> enqueue reagents -> resolve queue
00079Cr 2               ;            -> animate -> remove -> level check -> gravity -> repeat
00079Cr 2               ;
00079Cr 2               ;   The effect queue always drains. Effects only ever remove tiles, never add
00079Cr 2               ;   them, and each cell can be marked at most once, so the queue is bounded by
00079Cr 2               ;   the 96 cells of the playfield.
00079Cr 2               ; =============================================================================
00079Cr 2               
00079Cr 2               ; -----------------------------------------------------------------------------
00079Cr 2               ;   CascadeBegin — called immediately after PieceLock
00079Cr 2               ;   Out: nothing.  Modifies: A
00079Cr 2               ; -----------------------------------------------------------------------------
00079Cr 2               CascadeBegin:
00079Cr 2  A9 01          lda #1
00079Er 2  8D rr rr       sta ChainStep                 ; The step about to run is step 1 (SPEC 8)
0007A1r 2  A9 00          lda #0
0007A3r 2  8D rr rr       sta CascadeLo
0007A6r 2  8D rr rr       sta CascadeMid
0007A9r 2  8D rr rr       sta CascadeHi
0007ACr 2  8D rr rr       sta StarCount
0007AFr 2  8D rr rr       sta RunCount
0007B2r 2  4C rr rr       jmp EffectQClear
0007B5r 2               
0007B5r 2               ; -----------------------------------------------------------------------------
0007B5r 2               ;   CascadeScan — steps 1 to 4: find the runs, score them, fire the reagents
0007B5r 2               ;   In:  nothing
0007B5r 2               ;   Out: C set if anything is marked and the step has something to animate.
0007B5r 2               ;        C clear when nothing matched and the cascade has settled.
0007B5r 2               ;        Modifies: A, X, Y, Scan*, Marks, RunCount, Cascade*, StarCount
0007B5r 2               ;
0007B5r 2               ;   Steps 3 and 4 are the reagents, and they run between the scan and the
0007B5r 2               ;   removal because everything they do is add cells to Marks: by the time
0007B5r 2               ;   CascadeRemove walks the bitmap it cannot tell a cell the scan found from
0007B5r 2               ;   a cell a fireball took, and does not need to.
0007B5r 2               ;
0007B5r 2               ;   NOTHING HAS LEFT THE BOARD WHEN THIS RETURNS. Step 5 — the glow and the
0007B5r 2               ;   shatter (anim.asm) — happens between here and CascadeFinish below, over
0007B5r 2               ;   several frames, and it can only draw a cell's own colour and its own
0007B5r 2               ;   reagent because the cell is still sitting there saying what it is. That
0007B5r 2               ;   split is what the whole of P6 rests on, and it is the same property that
0007B5r 2               ;   let P5 make an effect queue entry one byte.
0007B5r 2               ;
0007B5r 2               ;   Step 2's per-run half is in MatchEmit, which is the one moment a run's
0007B5r 2               ;   length and colour are both in hand; what is left of it here is the bonus
0007B5r 2               ;   for having found several at once, which nothing knows until all four
0007B5r 2               ;   passes have finished.
0007B5r 2               ; -----------------------------------------------------------------------------
0007B5r 2               CascadeScan:
0007B5r 2  20 rr rr       jsr MatchScan
0007B8r 2  F0 1E          beq @Settled                  ; RunCount is zero — nothing left to clear
0007BAr 2               
0007BAr 2  AE rr rr       ldx RunCount                  ; SPEC 8 step 2, last line, and SPEC 9.4
0007BDr 2  CA             dex                           ; MultiBonus is indexed by runs - 1 ...
0007BEr 2  E0 05          cpx #5
0007C0r 2  90 02          bcc @Multi
0007C2r 2  A2 04          ldx #4                        ;   ... and flattens out at 5
0007C4r 2               @Multi:
0007C4r 2  BD rr rr       lda MultiBonusLo,x
0007C7r 2  48             pha
0007C8r 2  BD rr rr       lda MultiBonusHi,x
0007CBr 2  AA             tax
0007CCr 2  68             pla
0007CDr 2  20 rr rr       jsr CascadeAdd
0007D0r 2               
0007D0r 2  20 rr rr       jsr EffectEnqueueMarked       ; SPEC 8 step 3
0007D3r 2  20 rr rr       jsr EffectResolve             ; SPEC 8 step 4
0007D6r 2  38             sec
0007D7r 2  60             rts
0007D8r 2               @Settled:
0007D8r 2  18             clc
0007D9r 2  60             rts
0007DAr 2               
0007DAr 2               ; -----------------------------------------------------------------------------
0007DAr 2               ;   CascadeFinish — steps 6 and 7, once the animation has finished with them
0007DAr 2               ;   In:  Marks, as CascadeScan left it
0007DAr 2               ;   Out: nothing.  Modifies: A, X, Y, CellCount, Board, Level
0007DAr 2               ; -----------------------------------------------------------------------------
0007DAr 2               CascadeFinish:
0007DAr 2  20 rr rr       jsr CascadeRemove             ; SPEC 8 step 6
0007DDr 2  A5 rr          lda CellCount
0007DFr 2  4C rr rr       jmp ScoreLevelCheck           ; SPEC 8 step 7 — match and effect removals
0007E2r 2                                               ;   both count, and by here they are the same
0007E2r 2                                               ;   cells
0007E2r 2               
0007E2r 2               ; -----------------------------------------------------------------------------
0007E2r 2               ;   CascadeRemove — empty every marked cell and queue it for redraw
0007E2r 2               ;   In:  Marks
0007E2r 2               ;   Out: CellCount = cells removed.  Modifies: A, X, Y, CellCount, RedrawCol
0007E2r 2               ;   SPEC 8 step 6.
0007E2r 2               ;
0007E2r 2               ;   Every marked cell is zeroed in one go, because the gravity that follows
0007E2r 2               ;   needs a board that is finished changing. Only the REDRAW is rationed: at
0007E2r 2               ;   most 96 cells can be marked and the dirty ring holds 64, and P5 made that
0007E2r 2               ;   reachable — a bolt is 21 cells on its own and a chain of them is most of
0007E2r 2               ;   the well. A mark dropped by a full ring is never made again (D6), so
0007E2r 2               ;   rather than drop one this falls back to RenderBoard, the whole-well cursor
0007E2r 2               ;   RenderFlush already feeds a frame at a time (D12). Four frames of redraw
0007E2r 2               ;   instead of a hole in the screen, and only on the rare huge step: a plain
0007E2r 2               ;   three-in-a-row never comes near the cap.
0007E2r 2               ;
0007E2r 2               ;   CellCount goes to ScoreLevelCheck — thirty cleared tiles is a level
0007E2r 2               ;   (SPEC 10.1). By the time this runs the cells have already glowed and
0007E2r 2               ;   shattered (anim.asm); what it draws over them is the empty well behind.
0007E2r 2               ; -----------------------------------------------------------------------------
0007E2r 2               CascadeRemove:
0007E2r 2  A9 00          lda #0
0007E4r 2  85 rr          sta CellCount
0007E6r 2  AA             tax                           ; X = board index, walked a row at a time
0007E7r 2               @Row:
0007E7r 2  8A             txa
0007E8r 2  4A             lsr a
0007E9r 2  4A             lsr a
0007EAr 2  4A             lsr a
0007EBr 2  A8             tay
0007ECr 2  B9 rr rr       lda Marks,y
0007EFr 2  F0 38          beq @NextRow                  ; Nothing marked in this row, and most rows
0007F1r 2                                               ;   hold nothing marked
0007F1r 2               @Cell:
0007F1r 2  8A             txa
0007F2r 2  48             pha
0007F3r 2  20 rr rr       jsr MarkTest
0007F6r 2  68             pla
0007F7r 2  AA             tax                           ; MarkTest needs X, so the cursor comes back
0007F8r 2  90 1F          bcc @NextCell                 ;   through A. Neither PLA nor TAX touches C.
0007FAr 2  A9 00          lda #TILE_EMPTY
0007FCr 2  9D rr rr       sta Board,x
0007FFr 2  E6 rr          inc CellCount
000801r 2               
000801r 2  AD rr rr       lda DirtyCount                ; Room to mark this one?
000804r 2  C9 40          cmp #DIRTY_ENTRIES
000806r 2  B0 0A          bcs @Bulk                     ; No — redraw the lot instead of losing it
000808r 2  8A             txa
000809r 2  48             pha
00080Ar 2  20 rr rr       jsr RenderCell
00080Dr 2  68             pla
00080Er 2  AA             tax
00080Fr 2  4C rr rr       jmp @NextCell
000812r 2               @Bulk:
000812r 2  8A             txa
000813r 2  48             pha
000814r 2  20 rr rr       jsr RenderBoard               ; Sets the cursor and nothing else, so the
000817r 2  68             pla                           ;   cells already queued still land and the
000818r 2  AA             tax                           ;   redraw overwrites them with the same values
000819r 2               @NextCell:
000819r 2  E8             inx
00081Ar 2  8A             txa
00081Br 2  29 07          and #(BOARD_STRIDE - 1)
00081Dr 2  C9 06          cmp #BOARD_W
00081Fr 2  90 D0          bcc @Cell
000821r 2               
000821r 2  8A             txa                           ; X is on the row's first sentinel column;
000822r 2  18             clc                           ;   step over both of them
000823r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000825r 2  AA             tax
000826r 2  4C rr rr       jmp @Test
000829r 2               
000829r 2               @NextRow:
000829r 2  8A             txa
00082Ar 2  18             clc
00082Br 2  69 08          adc #BOARD_STRIDE
00082Dr 2  AA             tax
00082Er 2               @Test:
00082Er 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
000830r 2  90 B5          bcc @Row
000832r 2  60             rts
000833r 2               
000833r 2               ; -----------------------------------------------------------------------------
000833r 2               ;   CascadeSettle — apply the star multiplier and bank the points
000833r 2               ;   SPEC 8 SETTLE, SPEC 9.6 — the doubling covers the WHOLE cascade, including
000833r 2               ;   points scored before the star cleared.
000833r 2               ; -----------------------------------------------------------------------------
000833r 2               CascadeSettle:
000833r 2  AD rr rr       lda StarCount
000836r 2  C9 03          cmp #STAR_SHIFT_CAP
000838r 2  90 02          bcc @Shift
00083Ar 2  A9 03          lda #STAR_SHIFT_CAP           ; x8 and no further, however many were caught
00083Cr 2               @Shift:
00083Cr 2  AA             tax
00083Dr 2  F0 06          beq @Bank
00083Fr 2               @Double:
00083Fr 2  20 rr rr       jsr CascadeDouble             ; A doubling in BCD is one self-addition
000842r 2  CA             dex
000843r 2  D0 FA          bne @Double
000845r 2               @Bank:
000845r 2  4C rr rr       jmp ScoreAdd                  ; Its carry is not read: ScoreHighCheck has
000848r 2                                               ;   already raised the fanfare and the flash
000848r 2                                               ;   itself, and does so exactly once
000848r 2               
000848r 2               
000848r 2               ; =============================================================================
000848r 2               ;   The reagents (SPEC 7)
000848r 2               ; =============================================================================
000848r 2               ;   Steps 3 and 4 of SPEC 8, and the five effects between them. The shape is:
000848r 2               ;
000848r 2               ;     EffectEnqueueMarked   walks MARKS once the scan has finished, and offers
000848r 2               ;                           every matched cell to EffectEnqueue
000848r 2               ;     EffectEnqueue         decides what a cell being removed is worth — a
000848r 2               ;                           prism pays, a star counts, a fireball/bolt/bomb
000848r 2               ;                           queues
000848r 2               ;     EffectResolve         drains the queue, detonating each in turn
000848r 2               ;     EffectFireball/Bolt/  list the cells a detonation reaches, and offer each
000848r 2               ;       Bomb                one to EffectHit
000848r 2               ;     EffectHit             marks it, scores it, and offers it to
000848r 2               ;                           EffectEnqueue in its turn — which is the whole of
000848r 2               ;                           SPEC 7.2's chain reaction, in one routine
000848r 2               ;
000848r 2               ;   TERMINATION IS STRUCTURAL, not a limit. An effect only ever MARKS cells and
000848r 2               ;   never adds one, and EffectHit refuses a cell that is already marked, so a
000848r 2               ;   cell can be pushed at most once and the loop is bounded by the 96 cells of
000848r 2               ;   the well.
000848r 2               ;
000848r 2               ;   Nothing here touches the board. Marked cells are still sitting there,
000848r 2               ;   readable, until CascadeRemove zeroes them in step 6 — which is what lets a
000848r 2               ;   queue entry be a board index and nothing else (constants.inc).
000848r 2               ; =============================================================================
000848r 2               
000848r 2               ; -----------------------------------------------------------------------------
000848r 2               ;   EffectEnqueueMarked — SPEC 8 step 3
000848r 2               ;   In:  Marks, as MatchScan left it
000848r 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectQ, StarCount, Cascade*
000848r 2               ;
000848r 2               ;   Nothing called from here marks anything, so the bitmap being walked cannot
000848r 2               ;   change underneath the walk. Step 4 is where marking starts, and the cells
000848r 2               ;   it marks enqueue themselves as they are marked (EffectHit) rather than
000848r 2               ;   waiting for a second pass over MARKS.
000848r 2               ;
000848r 2               ;   It has to be a pass over the union rather than part of MatchEmit's mark
000848r 2               ;   loop: a cell in a horizontal run AND a vertical one is marked twice and
000848r 2               ;   would then detonate twice (SPEC 6.1).
000848r 2               ; -----------------------------------------------------------------------------
000848r 2               EffectEnqueueMarked:
000848r 2  A9 00          lda #0
00084Ar 2  85 rr          sta EffectIdx
00084Cr 2               @Row:
00084Cr 2  A5 rr          lda EffectIdx
00084Er 2  4A             lsr a
00084Fr 2  4A             lsr a
000850r 2  4A             lsr a
000851r 2  A8             tay
000852r 2  B9 rr rr       lda Marks,y
000855r 2  F0 20          beq @NextRow                  ; Nothing marked in this row, which is most
000857r 2                                               ;   rows of most steps
000857r 2               @Cell:
000857r 2  A5 rr          lda EffectIdx
000859r 2  20 rr rr       jsr MarkTest
00085Cr 2  90 05          bcc @NextCell
00085Er 2  A6 rr          ldx EffectIdx
000860r 2  20 rr rr       jsr EffectEnqueue
000863r 2               @NextCell:
000863r 2  E6 rr          inc EffectIdx
000865r 2  A5 rr          lda EffectIdx
000867r 2  29 07          and #(BOARD_STRIDE - 1)
000869r 2  C9 06          cmp #BOARD_W
00086Br 2  90 EA          bcc @Cell
00086Dr 2               
00086Dr 2  A5 rr          lda EffectIdx                 ; On the row's first sentinel column; step
00086Fr 2  18             clc                           ;   over both of them
000870r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000872r 2  85 rr          sta EffectIdx
000874r 2  4C rr rr       jmp @Test
000877r 2               
000877r 2               @NextRow:
000877r 2  A5 rr          lda EffectIdx
000879r 2  18             clc
00087Ar 2  69 08          adc #BOARD_STRIDE
00087Cr 2  85 rr          sta EffectIdx
00087Er 2               @Test:
00087Er 2  A5 rr          lda EffectIdx
000880r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000882r 2  90 C8          bcc @Row
000884r 2  60             rts
000885r 2               
000885r 2               ; -----------------------------------------------------------------------------
000885r 2               ;   EffectEnqueue — a marked cell is going; make what it holds count
000885r 2               ;   In:  X = board index of a cell that is ALREADY marked
000885r 2               ;   Out: nothing.  Modifies: A, X, Y
000885r 2               ;
000885r 2               ;   Called exactly once per removed cell — from step 3 for the cells the scan
000885r 2               ;   found, and from EffectHit for every cell an effect takes. Three outcomes:
000885r 2               ;
000885r 2               ;     a prism   pays BONUS_PRISM here and now and is never queued: it has no
000885r 2               ;               effect to fire, only a bonus (SPEC 7.3)
000885r 2               ;     a star    counts into StarCount and is never queued either — SPEC 8
000885r 2               ;               step 3 is explicit that stars are counted, not queued
000885r 2               ;     the rest  go on the queue, and pay their trigger bonus when they pop
000885r 2               ;
000885r 2               ;   THE COLOUR IS TESTED BEFORE THE GLYPH, and that order is not cosmetic. A
000885r 2               ;   prism is glyph 0 of colour 6, indistinguishable from a plain potion by its
000885r 2               ;   glyph alone — and from P6 onward the board may hold any of the prism's four
000885r 2               ;   idle rotation frames, whose low three bits read as a bolt or a bomb and
000885r 2               ;   would detonate one. Colour 6 is the only test that stays true.
000885r 2               ; -----------------------------------------------------------------------------
000885r 2               EffectEnqueue:
000885r 2  BD rr rr       lda Board,x
000888r 2  29 F8          and #COLOR_MASK
00088Ar 2  C9 70          cmp #WILD_BASE
00088Cr 2  F0 12          beq @Prism
00088Er 2  BD rr rr       lda Board,x
000891r 2  29 07          and #GLYPH_MASK
000893r 2  F0 0A          beq @Done                     ; A plain potion, which is most of the board
000895r 2  C9 04          cmp #GLYPH_STAR
000897r 2  F0 0A          beq @Star
000899r 2  B0 04          bcs @Done                     ; Glyphs 5-7 are animation frames (SPEC 4.4),
00089Br 2                                               ;   never reagents
00089Br 2  8A             txa
00089Cr 2  4C rr rr       jmp EffectQPush               ; Fireball, bolt or bomb — glyphs 1 to 3
00089Fr 2               @Done:
00089Fr 2  60             rts
0008A0r 2               @Prism:
0008A0r 2  4C rr rr       jmp EffectPrism               ; Both of these are the far side of the three
0008A3r 2               @Star:                          ;   detonations below, well out of branch range
0008A3r 2  4C rr rr       jmp EffectStar
0008A6r 2               
0008A6r 2               ; -----------------------------------------------------------------------------
0008A6r 2               ;   EffectHit — one cell of one detonation
0008A6r 2               ;   In:  X = board index
0008A6r 2               ;   Out: nothing.  Modifies: A, X, Y
0008A6r 2               ;
0008A6r 2               ;   The whole of SPEC 8 step 4's inner loop, which is why every effect below
0008A6r 2               ;   is nothing but a list of cells to offer it.
0008A6r 2               ;
0008A6r 2               ;   A cell that is empty, a wall, or already marked is not a target. "Not
0008A6r 2               ;   already marked" is what makes the queue terminate and what stops a cell
0008A6r 2               ;   being paid for twice; testing the WALL here is what lets the walks above
0008A6r 2               ;   run over the two sentinel columns without bounds checks of their own. A
0008A6r 2               ;   marked sentinel would be zeroed by CascadeRemove and the well would grow
0008A6r 2               ;   a hole in its floor.
0008A6r 2               ; -----------------------------------------------------------------------------
0008A6r 2               EffectHit:
0008A6r 2  BD rr rr       lda Board,x
0008A9r 2  F0 1A          beq @Done                     ; Empty
0008ABr 2  C9 FF          cmp #TILE_WALL
0008ADr 2  F0 16          beq @Done                     ; A sentinel is never a target
0008AFr 2  8A             txa
0008B0r 2  48             pha
0008B1r 2  20 rr rr       jsr MarkTest
0008B4r 2  68             pla
0008B5r 2  AA             tax                           ; Neither PLA nor TAX touches C
0008B6r 2  B0 0D          bcs @Done                     ; Already going
0008B8r 2               
0008B8r 2  8A             txa
0008B9r 2  48             pha                           ; MarkSet takes the index in A, which PHA left
0008BAr 2  20 rr rr       jsr MarkSet                   ;   alone
0008BDr 2  20 rr rr       jsr EffectScoreCell           ; SPEC 9.2, per cell an effect took
0008C0r 2  68             pla
0008C1r 2  AA             tax
0008C2r 2  4C rr rr       jmp EffectEnqueue             ; ...and if it was a reagent, it fires too
0008C5r 2               @Done:
0008C5r 2  60             rts
0008C6r 2               
0008C6r 2               ; -----------------------------------------------------------------------------
0008C6r 2               ;   EffectScoreCell — EffectValue[chain] for one cell taken by an effect
0008C6r 2               ;   Out: nothing.  Modifies: A, X, Y
0008C6r 2               ;   SPEC 9.2 — deliberately dearer than a matched tile at low chain depth, so
0008C6r 2               ;   that the first reagent a player ever sets off feels better than plain play.
0008C6r 2               ; -----------------------------------------------------------------------------
0008C6r 2               EffectScoreCell:
0008C6r 2  AE rr rr       ldx ChainStep
0008C9r 2  CA             dex                           ; Indexed by chain - 1 ...
0008CAr 2  E0 08          cpx #8
0008CCr 2  90 02          bcc @Chain
0008CEr 2  A2 07          ldx #7                        ;   ... and flattens out at 8
0008D0r 2               @Chain:
0008D0r 2  BD rr rr       lda EffectValueLo,x
0008D3r 2  48             pha
0008D4r 2  BD rr rr       lda EffectValueHi,x
0008D7r 2  AA             tax
0008D8r 2  68             pla
0008D9r 2  4C rr rr       jmp CascadeAdd
0008DCr 2               
0008DCr 2               ; -----------------------------------------------------------------------------
0008DCr 2               ;   EffectResolve — drain the queue (SPEC 8 step 4)
0008DCr 2               ;   Out: nothing.  Modifies: A, X, Y, Effect*, Marks, Cascade*, StarCount
0008DCr 2               ;
0008DCr 2               ;   The detonation runs first and the trigger bonus is paid on the way back,
0008DCr 2               ;   which is the order SPEC 8 step 4 sets out. It makes no difference to the
0008DCr 2               ;   total — everything lands in the same accumulator — but it does mean the
0008DCr 2               ;   glyph has to survive a routine that clobbers all three registers, and the
0008DCr 2               ;   stack is the cheapest place to put it.
0008DCr 2               ; -----------------------------------------------------------------------------
0008DCr 2               EffectResolve:
0008DCr 2               @Loop:
0008DCr 2  20 rr rr       jsr EffectQPop
0008DFr 2  90 45          bcc @Done                     ; Empty — the step is finished
0008E1r 2               
0008E1r 2  AA             tax                           ; X = the detonating cell
0008E2r 2  BD rr rr       lda Board,x                   ; Still on the board: step 6 has not run
0008E5r 2  29 07          and #GLYPH_MASK
0008E7r 2  48             pha
0008E8r 2  C9 01          cmp #GLYPH_FIREBALL
0008EAr 2  F0 0F          beq @Fireball
0008ECr 2  C9 02          cmp #GLYPH_BOLT
0008EEr 2  F0 20          beq @Bolt
0008F0r 2               
0008F0r 2  A9 07          lda #SFX_BOMB                 ; Glyph 3 — nothing else ever reaches here
0008F2r 2  20 rr rr       jsr SfxPlay
0008F5r 2  20 rr rr       jsr EffectBomb
0008F8r 2  4C rr rr       jmp @Bonus
0008FBr 2               
0008FBr 2               @Fireball:
0008FBr 2  A9 05          lda #SFX_FIREBALL
0008FDr 2  20 rr rr       jsr SfxPlay
000900r 2  BD rr rr       lda Board,x
000903r 2  29 F8          and #COLOR_MASK               ; Its own colour, which can never be wild
000905r 2  48             pha
000906r 2  20 rr rr       jsr HalColorFlash             ; SPEC 4.6, 14 — every tile of that colour goes
000909r 2  68             pla                           ;   white for the glow window, which is one VDP
00090Ar 2                                               ;   colour byte here and one compare a cell on
00090Ar 2                                               ;   the Commodores. AnimGlowBegin reads
00090Ar 2                                               ;   TintColor to find out that it happened
00090Ar 2  20 rr rr       jsr EffectFireball
00090Dr 2  4C rr rr       jmp @Bonus
000910r 2               
000910r 2               @Bolt:
000910r 2  A9 06          lda #SFX_BOLT
000912r 2  20 rr rr       jsr SfxPlay
000915r 2  20 rr rr       jsr EffectBolt
000918r 2               
000918r 2               @Bonus:
000918r 2  68             pla
000919r 2  A8             tay                           ; TriggerBonus is indexed by glyph (SPEC 9.5),
00091Ar 2  B9 rr rr       lda TriggerBonusLo,y          ;   and is paid however the reagent was removed
00091Dr 2  BE rr rr       ldx TriggerBonusHi,y
000920r 2  20 rr rr       jsr CascadeAdd
000923r 2  4C rr rr       jmp @Loop
000926r 2               @Done:
000926r 2  60             rts
000927r 2               
000927r 2               ; -----------------------------------------------------------------------------
000927r 2               ;   The five reagents (SPEC 7.3). Each lists the cells it reaches and leaves
000927r 2               ;   the marking, the scoring and the chain reaction to EffectHit.
000927r 2               ; -----------------------------------------------------------------------------
000927r 2               
000927r 2               ; -----------------------------------------------------------------------------
000927r 2               ;   EffectFireball — every remaining tile of one colour, board wide
000927r 2               ;   In:  A = the colour key ($40 to $68)
000927r 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectArg, Marks, Cascade*
000927r 2               ;   SPEC 7.3 — the signature reagent, and the reason a chain goes three deep.
000927r 2               ;
000927r 2               ;   PRISMS ARE IMMUNE AND IT COSTS NOTHING TO MAKE THEM SO (SPEC 7.4). A prism
000927r 2               ;   is colour 6 and a fireball's colour never is, so the compare below is the
000927r 2               ;   immunity — there is no special case to forget. An empty cell and a wall
000927r 2               ;   fail it for the same reason, which is why this walks all eight columns of
000927r 2               ;   every row rather than stepping over the sentinels.
000927r 2               ;
000927r 2               ;   The fireball's own cell is already marked, so it is not a target of itself,
000927r 2               ;   and a second fireball of the same colour in the same step finds nothing
000927r 2               ;   left to take — and still pays its trigger bonus (SPEC 7.3).
000927r 2               ; -----------------------------------------------------------------------------
000927r 2               EffectFireball:
000927r 2  85 rr          sta EffectArg                 ; The colour it is hunting
000929r 2  A9 00          lda #0
00092Br 2  85 rr          sta EffectIdx
00092Dr 2               @Cell:
00092Dr 2  A6 rr          ldx EffectIdx
00092Fr 2  BD rr rr       lda Board,x
000932r 2  29 F8          and #COLOR_MASK
000934r 2  C5 rr          cmp EffectArg
000936r 2  D0 03          bne @Next
000938r 2  20 rr rr       jsr EffectHit
00093Br 2               @Next:
00093Br 2  E6 rr          inc EffectIdx
00093Dr 2  A5 rr          lda EffectIdx
00093Fr 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000941r 2  90 EA          bcc @Cell
000943r 2  60             rts
000944r 2               
000944r 2               ; -----------------------------------------------------------------------------
000944r 2               ;   EffectBolt — the whole row and the whole column through the bolt's cell
000944r 2               ;   In:  X = board index
000944r 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectEnd, EffectArg, Marks
000944r 2               ;   SPEC 7.3 — up to 6 + 16 - 1 = 21 cells, and the only reagent that reaches
000944r 2               ;   something buried at the bottom of a column.
000944r 2               ;
000944r 2               ;   Neither walk needs clipping: a row is six cells wherever it is, and a
000944r 2               ;   column is sixteen. The bolt's own cell is offered twice, once by each, and
000944r 2               ;   is refused both times because it was marked before this was called.
000944r 2               ; -----------------------------------------------------------------------------
000944r 2               EffectBolt:
000944r 2  8A             txa
000945r 2  29 07          and #(BOARD_STRIDE - 1)
000947r 2  85 rr          sta EffectArg                 ; Its column, for the second walk
000949r 2  8A             txa
00094Ar 2  29 F8          and #(256 - BOARD_STRIDE)     ; $F8 — its row base
00094Cr 2  85 rr          sta EffectIdx
00094Er 2  18             clc
00094Fr 2  69 06          adc #BOARD_W
000951r 2  85 rr          sta EffectEnd                 ; One past the row's last playfield cell
000953r 2               @Row:
000953r 2  A6 rr          ldx EffectIdx
000955r 2  20 rr rr       jsr EffectHit
000958r 2  E6 rr          inc EffectIdx
00095Ar 2  A5 rr          lda EffectIdx
00095Cr 2  C5 rr          cmp EffectEnd
00095Er 2  90 F3          bcc @Row
000960r 2               
000960r 2  A5 rr          lda EffectArg                 ; The column, row 0 downward
000962r 2  85 rr          sta EffectIdx
000964r 2               @Col:
000964r 2  A6 rr          ldx EffectIdx
000966r 2  20 rr rr       jsr EffectHit
000969r 2  A5 rr          lda EffectIdx
00096Br 2  18             clc
00096Cr 2  69 08          adc #BOARD_STRIDE
00096Er 2  85 rr          sta EffectIdx
000970r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000972r 2  90 F0          bcc @Col
000974r 2  60             rts
000975r 2               
000975r 2               ; -----------------------------------------------------------------------------
000975r 2               ;   EffectBomb — the 3 x 3 block centred on the bomb, clipped at the edges
000975r 2               ;   In:  X = board index
000975r 2               ;   Out: nothing.  Modifies: A, X, Y, Effect*, Tmp0, Tmp1, Marks, Cascade*
000975r 2               ;   SPEC 7.3 — up to 9 cells, and the reagent most likely to catch another.
000975r 2               ;
000975r 2               ;   BOTH SPANS ARE CLIPPED, and the row span has to be: row 0 minus one row is
000975r 2               ;   index minus 8, which underflows a byte and reads the BSS in front of a
000975r 2               ;   page-aligned Board. The column span could lean on the sentinels the way
000975r 2               ;   every other walk in the game does — except at row 0, column 0, where
000975r 2               ;   "one to the left" is index $FF and off the end of the board. Clipping both
000975r 2               ;   is smaller than special-casing one corner.
000975r 2               ;
000975r 2               ;   Tmp0 and Tmp1 are finished with before the first JSR, which is what the
000975r 2               ;   rule about them says (zeropage.inc).
000975r 2               ; -----------------------------------------------------------------------------
000975r 2               EffectBomb:
000975r 2  8A             txa                           ; --- the column span ---
000976r 2  29 07          and #(BOARD_STRIDE - 1)
000978r 2  A8             tay
000979r 2  F0 01          beq @Left                     ; Column 0 — the block starts there
00097Br 2  88             dey
00097Cr 2               @Left:
00097Cr 2  84 rr          sty Tmp0                      ; First column of the block
00097Er 2  8A             txa
00097Fr 2  29 07          and #(BOARD_STRIDE - 1)
000981r 2  C9 05          cmp #(BOARD_W - 1)
000983r 2  B0 02          bcs @Right                    ; Already against the right wall
000985r 2  69 01          adc #1                        ; C is clear — the CMP above failed
000987r 2               @Right:
000987r 2  85 rr          sta EffectArg                 ; Last column of the block
000989r 2               
000989r 2  8A             txa                           ; --- the row span ---
00098Ar 2  29 F8          and #(256 - BOARD_STRIDE)
00098Cr 2  85 rr          sta Tmp1                      ; The bomb's own row base
00098Er 2  F0 03          beq @Top                      ; Row 0 — the block starts there
000990r 2  38             sec
000991r 2  E9 08          sbc #BOARD_STRIDE
000993r 2               @Top:
000993r 2  18             clc
000994r 2  65 rr          adc Tmp0
000996r 2  85 rr          sta EffectRow                 ; First cell of the block's first row
000998r 2               
000998r 2  A5 rr          lda Tmp1
00099Ar 2  C9 78          cmp #((BOARD_H - 1) * BOARD_STRIDE)
00099Cr 2  B0 03          bcs @Bottom                   ; Row 15 — the block ends there
00099Er 2  18             clc
00099Fr 2  69 08          adc #BOARD_STRIDE
0009A1r 2               @Bottom:
0009A1r 2  18             clc
0009A2r 2  65 rr          adc Tmp0
0009A4r 2  85 rr          sta EffectEnd                 ; First cell of the block's LAST row
0009A6r 2               
0009A6r 2               @Rows:
0009A6r 2  A5 rr          lda EffectRow
0009A8r 2  85 rr          sta EffectIdx
0009AAr 2               @Cell:
0009AAr 2  A6 rr          ldx EffectIdx
0009ACr 2  20 rr rr       jsr EffectHit
0009AFr 2  A5 rr          lda EffectIdx
0009B1r 2  29 07          and #(BOARD_STRIDE - 1)
0009B3r 2  C5 rr          cmp EffectArg
0009B5r 2  E6 rr          inc EffectIdx                 ; INC touches N and Z only, so the CMP's carry
0009B7r 2  90 F1          bcc @Cell                     ;   is still the one being branched on
0009B9r 2               
0009B9r 2  A5 rr          lda EffectRow
0009BBr 2  C5 rr          cmp EffectEnd
0009BDr 2  B0 07          bcs @Done                     ; That was the last row of the block
0009BFr 2  18             clc
0009C0r 2  69 08          adc #BOARD_STRIDE
0009C2r 2  85 rr          sta EffectRow
0009C4r 2  D0 E0          bne @Rows                     ; Always — a row base past the first is >= 8
0009C6r 2               @Done:
0009C6r 2  60             rts
0009C7r 2               
0009C7r 2               ; -----------------------------------------------------------------------------
0009C7r 2               ;   EffectStar — removes nothing; it multiplies (SPEC 7.3)
0009C7r 2               ;   Out: nothing.  Modifies: A
0009C7r 2               ;
0009C7r 2               ;   The cap is not applied here. SPEC 9.6 doubles the WHOLE cascade up to three
0009C7r 2               ;   times at the end, so the count has to survive to CascadeSettle, which is
0009C7r 2               ;   where min(StarCount, STAR_SHIFT_CAP) is taken. A cascade cannot remove more
0009C7r 2               ;   than the 96 cells of the well, so the count cannot wrap on its way there.
0009C7r 2               ; -----------------------------------------------------------------------------
0009C7r 2               EffectStar:
0009C7r 2  EE rr rr       inc StarCount
0009CAr 2  A9 08          lda #SFX_STAR
0009CCr 2  20 rr rr       jsr SfxPlay
0009CFr 2  60             rts
0009D0r 2               
0009D0r 2               ; -----------------------------------------------------------------------------
0009D0r 2               ;   EffectPrism — removes nothing; a flat bonus per prism cleared (SPEC 9.5)
0009D0r 2               ;   Out: nothing.  Modifies: A, X
0009D0r 2               ;
0009D0r 2               ;   It goes through CascadeAdd and not ScoreAward, so a star in the same
0009D0r 2               ;   cascade doubles it: SPEC 9.6 exempts only the soft drop and the level
0009D0r 2               ;   bonus from the multiplier (D5, D18).
0009D0r 2               ; -----------------------------------------------------------------------------
0009D0r 2               EffectPrism:
0009D0r 2  A9 09          lda #SFX_PRISM
0009D2r 2  20 rr rr       jsr SfxPlay
0009D5r 2  A9 00          lda #<BONUS_PRISM
0009D7r 2  A2 04          ldx #>BONUS_PRISM
0009D9r 2  4C rr rr       jmp CascadeAdd
0009DCr 2               
0009DCr 2               ; -----------------------------------------------------------------------------
0009DCr 2               ;   The effect queue — a ring of board indices, one byte an entry.
0009DCr 2               ;
0009DCr 2               ;   The board still holds every pending reagent when its entry pops, because
0009DCr 2               ;   nothing is zeroed until step 6, so the glyph and the colour SPEC 8 packs
0009DCr 2               ;   into the entry are one `lda Board,x` away and storing them again would be
0009DCr 2               ;   storing a copy of the board (constants.inc).
0009DCr 2               ;
0009DCr 2               ;   Head and tail are entry numbers; the ring keeps one slot free, so it holds
0009DCr 2               ;   EFFECTQ_ENTRIES - 1. On overflow the effect is DROPPED and the cascade
0009DCr 2               ;   carries on (D6) — the cell is still marked, still scored and still removed,
0009DCr 2               ;   it simply does not detonate. With at most one reagent a piece, 47 pending
0009DCr 2               ;   detonations is not somewhere a real board goes.
0009DCr 2               ; -----------------------------------------------------------------------------
0009DCr 2               EffectQClear:
0009DCr 2  A9 00          lda #0
0009DEr 2  8D rr rr       sta EffectQHead
0009E1r 2  8D rr rr       sta EffectQTail
0009E4r 2  60             rts
0009E5r 2               
0009E5r 2               ; -----------------------------------------------------------------------------
0009E5r 2               ;   EffectQPush — In: A = board index.  Modifies: A, X, Y
0009E5r 2               ; -----------------------------------------------------------------------------
0009E5r 2               EffectQPush:
0009E5r 2  AE rr rr       ldx EffectQTail
0009E8r 2  AC rr rr       ldy EffectQTail
0009EBr 2  C8             iny
0009ECr 2  C0 30          cpy #EFFECTQ_ENTRIES
0009EEr 2  90 02          bcc @Store
0009F0r 2  A0 00          ldy #0                        ; Wrap
0009F2r 2               @Store:
0009F2r 2  CC rr rr       cpy EffectQHead
0009F5r 2  F0 06          beq @Full                     ; One slot free is the ring being full
0009F7r 2  9D rr rr       sta EffectQ,x
0009FAr 2  8C rr rr       sty EffectQTail
0009FDr 2               @Full:
0009FDr 2  60             rts
0009FEr 2               
0009FEr 2               ; -----------------------------------------------------------------------------
0009FEr 2               ;   EffectQPop — Out: C set and A = board index; C clear when empty
0009FEr 2               ;   Modifies: A, X
0009FEr 2               ; -----------------------------------------------------------------------------
0009FEr 2               EffectQPop:
0009FEr 2  AE rr rr       ldx EffectQHead
000A01r 2  EC rr rr       cpx EffectQTail
000A04r 2  F0 0F          beq @Empty
000A06r 2  BD rr rr       lda EffectQ,x
000A09r 2  E8             inx
000A0Ar 2  E0 30          cpx #EFFECTQ_ENTRIES
000A0Cr 2  90 02          bcc @Store
000A0Er 2  A2 00          ldx #0                        ; Wrap
000A10r 2               @Store:
000A10r 2  8E rr rr       stx EffectQHead
000A13r 2  38             sec
000A14r 2  60             rts
000A15r 2               @Empty:
000A15r 2  18             clc
000A16r 2  60             rts
000A17r 2               
000A17r 1               .include "../src/anim.asm"
000A17r 2               ; =============================================================================
000A17r 2               ;   anim.asm — Wizards Lab, the animations a clear is made of
000A17r 2               ; =============================================================================
000A17r 2               ;   SPEC.md section 14, and step 5 of SPEC 8. Everything here is a frame's
000A17r 2               ;   worth of work and then a return: nothing waits, nothing loops on a timer,
000A17r 2               ;   and the main loop never stops for any of it (D4).
000A17r 2               ;
000A17r 2               ;   A CLEAR STEP ANIMATES IN TWO WINDOWS, and every event SPEC 14 lists lands
000A17r 2               ;   inside one of them:
000A17r 2               ;
000A17r 2               ;     PLAY_GLOW      matched cells wear glyph +6 of their own colour, the
000A17r 2               ;                    bolt's beams lie over its row and column, and the
000A17r 2               ;                    fireball's colour is white board-wide. GlowFrames, or the
000A17r 2               ;                    longer FlashFrames when a fireball fired
000A17r 2               ;     PLAY_SHATTER   the removal ring opens outward over every marked cell,
000A17r 2               ;                    two frames a tile, with a marked prism's blip-out closing
000A17r 2               ;                    inward beside it. SHATTER_STEPS ring frames, or the
000A17r 2               ;                    prism's BLIP_STEPS when there is one
000A17r 2               ;
000A17r 2               ;   A window is as long as the LONGEST thing in it, which is the one rule that
000A17r 2               ;   makes the durations in SPEC 14 hold without a timer per effect.
000A17r 2               ;
000A17r 2               ;   THE BOARD IS UNTOUCHED THE WHOLE TIME. Marked cells are not zeroed until
000A17r 2               ;   CascadeRemove runs at the end of the shatter (SPEC 8 step 6), so every
000A17r 2               ;   routine below can read a cell to find out what it is while drawing
000A17r 2               ;   something else entirely over it — which is also what let P5 make an effect
000A17r 2               ;   queue entry one byte (cascade.asm). Nothing here writes Board except the
000A17r 2               ;   prism's idle rotation and the game-over petrify, both of which change what
000A17r 2               ;   a cell IS and not merely what it shows.
000A17r 2               ;
000A17r 2               ;   THE COLOUR IS TESTED BEFORE THE GLYPH, everywhere, for the reason P5 found
000A17r 2               ;   the hard way: a prism is glyph 0 of colour 6 and, now that it rotates, its
000A17r 2               ;   board byte is WILD_BASE + 0..3, whose low three bits read as a bolt or a
000A17r 2               ;   bomb. Colour 6 is the only test that stays true.
000A17r 2               ; =============================================================================
000A17r 2               
000A17r 2               ANIM_GLOW           = 0         ; The four passes AnimMarked can make over the
000A17r 2               ANIM_BEAM           = 1         ;   marked cells. AnimMode picks one; the walk
000A17r 2               ANIM_UNBEAM         = 2         ;   itself is the same 30 bytes for all four
000A17r 2               ANIM_SHATTER        = 3         ;   and is written once.
000A17r 2               
000A17r 2               ; -----------------------------------------------------------------------------
000A17r 2               ;   AnimMarked — run one pass over every marked cell
000A17r 2               ;   In:  A = ANIM_*      Out: nothing.  Modifies: A, X, Y, Anim*, and whatever
000A17r 2               ;        the pass itself touches
000A17r 2               ;
000A17r 2               ;   The same walk as EffectEnqueueMarked (cascade.asm) and for the same reason:
000A17r 2               ;   MARKS is the union of everything the step is taking, and a cell in a
000A17r 2               ;   horizontal run AND a vertical one appears in it once. Marks are read only
000A17r 2               ;   here — no pass sets one — so the bitmap cannot change underneath the walk.
000A17r 2               ;
000A17r 2               ;   The cursor is in memory rather than in X because everything the passes call
000A17r 2               ;   ends at RenderMark, which clobbers A and X (D13).
000A17r 2               ; -----------------------------------------------------------------------------
000A17r 2               AnimMarked:
000A17r 2  85 rr          sta AnimMode
000A19r 2  A9 00          lda #0
000A1Br 2  85 rr          sta AnimIdx
000A1Dr 2               @Row:
000A1Dr 2  A5 rr          lda AnimIdx
000A1Fr 2  4A             lsr a
000A20r 2  4A             lsr a
000A21r 2  4A             lsr a
000A22r 2  A8             tay
000A23r 2  B9 rr rr       lda Marks,y
000A26r 2  F0 20          beq @NextRow                  ; Nothing marked in this row, which is most
000A28r 2                                               ;   rows of most steps
000A28r 2               @Cell:
000A28r 2  A5 rr          lda AnimIdx
000A2Ar 2  20 rr rr       jsr MarkTest
000A2Dr 2  90 05          bcc @NextCell
000A2Fr 2  A6 rr          ldx AnimIdx
000A31r 2  20 rr rr       jsr AnimCell
000A34r 2               @NextCell:
000A34r 2  E6 rr          inc AnimIdx
000A36r 2  A5 rr          lda AnimIdx
000A38r 2  29 07          and #(BOARD_STRIDE - 1)
000A3Ar 2  C9 06          cmp #BOARD_W
000A3Cr 2  90 EA          bcc @Cell
000A3Er 2               
000A3Er 2  A5 rr          lda AnimIdx                   ; On the row's first sentinel column; step
000A40r 2  18             clc                           ;   over both of them
000A41r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000A43r 2  85 rr          sta AnimIdx
000A45r 2  4C rr rr       jmp @Test
000A48r 2               
000A48r 2               @NextRow:
000A48r 2  A5 rr          lda AnimIdx
000A4Ar 2  18             clc
000A4Br 2  69 08          adc #BOARD_STRIDE
000A4Dr 2  85 rr          sta AnimIdx
000A4Fr 2               @Test:
000A4Fr 2  A5 rr          lda AnimIdx
000A51r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000A53r 2  90 C8          bcc @Row
000A55r 2  60             rts
000A56r 2               
000A56r 2               ; -----------------------------------------------------------------------------
000A56r 2               ;   AnimCell — one marked cell, in whichever pass is running
000A56r 2               ;   In:  X = board index, AnimMode      Out: nothing.  Modifies: A, X, Y
000A56r 2               ; -----------------------------------------------------------------------------
000A56r 2               AnimCell:
000A56r 2  A5 rr          lda AnimMode
000A58r 2  F0 1A          beq AnimCellGlow
000A5Ar 2  C9 03          cmp #ANIM_SHATTER
000A5Cr 2  F0 2A          beq AnimCellShatter
000A5Er 2                 ; falls through into the two beam passes, which are the same test
000A5Er 2               
000A5Er 2               ; -----------------------------------------------------------------------------
000A5Er 2               ;   AnimCellBolt — is this cell a bolt? If so, draw or undraw its cross
000A5Er 2               ;   In:  X = board index      Out: nothing.  Modifies: A, X, Y, Anim*
000A5Er 2               ;
000A5Er 2               ;   The beams are their own pass and not a case inside the glow, because a
000A5Er 2               ;   beam goes OVER a glow: a cell in a bolt's row is very often also a matched
000A5Er 2               ;   cell, and both have to be drawn in that order.
000A5Er 2               ; -----------------------------------------------------------------------------
000A5Er 2               AnimCellBolt:
000A5Er 2  BD rr rr       lda Board,x
000A61r 2  29 F8          and #COLOR_MASK
000A63r 2  C9 70          cmp #WILD_BASE
000A65r 2  F0 0C          beq @Done                     ; Colour before glyph: a rotating prism's low
000A67r 2                                               ;   three bits say "bolt" and it is not one
000A67r 2  BD rr rr       lda Board,x
000A6Ar 2  29 07          and #GLYPH_MASK
000A6Cr 2  C9 02          cmp #GLYPH_BOLT
000A6Er 2  D0 03          bne @Done
000A70r 2  4C rr rr       jmp AnimBeam
000A73r 2               @Done:
000A73r 2  60             rts
000A74r 2               
000A74r 2               ; -----------------------------------------------------------------------------
000A74r 2               ;   AnimCellGlow — glyph +6 of the cell's own colour (SPEC 14)
000A74r 2               ;   In:  X = board index      Out: nothing.  Modifies: A, X, Y, AnimSteps
000A74r 2               ;
000A74r 2               ;   A MARKED PRISM SITS THE GLOW OUT. Group 14's slot +6 is an arrow, not a
000A74r 2               ;   glow (SPEC A.3), so `WILD_BASE + GLYPH_GLOW` must never be constructed —
000A74r 2               ;   the prism holds whatever rotation frame it was on and blips out later
000A74r 2               ;   instead. Meeting one here is also how the shatter window learns it has to
000A74r 2               ;   run BLIP_STEPS rather than SHATTER_STEPS, which saves a second walk.
000A74r 2               ; -----------------------------------------------------------------------------
000A74r 2               AnimCellGlow:
000A74r 2  BD rr rr       lda Board,x
000A77r 2  29 F8          and #COLOR_MASK
000A79r 2  C9 70          cmp #WILD_BASE
000A7Br 2  F0 05          beq @Prism
000A7Dr 2  09 06          ora #GLYPH_GLOW               ; The colour key's low three bits are clear, so
000A7Fr 2  4C rr rr       jmp RenderCellAs              ;   an ORA is the whole conversion (SPEC 4.2)
000A82r 2               @Prism:
000A82r 2  A9 05          lda #BLIP_STEPS
000A84r 2  8D rr rr       sta AnimSteps
000A87r 2  60             rts
000A88r 2               
000A88r 2               ; -----------------------------------------------------------------------------
000A88r 2               ;   AnimCellShatter — the ring frame this cell is showing right now
000A88r 2               ;   In:  X = board index, AnimStep      Out: nothing.  Modifies: A, X, Y
000A88r 2               ;   SPEC 14, Appendix A.3 — one ring, opening outward for everything except a
000A88r 2               ;   prism, which runs it closed inward.
000A88r 2               ; -----------------------------------------------------------------------------
000A88r 2               AnimCellShatter:
000A88r 2  BD rr rr       lda Board,x
000A8Br 2  29 F8          and #COLOR_MASK
000A8Dr 2  C9 70          cmp #WILD_BASE
000A8Fr 2  F0 0D          beq @Blip
000A91r 2  AC rr rr       ldy AnimStep
000A94r 2  C0 04          cpy #(SHATTER_STEPS + 1)
000A96r 2  B0 0F          bcs @Done                     ; The ring is spent and the cell already blank.
000A98r 2  B9 rr rr       lda VfxShatter,y              ;   Only reachable while a prism holds the
000A9Br 2  4C rr rr       jmp RenderCellAs              ;   window open for its last two frames
000A9Er 2               @Blip:
000A9Er 2  AC rr rr       ldy AnimStep
000AA1r 2  B9 rr rr       lda VfxBlip,y
000AA4r 2  4C rr rr       jmp RenderCellAs
000AA7r 2               @Done:
000AA7r 2  60             rts
000AA8r 2               
000AA8r 2               ; -----------------------------------------------------------------------------
000AA8r 2               ;   AnimBeam — the bolt's beams, along its whole row and its whole column
000AA8r 2               ;   In:  X = board index of the bolt; AnimIdx holds the same index, because
000AA8r 2               ;        this is only ever reached from AnimMarked's cursor
000AA8r 2               ;   Out: nothing.  Modifies: A, X, Y, AnimCur, AnimEnd, AnimArg
000AA8r 2               ;   SPEC 14, Appendix A.3.
000AA8r 2               ;
000AA8r 2               ;   The beams cover EVERY cell of the row and the column, empty ones included.
000AA8r 2               ;   A beam has to butt against its neighbours to read as a beam, and the cells
000AA8r 2               ;   the bolt found empty were never marked — so those are also the cells the
000AA8r 2               ;   ANIM_UNBEAM pass exists to put back, since nothing else would ever draw
000AA8r 2               ;   them again.
000AA8r 2               ;
000AA8r 2               ;   The cross goes down last, over both walks, because it is the one cell that
000AA8r 2               ;   belongs to each.
000AA8r 2               ; -----------------------------------------------------------------------------
000AA8r 2               AnimBeam:
000AA8r 2  8A             txa
000AA9r 2  29 07          and #(BOARD_STRIDE - 1)
000AABr 2  85 rr          sta AnimArg                   ; Its column, for the second walk
000AADr 2  8A             txa
000AAEr 2  29 F8          and #(256 - BOARD_STRIDE)     ; $F8 — its row base
000AB0r 2  85 rr          sta AnimCur
000AB2r 2  18             clc
000AB3r 2  69 06          adc #BOARD_W
000AB5r 2  85 rr          sta AnimEnd                   ; One past the row's last playfield cell
000AB7r 2               @Row:
000AB7r 2  A6 rr          ldx AnimCur
000AB9r 2  A9 3B          lda #VFX_BEAM_H
000ABBr 2  20 rr rr       jsr AnimBeamCell
000ABEr 2  E6 rr          inc AnimCur
000AC0r 2  A5 rr          lda AnimCur
000AC2r 2  C5 rr          cmp AnimEnd
000AC4r 2  90 F1          bcc @Row
000AC6r 2               
000AC6r 2  A5 rr          lda AnimArg                   ; The column, row 0 downward
000AC8r 2  85 rr          sta AnimCur
000ACAr 2               @Col:
000ACAr 2  A6 rr          ldx AnimCur
000ACCr 2  A9 3C          lda #VFX_BEAM_V
000ACEr 2  20 rr rr       jsr AnimBeamCell
000AD1r 2  A5 rr          lda AnimCur
000AD3r 2  18             clc
000AD4r 2  69 08          adc #BOARD_STRIDE
000AD6r 2  85 rr          sta AnimCur
000AD8r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000ADAr 2  90 EE          bcc @Col
000ADCr 2               
000ADCr 2  A6 rr          ldx AnimIdx                   ; The bolt's own cell. The outer walk is still
000ADEr 2  A9 3D          lda #VFX_BEAM_CROSS           ;   standing on it, which is cheaper than
000AE0r 2                 ; falls through                ;   keeping a copy across both walks
000AE0r 2               
000AE0r 2               ; -----------------------------------------------------------------------------
000AE0r 2               ;   AnimBeamCell — one cell of a beam, drawn or put back
000AE0r 2               ;   In:  X = board index, A = beam tile      Modifies: A, X, Y
000AE0r 2               ;
000AE0r 2               ;   On the way back only the cells that are NOT marked need anything: the
000AE0r 2               ;   marked ones are about to be drawn by the shatter, twice a frame apart, and
000AE0r 2               ;   drawing them here as well would only queue two marks for one cell.
000AE0r 2               ;
000AE0r 2               ;   THE RESTORE IS THE ONE MARK IN THE WHOLE ANIMATION THAT CANNOT BE DROPPED.
000AE0r 2               ;   Every other one is made again within a few frames — a lost glow is covered
000AE0r 2               ;   by the shatter six frames later, a lost ring frame by CascadeRemove at the
000AE0r 2               ;   end of it — but a beam laid over an EMPTY cell has nothing behind it that
000AE0r 2               ;   anything will ever draw again, and D6's drop-on-overflow would leave a
000AE0r 2               ;   white beam sitting in the well for the rest of the game. Five bolts in one
000AE0r 2               ;   run put 110 beam cells through here against a 64-entry ring, so this is
000AE0r 2               ;   reachable and not theoretical. It takes the same way out CascadeRemove
000AE0r 2               ;   does: the whole-well redraw cursor, which repaints every one of them from
000AE0r 2               ;   the board (D12).
000AE0r 2               ; -----------------------------------------------------------------------------
000AE0r 2               AnimBeamCell:
000AE0r 2  A4 rr          ldy AnimMode
000AE2r 2  C0 01          cpy #ANIM_BEAM
000AE4r 2  D0 03          bne @Restore
000AE6r 2  4C rr rr       jmp RenderCellAs
000AE9r 2               @Restore:
000AE9r 2  8A             txa
000AEAr 2  48             pha                           ; MarkTest takes the index in A and clobbers
000AEBr 2  20 rr rr       jsr MarkTest                  ;   X; neither PLA nor TAX touches C
000AEEr 2  68             pla
000AEFr 2  AA             tax
000AF0r 2  B0 0D          bcs @Done                     ; Marked — the shatter has it
000AF2r 2  AD rr rr       lda DirtyCount
000AF5r 2  C9 40          cmp #DIRTY_ENTRIES
000AF7r 2  B0 03          bcs @Bulk                     ; No room, and this cell must not be lost
000AF9r 2  4C rr rr       jmp RenderCell                ; Board,x — empty, in every case that gets here
000AFCr 2               @Bulk:
000AFCr 2  4C rr rr       jmp RenderBoard               ; Sets the cursor and nothing else; the cells
000AFFr 2                                               ;   already queued still land and the redraw
000AFFr 2                                               ;   goes over them with the same values
000AFFr 2               @Done:
000AFFr 2  60             rts
000B00r 2               
000B00r 2               ; =============================================================================
000B00r 2               ;   The two windows
000B00r 2               ; =============================================================================
000B00r 2               
000B00r 2               ; -----------------------------------------------------------------------------
000B00r 2               ;   AnimGlowBegin — SPEC 8 step 5, first half. Called with MARKS filled and
000B00r 2               ;   the effect queue drained, from CascadeEnter.
000B00r 2               ;   Out: PlayState = PLAY_GLOW.  Modifies: A, X, Y, Anim*
000B00r 2               ;
000B00r 2               ;   The fireball's flash is already lit: EffectResolve calls HalColorFlash as
000B00r 2               ;   it detonates, so TintColor arriving here as anything but TINT_NONE is how
000B00r 2               ;   this knows a fireball fired and the window has to be the longer one
000B00r 2               ;   (SPEC 14). Two fireballs of different colours in one step leave the LAST
000B00r 2               ;   one's colour flashing — one byte can only name one group, and the other's
000B00r 2               ;   cells still glow and still shatter.
000B00r 2               ; -----------------------------------------------------------------------------
000B00r 2               AnimGlowBegin:
000B00r 2  A9 03          lda #SHATTER_STEPS            ; Raised to BLIP_STEPS by AnimCellGlow if it
000B02r 2  8D rr rr       sta AnimSteps                 ;   meets a marked prism
000B05r 2  A9 00          lda #ANIM_GLOW
000B07r 2  20 rr rr       jsr AnimMarked
000B0Ar 2  A9 01          lda #ANIM_BEAM
000B0Cr 2  20 rr rr       jsr AnimMarked
000B0Fr 2               
000B0Fr 2  AE rr rr       ldx Region
000B12r 2  BD rr rr       lda GlowFrames,x
000B15r 2  AC rr rr       ldy TintColor
000B18r 2  C0 01          cpy #TINT_NONE
000B1Ar 2  F0 08          beq @Time
000B1Cr 2  BD rr rr       lda FlashFrames,x
000B1Fr 2  48             pha
000B20r 2  20 rr rr       jsr RenderNext                ; The preview is redrawn so that a piece of the
000B23r 2  68             pla                           ;   flashing colour goes white there too. On
000B24r 2                                               ;   the AC6502 the whole group recolours and
000B24r 2                                               ;   this changes nothing; on the Commodores the
000B24r 2                                               ;   tint is per cell and this is the only way
000B24r 2                                               ;   those three cells hear about it (SPEC 4.6)
000B24r 2               @Time:
000B24r 2  8D rr rr       sta AnimTimer
000B27r 2  A9 02          lda #PLAY_GLOW
000B29r 2  8D rr rr       sta PlayState
000B2Cr 2  60             rts
000B2Dr 2               
000B2Dr 2               ; -----------------------------------------------------------------------------
000B2Dr 2               ;   AnimGlowEnd — take the beams and the flash down, and start the shatter
000B2Dr 2               ;   Out: PlayState = PLAY_SHATTER.  Modifies: A, X, Y, Anim*
000B2Dr 2               ; -----------------------------------------------------------------------------
000B2Dr 2               AnimGlowEnd:
000B2Dr 2  A9 02          lda #ANIM_UNBEAM
000B2Fr 2  20 rr rr       jsr AnimMarked
000B32r 2               
000B32r 2  AD rr rr       lda TintColor
000B35r 2  C9 01          cmp #TINT_NONE
000B37r 2  F0 08          beq AnimShatterBegin
000B39r 2  A9 01          lda #TINT_NONE
000B3Br 2  20 rr rr       jsr HalColorFlash             ; The flash ends with the window; every cell it
000B3Er 2  20 rr rr       jsr RenderNext                ;   covered is marked and about to be redrawn
000B41r 2                                               ;   by the shatter, so only the preview needs
000B41r 2                                               ;   asking for again
000B41r 2                 ; falls through
000B41r 2               
000B41r 2               ; -----------------------------------------------------------------------------
000B41r 2               ;   AnimShatterBegin — SPEC 8 step 5, second half
000B41r 2               ;   Out: PlayState = PLAY_SHATTER.  Modifies: A, X, Y, Anim*
000B41r 2               ;   Frame 0 of the ring goes up now rather than next frame, so the window is
000B41r 2               ;   AnimSteps * VFX_FRAMES frames long and every tile of it holds for
000B41r 2               ;   VFX_FRAMES, the last one included.
000B41r 2               ; -----------------------------------------------------------------------------
000B41r 2               AnimShatterBegin:
000B41r 2  A9 00          lda #0
000B43r 2  8D rr rr       sta AnimStep
000B46r 2  A9 02          lda #VFX_FRAMES
000B48r 2  8D rr rr       sta AnimTimer
000B4Br 2  A9 03          lda #PLAY_SHATTER
000B4Dr 2  8D rr rr       sta PlayState
000B50r 2  A9 03          lda #ANIM_SHATTER
000B52r 2  4C rr rr       jmp AnimMarked
000B55r 2               
000B55r 2               ; =============================================================================
000B55r 2               ;   The prism at rest (SPEC 7.3, 14)
000B55r 2               ; =============================================================================
000B55r 2               
000B55r 2               ; -----------------------------------------------------------------------------
000B55r 2               ;   AnimPrismTick — advance the idle rotation, one frame every PRISM_SPIN_RATE
000B55r 2               ;   Out: nothing.  Modifies: A, X, Y, AnimIdx, AnimArg, PrismFrame, PrismTimer
000B55r 2               ;
000B55r 2               ;   The only tile in the game that moves when nothing is happening, and the
000B55r 2               ;   only place other than the petrify that WRITES a tile to the board without
000B55r 2               ;   the board having changed: a prism's cell really does hold WILD_BASE + 0..3
000B55r 2               ;   from here on. Everything that reads a cell masks the colour first, so the
000B55r 2               ;   glyph bits carrying a frame number rather than a zero is invisible to the
000B55r 2               ;   scan, to gravity and to the effects — but it is exactly why P5 made
000B55r 2               ;   EffectEnqueue test the colour before the glyph, and why the petrify below
000B55r 2               ;   does too.
000B55r 2               ;
000B55r 2               ;   IT DOES NOT RUN DURING THE GLOW OR THE SHATTER. A marked prism has to hold
000B55r 2               ;   still for the glow window and then play its blip-out, and it is cheaper to
000B55r 2               ;   stand the whole walk down for those twelve frames than to test every cell
000B55r 2               ;   against MARKS.
000B55r 2               ;
000B55r 2               ;   The walk is the 96 cells of the well every eighth frame whether a prism is
000B55r 2               ;   on the board or not — about 150 cycles a frame amortised, against a board
000B55r 2               ;   scan's eleven thousand. Remembering where the prisms are would cost more
000B55r 2               ;   than it saves, and would have to be kept right through gravity.
000B55r 2               ; -----------------------------------------------------------------------------
000B55r 2               AnimPrismTick:
000B55r 2  AD rr rr       lda PlayState
000B58r 2  C9 02          cmp #PLAY_GLOW
000B5Ar 2  F0 4B          beq @Done
000B5Cr 2  C9 03          cmp #PLAY_SHATTER
000B5Er 2  F0 47          beq @Done
000B60r 2  CE rr rr       dec PrismTimer
000B63r 2  D0 42          bne @Done
000B65r 2               
000B65r 2  A9 08          lda #PRISM_SPIN_RATE
000B67r 2  8D rr rr       sta PrismTimer
000B6Ar 2  EE rr rr       inc PrismFrame
000B6Dr 2  AD rr rr       lda PrismFrame
000B70r 2  29 03          and #(PRISM_SPIN_FRAMES - 1)
000B72r 2  8D rr rr       sta PrismFrame
000B75r 2  09 70          ora #PRISM_SPIN               ; WILD_BASE + frame (SPEC A.3)
000B77r 2  85 rr          sta AnimArg
000B79r 2               
000B79r 2  A9 00          lda #0
000B7Br 2  85 rr          sta AnimIdx
000B7Dr 2               @Cell:
000B7Dr 2  A6 rr          ldx AnimIdx
000B7Fr 2  BD rr rr       lda Board,x
000B82r 2  29 F8          and #COLOR_MASK
000B84r 2  C9 70          cmp #WILD_BASE
000B86r 2  D0 08          bne @Next
000B88r 2  A5 rr          lda AnimArg
000B8Ar 2  9D rr rr       sta Board,x
000B8Dr 2  20 rr rr       jsr RenderCell
000B90r 2               @Next:
000B90r 2  E6 rr          inc AnimIdx
000B92r 2  A5 rr          lda AnimIdx
000B94r 2  29 07          and #(BOARD_STRIDE - 1)
000B96r 2  C9 06          cmp #BOARD_W
000B98r 2  90 07          bcc @Test
000B9Ar 2  A5 rr          lda AnimIdx                   ; Over the two sentinel columns
000B9Cr 2  18             clc
000B9Dr 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000B9Fr 2  85 rr          sta AnimIdx
000BA1r 2               @Test:
000BA1r 2  A5 rr          lda AnimIdx
000BA3r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000BA5r 2  90 D6          bcc @Cell
000BA7r 2               @Done:
000BA7r 2  60             rts
000BA8r 2               
000BA8r 2               ; =============================================================================
000BA8r 2               ;   The message band (SPEC 12.2, 14)
000BA8r 2               ; =============================================================================
000BA8r 2               
000BA8r 2               ; -----------------------------------------------------------------------------
000BA8r 2               ;   AnimBannerShow — put a banner up for BannerFrames
000BA8r 2               ;   In:  Ptr1 -> string      Out: nothing.  Modifies: A, X, Y and the text
000BA8r 2               ;        cursor
000BA8r 2               ; -----------------------------------------------------------------------------
000BA8r 2               AnimBannerShow:
000BA8r 2  20 rr rr       jsr TextBanner
000BABr 2  AE rr rr       ldx Region
000BAEr 2  BD rr rr       lda BannerFrames,x
000BB1r 2  8D rr rr       sta BannerTimer
000BB4r 2  60             rts
000BB5r 2               
000BB5r 2               ; -----------------------------------------------------------------------------
000BB5r 2               ;   AnimBannerTick — one frame of whatever banner is up
000BB5r 2               ;   Out: nothing.  Modifies: A, X, Y
000BB5r 2               ;   Play never stops for a banner: it ticks alongside the sub-states, like the
000BB5r 2               ;   high-score flash it shares its clock with (SPEC 9.8).
000BB5r 2               ; -----------------------------------------------------------------------------
000BB5r 2               AnimBannerTick:
000BB5r 2  AD rr rr       lda BannerTimer
000BB8r 2  F0 08          beq @Done
000BBAr 2  CE rr rr       dec BannerTimer
000BBDr 2  D0 03          bne @Done
000BBFr 2  4C rr rr       jmp TextBannerClear
000BC2r 2               @Done:
000BC2r 2  60             rts
000BC3r 2               
000BC3r 2               ; -----------------------------------------------------------------------------
000BC3r 2               ;   AnimBannerLevel — "~~ LEVEL UP ~~" (SPEC 10.1, 14)
000BC3r 2               ; -----------------------------------------------------------------------------
000BC3r 2               AnimBannerLevel:
000BC3r 2  A9 rr          lda #<MsgLevelUp
000BC5r 2  85 rr          sta Ptr1
000BC7r 2  A9 rr          lda #>MsgLevelUp
000BC9r 2  85 rr          sta Ptr1+1
000BCBr 2  4C rr rr       jmp AnimBannerShow
000BCEr 2               
000BCEr 2               ; -----------------------------------------------------------------------------
000BCEr 2               ;   AnimBannerChain — "~~ CHAIN xN ~~" (SPEC 8 SETTLE, 14)
000BCEr 2               ;   In:  A = links in the cascade      Modifies: A, X, Y and the text cursor
000BCEr 2               ;
000BCEr 2               ;   The banner is a fixed-length string with a placeholder digit, overwritten
000BCEr 2               ;   afterwards at CHAIN_DIGIT_X — which is a constant only because the string
000BCEr 2               ;   is MSG_CHAIN_LEN cells long and TextBanner centres on PANEL_W
000BCEr 2               ;   (constants.inc). A chain past 9 says 9 rather than drawing whatever tile
000BCEr 2               ;   FONT_DIGIT_0 + 10 turns out to be.
000BCEr 2               ; -----------------------------------------------------------------------------
000BCEr 2               AnimBannerChain:
000BCEr 2  C9 0A          cmp #(CHAIN_MAX_SHOWN + 1)
000BD0r 2  90 02          bcc @Show
000BD2r 2  A9 09          lda #CHAIN_MAX_SHOWN
000BD4r 2               @Show:
000BD4r 2  48             pha
000BD5r 2  A9 rr          lda #<MsgChain
000BD7r 2  85 rr          sta Ptr1
000BD9r 2  A9 rr          lda #>MsgChain
000BDBr 2  85 rr          sta Ptr1+1
000BDDr 2  20 rr rr       jsr AnimBannerShow
000BE0r 2  68             pla
000BE1r 2  18             clc
000BE2r 2  69 10          adc #FONT_DIGIT_0
000BE4r 2  A2 0E          ldx #CHAIN_DIGIT_X
000BE6r 2  A0 16          ldy #MSG_Y
000BE8r 2  4C rr rr       jmp RenderMark
000BEBr 2               
000BEBr 2               ; -----------------------------------------------------------------------------
000BEBr 2               ;   AnimBannerOver — "~~ GAME OVER! ~~" (SPEC 13.4 step 3)
000BEBr 2               ;   Nothing takes it down again: StateGameOver does not call AnimBannerTick, so
000BEBr 2               ;   the band holds this until the screen itself ends and GameStart clears it.
000BEBr 2               ; -----------------------------------------------------------------------------
000BEBr 2               AnimBannerOver:
000BEBr 2  A9 rr          lda #<MsgGameOver
000BEDr 2  85 rr          sta Ptr1
000BEFr 2  A9 rr          lda #>MsgGameOver
000BF1r 2  85 rr          sta Ptr1+1
000BF3r 2  4C rr rr       jmp AnimBannerShow
000BF6r 2               
000BF6r 2               ; =============================================================================
000BF6r 2               ;   The title screen (SPEC 13.1)
000BF6r 2               ; =============================================================================
000BF6r 2               ;   Two moving things over one drawn image, and between them they are the whole
000BF6r 2               ;   of the title screen: there are no help pages, because the controls are part
000BF6r 2               ;   of the artwork and a page nobody is reading teaches nothing.
000BF6r 2               ; =============================================================================
000BF6r 2               
000BF6r 2               ; -----------------------------------------------------------------------------
000BF6r 2               ;   AnimTitleBegin — the blink starts lit, with the image the artist drew
000BF6r 2               ;   Out: nothing.  Modifies: A, X
000BF6r 2               ;   Called from the redraw, so entering the title twice in a session cannot
000BF6r 2               ;   leave the prompt dark for the first half period.
000BF6r 2               ; -----------------------------------------------------------------------------
000BF6r 2               AnimTitleBegin:
000BF6r 2  AE rr rr       ldx Region
000BF9r 2  BD rr rr       lda BlinkHalf,x
000BFCr 2  8D rr rr       sta TitleTimer
000BFFr 2  A9 00          lda #0
000C01r 2  8D rr rr       sta TitlePhase                ; The drawn screen already says PRESS FIRE
000C04r 2  60             rts
000C05r 2               
000C05r 2               ; -----------------------------------------------------------------------------
000C05r 2               ;   AnimTitleBlink — one frame of the prompt (SPEC 13.1, 14)
000C05r 2               ;   Out: nothing.  Modifies: A, X, Y, the text cursor, TitleTimer, TitlePhase
000C05r 2               ;
000C05r 2               ;   SPEC 14's blink period is 30 frames NTSC and 25 PAL, and BlinkHalf is half
000C05r 2               ;   of one — the same table and the same shape as the HIGH field's overtake
000C05r 2               ;   flash (score.asm), which is the other thing in the game that blinks. This
000C05r 2               ;   one free-runs instead of counting itself out.
000C05r 2               ; -----------------------------------------------------------------------------
000C05r 2               AnimTitleBlink:
000C05r 2  CE rr rr       dec TitleTimer
000C08r 2  D0 2B          bne @Done
000C0Ar 2  AE rr rr       ldx Region
000C0Dr 2  BD rr rr       lda BlinkHalf,x
000C10r 2  8D rr rr       sta TitleTimer
000C13r 2  AD rr rr       lda TitlePhase
000C16r 2  49 01          eor #$01
000C18r 2  8D rr rr       sta TitlePhase
000C1Br 2  F0 09          beq @Show
000C1Dr 2               
000C1Dr 2  A9 0A          lda #PROMPT_LEN               ; The dark half
000C1Fr 2  A2 06          ldx #PROMPT_X
000C21r 2  A0 0B          ldy #PROMPT_Y
000C23r 2  4C rr rr       jmp TextClearRun
000C26r 2               @Show:
000C26r 2  A9 rr          lda #<MsgPressFire            ; ...and back, byte for byte as the title image
000C28r 2  85 rr          sta Ptr1                      ;   has it (strings.inc)
000C2Ar 2  A9 rr          lda #>MsgPressFire
000C2Cr 2  85 rr          sta Ptr1+1
000C2Er 2  A2 06          ldx #PROMPT_X
000C30r 2  A0 0B          ldy #PROMPT_Y
000C32r 2  4C rr rr       jmp TextDraw
000C35r 2               @Done:
000C35r 2  60             rts
000C36r 2               
000C36r 2               ; -----------------------------------------------------------------------------
000C36r 2               ;   AnimTitleField — one cell of the magic field, every frame (SPEC 13.1)
000C36r 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0, Tmp1
000C36r 2               ;
000C36r 2               ;   Tiles 128-255 are one diagonal hatch in sixteen colours (SPEC Appendix A),
000C36r 2               ;   so writing a random one of them into a random one of the block's 28 cells
000C36r 2               ;   makes the whole block crawl. Two random bytes and one RenderMark: the
000C36r 2               ;   cheapest animation in the game, and the reason the title screen needs no
000C36r 2               ;   art beyond the page it is drawn on.
000C36r 2               ;
000C36r 2               ;   The tile is rolled BEFORE the cell and parked on the stack, because
000C36r 2               ;   RngRange has to be the last call — nothing here may hold a value in
000C36r 2               ;   Tmp0-Tmp3 across it (zeropage.inc).
000C36r 2               ; -----------------------------------------------------------------------------
000C36r 2               AnimTitleField:
000C36r 2  20 rr rr       jsr RngNext
000C39r 2  29 7F          and #(ART_TILES - 1)          ; ART_BASE is 128 and so is ART_TILES, so the
000C3Br 2  09 80          ora #ART_BASE                 ;   range is exactly the top bit set
000C3Dr 2  48             pha
000C3Er 2               
000C3Er 2  A9 1C          lda #FIELD_CELLS
000C40r 2  20 rr rr       jsr RngRange                  ; 0 .. 27, evenly — not a modulo (rng.asm)
000C43r 2  A0 08          ldy #FIELD_Y
000C45r 2  C9 0E          cmp #FIELD_W
000C47r 2  90 03          bcc @Have
000C49r 2  E9 0E          sbc #FIELD_W                  ; C is set by the CMP that got us here
000C4Br 2  C8             iny                           ; The second row of the block
000C4Cr 2               @Have:
000C4Cr 2  18             clc
000C4Dr 2  69 04          adc #FIELD_X
000C4Fr 2  AA             tax                           ; X = panel column, Y = panel row
000C50r 2  68             pla                           ; A = tile
000C51r 2  4C rr rr       jmp RenderMark
000C54r 2               
000C54r 2               ; =============================================================================
000C54r 2               ;   Game over (SPEC 13.4)
000C54r 2               ; =============================================================================
000C54r 2               
000C54r 2               ; -----------------------------------------------------------------------------
000C54r 2               ;   AnimPetrifyBegin — start the well turning to stone from the floor up
000C54r 2               ;   Out: nothing.  Modifies: A
000C54r 2               ; -----------------------------------------------------------------------------
000C54r 2               AnimPetrifyBegin:
000C54r 2  A9 0F          lda #(BOARD_H - 1)
000C56r 2  8D rr rr       sta PetrifyRow
000C59r 2  A9 02          lda #PETRIFY_FRAMES
000C5Br 2  8D rr rr       sta AnimTimer
000C5Er 2  60             rts
000C5Fr 2               
000C5Fr 2               ; -----------------------------------------------------------------------------
000C5Fr 2               ;   AnimPetrifyTick — one frame of it
000C5Fr 2               ;   Out: C set while it is still running, clear once the well is stone.
000C5Fr 2               ;        Modifies: A, X, Y, AnimIdx, AnimEnd, AnimTimer, PetrifyRow, Board
000C5Fr 2               ;   SPEC 13.4 — a row every PETRIFY_FRAMES, bottom upward, 32 frames in all.
000C5Fr 2               ;
000C5Fr 2               ;   Each cell sets as ITS OWN SHAPE, because group 15 holds the petrified
000C5Fr 2               ;   glyphs at the same five offsets the potions use (SPEC A.3): one AND and
000C5Fr 2               ;   one ORA, and a bomb sets as a stone bomb at the exact moment the player is
000C5Fr 2               ;   looking hardest at the board. Empty cells stay empty — the pile petrifies,
000C5Fr 2               ;   not the well.
000C5Fr 2               ;
000C5Fr 2               ;   A prism has no stone twin, so it sets as the plain one. Testing the colour
000C5Fr 2               ;   first is what keeps it off `PETRIFY_BASE + 3`, a stone bomb, which is what
000C5Fr 2               ;   a rotating prism's glyph bits would otherwise buy (AnimPrismTick above).
000C5Fr 2               ; -----------------------------------------------------------------------------
000C5Fr 2               AnimPetrifyTick:
000C5Fr 2  AD rr rr       lda PetrifyRow
000C62r 2  30 42          bmi @Finished                 ; $FF — the whole well is stone
000C64r 2  CE rr rr       dec AnimTimer
000C67r 2  D0 3B          bne @Running
000C69r 2               
000C69r 2  A9 02          lda #PETRIFY_FRAMES
000C6Br 2  8D rr rr       sta AnimTimer
000C6Er 2  AD rr rr       lda PetrifyRow
000C71r 2  0A             asl a                         ; Row base — the board's stride is 8
000C72r 2  0A             asl a
000C73r 2  0A             asl a
000C74r 2  85 rr          sta AnimIdx
000C76r 2  18             clc
000C77r 2  69 06          adc #BOARD_W
000C79r 2  85 rr          sta AnimEnd
000C7Br 2               @Cell:
000C7Br 2  A6 rr          ldx AnimIdx
000C7Dr 2  BD rr rr       lda Board,x
000C80r 2  F0 17          beq @Next                     ; Empty stays empty (SPEC 13.4)
000C82r 2  29 F8          and #COLOR_MASK
000C84r 2  C9 70          cmp #WILD_BASE
000C86r 2  F0 09          beq @Prism
000C88r 2  BD rr rr       lda Board,x
000C8Br 2  29 07          and #GLYPH_MASK
000C8Dr 2  09 78          ora #PETRIFY_BASE
000C8Fr 2  D0 02          bne @Set                      ; Always — PETRIFY_BASE is 120
000C91r 2               @Prism:
000C91r 2  A9 78          lda #PETRIFY_BASE
000C93r 2               @Set:
000C93r 2  9D rr rr       sta Board,x
000C96r 2  20 rr rr       jsr RenderCell
000C99r 2               @Next:
000C99r 2  E6 rr          inc AnimIdx
000C9Br 2  A5 rr          lda AnimIdx
000C9Dr 2  C5 rr          cmp AnimEnd
000C9Fr 2  90 DA          bcc @Cell
000CA1r 2  CE rr rr       dec PetrifyRow
000CA4r 2               @Running:
000CA4r 2  38             sec
000CA5r 2  60             rts
000CA6r 2               @Finished:
000CA6r 2  18             clc
000CA7r 2  60             rts
000CA8r 2               
000CA8r 1               .include "../src/score.asm"
000CA8r 2               ; =============================================================================
000CA8r 2               ;   score.asm — Wizards Lab, scoring
000CA8r 2               ; =============================================================================
000CA8r 2               ;   SPEC.md section 9. Seven digits of packed BCD in four bytes, low byte
000CA8r 2               ;   first; the top nibble of ScoreTop is held at zero. Every value in
000CA8r 2               ;   tables.inc is a multiple of ten, so scoring is a SED / ADC chain and never
000CA8r 2               ;   a multiply — the one place a tile count has to be multiplied by a table
000CA8r 2               ;   value, it is done as a loop of BCD additions, and the count is at most 21.
000CA8r 2               ;
000CA8r 2               ;   The score clamps at 9999999. It never wraps.
000CA8r 2               ;
000CA8r 2               ;   Display is always all seven digits, zero padded — see TextBcd. Nothing
000CA8r 2               ;   here strips a leading zero, and nothing downstream may either.
000CA8r 2               ;
000CA8r 2               ;   TWO WAYS IN, AND THEY ARE NOT INTERCHANGEABLE (D5):
000CA8r 2               ;
000CA8r 2               ;     CascadeAdd / CascadeAddTimes    points scored INSIDE a cascade. They go
000CA8r 2               ;                                     into Cascade{Lo,Mid,Hi} and stay there
000CA8r 2               ;                                     until CascadeSettle, because a star
000CA8r 2               ;                                     caught anywhere in the cascade doubles
000CA8r 2               ;                                     everything it scored, retroactively
000CA8r 2               ;                                     (SPEC 9.6).
000CA8r 2               ;     ScoreAward                      the awards SPEC 9.6 gives outside a
000CA8r 2               ;                                     cascade — the soft drop and the level-up
000CA8r 2               ;                                     bonus. These reach Score at once and a
000CA8r 2               ;                                     star never touches them.
000CA8r 2               ;
000CA8r 2               ;   Both funnel through ScoreBank, which is the only routine that writes
000CA8r 2               ;   Score, the only one that clamps, and the only one that can hand the high
000CA8r 2               ;   score over to the player.
000CA8r 2               ; =============================================================================
000CA8r 2               
000CA8r 2               ; -----------------------------------------------------------------------------
000CA8r 2               ;   ScoreHighInit — seed the session high score, once, at power-on
000CA8r 2               ;   SPEC 9.8 — the high score is not persisted; it starts at 0010000 on every
000CA8r 2               ;   power-on, which is the target the first game is played against. It then
000CA8r 2               ;   survives every game in the session, so this is deliberately NOT part of
000CA8r 2               ;   ScoreReset. Nothing may infer "cold boot" from the value being zero: BSS
000CA8r 2               ;   is not cleared on all three machines.
000CA8r 2               ;   Out: nothing.  Modifies: A
000CA8r 2               ; -----------------------------------------------------------------------------
000CA8r 2               ScoreHighInit:
000CA8r 2  A9 00          lda #HIGH_INIT_LO
000CAAr 2  8D rr rr       sta HighLo
000CADr 2  A9 00          lda #HIGH_INIT_MID
000CAFr 2  8D rr rr       sta HighMid
000CB2r 2  A9 01          lda #HIGH_INIT_HI
000CB4r 2  8D rr rr       sta HighHi
000CB7r 2  A9 00          lda #HIGH_INIT_TOP
000CB9r 2  8D rr rr       sta HighTop
000CBCr 2  A9 01          lda #$01                      ; BCD — the level the target was "set" on
000CBEr 2  8D rr rr       sta HighLevel
000CC1r 2  60             rts
000CC2r 2               
000CC2r 2               ; -----------------------------------------------------------------------------
000CC2r 2               ;   ScoreReset — zero the score for a new game
000CC2r 2               ;   Out: nothing.  Modifies: A
000CC2r 2               ;
000CC2r 2               ;   The high score itself is NOT reset (SPEC 9.8) — but the two flags that say
000CC2r 2               ;   what this game has done about it are, or the second game of a session
000CC2r 2               ;   would never flash.
000CC2r 2               ; -----------------------------------------------------------------------------
000CC2r 2               ScoreReset:
000CC2r 2  A9 00          lda #0
000CC4r 2  8D rr rr       sta ScoreLo
000CC7r 2  8D rr rr       sta ScoreMid
000CCAr 2  8D rr rr       sta ScoreHi
000CCDr 2  8D rr rr       sta ScoreTop
000CD0r 2  8D rr rr       sta CascadeLo
000CD3r 2  8D rr rr       sta CascadeMid
000CD6r 2  8D rr rr       sta CascadeHi
000CD9r 2  8D rr rr       sta StarCount
000CDCr 2  8D rr rr       sta HighOwned
000CDFr 2  8D rr rr       sta HighFlash
000CE2r 2  8D rr rr       sta HighTimer
000CE5r 2  60             rts
000CE6r 2               
000CE6r 2               ; -----------------------------------------------------------------------------
000CE6r 2               ;   CascadeAdd — add a 16-bit BCD value to the cascade accumulator
000CE6r 2               ;   In:  A = low BCD byte, X = high BCD byte
000CE6r 2               ;   Out: nothing.  Modifies: A, flags.  PRESERVES X and Y.
000CE6r 2               ;
000CE6r 2               ;   Preserving X and Y is what lets CascadeAddTimes loop over this without
000CE6r 2               ;   spilling anything, and Tmp0-Tmp3 may not be held across a JSR anyway
000CE6r 2               ;   (zeropage.inc).
000CE6r 2               ; -----------------------------------------------------------------------------
000CE6r 2               CascadeAdd:
000CE6r 2  F8             sed
000CE7r 2  18             clc
000CE8r 2  6D rr rr       adc CascadeLo
000CEBr 2  8D rr rr       sta CascadeLo
000CEEr 2  8A             txa
000CEFr 2  6D rr rr       adc CascadeMid
000CF2r 2  8D rr rr       sta CascadeMid
000CF5r 2  AD rr rr       lda CascadeHi
000CF8r 2  69 00          adc #0
000CFAr 2  8D rr rr       sta CascadeHi
000CFDr 2  D8             cld                           ; CLD leaves the carry alone
000CFEr 2  B0 01          bcs CascadeClamp
000D00r 2  60             rts
000D01r 2               
000D01r 2               ; -----------------------------------------------------------------------------
000D01r 2               ;   CascadeClamp — six nines, when an accumulate would have wrapped
000D01r 2               ;   Out: nothing.  Modifies: A.  PRESERVES X and Y.
000D01r 2               ;
000D01r 2               ;   Not reachable by playing: nothing is ever ADDED to the board during a
000D01r 2               ;   cascade, so one cascade can never remove more than the 96 cells the well
000D01r 2               ;   holds, and 96 cells at the dearest tile value there is (650, SPEC 9.2)
000D01r 2               ;   plus every bonus in section 9 comes to a little over 200,000 — a fifth of
000D01r 2               ;   what three bytes hold, and an eighth of what it would take to wrap after
000D01r 2               ;   the star cap has doubled it three times. It is here because "never wraps"
000D01r 2               ;   in SPEC 9 has to be true of every accumulator on the path, not just of the
000D01r 2               ;   one the player can see.
000D01r 2               ; -----------------------------------------------------------------------------
000D01r 2               CascadeClamp:
000D01r 2  A9 99          lda #$99
000D03r 2  8D rr rr       sta CascadeLo
000D06r 2  8D rr rr       sta CascadeMid
000D09r 2  8D rr rr       sta CascadeHi
000D0Cr 2  60             rts
000D0Dr 2               
000D0Dr 2               ; -----------------------------------------------------------------------------
000D0Dr 2               ;   CascadeAddTimes — add a value N times (the tiles-cleared multiply)
000D0Dr 2               ;   In:  A = low BCD, X = high BCD, Y = count
000D0Dr 2               ;   Out: nothing.  Modifies: A, Y, flags.  PRESERVES X.
000D0Dr 2               ;
000D0Dr 2               ;   SPEC 9 chose values that are all multiples of ten so that scoring is an
000D0Dr 2               ;   ADC chain, but `length * TileValue[chain]` is still a multiply. The count
000D0Dr 2               ;   is a run length — three to sixteen — so a loop of BCD additions is both
000D0Dr 2               ;   smaller and, at these counts, faster than any multiply routine worth
000D0Dr 2               ;   writing.
000D0Dr 2               ; -----------------------------------------------------------------------------
000D0Dr 2               CascadeAddTimes:
000D0Dr 2  48             pha                           ; The low byte rides the stack, because
000D0Er 2               @Loop:                          ;   CascadeAdd returns in A
000D0Er 2  C0 00          cpy #0
000D10r 2  F0 08          beq @Done
000D12r 2  68             pla
000D13r 2  48             pha
000D14r 2  20 rr rr       jsr CascadeAdd
000D17r 2  88             dey
000D18r 2  D0 F4          bne @Loop
000D1Ar 2               @Done:
000D1Ar 2  68             pla
000D1Br 2  60             rts
000D1Cr 2               
000D1Cr 2               ; -----------------------------------------------------------------------------
000D1Cr 2               ;   CascadeDouble — one BCD doubling of the cascade accumulator
000D1Cr 2               ;   Out: nothing.  Modifies: A, flags.  PRESERVES X and Y.
000D1Cr 2               ;   A doubling in BCD is a self-addition; three of them is the star cap.
000D1Cr 2               ; -----------------------------------------------------------------------------
000D1Cr 2               CascadeDouble:
000D1Cr 2  F8             sed
000D1Dr 2  18             clc
000D1Er 2  AD rr rr       lda CascadeLo
000D21r 2  6D rr rr       adc CascadeLo
000D24r 2  8D rr rr       sta CascadeLo
000D27r 2  AD rr rr       lda CascadeMid
000D2Ar 2  6D rr rr       adc CascadeMid
000D2Dr 2  8D rr rr       sta CascadeMid
000D30r 2  AD rr rr       lda CascadeHi
000D33r 2  6D rr rr       adc CascadeHi
000D36r 2  8D rr rr       sta CascadeHi
000D39r 2  D8             cld
000D3Ar 2  B0 C5          bcs CascadeClamp
000D3Cr 2  60             rts
000D3Dr 2               
000D3Dr 2               ; -----------------------------------------------------------------------------
000D3Dr 2               ;   ScoreAdd — bank the cascade accumulator into Score, clamped
000D3Dr 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
000D3Dr 2               ;   SPEC 9.8 — the high score updates live, so the player watches the overtake.
000D3Dr 2               ; -----------------------------------------------------------------------------
000D3Dr 2               ScoreAdd:
000D3Dr 2  AD rr rr       lda CascadeLo
000D40r 2  85 rr          sta Tmp0
000D42r 2  AD rr rr       lda CascadeMid
000D45r 2  85 rr          sta Tmp1
000D47r 2  AD rr rr       lda CascadeHi
000D4Ar 2  85 rr          sta Tmp2
000D4Cr 2  4C rr rr       jmp ScoreBank
000D4Fr 2               
000D4Fr 2               ; -----------------------------------------------------------------------------
000D4Fr 2               ;   ScoreAward — add a 16-bit BCD value straight to Score
000D4Fr 2               ;   In:  A = low BCD byte, X = high BCD byte
000D4Fr 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
000D4Fr 2               ;
000D4Fr 2               ;   The two awards SPEC 9.6 gives outside a cascade: one point a row for a
000D4Fr 2               ;   soft drop, and BONUS_LEVELUP when the level advances. Neither is a cascade
000D4Fr 2               ;   point and neither is doubled by a star, which is the whole reason they do
000D4Fr 2               ;   not go through CascadeAdd.
000D4Fr 2               ; -----------------------------------------------------------------------------
000D4Fr 2               ScoreAward:
000D4Fr 2  85 rr          sta Tmp0
000D51r 2  86 rr          stx Tmp1
000D53r 2  A9 00          lda #0
000D55r 2  85 rr          sta Tmp2
000D57r 2                 ; falls through into ScoreBank
000D57r 2               
000D57r 2               ; -----------------------------------------------------------------------------
000D57r 2               ;   ScoreBank — Score += the three BCD bytes in Tmp0-Tmp2, clamped at 9999999
000D57r 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
000D57r 2               ;
000D57r 2               ;   The only writer of Score. It redraws the field itself, because there is no
000D57r 2               ;   other moment at which the score is known to have changed (SPEC 12.6 —
000D57r 2               ;   nothing polls).
000D57r 2               ; -----------------------------------------------------------------------------
000D57r 2               ScoreBank:
000D57r 2  F8             sed
000D58r 2  18             clc
000D59r 2  AD rr rr       lda ScoreLo
000D5Cr 2  65 rr          adc Tmp0
000D5Er 2  8D rr rr       sta ScoreLo
000D61r 2  AD rr rr       lda ScoreMid
000D64r 2  65 rr          adc Tmp1
000D66r 2  8D rr rr       sta ScoreMid
000D69r 2  AD rr rr       lda ScoreHi
000D6Cr 2  65 rr          adc Tmp2
000D6Er 2  8D rr rr       sta ScoreHi
000D71r 2  AD rr rr       lda ScoreTop
000D74r 2  69 00          adc #0
000D76r 2  8D rr rr       sta ScoreTop
000D79r 2  D8             cld                           ; CLD leaves the carry alone
000D7Ar 2  B0 07          bcs @Clamp
000D7Cr 2  AD rr rr       lda ScoreTop                  ; The eighth digit is held at zero (SPEC 9),
000D7Fr 2  C9 10          cmp #$10                      ;   so anything that reached it has overflowed
000D81r 2  90 10          bcc @Drawn                    ;   the seven the panel shows
000D83r 2               @Clamp:
000D83r 2  A9 99          lda #$99
000D85r 2  8D rr rr       sta ScoreLo
000D88r 2  8D rr rr       sta ScoreMid
000D8Br 2  8D rr rr       sta ScoreHi
000D8Er 2  A9 09          lda #$09
000D90r 2  8D rr rr       sta ScoreTop
000D93r 2               @Drawn:
000D93r 2  20 rr rr       jsr RenderScore
000D96r 2                 ; falls through into ScoreHighCheck
000D96r 2               
000D96r 2               ; -----------------------------------------------------------------------------
000D96r 2               ;   ScoreHighCheck — hand the high score over the moment the score reaches it
000D96r 2               ;   Out: C set if the score is level with or past the high score — which, once
000D96r 2               ;        it has been taken, is EVERY call. The one-shot is HighOwned below, not
000D96r 2               ;        this flag; nothing currently reads it.  Modifies: A, X, Y, Tmp0
000D96r 2               ;
000D96r 2               ;   SPEC 9.8. The copy happens on every call once the score is level with the
000D96r 2               ;   high score, not just on the first — that is what keeps HighLevel tracking
000D96r 2               ;   the live level while a run is holding its own record, which is the point of
000D96r 2               ;   the number: it says how deep you have to get to beat it.
000D96r 2               ;
000D96r 2               ;   The fanfare and the flash are the one-shot half, and HighOwned is what
000D96r 2               ;   makes them one: without it every subsequent bank would fire them again,
000D96r 2               ;   because from the overtake onward the score and the high score are equal.
000D96r 2               ; -----------------------------------------------------------------------------
000D96r 2               ScoreHighCheck:
000D96r 2  AD rr rr       lda HighTop                   ; Four-byte compare, most significant first
000D99r 2  CD rr rr       cmp ScoreTop
000D9Cr 2  D0 16          bne @Test
000D9Er 2  AD rr rr       lda HighHi
000DA1r 2  CD rr rr       cmp ScoreHi
000DA4r 2  D0 0E          bne @Test
000DA6r 2  AD rr rr       lda HighMid
000DA9r 2  CD rr rr       cmp ScoreMid
000DACr 2  D0 06          bne @Test
000DAEr 2  AD rr rr       lda HighLo
000DB1r 2  CD rr rr       cmp ScoreLo
000DB4r 2               @Test:
000DB4r 2  90 02          bcc @Take                     ; high < score
000DB6r 2  D0 3E          bne @Behind                   ; high > score — nothing to do
000DB8r 2                                               ; equal: still copy, so HighLevel tracks
000DB8r 2               @Take:
000DB8r 2  AD rr rr       lda ScoreLo
000DBBr 2  8D rr rr       sta HighLo
000DBEr 2  AD rr rr       lda ScoreMid
000DC1r 2  8D rr rr       sta HighMid
000DC4r 2  AD rr rr       lda ScoreHi
000DC7r 2  8D rr rr       sta HighHi
000DCAr 2  AD rr rr       lda ScoreTop
000DCDr 2  8D rr rr       sta HighTop
000DD0r 2  20 rr rr       jsr ScoreLevelBcd             ; The level box under the digits is BCD; Level
000DD3r 2  8D rr rr       sta HighLevel                 ;   itself is binary (SPEC 12.2)
000DD6r 2  20 rr rr       jsr RenderHigh
000DD9r 2               
000DD9r 2  AD rr rr       lda HighOwned
000DDCr 2  D0 16          bne @Owned
000DDEr 2  EE rr rr       inc HighOwned
000DE1r 2  A9 0B          lda #SFX_HIGHSCORE            ; SPEC 9.8 — a longer fanfare, once
000DE3r 2  20 rr rr       jsr SfxPlay
000DE6r 2  A9 06          lda #HIGH_FLASH_BLINKS
000DE8r 2  8D rr rr       sta HighFlash
000DEBr 2  AE rr rr       ldx Region
000DEEr 2  BD rr rr       lda BlinkHalf,x
000DF1r 2  8D rr rr       sta HighTimer
000DF4r 2               @Owned:
000DF4r 2  38             sec
000DF5r 2  60             rts
000DF6r 2               
000DF6r 2               @Behind:
000DF6r 2  18             clc
000DF7r 2  60             rts
000DF8r 2               
000DF8r 2               ; -----------------------------------------------------------------------------
000DF8r 2               ;   ScoreLevelBcd — Level (binary 1-99) as one packed BCD byte
000DF8r 2               ;   Out: A = the level in BCD.  Modifies: A, X, Tmp0
000DF8r 2               ; -----------------------------------------------------------------------------
000DF8r 2               ScoreLevelBcd:
000DF8r 2  AD rr rr       lda Level
000DFBr 2  A2 00          ldx #0
000DFDr 2               @Tens:
000DFDr 2  C9 0A          cmp #10
000DFFr 2  90 05          bcc @Split
000E01r 2  E9 0A          sbc #10                       ; Carry is set by the CMP that got us here
000E03r 2  E8             inx
000E04r 2  D0 F7          bne @Tens                     ; Always — X tops out at 9
000E06r 2               @Split:
000E06r 2  85 rr          sta Tmp0                      ; Units
000E08r 2  8A             txa
000E09r 2  0A             asl a
000E0Ar 2  0A             asl a
000E0Br 2  0A             asl a
000E0Cr 2  0A             asl a
000E0Dr 2  05 rr          ora Tmp0
000E0Fr 2  60             rts
000E10r 2               
000E10r 2               ; -----------------------------------------------------------------------------
000E10r 2               ;   ScoreSoftDrop — one point for one row descended under soft drop (SPEC 9.6)
000E10r 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0-Tmp2
000E10r 2               ;
000E10r 2               ;   The one award in the game that is not a multiple of ten. BCD does not care.
000E10r 2               ; -----------------------------------------------------------------------------
000E10r 2               ScoreSoftDrop:
000E10r 2  A9 01          lda #$01
000E12r 2  A2 00          ldx #$00
000E14r 2  4C rr rr       jmp ScoreAward
000E17r 2               
000E17r 2               ; -----------------------------------------------------------------------------
000E17r 2               ;   ScoreLevelCheck — advance the level when 30 tiles have gone
000E17r 2               ;   In:  A = tiles removed this step
000E17r 2               ;   Out: C set if the level advanced.  Modifies: A, X, Y, Tmp0-Tmp2
000E17r 2               ;   SPEC 10.1 — at most one advance per step, surplus carries over, so a big
000E17r 2               ;   fireball chain can never skip a level. Match and effect removals both
000E17r 2               ;   count, which is why the count comes from CascadeRemove and not from the
000E17r 2               ;   scan: by then the two are the same cells.
000E17r 2               ; -----------------------------------------------------------------------------
000E17r 2               ScoreLevelCheck:
000E17r 2  18             clc
000E18r 2  6D rr rr       adc TilesCleared
000E1Br 2  8D rr rr       sta TilesCleared              ; A whole step can clear far more than thirty;
000E1Er 2  C9 1E          cmp #LEVEL_TILES              ;   the surplus stays here and buys the next
000E20r 2  90 23          bcc @No                       ;   level on the next step
000E22r 2  E9 1E          sbc #LEVEL_TILES              ; Carry is set by the CMP that got us here
000E24r 2  8D rr rr       sta TilesCleared
000E27r 2               
000E27r 2  AD rr rr       lda Level
000E2Ar 2  C9 63          cmp #LEVEL_MAX_SHOWN
000E2Cr 2  B0 17          bcs @No                       ; The box is two digits wide (SPEC 10.1), and
000E2Er 2  EE rr rr       inc Level                     ;   nothing about level 100 is reachable in a
000E31r 2  20 rr rr       jsr RenderLevel               ;   session anyway
000E34r 2  20 rr rr       jsr AnimBannerLevel           ; SPEC 14 — and play carries straight on; the
000E37r 2                                               ;   band clears itself BannerFrames later
000E37r 2  A9 0A          lda #SFX_LEVELUP
000E39r 2  20 rr rr       jsr SfxPlay
000E3Cr 2  A9 00          lda #<BONUS_LEVELUP           ; SPEC 9.6 — an award, not a cascade point, so
000E3Er 2  A2 10          ldx #>BONUS_LEVELUP           ;   a star in the same cascade does not double
000E40r 2  20 rr rr       jsr ScoreAward                ;   it (D5)
000E43r 2  38             sec
000E44r 2  60             rts
000E45r 2               @No:
000E45r 2  18             clc
000E46r 2  60             rts
000E47r 2               
000E47r 2               ; -----------------------------------------------------------------------------
000E47r 2               ;   ScoreFlashTick — one frame of the HIGH field's overtake flash
000E47r 2               ;   Out: nothing.  Modifies: A, X, Y
000E47r 2               ;   SPEC 9.8, SPEC 14 — the blink period is 30 frames NTSC / 25 PAL, shared
000E47r 2               ;   with the title screen's prompt, so HighFlash counts HALF blinks and
000E47r 2               ;   HighTimer counts the frames of one.
000E47r 2               ;
000E47r 2               ;   HighFlash is odd on the dark half and even on the lit one, and it ends at
000E47r 2               ;   zero, so the field is always left readable however the count is set.
000E47r 2               ; -----------------------------------------------------------------------------
000E47r 2               ScoreFlashTick:
000E47r 2  AD rr rr       lda HighFlash
000E4Ar 2  F0 1F          beq @Done
000E4Cr 2  CE rr rr       dec HighTimer
000E4Fr 2  D0 1A          bne @Done
000E51r 2  CE rr rr       dec HighFlash
000E54r 2  F0 12          beq @Show                     ; Out of blinks — end lit
000E56r 2  AE rr rr       ldx Region
000E59r 2  BD rr rr       lda BlinkHalf,x
000E5Cr 2  8D rr rr       sta HighTimer
000E5Fr 2  AD rr rr       lda HighFlash
000E62r 2  4A             lsr a
000E63r 2  90 03          bcc @Show
000E65r 2  4C rr rr       jmp RenderHighBlank
000E68r 2               @Show:
000E68r 2  4C rr rr       jmp RenderHigh
000E6Br 2               @Done:
000E6Br 2  60             rts
000E6Cr 2               
000E6Cr 2               ; -----------------------------------------------------------------------------
000E6Cr 2               ;   ScoreGravity — frames per row for the current level
000E6Cr 2               ;   Out: A = frame count, from SpeedNTSC or SpeedPAL per Region.
000E6Cr 2               ;        Modifies: A, X
000E6Cr 2               ;   SPEC 10.2. Strictly this module is P4's, but the falling piece cannot fall
000E6Cr 2               ;   without it, so it is real ahead of the rest of the file — the same reason
000E6Cr 2               ;   ScoreHighInit landed here in P1.
000E6Cr 2               ; -----------------------------------------------------------------------------
000E6Cr 2               ScoreGravity:
000E6Cr 2  AE rr rr       ldx Level
000E6Fr 2  CA             dex                           ; The table is indexed by level - 1 ...
000E70r 2  E0 10          cpx #LEVEL_SPEED_CAP
000E72r 2  90 02          bcc @Level
000E74r 2  A2 0F          ldx #LEVEL_SPEED_CAP - 1      ;   ... and stops improving at the cap
000E76r 2               @Level:
000E76r 2  AD rr rr       lda Region
000E79r 2  D0 04          bne @Pal
000E7Br 2  BD rr rr       lda SpeedNTSC,x
000E7Er 2  60             rts
000E7Fr 2               @Pal:
000E7Fr 2  BD rr rr       lda SpeedPAL,x
000E82r 2  60             rts
000E83r 2               
000E83r 1               .include "../src/render.asm"
000E83r 2               ; =============================================================================
000E83r 2               ;   render.asm — Wizards Lab, the dirty-cell renderer
000E83r 2               ; =============================================================================
000E83r 2               ;   SPEC.md section 12.6. The screen is never fully redrawn during play.
000E83r 2               ;   Changed cells are appended to a ring and flushed once a frame, at most
000E83r 2               ;   DIRTY_FLUSH_MAX per frame with the remainder carried over.
000E83r 2               ;
000E83r 2               ;   The cap is NOT a hardware write-spacing limit. S1 measured this loop at
000E83r 2               ;   165 cycles a cell on the AC6502, which puts two VRAM data writes 165 us
000E83r 2               ;   apart at 1 MHz and the closest two VDP PORT accesses 8 cycles apart —
000E83r 2               ;   inside even a real TMS9918A's 8 us and 2 us windows with two orders of
000E83r 2               ;   magnitude to spare, and further inside a pico9918's, which emulates VRAM
000E83r 2               ;   in RP2040 memory and has no display contention at all. A 6502 at this
000E83r 2               ;   clock cannot write a TMS9918 too fast however hard it tries.
000E83r 2               ;
000E83r 2               ;   The cap is a TIME BUDGET: DIRTY_FLUSH_MAX cells is what fits in vertical
000E83r 2               ;   blank on the tightest of the three. See constants.inc and PLAN.md S1.
000E83r 2               ;
000E83r 2               ;   All screen access goes through HalPlotCell (see hal.inc). Nothing in this
000E83r 2               ;   file knows where screen memory is.
000E83r 2               ; =============================================================================
000E83r 2               
000E83r 2               ; -----------------------------------------------------------------------------
000E83r 2               ;   RenderDirtyReset — empty the ring and cancel any outstanding board redraw
000E83r 2               ;   Call this after anything that draws the whole screen behind the renderer's
000E83r 2               ;   back (HalBlitScreen), because every queued cell then describes a screen
000E83r 2               ;   that no longer exists.
000E83r 2               ;   In:  nothing        Out: nothing.  Modifies: A
000E83r 2               ; -----------------------------------------------------------------------------
000E83r 2               RenderDirtyReset:
000E83r 2  A9 00          lda #0
000E85r 2  8D rr rr       sta DirtyCount
000E88r 2  8D rr rr       sta DirtyHead
000E8Br 2  8D rr rr       sta DirtyTail
000E8Er 2  8D rr rr       sta RedrawWash
000E91r 2  A9 FF          lda #$FF
000E93r 2  8D rr rr       sta RedrawIdx
000E96r 2  60             rts
000E97r 2               
000E97r 2               ; -----------------------------------------------------------------------------
000E97r 2               ;   RenderMark — queue one panel cell
000E97r 2               ;   In:  A = tile, X = panel column, Y = panel row
000E97r 2               ;   Out: nothing.  Modifies: A, X.  PRESERVES Y and every byte of zero page.
000E97r 2               ;
000E97r 2               ;   The PANEL_X / PANEL_Y offset is applied here, once, so nothing upstream
000E97r 2               ;   has to know which machine it is running on.
000E97r 2               ;
000E97r 2               ;   Preserving Y and zero page is a contract, not an accident: text.asm holds
000E97r 2               ;   its string cursor across this call (see zeropage.inc). The three values
000E97r 2               ;   ride the stack rather than scratch bytes because A, X and Y are all live
000E97r 2               ;   at once and there is no fourth register to index the ring with.
000E97r 2               ;
000E97r 2               ;   A mark that arrives with the ring full is DROPPED, silently (D6).
000E97r 2               ; -----------------------------------------------------------------------------
000E97r 2               RenderMark:
000E97r 2  48             pha                           ; Tile
000E98r 2  98             tya
000E99r 2  18             clc
000E9Ar 2  69 00          adc #PANEL_Y                  ; Panel row -> screen row
000E9Cr 2  48             pha
000E9Dr 2  8A             txa
000E9Er 2  18             clc
000E9Fr 2  69 00          adc #PANEL_X                  ; Panel column -> screen column
000EA1r 2  48             pha
000EA2r 2               
000EA2r 2  AD rr rr       lda DirtyCount
000EA5r 2  C9 40          cmp #DIRTY_ENTRIES
000EA7r 2  B0 1F          bcs @Full
000EA9r 2  EE rr rr       inc DirtyCount
000EACr 2               
000EACr 2  AE rr rr       ldx DirtyTail
000EAFr 2  68             pla
000EB0r 2  9D rr rr       sta Dirty+0,x                 ; Screen column
000EB3r 2  68             pla
000EB4r 2  9D rr rr       sta Dirty+1,x                 ; Screen row
000EB7r 2  68             pla
000EB8r 2  9D rr rr       sta Dirty+2,x                 ; Tile
000EBBr 2               
000EBBr 2  E8             inx                           ; Step one entry, wrapping the ring
000EBCr 2  E8             inx
000EBDr 2  E8             inx
000EBEr 2  E0 C0          cpx #DIRTY_BYTES
000EC0r 2  90 02          bcc @Store
000EC2r 2  A2 00          ldx #0
000EC4r 2               @Store:
000EC4r 2  8E rr rr       stx DirtyTail
000EC7r 2  60             rts
000EC8r 2               
000EC8r 2               @Full:
000EC8r 2  68             pla                           ; Unwind and drop it. The cell is wrong until
000EC9r 2  68             pla                           ;   something marks it again.
000ECAr 2  68             pla
000ECBr 2  60             rts
000ECCr 2               
000ECCr 2               ; -----------------------------------------------------------------------------
000ECCr 2               ;   RenderFlush — push up to DIRTY_FLUSH_MAX queued cells to the screen
000ECCr 2               ;   Called once per frame, from the top of the main loop.
000ECCr 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
000ECCr 2               ; -----------------------------------------------------------------------------
000ECCr 2               RenderFlush:
000ECCr 2  20 rr rr       jsr RenderBoardStep           ; Top the ring up from a board redraw, if one
000ECFr 2                                               ;   is outstanding, so it always makes progress
000ECFr 2  AD rr rr       lda DirtyCount
000ED2r 2  F0 31          beq @Done
000ED4r 2  C9 18          cmp #DIRTY_FLUSH_MAX
000ED6r 2  90 02          bcc @Budget
000ED8r 2  A9 18          lda #DIRTY_FLUSH_MAX
000EDAr 2               @Budget:
000EDAr 2  85 rr          sta FlushLeft
000EDCr 2               
000EDCr 2               @Cell:
000EDCr 2  AE rr rr       ldx DirtyHead
000EDFr 2  BD rr rr       lda Dirty+1,x
000EE2r 2  A8             tay                           ; Y = screen row
000EE3r 2  BD rr rr       lda Dirty+2,x
000EE6r 2  48             pha                           ; Tile
000EE7r 2  BD rr rr       lda Dirty+0,x
000EEAr 2  AA             tax                           ; X = screen column
000EEBr 2  68             pla                           ; A = tile
000EECr 2  20 rr rr       jsr HalPlotCell
000EEFr 2               
000EEFr 2  AD rr rr       lda DirtyHead                 ; Step one entry, wrapping the ring
000EF2r 2  18             clc
000EF3r 2  69 03          adc #3
000EF5r 2  C9 C0          cmp #DIRTY_BYTES
000EF7r 2  90 02          bcc @Store
000EF9r 2  A9 00          lda #0
000EFBr 2               @Store:
000EFBr 2  8D rr rr       sta DirtyHead
000EFEr 2  CE rr rr       dec DirtyCount
000F01r 2  C6 rr          dec FlushLeft
000F03r 2  D0 D7          bne @Cell
000F05r 2               @Done:
000F05r 2  60             rts
000F06r 2               
000F06r 2               ; -----------------------------------------------------------------------------
000F06r 2               ;   RenderBoard — ask for the whole 6 x 16 well to be redrawn
000F06r 2               ;   Used on state entry and after a pause, not per frame.
000F06r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000F06r 2               ;
000F06r 2               ;   The well is 96 cells and the ring holds DIRTY_ENTRIES; a redraw therefore
000F06r 2               ;   cannot be queued in one go. This only sets the cursor. RenderBoardStep,
000F06r 2               ;   which RenderFlush calls every frame, feeds the ring as fast as it drains,
000F06r 2               ;   so the redraw spreads over as many frames as it needs and never drops a
000F06r 2               ;   cell.
000F06r 2               ; -----------------------------------------------------------------------------
000F06r 2               RenderBoard:
000F06r 2  A9 00          lda #0
000F08r 2  8D rr rr       sta RedrawWash                ; From the board, not the PAUSE wash
000F0Br 2  8D rr rr       sta RedrawIdx                 ; Board index 0 = row 0, column 0
000F0Er 2  60             rts                           ; And nothing else. Falling through into the
000F0Fr 2                                               ;   step below would fill the ring here and
000F0Fr 2                                               ;   drop whatever the caller marks next.
000F0Fr 2               
000F0Fr 2               ; -----------------------------------------------------------------------------
000F0Fr 2               ;   RenderWash — ask for the well to be covered rather than shown
000F0Fr 2               ;   In:  nothing        Out: nothing.  Modifies: A
000F0Fr 2               ;   SPEC 13.3 — pausing washes all 96 cells with TILE_WASH so the board cannot
000F0Fr 2               ;   be studied while the clock is stopped. A wash and not a blank: a blanked
000F0Fr 2               ;   well reads as a crash, a stippled one reads as covered.
000F0Fr 2               ;
000F0Fr 2               ;   The same cursor as RenderBoard, because it is the same 96 cells against
000F0Fr 2               ;   the same 64-entry ring, and it is undone the same way — the resume calls
000F0Fr 2               ;   RenderBoard, which turns the flag off and repaints every cell from the
000F0Fr 2               ;   board it never stopped being (D12).
000F0Fr 2               ; -----------------------------------------------------------------------------
000F0Fr 2               RenderWash:
000F0Fr 2  A9 07          lda #TILE_WASH
000F11r 2  8D rr rr       sta RedrawWash
000F14r 2  A9 00          lda #0
000F16r 2  8D rr rr       sta RedrawIdx
000F19r 2  60             rts
000F1Ar 2               
000F1Ar 2               ; -----------------------------------------------------------------------------
000F1Ar 2               ;   RenderBoardStep — queue as much of an outstanding board redraw as fits
000F1Ar 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000F1Ar 2               ;   Does nothing when RedrawIdx is $FF.
000F1Ar 2               ; -----------------------------------------------------------------------------
000F1Ar 2               RenderBoardStep:
000F1Ar 2  AD rr rr       lda RedrawIdx
000F1Dr 2  30 46          bmi @Done                     ; $FF — nothing outstanding
000F1Fr 2               
000F1Fr 2               @Cell:
000F1Fr 2  AD rr rr       lda DirtyCount
000F22r 2  C9 40          cmp #DIRTY_ENTRIES
000F24r 2  B0 3F          bcs @Done                     ; Ring full — pick this cell up next frame
000F26r 2               
000F26r 2  AE rr rr       ldx RedrawIdx
000F29r 2  8A             txa
000F2Ar 2  29 07          and #(BOARD_STRIDE - 1)
000F2Cr 2  18             clc
000F2Dr 2  69 01          adc #WELL_ORIGIN_X
000F2Fr 2  85 rr          sta RedrawCol
000F31r 2  8A             txa
000F32r 2  4A             lsr a                         ; Board index >> 3 is the row (stride 8)
000F33r 2  4A             lsr a
000F34r 2  4A             lsr a
000F35r 2  18             clc
000F36r 2  69 04          adc #WELL_ORIGIN_Y
000F38r 2  A8             tay                           ; Y = panel row
000F39r 2  AD rr rr       lda RedrawWash                ; The PAUSE wash is the same walk drawing one
000F3Cr 2  D0 03          bne @Tile                     ;   tile over every cell instead (SPEC 13.3)
000F3Er 2  BD rr rr       lda Board,x                   ; The board byte IS the tile — empty is $00,
000F41r 2               @Tile:                          ;   which is TILE_BLANK (SPEC 3.3, 4.2)
000F41r 2  A6 rr          ldx RedrawCol
000F43r 2  20 rr rr       jsr RenderMark
000F46r 2               
000F46r 2  AE rr rr       ldx RedrawIdx                 ; Advance, stepping over the two sentinel
000F49r 2  E8             inx                           ;   columns at the end of each row
000F4Ar 2  8A             txa
000F4Br 2  29 07          and #(BOARD_STRIDE - 1)
000F4Dr 2  C9 06          cmp #BOARD_W
000F4Fr 2  90 05          bcc @Save
000F51r 2  8A             txa
000F52r 2  18             clc
000F53r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000F55r 2  AA             tax
000F56r 2               @Save:
000F56r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
000F58r 2  B0 06          bcs @Finish
000F5Ar 2  8E rr rr       stx RedrawIdx
000F5Dr 2  4C rr rr       jmp @Cell
000F60r 2               
000F60r 2               @Finish:
000F60r 2  A9 FF          lda #$FF
000F62r 2  8D rr rr       sta RedrawIdx
000F65r 2               @Done:
000F65r 2  60             rts
000F66r 2               
000F66r 2               ; -----------------------------------------------------------------------------
000F66r 2               ;   RenderCell — queue one board cell by board index
000F66r 2               ;   In:  X = board index (row * BOARD_STRIDE + column)
000F66r 2               ;   Out: nothing.  Modifies: A, X, Y
000F66r 2               ;   The single-cell form of RenderBoardStep, for the phases that move one tile
000F66r 2               ;   at a time.
000F66r 2               ; -----------------------------------------------------------------------------
000F66r 2               RenderCell:
000F66r 2  BD rr rr       lda Board,x                   ; The board byte IS the tile (SPEC 3.3)
000F69r 2                 ; falls through
000F69r 2               
000F69r 2               ; -----------------------------------------------------------------------------
000F69r 2               ;   RenderCellAs — queue one board cell showing something else entirely
000F69r 2               ;   In:  X = board index, A = tile
000F69r 2               ;   Out: nothing.  Modifies: A, X, Y
000F69r 2               ;
000F69r 2               ;   The animation frames are the only tiles in the game that are NOT what the
000F69r 2               ;   board holds: a glow glyph, a beam, a ring frame and a blip frame are all
000F69r 2               ;   drawn over a cell whose board byte still says what it really is, right up
000F69r 2               ;   until CascadeRemove zeroes it (anim.asm, SPEC 8 step 5). Everything else
000F69r 2               ;   goes through RenderCell above and never has to think about it.
000F69r 2               ; -----------------------------------------------------------------------------
000F69r 2               RenderCellAs:
000F69r 2  48             pha
000F6Ar 2  8A             txa
000F6Br 2  29 07          and #(BOARD_STRIDE - 1)
000F6Dr 2  18             clc
000F6Er 2  69 01          adc #WELL_ORIGIN_X
000F70r 2  85 rr          sta RedrawCol
000F72r 2  8A             txa
000F73r 2  4A             lsr a
000F74r 2  4A             lsr a
000F75r 2  4A             lsr a
000F76r 2  18             clc
000F77r 2  69 04          adc #WELL_ORIGIN_Y
000F79r 2  A8             tay
000F7Ar 2  68             pla
000F7Br 2  A6 rr          ldx RedrawCol
000F7Dr 2  4C rr rr       jmp RenderMark
000F80r 2               
000F80r 2               ; -----------------------------------------------------------------------------
000F80r 2               ;   RenderPiece — queue the three falling cells at where the piece is now
000F80r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000F80r 2               ;
000F80r 2               ;   RenderMark clobbers X and keeps Y, so the panel column is parked in
000F80r 2               ;   RedrawCol and the panel row rides Y down the three cells. Cell C can never
000F80r 2               ;   be lower than board row 15, so all three are always inside the well and
000F80r 2               ;   there is nothing to clip.
000F80r 2               ; -----------------------------------------------------------------------------
000F80r 2               RenderPiece:
000F80r 2  AD rr rr       lda PieceCol
000F83r 2  18             clc
000F84r 2  69 01          adc #WELL_ORIGIN_X
000F86r 2  85 rr          sta RedrawCol
000F88r 2  AD rr rr       lda PieceRow
000F8Br 2  18             clc
000F8Cr 2  69 04          adc #WELL_ORIGIN_Y
000F8Er 2  A8             tay
000F8Fr 2  AD rr rr       lda PieceA
000F92r 2  A6 rr          ldx RedrawCol
000F94r 2  20 rr rr       jsr RenderMark
000F97r 2  C8             iny
000F98r 2  AD rr rr       lda PieceB
000F9Br 2  A6 rr          ldx RedrawCol
000F9Dr 2  20 rr rr       jsr RenderMark
000FA0r 2  C8             iny
000FA1r 2  AD rr rr       lda PieceC
000FA4r 2  A6 rr          ldx RedrawCol
000FA6r 2  4C rr rr       jmp RenderMark
000FA9r 2               
000FA9r 2               ; -----------------------------------------------------------------------------
000FA9r 2               ;   RenderPieceErase — blank the three cells the piece is leaving
000FA9r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000FA9r 2               ;
000FA9r 2               ;   Three blanks rather than three board reads, because the cells under a
000FA9r 2               ;   falling piece are always empty: every move and every gravity step tests
000FA9r 2               ;   the target cells before it happens, and the one thing that writes them is
000FA9r 2               ;   PieceLock, after which nothing erases the piece again (piece.asm).
000FA9r 2               ; -----------------------------------------------------------------------------
000FA9r 2               RenderPieceErase:
000FA9r 2  AD rr rr       lda PieceCol
000FACr 2  18             clc
000FADr 2  69 01          adc #WELL_ORIGIN_X
000FAFr 2  85 rr          sta RedrawCol
000FB1r 2  AD rr rr       lda PieceRow
000FB4r 2  18             clc
000FB5r 2  69 04          adc #WELL_ORIGIN_Y
000FB7r 2  A8             tay
000FB8r 2  A9 00          lda #TILE_EMPTY
000FBAr 2  A6 rr          ldx RedrawCol
000FBCr 2  20 rr rr       jsr RenderMark
000FBFr 2  C8             iny
000FC0r 2  A9 00          lda #TILE_EMPTY
000FC2r 2  A6 rr          ldx RedrawCol
000FC4r 2  20 rr rr       jsr RenderMark
000FC7r 2  C8             iny
000FC8r 2  A9 00          lda #TILE_EMPTY
000FCAr 2  A6 rr          ldx RedrawCol
000FCCr 2  4C rr rr       jmp RenderMark
000FCFr 2               
000FCFr 2               ; -----------------------------------------------------------------------------
000FCFr 2               ;   RenderNext — the preview, panel column NEXT_X, rows NEXT_Y..NEXT_Y+2
000FCFr 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000FCFr 2               ;
000FCFr 2               ;   All three cells every time. The play screen image ships with a piece
000FCFr 2               ;   already drawn in the NEXT box (SPEC 12.1), so this has to overwrite rather
000FCFr 2               ;   than assume it is drawing onto backdrop.
000FCFr 2               ; -----------------------------------------------------------------------------
000FCFr 2               RenderNext:
000FCFr 2  A0 10          ldy #NEXT_Y
000FD1r 2  AD rr rr       lda NextA
000FD4r 2  A2 0B          ldx #NEXT_X
000FD6r 2  20 rr rr       jsr RenderMark
000FD9r 2  C8             iny
000FDAr 2  AD rr rr       lda NextB
000FDDr 2  A2 0B          ldx #NEXT_X
000FDFr 2  20 rr rr       jsr RenderMark
000FE2r 2  C8             iny
000FE3r 2  AD rr rr       lda NextC
000FE6r 2  A2 0B          ldx #NEXT_X
000FE8r 2  4C rr rr       jmp RenderMark
000FEBr 2               
000FEBr 2               ; -----------------------------------------------------------------------------
000FEBr 2               ;   RenderScore / RenderHigh / RenderLevel — only called when a value changes
000FEBr 2               ;   Nothing here compares anything: the caller knows when it changed a value
000FEBr 2               ;   and these are not cheap enough to run every frame. SCORE_DIGITS cells is
000FEBr 2               ;   most of a frame's flush budget on its own.
000FEBr 2               ; -----------------------------------------------------------------------------
000FEBr 2               RenderScore:
000FEBr 2  A9 rr          lda #<ScoreLo
000FEDr 2  85 rr          sta Ptr1
000FEFr 2  A9 rr          lda #>ScoreLo
000FF1r 2  85 rr          sta Ptr1+1
000FF3r 2  A2 0C          ldx #SCORE_X
000FF5r 2  A0 05          ldy #SCORE_Y
000FF7r 2  A9 07          lda #SCORE_DIGITS
000FF9r 2  4C rr rr       jmp TextBcd
000FFCr 2               
000FFCr 2               RenderHigh:
000FFCr 2  A9 rr          lda #<HighLo
000FFEr 2  85 rr          sta Ptr1
001000r 2  A9 rr          lda #>HighLo
001002r 2  85 rr          sta Ptr1+1
001004r 2  A2 0C          ldx #HIGH_X
001006r 2  A0 0A          ldy #HIGH_Y
001008r 2  A9 07          lda #SCORE_DIGITS
00100Ar 2  20 rr rr       jsr TextBcd
00100Dr 2               
00100Dr 2  A9 rr          lda #<HighLevel               ; The level it was set on, under the digits
00100Fr 2  85 rr          sta Ptr1
001011r 2  A9 rr          lda #>HighLevel
001013r 2  85 rr          sta Ptr1+1
001015r 2  A2 0F          ldx #HIGHLVL_X
001017r 2  A0 0B          ldy #HIGHLVL_Y
001019r 2  A9 02          lda #LEVEL_DIGITS
00101Br 2  4C rr rr       jmp TextBcd
00101Er 2               
00101Er 2               ; -----------------------------------------------------------------------------
00101Er 2               ;   RenderHighBlank — the dark half of the HIGH field's overtake flash
00101Er 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y, TextCol
00101Er 2               ;   SPEC 9.8. The seven digits only; the level under them stays put, so the
00101Er 2               ;   box never looks empty and the flash costs seven cells of the budget.
00101Er 2               ; -----------------------------------------------------------------------------
00101Er 2               RenderHighBlank:
00101Er 2  A9 07          lda #SCORE_DIGITS
001020r 2  A2 0C          ldx #HIGH_X
001022r 2  A0 0A          ldy #HIGH_Y
001024r 2  4C rr rr       jmp TextClearRun
001027r 2               
001027r 2               RenderLevel:
001027r 2  AD rr rr       lda Level
00102Ar 2  4C rr rr       jmp TextLevel
00102Dr 2               
00102Dr 1               .include "../src/text.asm"
00102Dr 2               ; =============================================================================
00102Dr 2               ;   text.asm — Wizards Lab, text and numbers on the panel
00102Dr 2               ; =============================================================================
00102Dr 2               ;   The font lives in tile groups 2-6, forty glyphs in the order
00102Dr 2               ;
00102Dr 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
00102Dr 2               ;
00102Dr 2               ;   starting at FONT_BASE, so a digit is FONT_DIGIT_0 + value and a letter is
00102Dr 2               ;   FONT_LETTER_A + (letter - 'A'). Strings are stored pre-converted to tile
00102Dr 2               ;   numbers, terminated by TEXT_END, so drawing one is a copy with no
00102Dr 2               ;   translation. src/strings.inc holds them and the macro that encodes them.
00102Dr 2               ;
00102Dr 2               ;   Everything here draws through RenderMark, never to the screen: text is
00102Dr 2               ;   panel cells like any other and goes through the same one flush a frame.
00102Dr 2               ;   That is also why the cursor state lives in the zero-page block RenderMark
00102Dr 2               ;   promises not to touch (zeropage.inc) rather than in Tmp0-Tmp3.
00102Dr 2               ; =============================================================================
00102Dr 2               
00102Dr 2               ; -----------------------------------------------------------------------------
00102Dr 2               ;   TextDraw — draw a tile-encoded string
00102Dr 2               ;   In:  Ptr1 -> string (TEXT_END terminated), X = panel column, Y = panel row
00102Dr 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx
00102Dr 2               ; -----------------------------------------------------------------------------
00102Dr 2               TextDraw:
00102Dr 2  86 rr          stx TextCol
00102Fr 2  84 rr          sty TextRow
001031r 2  A9 00          lda #0
001033r 2  85 rr          sta TextIdx
001035r 2               @Char:
001035r 2  A4 rr          ldy TextIdx
001037r 2  B1 rr          lda (Ptr1),y
001039r 2  C9 FF          cmp #TEXT_END
00103Br 2  F0 0D          beq @Done
00103Dr 2  A6 rr          ldx TextCol
00103Fr 2  A4 rr          ldy TextRow
001041r 2  20 rr rr       jsr RenderMark
001044r 2  E6 rr          inc TextCol
001046r 2  E6 rr          inc TextIdx
001048r 2  D0 EB          bne @Char                     ; Always — a string is never 256 tiles long
00104Ar 2               @Done:
00104Ar 2  60             rts
00104Br 2               
00104Br 2               ; -----------------------------------------------------------------------------
00104Br 2               ;   TextBcd — draw a packed-BCD number, zero padded
00104Br 2               ;   In:  Ptr1 -> BCD bytes (low first), A = digit count,
00104Br 2               ;        X = panel column, Y = panel row
00104Br 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx, TextByte,
00104Br 2               ;        TextSkip
00104Br 2               ;
00104Br 2               ;   SCORE_DIGITS (7) for the score and the high score, 2 for the high score's
00104Br 2               ;   level. The LEVEL box is not drawn with this — see TextLevel.
00104Br 2               ;
00104Br 2               ;   The count is in DIGITS, not bytes, because the score is seven digits in
00104Br 2               ;   four bytes: the top nibble of the most significant byte is held at zero
00104Br 2               ;   (SPEC 9) and must not be drawn, or the field would be eight cells wide and
00104Br 2               ;   no longer centred. An odd count starts at the LOW nibble of the top byte.
00104Br 2               ;
00104Br 2               ;   **Every digit is drawn, every time.** A leading zero is a zero glyph, not
00104Br 2               ;   a blank: 1250 draws as 0001250. There is no suppression pass and no
00104Br 2               ;   right-alignment — the field is fixed width so a digit never changes
00104Br 2               ;   column while the player is watching it (SPEC 9). This also makes the
00104Br 2               ;   routine branchless, and lets RenderScore mark a fixed run of cells dirty.
00104Br 2               ; -----------------------------------------------------------------------------
00104Br 2               TextBcd:
00104Br 2  86 rr          stx TextCol
00104Dr 2  84 rr          sty TextRow
00104Fr 2  48             pha                           ; Digit count
001050r 2  29 01          and #$01
001052r 2  85 rr          sta TextSkip                  ; Odd count: the top high nibble is not drawn
001054r 2  68             pla
001055r 2  18             clc
001056r 2  69 01          adc #1                        ; Bytes = (digits + 1) / 2
001058r 2  4A             lsr a
001059r 2  AA             tax
00105Ar 2  CA             dex
00105Br 2  86 rr          stx TextIdx                   ; Start at the most significant byte
00105Dr 2               
00105Dr 2               @Byte:
00105Dr 2  A4 rr          ldy TextIdx
00105Fr 2  B1 rr          lda (Ptr1),y
001061r 2  85 rr          sta TextByte
001063r 2               
001063r 2  A5 rr          lda TextSkip
001065r 2  D0 09          bne @Low
001067r 2  A5 rr          lda TextByte
001069r 2  4A             lsr a
00106Ar 2  4A             lsr a
00106Br 2  4A             lsr a
00106Cr 2  4A             lsr a
00106Dr 2  20 rr rr       jsr TextDigit
001070r 2               @Low:
001070r 2  A9 00          lda #0
001072r 2  85 rr          sta TextSkip
001074r 2  A5 rr          lda TextByte
001076r 2  29 0F          and #$0F
001078r 2  20 rr rr       jsr TextDigit
00107Br 2               
00107Br 2  C6 rr          dec TextIdx
00107Dr 2  10 DE          bpl @Byte
00107Fr 2  60             rts
001080r 2               
001080r 2               ; -----------------------------------------------------------------------------
001080r 2               ;   TextDigit — draw one digit at the cursor and step it right
001080r 2               ;   In:  A = value 0-9      Modifies: A, X, Y, TextCol
001080r 2               ; -----------------------------------------------------------------------------
001080r 2               TextDigit:
001080r 2  18             clc
001081r 2  69 10          adc #FONT_DIGIT_0
001083r 2  A6 rr          ldx TextCol
001085r 2  A4 rr          ldy TextRow
001087r 2  20 rr rr       jsr RenderMark
00108Ar 2  E6 rr          inc TextCol
00108Cr 2  60             rts
00108Dr 2               
00108Dr 2               ; -----------------------------------------------------------------------------
00108Dr 2               ;   TextBanner — centre a string in the one-row message band
00108Dr 2               ;   In:  Ptr1 -> string
00108Dr 2               ;   Out: nothing.  Modifies: A, X, Y and the text cursor
00108Dr 2               ;
00108Dr 2               ;   SPEC 12.2 — the band is panel row MSG_Y, full width, one row only. The
00108Dr 2               ;   string arrives already wrapped as `~~ TEXT ~~` — two FONT_TILDE, a blank,
00108Dr 2               ;   the text, a blank, two FONT_TILDE. Centring is (PANEL_W - length) / 2,
00108Dr 2               ;   which is why banner strings are drawn even-length.
00108Dr 2               ;
00108Dr 2               ;   THE BAND EITHER SIDE OF THE STRING IS BLANKED, and only that. Banners are
00108Dr 2               ;   not all the same width — `~~ PAUSED ~~` is two cells narrower than
00108Dr 2               ;   `~~ LEVEL UP ~~`, which is exactly what pausing during a level-up meets —
00108Dr 2               ;   so a shorter one drawn straight over a longer one would leave the tail of
00108Dr 2               ;   the old ornament sitting either side of it. Blanking the WHOLE band first
00108Dr 2               ;   would fix that too, and cost 18 marks on top of the string's: past
00108Dr 2               ;   DIRTY_FLUSH_MAX, so every banner in the game would take an extra frame to
00108Dr 2               ;   arrive. Blanking the margins costs only the cells the string is not
00108Dr 2               ;   covering — six for the narrowest banner in the game, two for the widest.
00108Dr 2               ; -----------------------------------------------------------------------------
00108Dr 2               TextBanner:
00108Dr 2  A0 00          ldy #0
00108Fr 2               @Len:
00108Fr 2  B1 rr          lda (Ptr1),y
001091r 2  C9 FF          cmp #TEXT_END
001093r 2  F0 03          beq @Got
001095r 2  C8             iny
001096r 2  D0 F7          bne @Len
001098r 2               @Got:
001098r 2  98             tya
001099r 2  85 rr          sta TextIdx
00109Br 2  A9 16          lda #PANEL_W
00109Dr 2  38             sec
00109Er 2  E5 rr          sbc TextIdx
0010A0r 2  4A             lsr a                         ; (PANEL_W - length) / 2
0010A1r 2  85 rr          sta TextByte                  ; Where the string starts...
0010A3r 2  18             clc
0010A4r 2  65 rr          adc TextIdx
0010A6r 2  85 rr          sta TextSkip                  ; ...and one cell past where it ends. Neither
0010A8r 2                                               ;   is TextCol / TextRow / TextIdx, because
0010A8r 2                                               ;   TextClearRun below takes those
0010A8r 2               
0010A8r 2  A5 rr          lda TextByte                  ; The band to the left of it
0010AAr 2  38             sec
0010ABr 2  E9 02          sbc #MSG_X
0010ADr 2  F0 07          beq @Right
0010AFr 2  A2 02          ldx #MSG_X
0010B1r 2  A0 16          ldy #MSG_Y
0010B3r 2  20 rr rr       jsr TextClearRun
0010B6r 2               @Right:
0010B6r 2  A9 14          lda #(MSG_X + MSG_W)          ; ...and to the right
0010B8r 2  38             sec
0010B9r 2  E5 rr          sbc TextSkip
0010BBr 2  F0 07          beq @Draw
0010BDr 2  A6 rr          ldx TextSkip
0010BFr 2  A0 16          ldy #MSG_Y
0010C1r 2  20 rr rr       jsr TextClearRun
0010C4r 2               @Draw:
0010C4r 2  A6 rr          ldx TextByte
0010C6r 2  A0 16          ldy #MSG_Y
0010C8r 2  4C rr rr       jmp TextDraw
0010CBr 2               
0010CBr 2               ; -----------------------------------------------------------------------------
0010CBr 2               ;   TextBannerClear — blank the message band back to backdrop
0010CBr 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx
0010CBr 2               ;
0010CBr 2               ;   Columns MSG_X .. MSG_X + MSG_W - 1 only. The shelf tiles at either end of
0010CBr 2               ;   the band belong to the static screen image and are never redrawn.
0010CBr 2               ; -----------------------------------------------------------------------------
0010CBr 2               TextBannerClear:
0010CBr 2  A9 12          lda #MSG_W
0010CDr 2  A2 02          ldx #MSG_X
0010CFr 2  A0 16          ldy #MSG_Y
0010D1r 2                 ; falls through
0010D1r 2               
0010D1r 2               ; -----------------------------------------------------------------------------
0010D1r 2               ;   TextClearRun — blank a horizontal run of panel cells
0010D1r 2               ;   In:  A = width (never 0), X = panel column, Y = panel row
0010D1r 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx
0010D1r 2               ;
0010D1r 2               ;   Three callers wanted this loop with different numbers in it: the message
0010D1r 2               ;   band above, the HIGH field's dark half (SPEC 9.8) and the title screen's
0010D1r 2               ;   blinking prompt (SPEC 13.1). The cursor is in memory for the usual reason —
0010D1r 2               ;   RenderMark clobbers A and X and keeps only Y (D13).
0010D1r 2               ; -----------------------------------------------------------------------------
0010D1r 2               TextClearRun:
0010D1r 2  85 rr          sta TextIdx                   ; Cells left
0010D3r 2  86 rr          stx TextCol
0010D5r 2  84 rr          sty TextRow
0010D7r 2               @Cell:
0010D7r 2  A9 00          lda #TILE_BLANK
0010D9r 2  A6 rr          ldx TextCol
0010DBr 2  A4 rr          ldy TextRow
0010DDr 2  20 rr rr       jsr RenderMark
0010E0r 2  E6 rr          inc TextCol
0010E2r 2  C6 rr          dec TextIdx
0010E4r 2  D0 F1          bne @Cell
0010E6r 2  60             rts
0010E7r 2               
0010E7r 2               ; -----------------------------------------------------------------------------
0010E7r 2               ;   TextLevel — the LEVEL box, tens above units in one column
0010E7r 2               ;   In:  A = level (binary, 1-99)
0010E7r 2               ;   Out: nothing.  Modifies: A, X, Y, TextByte
0010E7r 2               ;   SPEC 12.2 — LEVEL_X, tens at LEVEL_Y and units at LEVEL_Y + 1. Always two
0010E7r 2               ;   digits: level 5 draws "0" over "5".
0010E7r 2               ; -----------------------------------------------------------------------------
0010E7r 2               TextLevel:
0010E7r 2  A2 00          ldx #0
0010E9r 2               @Tens:
0010E9r 2  C9 0A          cmp #10
0010EBr 2  90 05          bcc @Split
0010EDr 2  E9 0A          sbc #10                       ; Carry is set by the CMP that got us here
0010EFr 2  E8             inx
0010F0r 2  D0 F7          bne @Tens                     ; Always — X tops out at 9
0010F2r 2               @Split:
0010F2r 2  85 rr          sta TextByte                  ; Units
0010F4r 2  8A             txa
0010F5r 2  18             clc
0010F6r 2  69 10          adc #FONT_DIGIT_0
0010F8r 2  A2 12          ldx #LEVEL_X
0010FAr 2  A0 11          ldy #LEVEL_Y
0010FCr 2  20 rr rr       jsr RenderMark
0010FFr 2  A5 rr          lda TextByte
001101r 2  18             clc
001102r 2  69 10          adc #FONT_DIGIT_0
001104r 2  A2 12          ldx #LEVEL_X
001106r 2  A0 12          ldy #LEVEL_Y + 1
001108r 2  4C rr rr       jmp RenderMark
00110Br 2               
00110Br 1               .include "../src/audio.asm"
00110Br 2               ; =============================================================================
00110Br 2               ;   audio.asm — Wizards Lab, sound
00110Br 2               ; =============================================================================
00110Br 2               ;   SPEC.md section 16. Twelve effects, one channel, and none of it knows what
00110Br 2               ;   a sound chip is: an effect is a list of STEPS in ROM (tables.inc), a step
00110Br 2               ;   is a duration, a timbre and a note, and pushing one at the hardware is
00110Br 2               ;   HalSfx's whole job (hal.inc).
00110Br 2               ;
00110Br 2               ;   That split is the opposite way round from the one SPEC 16 assumed. It said
00110Br 2               ;   the AC6502 and the C64 would share a SID driver and the VIC-20 would need
00110Br 2               ;   its own, which is true of the twenty lines that write registers and of
00110Br 2               ;   nothing else: the sequencing, the priority, the envelope of an effect
00110Br 2               ;   across frames and every note in the game are the same on all three, so
00110Br 2               ;   they live here and are shared by all three rather than by two (PLAN.md
00110Br 2               ;   D22). What each platform still owns is a note table and five stores.
00110Br 2               ;
00110Br 2               ;   ONE CHANNEL. The id is the priority — SPEC 16 lists the twelve from the
00110Br 2               ;   quietest event to the loudest — so a request takes the channel only if its
00110Br 2               ;   id is at least the id of what is already playing. That is what keeps the
00110Br 2               ;   move blip out of the middle of a fireball, and it is why SfxPlay exists
00110Br 2               ;   rather than logic storing into SfxRequest: a lock, a match and a bomb can
00110Br 2               ;   all be requested in ONE frame, and last-write-wins would pick whichever
00110Br 2               ;   the code happened to reach last.
00110Br 2               ;
00110Br 2               ;   AND ONE LEVEL. Neither sound chip has a per-voice volume, so "quieter"
00110Br 2               ;   cannot be a property of a note: it is a master register the platform writes
00110Br 2               ;   on its way past, and the byte that carries the choice to it is the timbre,
00110Br 2               ;   bit 7 (constants.inc). Nothing the GAME plays ever sets it. It exists for
00110Br 2               ;   the title screen, which plays the same twelve effects at half volume
00110Br 2               ;   underneath a cauldron (ambience.asm).
00110Br 2               ;
00110Br 2               ;   Nothing here waits, loops over cells, or touches the screen. AudioTick is
00110Br 2               ;   fifteen cycles on a frame where nothing changes and a step's worth of
00110Br 2               ;   register writes on a frame where something does, so it cannot delay a
00110Br 2               ;   frame however the frame is going.
00110Br 2               ; =============================================================================
00110Br 2               
00110Br 2               ; -----------------------------------------------------------------------------
00110Br 2               ;   AudioInit — silence, and whatever the sound chip needs to be told once
00110Br 2               ;   Out: nothing.  Modifies: A, X
00110Br 2               ; -----------------------------------------------------------------------------
00110Br 2               AudioInit:
00110Br 2  A9 00          lda #0
00110Dr 2  8D rr rr       sta SfxRequest
001110r 2  8D rr rr       sta SfxId
001113r 2  8D rr rr       sta SfxTimer
001116r 2  8D rr rr       sta SfxShift
001119r 2  8D rr rr       sta SfxStepIdx
00111Cr 2  8D rr rr       sta SfxLevel                  ; Full volume, and no ambience — the title
00111Fr 2                                               ;   screen turns both on for itself
00111Fr 2  A2 00          ldx #0
001121r 2  A9 00          lda #TIMBRE_OFF
001123r 2  4C rr rr       jmp HalSfx
001126r 2               
001126r 2               ; -----------------------------------------------------------------------------
001126r 2               ;   SfxPlay — ask for an effect
001126r 2               ;   In:  A = SFX_* id
001126r 2               ;   Out: nothing.  Modifies: A only — X, Y and zero page are untouched, because
001126r 2               ;        half the callers are in the middle of a walk that is holding a cursor
001126r 2               ;        in a register (cascade.asm).
001126r 2               ;
001126r 2               ;   The loudest request in a frame is the one that survives, and the id is the
001126r 2               ;   loudness. A quieter one is not queued for later: by the next frame the
001126r 2               ;   event it belonged to is over.
001126r 2               ; -----------------------------------------------------------------------------
001126r 2               SfxPlay:
001126r 2  CD rr rr       cmp SfxRequest
001129r 2  90 03          bcc @Done                     ; Something at least as loud is already asked
00112Br 2  8D rr rr       sta SfxRequest                ;   for this frame
00112Er 2               @Done:
00112Er 2  60             rts
00112Fr 2               
00112Fr 2               ; -----------------------------------------------------------------------------
00112Fr 2               ;   AudioTick — one frame of sound. Called from the bottom of the main loop.
00112Fr 2               ;   Out: nothing.  Modifies: A, X, Y
00112Fr 2               ; -----------------------------------------------------------------------------
00112Fr 2               AudioTick:
00112Fr 2  AD rr rr       lda SfxRequest
001132r 2  F0 0D          beq @Advance                  ; Nothing asked for — carry on with what plays
001134r 2  A2 00          ldx #0
001136r 2  8E rr rr       stx SfxRequest                ; Consumed either way: a request that loses is
001139r 2  CD rr rr       cmp SfxId                     ;   dropped, not held over
00113Cr 2  90 03          bcc @Advance
00113Er 2  4C rr rr       jmp SfxBegin
001141r 2               
001141r 2               @Advance:
001141r 2  AD rr rr       lda SfxId
001144r 2  F0 09          beq @Idle                     ; Silent...
001146r 2  CE rr rr       dec SfxTimer
001149r 2  D0 03          bne @Done                     ; The step still has frames left in it
00114Br 2  4C rr rr       jmp SfxStep                   ; ...and when it does not, the next one starts
00114Er 2               @Done:
00114Er 2  60             rts
00114Fr 2               
00114Fr 2               @Idle:                          ; ...and silence is where the title screen puts
00114Fr 2  4C rr rr       jmp AmbienceTick              ;   its cauldron. Nine cycles and an RTS in
001152r 2                                               ;   play, where the ambience is off
001152r 2               
001152r 2               ; -----------------------------------------------------------------------------
001152r 2               ;   SfxBegin — start an effect from its first step
001152r 2               ;   In:  A = SFX_* id
001152r 2               ;   Out: nothing.  Modifies: A, X, Y
001152r 2               ;
001152r 2               ;   Eleven of the twelve play at the pitch tables.inc wrote them at. The match
001152r 2               ;   chime is the one SPEC 16 says rises with the chain, and it rises by
001152r 2               ;   transposing the whole effect rather than by having a step list per depth —
001152r 2               ;   which is the whole of what this routine does before it hands over to
001152r 2               ;   SfxBeginShifted below.
001152r 2               ; -----------------------------------------------------------------------------
001152r 2               SfxBegin:
001152r 2  A2 00          ldx #0
001154r 2  C9 04          cmp #SFX_MATCH
001156r 2  D0 12          bne SfxBeginShifted
001158r 2               
001158r 2  48             pha                           ; The id; SfxBeginShifted wants it in A
001159r 2  AD rr rr       lda ChainStep                 ; 1 on the first step of a cascade (SPEC 8)
00115Cr 2  F0 0B          beq @Flat                     ; Never zero in practice; X is already 0
00115Er 2  38             sec
00115Fr 2  E9 01          sbc #1
001161r 2  0A             asl a                         ; SFX_CHAIN_SHIFT semitones a link
001162r 2  C9 09          cmp #(SFX_CHAIN_MAX + 1)
001164r 2  90 02          bcc @Capped
001166r 2  A9 08          lda #SFX_CHAIN_MAX
001168r 2               @Capped:
001168r 2  AA             tax
001169r 2               @Flat:
001169r 2  68             pla
00116Ar 2                 ; falls through
00116Ar 2               
00116Ar 2               ; -----------------------------------------------------------------------------
00116Ar 2               ;   SfxBeginShifted — start an effect transposed by a given number of semitones
00116Ar 2               ;   In:  A = SFX_* id, X = semitones to add to every note of it
00116Ar 2               ;   Out: nothing.  Modifies: A, X, Y
00116Ar 2               ;
00116Ar 2               ;   Split out of SfxBegin for the title screen's ambience, which pitches every
00116Ar 2               ;   bubble by a fresh random amount and would otherwise have to write SfxShift
00116Ar 2               ;   after SfxBegin had already played the first step at the wrong pitch
00116Ar 2               ;   (ambience.asm). It takes the channel unconditionally and is not a request:
00116Ar 2               ;   the only caller outside SfxBegin knows the channel is silent because it is
00116Ar 2               ;   only reached on a frame where it was.
00116Ar 2               ; -----------------------------------------------------------------------------
00116Ar 2               SfxBeginShifted:
00116Ar 2  8D rr rr       sta SfxId
00116Dr 2  8E rr rr       stx SfxShift
001170r 2  AE rr rr       ldx SfxId
001173r 2  BD rr rr       lda SfxOffsets - 1,x          ; The id is 1-based; the table is not
001176r 2  8D rr rr       sta SfxStepIdx
001179r 2                 ; falls through into the first step
001179r 2               
001179r 2               ; -----------------------------------------------------------------------------
001179r 2               ;   SfxStep — play the step at SfxStepIdx and advance past it
001179r 2               ;   Out: nothing.  Modifies: A, X, Y
001179r 2               ;   A zero frame count is the end of the effect and returns the channel to
001179r 2               ;   silence — which is a real event on a SID, where it is the gate coming down.
001179r 2               ; -----------------------------------------------------------------------------
001179r 2               SfxStep:
001179r 2  AE rr rr       ldx SfxStepIdx
00117Cr 2  BD rr rr       lda SfxSteps,x
00117Fr 2  F0 25          beq @End
001181r 2  8D rr rr       sta SfxTimer
001184r 2               
001184r 2  BD rr rr       lda SfxSteps + 2,x            ; The note...
001187r 2  18             clc
001188r 2  6D rr rr       adc SfxShift                  ;   ...transposed, for the match chime
00118Br 2  C9 25          cmp #(NOTE_MAX + 1)
00118Dr 2  90 02          bcc @Note
00118Fr 2  A9 24          lda #NOTE_MAX                 ; Both note tables stop at C6 and a chain deep
001191r 2               @Note:                          ;   enough to push past it clamps rather than
001191r 2  A8             tay                           ;   reading off the end of one
001192r 2  BD rr rr       lda SfxSteps + 1,x            ; The timbre...
001195r 2  0D rr rr       ora SfxLevel                  ;   ...and how loud, which is bit 7 of the same
001198r 2                                               ;   byte and is zero for everything the game
001198r 2                                               ;   itself plays (constants.inc). A step whose
001198r 2                                               ;   timbre is TIMBRE_OFF — a rest — comes out of
001198r 2                                               ;   here as $80, and every HalSfx masks the bit
001198r 2                                               ;   off before it looks, so a quiet rest is
001198r 2                                               ;   still a rest
001198r 2  48             pha
001199r 2  8A             txa
00119Ar 2  18             clc
00119Br 2  69 03          adc #SFX_STEP_BYTES
00119Dr 2  8D rr rr       sta SfxStepIdx
0011A0r 2  98             tya
0011A1r 2  AA             tax                           ; X = note
0011A2r 2  68             pla                           ; A = timbre
0011A3r 2  4C rr rr       jmp HalSfx
0011A6r 2               
0011A6r 2               @End:
0011A6r 2  A9 00          lda #0
0011A8r 2  8D rr rr       sta SfxId
0011ABr 2  A2 00          ldx #0
0011ADr 2  AD rr rr       lda SfxLevel                  ; TIMBRE_OFF at the level the channel is AT, and
0011B0r 2                                               ;   TIMBRE_OFF is zero, so the level is the
0011B0r 2                                               ;   whole byte. Letting go at full volume
0011B0r 2                                               ;   instead would put the master register back
0011B0r 2                                               ;   up before the SID's release tail of a quiet
0011B0r 2                                               ;   note had finished, and every bubble on the
0011B0r 2                                               ;   title screen would end in a click
0011B0r 2                                               ;   (include/sid.inc)
0011B0r 2  4C rr rr       jmp HalSfx
0011B3r 2               
0011B3r 1               .include "../src/ambience.asm"
0011B3r 2               ; =============================================================================
0011B3r 2               ;   ambience.asm — Wizards Lab, the sound of the title screen
0011B3r 2               ; =============================================================================
0011B3r 2               ;   SPEC 13.1 gives the title screen two moving things and no sound at all.
0011B3r 2               ;   This is a third: not music, which one channel and no envelope cannot carry
0011B3r 2               ;   for thirty seconds without becoming a nursery rhyme, but the ROOM. A
0011B3r 2               ;   cauldron bubbling away somewhere under the page, and every so often one of
0011B3r 2               ;   the game's own effects drifting past at half volume as though an experiment
0011B3r 2               ;   two benches over just went off.
0011B3r 2               ;
0011B3r 2               ;   HOW IT FITS IN ONE CHANNEL. It does not mix, because nothing here can mix:
0011B3r 2               ;   there is one voice and no way to sum two sounds into it. What it does
0011B3r 2               ;   instead is fill the gaps. AudioTick calls this from the frame where the
0011B3r 2               ;   channel fell silent and from no other (audio.asm), so the ambience only
0011B3r 2               ;   ever speaks when nothing else is speaking, and a bubble is not a special
0011B3r 2               ;   case of anything — it is an effect out of the same table, begun through the
0011B3r 2               ;   same driver, at half volume and a random pitch.
0011B3r 2               ;
0011B3r 2               ;   That last part is what stops it sounding like a loop. There are three
0011B3r 2               ;   cauldron sounds; there are sixteen entries in AmbTable saying how often
0011B3r 2               ;   each of them and each of the five borrowed effects comes up; every one is
0011B3r 2               ;   transposed by a fresh 0-7 semitones as it starts; and the quiet between
0011B3r 2               ;   them is rolled every time. Two random bytes and a table lookup per sound.
0011B3r 2               ;
0011B3r 2               ;   WHY IT NEEDS NO OFF SWITCH IN PLAY. SfxLevel is both the volume and the
0011B3r 2               ;   flag, and the game never sets it. A frame of play reaches AmbienceTick only
0011B3r 2               ;   when nothing is sounding, reads one byte, finds zero and returns: nine
0011B3r 2               ;   cycles, and no branch anywhere else in the audio path (ram.inc).
0011B3r 2               ; =============================================================================
0011B3r 2               
0011B3r 2               ; -----------------------------------------------------------------------------
0011B3r 2               ;   AmbienceBegin — the lab starts murmuring
0011B3r 2               ;   Out: nothing.  Modifies: A
0011B3r 2               ;   Called from the title screen's redraw, beside AnimTitleBegin, so a second
0011B3r 2               ;   visit in a session sounds like the first one (main.asm).
0011B3r 2               ; -----------------------------------------------------------------------------
0011B3r 2               AmbienceBegin:
0011B3r 2  A9 80          lda #TIMBRE_QUIET             ; Half volume from here until GameStart, and
0011B5r 2  8D rr rr       sta SfxLevel                  ;   the flag that says this routine is live
0011B8r 2  A9 07          lda #AMB_GAP_MIN
0011BAr 2  8D rr rr       sta AmbTimer                  ; A beat before the first sound, not a bloop on
0011BDr 2  60             rts                           ;   the frame the screen appears — the title
0011BEr 2                                               ;   arrives from a game-over fanfare as often as
0011BEr 2                                               ;   from a cold boot, and a cauldron that starts
0011BEr 2                                               ;   ON the cut reads as part of the fanfare
0011BEr 2               
0011BEr 2               ; -----------------------------------------------------------------------------
0011BEr 2               ;   AmbienceEnd — and stops
0011BEr 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0-Tmp2 (HalSfx)
0011BEr 2               ;
0011BEr 2               ;   Cuts whatever is sounding rather than letting it finish, because what
0011BEr 2               ;   follows this is the play screen and the first thing on it is a piece
0011BEr 2               ;   spawning. A bubble carried over the cut would be the game's first noise.
0011BEr 2               ; -----------------------------------------------------------------------------
0011BEr 2               AmbienceEnd:
0011BEr 2  A9 00          lda #0
0011C0r 2  8D rr rr       sta SfxLevel
0011C3r 2  8D rr rr       sta SfxId
0011C6r 2  8D rr rr       sta SfxRequest                ; Nothing on the title screen asks for a sound,
0011C9r 2                                               ;   but a byte of BSS is not a promise
0011C9r 2  A2 00          ldx #0
0011CBr 2  A9 00          lda #TIMBRE_OFF
0011CDr 2  4C rr rr       jmp HalSfx
0011D0r 2               
0011D0r 2               ; -----------------------------------------------------------------------------
0011D0r 2               ;   AmbienceTick — one frame of it, from AudioTick's silent branch
0011D0r 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0, Tmp1
0011D0r 2               ;
0011D0r 2               ;   The gap is counted HERE and not in the main loop, which is the reason this
0011D0r 2               ;   hangs off the silent branch rather than off StateTitle: a sound that runs
0011D0r 2               ;   forty frames should be followed by the full gap, not by whatever is left of
0011D0r 2               ;   one that was ticking down underneath it. Silence is the only thing the
0011D0r 2               ;   timer measures.
0011D0r 2               ; -----------------------------------------------------------------------------
0011D0r 2               AmbienceTick:
0011D0r 2  AD rr rr       lda SfxLevel
0011D3r 2  F0 2E          beq @Done                     ; The game is playing — this is the whole cost
0011D5r 2  CE rr rr       dec AmbTimer
0011D8r 2  D0 29          bne @Done                     ; Still quiet
0011DAr 2               
0011DAr 2  20 rr rr       jsr RngNext
0011DDr 2  29 0F          and #(AMB_ENTRIES - 1)        ; Sixteen entries, so a nibble picks one evenly
0011DFr 2  AA             tax                           ;   without RngRange
0011E0r 2  BD rr rr       lda AmbTable,x
0011E3r 2  48             pha                           ; The sound, parked while the pitch is rolled —
0011E4r 2                                               ;   nothing may hold a value in Tmp0-Tmp3
0011E4r 2                                               ;   across RngRange (zeropage.inc)
0011E4r 2  A9 08          lda #AMB_SHIFT_RANGE
0011E6r 2  20 rr rr       jsr RngRange                  ; 0 .. 7 semitones up: what makes two bubbles
0011E9r 2  AA             tax                           ;   two different sizes rather than one sound
0011EAr 2  68             pla
0011EBr 2  20 rr rr       jsr SfxBeginShifted           ; The channel is silent — that is the only
0011EEr 2                                               ;   frame this routine runs on — so it is taken
0011EEr 2                                               ;   outright and not asked for (audio.asm)
0011EEr 2               
0011EEr 2  A9 1A          lda #AMB_GAP_RANGE
0011F0r 2  20 rr rr       jsr RngRange
0011F3r 2  18             clc
0011F4r 2  69 07          adc #AMB_GAP_MIN              ; AMB_GAP_MIN .. MIN + RANGE - 1 frames of quiet
0011F6r 2  AE rr rr       ldx SfxId                     ; What just started, read back off the channel
0011F9r 2  E0 0D          cpx #SFX_CAULDRON             ;   rather than remembered across two calls
0011FBr 2  B0 03          bcs @Set                      ; The cauldron carries straight on...
0011FDr 2  18             clc
0011FEr 2  69 28          adc #AMB_GAP_EVENT            ; ...but the lab goes quiet for a while after
001200r 2               @Set:                           ;   something actually happens in it
001200r 2  8D rr rr       sta AmbTimer
001203r 2               @Done:
001203r 2  60             rts
001204r 2               
001204r 1               
001204r 1               ; =============================================================================
001204r 1               ;   HAL — VIC-I, hi-res text
001204r 1               ; =============================================================================
001204r 1               
001204r 1               ; -----------------------------------------------------------------------------
001204r 1               ;   HalInitVideo — 22 x 23 cells, custom charset in RAM, everything black
001204r 1               ; -----------------------------------------------------------------------------
001204r 1               HalInitVideo:
001204r 1                 ; Screen centring. The KERNAL normally sets these, but an autostart cart
001204r 1                 ; takes over before it gets that far, so they are still at their power-on
001204r 1                 ; values and the picture sits in the wrong place. The right pair depends on
001204r 1                 ; the region, which is why HalDetectRegion runs before this.
001204r 1  A2 05          ldx #$05                      ; NTSC
001206r 1  A0 19          ldy #$19
001208r 1  AD rr rr       lda Region
00120Br 1  F0 04          beq @Centre
00120Dr 1  A2 0C          ldx #$0C                      ; PAL
00120Fr 1  A0 26          ldy #$26
001211r 1               @Centre:
001211r 1  8E 00 90       stx VIC_CR0                   ; Horizontal centring (bit 7 = interlace, off)
001214r 1  8C 01 90       sty VIC_CR1                   ; Vertical centring
001217r 1               
001217r 1  A9 96          lda #$96                      ; 22 columns, video matrix bit 9 set -> $1E00
001219r 1  8D 02 90       sta VIC_CR2
00121Cr 1  A9 2E          lda #$2E                      ; 23 rows (46 half-lines), 8-pixel characters
00121Er 1  8D 03 90       sta VIC_CR3
001221r 1  A9 FD          lda #$FD                      ; Screen $1E00, character set $1400
001223r 1  8D 05 90       sta VIC_CR5
001226r 1  A9 08          lda #$08                      ; Black background, black border, normal video
001228r 1  8D 0F 90       sta VIC_CRF
00122Br 1               
00122Br 1  20 rr rr       jsr LoadTileset
00122Er 1                 ; falls through
00122Er 1               
00122Er 1               ; -----------------------------------------------------------------------------
00122Er 1               ;   HalClearScreen — blank tiles, white colour RAM
00122Er 1               ; -----------------------------------------------------------------------------
00122Er 1               HalClearScreen:
00122Er 1  A2 00          ldx #0                        ; 506 cells = one full page plus 250
001230r 1               @Page0:
001230r 1  A9 00          lda #TILE_BLANK
001232r 1  9D 00 1E       sta SCREEN + $0000,x
001235r 1  A9 01          lda #1                        ; White
001237r 1  9D 00 96       sta COLRAM + $0000,x
00123Ar 1  E8             inx
00123Br 1  D0 F3          bne @Page0
00123Dr 1               @Page1:
00123Dr 1  A9 00          lda #TILE_BLANK
00123Fr 1  9D 00 1F       sta SCREEN + $0100,x
001242r 1  A9 01          lda #1
001244r 1  9D 00 97       sta COLRAM + $0100,x
001247r 1  E8             inx
001248r 1  E0 FA          cpx #250                      ; $1E00 + 506 = $1FFA, the end of the matrix
00124Ar 1  D0 F1          bne @Page1
00124Cr 1  60             rts
00124Dr 1               
00124Dr 1               ; -----------------------------------------------------------------------------
00124Dr 1               ;   LoadTileset — copy 2 K of patterns from BLK3 into RAM at $1400
00124Dr 1               ;   The VIC chip cannot see cartridge ROM, so this copy is not optional.
00124Dr 1               ;   PLACEHOLDER ART: Tileset is data/tileset.bin. See data/README.md.
00124Dr 1               ; -----------------------------------------------------------------------------
00124Dr 1               LoadTileset:
00124Dr 1  A9 rr          lda #<Tileset
00124Fr 1  85 rr          sta SrcPtr
001251r 1  A9 rr          lda #>Tileset
001253r 1  85 rr          sta SrcPtr+1
001255r 1  A9 00          lda #<CHARSET_RAM
001257r 1  85 rr          sta DstPtr
001259r 1  A9 14          lda #>CHARSET_RAM
00125Br 1  85 rr          sta DstPtr+1
00125Dr 1               
00125Dr 1  A2 08          ldx #8                        ; 8 x 256 = 2048 bytes
00125Fr 1  A0 00          ldy #0
001261r 1               @Byte:
001261r 1  B1 rr          lda (SrcPtr),y
001263r 1  91 rr          sta (DstPtr),y
001265r 1  C8             iny
001266r 1  D0 F9          bne @Byte
001268r 1  E6 rr          inc SrcPtr+1
00126Ar 1  E6 rr          inc DstPtr+1
00126Cr 1  CA             dex
00126Dr 1  D0 F2          bne @Byte
00126Fr 1  60             rts
001270r 1               
001270r 1               ; -----------------------------------------------------------------------------
001270r 1               ;   HalWaitFrame — sync on the top of the raster
001270r 1               ; -----------------------------------------------------------------------------
001270r 1               HalWaitFrame:
001270r 1               @NotTop:
001270r 1  AD 04 90       lda VIC_CR4                   ; Raster line / 2
001273r 1  F0 FB          beq @NotTop                   ; Leave the top of the frame first...
001275r 1               @Top:
001275r 1  AD 04 90       lda VIC_CR4
001278r 1  D0 FB          bne @Top                      ; ...then wait for it to come round again
00127Ar 1  60             rts
00127Br 1               
00127Br 1               ; -----------------------------------------------------------------------------
00127Br 1               ;   HalPlotCell — In: A = tile, X = screen column, Y = screen row
00127Br 1               ; -----------------------------------------------------------------------------
00127Br 1               HalPlotCell:
00127Br 1  48             pha                           ; Hold the tile; RowPtrs needs A
00127Cr 1  20 rr rr       jsr RowPtrs                   ; ScreenPtr / ColorPtr = start of row Y
00127Fr 1  8A             txa
001280r 1  A8             tay                           ; Y = column
001281r 1  68             pla                           ; A = tile
001282r 1  91 rr          sta (ScreenPtr),y
001284r 1  AA             tax                           ; The tile is its own colour lookup index...
001285r 1  29 F8          and #COLOR_MASK               ; ...unless its colour is the one a fireball is
001287r 1  CD rr rr       cmp TintColor                 ;   flashing white (SPEC 4.6). TintColor is
00128Ar 1  F0 06          beq @White                    ;   TINT_NONE when nothing is, and no masked
00128Cr 1  BD rr rr       lda TileColorVIC,x                ;   tile can equal that, so the test needs no
00128Fr 1  4C rr rr       jmp @Put                      ;   separate "is anything lit at all" branch —
001292r 1               @White:                         ;   one CMP a cell, and only while it is lit
001292r 1  A9 01          lda #COLOR_WHITE              ;   does a cell come out any different
001294r 1               @Put:
001294r 1  91 rr          sta (ColorPtr),y
001296r 1  60             rts
001297r 1               
001297r 1               ; -----------------------------------------------------------------------------
001297r 1               ;   RowPtrs — In: Y = screen row.  Out: ScreenPtr, ColorPtr at that row
001297r 1               ; -----------------------------------------------------------------------------
001297r 1               RowPtrs:
001297r 1  B9 rr rr       lda RowLo,y
00129Ar 1  85 rr          sta ScreenPtr
00129Cr 1  85 rr          sta ColorPtr
00129Er 1  B9 rr rr       lda RowHi,y
0012A1r 1  85 rr          sta ScreenPtr+1
0012A3r 1  18             clc
0012A4r 1  69 78          adc #(>COLRAM - >SCREEN)      ; Colour RAM mirrors the matrix, page-offset
0012A6r 1  85 rr          sta ColorPtr+1
0012A8r 1  60             rts
0012A9r 1               
0012A9r 1               ; -----------------------------------------------------------------------------
0012A9r 1               ;   HalBlitScreen — draw a full 506-byte screen plus its colour image
0012A9r 1               ;   In: SrcPtr -> name table, Ptr1 -> colour table
0012A9r 1               ; -----------------------------------------------------------------------------
0012A9r 1               HalBlitScreen:
0012A9r 1  A0 00          ldy #0                        ; 506 cells = one full page plus 250
0012ABr 1               @Page0:
0012ABr 1  B1 rr          lda (SrcPtr),y
0012ADr 1  99 00 1E       sta SCREEN + $0000,y
0012B0r 1  B1 rr          lda (Ptr1),y
0012B2r 1  99 00 96       sta COLRAM + $0000,y
0012B5r 1  C8             iny
0012B6r 1  D0 F3          bne @Page0
0012B8r 1               
0012B8r 1  E6 rr          inc SrcPtr+1
0012BAr 1  E6 rr          inc Ptr1+1
0012BCr 1  A0 00          ldy #0
0012BEr 1               @Page1:
0012BEr 1  B1 rr          lda (SrcPtr),y
0012C0r 1  99 00 1F       sta SCREEN + $0100,y
0012C3r 1  B1 rr          lda (Ptr1),y
0012C5r 1  99 00 97       sta COLRAM + $0100,y
0012C8r 1  C8             iny
0012C9r 1  C0 FA          cpy #250                      ; Anything past here is not screen memory
0012CBr 1  D0 F1          bne @Page1
0012CDr 1  60             rts
0012CEr 1               
0012CEr 1               ; -----------------------------------------------------------------------------
0012CEr 1               ;   HalReadInput — joystick and keyboard, folded into one active-high mask
0012CEr 1               ;
0012CEr 1               ;   The VIC splits its stick across two chips: up, down, left and fire are on
0012CEr 1               ;   VIA1 $9111, but RIGHT is on VIA2 $9120 bit 7 — which is also the last of
0012CEr 1               ;   the eight keyboard row lines. That collision is PLAN.md S4, and it turns
0012CEr 1               ;   out not to be one:
0012CEr 1               ;
0012CEr 1               ;     Every key this game reads lives in matrix rows 1-6. Row 0 is the top
0012CEr 1               ;     number row and row 7 the rest of it, and the game wants neither. So DDRB
0012CEr 1               ;     is set ONCE to $7F and never touched again — PB0-PB6 drive the six rows
0012CEr 1               ;     that matter, PB7 stays an input for the RIGHT switch, and the two never
0012CEr 1               ;     take turns.
0012CEr 1               ;
0012CEr 1               ;   That is better than flipping the DDR twice a frame, and not only because
0012CEr 1               ;   it is shorter: driving PB7 high while a closed RIGHT switch pulls it to
0012CEr 1               ;   ground puts the VIA's output stage against the joystick, and never
0012CEr 1               ;   configuring PB7 as an output means that cannot happen at all.
0012CEr 1               ; -----------------------------------------------------------------------------
0012CEr 1               HalReadInput:
0012CEr 1  AD 13 91       lda $9113                     ; VIA1 DDR: the joystick lines are inputs
0012D1r 1  29 C3          and #%11000011
0012D3r 1  8D 13 91       sta $9113
0012D6r 1               
0012D6r 1  A9 7F          lda #%01111111                ; VIA2 DDRB: rows 0-6 out, RIGHT switch in
0012D8r 1  8D 22 91       sta $9122
0012DBr 1  A9 00          lda #$00                      ; VIA2 DDRA: the column lines are inputs
0012DDr 1  8D 23 91       sta $9123
0012E0r 1               
0012E0r 1  AD 11 91       lda $9111                     ; Active low: bit2 U, bit3 D, bit4 L, bit5 fire
0012E3r 1  49 FF          eor #$FF
0012E5r 1  29 3C          and #%00111100                ; Only those four; PA7 here is not the stick
0012E7r 1  85 rr          sta Tmp0
0012E9r 1               
0012E9r 1  AD 20 91       lda $9120
0012ECr 1  49 FF          eor #$FF
0012EEr 1  29 80          and #$80                      ; Fold RIGHT in as bit 7 of the same byte
0012F0r 1  05 rr          ora Tmp0
0012F2r 1  85 rr          sta Tmp0
0012F4r 1               
0012F4r 1  A9 00          lda #0
0012F6r 1  85 rr          sta Tmp1
0012F8r 1               
0012F8r 1  A5 rr          lda Tmp0
0012FAr 1  29 04          and #%00000100                  ; VIA1 bit 2
0012FCr 1  F0 06          beq @NoUp
0012FEr 1  A5 rr          lda Tmp1
001300r 1  09 01          ora #INPUT_UP
001302r 1  85 rr          sta Tmp1
001304r 1               @NoUp:
001304r 1  A5 rr          lda Tmp0
001306r 1  29 08          and #%00001000                  ; VIA1 bit 3
001308r 1  F0 06          beq @NoDown
00130Ar 1  A5 rr          lda Tmp1
00130Cr 1  09 02          ora #INPUT_DOWN
00130Er 1  85 rr          sta Tmp1
001310r 1               @NoDown:
001310r 1  A5 rr          lda Tmp0
001312r 1  29 10          and #%00010000                  ; VIA1 bit 4
001314r 1  F0 06          beq @NoLeft
001316r 1  A5 rr          lda Tmp1
001318r 1  09 04          ora #INPUT_LEFT
00131Ar 1  85 rr          sta Tmp1
00131Cr 1               @NoLeft:
00131Cr 1  A5 rr          lda Tmp0
00131Er 1  29 80          and #%10000000                  ; VIA2 PB7, folded in above
001320r 1  F0 06          beq @NoRight
001322r 1  A5 rr          lda Tmp1
001324r 1  09 08          ora #INPUT_RIGHT
001326r 1  85 rr          sta Tmp1
001328r 1               @NoRight:
001328r 1  A5 rr          lda Tmp0
00132Ar 1  29 20          and #%00100000                  ; VIA1 bit 5
00132Cr 1  F0 06          beq @NoFire
00132Er 1  A5 rr          lda Tmp1
001330r 1  09 10          ora #INPUT_FIRE
001332r 1  85 rr          sta Tmp1
001334r 1               @NoFire:
001334r 1               
001334r 1  20 rr rr       jsr ScanKeys
001337r 1  05 rr          ora Tmp1
001339r 1  60             rts
00133Ar 1               
00133Ar 1               ; -----------------------------------------------------------------------------
00133Ar 1               ;   ScanKeys — the keyboard matrix, as the same active-high mask
00133Ar 1               ;   Out: A = INPUT_* bits.  Modifies: A, X, Tmp2
00133Ar 1               ;
00133Ar 1               ;   VIA2 $9120 drives the rows (one bit LOW selects one row) and $9121 reads
00133Ar 1               ;   the columns, active low. Every key the game uses is in KeyTable below;
00133Ar 1               ;   the two cursor keys come after it because SHIFT turns them around, and
00133Ar 1               ;   knowing whether SHIFT is down means having scanned the table first.
00133Ar 1               ; -----------------------------------------------------------------------------
00133Ar 1               KEY_SHIFT           = %01000000 ; Scratch inside this file only — INPUT_MASK
00133Ar 1                                               ;   strips it before the mask leaves here
00133Ar 1               
00133Ar 1               ScanKeys:
00133Ar 1  A9 00          lda #0
00133Cr 1  85 rr          sta Tmp2
00133Er 1  A2 00          ldx #0
001340r 1               @Key:
001340r 1  BD rr rr       lda KeyTable,x
001343r 1  F0 19          beq @Cursors                  ; $00 drives every row at once — the
001345r 1  8D 20 91       sta $9120                     ;   terminator, because it is not a row mask
001348r 1  AD 21 91       lda $9121
00134Br 1  49 FF          eor #$FF                      ; Active low in, active high out
00134Dr 1  3D rr rr       and KeyTable+1,x
001350r 1  F0 07          beq @Next
001352r 1  A5 rr          lda Tmp2
001354r 1  1D rr rr       ora KeyTable+2,x
001357r 1  85 rr          sta Tmp2
001359r 1               @Next:
001359r 1  E8             inx
00135Ar 1  E8             inx
00135Br 1  E8             inx
00135Cr 1  D0 E2          bne @Key                      ; Always — the table is far shorter than 256
00135Er 1               
00135Er 1                 ; --- the two cursor keys, which SHIFT turns around (SPEC 11.2) ------------
00135Er 1                 ;   Unshifted they are RIGHT and DOWN, shifted LEFT and UP, which is exactly
00135Er 1                 ;   the four the game wants and the reason for reading the matrix rather
00135Er 1                 ;   than letting the KERNAL translate a keystroke into one character.
00135Er 1               @Cursors:
00135Er 1  A9 FB          lda #%11111011                ; Row 2 — CRSR RIGHT shares it with A and D
001360r 1  8D 20 91       sta $9120
001363r 1  AD 21 91       lda $9121
001366r 1  29 80          and #%10000000                ; Column 7
001368r 1  D0 0F          bne @NoLeftRight              ; Still high, so not pressed
00136Ar 1  A2 08          ldx #INPUT_RIGHT
00136Cr 1  A5 rr          lda Tmp2
00136Er 1  29 40          and #KEY_SHIFT
001370r 1  F0 02          beq @LeftRight
001372r 1  A2 04          ldx #INPUT_LEFT
001374r 1               @LeftRight:
001374r 1  8A             txa
001375r 1  05 rr          ora Tmp2
001377r 1  85 rr          sta Tmp2
001379r 1               @NoLeftRight:
001379r 1               
001379r 1  A9 F7          lda #%11110111                ; Row 3 — CRSR DOWN, next to LSHIFT
00137Br 1  8D 20 91       sta $9120
00137Er 1  AD 21 91       lda $9121
001381r 1  29 80          and #%10000000
001383r 1  D0 0F          bne @NoUpDown
001385r 1  A2 02          ldx #INPUT_DOWN
001387r 1  A5 rr          lda Tmp2
001389r 1  29 40          and #KEY_SHIFT
00138Br 1  F0 02          beq @UpDown
00138Dr 1  A2 01          ldx #INPUT_UP
00138Fr 1               @UpDown:
00138Fr 1  8A             txa
001390r 1  05 rr          ora Tmp2
001392r 1  85 rr          sta Tmp2
001394r 1               @NoUpDown:
001394r 1               
001394r 1  A5 rr          lda Tmp2
001396r 1  29 3F          and #INPUT_MASK               ; Drop KEY_SHIFT — it is not an input
001398r 1  60             rts
001399r 1               
001399r 1               ; -----------------------------------------------------------------------------
001399r 1               ;   KeyTable — row mask, column mask, input bit.  Terminated by $00.
001399r 1               ;   Rows 1-6 only; see HalReadInput above for why that matters.
001399r 1               ; -----------------------------------------------------------------------------
001399r 1               KeyTable:
001399r 1  FD 02 01       .byte %11111101, %00000010, INPUT_UP      ; W        row 1, col 1
00139Cr 1  FB 02 04       .byte %11111011, %00000010, INPUT_LEFT    ; A        row 2, col 1
00139Fr 1  DF 02 02       .byte %11011111, %00000010, INPUT_DOWN    ; S        row 5, col 1
0013A2r 1  FB 04 08       .byte %11111011, %00000100, INPUT_RIGHT   ; D        row 2, col 2
0013A5r 1  BF 01 10       .byte %10111111, %00000001, INPUT_FIRE    ; Q        row 6, col 0
0013A8r 1  FD 20 20       .byte %11111101, %00100000, INPUT_PAUSE   ; P        row 1, col 5
0013ABr 1  EF 01 01       .byte %11101111, %00000001, INPUT_UP      ; SPACE    row 4, col 0
0013AEr 1  FD 80 10       .byte %11111101, %10000000, INPUT_FIRE    ; RETURN   row 1, col 7
0013B1r 1  F7 02 40       .byte %11110111, %00000010, KEY_SHIFT     ; LSHIFT   row 3, col 1
0013B4r 1  EF 40 40       .byte %11101111, %01000000, KEY_SHIFT     ; RSHIFT   row 4, col 6
0013B7r 1  00             .byte $00
0013B8r 1               
0013B8r 1               ; -----------------------------------------------------------------------------
0013B8r 1               ;   HalDetectRegion — NTSC has 261 raster lines, PAL 312
0013B8r 1               ;   $9004 carries the line number halved, so the highest value it reaches is
0013B8r 1               ;   about $82 on NTSC and $9C on PAL. Sample it and take the maximum.
0013B8r 1               ; -----------------------------------------------------------------------------
0013B8r 1               HalDetectRegion:
0013B8r 1  A9 00          lda #0
0013BAr 1  85 rr          sta Tmp0                      ; Highest line seen
0013BCr 1  A2 00          ldx #0
0013BEr 1  A0 00          ldy #0
0013C0r 1               @Sample:
0013C0r 1  AD 04 90       lda VIC_CR4
0013C3r 1  C5 rr          cmp Tmp0
0013C5r 1  90 02          bcc @Next
0013C7r 1  85 rr          sta Tmp0
0013C9r 1               @Next:
0013C9r 1  C8             iny
0013CAr 1  D0 F4          bne @Sample
0013CCr 1  E8             inx
0013CDr 1  E0 40          cpx #64                       ; 16384 samples — comfortably over one frame
0013CFr 1  D0 EF          bne @Sample
0013D1r 1               
0013D1r 1  A5 rr          lda Tmp0
0013D3r 1  C9 90          cmp #$90
0013D5r 1  90 03          bcc @Ntsc
0013D7r 1  A9 01          lda #1                        ; PAL
0013D9r 1  60             rts
0013DAr 1               @Ntsc:
0013DAr 1  A9 00          lda #0
0013DCr 1  60             rts
0013DDr 1               
0013DDr 1               ; -----------------------------------------------------------------------------
0013DDr 1               ;   HalColorFlash — the fireball's detonation (SPEC 4.6, 14)
0013DDr 1               ;   In:  A = colour key ($40..$68), or TINT_NONE.  Modifies: A, TintColor
0013DDr 1               ;
0013DDr 1               ;   Colour here is per CELL, so there is no single byte to poke: the flash is
0013DDr 1               ;   HalPlotCell substituting white for any tile of TintColor as it draws it,
0013DDr 1               ;   and the animation re-marking every cell that has to change. Storing the
0013DDr 1               ;   colour is therefore the whole routine, and the transition HalColorFlash
0013DDr 1               ;   promises to handle costs nothing — the previous colour stops being
0013DDr 1               ;   substituted the moment this byte changes, and its cells are re-marked by
0013DDr 1               ;   the same pass that marks the new one (anim.asm, hal.inc).
0013DDr 1               ;
0013DDr 1               ;   The AC6502 does it in one VDP write instead. Same frame count, same look,
0013DDr 1               ;   completely different mechanism — which is exactly what SPEC 4.6 predicted.
0013DDr 1               ; -----------------------------------------------------------------------------
0013DDr 1               HalColorFlash:
0013DDr 1  8D rr rr       sta TintColor
0013E0r 1  60             rts
0013E1r 1               
0013E1r 1               ; -----------------------------------------------------------------------------
0013E1r 1               ;   HalSfx — one note on the VIC-I, $900A-$900E (hal.inc)
0013E1r 1               ;   In:  A = TIMBRE_*, optionally + TIMBRE_QUIET; X = note.
0013E1r 1               ;   Out: nothing.  Modifies: A, X, Y
0013E1r 1               ;
0013E1r 1               ;   No SID here and nothing shaped like one: four oscillators, one 7-bit value
0013E1r 1               ;   each, bit 7 to enable, one global volume, and no envelope at all. What it
0013E1r 1               ;   does have is the thing that makes a timbre free — bass, alto and soprano
0013E1r 1               ;   are the SAME oscillator design divided by 256, 128 and 64, so they are
0013E1r 1               ;   exactly an octave apart and TIMBRE_SOFT / BUZZ / BRIGHT are a choice of
0013E1r 1               ;   register rather than a shift of the pitch (constants.inc). The SID pays
0013E1r 1               ;   for the same octave in a 16-bit shift.
0013E1r 1               ;
0013E1r 1               ;   All four are silenced on the way in. Only one is ever meant to sound and
0013E1r 1               ;   stopping the other three costs four stores, which is cheaper than a byte
0013E1r 1               ;   remembering which one was left running.
0013E1r 1               ; -----------------------------------------------------------------------------
0013E1r 1               VIC_VOL_FULL = $0F              ; The two levels (src/constants.inc). $900E's
0013E1r 1               VIC_VOL_QUIET = $06             ;   high nibble is the auxiliary colour and
0013E1r 1                                               ;   both of these leave it clear
0013E1r 1               
0013E1r 1               HalSfx:
0013E1r 1  A0 00          ldy #0
0013E3r 1  8C 0A 90       sty VIC_CRA                   ; Bass
0013E6r 1  8C 0B 90       sty VIC_CRB                   ; Alto
0013E9r 1  8C 0C 90       sty VIC_CRC                   ; Soprano
0013ECr 1  8C 0D 90       sty VIC_CRD                   ; Noise
0013EFr 1               
0013EFr 1                 ; --- the level, which is bit 7 of the timbre and not a voice --------------
0013EFr 1                 ;   The VIC-I has no per-oscillator volume either, so quiet is this register
0013EFr 1                 ;   and nothing else. Masked off first and on every path, so a QUIET
0013EFr 1                 ;   TIMBRE_OFF ($80) is still silence (constants.inc, src/ambience.asm).
0013EFr 1  A0 0F          ldy #VIC_VOL_FULL
0013F1r 1  C9 80          cmp #TIMBRE_QUIET
0013F3r 1  90 04          bcc @Level
0013F5r 1  29 7F          and #TIMBRE_MASK
0013F7r 1  A0 06          ldy #VIC_VOL_QUIET
0013F9r 1               @Level:
0013F9r 1  8C 0E 90       sty VIC_CRE                   ; Volume, low nibble. The high nibble is the
0013FCr 1                                               ;   auxiliary colour, which only multicolor
0013FCr 1                                               ;   characters read and this game has none —
0013FCr 1                                               ;   colour RAM bit 3 stays clear on every cell
0013FCr 1                                               ;   (data/tilecolor-vic20.inc)
0013FCr 1  C9 00          cmp #TIMBRE_OFF
0013FEr 1  F0 0C          beq @Done
001400r 1               
001400r 1  A8             tay                           ; Y = timbre, 1..4
001401r 1  BD rr rr       lda VicNotes,x                ; The oscillator value for this pitch...
001404r 1  BE rr rr       ldx VicOsc - 1,y              ;   ...and which of the four sounds it
001407r 1  09 80          ora #$80                      ; Bit 7 enables the oscillator
001409r 1  9D 0A 90       sta VIC_CRA,x                 ; $900A-$900D are contiguous
00140Cr 1               @Done:
00140Cr 1  60             rts
00140Dr 1               
00140Dr 1               ; =============================================================================
00140Dr 1               ;   Data
00140Dr 1               ; =============================================================================
00140Dr 1               
00140Dr 1               .segment "RODATA"
000000r 1               
000000r 1               .include "../data/tilecolor-vic20.inc"
000000r 2               ; =============================================================================
000000r 2               ;   tilecolor-vic20.inc — VIC-20 tile -> colour RAM table
000000r 2               ; =============================================================================
000000r 2               ;   Generated from SPEC.md section 4.3 and Appendix A. Spec-derived data, not
000000r 2               ;   artwork: edit this file by hand, it is never overwritten by an editor
000000r 2               ;   export. Tile groups 16-31 (tiles 128-255) are the margin artwork and their
000000r 2               ;   colours are the artist's to choose.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               
000000r 2               ;   256 bytes, indexed by tile number. Render is:
000000r 2               ;       SCREEN,x = tile   /   COLRAM,x = TileColor,tile
000000r 2               ;   VIC-20 hi-res text mode: colours 0-7 only (bit 3 selects
000000r 2               ;   multicolor and must stay clear).
000000r 2               
000000r 2               TileColorVIC:
000000r 2  01 01 01 01    .res 8, $01                      ; tiles   0-7    group 0  UI / well frame        white
000004r 2  01 01 01 01  
000008r 2  01 01 01 01    .res 8, $01                      ; tiles   8-15   group 1  UI accents             gray
00000Cr 2  01 01 01 01  
000010r 2  01 01 01 01    .res 8, $01                      ; tiles  16-23   group 2  Font  0 1 2 3 4 5 6 7  white
000014r 2  01 01 01 01  
000018r 2  01 01 01 01    .res 8, $01                      ; tiles  24-31   group 3  Font  8 9 A B C D E F  white
00001Cr 2  01 01 01 01  
000020r 2  01 01 01 01    .res 8, $01                      ; tiles  32-39   group 4  Font  G H I J K L M N  white
000024r 2  01 01 01 01  
000028r 2  01 01 01 01    .res 8, $01                      ; tiles  40-47   group 5  Font  O P Q R S T U V  white
00002Cr 2  01 01 01 01  
000030r 2  01 01 01 01    .res 8, $01                      ; tiles  48-55   group 6  Font  W X Y Z . x ! -  white
000034r 2  01 01 01 01  
000038r 2  01 01 01 01    .res 8, $01                      ; tiles  56-63   group 7  VFX                    white
00003Cr 2  01 01 01 01  
000040r 2  02 02 02 02    .res 8, $02                      ; tiles  64-71   group 8  POTION 0  RED
000044r 2  02 02 02 02  
000048r 2  07 07 07 07    .res 8, $07                      ; tiles  72-79   group 9  POTION 1  YELLOW
00004Cr 2  07 07 07 07  
000050r 2  05 05 05 05    .res 8, $05                      ; tiles  80-87   group 10 POTION 2  GREEN
000054r 2  05 05 05 05  
000058r 2  03 03 03 03    .res 8, $03                      ; tiles  88-95   group 11 POTION 3  CYAN
00005Cr 2  03 03 03 03  
000060r 2  06 06 06 06    .res 8, $06                      ; tiles  96-103  group 12 POTION 4  BLUE
000064r 2  06 06 06 06  
000068r 2  04 04 04 04    .res 8, $04                      ; tiles 104-111  group 13 POTION 5  PURPLE
00006Cr 2  04 04 04 04  
000070r 2  01 01 01 01    .res 8, $01                      ; tiles 112-119  group 14 POTION 6  WILD / prism white
000074r 2  01 01 01 01  
000078r 2  02 02 02 02    .res 8, $02                      ; tiles 120-127  group 15 Wall / stone           red
00007Cr 2  02 02 02 02  
000080r 2  01 01 01 01    .res 8, $01                      ; tiles 128-135  group 16 artwork
000084r 2  01 01 01 01  
000088r 2  02 02 02 02    .res 8, $02                      ; tiles 136-143  group 17 artwork
00008Cr 2  02 02 02 02  
000090r 2  05 05 05 05    .res 8, $05                      ; tiles 144-151  group 18 artwork
000094r 2  05 05 05 05  
000098r 2  07 07 07 07    .res 8, $07                      ; tiles 152-159  group 19 artwork
00009Cr 2  07 07 07 07  
0000A0r 2  06 06 06 06    .res 8, $06                      ; tiles 160-167  group 20 artwork
0000A4r 2  06 06 06 06  
0000A8r 2  05 05 05 05    .res 8, $05                      ; tiles 168-175  group 21 artwork
0000ACr 2  05 05 05 05  
0000B0r 2  02 02 02 02    .res 8, $02                      ; tiles 176-183  group 22 artwork
0000B4r 2  02 02 02 02  
0000B8r 2  03 03 03 03    .res 8, $03                      ; tiles 184-191  group 23 artwork
0000BCr 2  03 03 03 03  
0000C0r 2  07 07 07 07    .res 8, $07                      ; tiles 192-199  group 24 artwork
0000C4r 2  07 07 07 07  
0000C8r 2  06 06 06 06    .res 8, $06                      ; tiles 200-207  group 25 artwork
0000CCr 2  06 06 06 06  
0000D0r 2  04 04 04 04    .res 8, $04                      ; tiles 208-215  group 26 artwork
0000D4r 2  04 04 04 04  
0000D8r 2  05 05 05 05    .res 8, $05                      ; tiles 216-223  group 27 artwork
0000DCr 2  05 05 05 05  
0000E0r 2  02 02 02 02    .res 8, $02                      ; tiles 224-231  group 28 artwork
0000E4r 2  02 02 02 02  
0000E8r 2  01 01 01 01    .res 8, $01                      ; tiles 232-239  group 29 artwork
0000ECr 2  01 01 01 01  
0000F0r 2  01 01 01 01    .res 8, $01                      ; tiles 240-247  group 30 artwork
0000F4r 2  01 01 01 01  
0000F8r 2  01 01 01 01    .res 8, $01                      ; tiles 248-255  group 31 artwork
0000FCr 2  01 01 01 01  
000100r 2               
000100r 1               .include "../src/tables.inc"
000100r 2               ; =============================================================================
000100r 2               ;   tables.inc — Wizards Lab, spec-derived lookup tables
000100r 2               ; =============================================================================
000100r 2               ;   Straight out of SPEC.md sections 5.3, 9, 10, 14 and 16. Hand-authored,
000100r 2               ;   never overwritten by an editor export. Included once, from the RODATA
000100r 2               ;   segment.
000100r 2               ;
000100r 2               ;   Score values above 99 do not fit in a byte, so every scoring table is a
000100r 2               ;   pair of parallel arrays — low BCD byte and high BCD byte — indexed by the
000100r 2               ;   same value.
000100r 2               ; =============================================================================
000100r 2               
000100r 2               ; --- Gravity, frames per row (SPEC 10.2) -------------------------------------
000100r 2               ;   Indexed by (level - 1), clamped to LEVEL_SPEED_CAP - 1.
000100r 2               ;   PAL is round(NTSC * 50/60), so wall-clock speed matches across regions.
000100r 2               
000100r 2               SpeedNTSC:
000100r 2  30 2B 26 22    .byte  48, 43, 38, 34, 30, 26, 23, 20   ; levels  1- 8   0.800s .. 0.333s
000104r 2  1E 1A 17 14  
000108r 2  11 0F 0D 0B    .byte  17, 15, 13, 11,  9,  8,  7,  6   ; levels  9-16   0.283s .. 0.100s
00010Cr 2  09 08 07 06  
000110r 2               
000110r 2               SpeedPAL:
000110r 2  28 24 20 1C    .byte  40, 36, 32, 28, 25, 22, 19, 17   ; levels  1- 8   0.800s .. 0.340s
000114r 2  19 16 13 11  
000118r 2  0E 0D 0B 09    .byte  14, 13, 11,  9,  8,  7,  6,  5   ; levels  9-16   0.280s .. 0.100s
00011Cr 2  08 07 06 05  
000120r 2               
000120r 2               ; --- Frame counts that differ by region (SPEC 5.6, 11.3, 14) -----------------
000120r 2               ;   Indexed by Region: 0 = NTSC, 1 = PAL. PAL is round(NTSC * 50/60) wherever
000120r 2               ;   the difference is worth a frame, so a piece takes the same number of
000120r 2               ;   SECONDS to lock on both machines rather than the same number of frames.
000120r 2               ;
000120r 2               ;   Two bytes each rather than one table of pairs, because every read is
000120r 2               ;   `ldx Region / lda Name,x` and a pair table would need the index doubled.
000120r 2               
000120r 2               LockDelay:                              ; SPEC 5.6
000120r 2  10 0E          .byte 16, 14
000122r 2               AreDelay:                               ; Entry delay after a cascade settles
000122r 2  0C 0A          .byte 12, 10
000124r 2               DasInitial:                             ; SPEC 11.3 — first repeat
000124r 2  0C 0A          .byte 12, 10
000126r 2               DasRepeat:                              ; ...and every one after it
000126r 2  04 03          .byte  4,  3
000128r 2               SoftDropRate:                           ; Frames per row while DOWN is held.
000128r 2  03 02          .byte  3,  2                          ;   Never used when gravity is faster.
00012Ar 2               BlinkHalf:                              ; SPEC 14 — half of the 30 / 25 frame
00012Ar 2  0F 0D          .byte 15, 13                          ;   blink period, which is what a
00012Cr 2                                                       ;   blinking field actually counts
00012Cr 2               GlowFrames:                             ; SPEC 14 — the GLOW window: the match
00012Cr 2  06 05          .byte  6,  5                          ;   glow and the bolt's beams
00012Er 2               FlashFrames:                            ; ...and what the window grows to when
00012Er 2  08 07          .byte  8,  7                          ;   a fireball fired, because its flash
000130r 2                                                       ;   is the longer of the two and both
000130r 2                                                       ;   are showing at once (constants.inc)
000130r 2               BannerFrames:                           ; SPEC 14 — how long LEVEL UP and
000130r 2  2D 26          .byte 45, 38                          ;   CHAIN xN stay in the message band
000132r 2               SecondFrames:                           ; One second, which is the unit the
000132r 2  3C 32          .byte 60, 50                          ;   game-over timeout is counted in
000134r 2                                                       ;   (SPEC 13.4). The only entry here
000134r 2                                                       ;   that is not a duration out of
000134r 2                                                       ;   SPEC 14 but the frame rate itself
000134r 2               
000134r 2               ; --- The two removal animations (SPEC 14, Appendix A.3) ----------------------
000134r 2               ;   One ring, run in both directions. Indexed by AnimStep, which advances every
000134r 2               ;   VFX_FRAMES frames.
000134r 2               ;
000134r 2               ;   Potions, reagents, the bomb blast and the star all open OUTWARD and are
000134r 2               ;   gone in SHATTER_STEPS frames; the fourth entry only ever comes up when a
000134r 2               ;   marked prism is blipping out beside them and holding the window open, and
000134r 2               ;   it blanks the cell rather than leaving the last ring frame sitting there
000134r 2               ;   for four more frames.
000134r 2               
000134r 2               VfxShatter:
000134r 2  38 39 3A 00    .byte VFX_REMOVE1, VFX_REMOVE2, VFX_REMOVE3, TILE_EMPTY
000138r 2               
000138r 2               ;   The prism closes INWARD, and does not pass through the glow (SPEC A.3 —
000138r 2               ;   group 14 has no glyph +6). Five frames, so a step that clears one runs
000138r 2               ;   BLIP_STEPS rather than SHATTER_STEPS.
000138r 2               
000138r 2               VfxBlip:
000138r 2  74 75 39 38    .byte PRISM_BLIP, PRISM_BLIP + 1, VFX_REMOVE2, VFX_REMOVE1, FONT_DOT
00013Cr 2  34           
00013Dr 2               
00013Dr 2               ; --- Per-tile value for MATCH removals (SPEC 9.1) ----------------------------
00013Dr 2               ;   Indexed by (chain - 1), clamped to 7.   20 50 100 200 300 400 500 600
00013Dr 2               TileValueLo:
00013Dr 2  20 50 00 00    .byte $20, $50, $00, $00, $00, $00, $00, $00
000141r 2  00 00 00 00  
000145r 2               TileValueHi:
000145r 2  00 00 01 02    .byte $00, $00, $01, $02, $03, $04, $05, $06
000149r 2  03 04 05 06  
00014Dr 2               
