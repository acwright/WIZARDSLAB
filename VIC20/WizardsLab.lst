000000r 1               ; =============================================================================
000000r 1               ;   Wizards Lab — VIC-20
000000r 1               ; =============================================================================
000000r 1               ;   A 16 K cartridge for an unexpanded VIC-20: BLK5 ($A000) carries the
000000r 1               ;   autostart header and the code, BLK3 ($6000) carries the tileset and screen
000000r 1               ;   images.
000000r 1               ;
000000r 1               ;   This machine sets the shape of the whole game. Its 22 x 23 screen is
000000r 1               ;   exactly the panel every platform draws, and its eight hi-res foreground
000000r 1               ;   colours are what cap the potion palette at six plus white. Designing
000000r 1               ;   against it first is what lets one layout serve all three.
000000r 1               ;
000000r 1               ;   The VIC chip cannot see cartridge ROM, so the character set is copied out
000000r 1               ;   of BLK3 into RAM at $1400 during boot.
000000r 1               ;
000000r 1               ;   Built with VIC20-16K.cfg.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               .include "../include/vic20.inc"
000000r 2               ; VIC-20 Include File for ca65
000000r 2               ; Memory addresses, KERNAL routines, and hardware registers
000000r 2               ; Compatible with both NTSC and PAL VIC-20 systems
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Zero Page Locations
000000r 2               ;=============================================================================
000000r 2               VARTAB          = $2D           ; Pointer to start of BASIC variables
000000r 2               ARYTAB          = $2F           ; Pointer to start of BASIC arrays
000000r 2               STREND          = $31           ; Pointer to end of BASIC arrays
000000r 2               FRETOP          = $33           ; Pointer to bottom of string space
000000r 2               MEMSIZ          = $37           ; Pointer to top of BASIC memory
000000r 2               TIME            = $A0           ; Jiffy clock (3 bytes)
000000r 2               TIMER           = $A0           ; Same as TIME
000000r 2               STATUS          = $90           ; I/O status byte
000000r 2               STKEY           = $91           ; STOP key flag
000000r 2               MSGFLG          = $9D           ; Kernal message control flag
000000r 2               FNLEN           = $B7           ; Length of filename
000000r 2               LA              = $B8           ; Logical file number
000000r 2               SA              = $B9           ; Secondary address
000000r 2               FA              = $BA           ; Device number
000000r 2               FNADR           = $BB           ; Pointer to filename (2 bytes)
000000r 2               STAL            = $C1           ; Pointer for tape I/O (2 bytes)
000000r 2               EAL             = $C3           ; Pointer for tape I/O (2 bytes)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Screen and Color Memory (Unexpanded VIC-20)
000000r 2               ;=============================================================================
000000r 2               SCREEN          = $1E00         ; Screen memory start (22x23 default)
000000r 2               COLRAM          = $9600         ; Color RAM start
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; User BASIC Memory
000000r 2               ;=============================================================================
000000r 2               BASIC_START     = $1001         ; Start of BASIC program area
000000r 2               BASIC_END       = $1E00         ; End of BASIC (screen memory starts)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; VIC Chip Registers (6560/6561 Video Interface Chip)
000000r 2               ;=============================================================================
000000r 2               VIC             = $9000         ; Base address of VIC chip
000000r 2               
000000r 2               ; Individual VIC registers
000000r 2               VIC_CR0         = $9000         ; Horizontal centering (bit 7 = interlace)
000000r 2               VIC_CR1         = $9001         ; Vertical centering
000000r 2               VIC_CR2         = $9002         ; Video matrix columns (bits 0-6, bit 7=raster)
000000r 2               VIC_CR3         = $9003         ; Raster value (bits 1-7 = rows*2, bit 0=character size)
000000r 2               VIC_CR4         = $9004         ; TV raster beam location (read only)
000000r 2               VIC_CR5         = $9005         ; Video matrix start address (bits 4-7)
000000r 2               VIC_CRA         = $900A         ; Bass frequency
000000r 2               VIC_CRB         = $900B         ; Alto frequency
000000r 2               VIC_CRC         = $900C         ; Soprano frequency
000000r 2               VIC_CRD         = $900D         ; Noise frequency
000000r 2               VIC_CRE         = $900E         ; Auxiliary color / Volume
000000r 2               VIC_CRF         = $900F         ; Screen & border colors / reverse mode
000000r 2               
000000r 2               ; VIC register aliases
000000r 2               VIC_HORZ        = VIC_CR0       ; Horizontal position
000000r 2               VIC_VERT        = VIC_CR1       ; Vertical position
000000r 2               VIC_COLUMNS     = VIC_CR2       ; Number of columns
000000r 2               VIC_ROWS        = VIC_CR3       ; Number of rows
000000r 2               VIC_RASTER      = VIC_CR4       ; Raster position
000000r 2               VIC_ORIGIN      = VIC_CR5       ; Screen memory location
000000r 2               VIC_BASS        = VIC_CRA       ; Sound: Bass voice
000000r 2               VIC_ALTO        = VIC_CRB       ; Sound: Alto voice
000000r 2               VIC_SOPRANO     = VIC_CRC       ; Sound: Soprano voice
000000r 2               VIC_NOISE       = VIC_CRD       ; Sound: Noise voice
000000r 2               VIC_VOLUME      = VIC_CRE       ; Volume control (bits 0-3)
000000r 2               VIC_AUX_COLOR   = VIC_CRE       ; Auxiliary color (bits 4-7)
000000r 2               VIC_BACKGROUND  = VIC_CRF       ; Background color (bits 4-7)
000000r 2               VIC_BORDER      = VIC_CRF       ; Border color (bits 0-2)
000000r 2               VIC_REVERSE     = VIC_CRF       ; Reverse mode (bit 3)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; VIA Chip #1 Registers (6522 VIA - Keyboard, Joystick)
000000r 2               ;=============================================================================
000000r 2               VIA1            = $9110         ; Base address of VIA1
000000r 2               VIA1_PB         = $9110         ; Port B (keyboard row select, joystick)
000000r 2               VIA1_PA1        = $9111         ; Port A (keyboard column read)
000000r 2               VIA1_DDRB       = $9112         ; Data direction register B
000000r 2               VIA1_DDRA       = $9113         ; Data direction register A
000000r 2               VIA1_T1CL       = $9114         ; Timer 1 counter low
000000r 2               VIA1_T1CH       = $9115         ; Timer 1 counter high
000000r 2               VIA1_T1LL       = $9116         ; Timer 1 latch low
000000r 2               VIA1_T1LH       = $9117         ; Timer 1 latch high
000000r 2               VIA1_T2CL       = $9118         ; Timer 2 counter low
000000r 2               VIA1_T2CH       = $9119         ; Timer 2 counter high
000000r 2               VIA1_SR         = $911A         ; Shift register
000000r 2               VIA1_ACR        = $911B         ; Auxiliary control register
000000r 2               VIA1_PCR        = $911C         ; Peripheral control register
000000r 2               VIA1_IFR        = $911D         ; Interrupt flag register
000000r 2               VIA1_IER        = $911E         ; Interrupt enable register
000000r 2               VIA1_PA2        = $911F         ; Port A (no handshake)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; VIA Chip #2 Registers (6522 VIA - Serial, Tape, Joystick)
000000r 2               ;=============================================================================
000000r 2               VIA2            = $9120         ; Base address of VIA2
000000r 2               VIA2_PB         = $9120         ; Port B (serial bus, tape control, joystick)
000000r 2               VIA2_PA1        = $9121         ; Port A (serial bus)
000000r 2               VIA2_DDRB       = $9122         ; Data direction register B
000000r 2               VIA2_DDRA       = $9123         ; Data direction register A
000000r 2               VIA2_T1CL       = $9124         ; Timer 1 counter low
000000r 2               VIA2_T1CH       = $9125         ; Timer 1 counter high
000000r 2               VIA2_T1LL       = $9126         ; Timer 1 latch low
000000r 2               VIA2_T1LH       = $9127         ; Timer 1 latch high
000000r 2               VIA2_T2CL       = $9128         ; Timer 2 counter low
000000r 2               VIA2_T2CH       = $9129         ; Timer 2 counter high
000000r 2               VIA2_SR         = $912A         ; Shift register
000000r 2               VIA2_ACR        = $912B         ; Auxiliary control register
000000r 2               VIA2_PCR        = $912C         ; Peripheral control register
000000r 2               VIA2_IFR        = $912D         ; Interrupt flag register
000000r 2               VIA2_IER        = $912E         ; Interrupt enable register
000000r 2               VIA2_PA2        = $912F         ; Port A (no handshake)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Joystick (VIA1 Port A = $9111, VIA2 Port B = $9120)
000000r 2               ; Active-low: bit is 0 when the switch is closed (direction/fire pressed)
000000r 2               ;=============================================================================
000000r 2               JOY_UP          = %00000100     ; VIA1_PA1 bit 2
000000r 2               JOY_DOWN        = %00001000     ; VIA1_PA1 bit 3
000000r 2               JOY_LEFT        = %00010000     ; VIA1_PA1 bit 4
000000r 2               JOY_FIRE        = %00100000     ; VIA1_PA1 bit 5
000000r 2               JOY_RIGHT       = %10000000     ; VIA2_PB bit 7
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Color Codes
000000r 2               ;=============================================================================
000000r 2               BLACK           = $00
000000r 2               WHITE           = $01
000000r 2               RED             = $02
000000r 2               CYAN            = $03
000000r 2               PURPLE          = $04
000000r 2               GREEN           = $05
000000r 2               BLUE            = $06
000000r 2               YELLOW          = $07
000000r 2               ORANGE          = $08
000000r 2               LIGHT_ORANGE    = $09
000000r 2               PINK            = $0A
000000r 2               LIGHT_CYAN      = $0B
000000r 2               LIGHT_PURPLE    = $0C
000000r 2               LIGHT_GREEN     = $0D
000000r 2               LIGHT_BLUE      = $0E
000000r 2               LIGHT_YELLOW    = $0F
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Character Codes (PETSCII)
000000r 2               ;=============================================================================
000000r 2               CHR_RETURN      = $0D
000000r 2               CHR_SPACE       = $20
000000r 2               CHR_DELETE      = $14
000000r 2               CHR_INSERT      = $94
000000r 2               CHR_HOME        = $13
000000r 2               CHR_CLEAR       = $93
000000r 2               CHR_RVSON       = $12           ; Reverse on
000000r 2               CHR_RVSOFF      = $92           ; Reverse off
000000r 2               CHR_DOWN        = $11
000000r 2               CHR_UP          = $91
000000r 2               CHR_RIGHT       = $1D
000000r 2               CHR_LEFT        = $9D
000000r 2               CHR_BLACK       = $90
000000r 2               CHR_WHITE       = $05
000000r 2               CHR_RED         = $1C
000000r 2               CHR_CYAN        = $9F
000000r 2               CHR_PURPLE      = $9C
000000r 2               CHR_GREEN       = $1E
000000r 2               CHR_BLUE        = $9E
000000r 2               CHR_YELLOW      = $9B
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; ROM Addresses
000000r 2               ;=============================================================================
000000r 2               CHARROM         = $8000         ; Character ROM
000000r 2               BASIC_ROM       = $C000         ; BASIC ROM start
000000r 2               KERNAL_ROM      = $E000         ; KERNAL ROM start
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; KERNAL Routines
000000r 2               ;=============================================================================
000000r 2               ; Internal KERNAL routines (address may vary by ROM version)
000000r 2               CINT            = $E518         ; Initialize screen editor
000000r 2               IOINIT          = $FDF9         ; Initialize I/O
000000r 2               RAMTAS          = $FD8D         ; Initialize RAM
000000r 2               RESTOR          = $FD52         ; Restore default I/O vectors
000000r 2               VECTOR          = $FD1A         ; Manage RAM vectors
000000r 2               
000000r 2               ; KERNAL Jump Table (standard across all VIC-20s)
000000r 2               SETMSG          = $FF90         ; Control KERNAL messages
000000r 2               SECOND          = $FF93         ; Send secondary address
000000r 2               TKSA            = $FF96         ; Send secondary address for talk
000000r 2               MEMTOP          = $FF99         ; Read/set top of memory
000000r 2               MEMBOT          = $FF9C         ; Read/set bottom of memory
000000r 2               SCNKEY          = $FF9F         ; Scan keyboard
000000r 2               SETTMO          = $FFA2         ; Set timeout for serial bus
000000r 2               ACPTR           = $FFA5         ; Input byte from serial bus
000000r 2               CIOUT           = $FFA8         ; Output byte to serial bus
000000r 2               UNTLK           = $FFAB         ; Send UNTALK to serial bus
000000r 2               UNLSN           = $FFAE         ; Send UNLISTEN to serial bus
000000r 2               LISTEN          = $FFB1         ; Send LISTEN to serial bus
000000r 2               TALK            = $FFB4         ; Send TALK to serial bus
000000r 2               READST          = $FFB7         ; Read I/O status word
000000r 2               SETLFS          = $FFBA         ; Set logical file parameters
000000r 2               SETNAM          = $FFBD         ; Set filename
000000r 2               OPEN            = $FFC0         ; Open a logical file
000000r 2               CLOSE           = $FFC3         ; Close a logical file
000000r 2               CHKIN           = $FFC6         ; Define file as default input
000000r 2               CHKOUT          = $FFC9         ; Define file as default output
000000r 2               CLRCHN          = $FFCC         ; Restore default I/O devices
000000r 2               CHRIN           = $FFCF         ; Input character from channel
000000r 2               CHROUT          = $FFD2         ; Output character to channel
000000r 2               LOAD            = $FFD5         ; Load RAM from device
000000r 2               SAVE            = $FFD8         ; Save RAM to device
000000r 2               SETTIM          = $FFDB         ; Set 24-hour clock
000000r 2               RDTIM           = $FFDE         ; Read 24-hour clock
000000r 2               STOP            = $FFE1         ; Check STOP key
000000r 2               GETIN           = $FFE4         ; Get character from keyboard
000000r 2               CLALL           = $FFE7         ; Close all channels and files
000000r 2               UDTIM           = $FFEA         ; Increment 24-hour clock
000000r 2               SCREEN_ORG      = $FFED         ; Return screen organization
000000r 2               PLOT            = $FFF0         ; Read/set cursor X/Y position
000000r 2               IOBASE          = $FFF3         ; Return I/O base address
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; IRQ/NMI Vectors
000000r 2               ;=============================================================================
000000r 2               IRQ_VECTOR      = $0314         ; IRQ vector (2 bytes)
000000r 2               BRK_VECTOR      = $0316         ; BRK vector (2 bytes)
000000r 2               NMI_VECTOR      = $0318         ; NMI vector (2 bytes)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Hardware Vectors (in ROM)
000000r 2               ;=============================================================================
000000r 2               HW_NMI          = $FFFA         ; NMI vector
000000r 2               HW_RESET        = $FFFC         ; Reset vector
000000r 2               HW_IRQ          = $FFFE         ; IRQ/BRK vector
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Useful Constants
000000r 2               ;=============================================================================
000000r 2               SCREEN_COLS     = 22            ; Default screen columns
000000r 2               SCREEN_ROWS     = 23            ; Default screen rows
000000r 2               JIFFY_PAL       = 50            ; Jiffies per second (PAL)
000000r 2               JIFFY_NTSC      = 60            ; Jiffies per second (NTSC)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Memory Expansion Configurations
000000r 2               ;=============================================================================
000000r 2               ; RAM Block 0 (BLK0) = $0400-$0FFF (3K)
000000r 2               ; RAM Block 1 (BLK1) = $2000-$3FFF (8K)
000000r 2               ; RAM Block 2 (BLK2) = $4000-$5FFF (8K)
000000r 2               ; RAM Block 3 (BLK3) = $6000-$7FFF (8K)
000000r 2               ; RAM Block 5 (BLK5) = $A000-$BFFF (8K)
000000r 2               
000000r 2               BLK0            = $0400         ; 3K expansion
000000r 2               BLK1            = $2000         ; 8K expansion
000000r 2               BLK2            = $4000         ; 8K expansion
000000r 2               BLK3            = $6000         ; 8K expansion
000000r 2               BLK5            = $A000         ; 8K expansion
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; End of VIC20.inc
000000r 2               ;=============================================================================
000000r 2               
000000r 1               
000000r 1               ; --- Platform constants (hal.inc) --------------------------------------------
000000r 1               SCR_COLS         = 22
000000r 1               SCR_ROWS         = 23
000000r 1               SCR_CELLS        = 506           ; 22 x 23
000000r 1               PANEL_X             = 0             ; The screen IS the panel
000000r 1               PANEL_Y             = 0
000000r 1               HAS_COLOR_RAM       = 1
000000r 1               
000000r 1               CHARSET_RAM         = $1400         ; 2 K, $1400-$1BFF
000000r 1               
000000r 1               .include "../src/constants.inc"
000000r 2               ; =============================================================================
000000r 2               ;   constants.inc — Wizards Lab, shared game constants
000000r 2               ; =============================================================================
000000r 2               ;   Everything here comes straight out of SPEC.md. If a number changes there,
000000r 2               ;   it changes here, and nowhere else. Nothing in this file is platform
000000r 2               ;   specific — see the per-platform WizardsLab.asm for PANEL_X / PANEL_Y and
000000r 2               ;   the hardware addresses.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Board (SPEC 3) ----------------------------------------------------------
000000r 2               BOARD_W             = 6         ; Playfield columns
000000r 2               BOARD_H             = 16        ; Playfield rows
000000r 2               BOARD_STRIDE        = 8         ; Bytes per row — two wasted, on purpose
000000r 2               BOARD_ROWS_ALLOC    = 20        ; 16 playfield + 2 floor sentinels + 2 reserved
000000r 2               BOARD_BYTES         = BOARD_ROWS_ALLOC * BOARD_STRIDE    ; 160
000000r 2               SPAWN_COL           = 2         ; 0-indexed, left of centre
000000r 2               MATCH_MIN           = 3         ; Run length that clears
000000r 2               
000000r 2               ; --- Tile encoding (SPEC 4) --------------------------------------------------
000000r 2               ;   tile = COLOR_BASE + (color << 3) + glyph
000000r 2               ;   The board byte IS the tile index. No translation on the way to the screen.
000000r 2               TILE_EMPTY          = $00
000000r 2               TILE_WALL           = $FF
000000r 2               COLOR_BASE          = $40
000000r 2               COLOR_MASK          = $F8       ; AND this and you have the colour key
000000r 2               GLYPH_MASK          = $07
000000r 2               WILD_BASE           = $70       ; Colour 6 — the prism
000000r 2               NUM_COLORS          = 6
000000r 2               
000000r 2               COLOR_RED           = 0
000000r 2               COLOR_YELLOW        = 1
000000r 2               COLOR_GREEN         = 2
000000r 2               COLOR_CYAN          = 3
000000r 2               COLOR_BLUE          = 4
000000r 2               COLOR_PURPLE        = 5
000000r 2               COLOR_WILD          = 6
000000r 2               
000000r 2               GLYPH_POTION        = 0
000000r 2               GLYPH_FIREBALL      = 1
000000r 2               GLYPH_BOLT          = 2
000000r 2               GLYPH_BOMB          = 3
000000r 2               GLYPH_STAR          = 4
000000r 2               GLYPH_GLOW          = 6         ; Match-flash frame. Potion colours only —
000000r 2                                               ;   WILD_BASE + GLYPH_GLOW is an arrow, not a
000000r 2                                               ;   glow, so the prism never takes this path.
000000r 2                                               ;   See PRISM_BLIP below and SPEC 4.4.
000000r 2               
000000r 2               ; --- Named tiles -------------------------------------------------------------
000000r 2               TILE_BLANK          = 0
000000r 2               TILE_BAR_H          = 1
000000r 2               TILE_BAR_V          = 2
000000r 2               TILE_COR_TL         = 3
000000r 2               TILE_COR_TR         = 4
000000r 2               TILE_COR_BL         = 5
000000r 2               TILE_COR_BR         = 6
000000r 2               TILE_WASH           = 7         ; PAUSE / dim wash, white
000000r 2               FONT_BASE           = 16        ; '0'..'9' then 'A'..'Z' then . x ! ~
000000r 2               FONT_DIGIT_0        = 16
000000r 2               FONT_LETTER_A       = 26
000000r 2               FONT_DOT            = 52        ; A CENTRED dot, not a baseline period — it is
000000r 2                                               ;   also frame 0 of the removal ring below
000000r 2               FONT_TIMES          = 53
000000r 2               FONT_BANG           = 54
000000r 2               FONT_TILDE          = 55        ; The banner ornament, ~~~LIKE THIS~~~
000000r 2               TEXT_END            = $FF       ; String terminator. Shares its value with
000000r 2                                               ;   TILE_WALL, which costs nothing: no string
000000r 2                                               ;   ever contains tile 255.
000000r 2               
000000r 2               ; The removal ring (SPEC 14). One animation, used for every removal there is:
000000r 2               ; the match shatter, the bomb blast, the star. It opens outward
000000r 2               ;
000000r 2               ;       FONT_DOT -> VFX_REMOVE1 -> VFX_REMOVE2 -> VFX_REMOVE3 -> empty
000000r 2               ;
000000r 2               ; and the prism's blip-out runs the same tiles closed inward (PRISM_BLIP).
000000r 2               VFX_REMOVE1         = 56
000000r 2               VFX_REMOVE2         = 57
000000r 2               VFX_REMOVE3         = 58
000000r 2               VFX_BEAM_H          = 59        ; The bolt's row
000000r 2               VFX_BEAM_V          = 60        ; The bolt's column
000000r 2               VFX_BEAM_CROSS      = 61        ; Drawn once, at the bolt's own cell
000000r 2               ARROW_UP            = 62        ; The title screen's controls (SPEC 13.1).
000000r 2               ARROW_DOWN          = 63        ;   Up and down live in group 7, left and
000000r 2               ARROW_LEFT          = 118       ;   right in group 14 — whichever white group
000000r 2               ARROW_RIGHT         = 119       ;   had a slot spare. Nothing indexes them.
000000r 2               
000000r 2               ; Group 14 is the prism's. Slots +0..+3 are its idle rotation and +4..+5 its
000000r 2               ; blip-out; there is no glow slot (SPEC A.3).
000000r 2               PRISM_SPIN          = WILD_BASE ; Four frames, WILD_BASE + 0..3
000000r 2               PRISM_SPIN_FRAMES   = 4
000000r 2               PRISM_BLIP          = WILD_BASE + 4     ; Two frames, then VFX_REMOVE2,
000000r 2                                                       ;   VFX_REMOVE1, FONT_DOT, empty
000000r 2               
000000r 2               ; Group 15 is the stone group: the petrified glyph set at the same offsets the
000000r 2               ; potions use, so a cell petrifies into its own shape —
000000r 2               ;
000000r 2               ;       petrified = PETRIFY_BASE + (tile & GLYPH_MASK)     for glyphs 0-4
000000r 2               ;
000000r 2               ; — and then the two tiles the margins are built from.
000000r 2               PETRIFY_BASE        = 120       ; +0 potion, +1 fireball, +2 bolt,
000000r 2                                               ;   +3 bomb, +4 star
000000r 2               TILE_RESERVED       = 125       ; Held for a sixth glyph, if one is ever added
000000r 2               TILE_SHELF          = 126       ; The shelf the panel stands on
000000r 2               TILE_BRICK          = 127       ; Brick — the margin fill
000000r 2               FRAME_DIM           = 8         ; Group 1 is group 0 byte for byte, one colour
000000r 2                                               ;   quieter, so frame_tile + FRAME_DIM is any
000000r 2                                               ;   frame piece's dim twin (SPEC A.3)
000000r 2               ART_BASE            = 128       ; Groups 16-31 — one hatch in sixteen colours,
000000r 2                                               ;   the title screen's magic field (SPEC 13.1)
000000r 2               ART_TILES           = 128
000000r 2               
000000r 2               ; --- Panel geometry (SPEC 12) ------------------------------------------------
000000r 2               ;   One 22 x 24 panel, rendered identically on all three machines. PANEL_Y is
000000r 2               ;   0 everywhere; only PANEL_X differs. The panel is vertically symmetric —
000000r 2               ;   backdrop row, band row, backdrop row, eighteen rows of frame, backdrop row,
000000r 2               ;   band row, backdrop row — which is why 24 is the height. The AC6502 is the
000000r 2               ;   exact fit; the VIC-20 clips panel row 23 off the bottom and the C64 has one
000000r 2               ;   spare screen row (24) below the panel. See SPEC 12.4.
000000r 2               PANEL_W             = 22
000000r 2               PANEL_H             = 24
000000r 2               
000000r 2               WELL_ORIGIN_X       = 1         ; Panel-relative: board (0,0) lives here
000000r 2               WELL_ORIGIN_Y       = 4
000000r 2               
000000r 2               SCORE_X             = 12        ; 7 digits, cols 12-18
000000r 2               SCORE_Y             = 5
000000r 2               HIGH_X              = 12        ; 7 digits, cols 12-18
000000r 2               HIGH_Y              = 10
000000r 2               HIGHLVL_X           = 15        ; Level the high score was set on, 2 digits;
000000r 2                                               ;   the 'L' at col 14 is in the static image
000000r 2               HIGHLVL_Y           = 11
000000r 2               LEVEL_X             = 18        ; Single column: tens above units
000000r 2               LEVEL_Y             = 17        ; Tens at LEVEL_Y, units at LEVEL_Y + 1
000000r 2               NEXT_X              = 11        ; Single tile column
000000r 2               NEXT_Y              = 16        ; Cells A, B, C at NEXT_Y, +1, +2
000000r 2               MSG_X               = 2         ; The band's OWNED cells. Panel columns 0-1 and
000000r 2               MSG_W               = 18        ;   20-21 of row 22 are shelf in the static
000000r 2               MSG_Y               = 22        ;   image and code never touches them; the
000000r 2                                               ;   banner still centres on the full PANEL_W,
000000r 2                                               ;   which lands in the same place for an
000000r 2                                               ;   even-length string (SPEC 12.2).
000000r 2               
000000r 2               SCORE_DIGITS        = 7         ; Always all 7 drawn, zero padded
000000r 2               LEVEL_DIGITS        = 2         ; Always zero padded — level 5 draws "0" / "5"
000000r 2               
000000r 2               ; --- Piece and timing (SPEC 5.6, 11.3, 14) -----------------------------------
000000r 2               ;   Every duration in the game is a frame count, and most of them differ
000000r 2               ;   between NTSC and PAL so that wall-clock speed matches. Those live in
000000r 2               ;   tables.inc as two-entry tables indexed by Region, not here — a constant
000000r 2               ;   that is not one number is not a constant. The ones below are the same on
000000r 2               ;   both machines.
000000r 2               LOCK_RESET_MAX      = 4         ; Horizontal moves that may reset the lock
000000r 2                                               ;   delay, per piece. Rotation never resets it.
000000r 2               FALL_FRAMES         = 2         ; Frames a row while the pile falls into the
000000r 2                                               ;   holes a clear left (SPEC 14). The one
000000r 2                                               ;   duration in the game that is the same on
000000r 2                                               ;   both regions, because SPEC 14 says so: at
000000r 2                                               ;   two frames there is nothing to round.
000000r 2               
000000r 2               ; --- Levels (SPEC 10) --------------------------------------------------------
000000r 2               LEVEL_TILES         = 30        ; Tiles cleared per level
000000r 2               LEVEL_SPEED_CAP     = 16        ; Speed stops improving here
000000r 2               LEVEL_MAX_SHOWN     = 99
000000r 2               
000000r 2               ; --- Scoring (SPEC 9) --------------------------------------------------------
000000r 2               BONUS_FIREBALL      = $0500     ; BCD
000000r 2               BONUS_BOLT          = $0300
000000r 2               BONUS_BOMB          = $0300
000000r 2               BONUS_PRISM         = $0400
000000r 2               BONUS_LEVELUP       = $1000
000000r 2               STAR_SHIFT_CAP      = 3         ; Three doublings — x8
000000r 2               SCORE_BYTES         = 4         ; 8 nibbles packed BCD; the top one stays 0,
000000r 2                                               ;   so 7 digits show and the score wraps at
000000r 2                                               ;   10,000,000.
000000r 2               HIGH_INIT_LO        = $00       ; 0010000
000000r 2               HIGH_INIT_MID       = $00
000000r 2               HIGH_INIT_HI        = $01
000000r 2               HIGH_INIT_TOP       = $00
000000r 2               
000000r 2               ; --- Reagent probability, out of 256 (SPEC 5.3) ------------------------------
000000r 2               PSPECIAL_BANDS      = 5
000000r 2               
000000r 2               ; --- Input bitmask (SPEC 11.1) -----------------------------------------------
000000r 2               ;   Active HIGH. Each platform inverts and remaps its own hardware into this.
000000r 2               INPUT_UP            = %00000001 ; Rotate forward
000000r 2               INPUT_DOWN          = %00000010 ; Soft drop
000000r 2               INPUT_LEFT          = %00000100
000000r 2               INPUT_RIGHT         = %00001000
000000r 2               INPUT_FIRE          = %00010000 ; Rotate reverse / confirm
000000r 2               INPUT_PAUSE         = %00100000
000000r 2               INPUT_MASK          = %00111111 ; Everything the game reads. Bits 6-7 are free
000000r 2                                               ;   for a platform to use as scratch inside
000000r 2                                               ;   HalReadInput, as long as it strips them.
000000r 2               
000000r 2               ; --- Game states (SPEC 13) ---------------------------------------------------
000000r 2               STATE_TITLE         = 0
000000r 2               STATE_PLAY          = 1
000000r 2               STATE_PAUSE         = 2
000000r 2               STATE_GAMEOVER      = 3
000000r 2               
000000r 2               ; --- Play sub-states (SPEC 8) ------------------------------------------------
000000r 2               PLAY_FALLING        = 0
000000r 2               PLAY_LOCKING        = 1
000000r 2               PLAY_GLOW           = 2
000000r 2               PLAY_SHATTER        = 3
000000r 2               PLAY_GRAVITY        = 4
000000r 2               PLAY_ARE            = 5
000000r 2               
000000r 2               ; --- Buffer sizes (SPEC 17.1) ------------------------------------------------
000000r 2               MARKS_BYTES         = 16        ; One byte per row, bits 0-5
000000r 2               EFFECTQ_ENTRIES     = 48        ; 2 bytes each; drop on overflow
000000r 2               EFFECTQ_BYTES       = EFFECTQ_ENTRIES * 2
000000r 2               DIRTY_ENTRIES       = 64        ; 3 bytes each: offset lo, offset hi, tile
000000r 2               DIRTY_BYTES         = DIRTY_ENTRIES * 3
000000r 2               DIRTY_FLUSH_MAX     = 24        ; Cells pushed to the screen per frame.
000000r 2                                               ;   MEASURED, not estimated (PLAN.md S1). A
000000r 2                                               ;   flush costs 165 cycles a cell on the
000000r 2                                               ;   AC6502 and about 132 on the Commodores, so
000000r 2                                               ;   24 cells is 3965 cycles — inside vertical
000000r 2                                               ;   blank on all three, and tightest on the
000000r 2                                               ;   AC6502 at 1 MHz, whose 70 blank lines are
000000r 2                                               ;   roughly 4450. It is also a quarter of the
000000r 2                                               ;   96-cell well, so a full redraw is exactly
000000r 2                                               ;   four frames.
000000r 2                                               ;   Overrunning vblank is not dangerous on any
000000r 2                                               ;   of the three — no VRAM write spacing is
000000r 2                                               ;   anywhere near violated (S1) — it only
000000r 2                                               ;   risks a cell landing a frame late. This is
000000r 2                                               ;   a budget, not a hardware limit.
000000r 2               
000000r 1               .include "../src/zeropage.inc"
000000r 2               ; =============================================================================
000000r 2               ;   zeropage.inc — Wizards Lab, zero page allocation
000000r 2               ; =============================================================================
000000r 2               ;   The ZEROPAGE segment is placed at $40 on every platform. That window is
000000r 2               ;   free on all three:
000000r 2               ;
000000r 2               ;     AC6502   $003A-$00FF free for user programs (6502.inc memory map)
000000r 2               ;     VIC-20   all of page zero, once the cartridge stops calling the KERNAL
000000r 2               ;     C64      all of page zero EXCEPT $00/$01, which are the processor port
000000r 2               ;
000000r 2               ;   Starting at $40 clears the C64's port bytes and the AC6502's system
000000r 2               ;   scratch with room to spare, and keeps one number in three linker configs.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               .segment "ZEROPAGE"
000000r 2               
000000r 2  xx xx        Ptr1:           .res 2      ; General pointer — free across any call boundary
000002r 2  xx xx        Ptr2:           .res 2      ; General pointer
000004r 2  xx xx        SrcPtr:         .res 2      ; Block copy source
000006r 2  xx xx        DstPtr:         .res 2      ; Block copy destination
000008r 2  xx xx        ScreenPtr:      .res 2      ; Current screen row base
00000Ar 2  xx xx        ColorPtr:       .res 2      ; Current colour RAM row base (Commodore only)
00000Cr 2               
00000Cr 2  xx           RngLo:          .res 1      ; 16-bit LFSR state — never both zero
00000Dr 2  xx           RngHi:          .res 1
00000Er 2               
00000Er 2  xx           Tmp0:           .res 1      ; Scratch. Never live across a JSR.
00000Fr 2  xx           Tmp1:           .res 1
000010r 2  xx           Tmp2:           .res 1
000011r 2  xx           Tmp3:           .res 1
000012r 2               
000012r 2               ; --- The match scanner (SPEC 6.2) --------------------------------------------
000012r 2               ;   One line of one pass at a time. The cursor is a BOARD INDEX rather than a
000012r 2               ;   row and a column, because all four passes are the same walk with a
000012r 2               ;   different step: +1 horizontal, +8 vertical, +9 diagonal, +7 anti-diagonal.
000012r 2  xx           ScanIdx:        .res 1      ; Where the cursor was when a run ended: ScanLine
000013r 2                                           ;   keeps it in X and spills it only here
000013r 2  xx           ScanStep:       .res 1      ; What to add to reach the next cell of this line
000014r 2  xx           ScanColor:      .res 1      ; Colour key of the run in progress ($FF = unset)
000015r 2  xx           ScanLen:        .res 1      ; Cells in it so far, wildcards included
000016r 2  xx           ScanEnd:        .res 1      ; Walk-back cursor while a finished run is marked
000017r 2  xx           ScanTop:        .res 1      ; Row base of the top of the pile. Every pass
000018r 2                                           ;   starts there rather than at row 0, which is
000018r 2                                           ;   most of the cost of a scan (match.asm)
000018r 2               
000018r 2               ; --- Board walks that call the renderer (SPEC 8 steps 6 and 8) ---------------
000018r 2               ;   RenderCell clobbers A, X and Y, so a walk that marks what it changes
000018r 2               ;   cannot keep its cursor in a register. GravIdx also has to survive from one
000018r 2               ;   frame to the next: a row of falling is a cursor and not a bulk enqueue,
000018r 2               ;   because a full well is more cells than the dirty ring holds (D12,
000018r 2               ;   SPEC 12.6).
000018r 2  xx           GravIdx:        .res 1      ; Cell the fall is walking up from, $FF when the
000019r 2                                           ;   row is finished
000019r 2  xx           GravMoved:      .res 1      ; Non-zero if this row of falling moved anything
00001Ar 2  xx           CellCount:      .res 1      ; Cells CascadeRemove has taken off the board
00001Br 2               
00001Br 2               ; --- Render and text scratch -------------------------------------------------
00001Br 2               ;   These ARE live across a JSR, unlike Tmp0-Tmp3, because text.asm calls
00001Br 2               ;   RenderMark once per cell and has to remember where it is. That is safe
00001Br 2               ;   only because RenderMark touches nothing here: it clobbers A, X and the
00001Br 2               ;   stack and nothing else (see render.asm). Do not call anything else from a
00001Br 2               ;   loop that holds one of these.
00001Br 2  xx           TextCol:        .res 1      ; Panel column the next glyph goes in
00001Cr 2  xx           TextRow:        .res 1      ; Panel row the string is drawn on
00001Dr 2  xx           TextIdx:        .res 1      ; Cursor within the string, or the BCD byte index
00001Er 2  xx           TextByte:       .res 1      ; The BCD byte being split into two digits
00001Fr 2  xx           TextSkip:       .res 1      ; Non-zero while the first high nibble is skipped
000020r 2  xx           FlushLeft:      .res 1      ; Cells left in this frame's flush budget
000021r 2  xx           RedrawCol:      .res 1      ; Panel column of the cell being marked. Shared by
000022r 2                                           ;   every routine that marks a run of cells in one
000022r 2                                           ;   column, because RenderMark clobbers X.
000022r 2               
000022r 1               .include "../src/ram.inc"
000022r 2               ; =============================================================================
000022r 2               ;   ram.inc — Wizards Lab, work RAM
000022r 2               ; =============================================================================
000022r 2               ;   SPEC.md section 17.1. Around 530 bytes, which is what lets the whole game
000022r 2               ;   fit the VIC-20's 1 KB of usable work RAM — the tightest of the three
000022r 2               ;   targets, and therefore the one the layout is designed against.
000022r 2               ;
000022r 2               ;   Every platform places the BSS segment somewhere different (see each
000022r 2               ;   linker config); nothing in this file cares where.
000022r 2               ; =============================================================================
000022r 2               
000022r 2               .segment "BSS"
000000r 2               
000000r 2               ; --- The board (SPEC 3.2) ----------------------------------------------------
000000r 2               ;   20 rows x 8 stride. Columns 6-7 of every row and rows 16-19 entirely are
000000r 2               ;   permanent $FF sentinels, so scans walk off the edge and stop by themselves.
000000r 2               ;   Page-align it: address(row,col) = Board + (row << 3) + col.
000000r 2               .align 256
000000r 2  xx xx xx xx  Board:          .res BOARD_BYTES
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
0000A0r 2               
0000A0r 2               ; --- Match / cascade state (SPEC 6.2, 8) -------------------------------------
0000A0r 2  xx xx xx xx  Marks:          .res MARKS_BYTES        ; One byte per row, bits 0-5 = columns
0000A4r 2  xx xx xx xx  
0000A8r 2  xx xx xx xx  
0000B0r 2  xx xx xx xx  EffectQ:        .res EFFECTQ_BYTES      ; Ring of pending reagent detonations
0000B4r 2  xx xx xx xx  
0000B8r 2  xx xx xx xx  
000110r 2  xx           EffectQHead:    .res 1
000111r 2  xx           EffectQTail:    .res 1
000112r 2  xx           RunCount:       .res 1                  ; Runs resolved in the current step
000113r 2  xx           ChainStep:      .res 1                  ; 1 on the first step of a cascade
000114r 2  xx           StarCount:      .res 1                  ; Doublings pending, capped at 3
000115r 2  xx           CascadeLo:      .res 1                  ; Cascade point accumulator, packed BCD
000116r 2  xx           CascadeMid:     .res 1
000117r 2  xx           CascadeHi:      .res 1
000118r 2               
000118r 2               ; --- Render (SPEC 12.6) ------------------------------------------------------
000118r 2               ;   A ring of DIRTY_ENTRIES cells waiting to be pushed to the screen, three
000118r 2               ;   bytes each: SCREEN column, SCREEN row, tile. Not a 16-bit screen offset —
000118r 2               ;   HalPlotCell takes a column and a row (hal.inc), and every platform reaches
000118r 2               ;   a cell through a per-row pointer table (SPEC 12.3), so an offset would only
000118r 2               ;   have to be taken apart again at the far end.
000118r 2               ;
000118r 2               ;   A ring rather than a list with a resume index, because a frame that flushes
000118r 2               ;   its cap leaves a remainder and the next frame's marks have to go somewhere.
000118r 2               ;   Head and tail are BYTE offsets into Dirty, not entry numbers, so stepping
000118r 2               ;   one entry is an add of 3 and never a multiply.
000118r 2  xx xx xx xx  Dirty:          .res DIRTY_BYTES        ; screen col, screen row, tile
00011Cr 2  xx xx xx xx  
000120r 2  xx xx xx xx  
0001D8r 2  xx           DirtyCount:     .res 1                  ; Entries pending, 0..DIRTY_ENTRIES
0001D9r 2  xx           DirtyHead:      .res 1                  ; Byte offset of the oldest pending
0001DAr 2  xx           DirtyTail:      .res 1                  ; Byte offset the next mark goes to
0001DBr 2  xx           RedrawIdx:      .res 1                  ; Board index RenderBoardStep resumes
0001DCr 2                                                       ;   at, or $FF when no redraw is
0001DCr 2                                                       ;   outstanding
0001DCr 2               
0001DCr 2               ; --- The falling piece (SPEC 5) ----------------------------------------------
0001DCr 2  xx           PieceCol:       .res 1
0001DDr 2  xx           PieceRow:       .res 1                  ; Row of cell A (the top cell)
0001DEr 2  xx           PieceA:         .res 1                  ; Tile bytes, top to bottom
0001DFr 2  xx           PieceB:         .res 1
0001E0r 2  xx           PieceC:         .res 1
0001E1r 2  xx           NextA:          .res 1                  ; The preview piece
0001E2r 2  xx           NextB:          .res 1
0001E3r 2  xx           NextC:          .res 1
0001E4r 2  xx           PieceDirty:     .res 1                  ; Non-zero when the three cells need
0001E5r 2                                                       ;   drawing. Not drawn on the spot,
0001E5r 2                                                       ;   because a full-board redraw may be
0001E5r 2                                                       ;   in flight and would paint over
0001E5r 2                                                       ;   them — see StatePlay (D14).
0001E5r 2               
0001E5r 2               ; --- Progress (SPEC 9, 10) ---------------------------------------------------
0001E5r 2  xx           ScoreLo:        .res 1                  ; 7 digits packed BCD, low byte first;
0001E6r 2  xx           ScoreMid:       .res 1                  ;   the top nibble of ScoreTop stays 0
0001E7r 2  xx           ScoreHi:        .res 1
0001E8r 2  xx           ScoreTop:       .res 1
0001E9r 2  xx           HighLo:         .res 1
0001EAr 2  xx           HighMid:        .res 1
0001EBr 2  xx           HighHi:         .res 1
0001ECr 2  xx           HighTop:        .res 1
0001EDr 2  xx           HighLevel:      .res 1                  ; Level the high score was set on, BCD
0001EEr 2  xx           Level:          .res 1                  ; Binary, 1-99
0001EFr 2  xx           TilesCleared:   .res 1                  ; Toward the next level, wraps at 30
0001F0r 2               
0001F0r 2               ; --- Timers, all in frames (SPEC 14) -----------------------------------------
0001F0r 2  xx           GravityTimer:   .res 1
0001F1r 2  xx           LockTimer:      .res 1
0001F2r 2  xx           LockResets:     .res 1
0001F3r 2  xx           DasTimer:       .res 1
0001F4r 2  xx           DasDir:         .res 1
0001F5r 2  xx           AreTimer:       .res 1
0001F6r 2  xx           AnimTimer:      .res 1
0001F7r 2  xx           BannerTimer:    .res 1
0001F8r 2  xx           FrameCounter:   .res 1                  ; Free-running from power-on; seeds RNG
0001F9r 2               
0001F9r 2               ; --- Input (SPEC 11.1) -------------------------------------------------------
0001F9r 2  xx           InputNow:       .res 1
0001FAr 2  xx           InputPrev:      .res 1
0001FBr 2  xx           InputEdge:      .res 1                  ; Newly pressed this frame
0001FCr 2               
0001FCr 2               ; --- State machine (SPEC 13) -------------------------------------------------
0001FCr 2  xx           GameState:      .res 1                  ; STATE_*
0001FDr 2  xx           PlayState:      .res 1                  ; PLAY_*
0001FEr 2  xx           TitlePage:      .res 1
0001FFr 2  xx           Region:         .res 1                  ; 0 = NTSC, 1 = PAL
000200r 2  xx           NeedsRedraw:    .res 1
000201r 2               
000201r 2               ; --- Audio (SPEC 16) ---------------------------------------------------------
000201r 2  xx           SfxRequest:     .res 1                  ; Written by logic, consumed by AudioTick
000202r 2  xx           SfxTimer:       .res 1
000203r 2  xx xx xx xx  SfxState:       .res 14
000207r 2  xx xx xx xx  
00020Br 2  xx xx xx xx  
000211r 2               
000211r 1               .include "../src/hal.inc"
000211r 2               ; =============================================================================
000211r 2               ;   hal.inc — Wizards Lab, the platform contract
000211r 2               ; =============================================================================
000211r 2               ;   Everything in src/ is shared, unmodified, by all three machines. The only
000211r 2               ;   things that differ are collected here: each platform's WizardsLab.asm must
000211r 2               ;   define these constants and implement these seven routines, and nothing
000211r 2               ;   else in src/ may touch hardware directly.
000211r 2               ;
000211r 2               ;   This file declares nothing. It is the documentation for the boundary, kept
000211r 2               ;   next to the code it constrains so it cannot drift out of date unnoticed.
000211r 2               ;
000211r 2               ;   CONSTANTS the platform must define BEFORE including the shared sources
000211r 2               ;   ---------------------------------------------------------------------
000211r 2               ;     PANEL_X, PANEL_Y      Where the 22 x 24 panel sits on this screen.
000211r 2               ;                             AC6502  5, 0      VIC-20  0, 0      C64  9, 0
000211r 2               ;                           PANEL_Y is 0 everywhere; the VIC-20 clips panel
000211r 2               ;                           row 23 and the C64 has one spare row below it.
000211r 2               ;     SCR_COLS           32 / 22 / 40
000211r 2               ;     SCR_ROWS           24 / 23 / 25
000211r 2               ;     HAS_COLOR_RAM         1 on the Commodores, 0 on the AC6502, whose colour
000211r 2               ;                           lives in the VDP colour table instead.
000211r 2               ;
000211r 2               ;   ROUTINES the platform must implement
000211r 2               ;   ------------------------------------
000211r 2               ;     HalInitVideo      Bring up the video hardware: black background and
000211r 2               ;                       border, the correct text/tile mode, tileset in place,
000211r 2               ;                       colours configured, screen cleared. Called once.
000211r 2               ;                       In:  nothing        Out: nothing
000211r 2               ;
000211r 2               ;     HalWaitFrame      Block until the start of the next vertical blank.
000211r 2               ;                       Everything below is called only between frames.
000211r 2               ;                       In:  nothing        Out: nothing
000211r 2               ;
000211r 2               ;     HalPlotCell       Write one cell, colour included where the platform has
000211r 2               ;                       per-cell colour.
000211r 2               ;                       In:  A = tile, X = screen column, Y = screen row
000211r 2               ;                       Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
000211r 2               ;
000211r 2               ;     HalBlitScreen     Draw a whole static screen from a name-table image in
000211r 2               ;                       ROM: SCR_COLS * SCR_ROWS bytes, row-major, plus
000211r 2               ;                       the matching colour image where the platform needs one.
000211r 2               ;                       In:  SrcPtr -> name table, Ptr1 -> colour table
000211r 2               ;                       Out: nothing
000211r 2               ;
000211r 2               ;     HalReadInput      Read stick and keyboard, fold both into one mask.
000211r 2               ;                       In:  nothing
000211r 2               ;                       Out: A = INPUT_* bits, ACTIVE HIGH
000211r 2               ;
000211r 2               ;     HalDetectRegion   Decide NTSC or PAL so the timing tables can be picked.
000211r 2               ;                       In:  nothing        Out: A = 0 NTSC, 1 PAL
000211r 2               ;
000211r 2               ;     HalSfx            Start a sound effect. May be a bare RTS until audio
000211r 2               ;                       exists.
000211r 2               ;                       In:  A = effect id (SPEC 16)
000211r 2               ;                       Out: nothing
000211r 2               ;
000211r 2               ;   The shared code assumes nothing about interrupts. Each platform may drive
000211r 2               ;   HalWaitFrame from a raster IRQ, a timer, or a status-register poll.
000211r 2               ; =============================================================================
000211r 2               
000211r 1               
000211r 1               ; =============================================================================
000211r 1               ;   Cartridge header — BLK5, $A000
000211r 1               ; =============================================================================
000211r 1               
000211r 1               .segment "CARTHDR"
000000r 1               
000000r 1  rr rr        .addr ColdStart                 ; Cold start vector
000002r 1  rr rr        .addr ColdStart                 ; Warm start vector (RESTORE = full restart)
000004r 1  41 30 C3 C2  .byte $41, $30, $C3, $C2, $CD   ; "A0CBM" autostart signature
000008r 1  CD           
000009r 1               
000009r 1               ; =============================================================================
000009r 1               ;   Entry
000009r 1               ; =============================================================================
000009r 1               
000009r 1               .segment "CODE"
000000r 1               
000000r 1               ColdStart:
000000r 1  78             sei
000001r 1  D8             cld
000002r 1  A2 FF          ldx #$FF
000004r 1  9A             txs                           ; Nothing did this for us
000005r 1               
000005r 1  20 rr rr       jsr GameInit                  ; Never returns
000008r 1               
000008r 1               ; --- Shared game code --------------------------------------------------------
000008r 1               .include "../src/main.asm"
000008r 2               ; =============================================================================
000008r 2               ;   main.asm — Wizards Lab, shared entry point and main loop
000008r 2               ; =============================================================================
000008r 2               ;   Included by every platform's WizardsLab.asm after that file has defined
000008r 2               ;   PANEL_X / PANEL_Y and its half of the HAL (see hal.inc). Nothing below
000008r 2               ;   touches hardware.
000008r 2               ;
000008r 2               ;   BUILD STATUS
000008r 2               ;   ------------
000008r 2               ;   Pieces spawn, steer, rotate, fall and lock, runs of three or more clear,
000008r 2               ;   the pile falls into the holes and chains keep going until nothing matches
000008r 2               ;   (PLAN.md P2, P3). Nothing scores yet — CascadeSettle banks a total that is
000008r 2               ;   still zero — and the clear is instant: GLOW and SHATTER are P6's, and slot
000008r 2               ;   into CascadeEnter between the scan and the fall.
000008r 2               ; =============================================================================
000008r 2               
000008r 2               ; -----------------------------------------------------------------------------
000008r 2               ;   GameInit — one-time setup, called from the cartridge entry point
000008r 2               ; -----------------------------------------------------------------------------
000008r 2               GameInit:
000008r 2  20 rr rr       jsr HalDetectRegion
00000Br 2  8D rr rr       sta Region
00000Er 2               
00000Er 2  20 rr rr       jsr HalInitVideo              ; Tiles in place, screen black and cleared
000011r 2  20 rr rr       jsr AudioInit
000014r 2  20 rr rr       jsr RenderDirtyReset
000017r 2               
000017r 2  A9 00          lda #0
000019r 2  8D rr rr       sta FrameCounter
00001Cr 2  20 rr rr       jsr RngSeed                   ; A zero LFSR state sticks at zero forever, and
00001Fr 2                                               ;   BSS is not cleared on all three machines, so
00001Fr 2                                               ;   seed it once here just to get it out of that
00001Fr 2                                               ;   hole. This is NOT the game's seed — SPEC 15
00001Fr 2                                               ;   forbids a constant one, and StateTitle
00001Fr 2                                               ;   reseeds from the player's reaction time
00001Fr 2                                               ;   before the first piece is ever rolled.
00001Fr 2  A9 00          lda #0
000021r 2  8D rr rr       sta InputNow
000024r 2  8D rr rr       sta InputPrev
000027r 2  8D rr rr       sta InputEdge
00002Ar 2  8D rr rr       sta TitlePage
00002Dr 2               
00002Dr 2  20 rr rr       jsr ScoreHighInit             ; Once a session, before the first ScoreReset
000030r 2  20 rr rr       jsr ScoreReset
000033r 2  20 rr rr       jsr BoardClear
000036r 2               
000036r 2               .ifdef WL_DEBUG
000036r 2                 jsr GameStart                 ; TEMPORARY: skip the title and start playing,
000036r 2                                               ;   because a headless machine has no input
000036r 2                                               ;   attached and would sit on the title screen
000036r 2                                               ;   forever. Nothing else about the build
000036r 2                                               ;   differs any more (PLAN.md section 3).
000036r 2               .else
000036r 2  A9 00          lda #STATE_TITLE
000038r 2  8D rr rr       sta GameState
00003Br 2  A9 01          lda #1
00003Dr 2  8D rr rr       sta NeedsRedraw
000040r 2               .endif
000040r 2                 ; falls through into GameLoop
000040r 2               
000040r 2               ; -----------------------------------------------------------------------------
000040r 2               ;   GameLoop — never returns
000040r 2               ; -----------------------------------------------------------------------------
000040r 2               GameLoop:
000040r 2  20 rr rr       jsr HalWaitFrame
000043r 2  EE rr rr       inc FrameCounter              ; Free-running from power-on; seeds the RNG
000046r 2               
000046r 2  20 rr rr       jsr RenderFlush               ; Screen writes happen in vertical blank only
000049r 2  20 rr rr       jsr InputPoll
00004Cr 2               
00004Cr 2  AD rr rr       lda GameState                 ; Dispatch on the current screen state
00004Fr 2  C9 00          cmp #STATE_TITLE
000051r 2  F0 0B          beq @Title
000053r 2  C9 01          cmp #STATE_PLAY
000055r 2  F0 0D          beq @Play
000057r 2  C9 02          cmp #STATE_PAUSE
000059r 2  F0 0F          beq @Pause
00005Br 2  4C rr rr       jmp StateGameOver
00005Er 2               
00005Er 2               @Title:
00005Er 2  20 rr rr       jsr StateTitle
000061r 2  4C rr rr       jmp @Audio
000064r 2               @Play:
000064r 2  20 rr rr       jsr StatePlay
000067r 2  4C rr rr       jmp @Audio
00006Ar 2               @Pause:
00006Ar 2  20 rr rr       jsr StatePause
00006Dr 2               
00006Dr 2               @Audio:
00006Dr 2  20 rr rr       jsr AudioTick
000070r 2  4C rr rr       jmp GameLoop
000073r 2               
000073r 2               ; =============================================================================
000073r 2               ;   States (SPEC 13)
000073r 2               ; =============================================================================
000073r 2               
000073r 2               ; -----------------------------------------------------------------------------
000073r 2               ;   StateTitle — blinking prompt over the drawn screen, and the magic field
000073r 2               ;   SPEC 13.1. There are no help pages: the controls are part of the screen
000073r 2               ;   image, so the only things moving here are the prompt and the field.
000073r 2               ; -----------------------------------------------------------------------------
000073r 2               StateTitle:
000073r 2  AD rr rr       lda NeedsRedraw
000076r 2  F0 0B          beq @Live
000078r 2  A9 00          lda #0
00007Ar 2  8D rr rr       sta NeedsRedraw
00007Dr 2  20 rr rr       jsr DrawTitleScreen
000080r 2  20 rr rr       jsr RenderDirtyReset          ; A full blit went behind the renderer's back
000083r 2               
000083r 2               @Live:
000083r 2                 ; TODO: blink the prompt every 30 frames, and shimmer the magic field —
000083r 2                 ; one NextRandom for a cell in the 14 x 2 block, one for a tile in
000083r 2                 ; ART_BASE..ART_BASE+ART_TILES-1, one RenderMark.
000083r 2  AD rr rr       lda InputEdge
000086r 2  29 11          and #(INPUT_FIRE | INPUT_UP)  ; Fire, or SPACE, which the keyboards fold
000088r 2  F0 06          beq @Done                     ;   into UP so it can rotate in play (D15)
00008Ar 2               
00008Ar 2  20 rr rr       jsr RngSeed                   ; SPEC 15 — seed from reaction time, not a constant
00008Dr 2  20 rr rr       jsr GameStart
000090r 2               @Done:
000090r 2  60             rts
000091r 2               
000091r 2               ; -----------------------------------------------------------------------------
000091r 2               ;   GameStart — enter play from the title screen
000091r 2               ; -----------------------------------------------------------------------------
000091r 2               GameStart:
000091r 2  20 rr rr       jsr ScoreReset
000094r 2  20 rr rr       jsr BoardClear
000097r 2               
000097r 2  A9 01          lda #1
000099r 2  8D rr rr       sta Level
00009Cr 2  A9 00          lda #0
00009Er 2  8D rr rr       sta TilesCleared
0000A1r 2  8D rr rr       sta DasDir                    ; No direction is held into a new game
0000A4r 2  8D rr rr       sta DasTimer
0000A7r 2  8D rr rr       sta PieceDirty
0000AAr 2               
0000AAr 2  20 rr rr       jsr DrawPlayScreen            ; The whole screen at once, behind the
0000ADr 2  20 rr rr       jsr RenderDirtyReset          ;   renderer's back — so drop anything queued
0000B0r 2                                               ;   against the screen that just went away
0000B0r 2               
0000B0r 2  20 rr rr       jsr TextBannerClear           ; The play image ships with the band reading
0000B3r 2                                               ;   `~~ PAUSED ~~` (SPEC 12.1); play owns it
0000B3r 2  20 rr rr       jsr RenderScore               ; The panel fields are code's, not the image's
0000B6r 2  20 rr rr       jsr RenderHigh
0000B9r 2  20 rr rr       jsr RenderLevel
0000BCr 2  20 rr rr       jsr RenderBoard               ; Queued across as many frames as it takes
0000BFr 2               
0000BFr 2  20 rr rr       jsr PieceGenerateNext         ; Fill the preview...
0000C2r 2  20 rr rr       jsr PieceSpawn                ; ...then promote it and refill. The board is
0000C5r 2  20 rr rr       jsr PieceGenerateNext         ;   empty, so the spawn cannot be blocked.
0000C8r 2  20 rr rr       jsr RenderNext
0000CBr 2               
0000CBr 2  A9 00          lda #PLAY_FALLING
0000CDr 2  8D rr rr       sta PlayState
0000D0r 2  A9 01          lda #STATE_PLAY
0000D2r 2  8D rr rr       sta GameState
0000D5r 2  60             rts
0000D6r 2               
0000D6r 2               ; -----------------------------------------------------------------------------
0000D6r 2               ;   StatePlay — the game
0000D6r 2               ;   SPEC 13.2. One frame is: advance whatever the play sub-state is doing,
0000D6r 2               ;   then queue whatever changed. Cascades run as sub-states rather than in a
0000D6r 2               ;   blocking loop so animation stays on the frame clock.
0000D6r 2               ; -----------------------------------------------------------------------------
0000D6r 2               StatePlay:
0000D6r 2  AD rr rr       lda InputEdge
0000D9r 2  29 20          and #INPUT_PAUSE
0000DBr 2  D0 3E          bne @ToPause
0000DDr 2               
0000DDr 2  AD rr rr       lda PlayState
0000E0r 2  C9 00          cmp #PLAY_FALLING
0000E2r 2  F0 0F          beq @Falling
0000E4r 2  C9 01          cmp #PLAY_LOCKING
0000E6r 2  F0 11          beq @Locking
0000E8r 2  C9 04          cmp #PLAY_GRAVITY
0000EAr 2  F0 13          beq @Gravity
0000ECr 2  C9 05          cmp #PLAY_ARE
0000EEr 2  F0 15          beq @Are
0000F0r 2  4C rr rr       jmp @Draw                     ; GLOW and SHATTER are P6's
0000F3r 2               
0000F3r 2               @Falling:
0000F3r 2  20 rr rr       jsr PlayFalling
0000F6r 2  4C rr rr       jmp @Draw
0000F9r 2               @Locking:
0000F9r 2  20 rr rr       jsr PlayLocking
0000FCr 2  4C rr rr       jmp @Draw
0000FFr 2               @Gravity:
0000FFr 2  20 rr rr       jsr PlayGravity
000102r 2  4C rr rr       jmp @Draw
000105r 2               @Are:
000105r 2  20 rr rr       jsr PlayAre
000108r 2               
000108r 2                 ; --- draw the piece, once whatever else wanted the screen has finished ----
000108r 2                 ;   D14. RenderBoard is a cursor that feeds the ring over several frames
000108r 2                 ;   (D12), so marks made while one is outstanding are drawn BEFORE the
000108r 2                 ;   redraw reaches those cells and are then painted over. Holding the piece
000108r 2                 ;   back until the redraw has finished is one byte and always right; the
000108r 2                 ;   alternative is a piece that vanishes for four frames after every pause.
000108r 2               @Draw:
000108r 2  AD rr rr       lda PieceDirty
00010Br 2  F0 0D          beq @Done
00010Dr 2  AD rr rr       lda RedrawIdx
000110r 2  10 08          bpl @Done                     ; A board redraw is still in flight
000112r 2  A9 00          lda #0
000114r 2  8D rr rr       sta PieceDirty
000117r 2  20 rr rr       jsr RenderPiece
00011Ar 2               @Done:
00011Ar 2  60             rts
00011Br 2               
00011Br 2               @ToPause:
00011Br 2  A9 02          lda #STATE_PAUSE
00011Dr 2  8D rr rr       sta GameState
000120r 2                 ; TODO (P7): wash the well with TILE_WASH so a pause cannot be used to study
000120r 2                 ; the board (13.3). A wash, not a blank — a blanked well reads as crashed.
000120r 2  60             rts
000121r 2               
000121r 2               ; -----------------------------------------------------------------------------
000121r 2               ;   PlayFalling — steer the piece, and drop it a row when the timer runs out
000121r 2               ;   SPEC 5.5, 5.6, 11.3
000121r 2               ; -----------------------------------------------------------------------------
000121r 2               PlayFalling:
000121r 2  20 rr rr       jsr PieceControl              ; Rotation and DAS; the result is ignored here
000124r 2                                               ;   because there is no lock delay to reset yet
000124r 2  20 rr rr       jsr PieceFallRate
000127r 2  85 rr          sta Tmp0
000129r 2  AD rr rr       lda GravityTimer              ; Pressing DOWN mid-wait must shorten the wait
00012Cr 2  C5 rr          cmp Tmp0                      ;   in progress, not just the next one
00012Er 2  90 05          bcc @Tick
000130r 2  A5 rr          lda Tmp0
000132r 2  8D rr rr       sta GravityTimer
000135r 2               @Tick:
000135r 2  CE rr rr       dec GravityTimer
000138r 2  D0 1A          bne @Done
00013Ar 2  20 rr rr       jsr PieceStep
00013Dr 2  B0 07          bcs @Land
00013Fr 2  20 rr rr       jsr PieceFallRate
000142r 2  8D rr rr       sta GravityTimer
000145r 2  60             rts
000146r 2               
000146r 2               @Land:
000146r 2  AE rr rr       ldx Region
000149r 2  BD rr rr       lda LockDelay,x
00014Cr 2  8D rr rr       sta LockTimer
00014Fr 2  A9 01          lda #PLAY_LOCKING
000151r 2  8D rr rr       sta PlayState
000154r 2               @Done:
000154r 2  60             rts
000155r 2               
000155r 2               ; -----------------------------------------------------------------------------
000155r 2               ;   PlayLocking — the lock delay, and the moves that may reset it
000155r 2               ;   SPEC 5.6 — a horizontal move resets the delay LOCK_RESET_MAX times; after
000155r 2               ;   that it runs out regardless. Rotation never resets it. A move that opens a
000155r 2               ;   gap underneath resumes falling, and the reset count carries.
000155r 2               ; -----------------------------------------------------------------------------
000155r 2               PlayLocking:
000155r 2  20 rr rr       jsr PieceControl
000158r 2  90 13          bcc @Settled
00015Ar 2  AD rr rr       lda LockResets
00015Dr 2  C9 04          cmp #LOCK_RESET_MAX
00015Fr 2  B0 0C          bcs @Settled
000161r 2  EE rr rr       inc LockResets
000164r 2  AE rr rr       ldx Region
000167r 2  BD rr rr       lda LockDelay,x
00016Ar 2  8D rr rr       sta LockTimer
00016Dr 2               
00016Dr 2               @Settled:
00016Dr 2  20 rr rr       jsr PieceCanFall
000170r 2  90 0C          bcc @Tick
000172r 2  A9 00          lda #PLAY_FALLING             ; It moved over a hole — fall again. SPEC 5.6
000174r 2  8D rr rr       sta PlayState                 ;   says the lock counter clears here and the
000177r 2                                               ;   reset count does not; nothing reads
000177r 2                                               ;   LockTimer while falling and the next
000177r 2                                               ;   landing loads it fresh, so it is already
000177r 2                                               ;   clear in every sense that matters.
000177r 2  20 rr rr       jsr PieceFallRate
00017Ar 2  8D rr rr       sta GravityTimer
00017Dr 2  60             rts
00017Er 2               
00017Er 2               @Tick:
00017Er 2  CE rr rr       dec LockTimer
000181r 2  D0 09          bne @Done
000183r 2  20 rr rr       jsr PieceLock
000186r 2  20 rr rr       jsr CascadeBegin              ; SPEC 8 — the cascade starts the moment the
000189r 2  4C rr rr       jmp CascadeEnter              ;   piece is board, and runs as sub-states
00018Cr 2               @Done:
00018Cr 2  60             rts
00018Dr 2               
00018Dr 2               ; -----------------------------------------------------------------------------
00018Dr 2               ;   CascadeEnter — run one cascade step and choose the sub-state after it
00018Dr 2               ;   In:  ChainStep set        Out: PlayState set.  Modifies: A, X, Y
00018Dr 2               ;   SPEC 8, D4. Called from the lock, and again from the bottom of every fall.
00018Dr 2               ;
00018Dr 2               ;   A step that clears something hands over to PLAY_GRAVITY; a step that finds
00018Dr 2               ;   nothing is where the cascade settles and the next piece is queued. P6
00018Dr 2               ;   inserts PLAY_GLOW and PLAY_SHATTER ahead of the fall without changing
00018Dr 2               ;   either branch.
00018Dr 2               ; -----------------------------------------------------------------------------
00018Dr 2               CascadeEnter:
00018Dr 2  20 rr rr       jsr CascadeStep
000190r 2  90 09          bcc @Settle
000192r 2               
000192r 2  20 rr rr       jsr BoardGravityBegin         ; Something went; let what was above it fall
000195r 2  A9 04          lda #PLAY_GRAVITY
000197r 2  8D rr rr       sta PlayState
00019Ar 2  60             rts
00019Br 2               
00019Br 2               @Settle:
00019Br 2  20 rr rr       jsr CascadeSettle             ; P4 banks the points here; P6 raises the
00019Er 2                                               ;   chain banner
00019Er 2  AE rr rr       ldx Region
0001A1r 2  BD rr rr       lda AreDelay,x
0001A4r 2  8D rr rr       sta AreTimer
0001A7r 2  A9 05          lda #PLAY_ARE
0001A9r 2  8D rr rr       sta PlayState
0001ACr 2  60             rts
0001ADr 2               
0001ADr 2               ; -----------------------------------------------------------------------------
0001ADr 2               ;   PlayGravity — the pile falls into the holes the clear left
0001ADr 2               ;   SPEC 8 step 8, SPEC 14 — a row every FALL_FRAMES, and when a row moves
0001ADr 2               ;   nothing the board has settled and the next step scans it.
0001ADr 2               ;
0001ADr 2               ;   The row itself may take more than one frame: BoardGravityStep is a cursor
0001ADr 2               ;   that stops when the dirty ring is full (board.asm). The beat only starts
0001ADr 2               ;   once the row has actually landed, so a heavy board falls a little slower
0001ADr 2               ;   rather than losing cells off the screen.
0001ADr 2               ; -----------------------------------------------------------------------------
0001ADr 2               PlayGravity:
0001ADr 2  A5 rr          lda GravIdx
0001AFr 2  10 0C          bpl @Working                  ; A row is still coming down
0001B1r 2               
0001B1r 2  CE rr rr       dec AnimTimer
0001B4r 2  D0 11          bne @Done
0001B6r 2  A5 rr          lda GravMoved
0001B8r 2  F0 0E          beq @Landed                   ; The last row moved nothing: everything is
0001BAr 2  20 rr rr       jsr BoardGravityBegin         ;   resting on something
0001BDr 2               
0001BDr 2               @Working:
0001BDr 2  20 rr rr       jsr BoardGravityStep
0001C0r 2  90 05          bcc @Done                     ; The ring filled — the rest waits for a flush
0001C2r 2  A9 02          lda #FALL_FRAMES              ; The row is down; hold it there for the beat
0001C4r 2  8D rr rr       sta AnimTimer
0001C7r 2               @Done:
0001C7r 2  60             rts
0001C8r 2               
0001C8r 2               @Landed:
0001C8r 2  EE rr rr       inc ChainStep                 ; SPEC 8 step 9
0001CBr 2  4C rr rr       jmp CascadeEnter
0001CEr 2               
0001CEr 2               ; -----------------------------------------------------------------------------
0001CEr 2               ;   PlayAre — the entry delay, then the next piece
0001CEr 2               ;   SPEC 5.6, 13.4 — a blocked spawn is game over.
0001CEr 2               ; -----------------------------------------------------------------------------
0001CEr 2               PlayAre:
0001CEr 2  CE rr rr       dec AreTimer
0001D1r 2  D0 10          bne @Done
0001D3r 2  20 rr rr       jsr PieceSpawn
0001D6r 2  B0 0C          bcs @Over
0001D8r 2  20 rr rr       jsr PieceGenerateNext
0001DBr 2  20 rr rr       jsr RenderNext
0001DEr 2  A9 00          lda #PLAY_FALLING
0001E0r 2  8D rr rr       sta PlayState
0001E3r 2               @Done:
0001E3r 2  60             rts
0001E4r 2               
0001E4r 2               @Over:
0001E4r 2  A9 03          lda #STATE_GAMEOVER           ; P7 owns the petrify animation; for now the
0001E6r 2  8D rr rr       sta GameState                 ;   game simply stops
0001E9r 2  60             rts
0001EAr 2               
0001EAr 2               ; -----------------------------------------------------------------------------
0001EAr 2               ;   StatePause
0001EAr 2               ; -----------------------------------------------------------------------------
0001EAr 2               StatePause:
0001EAr 2  AD rr rr       lda InputEdge
0001EDr 2  29 30          and #(INPUT_PAUSE | INPUT_FIRE)
0001EFr 2  F0 14          beq @Done
0001F1r 2  A9 01          lda #STATE_PLAY
0001F3r 2  8D rr rr       sta GameState
0001F6r 2  20 rr rr       jsr RenderBoard               ; Put the board back...
0001F9r 2  AD rr rr       lda PlayState                 ;   ...and the piece on top of it, once the
0001FCr 2  C9 02          cmp #PLAY_GLOW                ;   redraw has gone by (D14) — but only while
0001FEr 2  B0 05          bcs @Done                     ;   there IS one. From GLOW on up the piece is
000200r 2  A9 01          lda #1                        ;   in the board and PieceA-C are stale; the
000202r 2  8D rr rr       sta PieceDirty                ;   cascade may have taken those cells away
000205r 2               @Done:                          ;   entirely.
000205r 2  60             rts
000206r 2               
000206r 2               ; -----------------------------------------------------------------------------
000206r 2               ;   StateGameOver — petrify, banner, back to the title
000206r 2               ;   SPEC 13.4
000206r 2               ; -----------------------------------------------------------------------------
000206r 2               StateGameOver:
000206r 2                 ; TODO: petrify the well from the bottom up, 2 frames a row, then the banner
000206r 2                 ; and a 10 second timeout. Each cell keeps its own shape —
000206r 2                 ;   PETRIFY_BASE + (tile & GLYPH_MASK)
000206r 2                 ; — and empty cells stay empty (13.4).
000206r 2  AD rr rr       lda InputEdge
000209r 2  29 11          and #(INPUT_FIRE | INPUT_UP)  ; Fire, or SPACE (D15)
00020Br 2  F0 0A          beq @Done
00020Dr 2  A9 00          lda #STATE_TITLE
00020Fr 2  8D rr rr       sta GameState
000212r 2  A9 01          lda #1
000214r 2  8D rr rr       sta NeedsRedraw
000217r 2               @Done:
000217r 2  60             rts
000218r 2               
000218r 2               ; =============================================================================
000218r 2               ;   Static screen drawing
000218r 2               ; =============================================================================
000218r 2               ;   The whole static layout — panel frame, labels, and the margin artwork that
000218r 2               ;   fills the screen either side of it — comes out of the editors as one
000218r 2               ;   name-table image per platform. Code only ever draws over the top of it:
000218r 2               ;   the well, the score and level digits, the preview, and the message band.
000218r 2               ;
000218r 2               ;   All six images are real. They come out of artwork/WizardsLab.tms9918 —
000218r 2               ;   the master — by way of `make artwork`. See data/README.md.
000218r 2               ; =============================================================================
000218r 2               
000218r 2               DrawTitleScreen:
000218r 2  A9 rr          lda #<TitleScreen
00021Ar 2  85 rr          sta SrcPtr
00021Cr 2  A9 rr          lda #>TitleScreen
00021Er 2  85 rr          sta SrcPtr+1
000220r 2  A9 rr          lda #<TitleColor
000222r 2  85 rr          sta Ptr1
000224r 2  A9 rr          lda #>TitleColor
000226r 2  85 rr          sta Ptr1+1
000228r 2  4C rr rr       jmp HalBlitScreen
00022Br 2               
00022Br 2               DrawPlayScreen:
00022Br 2  A9 rr          lda #<PlayScreen
00022Dr 2  85 rr          sta SrcPtr
00022Fr 2  A9 rr          lda #>PlayScreen
000231r 2  85 rr          sta SrcPtr+1
000233r 2  A9 rr          lda #<PlayColor
000235r 2  85 rr          sta Ptr1
000237r 2  A9 rr          lda #>PlayColor
000239r 2  85 rr          sta Ptr1+1
00023Br 2  4C rr rr       jmp HalBlitScreen
00023Er 2               
00023Er 1               .include "../src/rng.asm"
00023Er 2               ; =============================================================================
00023Er 2               ;   rng.asm — Wizards Lab, random numbers
00023Er 2               ; =============================================================================
00023Er 2               ;   A 16-bit Galois LFSR with the conventional $B400 taps, which is maximal
00023Er 2               ;   length: it visits all 65535 non-zero states before repeating. Eight shifts
00023Er 2               ;   per call, one whole byte out.
00023Er 2               ;
00023Er 2               ;   Seeding matters more than the generator does. A fixed seed would deal the
00023Er 2               ;   same first three pieces every session and the game would feel dead, so the
00023Er 2               ;   seed is taken from the free-running frame counter at the moment the player
00023Er 2               ;   presses fire on the title screen — human reaction time is the entropy.
00023Er 2               ;
00023Er 2               ;   SPEC.md section 15.
00023Er 2               ; =============================================================================
00023Er 2               
00023Er 2               ; -----------------------------------------------------------------------------
00023Er 2               ;   RngSeed — seed from the frame counter
00023Er 2               ;   In:  nothing (reads FrameCounter)
00023Er 2               ;   Out: nothing.  Modifies: A
00023Er 2               ; -----------------------------------------------------------------------------
00023Er 2               RngSeed:
00023Er 2  AD rr rr       lda FrameCounter
000241r 2  09 01          ora #$01                      ; Never let the state reach zero — it sticks
000243r 2  85 rr          sta RngLo
000245r 2  49 5A          eor #$5A                      ; Spread one byte of entropy over both halves
000247r 2  85 rr          sta RngHi
000249r 2  60             rts
00024Ar 2               
00024Ar 2               ; -----------------------------------------------------------------------------
00024Ar 2               ;   RngNext — next pseudo-random byte
00024Ar 2               ;   In:  nothing
00024Ar 2               ;   Out: A = random 0-255.  Modifies: A, X, flags
00024Ar 2               ; -----------------------------------------------------------------------------
00024Ar 2               RngNext:
00024Ar 2  A2 08          ldx #8                        ; Eight shifts give one whole output byte
00024Cr 2               @Bit:
00024Cr 2  46 rr          lsr RngHi                     ; Shift the 16-bit state right one place,
00024Er 2  66 rr          ror RngLo                     ;   the bit falling out of bit 0 lands in C
000250r 2  90 06          bcc @NoTap
000252r 2  A5 rr          lda RngHi
000254r 2  49 B4          eor #$B4                      ; Galois feedback mask $B400
000256r 2  85 rr          sta RngHi
000258r 2               @NoTap:
000258r 2  CA             dex
000259r 2  D0 F1          bne @Bit
00025Br 2  A5 rr          lda RngLo
00025Dr 2  60             rts
00025Er 2               
00025Er 2               ; -----------------------------------------------------------------------------
00025Er 2               ;   RngRange — a random number below a small limit
00025Er 2               ;   In:  A = limit, 1-128
00025Er 2               ;   Out: A = 0 .. limit-1.  Modifies: A, X, Tmp0, Tmp1.  PRESERVES Y.
00025Er 2               ;
00025Er 2               ;   Not a modulo. `random % 6` throws four of the 256 outcomes into the low
00025Er 2               ;   values and leaves colours 0-3 a shade likelier than 4-5; this takes the
00025Er 2               ;   HIGH byte of (random * limit) instead, which spreads the remainder evenly
00025Er 2               ;   across the range and costs a fixed eight shifts either way.
00025Er 2               ;
00025Er 2               ;   The eight-bit multiply keeps only the high byte: the low half falls out of
00025Er 2               ;   the accumulator one bit at a time and is never wanted.
00025Er 2               ;
00025Er 2               ;   Y is preserved so a caller can loop over the three cells of a piece with
00025Er 2               ;   it (piece.asm does).
00025Er 2               ; -----------------------------------------------------------------------------
00025Er 2               RngRange:
00025Er 2  48             pha                           ; The limit — RngNext wants A
00025Fr 2  20 rr rr       jsr RngNext
000262r 2  85 rr          sta Tmp0                      ; The random byte
000264r 2  68             pla
000265r 2  85 rr          sta Tmp1                      ; The limit, shifted out one bit at a time
000267r 2  A9 00          lda #0
000269r 2  A2 08          ldx #8
00026Br 2               @Bit:
00026Br 2  46 rr          lsr Tmp1                      ; Next multiplier bit into C
00026Dr 2  90 03          bcc @NoAdd
00026Fr 2  18             clc
000270r 2  65 rr          adc Tmp0                      ; Partial product, carry out into C
000272r 2               @NoAdd:
000272r 2  6A             ror a                         ; Shift the accumulator down, carry in at bit 7
000273r 2  CA             dex
000274r 2  D0 F5          bne @Bit
000276r 2  60             rts
000277r 2               
000277r 1               .include "../src/input.asm"
000277r 2               ; =============================================================================
000277r 2               ;   input.asm — Wizards Lab, input conditioning
000277r 2               ; =============================================================================
000277r 2               ;   SPEC.md section 11. HalReadInput hands back one active-high mask however
000277r 2               ;   the platform likes; everything above this line works on that mask and
000277r 2               ;   never touches hardware.
000277r 2               ;
000277r 2               ;   Auto-repeat applies to LEFT and RIGHT only. Rotate does NOT repeat — up
000277r 2               ;   must be released and pressed again. That is not a preference: a repeating
000277r 2               ;   rotate makes a three-cell Columns piece impossible to aim.
000277r 2               ; =============================================================================
000277r 2               
000277r 2               ; -----------------------------------------------------------------------------
000277r 2               ;   InputPoll — read the hardware and work out what is newly pressed
000277r 2               ;   In:  nothing
000277r 2               ;   Out: InputNow, InputPrev, InputEdge updated.  Modifies: A
000277r 2               ; -----------------------------------------------------------------------------
000277r 2               InputPoll:
000277r 2  AD rr rr       lda InputNow
00027Ar 2  8D rr rr       sta InputPrev
00027Dr 2  20 rr rr       jsr HalReadInput
000280r 2  8D rr rr       sta InputNow
000283r 2  4D rr rr       eor InputPrev                 ; Bits that changed
000286r 2  2D rr rr       and InputNow                  ; ...and are now down = newly pressed
000289r 2  8D rr rr       sta InputEdge
00028Cr 2  60             rts
00028Dr 2               
00028Dr 2               ; -----------------------------------------------------------------------------
00028Dr 2               ;   InputShift — LEFT/RIGHT with delayed auto shift
00028Dr 2               ;   Out: A = INPUT_LEFT, INPUT_RIGHT, or 0 if no move should happen this frame.
00028Dr 2               ;        Modifies: A, X
00028Dr 2               ;   SPEC 11.3 — initial delay 12 frames NTSC / 10 PAL, then 4 / 3.
00028Dr 2               ;
00028Dr 2               ;   A fresh press fires on the same frame it arrives; the delay is what comes
00028Dr 2               ;   after it, not before it, so a tap is always exactly one column.
00028Dr 2               ;
00028Dr 2               ;   Holding both directions at once is not something a stick can do, but two
00028Dr 2               ;   keys can. LEFT wins, and it wins consistently, so the piece sits still
00028Dr 2               ;   rather than shivering between the two.
00028Dr 2               ; -----------------------------------------------------------------------------
00028Dr 2               InputShift:
00028Dr 2  AD rr rr       lda InputNow
000290r 2  29 04          and #INPUT_LEFT
000292r 2  D0 07          bne @Dir
000294r 2  AD rr rr       lda InputNow
000297r 2  29 08          and #INPUT_RIGHT
000299r 2  F0 2A          beq @None
00029Br 2               
00029Br 2               @Dir:
00029Br 2  CD rr rr       cmp DasDir
00029Er 2  F0 10          beq @Held
0002A0r 2               
0002A0r 2  8D rr rr       sta DasDir                    ; A new direction: fire now, then wait
0002A3r 2  AE rr rr       ldx Region
0002A6r 2  BD rr rr       lda DasInitial,x
0002A9r 2  8D rr rr       sta DasTimer
0002ACr 2  AD rr rr       lda DasDir
0002AFr 2  60             rts
0002B0r 2               
0002B0r 2               @Held:
0002B0r 2  CE rr rr       dec DasTimer                  ; Always loaded non-zero, so this cannot wrap
0002B3r 2  D0 0D          bne @Wait
0002B5r 2  AE rr rr       ldx Region
0002B8r 2  BD rr rr       lda DasRepeat,x
0002BBr 2  8D rr rr       sta DasTimer
0002BEr 2  AD rr rr       lda DasDir
0002C1r 2  60             rts
0002C2r 2               
0002C2r 2               @Wait:
0002C2r 2  A9 00          lda #0
0002C4r 2  60             rts
0002C5r 2               
0002C5r 2               @None:
0002C5r 2  8D rr rr       sta DasDir                    ; A is already 0 — release, so the next press
0002C8r 2  60             rts                           ;   counts as fresh
0002C9r 2               
0002C9r 1               .include "../src/board.asm"
0002C9r 2               ; =============================================================================
0002C9r 2               ;   board.asm — Wizards Lab, the playfield
0002C9r 2               ; =============================================================================
0002C9r 2               ;   SPEC.md section 3. The board is 20 rows of 8 bytes, page-aligned, with
0002C9r 2               ;   columns 6-7 and rows 16-19 held permanently at $FF. Those sentinels are
0002C9r 2               ;   what let every scan in match.asm run without a bounds check.
0002C9r 2               ;
0002C9r 2               ;   address(row, col) = Board + (row << 3) + col
0002C9r 2               ; =============================================================================
0002C9r 2               
0002C9r 2               ; -----------------------------------------------------------------------------
0002C9r 2               ;   BoardClear — empty the playfield and lay the sentinels back down
0002C9r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X
0002C9r 2               ;
0002C9r 2               ;   Walls first over the whole 160 bytes, then the six playfield columns of
0002C9r 2               ;   the sixteen playfield rows punched back out to empty. Doing it in that
0002C9r 2               ;   order means the sentinels can never be forgotten: everything that is not
0002C9r 2               ;   explicitly playfield is a wall.
0002C9r 2               ;
0002C9r 2               ;   The wall loop counts UP and ends on a CPX. Counting down from 159 to a BPL
0002C9r 2               ;   looks tidier and is wrong: 159 is $9F, bit 7 already set, so the branch
0002C9r 2               ;   falls through after the first store and the other 159 bytes keep whatever
0002C9r 2               ;   the machine powered up with. That went unnoticed for a whole phase,
0002C9r 2               ;   because nothing read a sentinel until the falling piece needed a floor.
0002C9r 2               ; -----------------------------------------------------------------------------
0002C9r 2               BoardClear:
0002C9r 2  A9 FF          lda #TILE_WALL
0002CBr 2  A2 00          ldx #0
0002CDr 2               @Wall:
0002CDr 2  9D rr rr       sta Board,x
0002D0r 2  E8             inx
0002D1r 2  E0 A0          cpx #BOARD_BYTES
0002D3r 2  D0 F8          bne @Wall
0002D5r 2               
0002D5r 2  A2 00          ldx #0                        ; X walks the row bases, 0, 8, 16, ...
0002D7r 2               @Row:
0002D7r 2  A9 00          lda #TILE_EMPTY               ; Reloaded every row: the TXA below eats it
0002D9r 2  9D rr rr 9D    .repeat BOARD_W, COL
0002DDr 2  rr rr 9D rr  
0002E1r 2  rr 9D rr rr  
0002EBr 2                   sta Board + COL, x
0002EBr 2                 .endrepeat
0002EBr 2  8A             txa
0002ECr 2  18             clc
0002EDr 2  69 08          adc #BOARD_STRIDE
0002EFr 2  AA             tax
0002F0r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
0002F2r 2  90 E3          bcc @Row
0002F4r 2  60             rts
0002F5r 2               
0002F5r 2               ; -----------------------------------------------------------------------------
0002F5r 2               ;   BoardRowPtr — point Ptr1 at the start of a board row
0002F5r 2               ;   In:  A = row        Out: Ptr1 = &Board[row][0].  Modifies: A, Ptr1
0002F5r 2               ;
0002F5r 2               ;   Board is page-aligned and 160 bytes, so row * 8 is at most 152 and the low
0002F5r 2               ;   byte can never carry into the high one.
0002F5r 2               ; -----------------------------------------------------------------------------
0002F5r 2               BoardRowPtr:
0002F5r 2  0A             asl a
0002F6r 2  0A             asl a
0002F7r 2  0A             asl a
0002F8r 2  18             clc
0002F9r 2  69 rr          adc #<Board
0002FBr 2  85 rr          sta Ptr1
0002FDr 2  A9 rr          lda #>Board
0002FFr 2  85 rr          sta Ptr1+1
000301r 2  60             rts
000302r 2               
000302r 2               ; -----------------------------------------------------------------------------
000302r 2               ;   BoardGravityBegin / BoardGravityStep — the pile falls, one row at a time
000302r 2               ;   SPEC 8 step 8, SPEC 14: tiles descend one row every FALL_FRAMES.
000302r 2               ;
000302r 2               ;   A row of falling is one pass over the board, bottom to top, moving every
000302r 2               ;   tile that has an empty cell under it down into it. Repeat until a pass
000302r 2               ;   moves nothing and the columns are compacted — but repeat it a row at a
000302r 2               ;   time, because the fall is animated and a column that dropped four rows in
000302r 2               ;   one frame would read as a teleport.
000302r 2               ;
000302r 2               ;   Walking BOTTOM TO TOP is what makes a whole column fall together rather
000302r 2               ;   than one tile a frame: by the time the pass reaches a tile, the tile below
000302r 2               ;   it has already moved and left the gap.
000302r 2               ;
000302r 2               ;   The pass is a CURSOR, not a loop that runs to completion (D12, SPEC 12.6).
000302r 2               ;   Sixty tiles falling is a hundred-odd changed cells and the dirty ring holds
000302r 2               ;   64, so the pass stops when the ring is full and picks up where it stopped
000302r 2               ;   next frame. Nothing is dropped and the board is a legal board at every
000302r 2               ;   point it stops — one frame's worth of columns has fallen a row and the
000302r 2               ;   rest has not, which is a stagger nobody can see.
000302r 2               ;
000302r 2               ;   The two sentinel columns need no special case: a wall's "cell below" is
000302r 2               ;   another wall, so columns 6 and 7 never move.
000302r 2               ; -----------------------------------------------------------------------------
000302r 2               GRAV_TOP = (BOARD_H - 1) * BOARD_STRIDE - 1     ; The last cell of row 14, the
000302r 2                                                               ;   lowest row that can fall at
000302r 2                                                               ;   all. Row 15 is on the floor
000302r 2               BoardGravityBegin:
000302r 2  A9 77          lda #GRAV_TOP
000304r 2  85 rr          sta GravIdx
000306r 2  A9 00          lda #0
000308r 2  85 rr          sta GravMoved
00030Ar 2  60             rts
00030Br 2               
00030Br 2               ; -----------------------------------------------------------------------------
00030Br 2               ;   BoardGravityStep — carry on with the current row of falling
00030Br 2               ;   In:  nothing
00030Br 2               ;   Out: C set when the row is finished; GravMoved non-zero if it moved
00030Br 2               ;        anything. Modifies: A, X, Y, GravIdx, GravMoved, RedrawCol
00030Br 2               ; -----------------------------------------------------------------------------
00030Br 2               BoardGravityStep:
00030Br 2  A5 rr          lda GravIdx
00030Dr 2  30 3F          bmi @Finished                 ; $FF — the row is already done
00030Fr 2               
00030Fr 2               @Cell:
00030Fr 2  AD rr rr       lda DirtyCount                ; Room for both cells of a move, or wait for
000312r 2  C9 3E          cmp #(DIRTY_ENTRIES - 2)      ;   the flush. A mark dropped here would never
000314r 2  B0 3A          bcs @Later                    ;   be marked again (D6 is survivable only
000316r 2                                               ;   because nothing that MUST land uses it)
000316r 2               
000316r 2  A6 rr          ldx GravIdx
000318r 2  BD rr rr       lda Board,x
00031Br 2  F0 2D          beq @Next                     ; Nothing here to fall
00031Dr 2  BD rr rr       lda Board + BOARD_STRIDE,x
000320r 2  D0 28          bne @Next                     ; Something under it — a tile, or the floor
000322r 2               
000322r 2  BD rr rr       lda Board,x                   ; Move it down one row
000325r 2  9D rr rr       sta Board + BOARD_STRIDE,x
000328r 2  A9 00          lda #TILE_EMPTY
00032Ar 2  9D rr rr       sta Board,x
00032Dr 2  E6 rr          inc GravMoved
00032Fr 2               
00032Fr 2  A5 rr          lda GravIdx                   ; The cell it LEFT only needs redrawing if it
000331r 2  C9 08          cmp #BOARD_STRIDE             ;   is going to stay empty. If there is a tile
000333r 2  90 07          bcc @Vacated                  ;   above it, that tile lands here later in
000335r 2  A6 rr          ldx GravIdx                   ;   this same pass and its own arrival mark
000337r 2  BD rr rr       lda Board - BOARD_STRIDE,x    ;   covers the cell. Half the marks of a
00033Ar 2  D0 05          bne @Arrived                  ;   sliding column, which is what the ring
00033Cr 2               @Vacated:                       ;   pressure is made of.
00033Cr 2  A6 rr          ldx GravIdx
00033Er 2  20 rr rr       jsr RenderCell
000341r 2               @Arrived:
000341r 2  A5 rr          lda GravIdx
000343r 2  18             clc
000344r 2  69 08          adc #BOARD_STRIDE
000346r 2  AA             tax
000347r 2  20 rr rr       jsr RenderCell
00034Ar 2               
00034Ar 2               @Next:
00034Ar 2  C6 rr          dec GravIdx                   ; Down to 0, then $FF, which ends the pass —
00034Cr 2  10 C1          bpl @Cell                     ;   GRAV_TOP is 119, so bit 7 starts clear
00034Er 2                                               ;   (see PLAN.md section 3)
00034Er 2               @Finished:
00034Er 2  38             sec
00034Fr 2  60             rts
000350r 2               
000350r 2               @Later:
000350r 2  18             clc                           ; Ring full: the rest of this row waits a frame
000351r 2  60             rts
000352r 2               
000352r 1               .include "../src/piece.asm"
000352r 2               ; =============================================================================
000352r 2               ;   piece.asm — Wizards Lab, the falling piece
000352r 2               ; =============================================================================
000352r 2               ;   SPEC.md section 5. A piece is three independently generated cells stacked
000352r 2               ;   vertically, A on top. At most one of the three carries a reagent, which is
000352r 2               ;   enforced by rolling once for the piece rather than once per cell.
000352r 2               ;
000352r 2               ;   The piece is NOT in the board while it falls. Board cells under it stay
000352r 2               ;   empty until PieceLock writes them, which is what makes the movement tests
000352r 2               ;   below a plain read of the three target cells and what lets the erase be
000352r 2               ;   three blanks rather than three board reads.
000352r 2               ;
000352r 2               ;   Nothing here draws. Every routine that changes where the piece is or what
000352r 2               ;   it holds sets PieceDirty and lets StatePlay pick the moment (D14).
000352r 2               ; =============================================================================
000352r 2               
000352r 2               ; -----------------------------------------------------------------------------
000352r 2               ;   PieceIndex — board index of the piece's top cell
000352r 2               ;   In:  nothing
000352r 2               ;   Out: A = X = PieceRow * BOARD_STRIDE + PieceCol.  Modifies: A, X
000352r 2               ;
000352r 2               ;   Cells B and C are one and two strides on from it, and the cell below C is
000352r 2               ;   three — which is the only address arithmetic the rest of this file needs.
000352r 2               ;   Row 16 and beyond is a wall row, so "below C" is always a legal read.
000352r 2               ; -----------------------------------------------------------------------------
000352r 2               PieceIndex:
000352r 2  AD rr rr       lda PieceRow
000355r 2  0A             asl a
000356r 2  0A             asl a
000357r 2  0A             asl a                         ; row * 8
000358r 2  18             clc
000359r 2  6D rr rr       adc PieceCol
00035Cr 2  AA             tax
00035Dr 2  60             rts
00035Er 2               
00035Er 2               ; -----------------------------------------------------------------------------
00035Er 2               ;   PieceGenerateNext — roll the preview piece into NextA/NextB/NextC
00035Er 2               ;   In:  nothing (reads Level)
00035Er 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0, Tmp1
00035Er 2               ;   SPEC 5.2, 5.3 — colours uniform over 0-5, then one reagent roll.
00035Er 2               ; -----------------------------------------------------------------------------
00035Er 2               PieceGenerateNext:
00035Er 2  A0 00          ldy #0                        ; RngRange preserves Y, so it can index the
000360r 2               @Color:                         ;   three cells across the call
000360r 2  A9 06          lda #NUM_COLORS
000362r 2  20 rr rr       jsr RngRange                  ; 0-5, uniform (SPEC 5.2)
000365r 2  0A             asl a
000366r 2  0A             asl a
000367r 2  0A             asl a                         ; colour << 3 ...
000368r 2  18             clc
000369r 2  69 40          adc #COLOR_BASE               ;   ... + base, glyph 0, so it is a potion
00036Br 2  99 rr rr       sta NextA,y                   ; NextA/B/C are three consecutive bytes
00036Er 2  C8             iny
00036Fr 2  C0 03          cpy #3
000371r 2  90 ED          bcc @Color
000373r 2               
000373r 2                 ; --- does this piece carry a reagent at all? (SPEC 5.3) -------------------
000373r 2                 ;   One roll for the whole piece, which both caps it at one reagent and
000373r 2                 ;   costs three rolls fewer than asking each cell.
000373r 2  20 rr rr       jsr RngNext
000376r 2  85 rr          sta Tmp0                      ; The roll. Nothing below calls out until it
000378r 2                                               ;   has been compared, so Tmp0 is safe.
000378r 2  AE rr rr       ldx Level
00037Br 2  CA             dex                           ; LevelBand is indexed by level - 1 ...
00037Cr 2  E0 10          cpx #16
00037Er 2  90 02          bcc @Band
000380r 2  A2 0F          ldx #15                       ;   ... and clamped: band 4 is "13 and up"
000382r 2               @Band:
000382r 2  BD rr rr       lda LevelBand,x
000385r 2  AA             tax                           ; X = band 0-4
000386r 2  A5 rr          lda Tmp0
000388r 2  DD rr rr       cmp PSpecial,x                ; C clear = the roll came in under the chance
00038Br 2  B0 2E          bcs @Done
00038Dr 2               
00038Dr 2                 ; --- which cell, and which reagent ----------------------------------------
00038Dr 2  8A             txa
00038Er 2  48             pha                           ; The band, across the cell roll
00038Fr 2  A9 03          lda #3
000391r 2  20 rr rr       jsr RngRange                  ; 0, 1 or 2 — uniform over A, B and C
000394r 2  A8             tay                           ; Y survives the type roll below
000395r 2  68             pla
000396r 2  0A             asl a
000397r 2  0A             asl a                         ; band * 4 — ReagentThresholds is four
000398r 2  48             pha                           ;   thresholds per band
000399r 2  20 rr rr       jsr RngNext
00039Cr 2  85 rr          sta Tmp0                      ; The type roll
00039Er 2  68             pla
00039Fr 2  AA             tax
0003A0r 2  A5 rr          lda Tmp0
0003A2r 2               
0003A2r 2  DD rr rr       cmp ReagentThresholds+0,x     ; The cumulative-weight compare chain SPEC 5.3
0003A5r 2  90 15          bcc @Fireball                 ;   recommends over a 1280-byte lookup
0003A7r 2  DD rr rr       cmp ReagentThresholds+1,x
0003AAr 2  90 14          bcc @Bolt
0003ACr 2  DD rr rr       cmp ReagentThresholds+2,x
0003AFr 2  90 13          bcc @Bomb
0003B1r 2  DD rr rr       cmp ReagentThresholds+3,x
0003B4r 2  90 12          bcc @Star
0003B6r 2               
0003B6r 2  A9 70          lda #WILD_BASE                ; A Prism discards the colour it rolled and
0003B8r 2  99 rr rr       sta NextA,y                   ;   joins group 14 (SPEC 5.2)
0003BBr 2               @Done:
0003BBr 2  60             rts
0003BCr 2               
0003BCr 2               @Fireball:
0003BCr 2  A9 01          lda #GLYPH_FIREBALL
0003BEr 2  D0 0A          bne @Apply                    ; Always — every glyph below is non-zero
0003C0r 2               @Bolt:
0003C0r 2  A9 02          lda #GLYPH_BOLT
0003C2r 2  D0 06          bne @Apply
0003C4r 2               @Bomb:
0003C4r 2  A9 03          lda #GLYPH_BOMB
0003C6r 2  D0 02          bne @Apply
0003C8r 2               @Star:
0003C8r 2  A9 04          lda #GLYPH_STAR
0003CAr 2               @Apply:
0003CAr 2  19 rr rr       ora NextA,y                   ; The cell's glyph nibble is 0, so an ORA sets
0003CDr 2  99 rr rr       sta NextA,y                   ;   the reagent and keeps the rolled colour
0003D0r 2  60             rts
0003D1r 2               
0003D1r 2               ; -----------------------------------------------------------------------------
0003D1r 2               ;   PieceSpawn — promote the preview to the falling piece
0003D1r 2               ;   In:  nothing
0003D1r 2               ;   Out: C set if the spawn cells were occupied (game over)
0003D1r 2               ;        Modifies: A, X
0003D1r 2               ;   SPEC 5.4 — spawn column SPAWN_COL, rows 0-2, visible immediately.
0003D1r 2               ;
0003D1r 2               ;   The preview is copied whether or not the spawn succeeds; on a blocked
0003D1r 2               ;   spawn nothing looks at the piece again.
0003D1r 2               ; -----------------------------------------------------------------------------
0003D1r 2               PieceSpawn:
0003D1r 2  AD rr rr       lda NextA
0003D4r 2  8D rr rr       sta PieceA
0003D7r 2  AD rr rr       lda NextB
0003DAr 2  8D rr rr       sta PieceB
0003DDr 2  AD rr rr       lda NextC
0003E0r 2  8D rr rr       sta PieceC
0003E3r 2               
0003E3r 2  A9 02          lda #SPAWN_COL
0003E5r 2  8D rr rr       sta PieceCol
0003E8r 2  A9 00          lda #0
0003EAr 2  8D rr rr       sta PieceRow
0003EDr 2  8D rr rr       sta LockTimer
0003F0r 2  8D rr rr       sta LockResets                ; The reset allowance is per piece (SPEC 5.6)
0003F3r 2               
0003F3r 2  AD rr rr       lda Board + 0 * BOARD_STRIDE + SPAWN_COL
0003F6r 2  0D rr rr       ora Board + 1 * BOARD_STRIDE + SPAWN_COL
0003F9r 2  0D rr rr       ora Board + 2 * BOARD_STRIDE + SPAWN_COL
0003FCr 2  D0 0D          bne @Blocked
0003FEr 2               
0003FEr 2  20 rr rr       jsr ScoreGravity
000401r 2  8D rr rr       sta GravityTimer
000404r 2  A9 01          lda #1
000406r 2  8D rr rr       sta PieceDirty                ; Drawn immediately — there is no off-screen
000409r 2  18             clc                           ;   entry (SPEC 5.4)
00040Ar 2  60             rts
00040Br 2               
00040Br 2               @Blocked:
00040Br 2  38             sec
00040Cr 2  60             rts
00040Dr 2               
00040Dr 2               ; -----------------------------------------------------------------------------
00040Dr 2               ;   PieceMoveLeft / PieceMoveRight — one column, if all three cells are free
00040Dr 2               ;   Out: C set if the move happened (the caller resets the lock timer).
00040Dr 2               ;        Modifies: A, X
00040Dr 2               ;   SPEC 5.5 — no wall kicks; a 1-wide piece has nothing to kick off.
00040Dr 2               ;
00040Dr 2               ;   The right edge needs no bounds check: column 6 is a permanent $FF sentinel
00040Dr 2               ;   and fails the emptiness test on its own (SPEC 3.2). The LEFT edge does,
00040Dr 2               ;   because column -1 of row 0 is the byte before a page-aligned Board and
00040Dr 2               ;   belongs to nobody.
00040Dr 2               ; -----------------------------------------------------------------------------
00040Dr 2               PieceMoveLeft:
00040Dr 2  AD rr rr       lda PieceCol
000410r 2  F0 18          beq @No                       ; Column 0 — there is no sentinel to the left
000412r 2  20 rr rr       jsr PieceIndex
000415r 2  CA             dex
000416r 2  BD rr rr       lda Board + 0 * BOARD_STRIDE,x
000419r 2  1D rr rr       ora Board + 1 * BOARD_STRIDE,x
00041Cr 2  1D rr rr       ora Board + 2 * BOARD_STRIDE,x
00041Fr 2  D0 09          bne @No
000421r 2  20 rr rr       jsr RenderPieceErase
000424r 2  CE rr rr       dec PieceCol
000427r 2  4C rr rr       jmp PieceMoved
00042Ar 2               
00042Ar 2               @No:
00042Ar 2  18             clc
00042Br 2  60             rts
00042Cr 2               
00042Cr 2               PieceMoveRight:
00042Cr 2  20 rr rr       jsr PieceIndex
00042Fr 2  E8             inx
000430r 2  BD rr rr       lda Board + 0 * BOARD_STRIDE,x
000433r 2  1D rr rr       ora Board + 1 * BOARD_STRIDE,x
000436r 2  1D rr rr       ora Board + 2 * BOARD_STRIDE,x
000439r 2  D0 09          bne @No
00043Br 2  20 rr rr       jsr RenderPieceErase
00043Er 2  EE rr rr       inc PieceCol
000441r 2  4C rr rr       jmp PieceMoved
000444r 2               @No:
000444r 2  18             clc
000445r 2  60             rts
000446r 2               
000446r 2               ; -----------------------------------------------------------------------------
000446r 2               ;   PieceMoved — mark the piece for redraw and report success
000446r 2               ;   Out: C set.  Modifies: A
000446r 2               ; -----------------------------------------------------------------------------
000446r 2               PieceMoved:
000446r 2  A9 01          lda #1
000448r 2  8D rr rr       sta PieceDirty
00044Br 2  38             sec
00044Cr 2  60             rts
00044Dr 2               
00044Dr 2               ; -----------------------------------------------------------------------------
00044Dr 2               ;   PieceRotate / PieceRotateBack — cycle the three cells
00044Dr 2               ;   Out: nothing.  Modifies: A, X
00044Dr 2               ;   SPEC 5.5 — (A,B,C) -> (B,C,A) forward, (C,A,B) back. Always succeeds: the
00044Dr 2               ;   footprint never changes, so there is nothing to test and nothing to erase.
00044Dr 2               ;   Rotation does not reset the lock delay (SPEC 5.6).
00044Dr 2               ; -----------------------------------------------------------------------------
00044Dr 2               PieceRotate:
00044Dr 2  AD rr rr       lda PieceA
000450r 2  AE rr rr       ldx PieceB
000453r 2  8E rr rr       stx PieceA
000456r 2  AE rr rr       ldx PieceC
000459r 2  8E rr rr       stx PieceB
00045Cr 2  8D rr rr       sta PieceC
00045Fr 2  A9 01          lda #1
000461r 2  8D rr rr       sta PieceDirty
000464r 2  60             rts
000465r 2               
000465r 2               PieceRotateBack:
000465r 2  AD rr rr       lda PieceC
000468r 2  AE rr rr       ldx PieceB
00046Br 2  8E rr rr       stx PieceC
00046Er 2  AE rr rr       ldx PieceA
000471r 2  8E rr rr       stx PieceB
000474r 2  8D rr rr       sta PieceA
000477r 2  A9 01          lda #1
000479r 2  8D rr rr       sta PieceDirty
00047Cr 2  60             rts
00047Dr 2               
00047Dr 2               ; -----------------------------------------------------------------------------
00047Dr 2               ;   PieceCanFall — is the cell below C free?
00047Dr 2               ;   Out: C set if the piece can descend one row.  Modifies: A, X
00047Dr 2               ;   Three strides past cell A. With C on row 15 that reads row 18, which is a
00047Dr 2               ;   permanent wall row, so the floor needs no special case (SPEC 3.2).
00047Dr 2               ; -----------------------------------------------------------------------------
00047Dr 2               PieceCanFall:
00047Dr 2  20 rr rr       jsr PieceIndex
000480r 2  BD rr rr       lda Board + 3 * BOARD_STRIDE,x
000483r 2  D0 02          bne @No
000485r 2  38             sec
000486r 2  60             rts
000487r 2               @No:
000487r 2  18             clc
000488r 2  60             rts
000489r 2               
000489r 2               ; -----------------------------------------------------------------------------
000489r 2               ;   PieceStep — one row of gravity
000489r 2               ;   Out: C set if the piece has landed and the lock delay should start.
000489r 2               ;        Modifies: A, X
000489r 2               ; -----------------------------------------------------------------------------
000489r 2               PieceStep:
000489r 2  20 rr rr       jsr PieceCanFall
00048Cr 2  90 0B          bcc @Landed
00048Er 2  20 rr rr       jsr RenderPieceErase
000491r 2  EE rr rr       inc PieceRow
000494r 2  20 rr rr       jsr PieceMoved
000497r 2  18             clc                           ; Moved, so it has not landed
000498r 2  60             rts
000499r 2               @Landed:
000499r 2  38             sec
00049Ar 2  60             rts
00049Br 2               
00049Br 2               ; -----------------------------------------------------------------------------
00049Br 2               ;   PieceLock — write the three cells into the board
00049Br 2               ;   Out: nothing.  Modifies: A, X, Y
00049Br 2               ;   SPEC 5.6 — after this the caller runs a cascade.
00049Br 2               ;
00049Br 2               ;   Once the board holds the piece, drawing the piece and drawing those three
00049Br 2               ;   board cells are the same three writes, so RenderPiece does the queueing.
00049Br 2               ; -----------------------------------------------------------------------------
00049Br 2               PieceLock:
00049Br 2  20 rr rr       jsr PieceIndex
00049Er 2  AD rr rr       lda PieceA
0004A1r 2  9D rr rr       sta Board + 0 * BOARD_STRIDE,x
0004A4r 2  AD rr rr       lda PieceB
0004A7r 2  9D rr rr       sta Board + 1 * BOARD_STRIDE,x
0004AAr 2  AD rr rr       lda PieceC
0004ADr 2  9D rr rr       sta Board + 2 * BOARD_STRIDE,x
0004B0r 2               
0004B0r 2  20 rr rr       jsr RenderPiece
0004B3r 2  A9 00          lda #0
0004B5r 2  8D rr rr       sta PieceDirty                ; It is board now; nothing owes it a redraw
0004B8r 2  60             rts
0004B9r 2               
0004B9r 2               ; -----------------------------------------------------------------------------
0004B9r 2               ;   PieceFallRate — frames per row for this frame
0004B9r 2               ;   Out: A = frame count.  Modifies: A, X, Tmp0
0004B9r 2               ;   SPEC 5.5, 11.3 — soft drop substitutes its own rate and is ignored when
0004B9r 2               ;   gravity is already the faster of the two (levels 14+ on NTSC).
0004B9r 2               ; -----------------------------------------------------------------------------
0004B9r 2               PieceFallRate:
0004B9r 2  20 rr rr       jsr ScoreGravity              ; Speed[level] for this region
0004BCr 2  85 rr          sta Tmp0
0004BEr 2  AD rr rr       lda InputNow
0004C1r 2  29 02          and #INPUT_DOWN
0004C3r 2  F0 0A          beq @Gravity
0004C5r 2  AE rr rr       ldx Region
0004C8r 2  BD rr rr       lda SoftDropRate,x
0004CBr 2  C5 rr          cmp Tmp0                      ; C clear = soft drop is the faster
0004CDr 2  90 02          bcc @Done
0004CFr 2               @Gravity:
0004CFr 2  A5 rr          lda Tmp0
0004D1r 2               @Done:
0004D1r 2  60             rts
0004D2r 2               
0004D2r 2               ; -----------------------------------------------------------------------------
0004D2r 2               ;   PieceControl — apply this frame's input to the piece
0004D2r 2               ;   Out: C set if a horizontal move succeeded (the caller may reset the lock
0004D2r 2               ;        delay).  Modifies: A, X, Y
0004D2r 2               ;
0004D2r 2               ;   Rotation is edge triggered and never repeats: UP has to be released and
0004D2r 2               ;   pressed again. SPEC 11.3 calls that non-negotiable and it is — a
0004D2r 2               ;   repeating rotate makes a three-cell piece impossible to aim. Left and
0004D2r 2               ;   right go through InputShift, which is where the repeat lives.
0004D2r 2               ; -----------------------------------------------------------------------------
0004D2r 2               PieceControl:
0004D2r 2  AD rr rr       lda InputEdge
0004D5r 2  29 01          and #INPUT_UP
0004D7r 2  F0 03          beq @NoRotate
0004D9r 2  20 rr rr       jsr PieceRotate
0004DCr 2               @NoRotate:
0004DCr 2  AD rr rr       lda InputEdge
0004DFr 2  29 10          and #INPUT_FIRE
0004E1r 2  F0 03          beq @NoBack
0004E3r 2  20 rr rr       jsr PieceRotateBack
0004E6r 2               @NoBack:
0004E6r 2  20 rr rr       jsr InputShift
0004E9r 2  C9 04          cmp #INPUT_LEFT
0004EBr 2  F0 06          beq @Left
0004EDr 2  C9 08          cmp #INPUT_RIGHT
0004EFr 2  F0 05          beq @Right
0004F1r 2  18             clc
0004F2r 2  60             rts
0004F3r 2               @Left:
0004F3r 2  4C rr rr       jmp PieceMoveLeft
0004F6r 2               @Right:
0004F6r 2  4C rr rr       jmp PieceMoveRight
0004F9r 2               
0004F9r 1               .include "../src/match.asm"
0004F9r 2               ; =============================================================================
0004F9r 2               ;   match.asm — Wizards Lab, the match scanner
0004F9r 2               ; =============================================================================
0004F9r 2               ;   SPEC.md section 6. Four passes — horizontal, vertical, and both diagonals —
0004F9r 2               ;   each walking its axis and tracking a run colour and length. A run of three
0004F9r 2               ;   or more sets the MARK bit for each of its cells.
0004F9r 2               ;
0004F9r 2               ;   Colour comparison is the whole trick:
0004F9r 2               ;
0004F9r 2               ;       lda cell
0004F9r 2               ;       and #COLOR_MASK         ; the low three bits are the glyph, ignore them
0004F9r 2               ;       cmp ScanColor
0004F9r 2               ;
0004F9r 2               ;   which is why a red potion, a red fireball and a red star all match. The
0004F9r 2               ;   glyph decides what happens on removal, never whether cells match.
0004F9r 2               ;
0004F9r 2               ;   Wildcards (SPEC 6.3): a WILD cell continues any run. If the run has no
0004F9r 2               ;   colour yet it stays unset and is adopted from the first non-wild cell, so
0004F9r 2               ;   one prism can close a red horizontal run and a blue vertical run at once.
0004F9r 2               ;
0004F9r 2               ;   THE FOUR PASSES ARE ONE LOOP. A line is a start cell and a step, and the
0004F9r 2               ;   step is the only thing that differs: +1 across, +8 down, +9 down-right,
0004F9r 2               ;   +7 down-left. Every one of them ends on a sentinel rather than on a bounds
0004F9r 2               ;   check, which is what the 8-byte stride was bought for (SPEC 3.2):
0004F9r 2               ;
0004F9r 2               ;     across   from column 5, +1 lands on column 6      — wall
0004F9r 2               ;     down     from row 15,   +8 lands on row 16        — wall row
0004F9r 2               ;     down-r   from column 5, +9 lands on row+1 col 6   — wall
0004F9r 2               ;     down-l   from column 0, +7 lands on THIS row's column 7 — wall
0004F9r 2               ;
0004F9r 2               ;   The last one is the reason the left edge needs no test either: the byte
0004F9r 2               ;   before column 0 belongs to the row above, and it is already a wall.
0004F9r 2               ; =============================================================================
0004F9r 2               
0004F9r 2               ; -----------------------------------------------------------------------------
0004F9r 2               ;   MatchScan — find every run on the board
0004F9r 2               ;   In:  nothing
0004F9r 2               ;   Out: Marks filled, RunCount set, Z set if nothing matched.
0004F9r 2               ;        Modifies: A, X, Y, Scan*
0004F9r 2               ; -----------------------------------------------------------------------------
0004F9r 2               MatchScan:
0004F9r 2  20 rr rr       jsr MarksClear
0004FCr 2  A9 00          lda #0
0004FEr 2  8D rr rr       sta RunCount
000501r 2               
000501r 2  20 rr rr       jsr ScanFindTop               ; Everything below skips the empty air above
000504r 2  A5 rr          lda ScanTop                   ;   the pile, which on most boards is most of
000506r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE) ;   the board
000508r 2  B0 0C          bcs @Done                     ; Nothing on the board at all
00050Ar 2               
00050Ar 2  20 rr rr       jsr MatchScanHorizontal
00050Dr 2  20 rr rr       jsr MatchScanVertical
000510r 2  20 rr rr       jsr MatchScanDiagonal
000513r 2  20 rr rr       jsr MatchScanAntiDiagonal
000516r 2               @Done:
000516r 2  AD rr rr       lda RunCount                  ; Z set when nothing matched
000519r 2  60             rts
00051Ar 2               
00051Ar 2               ; -----------------------------------------------------------------------------
00051Ar 2               ;   ScanFindTop — board index of the first row that holds anything
00051Ar 2               ;   Out: ScanTop = row base, or BOARD_H * BOARD_STRIDE if the board is empty.
00051Ar 2               ;        Modifies: A, X, ScanTop
00051Ar 2               ;
00051Ar 2               ;   Every pass below starts here instead of at row 0. A pile six rows deep is
00051Ar 2               ;   scanned as six rows: 178 cells against 448, and the four passes come in
00051Ar 2               ;   under a third of the frame instead of over two whole ones. Finding it costs
00051Ar 2               ;   about 45 cycles a row of empty air, which is the cheapest part of the scan.
00051Ar 2               ;
00051Ar 2               ;   Correct as well as quick, and for a reason worth writing down: a line that
00051Ar 2               ;   reaches the pile at all must CROSS the pile's top row, because every one of
00051Ar 2               ;   the four steps moves down at most one row at a time. Starting the diagonals
00051Ar 2               ;   on that row rather than on row 0 therefore misses nothing.
00051Ar 2               ; -----------------------------------------------------------------------------
00051Ar 2               ScanFindTop:
00051Ar 2  A2 00          ldx #0
00051Cr 2               @Row:
00051Cr 2  BD rr rr       lda Board + 0,x               ; The six playfield columns; the two sentinel
00051Fr 2  1D rr rr       ora Board + 1,x               ;   ones would make every row look occupied
000522r 2  1D rr rr       ora Board + 2,x
000525r 2  1D rr rr       ora Board + 3,x
000528r 2  1D rr rr       ora Board + 4,x
00052Br 2  1D rr rr       ora Board + 5,x
00052Er 2  D0 09          bne @Found
000530r 2  8A             txa
000531r 2  18             clc
000532r 2  69 08          adc #BOARD_STRIDE
000534r 2  AA             tax
000535r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
000537r 2  90 E3          bcc @Row
000539r 2               @Found:
000539r 2  86 rr          stx ScanTop
00053Br 2  60             rts
00053Cr 2               
00053Cr 2               ; -----------------------------------------------------------------------------
00053Cr 2               ;   The four passes (SPEC 6.2). Each sets a step and hands ScanLine its start
00053Cr 2               ;   cells; the start cell rides the stack because ScanLine needs both index
00053Cr 2               ;   registers and the scratch bytes below it.
00053Cr 2               ; -----------------------------------------------------------------------------
00053Cr 2               MatchScanHorizontal:            ; Every row of the pile, column 0 rightward
00053Cr 2  A9 01          lda #1
00053Er 2  85 rr          sta ScanStep
000540r 2  A5 rr          lda ScanTop
000542r 2               @Line:
000542r 2  48             pha
000543r 2  20 rr rr       jsr ScanLine
000546r 2  68             pla
000547r 2  18             clc
000548r 2  69 08          adc #BOARD_STRIDE
00054Ar 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
00054Cr 2  90 F4          bcc @Line
00054Er 2  60             rts
00054Fr 2               
00054Fr 2               MatchScanVertical:              ; 6 columns, top of the pile downward
00054Fr 2  A9 08          lda #BOARD_STRIDE
000551r 2  85 rr          sta ScanStep
000553r 2  4C rr rr       jmp ScanTopRow
000556r 2               
000556r 2               MatchScanDiagonal:              ; down-right: the top row, then the left edge
000556r 2  A9 09          lda #(BOARD_STRIDE + 1)
000558r 2  85 rr          sta ScanStep
00055Ar 2  20 rr rr       jsr ScanTopRow
00055Dr 2  A9 00          lda #0
00055Fr 2  4C rr rr       jmp ScanEdgeColumn
000562r 2               
000562r 2               MatchScanAntiDiagonal:          ; down-left: the top row, then the right edge
000562r 2  A9 07          lda #(BOARD_STRIDE - 1)
000564r 2  85 rr          sta ScanStep
000566r 2  20 rr rr       jsr ScanTopRow
000569r 2  A9 05          lda #(BOARD_W - 1)
00056Br 2  4C rr rr       jmp ScanEdgeColumn
00056Er 2               
00056Er 2               ; -----------------------------------------------------------------------------
00056Er 2               ;   ScanTopRow — scan a line from each of the six cells of the pile's top row
00056Er 2               ;   ScanEdgeColumn — and from the rows below it, in the column in A
00056Er 2               ;   In:  ScanStep set, ScanTop set; A = column (ScanEdgeColumn only)
00056Er 2               ;
00056Er 2               ;   Between them those are every start cell a diagonal needs, and the top row
00056Er 2               ;   alone is every start cell the vertical pass needs. The top row is scanned
00056Er 2               ;   by the first, so the second skips it rather than scanning the longest
00056Er 2               ;   diagonal twice.
00056Er 2               ; -----------------------------------------------------------------------------
00056Er 2               ScanTopRow:
00056Er 2  A5 rr          lda ScanTop
000570r 2               @Line:
000570r 2  48             pha
000571r 2  20 rr rr       jsr ScanLine
000574r 2  68             pla
000575r 2  18             clc
000576r 2  69 01          adc #1
000578r 2  48             pha                           ; Six columns of that row, whichever row it
000579r 2  29 07          and #(BOARD_STRIDE - 1)       ;   is, so it is the COLUMN that ends the loop
00057Br 2  C9 06          cmp #BOARD_W                  ;   and not the index
00057Dr 2  68             pla                           ; PLA leaves C alone
00057Er 2  90 F0          bcc @Line
000580r 2  60             rts
000581r 2               
000581r 2               ScanEdgeColumn:
000581r 2  18             clc
000582r 2  65 rr          adc ScanTop                   ; That column, on the pile's top row...
000584r 2  18             clc
000585r 2  69 08          adc #BOARD_STRIDE             ;   ...and then the row below it
000587r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000589r 2  B0 0C          bcs @Done                     ; The pile is one row deep — there is no below
00058Br 2               @Line:
00058Br 2  48             pha
00058Cr 2  20 rr rr       jsr ScanLine
00058Fr 2  68             pla
000590r 2  18             clc
000591r 2  69 08          adc #BOARD_STRIDE
000593r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000595r 2  90 F4          bcc @Line
000597r 2               @Done:
000597r 2  60             rts
000598r 2               
000598r 2               ; -----------------------------------------------------------------------------
000598r 2               ;   ScanLine — walk one line, marking every run of MATCH_MIN or more
000598r 2               ;   In:  A = start board index, ScanStep = direction
000598r 2               ;   Out: nothing.  Modifies: A, X, Scan*, Marks, RunCount
000598r 2               ;
000598r 2               ;   ONLY A WALL ENDS THE LINE. A hole in the middle of a row breaks the run
000598r 2               ;   and the walk carries on past it, because the cells beyond it are a run of
000598r 2               ;   their own — a line that stopped at the first empty cell would never look
000598r 2               ;   below the top of the pile at all, which is very nearly the whole board.
000598r 2               ;
000598r 2               ;   A colour change ends the run and starts a new one at the cell that broke
000598r 2               ;   it — the cell that broke a red run is the first cell of the blue one, and
000598r 2               ;   any prisms that were riding the red run stay with the red run. SPEC 6.3
000598r 2               ;   gives a wildcard to the run it is already in, not to both.
000598r 2               ; -----------------------------------------------------------------------------
000598r 2               ScanLine:
000598r 2  AA             tax                           ; The cursor lives in X for the whole line:
000599r 2  A9 FF          lda #$FF                      ;   this loop runs about four hundred times a
00059Br 2  85 rr          sta ScanColor                 ;   scan and every cycle in it is four hundred
00059Dr 2  A9 00          lda #0                        ;   cycles of the frame
00059Fr 2  85 rr          sta ScanLen
0005A1r 2               
0005A1r 2               @Cell:
0005A1r 2  BD rr rr       lda Board,x
0005A4r 2  F0 41          beq @Gap                      ; A hole breaks the run, not the line
0005A6r 2  C9 FF          cmp #TILE_WALL
0005A8r 2  F0 52          beq @End                      ; A wall is where the line stops
0005AAr 2  29 F8          and #COLOR_MASK               ; The colour key, glyph discarded (SPEC 4.2)
0005ACr 2  C5 rr          cmp ScanColor
0005AEr 2  F0 19          beq @Grow                     ; Same colour — the commonest case, first
0005B0r 2  C9 70          cmp #WILD_BASE
0005B2r 2  F0 15          beq @Grow                     ; A prism continues any run (SPEC 6.3)
0005B4r 2               
0005B4r 2  A8             tay                           ; A different colour. Park it: everything
0005B5r 2  A5 rr          lda ScanColor                 ;   below either adopts it or starts a run
0005B7r 2  30 0E          bmi @Adopt                    ;   with it. $FF is the only value here with
0005B9r 2                                               ;   bit 7 set — colours are $40 to $70
0005B9r 2  A5 rr          lda ScanLen
0005BBr 2  C9 03          cmp #MATCH_MIN
0005BDr 2  B0 14          bcs @Close                    ; The run it broke was long enough to mark
0005BFr 2               
0005BFr 2  84 rr          sty ScanColor                 ; It was not, so no call and no marking: this
0005C1r 2  A9 01          lda #1                        ;   cell is simply the start of the next run.
0005C3r 2  85 rr          sta ScanLen                   ;   Five adjacent cells in six differ in
0005C5r 2  D0 04          bne @Advance                  ;   colour, so this is the path that decides
0005C7r 2                                               ;   what a scan costs
0005C7r 2               @Adopt:
0005C7r 2  84 rr          sty ScanColor
0005C9r 2               @Grow:
0005C9r 2  E6 rr          inc ScanLen
0005CBr 2               @Advance:
0005CBr 2  8A             txa
0005CCr 2  18             clc
0005CDr 2  65 rr          adc ScanStep
0005CFr 2  AA             tax
0005D0r 2  4C rr rr       jmp @Cell
0005D3r 2               
0005D3r 2               @Close:
0005D3r 2  86 rr          stx ScanIdx
0005D5r 2  20 rr rr       jsr MatchEmit                 ; Mark it — and MatchEmit leaves ScanLen zero
0005D8r 2  A6 rr          ldx ScanIdx
0005DAr 2  BD rr rr       lda Board,x
0005DDr 2  29 F8          and #COLOR_MASK
0005DFr 2  85 rr          sta ScanColor
0005E1r 2  A9 01          lda #1
0005E3r 2  85 rr          sta ScanLen
0005E5r 2  D0 E4          bne @Advance                  ; Always
0005E7r 2               
0005E7r 2               @Gap:
0005E7r 2  A5 rr          lda ScanLen
0005E9r 2  F0 E0          beq @Advance                  ; Nothing running — step over the hole. This
0005EBr 2                                               ;   is the cell the scan meets most often, so
0005EBr 2                                               ;   it is the one that must not call anything
0005EBr 2  86 rr          stx ScanIdx
0005EDr 2  20 rr rr       jsr MatchEmit                 ; Close the run the hole broke...
0005F0r 2  A6 rr          ldx ScanIdx
0005F2r 2  A9 FF          lda #$FF
0005F4r 2  85 rr          sta ScanColor                 ;   ...and start again on the far side of it
0005F6r 2  A9 00          lda #0
0005F8r 2  85 rr          sta ScanLen
0005FAr 2  F0 CF          beq @Advance                  ; Always
0005FCr 2               
0005FCr 2               @End:
0005FCr 2  A5 rr          lda ScanLen
0005FEr 2  F0 05          beq @Nothing                  ; The line ran out with nothing in hand
000600r 2  86 rr          stx ScanIdx
000602r 2  4C rr rr       jmp MatchEmit                 ; Whatever was running ends with the line
000605r 2               @Nothing:
000605r 2  60             rts
000606r 2               
000606r 2               ; -----------------------------------------------------------------------------
000606r 2               ;   MatchEmit — a run has ended; mark it if it was long enough
000606r 2               ;   In:  ScanIdx = one cell PAST the run's last, ScanLen, ScanColor, ScanStep
000606r 2               ;   Out: nothing.  Modifies: A, X, Y, ScanEnd, ScanLen, RunCount, Marks
000606r 2               ;
000606r 2               ;   Runs are marked, not removed: a cell can be in a horizontal run and a
000606r 2               ;   vertical one at once, and it clears once while both runs score (SPEC 6.1).
000606r 2               ;   The union is what the MARKS bitmap is for.
000606r 2               ;
000606r 2               ;   P4 SCORES HERE. ScanLen and ScanColor still describe the run at the point
000606r 2               ;   RunCount is bumped, which is the only moment they do — the mark loop below
000606r 2               ;   counts ScanLen down to zero on its way back along the line.
000606r 2               ; -----------------------------------------------------------------------------
000606r 2               MatchEmit:
000606r 2  A5 rr          lda ScanLen
000608r 2  C9 03          cmp #MATCH_MIN
00060Ar 2  90 1A          bcc @Done                     ; Two in a row is not a run
00060Cr 2               
00060Cr 2  EE rr rr       inc RunCount
00060Fr 2  A5 rr          lda ScanIdx
000611r 2  38             sec
000612r 2  E5 rr          sbc ScanStep                  ; Back onto the run's last cell
000614r 2  85 rr          sta ScanEnd
000616r 2               @Mark:
000616r 2  A5 rr          lda ScanEnd
000618r 2  20 rr rr       jsr MarkSet
00061Br 2  A5 rr          lda ScanEnd
00061Dr 2  38             sec
00061Er 2  E5 rr          sbc ScanStep
000620r 2  85 rr          sta ScanEnd
000622r 2  C6 rr          dec ScanLen
000624r 2  D0 F0          bne @Mark
000626r 2               @Done:
000626r 2  60             rts
000627r 2               
000627r 2               ; -----------------------------------------------------------------------------
000627r 2               ;   MarksClear / MarkSet / MarkTest — the 16-byte bitmap
000627r 2               ;   One byte per row, bits 0-5 = columns 0-5. Union of runs is a free ORA.
000627r 2               ;
000627r 2               ;   MarkBits has eight entries rather than six so that the two sentinel
000627r 2               ;   columns index it harmlessly: bits 6 and 7 of a Marks byte are never set,
000627r 2               ;   so a walk over the whole 8-byte stride can test every cell it meets
000627r 2               ;   without first asking whether the cell is a wall.
000627r 2               ; -----------------------------------------------------------------------------
000627r 2               MarkBits:
000627r 2  01 02 04 08    .byte $01, $02, $04, $08, $10, $20, $40, $80
00062Br 2  10 20 40 80  
00062Fr 2               
00062Fr 2               MarksClear:
00062Fr 2  A9 00          lda #0
000631r 2  A2 00          ldx #0
000633r 2               @Row:
000633r 2  9D rr rr       sta Marks,x
000636r 2  E8             inx
000637r 2  E0 10          cpx #MARKS_BYTES
000639r 2  D0 F8          bne @Row
00063Br 2  60             rts
00063Cr 2               
00063Cr 2               MarkSet:                        ; In: A = board index.  Modifies: A, X, Y
00063Cr 2  AA             tax
00063Dr 2  29 07          and #(BOARD_STRIDE - 1)
00063Fr 2  A8             tay                           ; Y = column
000640r 2  8A             txa
000641r 2  4A             lsr a
000642r 2  4A             lsr a
000643r 2  4A             lsr a
000644r 2  AA             tax                           ; X = row
000645r 2  BD rr rr       lda Marks,x
000648r 2  19 rr rr       ora MarkBits,y
00064Br 2  9D rr rr       sta Marks,x
00064Er 2  60             rts
00064Fr 2               
00064Fr 2               MarkTest:                       ; In: A = board index.  Out: C set if marked
00064Fr 2  AA             tax                           ;     Modifies: A, X, Y
000650r 2  29 07          and #(BOARD_STRIDE - 1)
000652r 2  A8             tay
000653r 2  8A             txa
000654r 2  4A             lsr a
000655r 2  4A             lsr a
000656r 2  4A             lsr a
000657r 2  AA             tax
000658r 2  BD rr rr       lda Marks,x
00065Br 2  39 rr rr       and MarkBits,y
00065Er 2  F0 02          beq @No
000660r 2  38             sec
000661r 2  60             rts
000662r 2               @No:
000662r 2  18             clc
000663r 2  60             rts
000664r 2               
000664r 1               .include "../src/cascade.asm"
000664r 2               ; =============================================================================
000664r 2               ;   cascade.asm — Wizards Lab, clear resolution
000664r 2               ; =============================================================================
000664r 2               ;   SPEC.md section 8. A cascade runs from the moment a piece locks until no
000664r 2               ;   further matches exist, one step per iteration, with ChainStep counting the
000664r 2               ;   steps. The step order is fixed:
000664r 2               ;
000664r 2               ;       scan -> score matches -> enqueue reagents -> resolve queue
000664r 2               ;            -> animate -> remove -> level check -> gravity -> repeat
000664r 2               ;
000664r 2               ;   The effect queue always drains. Effects only ever remove tiles, never add
000664r 2               ;   them, and each cell can be marked at most once, so the queue is bounded by
000664r 2               ;   the 96 cells of the playfield.
000664r 2               ; =============================================================================
000664r 2               
000664r 2               ; -----------------------------------------------------------------------------
000664r 2               ;   CascadeBegin — called immediately after PieceLock
000664r 2               ;   Out: nothing.  Modifies: A
000664r 2               ; -----------------------------------------------------------------------------
000664r 2               CascadeBegin:
000664r 2  A9 01          lda #1
000666r 2  8D rr rr       sta ChainStep                 ; The step about to run is step 1 (SPEC 8)
000669r 2  A9 00          lda #0
00066Br 2  8D rr rr       sta CascadeLo
00066Er 2  8D rr rr       sta CascadeMid
000671r 2  8D rr rr       sta CascadeHi
000674r 2  8D rr rr       sta StarCount
000677r 2  8D rr rr       sta RunCount
00067Ar 2  4C rr rr       jmp EffectQClear
00067Dr 2               
00067Dr 2               ; -----------------------------------------------------------------------------
00067Dr 2               ;   CascadeStep — run one step's scan and take what it found off the board
00067Dr 2               ;   In:  nothing
00067Dr 2               ;   Out: C set if anything matched, and the caller should let the pile fall.
00067Dr 2               ;        C clear when nothing matched and the cascade has settled.
00067Dr 2               ;        Modifies: A, X, Y, Scan*, CellCount, Marks, RunCount
00067Dr 2               ;
00067Dr 2               ;   Steps 2 to 5 of SPEC 8 are not here yet: P4 scores the runs, P5 enqueues
00067Dr 2               ;   and resolves the reagents among them, and P6 puts the glow and the shatter
00067Dr 2               ;   between the scan and the removal. All three land between the two calls
00067Dr 2               ;   below without moving either of them, which is the reason the step is
00067Dr 2               ;   already split into a scan and a removal that a sub-state can sit between.
00067Dr 2               ; -----------------------------------------------------------------------------
00067Dr 2               CascadeStep:
00067Dr 2  20 rr rr       jsr MatchScan
000680r 2  F0 05          beq @Settled                  ; RunCount is zero — nothing left to clear
000682r 2  20 rr rr       jsr CascadeRemove
000685r 2  38             sec
000686r 2  60             rts
000687r 2               @Settled:
000687r 2  18             clc
000688r 2  60             rts
000689r 2               
000689r 2               ; -----------------------------------------------------------------------------
000689r 2               ;   CascadeRemove — empty every marked cell and queue it for redraw
000689r 2               ;   In:  Marks
000689r 2               ;   Out: CellCount = cells removed.  Modifies: A, X, Y, CellCount, RedrawCol
000689r 2               ;   SPEC 8 step 6.
000689r 2               ;
000689r 2               ;   At most 96 cells and the ring holds 64 — but a marked cell is a cell that
000689r 2               ;   just matched, and a board cannot hold more matches than it holds tiles
000689r 2               ;   that a single piece completed. The worst real case is a handful. This one
000689r 2               ;   does NOT need the cursor treatment BoardGravityStep gets: gravity moves
000689r 2               ;   cells that were never marked, and can genuinely touch the whole well.
000689r 2               ;
000689r 2               ;   P4 takes CellCount to ScoreLevelCheck — thirty cleared tiles is a level
000689r 2               ;   (SPEC 10.1) — and P6 will have animated these cells before they go.
000689r 2               ; -----------------------------------------------------------------------------
000689r 2               CascadeRemove:
000689r 2  A9 00          lda #0
00068Br 2  85 rr          sta CellCount
00068Dr 2  AA             tax                           ; X = board index, walked a row at a time
00068Er 2               @Row:
00068Er 2  8A             txa
00068Fr 2  4A             lsr a
000690r 2  4A             lsr a
000691r 2  4A             lsr a
000692r 2  A8             tay
000693r 2  B9 rr rr       lda Marks,y
000696r 2  F0 27          beq @NextRow                  ; Nothing marked in this row, and most rows
000698r 2                                               ;   hold nothing marked
000698r 2               @Cell:
000698r 2  8A             txa
000699r 2  48             pha
00069Ar 2  20 rr rr       jsr MarkTest
00069Dr 2  68             pla
00069Er 2  AA             tax                           ; MarkTest needs X, so the cursor comes back
00069Fr 2  90 0E          bcc @NextCell                 ;   through A. Neither PLA nor TAX touches C.
0006A1r 2  A9 00          lda #TILE_EMPTY
0006A3r 2  9D rr rr       sta Board,x
0006A6r 2  E6 rr          inc CellCount
0006A8r 2  8A             txa
0006A9r 2  48             pha
0006AAr 2  20 rr rr       jsr RenderCell
0006ADr 2  68             pla
0006AEr 2  AA             tax
0006AFr 2               @NextCell:
0006AFr 2  E8             inx
0006B0r 2  8A             txa
0006B1r 2  29 07          and #(BOARD_STRIDE - 1)
0006B3r 2  C9 06          cmp #BOARD_W
0006B5r 2  90 E1          bcc @Cell
0006B7r 2               
0006B7r 2  8A             txa                           ; X is on the row's first sentinel column;
0006B8r 2  18             clc                           ;   step over both of them
0006B9r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
0006BBr 2  AA             tax
0006BCr 2  4C rr rr       jmp @Test
0006BFr 2               
0006BFr 2               @NextRow:
0006BFr 2  8A             txa
0006C0r 2  18             clc
0006C1r 2  69 08          adc #BOARD_STRIDE
0006C3r 2  AA             tax
0006C4r 2               @Test:
0006C4r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
0006C6r 2  90 C6          bcc @Row
0006C8r 2  60             rts
0006C9r 2               
0006C9r 2               ; -----------------------------------------------------------------------------
0006C9r 2               ;   CascadeSettle — apply the star multiplier and bank the points
0006C9r 2               ;   SPEC 8 SETTLE, SPEC 9.6 — the doubling covers the WHOLE cascade, including
0006C9r 2               ;   points scored before the star cleared.
0006C9r 2               ; -----------------------------------------------------------------------------
0006C9r 2               CascadeSettle:
0006C9r 2                 ; TODO: shift CascadeLo/Mid/Hi left by min(StarCount, STAR_SHIFT_CAP) in BCD
0006C9r 2                 ; (a BCD doubling is one self-addition), then ScoreAdd.
0006C9r 2  60             rts
0006CAr 2               
0006CAr 2               ; -----------------------------------------------------------------------------
0006CAr 2               ;   The five reagents (SPEC 7.3). Each marks its targets, scores them at
0006CAr 2               ;   EffectValue[chain], and pushes any reagent it uncovers back onto the queue.
0006CAr 2               ; -----------------------------------------------------------------------------
0006CAr 2               EffectFireball:                   ; In: A = colour key. Every tile of it, board wide.
0006CAr 2  60             rts                             ;     Prisms are immune — they have no colour.
0006CBr 2               
0006CBr 2               EffectBolt:                       ; In: X = row, Y = column. Row + column, <= 21 cells.
0006CBr 2  60             rts
0006CCr 2               
0006CCr 2               EffectBomb:                       ; In: X = row, Y = column. 3x3, clipped at the edges.
0006CCr 2  60             rts
0006CDr 2               
0006CDr 2               EffectStar:                       ; Removes nothing; StarCount += 1, capped later.
0006CDr 2  60             rts
0006CEr 2               
0006CEr 2               EffectPrism:                      ; Removes nothing; awards BONUS_PRISM.
0006CEr 2  60             rts
0006CFr 2               
0006CFr 2               ; -----------------------------------------------------------------------------
0006CFr 2               ;   The effect queue — a ring of (glyph, row, col) packed into two bytes.
0006CFr 2               ;   On overflow an effect is dropped rather than growing the buffer; with at
0006CFr 2               ;   most one reagent per piece, EFFECTQ_ENTRIES is not reachable in practice.
0006CFr 2               ; -----------------------------------------------------------------------------
0006CFr 2               EffectQClear:                   ; Real ahead of the rest of the queue, because
0006CFr 2  A9 00          lda #0                        ;   CascadeBegin has to start every cascade
0006D1r 2  8D rr rr       sta EffectQHead               ;   with an empty one and P5 is the phase that
0006D4r 2  8D rr rr       sta EffectQTail               ;   first puts something in it
0006D7r 2  60             rts
0006D8r 2               
0006D8r 2               EffectQPush:                      ; In: A = glyph, X = row, Y = column
0006D8r 2  60             rts
0006D9r 2               
0006D9r 2               EffectQPop:                       ; Out: C clear if empty
0006D9r 2  18             clc
0006DAr 2  60             rts
0006DBr 2               
0006DBr 1               .include "../src/score.asm"
0006DBr 2               ; =============================================================================
0006DBr 2               ;   score.asm — Wizards Lab, scoring
0006DBr 2               ; =============================================================================
0006DBr 2               ;   SPEC.md section 9. Seven digits of packed BCD in four bytes, low byte
0006DBr 2               ;   first; the top nibble of ScoreTop is held at zero. Every value in
0006DBr 2               ;   tables.inc is a multiple of ten, so scoring is a SED / ADC chain and never
0006DBr 2               ;   a multiply — the one place a tile count has to be multiplied by a table
0006DBr 2               ;   value, it is done as a loop of BCD additions, and the count is at most 21.
0006DBr 2               ;
0006DBr 2               ;   The score clamps at 9999999. It never wraps.
0006DBr 2               ;
0006DBr 2               ;   Display is always all seven digits, zero padded — see TextBcd. Nothing
0006DBr 2               ;   here strips a leading zero, and nothing downstream may either.
0006DBr 2               ; =============================================================================
0006DBr 2               
0006DBr 2               ; -----------------------------------------------------------------------------
0006DBr 2               ;   ScoreHighInit — seed the session high score, once, at power-on
0006DBr 2               ;   SPEC 9.8 — the high score is not persisted; it starts at 0010000 on every
0006DBr 2               ;   power-on, which is the target the first game is played against. It then
0006DBr 2               ;   survives every game in the session, so this is deliberately NOT part of
0006DBr 2               ;   ScoreReset. Nothing may infer "cold boot" from the value being zero: BSS
0006DBr 2               ;   is not cleared on all three machines.
0006DBr 2               ;   Out: nothing.  Modifies: A
0006DBr 2               ; -----------------------------------------------------------------------------
0006DBr 2               ScoreHighInit:
0006DBr 2  A9 00          lda #HIGH_INIT_LO
0006DDr 2  8D rr rr       sta HighLo
0006E0r 2  A9 00          lda #HIGH_INIT_MID
0006E2r 2  8D rr rr       sta HighMid
0006E5r 2  A9 01          lda #HIGH_INIT_HI
0006E7r 2  8D rr rr       sta HighHi
0006EAr 2  A9 00          lda #HIGH_INIT_TOP
0006ECr 2  8D rr rr       sta HighTop
0006EFr 2  A9 01          lda #$01                      ; BCD — the level the target was "set" on
0006F1r 2  8D rr rr       sta HighLevel
0006F4r 2  60             rts
0006F5r 2               
0006F5r 2               ; -----------------------------------------------------------------------------
0006F5r 2               ;   ScoreReset — zero the score for a new game
0006F5r 2               ;   Out: nothing.  Modifies: A
0006F5r 2               ; -----------------------------------------------------------------------------
0006F5r 2               ScoreReset:
0006F5r 2  A9 00          lda #0
0006F7r 2  8D rr rr       sta ScoreLo
0006FAr 2  8D rr rr       sta ScoreMid
0006FDr 2  8D rr rr       sta ScoreHi
000700r 2  8D rr rr       sta ScoreTop
000703r 2  8D rr rr       sta CascadeLo
000706r 2  8D rr rr       sta CascadeMid
000709r 2  8D rr rr       sta CascadeHi
00070Cr 2  8D rr rr       sta StarCount
00070Fr 2  60             rts
000710r 2               
000710r 2               ; -----------------------------------------------------------------------------
000710r 2               ;   CascadeAdd — add a 16-bit BCD value to the cascade accumulator
000710r 2               ;   In:  A = low BCD byte, X = high BCD byte
000710r 2               ;   Out: nothing.  Modifies: A, flags
000710r 2               ; -----------------------------------------------------------------------------
000710r 2               CascadeAdd:
000710r 2                 ; TODO: SED, three-byte add into CascadeLo/Mid/Hi, CLD.
000710r 2  60             rts
000711r 2               
000711r 2               ; -----------------------------------------------------------------------------
000711r 2               ;   CascadeAddTimes — add a value N times (the tiles-cleared multiply)
000711r 2               ;   In:  A = low BCD, X = high BCD, Y = count
000711r 2               ; -----------------------------------------------------------------------------
000711r 2               CascadeAddTimes:
000711r 2  60             rts
000712r 2               
000712r 2               ; -----------------------------------------------------------------------------
000712r 2               ;   ScoreAdd — bank the cascade accumulator into Score, clamped
000712r 2               ;   Out: C set if a new high score was reached this call.
000712r 2               ;   SPEC 9.8 — the high score updates live, so the player watches the overtake.
000712r 2               ; -----------------------------------------------------------------------------
000712r 2               ScoreAdd:
000712r 2  18             clc
000713r 2  60             rts
000714r 2               
000714r 2               ; -----------------------------------------------------------------------------
000714r 2               ;   ScoreLevelCheck — advance the level when 30 tiles have gone
000714r 2               ;   In:  A = tiles removed this step
000714r 2               ;   Out: C set if the level advanced.
000714r 2               ;   SPEC 10.1 — at most one advance per step, surplus carries over, so a big
000714r 2               ;   fireball chain can never skip a level.
000714r 2               ; -----------------------------------------------------------------------------
000714r 2               ScoreLevelCheck:
000714r 2  18             clc
000715r 2  60             rts
000716r 2               
000716r 2               ; -----------------------------------------------------------------------------
000716r 2               ;   ScoreGravity — frames per row for the current level
000716r 2               ;   Out: A = frame count, from SpeedNTSC or SpeedPAL per Region.
000716r 2               ;        Modifies: A, X
000716r 2               ;   SPEC 10.2. Strictly this module is P4's, but the falling piece cannot fall
000716r 2               ;   without it, so it is real ahead of the rest of the file — the same reason
000716r 2               ;   ScoreHighInit landed here in P1.
000716r 2               ; -----------------------------------------------------------------------------
000716r 2               ScoreGravity:
000716r 2  AE rr rr       ldx Level
000719r 2  CA             dex                           ; The table is indexed by level - 1 ...
00071Ar 2  E0 10          cpx #LEVEL_SPEED_CAP
00071Cr 2  90 02          bcc @Level
00071Er 2  A2 0F          ldx #LEVEL_SPEED_CAP - 1      ;   ... and stops improving at the cap
000720r 2               @Level:
000720r 2  AD rr rr       lda Region
000723r 2  D0 04          bne @Pal
000725r 2  BD rr rr       lda SpeedNTSC,x
000728r 2  60             rts
000729r 2               @Pal:
000729r 2  BD rr rr       lda SpeedPAL,x
00072Cr 2  60             rts
00072Dr 2               
00072Dr 1               .include "../src/render.asm"
00072Dr 2               ; =============================================================================
00072Dr 2               ;   render.asm — Wizards Lab, the dirty-cell renderer
00072Dr 2               ; =============================================================================
00072Dr 2               ;   SPEC.md section 12.6. The screen is never fully redrawn during play.
00072Dr 2               ;   Changed cells are appended to a ring and flushed once a frame, at most
00072Dr 2               ;   DIRTY_FLUSH_MAX per frame with the remainder carried over.
00072Dr 2               ;
00072Dr 2               ;   The cap is NOT a hardware write-spacing limit. S1 measured this loop at
00072Dr 2               ;   165 cycles a cell on the AC6502, which puts two VRAM data writes 165 us
00072Dr 2               ;   apart at 1 MHz and the closest two VDP PORT accesses 8 cycles apart —
00072Dr 2               ;   inside even a real TMS9918A's 8 us and 2 us windows with two orders of
00072Dr 2               ;   magnitude to spare, and further inside a pico9918's, which emulates VRAM
00072Dr 2               ;   in RP2040 memory and has no display contention at all. A 6502 at this
00072Dr 2               ;   clock cannot write a TMS9918 too fast however hard it tries.
00072Dr 2               ;
00072Dr 2               ;   The cap is a TIME BUDGET: DIRTY_FLUSH_MAX cells is what fits in vertical
00072Dr 2               ;   blank on the tightest of the three. See constants.inc and PLAN.md S1.
00072Dr 2               ;
00072Dr 2               ;   All screen access goes through HalPlotCell (see hal.inc). Nothing in this
00072Dr 2               ;   file knows where screen memory is.
00072Dr 2               ; =============================================================================
00072Dr 2               
00072Dr 2               ; -----------------------------------------------------------------------------
00072Dr 2               ;   RenderDirtyReset — empty the ring and cancel any outstanding board redraw
00072Dr 2               ;   Call this after anything that draws the whole screen behind the renderer's
00072Dr 2               ;   back (HalBlitScreen), because every queued cell then describes a screen
00072Dr 2               ;   that no longer exists.
00072Dr 2               ;   In:  nothing        Out: nothing.  Modifies: A
00072Dr 2               ; -----------------------------------------------------------------------------
00072Dr 2               RenderDirtyReset:
00072Dr 2  A9 00          lda #0
00072Fr 2  8D rr rr       sta DirtyCount
000732r 2  8D rr rr       sta DirtyHead
000735r 2  8D rr rr       sta DirtyTail
000738r 2  A9 FF          lda #$FF
00073Ar 2  8D rr rr       sta RedrawIdx
00073Dr 2  60             rts
00073Er 2               
00073Er 2               ; -----------------------------------------------------------------------------
00073Er 2               ;   RenderMark — queue one panel cell
00073Er 2               ;   In:  A = tile, X = panel column, Y = panel row
00073Er 2               ;   Out: nothing.  Modifies: A, X.  PRESERVES Y and every byte of zero page.
00073Er 2               ;
00073Er 2               ;   The PANEL_X / PANEL_Y offset is applied here, once, so nothing upstream
00073Er 2               ;   has to know which machine it is running on.
00073Er 2               ;
00073Er 2               ;   Preserving Y and zero page is a contract, not an accident: text.asm holds
00073Er 2               ;   its string cursor across this call (see zeropage.inc). The three values
00073Er 2               ;   ride the stack rather than scratch bytes because A, X and Y are all live
00073Er 2               ;   at once and there is no fourth register to index the ring with.
00073Er 2               ;
00073Er 2               ;   A mark that arrives with the ring full is DROPPED, silently (D6).
00073Er 2               ; -----------------------------------------------------------------------------
00073Er 2               RenderMark:
00073Er 2  48             pha                           ; Tile
00073Fr 2  98             tya
000740r 2  18             clc
000741r 2  69 00          adc #PANEL_Y                  ; Panel row -> screen row
000743r 2  48             pha
000744r 2  8A             txa
000745r 2  18             clc
000746r 2  69 00          adc #PANEL_X                  ; Panel column -> screen column
000748r 2  48             pha
000749r 2               
000749r 2  AD rr rr       lda DirtyCount
00074Cr 2  C9 40          cmp #DIRTY_ENTRIES
00074Er 2  B0 1F          bcs @Full
000750r 2  EE rr rr       inc DirtyCount
000753r 2               
000753r 2  AE rr rr       ldx DirtyTail
000756r 2  68             pla
000757r 2  9D rr rr       sta Dirty+0,x                 ; Screen column
00075Ar 2  68             pla
00075Br 2  9D rr rr       sta Dirty+1,x                 ; Screen row
00075Er 2  68             pla
00075Fr 2  9D rr rr       sta Dirty+2,x                 ; Tile
000762r 2               
000762r 2  E8             inx                           ; Step one entry, wrapping the ring
000763r 2  E8             inx
000764r 2  E8             inx
000765r 2  E0 C0          cpx #DIRTY_BYTES
000767r 2  90 02          bcc @Store
000769r 2  A2 00          ldx #0
00076Br 2               @Store:
00076Br 2  8E rr rr       stx DirtyTail
00076Er 2  60             rts
00076Fr 2               
00076Fr 2               @Full:
00076Fr 2  68             pla                           ; Unwind and drop it. The cell is wrong until
000770r 2  68             pla                           ;   something marks it again.
000771r 2  68             pla
000772r 2  60             rts
000773r 2               
000773r 2               ; -----------------------------------------------------------------------------
000773r 2               ;   RenderFlush — push up to DIRTY_FLUSH_MAX queued cells to the screen
000773r 2               ;   Called once per frame, from the top of the main loop.
000773r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
000773r 2               ; -----------------------------------------------------------------------------
000773r 2               RenderFlush:
000773r 2  20 rr rr       jsr RenderBoardStep           ; Top the ring up from a board redraw, if one
000776r 2                                               ;   is outstanding, so it always makes progress
000776r 2  AD rr rr       lda DirtyCount
000779r 2  F0 31          beq @Done
00077Br 2  C9 18          cmp #DIRTY_FLUSH_MAX
00077Dr 2  90 02          bcc @Budget
00077Fr 2  A9 18          lda #DIRTY_FLUSH_MAX
000781r 2               @Budget:
000781r 2  85 rr          sta FlushLeft
000783r 2               
000783r 2               @Cell:
000783r 2  AE rr rr       ldx DirtyHead
000786r 2  BD rr rr       lda Dirty+1,x
000789r 2  A8             tay                           ; Y = screen row
00078Ar 2  BD rr rr       lda Dirty+2,x
00078Dr 2  48             pha                           ; Tile
00078Er 2  BD rr rr       lda Dirty+0,x
000791r 2  AA             tax                           ; X = screen column
000792r 2  68             pla                           ; A = tile
000793r 2  20 rr rr       jsr HalPlotCell
000796r 2               
000796r 2  AD rr rr       lda DirtyHead                 ; Step one entry, wrapping the ring
000799r 2  18             clc
00079Ar 2  69 03          adc #3
00079Cr 2  C9 C0          cmp #DIRTY_BYTES
00079Er 2  90 02          bcc @Store
0007A0r 2  A9 00          lda #0
0007A2r 2               @Store:
0007A2r 2  8D rr rr       sta DirtyHead
0007A5r 2  CE rr rr       dec DirtyCount
0007A8r 2  C6 rr          dec FlushLeft
0007AAr 2  D0 D7          bne @Cell
0007ACr 2               @Done:
0007ACr 2  60             rts
0007ADr 2               
0007ADr 2               ; -----------------------------------------------------------------------------
0007ADr 2               ;   RenderBoard — ask for the whole 6 x 16 well to be redrawn
0007ADr 2               ;   Used on state entry and after a pause, not per frame.
0007ADr 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
0007ADr 2               ;
0007ADr 2               ;   The well is 96 cells and the ring holds DIRTY_ENTRIES; a redraw therefore
0007ADr 2               ;   cannot be queued in one go. This only sets the cursor. RenderBoardStep,
0007ADr 2               ;   which RenderFlush calls every frame, feeds the ring as fast as it drains,
0007ADr 2               ;   so the redraw spreads over as many frames as it needs and never drops a
0007ADr 2               ;   cell.
0007ADr 2               ; -----------------------------------------------------------------------------
0007ADr 2               RenderBoard:
0007ADr 2  A9 00          lda #0
0007AFr 2  8D rr rr       sta RedrawIdx                 ; Board index 0 = row 0, column 0
0007B2r 2  60             rts                           ; And nothing else. Falling through into the
0007B3r 2                                               ;   step below would fill the ring here and
0007B3r 2                                               ;   drop whatever the caller marks next.
0007B3r 2               
0007B3r 2               ; -----------------------------------------------------------------------------
0007B3r 2               ;   RenderBoardStep — queue as much of an outstanding board redraw as fits
0007B3r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
0007B3r 2               ;   Does nothing when RedrawIdx is $FF.
0007B3r 2               ; -----------------------------------------------------------------------------
0007B3r 2               RenderBoardStep:
0007B3r 2  AD rr rr       lda RedrawIdx
0007B6r 2  30 41          bmi @Done                     ; $FF — nothing outstanding
0007B8r 2               
0007B8r 2               @Cell:
0007B8r 2  AD rr rr       lda DirtyCount
0007BBr 2  C9 40          cmp #DIRTY_ENTRIES
0007BDr 2  B0 3A          bcs @Done                     ; Ring full — pick this cell up next frame
0007BFr 2               
0007BFr 2  AE rr rr       ldx RedrawIdx
0007C2r 2  8A             txa
0007C3r 2  29 07          and #(BOARD_STRIDE - 1)
0007C5r 2  18             clc
0007C6r 2  69 01          adc #WELL_ORIGIN_X
0007C8r 2  85 rr          sta RedrawCol
0007CAr 2  8A             txa
0007CBr 2  4A             lsr a                         ; Board index >> 3 is the row (stride 8)
0007CCr 2  4A             lsr a
0007CDr 2  4A             lsr a
0007CEr 2  18             clc
0007CFr 2  69 04          adc #WELL_ORIGIN_Y
0007D1r 2  A8             tay                           ; Y = panel row
0007D2r 2  BD rr rr       lda Board,x                   ; The board byte IS the tile — empty is $00,
0007D5r 2  A6 rr          ldx RedrawCol                 ;   which is TILE_BLANK (SPEC 3.3, 4.2)
0007D7r 2  20 rr rr       jsr RenderMark
0007DAr 2               
0007DAr 2  AE rr rr       ldx RedrawIdx                 ; Advance, stepping over the two sentinel
0007DDr 2  E8             inx                           ;   columns at the end of each row
0007DEr 2  8A             txa
0007DFr 2  29 07          and #(BOARD_STRIDE - 1)
0007E1r 2  C9 06          cmp #BOARD_W
0007E3r 2  90 05          bcc @Save
0007E5r 2  8A             txa
0007E6r 2  18             clc
0007E7r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
0007E9r 2  AA             tax
0007EAr 2               @Save:
0007EAr 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
0007ECr 2  B0 06          bcs @Finish
0007EEr 2  8E rr rr       stx RedrawIdx
0007F1r 2  4C rr rr       jmp @Cell
0007F4r 2               
0007F4r 2               @Finish:
0007F4r 2  A9 FF          lda #$FF
0007F6r 2  8D rr rr       sta RedrawIdx
0007F9r 2               @Done:
0007F9r 2  60             rts
0007FAr 2               
0007FAr 2               ; -----------------------------------------------------------------------------
0007FAr 2               ;   RenderCell — queue one board cell by board index
0007FAr 2               ;   In:  X = board index (row * BOARD_STRIDE + column)
0007FAr 2               ;   Out: nothing.  Modifies: A, X, Y
0007FAr 2               ;   The single-cell form of RenderBoardStep, for the phases that move one tile
0007FAr 2               ;   at a time.
0007FAr 2               ; -----------------------------------------------------------------------------
0007FAr 2               RenderCell:
0007FAr 2  8A             txa
0007FBr 2  29 07          and #(BOARD_STRIDE - 1)
0007FDr 2  18             clc
0007FEr 2  69 01          adc #WELL_ORIGIN_X
000800r 2  85 rr          sta RedrawCol
000802r 2  8A             txa
000803r 2  4A             lsr a
000804r 2  4A             lsr a
000805r 2  4A             lsr a
000806r 2  18             clc
000807r 2  69 04          adc #WELL_ORIGIN_Y
000809r 2  A8             tay
00080Ar 2  BD rr rr       lda Board,x
00080Dr 2  A6 rr          ldx RedrawCol
00080Fr 2  4C rr rr       jmp RenderMark
000812r 2               
000812r 2               ; -----------------------------------------------------------------------------
000812r 2               ;   RenderPiece — queue the three falling cells at where the piece is now
000812r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000812r 2               ;
000812r 2               ;   RenderMark clobbers X and keeps Y, so the panel column is parked in
000812r 2               ;   RedrawCol and the panel row rides Y down the three cells. Cell C can never
000812r 2               ;   be lower than board row 15, so all three are always inside the well and
000812r 2               ;   there is nothing to clip.
000812r 2               ; -----------------------------------------------------------------------------
000812r 2               RenderPiece:
000812r 2  AD rr rr       lda PieceCol
000815r 2  18             clc
000816r 2  69 01          adc #WELL_ORIGIN_X
000818r 2  85 rr          sta RedrawCol
00081Ar 2  AD rr rr       lda PieceRow
00081Dr 2  18             clc
00081Er 2  69 04          adc #WELL_ORIGIN_Y
000820r 2  A8             tay
000821r 2  AD rr rr       lda PieceA
000824r 2  A6 rr          ldx RedrawCol
000826r 2  20 rr rr       jsr RenderMark
000829r 2  C8             iny
00082Ar 2  AD rr rr       lda PieceB
00082Dr 2  A6 rr          ldx RedrawCol
00082Fr 2  20 rr rr       jsr RenderMark
000832r 2  C8             iny
000833r 2  AD rr rr       lda PieceC
000836r 2  A6 rr          ldx RedrawCol
000838r 2  4C rr rr       jmp RenderMark
00083Br 2               
00083Br 2               ; -----------------------------------------------------------------------------
00083Br 2               ;   RenderPieceErase — blank the three cells the piece is leaving
00083Br 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
00083Br 2               ;
00083Br 2               ;   Three blanks rather than three board reads, because the cells under a
00083Br 2               ;   falling piece are always empty: every move and every gravity step tests
00083Br 2               ;   the target cells before it happens, and the one thing that writes them is
00083Br 2               ;   PieceLock, after which nothing erases the piece again (piece.asm).
00083Br 2               ; -----------------------------------------------------------------------------
00083Br 2               RenderPieceErase:
00083Br 2  AD rr rr       lda PieceCol
00083Er 2  18             clc
00083Fr 2  69 01          adc #WELL_ORIGIN_X
000841r 2  85 rr          sta RedrawCol
000843r 2  AD rr rr       lda PieceRow
000846r 2  18             clc
000847r 2  69 04          adc #WELL_ORIGIN_Y
000849r 2  A8             tay
00084Ar 2  A9 00          lda #TILE_EMPTY
00084Cr 2  A6 rr          ldx RedrawCol
00084Er 2  20 rr rr       jsr RenderMark
000851r 2  C8             iny
000852r 2  A9 00          lda #TILE_EMPTY
000854r 2  A6 rr          ldx RedrawCol
000856r 2  20 rr rr       jsr RenderMark
000859r 2  C8             iny
00085Ar 2  A9 00          lda #TILE_EMPTY
00085Cr 2  A6 rr          ldx RedrawCol
00085Er 2  4C rr rr       jmp RenderMark
000861r 2               
000861r 2               ; -----------------------------------------------------------------------------
000861r 2               ;   RenderNext — the preview, panel column NEXT_X, rows NEXT_Y..NEXT_Y+2
000861r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000861r 2               ;
000861r 2               ;   All three cells every time. The play screen image ships with a piece
000861r 2               ;   already drawn in the NEXT box (SPEC 12.1), so this has to overwrite rather
000861r 2               ;   than assume it is drawing onto backdrop.
000861r 2               ; -----------------------------------------------------------------------------
000861r 2               RenderNext:
000861r 2  A0 10          ldy #NEXT_Y
000863r 2  AD rr rr       lda NextA
000866r 2  A2 0B          ldx #NEXT_X
000868r 2  20 rr rr       jsr RenderMark
00086Br 2  C8             iny
00086Cr 2  AD rr rr       lda NextB
00086Fr 2  A2 0B          ldx #NEXT_X
000871r 2  20 rr rr       jsr RenderMark
000874r 2  C8             iny
000875r 2  AD rr rr       lda NextC
000878r 2  A2 0B          ldx #NEXT_X
00087Ar 2  4C rr rr       jmp RenderMark
00087Dr 2               
00087Dr 2               ; -----------------------------------------------------------------------------
00087Dr 2               ;   RenderScore / RenderHigh / RenderLevel — only called when a value changes
00087Dr 2               ;   Nothing here compares anything: the caller knows when it changed a value
00087Dr 2               ;   and these are not cheap enough to run every frame. SCORE_DIGITS cells is
00087Dr 2               ;   most of a frame's flush budget on its own.
00087Dr 2               ; -----------------------------------------------------------------------------
00087Dr 2               RenderScore:
00087Dr 2  A9 rr          lda #<ScoreLo
00087Fr 2  85 rr          sta Ptr1
000881r 2  A9 rr          lda #>ScoreLo
000883r 2  85 rr          sta Ptr1+1
000885r 2  A2 0C          ldx #SCORE_X
000887r 2  A0 05          ldy #SCORE_Y
000889r 2  A9 07          lda #SCORE_DIGITS
00088Br 2  4C rr rr       jmp TextBcd
00088Er 2               
00088Er 2               RenderHigh:
00088Er 2  A9 rr          lda #<HighLo
000890r 2  85 rr          sta Ptr1
000892r 2  A9 rr          lda #>HighLo
000894r 2  85 rr          sta Ptr1+1
000896r 2  A2 0C          ldx #HIGH_X
000898r 2  A0 0A          ldy #HIGH_Y
00089Ar 2  A9 07          lda #SCORE_DIGITS
00089Cr 2  20 rr rr       jsr TextBcd
00089Fr 2               
00089Fr 2  A9 rr          lda #<HighLevel               ; The level it was set on, under the digits
0008A1r 2  85 rr          sta Ptr1
0008A3r 2  A9 rr          lda #>HighLevel
0008A5r 2  85 rr          sta Ptr1+1
0008A7r 2  A2 0F          ldx #HIGHLVL_X
0008A9r 2  A0 0B          ldy #HIGHLVL_Y
0008ABr 2  A9 02          lda #LEVEL_DIGITS
0008ADr 2  4C rr rr       jmp TextBcd
0008B0r 2               
0008B0r 2               RenderLevel:
0008B0r 2  AD rr rr       lda Level
0008B3r 2  4C rr rr       jmp TextLevel
0008B6r 2               
0008B6r 1               .include "../src/text.asm"
0008B6r 2               ; =============================================================================
0008B6r 2               ;   text.asm — Wizards Lab, text and numbers on the panel
0008B6r 2               ; =============================================================================
0008B6r 2               ;   The font lives in tile groups 2-6, forty glyphs in the order
0008B6r 2               ;
0008B6r 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
0008B6r 2               ;
0008B6r 2               ;   starting at FONT_BASE, so a digit is FONT_DIGIT_0 + value and a letter is
0008B6r 2               ;   FONT_LETTER_A + (letter - 'A'). Strings are stored pre-converted to tile
0008B6r 2               ;   numbers, terminated by TEXT_END, so drawing one is a copy with no
0008B6r 2               ;   translation. src/strings.inc holds them and the macro that encodes them.
0008B6r 2               ;
0008B6r 2               ;   Everything here draws through RenderMark, never to the screen: text is
0008B6r 2               ;   panel cells like any other and goes through the same one flush a frame.
0008B6r 2               ;   That is also why the cursor state lives in the zero-page block RenderMark
0008B6r 2               ;   promises not to touch (zeropage.inc) rather than in Tmp0-Tmp3.
0008B6r 2               ; =============================================================================
0008B6r 2               
0008B6r 2               ; -----------------------------------------------------------------------------
0008B6r 2               ;   TextDraw — draw a tile-encoded string
0008B6r 2               ;   In:  Ptr1 -> string (TEXT_END terminated), X = panel column, Y = panel row
0008B6r 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx
0008B6r 2               ; -----------------------------------------------------------------------------
0008B6r 2               TextDraw:
0008B6r 2  86 rr          stx TextCol
0008B8r 2  84 rr          sty TextRow
0008BAr 2  A9 00          lda #0
0008BCr 2  85 rr          sta TextIdx
0008BEr 2               @Char:
0008BEr 2  A4 rr          ldy TextIdx
0008C0r 2  B1 rr          lda (Ptr1),y
0008C2r 2  C9 FF          cmp #TEXT_END
0008C4r 2  F0 0D          beq @Done
0008C6r 2  A6 rr          ldx TextCol
0008C8r 2  A4 rr          ldy TextRow
0008CAr 2  20 rr rr       jsr RenderMark
0008CDr 2  E6 rr          inc TextCol
0008CFr 2  E6 rr          inc TextIdx
0008D1r 2  D0 EB          bne @Char                     ; Always — a string is never 256 tiles long
0008D3r 2               @Done:
0008D3r 2  60             rts
0008D4r 2               
0008D4r 2               ; -----------------------------------------------------------------------------
0008D4r 2               ;   TextBcd — draw a packed-BCD number, zero padded
0008D4r 2               ;   In:  Ptr1 -> BCD bytes (low first), A = digit count,
0008D4r 2               ;        X = panel column, Y = panel row
0008D4r 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx, TextByte,
0008D4r 2               ;        TextSkip
0008D4r 2               ;
0008D4r 2               ;   SCORE_DIGITS (7) for the score and the high score, 2 for the high score's
0008D4r 2               ;   level. The LEVEL box is not drawn with this — see TextLevel.
0008D4r 2               ;
0008D4r 2               ;   The count is in DIGITS, not bytes, because the score is seven digits in
0008D4r 2               ;   four bytes: the top nibble of the most significant byte is held at zero
0008D4r 2               ;   (SPEC 9) and must not be drawn, or the field would be eight cells wide and
0008D4r 2               ;   no longer centred. An odd count starts at the LOW nibble of the top byte.
0008D4r 2               ;
0008D4r 2               ;   **Every digit is drawn, every time.** A leading zero is a zero glyph, not
0008D4r 2               ;   a blank: 1250 draws as 0001250. There is no suppression pass and no
0008D4r 2               ;   right-alignment — the field is fixed width so a digit never changes
0008D4r 2               ;   column while the player is watching it (SPEC 9). This also makes the
0008D4r 2               ;   routine branchless, and lets RenderScore mark a fixed run of cells dirty.
0008D4r 2               ; -----------------------------------------------------------------------------
0008D4r 2               TextBcd:
0008D4r 2  86 rr          stx TextCol
0008D6r 2  84 rr          sty TextRow
0008D8r 2  48             pha                           ; Digit count
0008D9r 2  29 01          and #$01
0008DBr 2  85 rr          sta TextSkip                  ; Odd count: the top high nibble is not drawn
0008DDr 2  68             pla
0008DEr 2  18             clc
0008DFr 2  69 01          adc #1                        ; Bytes = (digits + 1) / 2
0008E1r 2  4A             lsr a
0008E2r 2  AA             tax
0008E3r 2  CA             dex
0008E4r 2  86 rr          stx TextIdx                   ; Start at the most significant byte
0008E6r 2               
0008E6r 2               @Byte:
0008E6r 2  A4 rr          ldy TextIdx
0008E8r 2  B1 rr          lda (Ptr1),y
0008EAr 2  85 rr          sta TextByte
0008ECr 2               
0008ECr 2  A5 rr          lda TextSkip
0008EEr 2  D0 09          bne @Low
0008F0r 2  A5 rr          lda TextByte
0008F2r 2  4A             lsr a
0008F3r 2  4A             lsr a
0008F4r 2  4A             lsr a
0008F5r 2  4A             lsr a
0008F6r 2  20 rr rr       jsr TextDigit
0008F9r 2               @Low:
0008F9r 2  A9 00          lda #0
0008FBr 2  85 rr          sta TextSkip
0008FDr 2  A5 rr          lda TextByte
0008FFr 2  29 0F          and #$0F
000901r 2  20 rr rr       jsr TextDigit
000904r 2               
000904r 2  C6 rr          dec TextIdx
000906r 2  10 DE          bpl @Byte
000908r 2  60             rts
000909r 2               
000909r 2               ; -----------------------------------------------------------------------------
000909r 2               ;   TextDigit — draw one digit at the cursor and step it right
000909r 2               ;   In:  A = value 0-9      Modifies: A, X, Y, TextCol
000909r 2               ; -----------------------------------------------------------------------------
000909r 2               TextDigit:
000909r 2  18             clc
00090Ar 2  69 10          adc #FONT_DIGIT_0
00090Cr 2  A6 rr          ldx TextCol
00090Er 2  A4 rr          ldy TextRow
000910r 2  20 rr rr       jsr RenderMark
000913r 2  E6 rr          inc TextCol
000915r 2  60             rts
000916r 2               
000916r 2               ; -----------------------------------------------------------------------------
000916r 2               ;   TextBanner — centre a string in the one-row message band
000916r 2               ;   In:  Ptr1 -> string
000916r 2               ;   Out: nothing.  Modifies: A, X, Y and the text cursor
000916r 2               ;
000916r 2               ;   SPEC 12.2 — the band is panel row MSG_Y, full width, one row only. The
000916r 2               ;   string arrives already wrapped as `~~ TEXT ~~` — two FONT_TILDE, a blank,
000916r 2               ;   the text, a blank, two FONT_TILDE. Centring is (PANEL_W - length) / 2,
000916r 2               ;   which is why banner strings are drawn even-length.
000916r 2               ; -----------------------------------------------------------------------------
000916r 2               TextBanner:
000916r 2  A0 00          ldy #0
000918r 2               @Len:
000918r 2  B1 rr          lda (Ptr1),y
00091Ar 2  C9 FF          cmp #TEXT_END
00091Cr 2  F0 03          beq @Got
00091Er 2  C8             iny
00091Fr 2  D0 F7          bne @Len
000921r 2               @Got:
000921r 2  98             tya
000922r 2  85 rr          sta TextIdx
000924r 2  A9 16          lda #PANEL_W
000926r 2  38             sec
000927r 2  E5 rr          sbc TextIdx
000929r 2  4A             lsr a                         ; (PANEL_W - length) / 2
00092Ar 2  AA             tax
00092Br 2  A0 16          ldy #MSG_Y
00092Dr 2  4C rr rr       jmp TextDraw
000930r 2               
000930r 2               ; -----------------------------------------------------------------------------
000930r 2               ;   TextBannerClear — blank the message band back to backdrop
000930r 2               ;   Out: nothing.  Modifies: A, X, Y
000930r 2               ;
000930r 2               ;   Columns MSG_X .. MSG_X + MSG_W - 1 only. The shelf tiles at either end of
000930r 2               ;   the band belong to the static screen image and are never redrawn.
000930r 2               ; -----------------------------------------------------------------------------
000930r 2               TextBannerClear:
000930r 2  A9 02          lda #MSG_X
000932r 2  85 rr          sta TextCol                   ; Not X: RenderMark clobbers it
000934r 2               @Cell:
000934r 2  A9 00          lda #TILE_BLANK
000936r 2  A6 rr          ldx TextCol
000938r 2  A0 16          ldy #MSG_Y
00093Ar 2  20 rr rr       jsr RenderMark
00093Dr 2  E6 rr          inc TextCol
00093Fr 2  A5 rr          lda TextCol
000941r 2  C9 14          cmp #(MSG_X + MSG_W)
000943r 2  90 EF          bcc @Cell
000945r 2  60             rts
000946r 2               
000946r 2               ; -----------------------------------------------------------------------------
000946r 2               ;   TextLevel — the LEVEL box, tens above units in one column
000946r 2               ;   In:  A = level (binary, 1-99)
000946r 2               ;   Out: nothing.  Modifies: A, X, Y, TextByte
000946r 2               ;   SPEC 12.2 — LEVEL_X, tens at LEVEL_Y and units at LEVEL_Y + 1. Always two
000946r 2               ;   digits: level 5 draws "0" over "5".
000946r 2               ; -----------------------------------------------------------------------------
000946r 2               TextLevel:
000946r 2  A2 00          ldx #0
000948r 2               @Tens:
000948r 2  C9 0A          cmp #10
00094Ar 2  90 05          bcc @Split
00094Cr 2  E9 0A          sbc #10                       ; Carry is set by the CMP that got us here
00094Er 2  E8             inx
00094Fr 2  D0 F7          bne @Tens                     ; Always — X tops out at 9
000951r 2               @Split:
000951r 2  85 rr          sta TextByte                  ; Units
000953r 2  8A             txa
000954r 2  18             clc
000955r 2  69 10          adc #FONT_DIGIT_0
000957r 2  A2 12          ldx #LEVEL_X
000959r 2  A0 11          ldy #LEVEL_Y
00095Br 2  20 rr rr       jsr RenderMark
00095Er 2  A5 rr          lda TextByte
000960r 2  18             clc
000961r 2  69 10          adc #FONT_DIGIT_0
000963r 2  A2 12          ldx #LEVEL_X
000965r 2  A0 12          ldy #LEVEL_Y + 1
000967r 2  4C rr rr       jmp RenderMark
00096Ar 2               
00096Ar 1               .include "../src/audio.asm"
00096Ar 2               ; =============================================================================
00096Ar 2               ;   audio.asm — Wizards Lab, sound
00096Ar 2               ; =============================================================================
00096Ar 2               ;   SPEC.md section 16. Out of scope for the first playable build, but the
00096Ar 2               ;   hook is here from the start so game logic never has to be revisited to add
00096Ar 2               ;   it: logic writes an effect id to SfxRequest and forgets about it.
00096Ar 2               ;
00096Ar 2               ;   The AC6502 and the C64 both have a SID and can share a driver — only the
00096Ar 2               ;   register base differs ($9800 against $D400). The VIC-20 needs its own,
00096Ar 2               ;   against $900A-$900E.
00096Ar 2               ; =============================================================================
00096Ar 2               
00096Ar 2               SFX_MOVE        = 1
00096Ar 2               SFX_ROTATE      = 2
00096Ar 2               SFX_LOCK        = 3
00096Ar 2               SFX_MATCH       = 4
00096Ar 2               SFX_FIREBALL    = 5
00096Ar 2               SFX_BOLT        = 6
00096Ar 2               SFX_BOMB        = 7
00096Ar 2               SFX_STAR        = 8
00096Ar 2               SFX_PRISM       = 9
00096Ar 2               SFX_LEVELUP     = 10
00096Ar 2               SFX_HIGHSCORE   = 11
00096Ar 2               SFX_GAMEOVER    = 12
00096Ar 2               
00096Ar 2               ; -----------------------------------------------------------------------------
00096Ar 2               ;   AudioInit — silence everything
00096Ar 2               ; -----------------------------------------------------------------------------
00096Ar 2               AudioInit:
00096Ar 2  A9 00          lda #0
00096Cr 2  8D rr rr       sta SfxRequest
00096Fr 2  8D rr rr       sta SfxTimer
000972r 2  60             rts
000973r 2               
000973r 2               ; -----------------------------------------------------------------------------
000973r 2               ;   AudioTick — called once per frame, consumes SfxRequest
000973r 2               ; -----------------------------------------------------------------------------
000973r 2               AudioTick:
000973r 2                 ; TODO: start a new effect when SfxRequest is non-zero, then advance the
000973r 2                 ; envelope of whatever is playing. Calls HalSfx for the register writes.
000973r 2  A9 00          lda #0
000975r 2  8D rr rr       sta SfxRequest
000978r 2  60             rts
000979r 2               
000979r 1               
000979r 1               ; =============================================================================
000979r 1               ;   HAL — VIC-I, hi-res text
000979r 1               ; =============================================================================
000979r 1               
000979r 1               ; -----------------------------------------------------------------------------
000979r 1               ;   HalInitVideo — 22 x 23 cells, custom charset in RAM, everything black
000979r 1               ; -----------------------------------------------------------------------------
000979r 1               HalInitVideo:
000979r 1                 ; Screen centring. The KERNAL normally sets these, but an autostart cart
000979r 1                 ; takes over before it gets that far, so they are still at their power-on
000979r 1                 ; values and the picture sits in the wrong place. The right pair depends on
000979r 1                 ; the region, which is why HalDetectRegion runs before this.
000979r 1  A2 05          ldx #$05                      ; NTSC
00097Br 1  A0 19          ldy #$19
00097Dr 1  AD rr rr       lda Region
000980r 1  F0 04          beq @Centre
000982r 1  A2 0C          ldx #$0C                      ; PAL
000984r 1  A0 26          ldy #$26
000986r 1               @Centre:
000986r 1  8E 00 90       stx VIC_CR0                   ; Horizontal centring (bit 7 = interlace, off)
000989r 1  8C 01 90       sty VIC_CR1                   ; Vertical centring
00098Cr 1               
00098Cr 1  A9 96          lda #$96                      ; 22 columns, video matrix bit 9 set -> $1E00
00098Er 1  8D 02 90       sta VIC_CR2
000991r 1  A9 2E          lda #$2E                      ; 23 rows (46 half-lines), 8-pixel characters
000993r 1  8D 03 90       sta VIC_CR3
000996r 1  A9 FD          lda #$FD                      ; Screen $1E00, character set $1400
000998r 1  8D 05 90       sta VIC_CR5
00099Br 1  A9 08          lda #$08                      ; Black background, black border, normal video
00099Dr 1  8D 0F 90       sta VIC_CRF
0009A0r 1               
0009A0r 1  20 rr rr       jsr LoadTileset
0009A3r 1                 ; falls through
0009A3r 1               
0009A3r 1               ; -----------------------------------------------------------------------------
0009A3r 1               ;   HalClearScreen — blank tiles, white colour RAM
0009A3r 1               ; -----------------------------------------------------------------------------
0009A3r 1               HalClearScreen:
0009A3r 1  A2 00          ldx #0                        ; 506 cells = one full page plus 250
0009A5r 1               @Page0:
0009A5r 1  A9 00          lda #TILE_BLANK
0009A7r 1  9D 00 1E       sta SCREEN + $0000,x
0009AAr 1  A9 01          lda #1                        ; White
0009ACr 1  9D 00 96       sta COLRAM + $0000,x
0009AFr 1  E8             inx
0009B0r 1  D0 F3          bne @Page0
0009B2r 1               @Page1:
0009B2r 1  A9 00          lda #TILE_BLANK
0009B4r 1  9D 00 1F       sta SCREEN + $0100,x
0009B7r 1  A9 01          lda #1
0009B9r 1  9D 00 97       sta COLRAM + $0100,x
0009BCr 1  E8             inx
0009BDr 1  E0 FA          cpx #250                      ; $1E00 + 506 = $1FFA, the end of the matrix
0009BFr 1  D0 F1          bne @Page1
0009C1r 1  60             rts
0009C2r 1               
0009C2r 1               ; -----------------------------------------------------------------------------
0009C2r 1               ;   LoadTileset — copy 2 K of patterns from BLK3 into RAM at $1400
0009C2r 1               ;   The VIC chip cannot see cartridge ROM, so this copy is not optional.
0009C2r 1               ;   PLACEHOLDER ART: Tileset is data/tileset.bin. See data/README.md.
0009C2r 1               ; -----------------------------------------------------------------------------
0009C2r 1               LoadTileset:
0009C2r 1  A9 rr          lda #<Tileset
0009C4r 1  85 rr          sta SrcPtr
0009C6r 1  A9 rr          lda #>Tileset
0009C8r 1  85 rr          sta SrcPtr+1
0009CAr 1  A9 00          lda #<CHARSET_RAM
0009CCr 1  85 rr          sta DstPtr
0009CEr 1  A9 14          lda #>CHARSET_RAM
0009D0r 1  85 rr          sta DstPtr+1
0009D2r 1               
0009D2r 1  A2 08          ldx #8                        ; 8 x 256 = 2048 bytes
0009D4r 1  A0 00          ldy #0
0009D6r 1               @Byte:
0009D6r 1  B1 rr          lda (SrcPtr),y
0009D8r 1  91 rr          sta (DstPtr),y
0009DAr 1  C8             iny
0009DBr 1  D0 F9          bne @Byte
0009DDr 1  E6 rr          inc SrcPtr+1
0009DFr 1  E6 rr          inc DstPtr+1
0009E1r 1  CA             dex
0009E2r 1  D0 F2          bne @Byte
0009E4r 1  60             rts
0009E5r 1               
0009E5r 1               ; -----------------------------------------------------------------------------
0009E5r 1               ;   HalWaitFrame — sync on the top of the raster
0009E5r 1               ; -----------------------------------------------------------------------------
0009E5r 1               HalWaitFrame:
0009E5r 1               @NotTop:
0009E5r 1  AD 04 90       lda VIC_CR4                   ; Raster line / 2
0009E8r 1  F0 FB          beq @NotTop                   ; Leave the top of the frame first...
0009EAr 1               @Top:
0009EAr 1  AD 04 90       lda VIC_CR4
0009EDr 1  D0 FB          bne @Top                      ; ...then wait for it to come round again
0009EFr 1  60             rts
0009F0r 1               
0009F0r 1               ; -----------------------------------------------------------------------------
0009F0r 1               ;   HalPlotCell — In: A = tile, X = screen column, Y = screen row
0009F0r 1               ; -----------------------------------------------------------------------------
0009F0r 1               HalPlotCell:
0009F0r 1  48             pha                           ; Hold the tile; RowPtrs needs A
0009F1r 1  20 rr rr       jsr RowPtrs                   ; ScreenPtr / ColorPtr = start of row Y
0009F4r 1  8A             txa
0009F5r 1  A8             tay                           ; Y = column
0009F6r 1  68             pla                           ; A = tile
0009F7r 1  91 rr          sta (ScreenPtr),y
0009F9r 1  AA             tax                           ; The tile is its own colour lookup index
0009FAr 1  BD rr rr       lda TileColorVIC,x
0009FDr 1  91 rr          sta (ColorPtr),y
0009FFr 1  60             rts
000A00r 1               
000A00r 1               ; -----------------------------------------------------------------------------
000A00r 1               ;   RowPtrs — In: Y = screen row.  Out: ScreenPtr, ColorPtr at that row
000A00r 1               ; -----------------------------------------------------------------------------
000A00r 1               RowPtrs:
000A00r 1  B9 rr rr       lda RowLo,y
000A03r 1  85 rr          sta ScreenPtr
000A05r 1  85 rr          sta ColorPtr
000A07r 1  B9 rr rr       lda RowHi,y
000A0Ar 1  85 rr          sta ScreenPtr+1
000A0Cr 1  18             clc
000A0Dr 1  69 78          adc #(>COLRAM - >SCREEN)      ; Colour RAM mirrors the matrix, page-offset
000A0Fr 1  85 rr          sta ColorPtr+1
000A11r 1  60             rts
000A12r 1               
000A12r 1               ; -----------------------------------------------------------------------------
000A12r 1               ;   HalBlitScreen — draw a full 506-byte screen plus its colour image
000A12r 1               ;   In: SrcPtr -> name table, Ptr1 -> colour table
000A12r 1               ; -----------------------------------------------------------------------------
000A12r 1               HalBlitScreen:
000A12r 1  A0 00          ldy #0                        ; 506 cells = one full page plus 250
000A14r 1               @Page0:
000A14r 1  B1 rr          lda (SrcPtr),y
000A16r 1  99 00 1E       sta SCREEN + $0000,y
000A19r 1  B1 rr          lda (Ptr1),y
000A1Br 1  99 00 96       sta COLRAM + $0000,y
000A1Er 1  C8             iny
000A1Fr 1  D0 F3          bne @Page0
000A21r 1               
000A21r 1  E6 rr          inc SrcPtr+1
000A23r 1  E6 rr          inc Ptr1+1
000A25r 1  A0 00          ldy #0
000A27r 1               @Page1:
000A27r 1  B1 rr          lda (SrcPtr),y
000A29r 1  99 00 1F       sta SCREEN + $0100,y
000A2Cr 1  B1 rr          lda (Ptr1),y
000A2Er 1  99 00 97       sta COLRAM + $0100,y
000A31r 1  C8             iny
000A32r 1  C0 FA          cpy #250                      ; Anything past here is not screen memory
000A34r 1  D0 F1          bne @Page1
000A36r 1  60             rts
000A37r 1               
000A37r 1               ; -----------------------------------------------------------------------------
000A37r 1               ;   HalReadInput — joystick and keyboard, folded into one active-high mask
000A37r 1               ;
000A37r 1               ;   The VIC splits its stick across two chips: up, down, left and fire are on
000A37r 1               ;   VIA1 $9111, but RIGHT is on VIA2 $9120 bit 7 — which is also the last of
000A37r 1               ;   the eight keyboard row lines. That collision is PLAN.md S4, and it turns
000A37r 1               ;   out not to be one:
000A37r 1               ;
000A37r 1               ;     Every key this game reads lives in matrix rows 1-6. Row 0 is the top
000A37r 1               ;     number row and row 7 the rest of it, and the game wants neither. So DDRB
000A37r 1               ;     is set ONCE to $7F and never touched again — PB0-PB6 drive the six rows
000A37r 1               ;     that matter, PB7 stays an input for the RIGHT switch, and the two never
000A37r 1               ;     take turns.
000A37r 1               ;
000A37r 1               ;   That is better than flipping the DDR twice a frame, and not only because
000A37r 1               ;   it is shorter: driving PB7 high while a closed RIGHT switch pulls it to
000A37r 1               ;   ground puts the VIA's output stage against the joystick, and never
000A37r 1               ;   configuring PB7 as an output means that cannot happen at all.
000A37r 1               ; -----------------------------------------------------------------------------
000A37r 1               HalReadInput:
000A37r 1  AD 13 91       lda $9113                     ; VIA1 DDR: the joystick lines are inputs
000A3Ar 1  29 C3          and #%11000011
000A3Cr 1  8D 13 91       sta $9113
000A3Fr 1               
000A3Fr 1  A9 7F          lda #%01111111                ; VIA2 DDRB: rows 0-6 out, RIGHT switch in
000A41r 1  8D 22 91       sta $9122
000A44r 1  A9 00          lda #$00                      ; VIA2 DDRA: the column lines are inputs
000A46r 1  8D 23 91       sta $9123
000A49r 1               
000A49r 1  AD 11 91       lda $9111                     ; Active low: bit2 U, bit3 D, bit4 L, bit5 fire
000A4Cr 1  49 FF          eor #$FF
000A4Er 1  29 3C          and #%00111100                ; Only those four; PA7 here is not the stick
000A50r 1  85 rr          sta Tmp0
000A52r 1               
000A52r 1  AD 20 91       lda $9120
000A55r 1  49 FF          eor #$FF
000A57r 1  29 80          and #$80                      ; Fold RIGHT in as bit 7 of the same byte
000A59r 1  05 rr          ora Tmp0
000A5Br 1  85 rr          sta Tmp0
000A5Dr 1               
000A5Dr 1  A9 00          lda #0
000A5Fr 1  85 rr          sta Tmp1
000A61r 1               
000A61r 1  A5 rr          lda Tmp0
000A63r 1  29 04          and #%00000100                  ; VIA1 bit 2
000A65r 1  F0 06          beq @NoUp
000A67r 1  A5 rr          lda Tmp1
000A69r 1  09 01          ora #INPUT_UP
000A6Br 1  85 rr          sta Tmp1
000A6Dr 1               @NoUp:
000A6Dr 1  A5 rr          lda Tmp0
000A6Fr 1  29 08          and #%00001000                  ; VIA1 bit 3
000A71r 1  F0 06          beq @NoDown
000A73r 1  A5 rr          lda Tmp1
000A75r 1  09 02          ora #INPUT_DOWN
000A77r 1  85 rr          sta Tmp1
000A79r 1               @NoDown:
000A79r 1  A5 rr          lda Tmp0
000A7Br 1  29 10          and #%00010000                  ; VIA1 bit 4
000A7Dr 1  F0 06          beq @NoLeft
000A7Fr 1  A5 rr          lda Tmp1
000A81r 1  09 04          ora #INPUT_LEFT
000A83r 1  85 rr          sta Tmp1
000A85r 1               @NoLeft:
000A85r 1  A5 rr          lda Tmp0
000A87r 1  29 80          and #%10000000                  ; VIA2 PB7, folded in above
000A89r 1  F0 06          beq @NoRight
000A8Br 1  A5 rr          lda Tmp1
000A8Dr 1  09 08          ora #INPUT_RIGHT
000A8Fr 1  85 rr          sta Tmp1
000A91r 1               @NoRight:
000A91r 1  A5 rr          lda Tmp0
000A93r 1  29 20          and #%00100000                  ; VIA1 bit 5
000A95r 1  F0 06          beq @NoFire
000A97r 1  A5 rr          lda Tmp1
000A99r 1  09 10          ora #INPUT_FIRE
000A9Br 1  85 rr          sta Tmp1
000A9Dr 1               @NoFire:
000A9Dr 1               
000A9Dr 1  20 rr rr       jsr ScanKeys
000AA0r 1  05 rr          ora Tmp1
000AA2r 1  60             rts
000AA3r 1               
000AA3r 1               ; -----------------------------------------------------------------------------
000AA3r 1               ;   ScanKeys — the keyboard matrix, as the same active-high mask
000AA3r 1               ;   Out: A = INPUT_* bits.  Modifies: A, X, Tmp2
000AA3r 1               ;
000AA3r 1               ;   VIA2 $9120 drives the rows (one bit LOW selects one row) and $9121 reads
000AA3r 1               ;   the columns, active low. Every key the game uses is in KeyTable below;
000AA3r 1               ;   the two cursor keys come after it because SHIFT turns them around, and
000AA3r 1               ;   knowing whether SHIFT is down means having scanned the table first.
000AA3r 1               ; -----------------------------------------------------------------------------
000AA3r 1               KEY_SHIFT           = %01000000 ; Scratch inside this file only — INPUT_MASK
000AA3r 1                                               ;   strips it before the mask leaves here
000AA3r 1               
000AA3r 1               ScanKeys:
000AA3r 1  A9 00          lda #0
000AA5r 1  85 rr          sta Tmp2
000AA7r 1  A2 00          ldx #0
000AA9r 1               @Key:
000AA9r 1  BD rr rr       lda KeyTable,x
000AACr 1  F0 19          beq @Cursors                  ; $00 drives every row at once — the
000AAEr 1  8D 20 91       sta $9120                     ;   terminator, because it is not a row mask
000AB1r 1  AD 21 91       lda $9121
000AB4r 1  49 FF          eor #$FF                      ; Active low in, active high out
000AB6r 1  3D rr rr       and KeyTable+1,x
000AB9r 1  F0 07          beq @Next
000ABBr 1  A5 rr          lda Tmp2
000ABDr 1  1D rr rr       ora KeyTable+2,x
000AC0r 1  85 rr          sta Tmp2
000AC2r 1               @Next:
000AC2r 1  E8             inx
000AC3r 1  E8             inx
000AC4r 1  E8             inx
000AC5r 1  D0 E2          bne @Key                      ; Always — the table is far shorter than 256
000AC7r 1               
000AC7r 1                 ; --- the two cursor keys, which SHIFT turns around (SPEC 11.2) ------------
000AC7r 1                 ;   Unshifted they are RIGHT and DOWN, shifted LEFT and UP, which is exactly
000AC7r 1                 ;   the four the game wants and the reason for reading the matrix rather
000AC7r 1                 ;   than letting the KERNAL translate a keystroke into one character.
000AC7r 1               @Cursors:
000AC7r 1  A9 FB          lda #%11111011                ; Row 2 — CRSR RIGHT shares it with A and D
000AC9r 1  8D 20 91       sta $9120
000ACCr 1  AD 21 91       lda $9121
000ACFr 1  29 80          and #%10000000                ; Column 7
000AD1r 1  D0 0F          bne @NoLeftRight              ; Still high, so not pressed
000AD3r 1  A2 08          ldx #INPUT_RIGHT
000AD5r 1  A5 rr          lda Tmp2
000AD7r 1  29 40          and #KEY_SHIFT
000AD9r 1  F0 02          beq @LeftRight
000ADBr 1  A2 04          ldx #INPUT_LEFT
000ADDr 1               @LeftRight:
000ADDr 1  8A             txa
000ADEr 1  05 rr          ora Tmp2
000AE0r 1  85 rr          sta Tmp2
000AE2r 1               @NoLeftRight:
000AE2r 1               
000AE2r 1  A9 F7          lda #%11110111                ; Row 3 — CRSR DOWN, next to LSHIFT
000AE4r 1  8D 20 91       sta $9120
000AE7r 1  AD 21 91       lda $9121
000AEAr 1  29 80          and #%10000000
000AECr 1  D0 0F          bne @NoUpDown
000AEEr 1  A2 02          ldx #INPUT_DOWN
000AF0r 1  A5 rr          lda Tmp2
000AF2r 1  29 40          and #KEY_SHIFT
000AF4r 1  F0 02          beq @UpDown
000AF6r 1  A2 01          ldx #INPUT_UP
000AF8r 1               @UpDown:
000AF8r 1  8A             txa
000AF9r 1  05 rr          ora Tmp2
000AFBr 1  85 rr          sta Tmp2
000AFDr 1               @NoUpDown:
000AFDr 1               
000AFDr 1  A5 rr          lda Tmp2
000AFFr 1  29 3F          and #INPUT_MASK               ; Drop KEY_SHIFT — it is not an input
000B01r 1  60             rts
000B02r 1               
000B02r 1               ; -----------------------------------------------------------------------------
000B02r 1               ;   KeyTable — row mask, column mask, input bit.  Terminated by $00.
000B02r 1               ;   Rows 1-6 only; see HalReadInput above for why that matters.
000B02r 1               ; -----------------------------------------------------------------------------
000B02r 1               KeyTable:
000B02r 1  FD 02 01       .byte %11111101, %00000010, INPUT_UP      ; W        row 1, col 1
000B05r 1  FB 02 04       .byte %11111011, %00000010, INPUT_LEFT    ; A        row 2, col 1
000B08r 1  DF 02 02       .byte %11011111, %00000010, INPUT_DOWN    ; S        row 5, col 1
000B0Br 1  FB 04 08       .byte %11111011, %00000100, INPUT_RIGHT   ; D        row 2, col 2
000B0Er 1  BF 01 10       .byte %10111111, %00000001, INPUT_FIRE    ; Q        row 6, col 0
000B11r 1  FD 20 20       .byte %11111101, %00100000, INPUT_PAUSE   ; P        row 1, col 5
000B14r 1  EF 01 01       .byte %11101111, %00000001, INPUT_UP      ; SPACE    row 4, col 0
000B17r 1  FD 80 10       .byte %11111101, %10000000, INPUT_FIRE    ; RETURN   row 1, col 7
000B1Ar 1  F7 02 40       .byte %11110111, %00000010, KEY_SHIFT     ; LSHIFT   row 3, col 1
000B1Dr 1  EF 40 40       .byte %11101111, %01000000, KEY_SHIFT     ; RSHIFT   row 4, col 6
000B20r 1  00             .byte $00
000B21r 1               
000B21r 1               ; -----------------------------------------------------------------------------
000B21r 1               ;   HalDetectRegion — NTSC has 261 raster lines, PAL 312
000B21r 1               ;   $9004 carries the line number halved, so the highest value it reaches is
000B21r 1               ;   about $82 on NTSC and $9C on PAL. Sample it and take the maximum.
000B21r 1               ; -----------------------------------------------------------------------------
000B21r 1               HalDetectRegion:
000B21r 1  A9 00          lda #0
000B23r 1  85 rr          sta Tmp0                      ; Highest line seen
000B25r 1  A2 00          ldx #0
000B27r 1  A0 00          ldy #0
000B29r 1               @Sample:
000B29r 1  AD 04 90       lda VIC_CR4
000B2Cr 1  C5 rr          cmp Tmp0
000B2Er 1  90 02          bcc @Next
000B30r 1  85 rr          sta Tmp0
000B32r 1               @Next:
000B32r 1  C8             iny
000B33r 1  D0 F4          bne @Sample
000B35r 1  E8             inx
000B36r 1  E0 40          cpx #64                       ; 16384 samples — comfortably over one frame
000B38r 1  D0 EF          bne @Sample
000B3Ar 1               
000B3Ar 1  A5 rr          lda Tmp0
000B3Cr 1  C9 90          cmp #$90
000B3Er 1  90 03          bcc @Ntsc
000B40r 1  A9 01          lda #1                        ; PAL
000B42r 1  60             rts
000B43r 1               @Ntsc:
000B43r 1  A9 00          lda #0
000B45r 1  60             rts
000B46r 1               
000B46r 1               ; -----------------------------------------------------------------------------
000B46r 1               ;   HalSfx — TODO: VIC-I sound, $900A-$900E. Its own driver; no SID here.
000B46r 1               ; -----------------------------------------------------------------------------
000B46r 1               HalSfx:
000B46r 1  60             rts
000B47r 1               
000B47r 1               ; =============================================================================
000B47r 1               ;   Data
000B47r 1               ; =============================================================================
000B47r 1               
000B47r 1               .segment "RODATA"
000000r 1               
000000r 1               .include "../data/tilecolor-vic20.inc"
000000r 2               ; =============================================================================
000000r 2               ;   tilecolor-vic20.inc — VIC-20 tile -> colour RAM table
000000r 2               ; =============================================================================
000000r 2               ;   Generated from SPEC.md section 4.3 and Appendix A. Spec-derived data, not
000000r 2               ;   artwork: edit this file by hand, it is never overwritten by an editor
000000r 2               ;   export. Tile groups 16-31 (tiles 128-255) are the margin artwork and their
000000r 2               ;   colours are the artist's to choose.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               
000000r 2               ;   256 bytes, indexed by tile number. Render is:
000000r 2               ;       SCREEN,x = tile   /   COLRAM,x = TileColor,tile
000000r 2               ;   VIC-20 hi-res text mode: colours 0-7 only (bit 3 selects
000000r 2               ;   multicolor and must stay clear).
000000r 2               
000000r 2               TileColorVIC:
000000r 2  01 01 01 01    .res 8, $01                      ; tiles   0-7    group 0  UI / well frame        white
000004r 2  01 01 01 01  
000008r 2  01 01 01 01    .res 8, $01                      ; tiles   8-15   group 1  UI accents             gray
00000Cr 2  01 01 01 01  
000010r 2  01 01 01 01    .res 8, $01                      ; tiles  16-23   group 2  Font  0 1 2 3 4 5 6 7  white
000014r 2  01 01 01 01  
000018r 2  01 01 01 01    .res 8, $01                      ; tiles  24-31   group 3  Font  8 9 A B C D E F  white
00001Cr 2  01 01 01 01  
000020r 2  01 01 01 01    .res 8, $01                      ; tiles  32-39   group 4  Font  G H I J K L M N  white
000024r 2  01 01 01 01  
000028r 2  01 01 01 01    .res 8, $01                      ; tiles  40-47   group 5  Font  O P Q R S T U V  white
00002Cr 2  01 01 01 01  
000030r 2  01 01 01 01    .res 8, $01                      ; tiles  48-55   group 6  Font  W X Y Z . x ! -  white
000034r 2  01 01 01 01  
000038r 2  01 01 01 01    .res 8, $01                      ; tiles  56-63   group 7  VFX                    white
00003Cr 2  01 01 01 01  
000040r 2  02 02 02 02    .res 8, $02                      ; tiles  64-71   group 8  POTION 0  RED
000044r 2  02 02 02 02  
000048r 2  07 07 07 07    .res 8, $07                      ; tiles  72-79   group 9  POTION 1  YELLOW
00004Cr 2  07 07 07 07  
000050r 2  05 05 05 05    .res 8, $05                      ; tiles  80-87   group 10 POTION 2  GREEN
000054r 2  05 05 05 05  
000058r 2  03 03 03 03    .res 8, $03                      ; tiles  88-95   group 11 POTION 3  CYAN
00005Cr 2  03 03 03 03  
000060r 2  06 06 06 06    .res 8, $06                      ; tiles  96-103  group 12 POTION 4  BLUE
000064r 2  06 06 06 06  
000068r 2  04 04 04 04    .res 8, $04                      ; tiles 104-111  group 13 POTION 5  PURPLE
00006Cr 2  04 04 04 04  
000070r 2  01 01 01 01    .res 8, $01                      ; tiles 112-119  group 14 POTION 6  WILD / prism white
000074r 2  01 01 01 01  
000078r 2  02 02 02 02    .res 8, $02                      ; tiles 120-127  group 15 Wall / stone           red
00007Cr 2  02 02 02 02  
000080r 2  01 01 01 01    .res 8, $01                      ; tiles 128-135  group 16 artwork
000084r 2  01 01 01 01  
000088r 2  02 02 02 02    .res 8, $02                      ; tiles 136-143  group 17 artwork
00008Cr 2  02 02 02 02  
000090r 2  05 05 05 05    .res 8, $05                      ; tiles 144-151  group 18 artwork
000094r 2  05 05 05 05  
000098r 2  07 07 07 07    .res 8, $07                      ; tiles 152-159  group 19 artwork
00009Cr 2  07 07 07 07  
0000A0r 2  06 06 06 06    .res 8, $06                      ; tiles 160-167  group 20 artwork
0000A4r 2  06 06 06 06  
0000A8r 2  05 05 05 05    .res 8, $05                      ; tiles 168-175  group 21 artwork
0000ACr 2  05 05 05 05  
0000B0r 2  02 02 02 02    .res 8, $02                      ; tiles 176-183  group 22 artwork
0000B4r 2  02 02 02 02  
0000B8r 2  03 03 03 03    .res 8, $03                      ; tiles 184-191  group 23 artwork
0000BCr 2  03 03 03 03  
0000C0r 2  07 07 07 07    .res 8, $07                      ; tiles 192-199  group 24 artwork
0000C4r 2  07 07 07 07  
0000C8r 2  06 06 06 06    .res 8, $06                      ; tiles 200-207  group 25 artwork
0000CCr 2  06 06 06 06  
0000D0r 2  04 04 04 04    .res 8, $04                      ; tiles 208-215  group 26 artwork
0000D4r 2  04 04 04 04  
0000D8r 2  05 05 05 05    .res 8, $05                      ; tiles 216-223  group 27 artwork
0000DCr 2  05 05 05 05  
0000E0r 2  02 02 02 02    .res 8, $02                      ; tiles 224-231  group 28 artwork
0000E4r 2  02 02 02 02  
0000E8r 2  01 01 01 01    .res 8, $01                      ; tiles 232-239  group 29 artwork
0000ECr 2  01 01 01 01  
0000F0r 2  01 01 01 01    .res 8, $01                      ; tiles 240-247  group 30 artwork
0000F4r 2  01 01 01 01  
0000F8r 2  01 01 01 01    .res 8, $01                      ; tiles 248-255  group 31 artwork
0000FCr 2  01 01 01 01  
000100r 2               
000100r 1               .include "../src/tables.inc"
000100r 2               ; =============================================================================
000100r 2               ;   tables.inc — Wizards Lab, spec-derived lookup tables
000100r 2               ; =============================================================================
000100r 2               ;   Straight out of SPEC.md sections 5.3, 9 and 10. Hand-authored, never
000100r 2               ;   overwritten by an editor export. Included once, from the RODATA segment.
000100r 2               ;
000100r 2               ;   Score values above 99 do not fit in a byte, so every scoring table is a
000100r 2               ;   pair of parallel arrays — low BCD byte and high BCD byte — indexed by the
000100r 2               ;   same value.
000100r 2               ; =============================================================================
000100r 2               
000100r 2               ; --- Gravity, frames per row (SPEC 10.2) -------------------------------------
000100r 2               ;   Indexed by (level - 1), clamped to LEVEL_SPEED_CAP - 1.
000100r 2               ;   PAL is round(NTSC * 50/60), so wall-clock speed matches across regions.
000100r 2               
000100r 2               SpeedNTSC:
000100r 2  30 2B 26 22    .byte  48, 43, 38, 34, 30, 26, 23, 20   ; levels  1- 8   0.800s .. 0.333s
000104r 2  1E 1A 17 14  
000108r 2  11 0F 0D 0B    .byte  17, 15, 13, 11,  9,  8,  7,  6   ; levels  9-16   0.283s .. 0.100s
00010Cr 2  09 08 07 06  
000110r 2               
000110r 2               SpeedPAL:
000110r 2  28 24 20 1C    .byte  40, 36, 32, 28, 25, 22, 19, 17   ; levels  1- 8   0.800s .. 0.340s
000114r 2  19 16 13 11  
000118r 2  0E 0D 0B 09    .byte  14, 13, 11,  9,  8,  7,  6,  5   ; levels  9-16   0.280s .. 0.100s
00011Cr 2  08 07 06 05  
000120r 2               
000120r 2               ; --- Frame counts that differ by region (SPEC 5.6, 11.3, 14) -----------------
000120r 2               ;   Indexed by Region: 0 = NTSC, 1 = PAL. PAL is round(NTSC * 50/60) wherever
000120r 2               ;   the difference is worth a frame, so a piece takes the same number of
000120r 2               ;   SECONDS to lock on both machines rather than the same number of frames.
000120r 2               ;
000120r 2               ;   Two bytes each rather than one table of pairs, because every read is
000120r 2               ;   `ldx Region / lda Name,x` and a pair table would need the index doubled.
000120r 2               
000120r 2               LockDelay:                              ; SPEC 5.6
000120r 2  10 0E          .byte 16, 14
000122r 2               AreDelay:                               ; Entry delay after a cascade settles
000122r 2  0C 0A          .byte 12, 10
000124r 2               DasInitial:                             ; SPEC 11.3 — first repeat
000124r 2  0C 0A          .byte 12, 10
000126r 2               DasRepeat:                              ; ...and every one after it
000126r 2  04 03          .byte  4,  3
000128r 2               SoftDropRate:                           ; Frames per row while DOWN is held.
000128r 2  03 02          .byte  3,  2                          ;   Never used when gravity is faster.
00012Ar 2               
00012Ar 2               ; --- Per-tile value for MATCH removals (SPEC 9.1) ----------------------------
00012Ar 2               ;   Indexed by (chain - 1), clamped to 7.   20 50 100 200 300 400 500 600
00012Ar 2               TileValueLo:
00012Ar 2  20 50 00 00    .byte $20, $50, $00, $00, $00, $00, $00, $00
00012Er 2  00 00 00 00  
000132r 2               TileValueHi:
000132r 2  00 00 01 02    .byte $00, $00, $01, $02, $03, $04, $05, $06
000136r 2  03 04 05 06  
00013Ar 2               
00013Ar 2               ; --- Per-tile value for EFFECT removals (SPEC 9.2) ---------------------------
00013Ar 2               ;   Indexed by (chain - 1), clamped to 7.   30 60 120 240 350 450 550 650
00013Ar 2               EffectValueLo:
00013Ar 2  30 60 20 40    .byte $30, $60, $20, $40, $50, $50, $50, $50
00013Er 2  50 50 50 50  
000142r 2               EffectValueHi:
000142r 2  00 00 01 02    .byte $00, $00, $01, $02, $03, $04, $05, $06
000146r 2  03 04 05 06  
00014Ar 2               
00014Ar 2               ; --- Run length bonus (SPEC 9.3) ---------------------------------------------
00014Ar 2               ;   Indexed by (length - 3), clamped to 4.  0 100 300 600 1000
00014Ar 2               LengthBonusLo:
00014Ar 2  00 00 00 00    .byte $00, $00, $00, $00, $00
00014Er 2  00           
00014Fr 2               LengthBonusHi:
00014Fr 2  00 01 03 06    .byte $00, $01, $03, $06, $10
000153r 2  10           
000154r 2               
000154r 2               ; --- Simultaneous run bonus (SPEC 9.4) ---------------------------------------
000154r 2               ;   Indexed by (runs - 1), clamped to 4.    0 200 500 1000 2000
000154r 2               MultiBonusLo:
000154r 2  00 00 00 00    .byte $00, $00, $00, $00, $00
000158r 2  00           
000159r 2               MultiBonusHi:
000159r 2  00 02 05 10    .byte $00, $02, $05, $10, $20
00015Dr 2  20           
00015Er 2               
00015Er 2               ; --- Level -> reagent probability band (SPEC 5.3) ----------------------------
00015Er 2               ;   Indexed by (level - 1), clamped to 15. Bands are 1-3, 4-6, 7-9, 10-12, 13+.
00015Er 2               LevelBand:
00015Er 2  00 00 00 01    .byte 0, 0, 0, 1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 4
000162r 2  01 01 02 02  
000166r 2  02 03 03 03  
00016Er 2               
00016Er 2               ; --- Chance a piece carries a reagent, out of 256 (SPEC 5.3) -----------------
00016Er 2               ;   Indexed by band.                        15%  22%  27%  32%  36%
00016Er 2               PSpecial:
00016Er 2  26 38 45 52    .byte  38,  56,  69,  82,  92
000172r 2  5C           
000173r 2               
000173r 2               ; --- Reagent type, cumulative thresholds out of 256 (SPEC 5.3) ---------------
000173r 2               ;   Four thresholds per band; a roll at or above the last one is a Prism.
000173r 2               ;       roll <  [0] -> Fireball
000173r 2               ;       roll <  [1] -> Bolt
000173r 2               ;       roll <  [2] -> Bomb
000173r 2               ;       roll <  [3] -> Star
000173r 2               ;       else        -> Prism
000173r 2               ReagentThresholds:
000173r 2  4D 8A C3 EC    .byte  77, 138, 195, 236             ; band 0   levels  1-3
000177r 2  4D 8D C0 EE    .byte  77, 141, 192, 238             ; band 1   levels  4-6
00017Br 2  52 92 C5 EE    .byte  82, 146, 197, 238             ; band 2   levels  7-9
00017Fr 2  4F 8D C3 EE    .byte  79, 141, 195, 238             ; band 3   levels 10-12
000183r 2  4F 8F C7 F0    .byte  79, 143, 199, 240             ; band 4   levels 13+
000187r 2               
000187r 2               ; --- Reagent trigger bonuses, indexed by glyph (SPEC 9.5) --------------------
000187r 2               ;   Glyph 0 potion and 4 star award nothing here (the star multiplies instead).
000187r 2               TriggerBonusLo:
000187r 2  00 00 00 00    .byte $00, $00, $00, $00, $00, $00, $00, $00
00018Br 2  00 00 00 00  
00018Fr 2               TriggerBonusHi:
00018Fr 2  00 05 03 03    .byte $00, $05, $03, $03, $00, $00, $00, $00
000193r 2  00 00 00 00  
000197r 2               
000197r 1               .include "../src/strings.inc"
000197r 2               ; =============================================================================
000197r 2               ;   strings.inc — Wizards Lab, tile-encoded text
000197r 2               ; =============================================================================
000197r 2               ;   Strings are stored as TILE numbers, not ASCII, terminated by TEXT_END, so
000197r 2               ;   TextDraw is a copy with no translation at run time (see text.asm). The
000197r 2               ;   translation happens here instead, at assembly time, in TileStr.
000197r 2               ;
000197r 2               ;   Hand-authored, never overwritten by an editor export (D3). Included once,
000197r 2               ;   from each platform's RODATA segment.
000197r 2               ; =============================================================================
000197r 2               
000197r 2               ; -----------------------------------------------------------------------------
000197r 2               ;   TileChar / TileStr — ASCII source, tile bytes out
000197r 2               ;   The font is forty glyphs in one run from FONT_BASE:
000197r 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
000197r 2               ;   and a space is TILE_BLANK. Anything else is not in the tileset and is an
000197r 2               ;   assembly error rather than a wrong glyph on the screen.
000197r 2               ; -----------------------------------------------------------------------------
000197r 2               .macro TileChar c
000197r 2                 .if c = ' '
000197r 2                   .byte TILE_BLANK
000197r 2                 .elseif (c >= '0') .and (c <= '9')
000197r 2                   .byte FONT_DIGIT_0 + (c - '0')
000197r 2                 .elseif (c >= 'A') .and (c <= 'Z')
000197r 2                   .byte FONT_LETTER_A + (c - 'A')
000197r 2                 .elseif c = '.'
000197r 2                   .byte FONT_DOT
000197r 2                 .elseif c = 'x'
000197r 2                   .byte FONT_TIMES
000197r 2                 .elseif c = '!'
000197r 2                   .byte FONT_BANG
000197r 2                 .elseif c = '~'
000197r 2                   .byte FONT_TILDE
000197r 2                 .else
000197r 2                   .error "strings.inc: no tile for this character"
000197r 2                 .endif
000197r 2               .endmacro
000197r 2               
000197r 2               .macro TileStr s
000197r 2                 .repeat .strlen(s), I
000197r 2                   TileChar {.strat(s, I)}
000197r 2                 .endrepeat
000197r 2                 .byte TEXT_END
000197r 2               .endmacro
000197r 2               
000197r 2               ; -----------------------------------------------------------------------------
000197r 2               ;   Banners — SPEC 12.2, 13.3
000197r 2               ;   Even length, so (PANEL_W - length) / 2 centres exactly. The band is 18
000197r 2               ;   cells of backdrop between two shelf tiles either side, so a banner has 18
000197r 2               ;   to play with before it starts overwriting the artwork.
000197r 2               ;
000197r 2               ;   MsgPaused matches the play screen image byte for byte on purpose: the
000197r 2               ;   artwork ships with the band already reading `~~ PAUSED ~~` (see SPEC 12.1),
000197r 2               ;   so entering play clears the band and pausing draws this straight back.
000197r 2               ; -----------------------------------------------------------------------------
000197r 2               MsgPaused:
000197r 2  37 37 00 29    TileStr "~~ PAUSED ~~"                 ; 12 cells, centres at panel column 5
00019Br 2  1A 2E 2C 1E  
00019Fr 2  1D 00 37 37  
0001A4r 2               
0001A4r 2               MsgLevelUp:
0001A4r 2  37 37 00 25    TileStr "~~ LEVEL UP ~~"               ; 14 cells, centres at panel column 4
0001A8r 2  1E 2F 1E 25  
0001ACr 2  00 2E 29 00  
0001B3r 2               
0001B3r 1               
0001B3r 1               ; --- Screen row start addresses ----------------------------------------------
0001B3r 1               RowLo:
0001B3r 1  00 16 2C 42    .repeat SCR_ROWS, i
0001B7r 1  58 6E 84 9A  
0001BBr 1  B0 C6 DC F2  
0001CAr 1                   .byte <(SCREEN + i * SCR_COLS)
0001CAr 1                 .endrepeat
0001CAr 1               RowHi:
0001CAr 1  1E 1E 1E 1E    .repeat SCR_ROWS, i
0001CEr 1  1E 1E 1E 1E  
0001D2r 1  1E 1E 1E 1E  
0001E1r 1                   .byte >(SCREEN + i * SCR_COLS)
0001E1r 1                 .endrepeat
0001E1r 1               
0001E1r 1               .segment "TILES"
000000r 1               
