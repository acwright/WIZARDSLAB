000120r 2               
000120r 2               ; --- Frame counts that differ by region (SPEC 5.6, 11.3, 14) -----------------
000120r 2               ;   Indexed by Region: 0 = NTSC, 1 = PAL. PAL is round(NTSC * 50/60) wherever
000120r 2               ;   the difference is worth a frame, so a piece takes the same number of
000120r 2               ;   SECONDS to lock on both machines rather than the same number of frames.
000120r 2               ;
000120r 2               ;   Two bytes each rather than one table of pairs, because every read is
000120r 2               ;   `ldx Region / lda Name,x` and a pair table would need the index doubled.
000120r 2               
000120r 2               LockDelay:                              ; SPEC 5.6
000120r 2  10 0E          .byte 16, 14
000122r 2               AreDelay:                               ; Entry delay after a cascade settles
000122r 2  0C 0A          .byte 12, 10
000124r 2               DasInitial:                             ; SPEC 11.3 — first repeat
000124r 2  0C 0A          .byte 12, 10
000126r 2               DasRepeat:                              ; ...and every one after it
000126r 2  04 03          .byte  4,  3
000128r 2               SoftDropRate:                           ; Frames per row while DOWN is held.
000128r 2  03 02          .byte  3,  2                          ;   Never used when gravity is faster.
00012Ar 2               BlinkHalf:                              ; SPEC 14 — half of the 30 / 25 frame
00012Ar 2  0F 0D          .byte 15, 13                          ;   blink period, which is what a
00012Cr 2                                                       ;   blinking field actually counts
00012Cr 2               
00012Cr 2               ; --- Per-tile value for MATCH removals (SPEC 9.1) ----------------------------
00012Cr 2               ;   Indexed by (chain - 1), clamped to 7.   20 50 100 200 300 400 500 600
00012Cr 2               TileValueLo:
00012Cr 2  20 50 00 00    .byte $20, $50, $00, $00, $00, $00, $00, $00
000130r 2  00 00 00 00  
000134r 2               TileValueHi:
000134r 2  00 00 01 02    .byte $00, $00, $01, $02, $03, $04, $05, $06
000138r 2  03 04 05 06  
00013Cr 2               
00013Cr 2               ; --- Per-tile value for EFFECT removals (SPEC 9.2) ---------------------------
00013Cr 2               ;   Indexed by (chain - 1), clamped to 7.   30 60 120 240 350 450 550 650
00013Cr 2               EffectValueLo:
00013Cr 2  30 60 20 40    .byte $30, $60, $20, $40, $50, $50, $50, $50
000140r 2  50 50 50 50  
000144r 2               EffectValueHi:
000144r 2  00 00 01 02    .byte $00, $00, $01, $02, $03, $04, $05, $06
000148r 2  03 04 05 06  
00014Cr 2               
00014Cr 2               ; --- Run length bonus (SPEC 9.3) ---------------------------------------------
00014Cr 2               ;   Indexed by (length - 3), clamped to 4.  0 100 300 600 1000
00014Cr 2               LengthBonusLo:
00014Cr 2  00 00 00 00    .byte $00, $00, $00, $00, $00
000150r 2  00           
000151r 2               LengthBonusHi:
000151r 2  00 01 03 06    .byte $00, $01, $03, $06, $10
000155r 2  10           
000156r 2               
000156r 2               ; --- Simultaneous run bonus (SPEC 9.4) ---------------------------------------
000156r 2               ;   Indexed by (runs - 1), clamped to 4.    0 200 500 1000 2000
000156r 2               MultiBonusLo:
000156r 2  00 00 00 00    .byte $00, $00, $00, $00, $00
00015Ar 2  00           
00015Br 2               MultiBonusHi:
00015Br 2  00 02 05 10    .byte $00, $02, $05, $10, $20
00015Fr 2  20           
000160r 2               
000160r 2               ; --- Level -> reagent probability band (SPEC 5.3) ----------------------------
000160r 2               ;   Indexed by (level - 1), clamped to 15. Bands are 1-3, 4-6, 7-9, 10-12, 13+.
000160r 2               LevelBand:
000160r 2  00 00 00 01    .byte 0, 0, 0, 1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 4
000164r 2  01 01 02 02  
000168r 2  02 03 03 03  
000170r 2               
000170r 2               ; --- Chance a piece carries a reagent, out of 256 (SPEC 5.3) -----------------
000170r 2               ;   Indexed by band.                        15%  22%  27%  32%  36%
000170r 2               PSpecial:
000170r 2  26 38 45 52    .byte  38,  56,  69,  82,  92
000174r 2  5C           
000175r 2               
000175r 2               ; --- Reagent type, cumulative thresholds out of 256 (SPEC 5.3) ---------------
000175r 2               ;   Four thresholds per band; a roll at or above the last one is a Prism.
000175r 2               ;       roll <  [0] -> Fireball
000175r 2               ;       roll <  [1] -> Bolt
000175r 2               ;       roll <  [2] -> Bomb
000175r 2               ;       roll <  [3] -> Star
000175r 2               ;       else        -> Prism
000175r 2               ReagentThresholds:
000175r 2  4D 8A C3 EC    .byte  77, 138, 195, 236             ; band 0   levels  1-3
000179r 2  4D 8D C0 EE    .byte  77, 141, 192, 238             ; band 1   levels  4-6
00017Dr 2  52 92 C5 EE    .byte  82, 146, 197, 238             ; band 2   levels  7-9
000181r 2  4F 8D C3 EE    .byte  79, 141, 195, 238             ; band 3   levels 10-12
000185r 2  4F 8F C7 F0    .byte  79, 143, 199, 240             ; band 4   levels 13+
000189r 2               
000189r 2               ; --- Reagent trigger bonuses, indexed by glyph (SPEC 9.5) --------------------
000189r 2               ;   Glyph 0 potion and 4 star award nothing here (the star multiplies instead).
000189r 2               TriggerBonusLo:
000189r 2  00 00 00 00    .byte $00, $00, $00, $00, $00, $00, $00, $00
00018Dr 2  00 00 00 00  
000191r 2               TriggerBonusHi:
000191r 2  00 05 03 03    .byte $00, $05, $03, $03, $00, $00, $00, $00
000195r 2  00 00 00 00  
000199r 2               
000199r 1               .include "../src/strings.inc"
000199r 2               ; =============================================================================
000199r 2               ;   strings.inc — Wizards Lab, tile-encoded text
000199r 2               ; =============================================================================
000199r 2               ;   Strings are stored as TILE numbers, not ASCII, terminated by TEXT_END, so
000199r 2               ;   TextDraw is a copy with no translation at run time (see text.asm). The
000199r 2               ;   translation happens here instead, at assembly time, in TileStr.
000199r 2               ;
000199r 2               ;   Hand-authored, never overwritten by an editor export (D3). Included once,
000199r 2               ;   from each platform's RODATA segment.
000199r 2               ; =============================================================================
000199r 2               
000199r 2               ; -----------------------------------------------------------------------------
000199r 2               ;   TileChar / TileStr — ASCII source, tile bytes out
000199r 2               ;   The font is forty glyphs in one run from FONT_BASE:
000199r 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
000199r 2               ;   and a space is TILE_BLANK. Anything else is not in the tileset and is an
000199r 2               ;   assembly error rather than a wrong glyph on the screen.
000199r 2               ; -----------------------------------------------------------------------------
000199r 2               .macro TileChar c
000199r 2                 .if c = ' '
000199r 2                   .byte TILE_BLANK
000199r 2                 .elseif (c >= '0') .and (c <= '9')
000199r 2                   .byte FONT_DIGIT_0 + (c - '0')
000199r 2                 .elseif (c >= 'A') .and (c <= 'Z')
000199r 2                   .byte FONT_LETTER_A + (c - 'A')
000199r 2                 .elseif c = '.'
000199r 2                   .byte FONT_DOT
000199r 2                 .elseif c = 'x'
000199r 2                   .byte FONT_TIMES
000199r 2                 .elseif c = '!'
000199r 2                   .byte FONT_BANG
000199r 2                 .elseif c = '~'
000199r 2                   .byte FONT_TILDE
000199r 2                 .else
000199r 2                   .error "strings.inc: no tile for this character"
000199r 2                 .endif
000199r 2               .endmacro
000199r 2               
000199r 2               .macro TileStr s
000199r 2                 .repeat .strlen(s), I
000199r 2                   TileChar {.strat(s, I)}
000199r 2                 .endrepeat
000199r 2                 .byte TEXT_END
000199r 2               .endmacro
000199r 2               
000199r 2               ; -----------------------------------------------------------------------------
000199r 2               ;   Banners — SPEC 12.2, 13.3
000199r 2               ;   Even length, so (PANEL_W - length) / 2 centres exactly. The band is 18
000199r 2               ;   cells of backdrop between two shelf tiles either side, so a banner has 18
000199r 2               ;   to play with before it starts overwriting the artwork.
000199r 2               ;
000199r 2               ;   MsgPaused matches the play screen image byte for byte on purpose: the
000199r 2               ;   artwork ships with the band already reading `~~ PAUSED ~~` (see SPEC 12.1),
000199r 2               ;   so entering play clears the band and pausing draws this straight back.
000199r 2               ; -----------------------------------------------------------------------------
000199r 2               MsgPaused:
000199r 2  37 37 00 29    TileStr "~~ PAUSED ~~"                 ; 12 cells, centres at panel column 5
00019Dr 2  1A 2E 2C 1E  
0001A1r 2  1D 00 37 37  
0001A6r 2               
0001A6r 2               MsgLevelUp:
0001A6r 2  37 37 00 25    TileStr "~~ LEVEL UP ~~"               ; 14 cells, centres at panel column 4
0001AAr 2  1E 2F 1E 25  
0001AEr 2  00 2E 29 00  
0001B5r 2               
0001B5r 1               
0001B5r 1               ; --- Screen row start addresses ----------------------------------------------
0001B5r 1               RowLo:
0001B5r 1  00 16 2C 42    .repeat SCR_ROWS, i
0001B9r 1  58 6E 84 9A  
0001BDr 1  B0 C6 DC F2  
0001CCr 1                   .byte <(SCREEN + i * SCR_COLS)
0001CCr 1                 .endrepeat
0001CCr 1               RowHi:
0001CCr 1  1E 1E 1E 1E    .repeat SCR_ROWS, i
0001D0r 1  1E 1E 1E 1E  
0001D4r 1  1E 1E 1E 1E  
0001E3r 1                   .byte >(SCREEN + i * SCR_COLS)
0001E3r 1                 .endrepeat
0001E3r 1               
0001E3r 1               .segment "TILES"
000000r 1               
