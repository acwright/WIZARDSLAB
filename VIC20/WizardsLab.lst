000000r 1               ; =============================================================================
000000r 1               ;   Wizards Lab — VIC-20
000000r 1               ; =============================================================================
000000r 1               ;   A 16 K cartridge for an unexpanded VIC-20: BLK5 ($A000) carries the
000000r 1               ;   autostart header and the code, BLK3 ($6000) carries the tileset and screen
000000r 1               ;   images.
000000r 1               ;
000000r 1               ;   This machine sets the shape of the whole game. Its 22 x 23 screen is
000000r 1               ;   exactly the panel every platform draws, and its eight hi-res foreground
000000r 1               ;   colours are what cap the potion palette at six plus white. Designing
000000r 1               ;   against it first is what lets one layout serve all three.
000000r 1               ;
000000r 1               ;   The VIC chip cannot see cartridge ROM, so the character set is copied out
000000r 1               ;   of BLK3 into RAM at $1400 during boot.
000000r 1               ;
000000r 1               ;   Built with VIC20-16K.cfg.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               .include "../include/vic20.inc"
000000r 2               ; VIC-20 Include File for ca65
000000r 2               ; Memory addresses, KERNAL routines, and hardware registers
000000r 2               ; Compatible with both NTSC and PAL VIC-20 systems
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Zero Page Locations
000000r 2               ;=============================================================================
000000r 2               VARTAB          = $2D           ; Pointer to start of BASIC variables
000000r 2               ARYTAB          = $2F           ; Pointer to start of BASIC arrays
000000r 2               STREND          = $31           ; Pointer to end of BASIC arrays
000000r 2               FRETOP          = $33           ; Pointer to bottom of string space
000000r 2               MEMSIZ          = $37           ; Pointer to top of BASIC memory
000000r 2               TIME            = $A0           ; Jiffy clock (3 bytes)
000000r 2               TIMER           = $A0           ; Same as TIME
000000r 2               STATUS          = $90           ; I/O status byte
000000r 2               STKEY           = $91           ; STOP key flag
000000r 2               MSGFLG          = $9D           ; Kernal message control flag
000000r 2               FNLEN           = $B7           ; Length of filename
000000r 2               LA              = $B8           ; Logical file number
000000r 2               SA              = $B9           ; Secondary address
000000r 2               FA              = $BA           ; Device number
000000r 2               FNADR           = $BB           ; Pointer to filename (2 bytes)
000000r 2               STAL            = $C1           ; Pointer for tape I/O (2 bytes)
000000r 2               EAL             = $C3           ; Pointer for tape I/O (2 bytes)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Screen and Color Memory (Unexpanded VIC-20)
000000r 2               ;=============================================================================
000000r 2               SCREEN          = $1E00         ; Screen memory start (22x23 default)
000000r 2               COLRAM          = $9600         ; Color RAM start
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; User BASIC Memory
000000r 2               ;=============================================================================
000000r 2               BASIC_START     = $1001         ; Start of BASIC program area
000000r 2               BASIC_END       = $1E00         ; End of BASIC (screen memory starts)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; VIC Chip Registers (6560/6561 Video Interface Chip)
000000r 2               ;=============================================================================
000000r 2               VIC             = $9000         ; Base address of VIC chip
000000r 2               
000000r 2               ; Individual VIC registers
000000r 2               VIC_CR0         = $9000         ; Horizontal centering (bit 7 = interlace)
000000r 2               VIC_CR1         = $9001         ; Vertical centering
000000r 2               VIC_CR2         = $9002         ; Video matrix columns (bits 0-6, bit 7=raster)
000000r 2               VIC_CR3         = $9003         ; Raster value (bits 1-7 = rows*2, bit 0=character size)
000000r 2               VIC_CR4         = $9004         ; TV raster beam location (read only)
000000r 2               VIC_CR5         = $9005         ; Video matrix start address (bits 4-7)
000000r 2               VIC_CRA         = $900A         ; Bass frequency
000000r 2               VIC_CRB         = $900B         ; Alto frequency
000000r 2               VIC_CRC         = $900C         ; Soprano frequency
000000r 2               VIC_CRD         = $900D         ; Noise frequency
000000r 2               VIC_CRE         = $900E         ; Auxiliary color / Volume
000000r 2               VIC_CRF         = $900F         ; Screen & border colors / reverse mode
000000r 2               
000000r 2               ; VIC register aliases
000000r 2               VIC_HORZ        = VIC_CR0       ; Horizontal position
000000r 2               VIC_VERT        = VIC_CR1       ; Vertical position
000000r 2               VIC_COLUMNS     = VIC_CR2       ; Number of columns
000000r 2               VIC_ROWS        = VIC_CR3       ; Number of rows
000000r 2               VIC_RASTER      = VIC_CR4       ; Raster position
000000r 2               VIC_ORIGIN      = VIC_CR5       ; Screen memory location
000000r 2               VIC_BASS        = VIC_CRA       ; Sound: Bass voice
000000r 2               VIC_ALTO        = VIC_CRB       ; Sound: Alto voice
000000r 2               VIC_SOPRANO     = VIC_CRC       ; Sound: Soprano voice
000000r 2               VIC_NOISE       = VIC_CRD       ; Sound: Noise voice
000000r 2               VIC_VOLUME      = VIC_CRE       ; Volume control (bits 0-3)
000000r 2               VIC_AUX_COLOR   = VIC_CRE       ; Auxiliary color (bits 4-7)
000000r 2               VIC_BACKGROUND  = VIC_CRF       ; Background color (bits 4-7)
000000r 2               VIC_BORDER      = VIC_CRF       ; Border color (bits 0-2)
000000r 2               VIC_REVERSE     = VIC_CRF       ; Reverse mode (bit 3)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; VIA Chip #1 Registers (6522 VIA - Keyboard, Joystick)
000000r 2               ;=============================================================================
000000r 2               VIA1            = $9110         ; Base address of VIA1
000000r 2               VIA1_PB         = $9110         ; Port B (keyboard row select, joystick)
000000r 2               VIA1_PA1        = $9111         ; Port A (keyboard column read)
000000r 2               VIA1_DDRB       = $9112         ; Data direction register B
000000r 2               VIA1_DDRA       = $9113         ; Data direction register A
000000r 2               VIA1_T1CL       = $9114         ; Timer 1 counter low
000000r 2               VIA1_T1CH       = $9115         ; Timer 1 counter high
000000r 2               VIA1_T1LL       = $9116         ; Timer 1 latch low
000000r 2               VIA1_T1LH       = $9117         ; Timer 1 latch high
000000r 2               VIA1_T2CL       = $9118         ; Timer 2 counter low
000000r 2               VIA1_T2CH       = $9119         ; Timer 2 counter high
000000r 2               VIA1_SR         = $911A         ; Shift register
000000r 2               VIA1_ACR        = $911B         ; Auxiliary control register
000000r 2               VIA1_PCR        = $911C         ; Peripheral control register
000000r 2               VIA1_IFR        = $911D         ; Interrupt flag register
000000r 2               VIA1_IER        = $911E         ; Interrupt enable register
000000r 2               VIA1_PA2        = $911F         ; Port A (no handshake)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; VIA Chip #2 Registers (6522 VIA - Serial, Tape, Joystick)
000000r 2               ;=============================================================================
000000r 2               VIA2            = $9120         ; Base address of VIA2
000000r 2               VIA2_PB         = $9120         ; Port B (serial bus, tape control, joystick)
000000r 2               VIA2_PA1        = $9121         ; Port A (serial bus)
000000r 2               VIA2_DDRB       = $9122         ; Data direction register B
000000r 2               VIA2_DDRA       = $9123         ; Data direction register A
000000r 2               VIA2_T1CL       = $9124         ; Timer 1 counter low
000000r 2               VIA2_T1CH       = $9125         ; Timer 1 counter high
000000r 2               VIA2_T1LL       = $9126         ; Timer 1 latch low
000000r 2               VIA2_T1LH       = $9127         ; Timer 1 latch high
000000r 2               VIA2_T2CL       = $9128         ; Timer 2 counter low
000000r 2               VIA2_T2CH       = $9129         ; Timer 2 counter high
000000r 2               VIA2_SR         = $912A         ; Shift register
000000r 2               VIA2_ACR        = $912B         ; Auxiliary control register
000000r 2               VIA2_PCR        = $912C         ; Peripheral control register
000000r 2               VIA2_IFR        = $912D         ; Interrupt flag register
000000r 2               VIA2_IER        = $912E         ; Interrupt enable register
000000r 2               VIA2_PA2        = $912F         ; Port A (no handshake)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Joystick (VIA1 Port A = $9111, VIA2 Port B = $9120)
000000r 2               ; Active-low: bit is 0 when the switch is closed (direction/fire pressed)
000000r 2               ;=============================================================================
000000r 2               JOY_UP          = %00000100     ; VIA1_PA1 bit 2
000000r 2               JOY_DOWN        = %00001000     ; VIA1_PA1 bit 3
000000r 2               JOY_LEFT        = %00010000     ; VIA1_PA1 bit 4
000000r 2               JOY_FIRE        = %00100000     ; VIA1_PA1 bit 5
000000r 2               JOY_RIGHT       = %10000000     ; VIA2_PB bit 7
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Color Codes
000000r 2               ;=============================================================================
000000r 2               BLACK           = $00
000000r 2               WHITE           = $01
000000r 2               RED             = $02
000000r 2               CYAN            = $03
000000r 2               PURPLE          = $04
000000r 2               GREEN           = $05
000000r 2               BLUE            = $06
000000r 2               YELLOW          = $07
000000r 2               ORANGE          = $08
000000r 2               LIGHT_ORANGE    = $09
000000r 2               PINK            = $0A
000000r 2               LIGHT_CYAN      = $0B
000000r 2               LIGHT_PURPLE    = $0C
000000r 2               LIGHT_GREEN     = $0D
000000r 2               LIGHT_BLUE      = $0E
000000r 2               LIGHT_YELLOW    = $0F
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Character Codes (PETSCII)
000000r 2               ;=============================================================================
000000r 2               CHR_RETURN      = $0D
000000r 2               CHR_SPACE       = $20
000000r 2               CHR_DELETE      = $14
000000r 2               CHR_INSERT      = $94
000000r 2               CHR_HOME        = $13
000000r 2               CHR_CLEAR       = $93
000000r 2               CHR_RVSON       = $12           ; Reverse on
000000r 2               CHR_RVSOFF      = $92           ; Reverse off
000000r 2               CHR_DOWN        = $11
000000r 2               CHR_UP          = $91
000000r 2               CHR_RIGHT       = $1D
000000r 2               CHR_LEFT        = $9D
000000r 2               CHR_BLACK       = $90
000000r 2               CHR_WHITE       = $05
000000r 2               CHR_RED         = $1C
000000r 2               CHR_CYAN        = $9F
000000r 2               CHR_PURPLE      = $9C
000000r 2               CHR_GREEN       = $1E
000000r 2               CHR_BLUE        = $9E
000000r 2               CHR_YELLOW      = $9B
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; ROM Addresses
000000r 2               ;=============================================================================
000000r 2               CHARROM         = $8000         ; Character ROM
000000r 2               BASIC_ROM       = $C000         ; BASIC ROM start
000000r 2               KERNAL_ROM      = $E000         ; KERNAL ROM start
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; KERNAL Routines
000000r 2               ;=============================================================================
000000r 2               ; Internal KERNAL routines (address may vary by ROM version)
000000r 2               CINT            = $E518         ; Initialize screen editor
000000r 2               IOINIT          = $FDF9         ; Initialize I/O
000000r 2               RAMTAS          = $FD8D         ; Initialize RAM
000000r 2               RESTOR          = $FD52         ; Restore default I/O vectors
000000r 2               VECTOR          = $FD1A         ; Manage RAM vectors
000000r 2               
000000r 2               ; KERNAL Jump Table (standard across all VIC-20s)
000000r 2               SETMSG          = $FF90         ; Control KERNAL messages
000000r 2               SECOND          = $FF93         ; Send secondary address
000000r 2               TKSA            = $FF96         ; Send secondary address for talk
000000r 2               MEMTOP          = $FF99         ; Read/set top of memory
000000r 2               MEMBOT          = $FF9C         ; Read/set bottom of memory
000000r 2               SCNKEY          = $FF9F         ; Scan keyboard
000000r 2               SETTMO          = $FFA2         ; Set timeout for serial bus
000000r 2               ACPTR           = $FFA5         ; Input byte from serial bus
000000r 2               CIOUT           = $FFA8         ; Output byte to serial bus
000000r 2               UNTLK           = $FFAB         ; Send UNTALK to serial bus
000000r 2               UNLSN           = $FFAE         ; Send UNLISTEN to serial bus
000000r 2               LISTEN          = $FFB1         ; Send LISTEN to serial bus
000000r 2               TALK            = $FFB4         ; Send TALK to serial bus
000000r 2               READST          = $FFB7         ; Read I/O status word
000000r 2               SETLFS          = $FFBA         ; Set logical file parameters
000000r 2               SETNAM          = $FFBD         ; Set filename
000000r 2               OPEN            = $FFC0         ; Open a logical file
000000r 2               CLOSE           = $FFC3         ; Close a logical file
000000r 2               CHKIN           = $FFC6         ; Define file as default input
000000r 2               CHKOUT          = $FFC9         ; Define file as default output
000000r 2               CLRCHN          = $FFCC         ; Restore default I/O devices
000000r 2               CHRIN           = $FFCF         ; Input character from channel
000000r 2               CHROUT          = $FFD2         ; Output character to channel
000000r 2               LOAD            = $FFD5         ; Load RAM from device
000000r 2               SAVE            = $FFD8         ; Save RAM to device
000000r 2               SETTIM          = $FFDB         ; Set 24-hour clock
000000r 2               RDTIM           = $FFDE         ; Read 24-hour clock
000000r 2               STOP            = $FFE1         ; Check STOP key
000000r 2               GETIN           = $FFE4         ; Get character from keyboard
000000r 2               CLALL           = $FFE7         ; Close all channels and files
000000r 2               UDTIM           = $FFEA         ; Increment 24-hour clock
000000r 2               SCREEN_ORG      = $FFED         ; Return screen organization
000000r 2               PLOT            = $FFF0         ; Read/set cursor X/Y position
000000r 2               IOBASE          = $FFF3         ; Return I/O base address
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; IRQ/NMI Vectors
000000r 2               ;=============================================================================
000000r 2               IRQ_VECTOR      = $0314         ; IRQ vector (2 bytes)
000000r 2               BRK_VECTOR      = $0316         ; BRK vector (2 bytes)
000000r 2               NMI_VECTOR      = $0318         ; NMI vector (2 bytes)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Hardware Vectors (in ROM)
000000r 2               ;=============================================================================
000000r 2               HW_NMI          = $FFFA         ; NMI vector
000000r 2               HW_RESET        = $FFFC         ; Reset vector
000000r 2               HW_IRQ          = $FFFE         ; IRQ/BRK vector
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Useful Constants
000000r 2               ;=============================================================================
000000r 2               SCREEN_COLS     = 22            ; Default screen columns
000000r 2               SCREEN_ROWS     = 23            ; Default screen rows
000000r 2               JIFFY_PAL       = 50            ; Jiffies per second (PAL)
000000r 2               JIFFY_NTSC      = 60            ; Jiffies per second (NTSC)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Memory Expansion Configurations
000000r 2               ;=============================================================================
000000r 2               ; RAM Block 0 (BLK0) = $0400-$0FFF (3K)
000000r 2               ; RAM Block 1 (BLK1) = $2000-$3FFF (8K)
000000r 2               ; RAM Block 2 (BLK2) = $4000-$5FFF (8K)
000000r 2               ; RAM Block 3 (BLK3) = $6000-$7FFF (8K)
000000r 2               ; RAM Block 5 (BLK5) = $A000-$BFFF (8K)
000000r 2               
000000r 2               BLK0            = $0400         ; 3K expansion
000000r 2               BLK1            = $2000         ; 8K expansion
000000r 2               BLK2            = $4000         ; 8K expansion
000000r 2               BLK3            = $6000         ; 8K expansion
000000r 2               BLK5            = $A000         ; 8K expansion
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; End of VIC20.inc
000000r 2               ;=============================================================================
000000r 2               
000000r 1               
000000r 1               ; --- Platform constants (hal.inc) --------------------------------------------
000000r 1               SCR_COLS         = 22
000000r 1               SCR_ROWS         = 23
000000r 1               SCR_CELLS        = 506           ; 22 x 23
000000r 1               PANEL_X             = 0             ; The screen IS the panel
000000r 1               PANEL_Y             = 0
000000r 1               HAS_COLOR_RAM       = 1
000000r 1               
000000r 1               CHARSET_RAM         = $1400         ; 2 K, $1400-$1BFF
000000r 1               
000000r 1               .include "../src/constants.inc"
000000r 2               ; =============================================================================
000000r 2               ;   constants.inc — Wizards Lab, shared game constants
000000r 2               ; =============================================================================
000000r 2               ;   Everything here comes straight out of SPEC.md. If a number changes there,
000000r 2               ;   it changes here, and nowhere else. Nothing in this file is platform
000000r 2               ;   specific — see the per-platform WizardsLab.asm for PANEL_X / PANEL_Y and
000000r 2               ;   the hardware addresses.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Board (SPEC 3) ----------------------------------------------------------
000000r 2               BOARD_W             = 6         ; Playfield columns
000000r 2               BOARD_H             = 16        ; Playfield rows
000000r 2               BOARD_STRIDE        = 8         ; Bytes per row — two wasted, on purpose
000000r 2               BOARD_ROWS_ALLOC    = 20        ; 16 playfield + 2 floor sentinels + 2 reserved
000000r 2               BOARD_BYTES         = BOARD_ROWS_ALLOC * BOARD_STRIDE    ; 160
000000r 2               SPAWN_COL           = 2         ; 0-indexed, left of centre
000000r 2               MATCH_MIN           = 3         ; Run length that clears
000000r 2               
000000r 2               ; --- Tile encoding (SPEC 4) --------------------------------------------------
000000r 2               ;   tile = COLOR_BASE + (color << 3) + glyph
000000r 2               ;   The board byte IS the tile index. No translation on the way to the screen.
000000r 2               TILE_EMPTY          = $00
000000r 2               TILE_WALL           = $FF
000000r 2               COLOR_BASE          = $40
000000r 2               COLOR_MASK          = $F8       ; AND this and you have the colour key
000000r 2               GLYPH_MASK          = $07
000000r 2               WILD_BASE           = $70       ; Colour 6 — the prism
000000r 2               NUM_COLORS          = 6
000000r 2               
000000r 2               COLOR_RED           = 0
000000r 2               COLOR_YELLOW        = 1
000000r 2               COLOR_GREEN         = 2
000000r 2               COLOR_CYAN          = 3
000000r 2               COLOR_BLUE          = 4
000000r 2               COLOR_PURPLE        = 5
000000r 2               COLOR_WILD          = 6
000000r 2               
000000r 2               GLYPH_POTION        = 0
000000r 2               GLYPH_FIREBALL      = 1
000000r 2               GLYPH_BOLT          = 2
000000r 2               GLYPH_BOMB          = 3
000000r 2               GLYPH_STAR          = 4
000000r 2               GLYPH_GLOW          = 6         ; Match-flash frame. Potion colours only —
000000r 2                                               ;   WILD_BASE + GLYPH_GLOW is an arrow, not a
000000r 2                                               ;   glow, so the prism never takes this path.
000000r 2                                               ;   See PRISM_BLIP below and SPEC 4.4.
000000r 2               
000000r 2               ; --- Named tiles -------------------------------------------------------------
000000r 2               TILE_BLANK          = 0
000000r 2               TILE_BAR_H          = 1
000000r 2               TILE_BAR_V          = 2
000000r 2               TILE_COR_TL         = 3
000000r 2               TILE_COR_TR         = 4
000000r 2               TILE_COR_BL         = 5
000000r 2               TILE_COR_BR         = 6
000000r 2               TILE_WASH           = 7         ; PAUSE / dim wash, white
000000r 2               FONT_BASE           = 16        ; '0'..'9' then 'A'..'Z' then . x ! ~
000000r 2               FONT_DIGIT_0        = 16
000000r 2               FONT_LETTER_A       = 26
000000r 2               FONT_DOT            = 52        ; A CENTRED dot, not a baseline period — it is
000000r 2                                               ;   also frame 0 of the removal ring below
000000r 2               FONT_TIMES          = 53
000000r 2               FONT_BANG           = 54
000000r 2               FONT_TILDE          = 55        ; The banner ornament, ~~~LIKE THIS~~~
000000r 2               TEXT_END            = $FF       ; String terminator. Shares its value with
000000r 2                                               ;   TILE_WALL, which costs nothing: no string
000000r 2                                               ;   ever contains tile 255.
000000r 2               
000000r 2               ; The removal ring (SPEC 14). One animation, used for every removal there is:
000000r 2               ; the match shatter, the bomb blast, the star. It opens outward
000000r 2               ;
000000r 2               ;       FONT_DOT -> VFX_REMOVE1 -> VFX_REMOVE2 -> VFX_REMOVE3 -> empty
000000r 2               ;
000000r 2               ; and the prism's blip-out runs the same tiles closed inward (PRISM_BLIP).
000000r 2               VFX_REMOVE1         = 56
000000r 2               VFX_REMOVE2         = 57
000000r 2               VFX_REMOVE3         = 58
000000r 2               VFX_BEAM_H          = 59        ; The bolt's row
000000r 2               VFX_BEAM_V          = 60        ; The bolt's column
000000r 2               VFX_BEAM_CROSS      = 61        ; Drawn once, at the bolt's own cell
000000r 2               ARROW_UP            = 62        ; The title screen's controls (SPEC 13.1).
000000r 2               ARROW_DOWN          = 63        ;   Up and down live in group 7, left and
000000r 2               ARROW_LEFT          = 118       ;   right in group 14 — whichever white group
000000r 2               ARROW_RIGHT         = 119       ;   had a slot spare. Nothing indexes them.
000000r 2               
000000r 2               ; Group 14 is the prism's. Slots +0..+3 are its idle rotation and +4..+5 its
000000r 2               ; blip-out; there is no glow slot (SPEC A.3).
000000r 2               PRISM_SPIN          = WILD_BASE ; Four frames, WILD_BASE + 0..3
000000r 2               PRISM_SPIN_FRAMES   = 4
000000r 2               PRISM_BLIP          = WILD_BASE + 4     ; Two frames, then VFX_REMOVE2,
000000r 2                                                       ;   VFX_REMOVE1, FONT_DOT, empty
000000r 2               
000000r 2               ; Group 15 is the stone group: the petrified glyph set at the same offsets the
000000r 2               ; potions use, so a cell petrifies into its own shape —
000000r 2               ;
000000r 2               ;       petrified = PETRIFY_BASE + (tile & GLYPH_MASK)     for glyphs 0-4
000000r 2               ;
000000r 2               ; — and then the two tiles the margins are built from.
000000r 2               PETRIFY_BASE        = 120       ; +0 potion, +1 fireball, +2 bolt,
000000r 2                                               ;   +3 bomb, +4 star
000000r 2               TILE_RESERVED       = 125       ; Held for a sixth glyph, if one is ever added
000000r 2               TILE_SHELF          = 126       ; The shelf the panel stands on
000000r 2               TILE_BRICK          = 127       ; Brick — the margin fill
000000r 2               FRAME_DIM           = 8         ; Group 1 is group 0 byte for byte, one colour
000000r 2                                               ;   quieter, so frame_tile + FRAME_DIM is any
000000r 2                                               ;   frame piece's dim twin (SPEC A.3)
000000r 2               ART_BASE            = 128       ; Groups 16-31 — one hatch in sixteen colours,
000000r 2                                               ;   the title screen's magic field (SPEC 13.1)
000000r 2               ART_TILES           = 128
000000r 2               
000000r 2               ; --- Panel geometry (SPEC 12) ------------------------------------------------
000000r 2               ;   One 22 x 24 panel, rendered identically on all three machines. PANEL_Y is
000000r 2               ;   0 everywhere; only PANEL_X differs. The panel is vertically symmetric —
000000r 2               ;   backdrop row, band row, backdrop row, eighteen rows of frame, backdrop row,
000000r 2               ;   band row, backdrop row — which is why 24 is the height. The AC6502 is the
000000r 2               ;   exact fit; the VIC-20 clips panel row 23 off the bottom and the C64 has one
000000r 2               ;   spare screen row (24) below the panel. See SPEC 12.4.
000000r 2               PANEL_W             = 22
000000r 2               PANEL_H             = 24
000000r 2               
000000r 2               WELL_ORIGIN_X       = 1         ; Panel-relative: board (0,0) lives here
000000r 2               WELL_ORIGIN_Y       = 4
000000r 2               
000000r 2               SCORE_X             = 12        ; 7 digits, cols 12-18
000000r 2               SCORE_Y             = 5
000000r 2               HIGH_X              = 12        ; 7 digits, cols 12-18
000000r 2               HIGH_Y              = 10
000000r 2               HIGHLVL_X           = 15        ; Level the high score was set on, 2 digits;
000000r 2                                               ;   the 'L' at col 14 is in the static image
000000r 2               HIGHLVL_Y           = 11
000000r 2               LEVEL_X             = 18        ; Single column: tens above units
000000r 2               LEVEL_Y             = 17        ; Tens at LEVEL_Y, units at LEVEL_Y + 1
000000r 2               NEXT_X              = 11        ; Single tile column
000000r 2               NEXT_Y              = 16        ; Cells A, B, C at NEXT_Y, +1, +2
000000r 2               MSG_X               = 2         ; The band's OWNED cells. Panel columns 0-1 and
000000r 2               MSG_W               = 18        ;   20-21 of row 22 are shelf in the static
000000r 2               MSG_Y               = 22        ;   image and code never touches them; the
000000r 2                                               ;   banner still centres on the full PANEL_W,
000000r 2                                               ;   which lands in the same place for an
000000r 2                                               ;   even-length string (SPEC 12.2).
000000r 2               
000000r 2               SCORE_DIGITS        = 7         ; Always all 7 drawn, zero padded
000000r 2               LEVEL_DIGITS        = 2         ; Always zero padded — level 5 draws "0" / "5"
000000r 2               
000000r 2               ; --- Piece and timing (SPEC 5.6, 11.3, 14) -----------------------------------
000000r 2               ;   Every duration in the game is a frame count, and most of them differ
000000r 2               ;   between NTSC and PAL so that wall-clock speed matches. Those live in
000000r 2               ;   tables.inc as two-entry tables indexed by Region, not here — a constant
000000r 2               ;   that is not one number is not a constant. The ones below are the same on
000000r 2               ;   both machines.
000000r 2               LOCK_RESET_MAX      = 4         ; Horizontal moves that may reset the lock
000000r 2                                               ;   delay, per piece. Rotation never resets it.
000000r 2               FALL_FRAMES         = 2         ; Frames a row while the pile falls into the
000000r 2                                               ;   holes a clear left (SPEC 14). The one
000000r 2                                               ;   duration in the game that is the same on
000000r 2                                               ;   both regions, because SPEC 14 says so: at
000000r 2                                               ;   two frames there is nothing to round.
000000r 2               
000000r 2               ; --- Levels (SPEC 10) --------------------------------------------------------
000000r 2               LEVEL_TILES         = 30        ; Tiles cleared per level
000000r 2               LEVEL_SPEED_CAP     = 16        ; Speed stops improving here
000000r 2               LEVEL_MAX_SHOWN     = 99
000000r 2               
000000r 2               ; --- Scoring (SPEC 9) --------------------------------------------------------
000000r 2               BONUS_FIREBALL      = $0500     ; BCD
000000r 2               BONUS_BOLT          = $0300
000000r 2               BONUS_BOMB          = $0300
000000r 2               BONUS_PRISM         = $0400
000000r 2               BONUS_LEVELUP       = $1000
000000r 2               STAR_SHIFT_CAP      = 3         ; Three doublings — x8
000000r 2               HIGH_FLASH_BLINKS   = 6         ; Half-blinks of the HIGH field when the score
000000r 2                                               ;   overtakes it (SPEC 9.8) — three dark, three
000000r 2                                               ;   lit, ending lit. At SPEC 14's 30-frame
000000r 2                                               ;   blink period that is about a second and a
000000r 2                                               ;   half, and play never stops for it.
000000r 2               SCORE_BYTES         = 4         ; 8 nibbles packed BCD; the top one stays 0,
000000r 2                                               ;   so 7 digits show and the score wraps at
000000r 2                                               ;   10,000,000.
000000r 2               HIGH_INIT_LO        = $00       ; 0010000
000000r 2               HIGH_INIT_MID       = $00
000000r 2               HIGH_INIT_HI        = $01
000000r 2               HIGH_INIT_TOP       = $00
000000r 2               
000000r 2               ; --- Reagent probability, out of 256 (SPEC 5.3) ------------------------------
000000r 2               PSPECIAL_BANDS      = 5
000000r 2               
000000r 2               ; --- Input bitmask (SPEC 11.1) -----------------------------------------------
000000r 2               ;   Active HIGH. Each platform inverts and remaps its own hardware into this.
000000r 2               INPUT_UP            = %00000001 ; Rotate forward
000000r 2               INPUT_DOWN          = %00000010 ; Soft drop
000000r 2               INPUT_LEFT          = %00000100
000000r 2               INPUT_RIGHT         = %00001000
000000r 2               INPUT_FIRE          = %00010000 ; Rotate reverse / confirm
000000r 2               INPUT_PAUSE         = %00100000
000000r 2               INPUT_MASK          = %00111111 ; Everything the game reads. Bits 6-7 are free
000000r 2                                               ;   for a platform to use as scratch inside
000000r 2                                               ;   HalReadInput, as long as it strips them.
000000r 2               
000000r 2               ; --- Game states (SPEC 13) ---------------------------------------------------
000000r 2               STATE_TITLE         = 0
000000r 2               STATE_PLAY          = 1
000000r 2               STATE_PAUSE         = 2
000000r 2               STATE_GAMEOVER      = 3
000000r 2               
000000r 2               ; --- Play sub-states (SPEC 8) ------------------------------------------------
000000r 2               PLAY_FALLING        = 0
000000r 2               PLAY_LOCKING        = 1
000000r 2               PLAY_GLOW           = 2
000000r 2               PLAY_SHATTER        = 3
000000r 2               PLAY_GRAVITY        = 4
000000r 2               PLAY_ARE            = 5
000000r 2               
000000r 2               ; --- Buffer sizes (SPEC 17.1) ------------------------------------------------
000000r 2               MARKS_BYTES         = 16        ; One byte per row, bits 0-5
000000r 2               EFFECTQ_ENTRIES     = 48        ; 2 bytes each; drop on overflow
000000r 2               EFFECTQ_BYTES       = EFFECTQ_ENTRIES * 2
000000r 2               DIRTY_ENTRIES       = 64        ; 3 bytes each: offset lo, offset hi, tile
000000r 2               DIRTY_BYTES         = DIRTY_ENTRIES * 3
000000r 2               DIRTY_FLUSH_MAX     = 24        ; Cells pushed to the screen per frame.
000000r 2                                               ;   MEASURED, not estimated (PLAN.md S1). A
000000r 2                                               ;   flush costs 165 cycles a cell on the
000000r 2                                               ;   AC6502 and about 132 on the Commodores, so
000000r 2                                               ;   24 cells is 3965 cycles — inside vertical
000000r 2                                               ;   blank on all three, and tightest on the
000000r 2                                               ;   AC6502 at 1 MHz, whose 70 blank lines are
000000r 2                                               ;   roughly 4450. It is also a quarter of the
000000r 2                                               ;   96-cell well, so a full redraw is exactly
000000r 2                                               ;   four frames.
000000r 2                                               ;   Overrunning vblank is not dangerous on any
000000r 2                                               ;   of the three — no VRAM write spacing is
000000r 2                                               ;   anywhere near violated (S1) — it only
000000r 2                                               ;   risks a cell landing a frame late. This is
000000r 2                                               ;   a budget, not a hardware limit.
000000r 2               
000000r 1               .include "../src/zeropage.inc"
000000r 2               ; =============================================================================
000000r 2               ;   zeropage.inc — Wizards Lab, zero page allocation
000000r 2               ; =============================================================================
000000r 2               ;   The ZEROPAGE segment is placed at $40 on every platform. That window is
000000r 2               ;   free on all three:
000000r 2               ;
000000r 2               ;     AC6502   $003A-$00FF free for user programs (6502.inc memory map)
000000r 2               ;     VIC-20   all of page zero, once the cartridge stops calling the KERNAL
000000r 2               ;     C64      all of page zero EXCEPT $00/$01, which are the processor port
000000r 2               ;
000000r 2               ;   Starting at $40 clears the C64's port bytes and the AC6502's system
000000r 2               ;   scratch with room to spare, and keeps one number in three linker configs.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               .segment "ZEROPAGE"
000000r 2               
000000r 2  xx xx        Ptr1:           .res 2      ; General pointer — free across any call boundary
000002r 2  xx xx        Ptr2:           .res 2      ; General pointer
000004r 2  xx xx        SrcPtr:         .res 2      ; Block copy source
000006r 2  xx xx        DstPtr:         .res 2      ; Block copy destination
000008r 2  xx xx        ScreenPtr:      .res 2      ; Current screen row base
00000Ar 2  xx xx        ColorPtr:       .res 2      ; Current colour RAM row base (Commodore only)
00000Cr 2               
00000Cr 2  xx           RngLo:          .res 1      ; 16-bit LFSR state — never both zero
00000Dr 2  xx           RngHi:          .res 1
00000Er 2               
00000Er 2  xx           Tmp0:           .res 1      ; Scratch. Never live across a JSR.
00000Fr 2  xx           Tmp1:           .res 1
000010r 2  xx           Tmp2:           .res 1
000011r 2  xx           Tmp3:           .res 1
000012r 2               
000012r 2               ; --- The match scanner (SPEC 6.2) --------------------------------------------
000012r 2               ;   One line of one pass at a time. The cursor is a BOARD INDEX rather than a
000012r 2               ;   row and a column, because all four passes are the same walk with a
000012r 2               ;   different step: +1 horizontal, +8 vertical, +9 diagonal, +7 anti-diagonal.
000012r 2  xx           ScanIdx:        .res 1      ; Where the cursor was when a run ended: ScanLine
000013r 2                                           ;   keeps it in X and spills it only here
000013r 2  xx           ScanStep:       .res 1      ; What to add to reach the next cell of this line
000014r 2  xx           ScanColor:      .res 1      ; Colour key of the run in progress ($FF = unset)
000015r 2  xx           ScanLen:        .res 1      ; Cells in it so far, wildcards included
000016r 2  xx           ScanEnd:        .res 1      ; Walk-back cursor while a finished run is marked
000017r 2  xx           ScanTop:        .res 1      ; Row base of the top of the pile. Every pass
000018r 2                                           ;   starts there rather than at row 0, which is
000018r 2                                           ;   most of the cost of a scan (match.asm)
000018r 2               
000018r 2               ; --- Board walks that call the renderer (SPEC 8 steps 6 and 8) ---------------
000018r 2               ;   RenderCell clobbers A, X and Y, so a walk that marks what it changes
000018r 2               ;   cannot keep its cursor in a register. GravIdx also has to survive from one
000018r 2               ;   frame to the next: a row of falling is a cursor and not a bulk enqueue,
000018r 2               ;   because a full well is more cells than the dirty ring holds (D12,
000018r 2               ;   SPEC 12.6).
000018r 2  xx           GravIdx:        .res 1      ; Cell the fall is walking up from, $FF when the
000019r 2                                           ;   row is finished
000019r 2  xx           GravMoved:      .res 1      ; Non-zero if this row of falling moved anything
00001Ar 2  xx           CellCount:      .res 1      ; Cells CascadeRemove has taken off the board
00001Br 2               
00001Br 2               ; --- Render and text scratch -------------------------------------------------
00001Br 2               ;   These ARE live across a JSR, unlike Tmp0-Tmp3, because text.asm calls
00001Br 2               ;   RenderMark once per cell and has to remember where it is. That is safe
00001Br 2               ;   only because RenderMark touches nothing here: it clobbers A, X and the
00001Br 2               ;   stack and nothing else (see render.asm). Do not call anything else from a
00001Br 2               ;   loop that holds one of these.
00001Br 2  xx           TextCol:        .res 1      ; Panel column the next glyph goes in
00001Cr 2  xx           TextRow:        .res 1      ; Panel row the string is drawn on
00001Dr 2  xx           TextIdx:        .res 1      ; Cursor within the string, or the BCD byte index
00001Er 2  xx           TextByte:       .res 1      ; The BCD byte being split into two digits
00001Fr 2  xx           TextSkip:       .res 1      ; Non-zero while the first high nibble is skipped
000020r 2  xx           FlushLeft:      .res 1      ; Cells left in this frame's flush budget
000021r 2  xx           RedrawCol:      .res 1      ; Panel column of the cell being marked. Shared by
000022r 2                                           ;   every routine that marks a run of cells in one
000022r 2                                           ;   column, because RenderMark clobbers X.
000022r 2               
000022r 1               .include "../src/ram.inc"
000022r 2               ; =============================================================================
000022r 2               ;   ram.inc — Wizards Lab, work RAM
000022r 2               ; =============================================================================
000022r 2               ;   SPEC.md section 17.1. Around 530 bytes, which is what lets the whole game
000022r 2               ;   fit the VIC-20's 1 KB of usable work RAM — the tightest of the three
000022r 2               ;   targets, and therefore the one the layout is designed against.
000022r 2               ;
000022r 2               ;   Every platform places the BSS segment somewhere different (see each
000022r 2               ;   linker config); nothing in this file cares where.
000022r 2               ; =============================================================================
000022r 2               
000022r 2               .segment "BSS"
000000r 2               
000000r 2               ; --- The board (SPEC 3.2) ----------------------------------------------------
000000r 2               ;   20 rows x 8 stride. Columns 6-7 of every row and rows 16-19 entirely are
000000r 2               ;   permanent $FF sentinels, so scans walk off the edge and stop by themselves.
000000r 2               ;   Page-align it: address(row,col) = Board + (row << 3) + col.
000000r 2               .align 256
000000r 2  xx xx xx xx  Board:          .res BOARD_BYTES
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
0000A0r 2               
0000A0r 2               ; --- Match / cascade state (SPEC 6.2, 8) -------------------------------------
0000A0r 2  xx xx xx xx  Marks:          .res MARKS_BYTES        ; One byte per row, bits 0-5 = columns
0000A4r 2  xx xx xx xx  
0000A8r 2  xx xx xx xx  
0000B0r 2  xx xx xx xx  EffectQ:        .res EFFECTQ_BYTES      ; Ring of pending reagent detonations
0000B4r 2  xx xx xx xx  
0000B8r 2  xx xx xx xx  
000110r 2  xx           EffectQHead:    .res 1
000111r 2  xx           EffectQTail:    .res 1
000112r 2  xx           RunCount:       .res 1                  ; Runs resolved in the current step
000113r 2  xx           ChainStep:      .res 1                  ; 1 on the first step of a cascade
000114r 2  xx           StarCount:      .res 1                  ; Doublings pending, capped at 3
000115r 2  xx           CascadeLo:      .res 1                  ; Cascade point accumulator, packed BCD
000116r 2  xx           CascadeMid:     .res 1
000117r 2  xx           CascadeHi:      .res 1
000118r 2               
000118r 2               ; --- Render (SPEC 12.6) ------------------------------------------------------
000118r 2               ;   A ring of DIRTY_ENTRIES cells waiting to be pushed to the screen, three
000118r 2               ;   bytes each: SCREEN column, SCREEN row, tile. Not a 16-bit screen offset —
000118r 2               ;   HalPlotCell takes a column and a row (hal.inc), and every platform reaches
000118r 2               ;   a cell through a per-row pointer table (SPEC 12.3), so an offset would only
000118r 2               ;   have to be taken apart again at the far end.
000118r 2               ;
000118r 2               ;   A ring rather than a list with a resume index, because a frame that flushes
000118r 2               ;   its cap leaves a remainder and the next frame's marks have to go somewhere.
000118r 2               ;   Head and tail are BYTE offsets into Dirty, not entry numbers, so stepping
000118r 2               ;   one entry is an add of 3 and never a multiply.
000118r 2  xx xx xx xx  Dirty:          .res DIRTY_BYTES        ; screen col, screen row, tile
00011Cr 2  xx xx xx xx  
000120r 2  xx xx xx xx  
0001D8r 2  xx           DirtyCount:     .res 1                  ; Entries pending, 0..DIRTY_ENTRIES
0001D9r 2  xx           DirtyHead:      .res 1                  ; Byte offset of the oldest pending
0001DAr 2  xx           DirtyTail:      .res 1                  ; Byte offset the next mark goes to
0001DBr 2  xx           RedrawIdx:      .res 1                  ; Board index RenderBoardStep resumes
0001DCr 2                                                       ;   at, or $FF when no redraw is
0001DCr 2                                                       ;   outstanding
0001DCr 2               
0001DCr 2               ; --- The falling piece (SPEC 5) ----------------------------------------------
0001DCr 2  xx           PieceCol:       .res 1
0001DDr 2  xx           PieceRow:       .res 1                  ; Row of cell A (the top cell)
0001DEr 2  xx           PieceA:         .res 1                  ; Tile bytes, top to bottom
0001DFr 2  xx           PieceB:         .res 1
0001E0r 2  xx           PieceC:         .res 1
0001E1r 2  xx           NextA:          .res 1                  ; The preview piece
0001E2r 2  xx           NextB:          .res 1
0001E3r 2  xx           NextC:          .res 1
0001E4r 2  xx           PieceDirty:     .res 1                  ; Non-zero when the three cells need
0001E5r 2                                                       ;   drawing. Not drawn on the spot,
0001E5r 2                                                       ;   because a full-board redraw may be
0001E5r 2                                                       ;   in flight and would paint over
0001E5r 2                                                       ;   them — see StatePlay (D14).
0001E5r 2               
0001E5r 2               ; --- Progress (SPEC 9, 10) ---------------------------------------------------
0001E5r 2  xx           ScoreLo:        .res 1                  ; 7 digits packed BCD, low byte first;
0001E6r 2  xx           ScoreMid:       .res 1                  ;   the top nibble of ScoreTop stays 0
0001E7r 2  xx           ScoreHi:        .res 1
0001E8r 2  xx           ScoreTop:       .res 1
0001E9r 2  xx           HighLo:         .res 1
0001EAr 2  xx           HighMid:        .res 1
0001EBr 2  xx           HighHi:         .res 1
0001ECr 2  xx           HighTop:        .res 1
0001EDr 2  xx           HighLevel:      .res 1                  ; Level the high score was set on, BCD
0001EEr 2  xx           HighOwned:      .res 1                  ; Non-zero once THIS game has taken the
0001EFr 2                                                       ;   high score. From the overtake on,
0001EFr 2                                                       ;   score and high score are equal and
0001EFr 2                                                       ;   every bank copies again, so without
0001EFr 2                                                       ;   this the one-shot fanfare and flash
0001EFr 2                                                       ;   would fire on every one (SPEC 9.8)
0001EFr 2  xx           HighFlash:      .res 1                  ; Half-blinks of the HIGH field left to
0001F0r 2                                                       ;   run. Odd = dark, even = lit, and it
0001F0r 2                                                       ;   ends at zero, so the field is always
0001F0r 2                                                       ;   left readable
0001F0r 2  xx           HighTimer:      .res 1                  ; Frames until the next half-blink
0001F1r 2  xx           Level:          .res 1                  ; Binary, 1-99
0001F2r 2  xx           TilesCleared:   .res 1                  ; Toward the next level, carries past 30
0001F3r 2               
0001F3r 2               ; --- Timers, all in frames (SPEC 14) -----------------------------------------
0001F3r 2  xx           GravityTimer:   .res 1
0001F4r 2  xx           LockTimer:      .res 1
0001F5r 2  xx           LockResets:     .res 1
0001F6r 2  xx           DasTimer:       .res 1
0001F7r 2  xx           DasDir:         .res 1
0001F8r 2  xx           AreTimer:       .res 1
0001F9r 2  xx           AnimTimer:      .res 1
0001FAr 2  xx           BannerTimer:    .res 1
0001FBr 2  xx           FrameCounter:   .res 1                  ; Free-running from power-on; seeds RNG
0001FCr 2               
0001FCr 2               ; --- Input (SPEC 11.1) -------------------------------------------------------
0001FCr 2  xx           InputNow:       .res 1
0001FDr 2  xx           InputPrev:      .res 1
0001FEr 2  xx           InputEdge:      .res 1                  ; Newly pressed this frame
0001FFr 2               
0001FFr 2               ; --- State machine (SPEC 13) -------------------------------------------------
0001FFr 2  xx           GameState:      .res 1                  ; STATE_*
000200r 2  xx           PlayState:      .res 1                  ; PLAY_*
000201r 2  xx           TitlePage:      .res 1
000202r 2  xx           Region:         .res 1                  ; 0 = NTSC, 1 = PAL
000203r 2  xx           NeedsRedraw:    .res 1
000204r 2               
000204r 2               ; --- Audio (SPEC 16) ---------------------------------------------------------
000204r 2  xx           SfxRequest:     .res 1                  ; Written by logic, consumed by AudioTick
000205r 2  xx           SfxTimer:       .res 1
000206r 2  xx xx xx xx  SfxState:       .res 14
00020Ar 2  xx xx xx xx  
00020Er 2  xx xx xx xx  
000214r 2               
000214r 1               .include "../src/hal.inc"
000214r 2               ; =============================================================================
000214r 2               ;   hal.inc — Wizards Lab, the platform contract
000214r 2               ; =============================================================================
000214r 2               ;   Everything in src/ is shared, unmodified, by all three machines. The only
000214r 2               ;   things that differ are collected here: each platform's WizardsLab.asm must
000214r 2               ;   define these constants and implement these seven routines, and nothing
000214r 2               ;   else in src/ may touch hardware directly.
000214r 2               ;
000214r 2               ;   This file declares nothing. It is the documentation for the boundary, kept
000214r 2               ;   next to the code it constrains so it cannot drift out of date unnoticed.
000214r 2               ;
000214r 2               ;   CONSTANTS the platform must define BEFORE including the shared sources
000214r 2               ;   ---------------------------------------------------------------------
000214r 2               ;     PANEL_X, PANEL_Y      Where the 22 x 24 panel sits on this screen.
000214r 2               ;                             AC6502  5, 0      VIC-20  0, 0      C64  9, 0
000214r 2               ;                           PANEL_Y is 0 everywhere; the VIC-20 clips panel
000214r 2               ;                           row 23 and the C64 has one spare row below it.
000214r 2               ;     SCR_COLS           32 / 22 / 40
000214r 2               ;     SCR_ROWS           24 / 23 / 25
000214r 2               ;     HAS_COLOR_RAM         1 on the Commodores, 0 on the AC6502, whose colour
000214r 2               ;                           lives in the VDP colour table instead.
000214r 2               ;
000214r 2               ;   ROUTINES the platform must implement
000214r 2               ;   ------------------------------------
000214r 2               ;     HalInitVideo      Bring up the video hardware: black background and
000214r 2               ;                       border, the correct text/tile mode, tileset in place,
000214r 2               ;                       colours configured, screen cleared. Called once.
000214r 2               ;                       In:  nothing        Out: nothing
000214r 2               ;
000214r 2               ;     HalWaitFrame      Block until the start of the next vertical blank.
000214r 2               ;                       Everything below is called only between frames.
000214r 2               ;                       In:  nothing        Out: nothing
000214r 2               ;
000214r 2               ;     HalPlotCell       Write one cell, colour included where the platform has
000214r 2               ;                       per-cell colour.
000214r 2               ;                       In:  A = tile, X = screen column, Y = screen row
000214r 2               ;                       Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
000214r 2               ;
000214r 2               ;     HalBlitScreen     Draw a whole static screen from a name-table image in
000214r 2               ;                       ROM: SCR_COLS * SCR_ROWS bytes, row-major, plus
000214r 2               ;                       the matching colour image where the platform needs one.
000214r 2               ;                       In:  SrcPtr -> name table, Ptr1 -> colour table
000214r 2               ;                       Out: nothing
000214r 2               ;
000214r 2               ;     HalReadInput      Read stick and keyboard, fold both into one mask.
000214r 2               ;                       In:  nothing
000214r 2               ;                       Out: A = INPUT_* bits, ACTIVE HIGH
000214r 2               ;
000214r 2               ;     HalDetectRegion   Decide NTSC or PAL so the timing tables can be picked.
000214r 2               ;                       In:  nothing        Out: A = 0 NTSC, 1 PAL
000214r 2               ;
000214r 2               ;     HalSfx            Start a sound effect. May be a bare RTS until audio
000214r 2               ;                       exists.
000214r 2               ;                       In:  A = effect id (SPEC 16)
000214r 2               ;                       Out: nothing
000214r 2               ;
000214r 2               ;   The shared code assumes nothing about interrupts. Each platform may drive
000214r 2               ;   HalWaitFrame from a raster IRQ, a timer, or a status-register poll.
000214r 2               ; =============================================================================
000214r 2               
000214r 1               
000214r 1               ; =============================================================================
000214r 1               ;   Cartridge header — BLK5, $A000
000214r 1               ; =============================================================================
000214r 1               
000214r 1               .segment "CARTHDR"
000000r 1               
000000r 1  rr rr        .addr ColdStart                 ; Cold start vector
000002r 1  rr rr        .addr ColdStart                 ; Warm start vector (RESTORE = full restart)
000004r 1  41 30 C3 C2  .byte $41, $30, $C3, $C2, $CD   ; "A0CBM" autostart signature
000008r 1  CD           
000009r 1               
000009r 1               ; =============================================================================
000009r 1               ;   Entry
000009r 1               ; =============================================================================
000009r 1               
000009r 1               .segment "CODE"
000000r 1               
000000r 1               ColdStart:
000000r 1  78             sei
000001r 1  D8             cld
000002r 1  A2 FF          ldx #$FF
000004r 1  9A             txs                           ; Nothing did this for us
000005r 1               
000005r 1  20 rr rr       jsr GameInit                  ; Never returns
000008r 1               
000008r 1               ; --- Shared game code --------------------------------------------------------
000008r 1               .include "../src/main.asm"
000008r 2               ; =============================================================================
000008r 2               ;   main.asm — Wizards Lab, shared entry point and main loop
000008r 2               ; =============================================================================
000008r 2               ;   Included by every platform's WizardsLab.asm after that file has defined
000008r 2               ;   PANEL_X / PANEL_Y and its half of the HAL (see hal.inc). Nothing below
000008r 2               ;   touches hardware.
000008r 2               ;
000008r 2               ;   BUILD STATUS
000008r 2               ;   ------------
000008r 2               ;   Pieces spawn, steer, rotate, fall and lock, runs of three or more clear,
000008r 2               ;   the pile falls into the holes, chains keep going until nothing matches, and
000008r 2               ;   all of it scores and ramps the level (PLAN.md P2, P3, P4). The clear is
000008r 2               ;   still instant: GLOW and SHATTER are P6's, and slot into CascadeEnter
000008r 2               ;   between the scan and the fall.
000008r 2               ; =============================================================================
000008r 2               
000008r 2               ; -----------------------------------------------------------------------------
000008r 2               ;   GameInit — one-time setup, called from the cartridge entry point
000008r 2               ; -----------------------------------------------------------------------------
000008r 2               GameInit:
000008r 2  20 rr rr       jsr HalDetectRegion
00000Br 2  8D rr rr       sta Region
00000Er 2               
00000Er 2  20 rr rr       jsr HalInitVideo              ; Tiles in place, screen black and cleared
000011r 2  20 rr rr       jsr AudioInit
000014r 2  20 rr rr       jsr RenderDirtyReset
000017r 2               
000017r 2  A9 00          lda #0
000019r 2  8D rr rr       sta FrameCounter
00001Cr 2  20 rr rr       jsr RngSeed                   ; A zero LFSR state sticks at zero forever, and
00001Fr 2                                               ;   BSS is not cleared on all three machines, so
00001Fr 2                                               ;   seed it once here just to get it out of that
00001Fr 2                                               ;   hole. This is NOT the game's seed — SPEC 15
00001Fr 2                                               ;   forbids a constant one, and StateTitle
00001Fr 2                                               ;   reseeds from the player's reaction time
00001Fr 2                                               ;   before the first piece is ever rolled.
00001Fr 2  A9 00          lda #0
000021r 2  8D rr rr       sta InputNow
000024r 2  8D rr rr       sta InputPrev
000027r 2  8D rr rr       sta InputEdge
00002Ar 2  8D rr rr       sta TitlePage
00002Dr 2               
00002Dr 2  20 rr rr       jsr ScoreHighInit             ; Once a session, before the first ScoreReset
000030r 2  20 rr rr       jsr ScoreReset
000033r 2  20 rr rr       jsr BoardClear
000036r 2               
000036r 2               .ifdef WL_DEBUG
000036r 2  20 rr rr       jsr GameStart                 ; TEMPORARY: skip the title and start playing,
000039r 2                                               ;   because a headless machine has no input
000039r 2                                               ;   attached and would sit on the title screen
000039r 2                                               ;   forever. Nothing else about the build
000039r 2                                               ;   differs any more (PLAN.md section 3).
000039r 2               .else
000039r 2                 lda #STATE_TITLE
000039r 2                 sta GameState
000039r 2                 lda #1
000039r 2                 sta NeedsRedraw
000039r 2               .endif
000039r 2                 ; falls through into GameLoop
000039r 2               
000039r 2               ; -----------------------------------------------------------------------------
000039r 2               ;   GameLoop — never returns
000039r 2               ; -----------------------------------------------------------------------------
000039r 2               GameLoop:
000039r 2  20 rr rr       jsr HalWaitFrame
00003Cr 2  EE rr rr       inc FrameCounter              ; Free-running from power-on; seeds the RNG
00003Fr 2               
00003Fr 2  20 rr rr       jsr RenderFlush               ; Screen writes happen in vertical blank only
000042r 2  20 rr rr       jsr InputPoll
000045r 2               
000045r 2  AD rr rr       lda GameState                 ; Dispatch on the current screen state
000048r 2  C9 00          cmp #STATE_TITLE
00004Ar 2  F0 0B          beq @Title
00004Cr 2  C9 01          cmp #STATE_PLAY
00004Er 2  F0 0D          beq @Play
000050r 2  C9 02          cmp #STATE_PAUSE
000052r 2  F0 0F          beq @Pause
000054r 2  4C rr rr       jmp StateGameOver
000057r 2               
000057r 2               @Title:
000057r 2  20 rr rr       jsr StateTitle
00005Ar 2  4C rr rr       jmp @Audio
00005Dr 2               @Play:
00005Dr 2  20 rr rr       jsr StatePlay
000060r 2  4C rr rr       jmp @Audio
000063r 2               @Pause:
000063r 2  20 rr rr       jsr StatePause
000066r 2               
000066r 2               @Audio:
000066r 2  20 rr rr       jsr AudioTick
000069r 2  4C rr rr       jmp GameLoop
00006Cr 2               
00006Cr 2               ; =============================================================================
00006Cr 2               ;   States (SPEC 13)
00006Cr 2               ; =============================================================================
00006Cr 2               
00006Cr 2               ; -----------------------------------------------------------------------------
00006Cr 2               ;   StateTitle — blinking prompt over the drawn screen, and the magic field
00006Cr 2               ;   SPEC 13.1. There are no help pages: the controls are part of the screen
00006Cr 2               ;   image, so the only things moving here are the prompt and the field.
00006Cr 2               ; -----------------------------------------------------------------------------
00006Cr 2               StateTitle:
00006Cr 2  AD rr rr       lda NeedsRedraw
00006Fr 2  F0 0B          beq @Live
000071r 2  A9 00          lda #0
000073r 2  8D rr rr       sta NeedsRedraw
000076r 2  20 rr rr       jsr DrawTitleScreen
000079r 2  20 rr rr       jsr RenderDirtyReset          ; A full blit went behind the renderer's back
00007Cr 2               
00007Cr 2               @Live:
00007Cr 2                 ; TODO: blink the prompt every 30 frames, and shimmer the magic field —
00007Cr 2                 ; one NextRandom for a cell in the 14 x 2 block, one for a tile in
00007Cr 2                 ; ART_BASE..ART_BASE+ART_TILES-1, one RenderMark.
00007Cr 2  AD rr rr       lda InputEdge
00007Fr 2  29 11          and #(INPUT_FIRE | INPUT_UP)  ; Fire, or SPACE, which the keyboards fold
000081r 2  F0 06          beq @Done                     ;   into UP so it can rotate in play (D15)
000083r 2               
000083r 2  20 rr rr       jsr RngSeed                   ; SPEC 15 — seed from reaction time, not a constant
000086r 2  20 rr rr       jsr GameStart
000089r 2               @Done:
000089r 2  60             rts
00008Ar 2               
00008Ar 2               ; -----------------------------------------------------------------------------
00008Ar 2               ;   GameStart — enter play from the title screen
00008Ar 2               ; -----------------------------------------------------------------------------
00008Ar 2               GameStart:
00008Ar 2  20 rr rr       jsr ScoreReset
00008Dr 2  20 rr rr       jsr BoardClear
000090r 2               
000090r 2  A9 01          lda #1
000092r 2  8D rr rr       sta Level
000095r 2  A9 00          lda #0
000097r 2  8D rr rr       sta TilesCleared
00009Ar 2  8D rr rr       sta DasDir                    ; No direction is held into a new game
00009Dr 2  8D rr rr       sta DasTimer
0000A0r 2  8D rr rr       sta PieceDirty
0000A3r 2               
0000A3r 2  20 rr rr       jsr DrawPlayScreen            ; The whole screen at once, behind the
0000A6r 2  20 rr rr       jsr RenderDirtyReset          ;   renderer's back — so drop anything queued
0000A9r 2                                               ;   against the screen that just went away
0000A9r 2               
0000A9r 2  20 rr rr       jsr TextBannerClear           ; The play image ships with the band reading
0000ACr 2                                               ;   `~~ PAUSED ~~` (SPEC 12.1); play owns it
0000ACr 2  20 rr rr       jsr RenderScore               ; The panel fields are code's, not the image's
0000AFr 2  20 rr rr       jsr RenderHigh
0000B2r 2  20 rr rr       jsr RenderLevel
0000B5r 2  20 rr rr       jsr RenderBoard               ; Queued across as many frames as it takes
0000B8r 2               
0000B8r 2  20 rr rr       jsr PieceGenerateNext         ; Fill the preview...
0000BBr 2  20 rr rr       jsr PieceSpawn                ; ...then promote it and refill. The board is
0000BEr 2  20 rr rr       jsr PieceGenerateNext         ;   empty, so the spawn cannot be blocked.
0000C1r 2  20 rr rr       jsr RenderNext
0000C4r 2               
0000C4r 2  A9 00          lda #PLAY_FALLING
0000C6r 2  8D rr rr       sta PlayState
0000C9r 2  A9 01          lda #STATE_PLAY
0000CBr 2  8D rr rr       sta GameState
0000CEr 2  60             rts
0000CFr 2               
0000CFr 2               ; -----------------------------------------------------------------------------
0000CFr 2               ;   StatePlay — the game
0000CFr 2               ;   SPEC 13.2. One frame is: advance whatever the play sub-state is doing,
0000CFr 2               ;   then queue whatever changed. Cascades run as sub-states rather than in a
0000CFr 2               ;   blocking loop so animation stays on the frame clock.
0000CFr 2               ; -----------------------------------------------------------------------------
0000CFr 2               StatePlay:
0000CFr 2  20 rr rr       jsr ScoreFlashTick            ; SPEC 9.8 — the HIGH field blinking after an
0000D2r 2                                               ;   overtake. Play never stops for it, so it
0000D2r 2                                               ;   ticks alongside whatever the sub-state is
0000D2r 2                                               ;   doing rather than inside one.
0000D2r 2  AD rr rr       lda InputEdge
0000D5r 2  29 20          and #INPUT_PAUSE
0000D7r 2  D0 3E          bne @ToPause
0000D9r 2               
0000D9r 2  AD rr rr       lda PlayState
0000DCr 2  C9 00          cmp #PLAY_FALLING
0000DEr 2  F0 0F          beq @Falling
0000E0r 2  C9 01          cmp #PLAY_LOCKING
0000E2r 2  F0 11          beq @Locking
0000E4r 2  C9 04          cmp #PLAY_GRAVITY
0000E6r 2  F0 13          beq @Gravity
0000E8r 2  C9 05          cmp #PLAY_ARE
0000EAr 2  F0 15          beq @Are
0000ECr 2  4C rr rr       jmp @Draw                     ; GLOW and SHATTER are P6's
0000EFr 2               
0000EFr 2               @Falling:
0000EFr 2  20 rr rr       jsr PlayFalling
0000F2r 2  4C rr rr       jmp @Draw
0000F5r 2               @Locking:
0000F5r 2  20 rr rr       jsr PlayLocking
0000F8r 2  4C rr rr       jmp @Draw
0000FBr 2               @Gravity:
0000FBr 2  20 rr rr       jsr PlayGravity
0000FEr 2  4C rr rr       jmp @Draw
000101r 2               @Are:
000101r 2  20 rr rr       jsr PlayAre
000104r 2               
000104r 2                 ; --- draw the piece, once whatever else wanted the screen has finished ----
000104r 2                 ;   D14. RenderBoard is a cursor that feeds the ring over several frames
000104r 2                 ;   (D12), so marks made while one is outstanding are drawn BEFORE the
000104r 2                 ;   redraw reaches those cells and are then painted over. Holding the piece
000104r 2                 ;   back until the redraw has finished is one byte and always right; the
000104r 2                 ;   alternative is a piece that vanishes for four frames after every pause.
000104r 2               @Draw:
000104r 2  AD rr rr       lda PieceDirty
000107r 2  F0 0D          beq @Done
000109r 2  AD rr rr       lda RedrawIdx
00010Cr 2  10 08          bpl @Done                     ; A board redraw is still in flight
00010Er 2  A9 00          lda #0
000110r 2  8D rr rr       sta PieceDirty
000113r 2  20 rr rr       jsr RenderPiece
000116r 2               @Done:
000116r 2  60             rts
000117r 2               
000117r 2               @ToPause:
000117r 2  A9 02          lda #STATE_PAUSE
000119r 2  8D rr rr       sta GameState
00011Cr 2                 ; TODO (P7): wash the well with TILE_WASH so a pause cannot be used to study
00011Cr 2                 ; the board (13.3). A wash, not a blank — a blanked well reads as crashed.
00011Cr 2  60             rts
00011Dr 2               
00011Dr 2               ; -----------------------------------------------------------------------------
00011Dr 2               ;   PlayFalling — steer the piece, and drop it a row when the timer runs out
00011Dr 2               ;   SPEC 5.5, 5.6, 11.3
00011Dr 2               ; -----------------------------------------------------------------------------
00011Dr 2               PlayFalling:
00011Dr 2  20 rr rr       jsr PieceControl              ; Rotation and DAS; the result is ignored here
000120r 2                                               ;   because there is no lock delay to reset yet
000120r 2  20 rr rr       jsr PieceFallRate
000123r 2  85 rr          sta Tmp0
000125r 2  AD rr rr       lda GravityTimer              ; Pressing DOWN mid-wait must shorten the wait
000128r 2  C5 rr          cmp Tmp0                      ;   in progress, not just the next one
00012Ar 2  90 05          bcc @Tick
00012Cr 2  A5 rr          lda Tmp0
00012Er 2  8D rr rr       sta GravityTimer
000131r 2               @Tick:
000131r 2  CE rr rr       dec GravityTimer
000134r 2  D0 1E          bne @Done
000136r 2  20 rr rr       jsr PieceStep
000139r 2  B0 0B          bcs @Land
00013Br 2  20 rr rr       jsr PieceFallRate             ; ...and C tells us whose rate the row that
00013Er 2  8D rr rr       sta GravityTimer              ;   just fell used. STA leaves it alone.
000141r 2  B0 11          bcs @Done
000143r 2  4C rr rr       jmp ScoreSoftDrop             ; SPEC 9.6 — one point, one row
000146r 2               
000146r 2               @Land:
000146r 2  AE rr rr       ldx Region
000149r 2  BD rr rr       lda LockDelay,x
00014Cr 2  8D rr rr       sta LockTimer
00014Fr 2  A9 01          lda #PLAY_LOCKING
000151r 2  8D rr rr       sta PlayState
000154r 2               @Done:
000154r 2  60             rts
000155r 2               
000155r 2               ; -----------------------------------------------------------------------------
000155r 2               ;   PlayLocking — the lock delay, and the moves that may reset it
000155r 2               ;   SPEC 5.6 — a horizontal move resets the delay LOCK_RESET_MAX times; after
000155r 2               ;   that it runs out regardless. Rotation never resets it. A move that opens a
000155r 2               ;   gap underneath resumes falling, and the reset count carries.
000155r 2               ; -----------------------------------------------------------------------------
000155r 2               PlayLocking:
000155r 2  20 rr rr       jsr PieceControl
000158r 2  90 13          bcc @Settled
00015Ar 2  AD rr rr       lda LockResets
00015Dr 2  C9 04          cmp #LOCK_RESET_MAX
00015Fr 2  B0 0C          bcs @Settled
000161r 2  EE rr rr       inc LockResets
000164r 2  AE rr rr       ldx Region
000167r 2  BD rr rr       lda LockDelay,x
00016Ar 2  8D rr rr       sta LockTimer
00016Dr 2               
00016Dr 2               @Settled:
00016Dr 2  20 rr rr       jsr PieceCanFall
000170r 2  90 0C          bcc @Tick
000172r 2  A9 00          lda #PLAY_FALLING             ; It moved over a hole — fall again. SPEC 5.6
000174r 2  8D rr rr       sta PlayState                 ;   says the lock counter clears here and the
000177r 2                                               ;   reset count does not; nothing reads
000177r 2                                               ;   LockTimer while falling and the next
000177r 2                                               ;   landing loads it fresh, so it is already
000177r 2                                               ;   clear in every sense that matters.
000177r 2  20 rr rr       jsr PieceFallRate
00017Ar 2  8D rr rr       sta GravityTimer
00017Dr 2  60             rts
00017Er 2               
00017Er 2               @Tick:
00017Er 2  CE rr rr       dec LockTimer
000181r 2  D0 09          bne @Done
000183r 2  20 rr rr       jsr PieceLock
000186r 2  20 rr rr       jsr CascadeBegin              ; SPEC 8 — the cascade starts the moment the
000189r 2  4C rr rr       jmp CascadeEnter              ;   piece is board, and runs as sub-states
00018Cr 2               @Done:
00018Cr 2  60             rts
00018Dr 2               
00018Dr 2               ; -----------------------------------------------------------------------------
00018Dr 2               ;   CascadeEnter — run one cascade step and choose the sub-state after it
00018Dr 2               ;   In:  ChainStep set        Out: PlayState set.  Modifies: A, X, Y
00018Dr 2               ;   SPEC 8, D4. Called from the lock, and again from the bottom of every fall.
00018Dr 2               ;
00018Dr 2               ;   A step that clears something hands over to PLAY_GRAVITY; a step that finds
00018Dr 2               ;   nothing is where the cascade settles and the next piece is queued. P6
00018Dr 2               ;   inserts PLAY_GLOW and PLAY_SHATTER ahead of the fall without changing
00018Dr 2               ;   either branch.
00018Dr 2               ; -----------------------------------------------------------------------------
00018Dr 2               CascadeEnter:
00018Dr 2  20 rr rr       jsr CascadeStep
000190r 2  90 09          bcc @Settle
000192r 2               
000192r 2  20 rr rr       jsr BoardGravityBegin         ; Something went; let what was above it fall
000195r 2  A9 04          lda #PLAY_GRAVITY
000197r 2  8D rr rr       sta PlayState
00019Ar 2  60             rts
00019Br 2               
00019Br 2               @Settle:
00019Br 2  20 rr rr       jsr CascadeSettle             ; The star multiplier and the bank (SPEC 8
00019Er 2                                               ;   SETTLE); P6 raises the chain banner
00019Er 2  AE rr rr       ldx Region
0001A1r 2  BD rr rr       lda AreDelay,x
0001A4r 2  8D rr rr       sta AreTimer
0001A7r 2  A9 05          lda #PLAY_ARE
0001A9r 2  8D rr rr       sta PlayState
0001ACr 2  60             rts
0001ADr 2               
0001ADr 2               ; -----------------------------------------------------------------------------
0001ADr 2               ;   PlayGravity — the pile falls into the holes the clear left
0001ADr 2               ;   SPEC 8 step 8, SPEC 14 — a row every FALL_FRAMES, and when a row moves
0001ADr 2               ;   nothing the board has settled and the next step scans it.
0001ADr 2               ;
0001ADr 2               ;   The row itself may take more than one frame: BoardGravityStep is a cursor
0001ADr 2               ;   that stops when the dirty ring is full (board.asm). The beat only starts
0001ADr 2               ;   once the row has actually landed, so a heavy board falls a little slower
0001ADr 2               ;   rather than losing cells off the screen.
0001ADr 2               ; -----------------------------------------------------------------------------
0001ADr 2               PlayGravity:
0001ADr 2  A5 rr          lda GravIdx
0001AFr 2  10 0C          bpl @Working                  ; A row is still coming down
0001B1r 2               
0001B1r 2  CE rr rr       dec AnimTimer
0001B4r 2  D0 11          bne @Done
0001B6r 2  A5 rr          lda GravMoved
0001B8r 2  F0 0E          beq @Landed                   ; The last row moved nothing: everything is
0001BAr 2  20 rr rr       jsr BoardGravityBegin         ;   resting on something
0001BDr 2               
0001BDr 2               @Working:
0001BDr 2  20 rr rr       jsr BoardGravityStep
0001C0r 2  90 05          bcc @Done                     ; The ring filled — the rest waits for a flush
0001C2r 2  A9 02          lda #FALL_FRAMES              ; The row is down; hold it there for the beat
0001C4r 2  8D rr rr       sta AnimTimer
0001C7r 2               @Done:
0001C7r 2  60             rts
0001C8r 2               
0001C8r 2               @Landed:
0001C8r 2  EE rr rr       inc ChainStep                 ; SPEC 8 step 9
0001CBr 2  4C rr rr       jmp CascadeEnter
0001CEr 2               
0001CEr 2               ; -----------------------------------------------------------------------------
0001CEr 2               ;   PlayAre — the entry delay, then the next piece
0001CEr 2               ;   SPEC 5.6, 13.4 — a blocked spawn is game over.
0001CEr 2               ; -----------------------------------------------------------------------------
0001CEr 2               PlayAre:
0001CEr 2  CE rr rr       dec AreTimer
0001D1r 2  D0 10          bne @Done
0001D3r 2  20 rr rr       jsr PieceSpawn
0001D6r 2  B0 0C          bcs @Over
0001D8r 2  20 rr rr       jsr PieceGenerateNext
0001DBr 2  20 rr rr       jsr RenderNext
0001DEr 2  A9 00          lda #PLAY_FALLING
0001E0r 2  8D rr rr       sta PlayState
0001E3r 2               @Done:
0001E3r 2  60             rts
0001E4r 2               
0001E4r 2               @Over:
0001E4r 2  A9 03          lda #STATE_GAMEOVER           ; P7 owns the petrify animation; for now the
0001E6r 2  8D rr rr       sta GameState                 ;   game simply stops
0001E9r 2  60             rts
0001EAr 2               
0001EAr 2               ; -----------------------------------------------------------------------------
0001EAr 2               ;   StatePause
0001EAr 2               ; -----------------------------------------------------------------------------
0001EAr 2               StatePause:
0001EAr 2  AD rr rr       lda InputEdge
0001EDr 2  29 30          and #(INPUT_PAUSE | INPUT_FIRE)
0001EFr 2  F0 14          beq @Done
0001F1r 2  A9 01          lda #STATE_PLAY
0001F3r 2  8D rr rr       sta GameState
0001F6r 2  20 rr rr       jsr RenderBoard               ; Put the board back...
0001F9r 2  AD rr rr       lda PlayState                 ;   ...and the piece on top of it, once the
0001FCr 2  C9 02          cmp #PLAY_GLOW                ;   redraw has gone by (D14) — but only while
0001FEr 2  B0 05          bcs @Done                     ;   there IS one. From GLOW on up the piece is
000200r 2  A9 01          lda #1                        ;   in the board and PieceA-C are stale; the
000202r 2  8D rr rr       sta PieceDirty                ;   cascade may have taken those cells away
000205r 2               @Done:                          ;   entirely.
000205r 2  60             rts
000206r 2               
000206r 2               ; -----------------------------------------------------------------------------
000206r 2               ;   StateGameOver — petrify, banner, back to the title
000206r 2               ;   SPEC 13.4
000206r 2               ; -----------------------------------------------------------------------------
000206r 2               StateGameOver:
000206r 2                 ; TODO: petrify the well from the bottom up, 2 frames a row, then the banner
000206r 2                 ; and a 10 second timeout. Each cell keeps its own shape —
000206r 2                 ;   PETRIFY_BASE + (tile & GLYPH_MASK)
000206r 2                 ; — and empty cells stay empty (13.4).
000206r 2  AD rr rr       lda InputEdge
000209r 2  29 11          and #(INPUT_FIRE | INPUT_UP)  ; Fire, or SPACE (D15)
00020Br 2  F0 0A          beq @Done
00020Dr 2  A9 00          lda #STATE_TITLE
00020Fr 2  8D rr rr       sta GameState
000212r 2  A9 01          lda #1
000214r 2  8D rr rr       sta NeedsRedraw
000217r 2               @Done:
000217r 2  60             rts
000218r 2               
000218r 2               ; =============================================================================
000218r 2               ;   Static screen drawing
000218r 2               ; =============================================================================
000218r 2               ;   The whole static layout — panel frame, labels, and the margin artwork that
000218r 2               ;   fills the screen either side of it — comes out of the editors as one
000218r 2               ;   name-table image per platform. Code only ever draws over the top of it:
000218r 2               ;   the well, the score and level digits, the preview, and the message band.
000218r 2               ;
000218r 2               ;   All six images are real. They come out of artwork/WizardsLab.tms9918 —
000218r 2               ;   the master — by way of `make artwork`. See data/README.md.
000218r 2               ; =============================================================================
000218r 2               
000218r 2               DrawTitleScreen:
000218r 2  A9 rr          lda #<TitleScreen
00021Ar 2  85 rr          sta SrcPtr
00021Cr 2  A9 rr          lda #>TitleScreen
00021Er 2  85 rr          sta SrcPtr+1
000220r 2  A9 rr          lda #<TitleColor
000222r 2  85 rr          sta Ptr1
000224r 2  A9 rr          lda #>TitleColor
000226r 2  85 rr          sta Ptr1+1
000228r 2  4C rr rr       jmp HalBlitScreen
00022Br 2               
00022Br 2               DrawPlayScreen:
00022Br 2  A9 rr          lda #<PlayScreen
00022Dr 2  85 rr          sta SrcPtr
00022Fr 2  A9 rr          lda #>PlayScreen
000231r 2  85 rr          sta SrcPtr+1
000233r 2  A9 rr          lda #<PlayColor
000235r 2  85 rr          sta Ptr1
000237r 2  A9 rr          lda #>PlayColor
000239r 2  85 rr          sta Ptr1+1
00023Br 2  4C rr rr       jmp HalBlitScreen
00023Er 2               
00023Er 1               .include "../src/rng.asm"
00023Er 2               ; =============================================================================
00023Er 2               ;   rng.asm — Wizards Lab, random numbers
00023Er 2               ; =============================================================================
00023Er 2               ;   A 16-bit Galois LFSR with the conventional $B400 taps, which is maximal
00023Er 2               ;   length: it visits all 65535 non-zero states before repeating. Eight shifts
00023Er 2               ;   per call, one whole byte out.
00023Er 2               ;
00023Er 2               ;   Seeding matters more than the generator does. A fixed seed would deal the
00023Er 2               ;   same first three pieces every session and the game would feel dead, so the
00023Er 2               ;   seed is taken from the free-running frame counter at the moment the player
00023Er 2               ;   presses fire on the title screen — human reaction time is the entropy.
00023Er 2               ;
00023Er 2               ;   SPEC.md section 15.
00023Er 2               ; =============================================================================
00023Er 2               
00023Er 2               ; -----------------------------------------------------------------------------
00023Er 2               ;   RngSeed — seed from the frame counter
00023Er 2               ;   In:  nothing (reads FrameCounter)
00023Er 2               ;   Out: nothing.  Modifies: A
00023Er 2               ; -----------------------------------------------------------------------------
00023Er 2               RngSeed:
00023Er 2  AD rr rr       lda FrameCounter
000241r 2  09 01          ora #$01                      ; Never let the state reach zero — it sticks
000243r 2  85 rr          sta RngLo
000245r 2  49 5A          eor #$5A                      ; Spread one byte of entropy over both halves
000247r 2  85 rr          sta RngHi
000249r 2  60             rts
00024Ar 2               
00024Ar 2               ; -----------------------------------------------------------------------------
00024Ar 2               ;   RngNext — next pseudo-random byte
00024Ar 2               ;   In:  nothing
00024Ar 2               ;   Out: A = random 0-255.  Modifies: A, X, flags
00024Ar 2               ; -----------------------------------------------------------------------------
00024Ar 2               RngNext:
00024Ar 2  A2 08          ldx #8                        ; Eight shifts give one whole output byte
00024Cr 2               @Bit:
00024Cr 2  46 rr          lsr RngHi                     ; Shift the 16-bit state right one place,
00024Er 2  66 rr          ror RngLo                     ;   the bit falling out of bit 0 lands in C
000250r 2  90 06          bcc @NoTap
000252r 2  A5 rr          lda RngHi
000254r 2  49 B4          eor #$B4                      ; Galois feedback mask $B400
000256r 2  85 rr          sta RngHi
000258r 2               @NoTap:
000258r 2  CA             dex
000259r 2  D0 F1          bne @Bit
00025Br 2  A5 rr          lda RngLo
00025Dr 2  60             rts
00025Er 2               
00025Er 2               ; -----------------------------------------------------------------------------
00025Er 2               ;   RngRange — a random number below a small limit
00025Er 2               ;   In:  A = limit, 1-128
00025Er 2               ;   Out: A = 0 .. limit-1.  Modifies: A, X, Tmp0, Tmp1.  PRESERVES Y.
00025Er 2               ;
00025Er 2               ;   Not a modulo. `random % 6` throws four of the 256 outcomes into the low
00025Er 2               ;   values and leaves colours 0-3 a shade likelier than 4-5; this takes the
00025Er 2               ;   HIGH byte of (random * limit) instead, which spreads the remainder evenly
00025Er 2               ;   across the range and costs a fixed eight shifts either way.
00025Er 2               ;
00025Er 2               ;   The eight-bit multiply keeps only the high byte: the low half falls out of
00025Er 2               ;   the accumulator one bit at a time and is never wanted.
00025Er 2               ;
00025Er 2               ;   Y is preserved so a caller can loop over the three cells of a piece with
00025Er 2               ;   it (piece.asm does).
00025Er 2               ; -----------------------------------------------------------------------------
00025Er 2               RngRange:
00025Er 2  48             pha                           ; The limit — RngNext wants A
00025Fr 2  20 rr rr       jsr RngNext
000262r 2  85 rr          sta Tmp0                      ; The random byte
000264r 2  68             pla
000265r 2  85 rr          sta Tmp1                      ; The limit, shifted out one bit at a time
000267r 2  A9 00          lda #0
000269r 2  A2 08          ldx #8
00026Br 2               @Bit:
00026Br 2  46 rr          lsr Tmp1                      ; Next multiplier bit into C
00026Dr 2  90 03          bcc @NoAdd
00026Fr 2  18             clc
000270r 2  65 rr          adc Tmp0                      ; Partial product, carry out into C
000272r 2               @NoAdd:
000272r 2  6A             ror a                         ; Shift the accumulator down, carry in at bit 7
000273r 2  CA             dex
000274r 2  D0 F5          bne @Bit
000276r 2  60             rts
000277r 2               
000277r 1               .include "../src/input.asm"
000277r 2               ; =============================================================================
000277r 2               ;   input.asm — Wizards Lab, input conditioning
000277r 2               ; =============================================================================
000277r 2               ;   SPEC.md section 11. HalReadInput hands back one active-high mask however
000277r 2               ;   the platform likes; everything above this line works on that mask and
000277r 2               ;   never touches hardware.
000277r 2               ;
000277r 2               ;   Auto-repeat applies to LEFT and RIGHT only. Rotate does NOT repeat — up
000277r 2               ;   must be released and pressed again. That is not a preference: a repeating
000277r 2               ;   rotate makes a three-cell Columns piece impossible to aim.
000277r 2               ; =============================================================================
000277r 2               
000277r 2               ; -----------------------------------------------------------------------------
000277r 2               ;   InputPoll — read the hardware and work out what is newly pressed
000277r 2               ;   In:  nothing
000277r 2               ;   Out: InputNow, InputPrev, InputEdge updated.  Modifies: A
000277r 2               ; -----------------------------------------------------------------------------
000277r 2               InputPoll:
000277r 2  AD rr rr       lda InputNow
00027Ar 2  8D rr rr       sta InputPrev
00027Dr 2  20 rr rr       jsr HalReadInput
000280r 2  8D rr rr       sta InputNow
000283r 2  4D rr rr       eor InputPrev                 ; Bits that changed
000286r 2  2D rr rr       and InputNow                  ; ...and are now down = newly pressed
000289r 2  8D rr rr       sta InputEdge
00028Cr 2  60             rts
00028Dr 2               
00028Dr 2               ; -----------------------------------------------------------------------------
00028Dr 2               ;   InputShift — LEFT/RIGHT with delayed auto shift
00028Dr 2               ;   Out: A = INPUT_LEFT, INPUT_RIGHT, or 0 if no move should happen this frame.
00028Dr 2               ;        Modifies: A, X
00028Dr 2               ;   SPEC 11.3 — initial delay 12 frames NTSC / 10 PAL, then 4 / 3.
00028Dr 2               ;
00028Dr 2               ;   A fresh press fires on the same frame it arrives; the delay is what comes
00028Dr 2               ;   after it, not before it, so a tap is always exactly one column.
00028Dr 2               ;
00028Dr 2               ;   Holding both directions at once is not something a stick can do, but two
00028Dr 2               ;   keys can. LEFT wins, and it wins consistently, so the piece sits still
00028Dr 2               ;   rather than shivering between the two.
00028Dr 2               ; -----------------------------------------------------------------------------
00028Dr 2               InputShift:
00028Dr 2  AD rr rr       lda InputNow
000290r 2  29 04          and #INPUT_LEFT
000292r 2  D0 07          bne @Dir
000294r 2  AD rr rr       lda InputNow
000297r 2  29 08          and #INPUT_RIGHT
000299r 2  F0 2A          beq @None
00029Br 2               
00029Br 2               @Dir:
00029Br 2  CD rr rr       cmp DasDir
00029Er 2  F0 10          beq @Held
0002A0r 2               
0002A0r 2  8D rr rr       sta DasDir                    ; A new direction: fire now, then wait
0002A3r 2  AE rr rr       ldx Region
0002A6r 2  BD rr rr       lda DasInitial,x
0002A9r 2  8D rr rr       sta DasTimer
0002ACr 2  AD rr rr       lda DasDir
0002AFr 2  60             rts
0002B0r 2               
0002B0r 2               @Held:
0002B0r 2  CE rr rr       dec DasTimer                  ; Always loaded non-zero, so this cannot wrap
0002B3r 2  D0 0D          bne @Wait
0002B5r 2  AE rr rr       ldx Region
0002B8r 2  BD rr rr       lda DasRepeat,x
0002BBr 2  8D rr rr       sta DasTimer
0002BEr 2  AD rr rr       lda DasDir
0002C1r 2  60             rts
0002C2r 2               
0002C2r 2               @Wait:
0002C2r 2  A9 00          lda #0
0002C4r 2  60             rts
0002C5r 2               
0002C5r 2               @None:
0002C5r 2  8D rr rr       sta DasDir                    ; A is already 0 — release, so the next press
0002C8r 2  60             rts                           ;   counts as fresh
0002C9r 2               
0002C9r 1               .include "../src/board.asm"
0002C9r 2               ; =============================================================================
0002C9r 2               ;   board.asm — Wizards Lab, the playfield
0002C9r 2               ; =============================================================================
0002C9r 2               ;   SPEC.md section 3. The board is 20 rows of 8 bytes, page-aligned, with
0002C9r 2               ;   columns 6-7 and rows 16-19 held permanently at $FF. Those sentinels are
0002C9r 2               ;   what let every scan in match.asm run without a bounds check.
0002C9r 2               ;
0002C9r 2               ;   address(row, col) = Board + (row << 3) + col
0002C9r 2               ; =============================================================================
0002C9r 2               
0002C9r 2               ; -----------------------------------------------------------------------------
0002C9r 2               ;   BoardClear — empty the playfield and lay the sentinels back down
0002C9r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X
0002C9r 2               ;
0002C9r 2               ;   Walls first over the whole 160 bytes, then the six playfield columns of
0002C9r 2               ;   the sixteen playfield rows punched back out to empty. Doing it in that
0002C9r 2               ;   order means the sentinels can never be forgotten: everything that is not
0002C9r 2               ;   explicitly playfield is a wall.
0002C9r 2               ;
0002C9r 2               ;   The wall loop counts UP and ends on a CPX. Counting down from 159 to a BPL
0002C9r 2               ;   looks tidier and is wrong: 159 is $9F, bit 7 already set, so the branch
0002C9r 2               ;   falls through after the first store and the other 159 bytes keep whatever
0002C9r 2               ;   the machine powered up with. That went unnoticed for a whole phase,
0002C9r 2               ;   because nothing read a sentinel until the falling piece needed a floor.
0002C9r 2               ; -----------------------------------------------------------------------------
0002C9r 2               BoardClear:
0002C9r 2  A9 FF          lda #TILE_WALL
0002CBr 2  A2 00          ldx #0
0002CDr 2               @Wall:
0002CDr 2  9D rr rr       sta Board,x
0002D0r 2  E8             inx
0002D1r 2  E0 A0          cpx #BOARD_BYTES
0002D3r 2  D0 F8          bne @Wall
0002D5r 2               
0002D5r 2  A2 00          ldx #0                        ; X walks the row bases, 0, 8, 16, ...
0002D7r 2               @Row:
0002D7r 2  A9 00          lda #TILE_EMPTY               ; Reloaded every row: the TXA below eats it
0002D9r 2  9D rr rr 9D    .repeat BOARD_W, COL
0002DDr 2  rr rr 9D rr  
0002E1r 2  rr 9D rr rr  
0002EBr 2                   sta Board + COL, x
0002EBr 2                 .endrepeat
0002EBr 2  8A             txa
0002ECr 2  18             clc
0002EDr 2  69 08          adc #BOARD_STRIDE
0002EFr 2  AA             tax
0002F0r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
0002F2r 2  90 E3          bcc @Row
0002F4r 2  60             rts
0002F5r 2               
0002F5r 2               ; -----------------------------------------------------------------------------
0002F5r 2               ;   BoardRowPtr — point Ptr1 at the start of a board row
0002F5r 2               ;   In:  A = row        Out: Ptr1 = &Board[row][0].  Modifies: A, Ptr1
0002F5r 2               ;
0002F5r 2               ;   Board is page-aligned and 160 bytes, so row * 8 is at most 152 and the low
0002F5r 2               ;   byte can never carry into the high one.
0002F5r 2               ; -----------------------------------------------------------------------------
0002F5r 2               BoardRowPtr:
0002F5r 2  0A             asl a
0002F6r 2  0A             asl a
0002F7r 2  0A             asl a
0002F8r 2  18             clc
0002F9r 2  69 rr          adc #<Board
0002FBr 2  85 rr          sta Ptr1
0002FDr 2  A9 rr          lda #>Board
0002FFr 2  85 rr          sta Ptr1+1
000301r 2  60             rts
000302r 2               
000302r 2               ; -----------------------------------------------------------------------------
000302r 2               ;   BoardGravityBegin / BoardGravityStep — the pile falls, one row at a time
000302r 2               ;   SPEC 8 step 8, SPEC 14: tiles descend one row every FALL_FRAMES.
000302r 2               ;
000302r 2               ;   A row of falling is one pass over the board, bottom to top, moving every
000302r 2               ;   tile that has an empty cell under it down into it. Repeat until a pass
000302r 2               ;   moves nothing and the columns are compacted — but repeat it a row at a
000302r 2               ;   time, because the fall is animated and a column that dropped four rows in
000302r 2               ;   one frame would read as a teleport.
000302r 2               ;
000302r 2               ;   Walking BOTTOM TO TOP is what makes a whole column fall together rather
000302r 2               ;   than one tile a frame: by the time the pass reaches a tile, the tile below
000302r 2               ;   it has already moved and left the gap.
000302r 2               ;
000302r 2               ;   The pass is a CURSOR, not a loop that runs to completion (D12, SPEC 12.6).
000302r 2               ;   Sixty tiles falling is a hundred-odd changed cells and the dirty ring holds
000302r 2               ;   64, so the pass stops when the ring is full and picks up where it stopped
000302r 2               ;   next frame. Nothing is dropped and the board is a legal board at every
000302r 2               ;   point it stops — one frame's worth of columns has fallen a row and the
000302r 2               ;   rest has not, which is a stagger nobody can see.
000302r 2               ;
000302r 2               ;   The two sentinel columns need no special case: a wall's "cell below" is
000302r 2               ;   another wall, so columns 6 and 7 never move.
000302r 2               ; -----------------------------------------------------------------------------
000302r 2               GRAV_TOP = (BOARD_H - 1) * BOARD_STRIDE - 1     ; The last cell of row 14, the
000302r 2                                                               ;   lowest row that can fall at
000302r 2                                                               ;   all. Row 15 is on the floor
000302r 2               BoardGravityBegin:
000302r 2  A9 77          lda #GRAV_TOP
000304r 2  85 rr          sta GravIdx
000306r 2  A9 00          lda #0
000308r 2  85 rr          sta GravMoved
00030Ar 2  60             rts
00030Br 2               
00030Br 2               ; -----------------------------------------------------------------------------
00030Br 2               ;   BoardGravityStep — carry on with the current row of falling
00030Br 2               ;   In:  nothing
00030Br 2               ;   Out: C set when the row is finished; GravMoved non-zero if it moved
00030Br 2               ;        anything. Modifies: A, X, Y, GravIdx, GravMoved, RedrawCol
00030Br 2               ; -----------------------------------------------------------------------------
00030Br 2               BoardGravityStep:
00030Br 2  A5 rr          lda GravIdx
00030Dr 2  30 3F          bmi @Finished                 ; $FF — the row is already done
00030Fr 2               
00030Fr 2               @Cell:
00030Fr 2  AD rr rr       lda DirtyCount                ; Room for both cells of a move, or wait for
000312r 2  C9 3E          cmp #(DIRTY_ENTRIES - 2)      ;   the flush. A mark dropped here would never
000314r 2  B0 3A          bcs @Later                    ;   be marked again (D6 is survivable only
000316r 2                                               ;   because nothing that MUST land uses it)
000316r 2               
000316r 2  A6 rr          ldx GravIdx
000318r 2  BD rr rr       lda Board,x
00031Br 2  F0 2D          beq @Next                     ; Nothing here to fall
00031Dr 2  BD rr rr       lda Board + BOARD_STRIDE,x
000320r 2  D0 28          bne @Next                     ; Something under it — a tile, or the floor
000322r 2               
000322r 2  BD rr rr       lda Board,x                   ; Move it down one row
000325r 2  9D rr rr       sta Board + BOARD_STRIDE,x
000328r 2  A9 00          lda #TILE_EMPTY
00032Ar 2  9D rr rr       sta Board,x
00032Dr 2  E6 rr          inc GravMoved
00032Fr 2               
00032Fr 2  A5 rr          lda GravIdx                   ; The cell it LEFT only needs redrawing if it
000331r 2  C9 08          cmp #BOARD_STRIDE             ;   is going to stay empty. If there is a tile
000333r 2  90 07          bcc @Vacated                  ;   above it, that tile lands here later in
000335r 2  A6 rr          ldx GravIdx                   ;   this same pass and its own arrival mark
000337r 2  BD rr rr       lda Board - BOARD_STRIDE,x    ;   covers the cell. Half the marks of a
00033Ar 2  D0 05          bne @Arrived                  ;   sliding column, which is what the ring
00033Cr 2               @Vacated:                       ;   pressure is made of.
00033Cr 2  A6 rr          ldx GravIdx
00033Er 2  20 rr rr       jsr RenderCell
000341r 2               @Arrived:
000341r 2  A5 rr          lda GravIdx
000343r 2  18             clc
000344r 2  69 08          adc #BOARD_STRIDE
000346r 2  AA             tax
000347r 2  20 rr rr       jsr RenderCell
00034Ar 2               
00034Ar 2               @Next:
00034Ar 2  C6 rr          dec GravIdx                   ; Down to 0, then $FF, which ends the pass —
00034Cr 2  10 C1          bpl @Cell                     ;   GRAV_TOP is 119, so bit 7 starts clear
00034Er 2                                               ;   (see PLAN.md section 3)
00034Er 2               @Finished:
00034Er 2  38             sec
00034Fr 2  60             rts
000350r 2               
000350r 2               @Later:
000350r 2  18             clc                           ; Ring full: the rest of this row waits a frame
000351r 2  60             rts
000352r 2               
000352r 1               .include "../src/piece.asm"
000352r 2               ; =============================================================================
000352r 2               ;   piece.asm — Wizards Lab, the falling piece
000352r 2               ; =============================================================================
000352r 2               ;   SPEC.md section 5. A piece is three independently generated cells stacked
000352r 2               ;   vertically, A on top. At most one of the three carries a reagent, which is
000352r 2               ;   enforced by rolling once for the piece rather than once per cell.
000352r 2               ;
000352r 2               ;   The piece is NOT in the board while it falls. Board cells under it stay
000352r 2               ;   empty until PieceLock writes them, which is what makes the movement tests
000352r 2               ;   below a plain read of the three target cells and what lets the erase be
000352r 2               ;   three blanks rather than three board reads.
000352r 2               ;
000352r 2               ;   Nothing here draws. Every routine that changes where the piece is or what
000352r 2               ;   it holds sets PieceDirty and lets StatePlay pick the moment (D14).
000352r 2               ; =============================================================================
000352r 2               
000352r 2               ; -----------------------------------------------------------------------------
000352r 2               ;   PieceIndex — board index of the piece's top cell
000352r 2               ;   In:  nothing
000352r 2               ;   Out: A = X = PieceRow * BOARD_STRIDE + PieceCol.  Modifies: A, X
000352r 2               ;
000352r 2               ;   Cells B and C are one and two strides on from it, and the cell below C is
000352r 2               ;   three — which is the only address arithmetic the rest of this file needs.
000352r 2               ;   Row 16 and beyond is a wall row, so "below C" is always a legal read.
000352r 2               ; -----------------------------------------------------------------------------
000352r 2               PieceIndex:
000352r 2  AD rr rr       lda PieceRow
000355r 2  0A             asl a
000356r 2  0A             asl a
000357r 2  0A             asl a                         ; row * 8
000358r 2  18             clc
000359r 2  6D rr rr       adc PieceCol
00035Cr 2  AA             tax
00035Dr 2  60             rts
00035Er 2               
00035Er 2               ; -----------------------------------------------------------------------------
00035Er 2               ;   PieceGenerateNext — roll the preview piece into NextA/NextB/NextC
00035Er 2               ;   In:  nothing (reads Level)
00035Er 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0, Tmp1
00035Er 2               ;   SPEC 5.2, 5.3 — colours uniform over 0-5, then one reagent roll.
00035Er 2               ; -----------------------------------------------------------------------------
00035Er 2               PieceGenerateNext:
00035Er 2  A0 00          ldy #0                        ; RngRange preserves Y, so it can index the
000360r 2               @Color:                         ;   three cells across the call
000360r 2  A9 06          lda #NUM_COLORS
000362r 2  20 rr rr       jsr RngRange                  ; 0-5, uniform (SPEC 5.2)
000365r 2  0A             asl a
000366r 2  0A             asl a
000367r 2  0A             asl a                         ; colour << 3 ...
000368r 2  18             clc
000369r 2  69 40          adc #COLOR_BASE               ;   ... + base, glyph 0, so it is a potion
00036Br 2  99 rr rr       sta NextA,y                   ; NextA/B/C are three consecutive bytes
00036Er 2  C8             iny
00036Fr 2  C0 03          cpy #3
000371r 2  90 ED          bcc @Color
000373r 2               
000373r 2                 ; --- does this piece carry a reagent at all? (SPEC 5.3) -------------------
000373r 2                 ;   One roll for the whole piece, which both caps it at one reagent and
000373r 2                 ;   costs three rolls fewer than asking each cell.
000373r 2  20 rr rr       jsr RngNext
000376r 2  85 rr          sta Tmp0                      ; The roll. Nothing below calls out until it
000378r 2                                               ;   has been compared, so Tmp0 is safe.
000378r 2  AE rr rr       ldx Level
00037Br 2  CA             dex                           ; LevelBand is indexed by level - 1 ...
00037Cr 2  E0 10          cpx #16
00037Er 2  90 02          bcc @Band
000380r 2  A2 0F          ldx #15                       ;   ... and clamped: band 4 is "13 and up"
000382r 2               @Band:
000382r 2  BD rr rr       lda LevelBand,x
000385r 2  AA             tax                           ; X = band 0-4
000386r 2  A5 rr          lda Tmp0
000388r 2  DD rr rr       cmp PSpecial,x                ; C clear = the roll came in under the chance
00038Br 2  B0 2E          bcs @Done
00038Dr 2               
00038Dr 2                 ; --- which cell, and which reagent ----------------------------------------
00038Dr 2  8A             txa
00038Er 2  48             pha                           ; The band, across the cell roll
00038Fr 2  A9 03          lda #3
000391r 2  20 rr rr       jsr RngRange                  ; 0, 1 or 2 — uniform over A, B and C
000394r 2  A8             tay                           ; Y survives the type roll below
000395r 2  68             pla
000396r 2  0A             asl a
000397r 2  0A             asl a                         ; band * 4 — ReagentThresholds is four
000398r 2  48             pha                           ;   thresholds per band
000399r 2  20 rr rr       jsr RngNext
00039Cr 2  85 rr          sta Tmp0                      ; The type roll
00039Er 2  68             pla
00039Fr 2  AA             tax
0003A0r 2  A5 rr          lda Tmp0
0003A2r 2               
0003A2r 2  DD rr rr       cmp ReagentThresholds+0,x     ; The cumulative-weight compare chain SPEC 5.3
0003A5r 2  90 15          bcc @Fireball                 ;   recommends over a 1280-byte lookup
0003A7r 2  DD rr rr       cmp ReagentThresholds+1,x
0003AAr 2  90 14          bcc @Bolt
0003ACr 2  DD rr rr       cmp ReagentThresholds+2,x
0003AFr 2  90 13          bcc @Bomb
0003B1r 2  DD rr rr       cmp ReagentThresholds+3,x
0003B4r 2  90 12          bcc @Star
0003B6r 2               
0003B6r 2  A9 70          lda #WILD_BASE                ; A Prism discards the colour it rolled and
0003B8r 2  99 rr rr       sta NextA,y                   ;   joins group 14 (SPEC 5.2)
0003BBr 2               @Done:
0003BBr 2  60             rts
0003BCr 2               
0003BCr 2               @Fireball:
0003BCr 2  A9 01          lda #GLYPH_FIREBALL
0003BEr 2  D0 0A          bne @Apply                    ; Always — every glyph below is non-zero
0003C0r 2               @Bolt:
0003C0r 2  A9 02          lda #GLYPH_BOLT
0003C2r 2  D0 06          bne @Apply
0003C4r 2               @Bomb:
0003C4r 2  A9 03          lda #GLYPH_BOMB
0003C6r 2  D0 02          bne @Apply
0003C8r 2               @Star:
0003C8r 2  A9 04          lda #GLYPH_STAR
0003CAr 2               @Apply:
0003CAr 2  19 rr rr       ora NextA,y                   ; The cell's glyph nibble is 0, so an ORA sets
0003CDr 2  99 rr rr       sta NextA,y                   ;   the reagent and keeps the rolled colour
0003D0r 2  60             rts
0003D1r 2               
0003D1r 2               ; -----------------------------------------------------------------------------
0003D1r 2               ;   PieceSpawn — promote the preview to the falling piece
0003D1r 2               ;   In:  nothing
0003D1r 2               ;   Out: C set if the spawn cells were occupied (game over)
0003D1r 2               ;        Modifies: A, X
0003D1r 2               ;   SPEC 5.4 — spawn column SPAWN_COL, rows 0-2, visible immediately.
0003D1r 2               ;
0003D1r 2               ;   The preview is copied whether or not the spawn succeeds; on a blocked
0003D1r 2               ;   spawn nothing looks at the piece again.
0003D1r 2               ; -----------------------------------------------------------------------------
0003D1r 2               PieceSpawn:
0003D1r 2  AD rr rr       lda NextA
0003D4r 2  8D rr rr       sta PieceA
0003D7r 2  AD rr rr       lda NextB
0003DAr 2  8D rr rr       sta PieceB
0003DDr 2  AD rr rr       lda NextC
0003E0r 2  8D rr rr       sta PieceC
0003E3r 2               
0003E3r 2  A9 02          lda #SPAWN_COL
0003E5r 2  8D rr rr       sta PieceCol
0003E8r 2  A9 00          lda #0
0003EAr 2  8D rr rr       sta PieceRow
0003EDr 2  8D rr rr       sta LockTimer
0003F0r 2  8D rr rr       sta LockResets                ; The reset allowance is per piece (SPEC 5.6)
0003F3r 2               
0003F3r 2  AD rr rr       lda Board + 0 * BOARD_STRIDE + SPAWN_COL
0003F6r 2  0D rr rr       ora Board + 1 * BOARD_STRIDE + SPAWN_COL
0003F9r 2  0D rr rr       ora Board + 2 * BOARD_STRIDE + SPAWN_COL
0003FCr 2  D0 0D          bne @Blocked
0003FEr 2               
0003FEr 2  20 rr rr       jsr ScoreGravity
000401r 2  8D rr rr       sta GravityTimer
000404r 2  A9 01          lda #1
000406r 2  8D rr rr       sta PieceDirty                ; Drawn immediately — there is no off-screen
000409r 2  18             clc                           ;   entry (SPEC 5.4)
00040Ar 2  60             rts
00040Br 2               
00040Br 2               @Blocked:
00040Br 2  38             sec
00040Cr 2  60             rts
00040Dr 2               
00040Dr 2               ; -----------------------------------------------------------------------------
00040Dr 2               ;   PieceMoveLeft / PieceMoveRight — one column, if all three cells are free
00040Dr 2               ;   Out: C set if the move happened (the caller resets the lock timer).
00040Dr 2               ;        Modifies: A, X
00040Dr 2               ;   SPEC 5.5 — no wall kicks; a 1-wide piece has nothing to kick off.
00040Dr 2               ;
00040Dr 2               ;   The right edge needs no bounds check: column 6 is a permanent $FF sentinel
00040Dr 2               ;   and fails the emptiness test on its own (SPEC 3.2). The LEFT edge does,
00040Dr 2               ;   because column -1 of row 0 is the byte before a page-aligned Board and
00040Dr 2               ;   belongs to nobody.
00040Dr 2               ; -----------------------------------------------------------------------------
00040Dr 2               PieceMoveLeft:
00040Dr 2  AD rr rr       lda PieceCol
000410r 2  F0 18          beq @No                       ; Column 0 — there is no sentinel to the left
000412r 2  20 rr rr       jsr PieceIndex
000415r 2  CA             dex
000416r 2  BD rr rr       lda Board + 0 * BOARD_STRIDE,x
000419r 2  1D rr rr       ora Board + 1 * BOARD_STRIDE,x
00041Cr 2  1D rr rr       ora Board + 2 * BOARD_STRIDE,x
00041Fr 2  D0 09          bne @No
000421r 2  20 rr rr       jsr RenderPieceErase
000424r 2  CE rr rr       dec PieceCol
000427r 2  4C rr rr       jmp PieceMoved
00042Ar 2               
00042Ar 2               @No:
00042Ar 2  18             clc
00042Br 2  60             rts
00042Cr 2               
00042Cr 2               PieceMoveRight:
00042Cr 2  20 rr rr       jsr PieceIndex
00042Fr 2  E8             inx
000430r 2  BD rr rr       lda Board + 0 * BOARD_STRIDE,x
000433r 2  1D rr rr       ora Board + 1 * BOARD_STRIDE,x
000436r 2  1D rr rr       ora Board + 2 * BOARD_STRIDE,x
000439r 2  D0 09          bne @No
00043Br 2  20 rr rr       jsr RenderPieceErase
00043Er 2  EE rr rr       inc PieceCol
000441r 2  4C rr rr       jmp PieceMoved
000444r 2               @No:
000444r 2  18             clc
000445r 2  60             rts
000446r 2               
000446r 2               ; -----------------------------------------------------------------------------
000446r 2               ;   PieceMoved — mark the piece for redraw and report success
000446r 2               ;   Out: C set.  Modifies: A
000446r 2               ; -----------------------------------------------------------------------------
000446r 2               PieceMoved:
000446r 2  A9 01          lda #1
000448r 2  8D rr rr       sta PieceDirty
00044Br 2  38             sec
00044Cr 2  60             rts
00044Dr 2               
00044Dr 2               ; -----------------------------------------------------------------------------
00044Dr 2               ;   PieceRotate / PieceRotateBack — cycle the three cells
00044Dr 2               ;   Out: nothing.  Modifies: A, X
00044Dr 2               ;   SPEC 5.5 — (A,B,C) -> (B,C,A) forward, (C,A,B) back. Always succeeds: the
00044Dr 2               ;   footprint never changes, so there is nothing to test and nothing to erase.
00044Dr 2               ;   Rotation does not reset the lock delay (SPEC 5.6).
00044Dr 2               ; -----------------------------------------------------------------------------
00044Dr 2               PieceRotate:
00044Dr 2  AD rr rr       lda PieceA
000450r 2  AE rr rr       ldx PieceB
000453r 2  8E rr rr       stx PieceA
000456r 2  AE rr rr       ldx PieceC
000459r 2  8E rr rr       stx PieceB
00045Cr 2  8D rr rr       sta PieceC
00045Fr 2  A9 01          lda #1
000461r 2  8D rr rr       sta PieceDirty
000464r 2  60             rts
000465r 2               
000465r 2               PieceRotateBack:
000465r 2  AD rr rr       lda PieceC
000468r 2  AE rr rr       ldx PieceB
00046Br 2  8E rr rr       stx PieceC
00046Er 2  AE rr rr       ldx PieceA
000471r 2  8E rr rr       stx PieceB
000474r 2  8D rr rr       sta PieceA
000477r 2  A9 01          lda #1
000479r 2  8D rr rr       sta PieceDirty
00047Cr 2  60             rts
00047Dr 2               
00047Dr 2               ; -----------------------------------------------------------------------------
00047Dr 2               ;   PieceCanFall — is the cell below C free?
00047Dr 2               ;   Out: C set if the piece can descend one row.  Modifies: A, X
00047Dr 2               ;   Three strides past cell A. With C on row 15 that reads row 18, which is a
00047Dr 2               ;   permanent wall row, so the floor needs no special case (SPEC 3.2).
00047Dr 2               ; -----------------------------------------------------------------------------
00047Dr 2               PieceCanFall:
00047Dr 2  20 rr rr       jsr PieceIndex
000480r 2  BD rr rr       lda Board + 3 * BOARD_STRIDE,x
000483r 2  D0 02          bne @No
000485r 2  38             sec
000486r 2  60             rts
000487r 2               @No:
000487r 2  18             clc
000488r 2  60             rts
000489r 2               
000489r 2               ; -----------------------------------------------------------------------------
000489r 2               ;   PieceStep — one row of gravity
000489r 2               ;   Out: C set if the piece has landed and the lock delay should start.
000489r 2               ;        Modifies: A, X
000489r 2               ; -----------------------------------------------------------------------------
000489r 2               PieceStep:
000489r 2  20 rr rr       jsr PieceCanFall
00048Cr 2  90 0B          bcc @Landed
00048Er 2  20 rr rr       jsr RenderPieceErase
000491r 2  EE rr rr       inc PieceRow
000494r 2  20 rr rr       jsr PieceMoved
000497r 2  18             clc                           ; Moved, so it has not landed
000498r 2  60             rts
000499r 2               @Landed:
000499r 2  38             sec
00049Ar 2  60             rts
00049Br 2               
00049Br 2               ; -----------------------------------------------------------------------------
00049Br 2               ;   PieceLock — write the three cells into the board
00049Br 2               ;   Out: nothing.  Modifies: A, X, Y
00049Br 2               ;   SPEC 5.6 — after this the caller runs a cascade.
00049Br 2               ;
00049Br 2               ;   Once the board holds the piece, drawing the piece and drawing those three
00049Br 2               ;   board cells are the same three writes, so RenderPiece does the queueing.
00049Br 2               ; -----------------------------------------------------------------------------
00049Br 2               PieceLock:
00049Br 2  20 rr rr       jsr PieceIndex
00049Er 2  AD rr rr       lda PieceA
0004A1r 2  9D rr rr       sta Board + 0 * BOARD_STRIDE,x
0004A4r 2  AD rr rr       lda PieceB
0004A7r 2  9D rr rr       sta Board + 1 * BOARD_STRIDE,x
0004AAr 2  AD rr rr       lda PieceC
0004ADr 2  9D rr rr       sta Board + 2 * BOARD_STRIDE,x
0004B0r 2               
0004B0r 2  20 rr rr       jsr RenderPiece
0004B3r 2  A9 00          lda #0
0004B5r 2  8D rr rr       sta PieceDirty                ; It is board now; nothing owes it a redraw
0004B8r 2  60             rts
0004B9r 2               
0004B9r 2               ; -----------------------------------------------------------------------------
0004B9r 2               ;   PieceFallRate — frames per row for this frame
0004B9r 2               ;   Out: A = frame count, C CLEAR if that rate is the soft drop's.
0004B9r 2               ;        Modifies: A, X, Tmp0
0004B9r 2               ;   SPEC 5.5, 11.3 — soft drop substitutes its own rate and is ignored when
0004B9r 2               ;   gravity is already the faster of the two (levels 14+ on NTSC).
0004B9r 2               ;
0004B9r 2               ;   The carry is what pays for the soft drop: SPEC 9.6 gives a point per row
0004B9r 2               ;   "descended under soft drop", and a row that fell at gravity's rate with
0004B9r 2               ;   DOWN held down was not one, so holding DOWN at level 16 earns nothing.
0004B9r 2               ;   Working it out here costs nothing — the comparison has already happened.
0004B9r 2               ; -----------------------------------------------------------------------------
0004B9r 2               PieceFallRate:
0004B9r 2  20 rr rr       jsr ScoreGravity              ; Speed[level] for this region
0004BCr 2  85 rr          sta Tmp0
0004BEr 2  AD rr rr       lda InputNow
0004C1r 2  29 02          and #INPUT_DOWN
0004C3r 2  F0 0A          beq @Gravity
0004C5r 2  AE rr rr       ldx Region
0004C8r 2  BD rr rr       lda SoftDropRate,x
0004CBr 2  C5 rr          cmp Tmp0                      ; C clear = soft drop is the faster
0004CDr 2  90 04          bcc @Soft
0004CFr 2               @Gravity:
0004CFr 2  A5 rr          lda Tmp0
0004D1r 2  38             sec
0004D2r 2  60             rts
0004D3r 2               @Soft:
0004D3r 2  18             clc
0004D4r 2  60             rts
0004D5r 2               
0004D5r 2               ; -----------------------------------------------------------------------------
0004D5r 2               ;   PieceControl — apply this frame's input to the piece
0004D5r 2               ;   Out: C set if a horizontal move succeeded (the caller may reset the lock
0004D5r 2               ;        delay).  Modifies: A, X, Y
0004D5r 2               ;
0004D5r 2               ;   Rotation is edge triggered and never repeats: UP has to be released and
0004D5r 2               ;   pressed again. SPEC 11.3 calls that non-negotiable and it is — a
0004D5r 2               ;   repeating rotate makes a three-cell piece impossible to aim. Left and
0004D5r 2               ;   right go through InputShift, which is where the repeat lives.
0004D5r 2               ; -----------------------------------------------------------------------------
0004D5r 2               PieceControl:
0004D5r 2  AD rr rr       lda InputEdge
0004D8r 2  29 01          and #INPUT_UP
0004DAr 2  F0 03          beq @NoRotate
0004DCr 2  20 rr rr       jsr PieceRotate
0004DFr 2               @NoRotate:
0004DFr 2  AD rr rr       lda InputEdge
0004E2r 2  29 10          and #INPUT_FIRE
0004E4r 2  F0 03          beq @NoBack
0004E6r 2  20 rr rr       jsr PieceRotateBack
0004E9r 2               @NoBack:
0004E9r 2  20 rr rr       jsr InputShift
0004ECr 2  C9 04          cmp #INPUT_LEFT
0004EEr 2  F0 06          beq @Left
0004F0r 2  C9 08          cmp #INPUT_RIGHT
0004F2r 2  F0 05          beq @Right
0004F4r 2  18             clc
0004F5r 2  60             rts
0004F6r 2               @Left:
0004F6r 2  4C rr rr       jmp PieceMoveLeft
0004F9r 2               @Right:
0004F9r 2  4C rr rr       jmp PieceMoveRight
0004FCr 2               
0004FCr 1               .include "../src/match.asm"
0004FCr 2               ; =============================================================================
0004FCr 2               ;   match.asm — Wizards Lab, the match scanner
0004FCr 2               ; =============================================================================
0004FCr 2               ;   SPEC.md section 6. Four passes — horizontal, vertical, and both diagonals —
0004FCr 2               ;   each walking its axis and tracking a run colour and length. A run of three
0004FCr 2               ;   or more sets the MARK bit for each of its cells.
0004FCr 2               ;
0004FCr 2               ;   Colour comparison is the whole trick:
0004FCr 2               ;
0004FCr 2               ;       lda cell
0004FCr 2               ;       and #COLOR_MASK         ; the low three bits are the glyph, ignore them
0004FCr 2               ;       cmp ScanColor
0004FCr 2               ;
0004FCr 2               ;   which is why a red potion, a red fireball and a red star all match. The
0004FCr 2               ;   glyph decides what happens on removal, never whether cells match.
0004FCr 2               ;
0004FCr 2               ;   Wildcards (SPEC 6.3): a WILD cell continues any run. If the run has no
0004FCr 2               ;   colour yet it stays unset and is adopted from the first non-wild cell, so
0004FCr 2               ;   one prism can close a red horizontal run and a blue vertical run at once.
0004FCr 2               ;
0004FCr 2               ;   THE FOUR PASSES ARE ONE LOOP. A line is a start cell and a step, and the
0004FCr 2               ;   step is the only thing that differs: +1 across, +8 down, +9 down-right,
0004FCr 2               ;   +7 down-left. Every one of them ends on a sentinel rather than on a bounds
0004FCr 2               ;   check, which is what the 8-byte stride was bought for (SPEC 3.2):
0004FCr 2               ;
0004FCr 2               ;     across   from column 5, +1 lands on column 6      — wall
0004FCr 2               ;     down     from row 15,   +8 lands on row 16        — wall row
0004FCr 2               ;     down-r   from column 5, +9 lands on row+1 col 6   — wall
0004FCr 2               ;     down-l   from column 0, +7 lands on THIS row's column 7 — wall
0004FCr 2               ;
0004FCr 2               ;   The last one is the reason the left edge needs no test either: the byte
0004FCr 2               ;   before column 0 belongs to the row above, and it is already a wall.
0004FCr 2               ; =============================================================================
0004FCr 2               
0004FCr 2               ; -----------------------------------------------------------------------------
0004FCr 2               ;   MatchScan — find every run on the board
0004FCr 2               ;   In:  nothing
0004FCr 2               ;   Out: Marks filled, RunCount set, Z set if nothing matched.
0004FCr 2               ;        Modifies: A, X, Y, Scan*
0004FCr 2               ; -----------------------------------------------------------------------------
0004FCr 2               MatchScan:
0004FCr 2  20 rr rr       jsr MarksClear
0004FFr 2  A9 00          lda #0
000501r 2  8D rr rr       sta RunCount
000504r 2               
000504r 2  20 rr rr       jsr ScanFindTop               ; Everything below skips the empty air above
000507r 2  A5 rr          lda ScanTop                   ;   the pile, which on most boards is most of
000509r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE) ;   the board
00050Br 2  B0 0C          bcs @Done                     ; Nothing on the board at all
00050Dr 2               
00050Dr 2  20 rr rr       jsr MatchScanHorizontal
000510r 2  20 rr rr       jsr MatchScanVertical
000513r 2  20 rr rr       jsr MatchScanDiagonal
000516r 2  20 rr rr       jsr MatchScanAntiDiagonal
000519r 2               @Done:
000519r 2  AD rr rr       lda RunCount                  ; Z set when nothing matched
00051Cr 2  60             rts
00051Dr 2               
00051Dr 2               ; -----------------------------------------------------------------------------
00051Dr 2               ;   ScanFindTop — board index of the first row that holds anything
00051Dr 2               ;   Out: ScanTop = row base, or BOARD_H * BOARD_STRIDE if the board is empty.
00051Dr 2               ;        Modifies: A, X, ScanTop
00051Dr 2               ;
00051Dr 2               ;   Every pass below starts here instead of at row 0. A pile six rows deep is
00051Dr 2               ;   scanned as six rows: 178 cells against 448, and the four passes come in
00051Dr 2               ;   under a third of the frame instead of over two whole ones. Finding it costs
00051Dr 2               ;   about 45 cycles a row of empty air, which is the cheapest part of the scan.
00051Dr 2               ;
00051Dr 2               ;   Correct as well as quick, and for a reason worth writing down: a line that
00051Dr 2               ;   reaches the pile at all must CROSS the pile's top row, because every one of
00051Dr 2               ;   the four steps moves down at most one row at a time. Starting the diagonals
00051Dr 2               ;   on that row rather than on row 0 therefore misses nothing.
00051Dr 2               ; -----------------------------------------------------------------------------
00051Dr 2               ScanFindTop:
00051Dr 2  A2 00          ldx #0
00051Fr 2               @Row:
00051Fr 2  BD rr rr       lda Board + 0,x               ; The six playfield columns; the two sentinel
000522r 2  1D rr rr       ora Board + 1,x               ;   ones would make every row look occupied
000525r 2  1D rr rr       ora Board + 2,x
000528r 2  1D rr rr       ora Board + 3,x
00052Br 2  1D rr rr       ora Board + 4,x
00052Er 2  1D rr rr       ora Board + 5,x
000531r 2  D0 09          bne @Found
000533r 2  8A             txa
000534r 2  18             clc
000535r 2  69 08          adc #BOARD_STRIDE
000537r 2  AA             tax
000538r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
00053Ar 2  90 E3          bcc @Row
00053Cr 2               @Found:
00053Cr 2  86 rr          stx ScanTop
00053Er 2  60             rts
00053Fr 2               
00053Fr 2               ; -----------------------------------------------------------------------------
00053Fr 2               ;   The four passes (SPEC 6.2). Each sets a step and hands ScanLine its start
00053Fr 2               ;   cells; the start cell rides the stack because ScanLine needs both index
00053Fr 2               ;   registers and the scratch bytes below it.
00053Fr 2               ; -----------------------------------------------------------------------------
00053Fr 2               MatchScanHorizontal:            ; Every row of the pile, column 0 rightward
00053Fr 2  A9 01          lda #1
000541r 2  85 rr          sta ScanStep
000543r 2  A5 rr          lda ScanTop
000545r 2               @Line:
000545r 2  48             pha
000546r 2  20 rr rr       jsr ScanLine
000549r 2  68             pla
00054Ar 2  18             clc
00054Br 2  69 08          adc #BOARD_STRIDE
00054Dr 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
00054Fr 2  90 F4          bcc @Line
000551r 2  60             rts
000552r 2               
000552r 2               MatchScanVertical:              ; 6 columns, top of the pile downward
000552r 2  A9 08          lda #BOARD_STRIDE
000554r 2  85 rr          sta ScanStep
000556r 2  4C rr rr       jmp ScanTopRow
000559r 2               
000559r 2               MatchScanDiagonal:              ; down-right: the top row, then the left edge
000559r 2  A9 09          lda #(BOARD_STRIDE + 1)
00055Br 2  85 rr          sta ScanStep
00055Dr 2  20 rr rr       jsr ScanTopRow
000560r 2  A9 00          lda #0
000562r 2  4C rr rr       jmp ScanEdgeColumn
000565r 2               
000565r 2               MatchScanAntiDiagonal:          ; down-left: the top row, then the right edge
000565r 2  A9 07          lda #(BOARD_STRIDE - 1)
000567r 2  85 rr          sta ScanStep
000569r 2  20 rr rr       jsr ScanTopRow
00056Cr 2  A9 05          lda #(BOARD_W - 1)
00056Er 2  4C rr rr       jmp ScanEdgeColumn
000571r 2               
000571r 2               ; -----------------------------------------------------------------------------
000571r 2               ;   ScanTopRow — scan a line from each of the six cells of the pile's top row
000571r 2               ;   ScanEdgeColumn — and from the rows below it, in the column in A
000571r 2               ;   In:  ScanStep set, ScanTop set; A = column (ScanEdgeColumn only)
000571r 2               ;
000571r 2               ;   Between them those are every start cell a diagonal needs, and the top row
000571r 2               ;   alone is every start cell the vertical pass needs. The top row is scanned
000571r 2               ;   by the first, so the second skips it rather than scanning the longest
000571r 2               ;   diagonal twice.
000571r 2               ; -----------------------------------------------------------------------------
000571r 2               ScanTopRow:
000571r 2  A5 rr          lda ScanTop
000573r 2               @Line:
000573r 2  48             pha
000574r 2  20 rr rr       jsr ScanLine
000577r 2  68             pla
000578r 2  18             clc
000579r 2  69 01          adc #1
00057Br 2  48             pha                           ; Six columns of that row, whichever row it
00057Cr 2  29 07          and #(BOARD_STRIDE - 1)       ;   is, so it is the COLUMN that ends the loop
00057Er 2  C9 06          cmp #BOARD_W                  ;   and not the index
000580r 2  68             pla                           ; PLA leaves C alone
000581r 2  90 F0          bcc @Line
000583r 2  60             rts
000584r 2               
000584r 2               ScanEdgeColumn:
000584r 2  18             clc
000585r 2  65 rr          adc ScanTop                   ; That column, on the pile's top row...
000587r 2  18             clc
000588r 2  69 08          adc #BOARD_STRIDE             ;   ...and then the row below it
00058Ar 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
00058Cr 2  B0 0C          bcs @Done                     ; The pile is one row deep — there is no below
00058Er 2               @Line:
00058Er 2  48             pha
00058Fr 2  20 rr rr       jsr ScanLine
000592r 2  68             pla
000593r 2  18             clc
000594r 2  69 08          adc #BOARD_STRIDE
000596r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000598r 2  90 F4          bcc @Line
00059Ar 2               @Done:
00059Ar 2  60             rts
00059Br 2               
00059Br 2               ; -----------------------------------------------------------------------------
00059Br 2               ;   ScanLine — walk one line, marking every run of MATCH_MIN or more
00059Br 2               ;   In:  A = start board index, ScanStep = direction
00059Br 2               ;   Out: nothing.  Modifies: A, X, Scan*, Marks, RunCount
00059Br 2               ;
00059Br 2               ;   ONLY A WALL ENDS THE LINE. A hole in the middle of a row breaks the run
00059Br 2               ;   and the walk carries on past it, because the cells beyond it are a run of
00059Br 2               ;   their own — a line that stopped at the first empty cell would never look
00059Br 2               ;   below the top of the pile at all, which is very nearly the whole board.
00059Br 2               ;
00059Br 2               ;   A colour change ends the run and starts a new one at the cell that broke
00059Br 2               ;   it — the cell that broke a red run is the first cell of the blue one, and
00059Br 2               ;   any prisms that were riding the red run stay with the red run. SPEC 6.3
00059Br 2               ;   gives a wildcard to the run it is already in, not to both.
00059Br 2               ; -----------------------------------------------------------------------------
00059Br 2               ScanLine:
00059Br 2  AA             tax                           ; The cursor lives in X for the whole line:
00059Cr 2  A9 FF          lda #$FF                      ;   this loop runs about four hundred times a
00059Er 2  85 rr          sta ScanColor                 ;   scan and every cycle in it is four hundred
0005A0r 2  A9 00          lda #0                        ;   cycles of the frame
0005A2r 2  85 rr          sta ScanLen
0005A4r 2               
0005A4r 2               @Cell:
0005A4r 2  BD rr rr       lda Board,x
0005A7r 2  F0 41          beq @Gap                      ; A hole breaks the run, not the line
0005A9r 2  C9 FF          cmp #TILE_WALL
0005ABr 2  F0 52          beq @End                      ; A wall is where the line stops
0005ADr 2  29 F8          and #COLOR_MASK               ; The colour key, glyph discarded (SPEC 4.2)
0005AFr 2  C5 rr          cmp ScanColor
0005B1r 2  F0 19          beq @Grow                     ; Same colour — the commonest case, first
0005B3r 2  C9 70          cmp #WILD_BASE
0005B5r 2  F0 15          beq @Grow                     ; A prism continues any run (SPEC 6.3)
0005B7r 2               
0005B7r 2  A8             tay                           ; A different colour. Park it: everything
0005B8r 2  A5 rr          lda ScanColor                 ;   below either adopts it or starts a run
0005BAr 2  30 0E          bmi @Adopt                    ;   with it. $FF is the only value here with
0005BCr 2                                               ;   bit 7 set — colours are $40 to $70
0005BCr 2  A5 rr          lda ScanLen
0005BEr 2  C9 03          cmp #MATCH_MIN
0005C0r 2  B0 14          bcs @Close                    ; The run it broke was long enough to mark
0005C2r 2               
0005C2r 2  84 rr          sty ScanColor                 ; It was not, so no call and no marking: this
0005C4r 2  A9 01          lda #1                        ;   cell is simply the start of the next run.
0005C6r 2  85 rr          sta ScanLen                   ;   Five adjacent cells in six differ in
0005C8r 2  D0 04          bne @Advance                  ;   colour, so this is the path that decides
0005CAr 2                                               ;   what a scan costs
0005CAr 2               @Adopt:
0005CAr 2  84 rr          sty ScanColor
0005CCr 2               @Grow:
0005CCr 2  E6 rr          inc ScanLen
0005CEr 2               @Advance:
0005CEr 2  8A             txa
0005CFr 2  18             clc
0005D0r 2  65 rr          adc ScanStep
0005D2r 2  AA             tax
0005D3r 2  4C rr rr       jmp @Cell
0005D6r 2               
0005D6r 2               @Close:
0005D6r 2  86 rr          stx ScanIdx
0005D8r 2  20 rr rr       jsr MatchEmit                 ; Mark it — and MatchEmit leaves ScanLen zero
0005DBr 2  A6 rr          ldx ScanIdx
0005DDr 2  BD rr rr       lda Board,x
0005E0r 2  29 F8          and #COLOR_MASK
0005E2r 2  85 rr          sta ScanColor
0005E4r 2  A9 01          lda #1
0005E6r 2  85 rr          sta ScanLen
0005E8r 2  D0 E4          bne @Advance                  ; Always
0005EAr 2               
0005EAr 2               @Gap:
0005EAr 2  A5 rr          lda ScanLen
0005ECr 2  F0 E0          beq @Advance                  ; Nothing running — step over the hole. This
0005EEr 2                                               ;   is the cell the scan meets most often, so
0005EEr 2                                               ;   it is the one that must not call anything
0005EEr 2  86 rr          stx ScanIdx
0005F0r 2  20 rr rr       jsr MatchEmit                 ; Close the run the hole broke...
0005F3r 2  A6 rr          ldx ScanIdx
0005F5r 2  A9 FF          lda #$FF
0005F7r 2  85 rr          sta ScanColor                 ;   ...and start again on the far side of it
0005F9r 2  A9 00          lda #0
0005FBr 2  85 rr          sta ScanLen
0005FDr 2  F0 CF          beq @Advance                  ; Always
0005FFr 2               
0005FFr 2               @End:
0005FFr 2  A5 rr          lda ScanLen
000601r 2  F0 05          beq @Nothing                  ; The line ran out with nothing in hand
000603r 2  86 rr          stx ScanIdx
000605r 2  4C rr rr       jmp MatchEmit                 ; Whatever was running ends with the line
000608r 2               @Nothing:
000608r 2  60             rts
000609r 2               
000609r 2               ; -----------------------------------------------------------------------------
000609r 2               ;   MatchEmit — a run has ended; mark it if it was long enough
000609r 2               ;   In:  ScanIdx = one cell PAST the run's last, ScanLen, ScanColor, ScanStep
000609r 2               ;   Out: nothing.  Modifies: A, X, Y, ScanEnd, ScanLen, RunCount, Marks
000609r 2               ;
000609r 2               ;   Runs are marked, not removed: a cell can be in a horizontal run and a
000609r 2               ;   vertical one at once, and it clears once while both runs score (SPEC 6.1).
000609r 2               ;   The union is what the MARKS bitmap is for.
000609r 2               ;
000609r 2               ;   SCORING HAPPENS HERE, before the mark loop and for the same reason the
000609r 2               ;   comment above used to promise it would: ScanLen still describes the run at
000609r 2               ;   this point and nowhere else, because the mark loop counts it down to zero
000609r 2               ;   on its way back along the line. MatchScoreRun leaves it alone.
000609r 2               ; -----------------------------------------------------------------------------
000609r 2               MatchEmit:
000609r 2  A5 rr          lda ScanLen
00060Br 2  C9 03          cmp #MATCH_MIN
00060Dr 2  90 1D          bcc @Done                     ; Two in a row is not a run
00060Fr 2               
00060Fr 2  EE rr rr       inc RunCount
000612r 2  20 rr rr       jsr MatchScoreRun             ; SPEC 8 step 2, per run
000615r 2  A5 rr          lda ScanIdx
000617r 2  38             sec
000618r 2  E5 rr          sbc ScanStep                  ; Back onto the run's last cell
00061Ar 2  85 rr          sta ScanEnd
00061Cr 2               @Mark:
00061Cr 2  A5 rr          lda ScanEnd
00061Er 2  20 rr rr       jsr MarkSet
000621r 2  A5 rr          lda ScanEnd
000623r 2  38             sec
000624r 2  E5 rr          sbc ScanStep
000626r 2  85 rr          sta ScanEnd
000628r 2  C6 rr          dec ScanLen
00062Ar 2  D0 F0          bne @Mark
00062Cr 2               @Done:
00062Cr 2  60             rts
00062Dr 2               
00062Dr 2               ; -----------------------------------------------------------------------------
00062Dr 2               ;   MatchScoreRun — the two per-run awards of SPEC 8 step 2
00062Dr 2               ;   In:  ScanLen = run length, ChainStep = the cascade step this is
00062Dr 2               ;   Out: nothing.  Modifies: A, X, Y.  Leaves ScanLen and ScanColor alone.
00062Dr 2               ;
00062Dr 2               ;       cascade_pts += length * TileValue[chain]
00062Dr 2               ;       cascade_pts += LengthBonus[length]
00062Dr 2               ;
00062Dr 2               ;   A cell in a horizontal run AND a vertical one is scored by both, and
00062Dr 2               ;   removed once (SPEC 6.1) — which is why this is per run and not per marked
00062Dr 2               ;   cell, and why it runs before the union in MARKS has anything to say.
00062Dr 2               ;
00062Dr 2               ;   MultiBonus is NOT here: it is per step, not per run, and CascadeStep adds
00062Dr 2               ;   it once the four passes have finished counting.
00062Dr 2               ; -----------------------------------------------------------------------------
00062Dr 2               MatchScoreRun:
00062Dr 2  AE rr rr       ldx ChainStep
000630r 2  CA             dex                           ; TileValue is indexed by chain - 1 ...
000631r 2  E0 08          cpx #8
000633r 2  90 02          bcc @Chain
000635r 2  A2 07          ldx #7                        ;   ... and flattens out at 8 (SPEC 9.1)
000637r 2               @Chain:
000637r 2  A4 rr          ldy ScanLen                   ; The multiply is Y additions (score.asm)
000639r 2  BD rr rr       lda TileValueLo,x
00063Cr 2  48             pha
00063Dr 2  BD rr rr       lda TileValueHi,x
000640r 2  AA             tax
000641r 2  68             pla
000642r 2  20 rr rr       jsr CascadeAddTimes
000645r 2               
000645r 2  A6 rr          ldx ScanLen
000647r 2  CA             dex
000648r 2  CA             dex
000649r 2  CA             dex                           ; LengthBonus is indexed by length - 3 ...
00064Ar 2  E0 05          cpx #5
00064Cr 2  90 02          bcc @Length
00064Er 2  A2 04          ldx #4                        ;   ... and flattens out at 7 (SPEC 9.3). A
000650r 2               @Length:                        ;   vertical run can be all sixteen rows long
000650r 2  BD rr rr       lda LengthBonusLo,x
000653r 2  48             pha
000654r 2  BD rr rr       lda LengthBonusHi,x
000657r 2  AA             tax
000658r 2  68             pla
000659r 2  4C rr rr       jmp CascadeAdd
00065Cr 2               
00065Cr 2               ; -----------------------------------------------------------------------------
00065Cr 2               ;   MarksClear / MarkSet / MarkTest — the 16-byte bitmap
00065Cr 2               ;   One byte per row, bits 0-5 = columns 0-5. Union of runs is a free ORA.
00065Cr 2               ;
00065Cr 2               ;   MarkBits has eight entries rather than six so that the two sentinel
00065Cr 2               ;   columns index it harmlessly: bits 6 and 7 of a Marks byte are never set,
00065Cr 2               ;   so a walk over the whole 8-byte stride can test every cell it meets
00065Cr 2               ;   without first asking whether the cell is a wall.
00065Cr 2               ; -----------------------------------------------------------------------------
00065Cr 2               MarkBits:
00065Cr 2  01 02 04 08    .byte $01, $02, $04, $08, $10, $20, $40, $80
000660r 2  10 20 40 80  
000664r 2               
000664r 2               MarksClear:
000664r 2  A9 00          lda #0
000666r 2  A2 00          ldx #0
000668r 2               @Row:
000668r 2  9D rr rr       sta Marks,x
00066Br 2  E8             inx
00066Cr 2  E0 10          cpx #MARKS_BYTES
00066Er 2  D0 F8          bne @Row
000670r 2  60             rts
000671r 2               
000671r 2               MarkSet:                        ; In: A = board index.  Modifies: A, X, Y
000671r 2  AA             tax
000672r 2  29 07          and #(BOARD_STRIDE - 1)
000674r 2  A8             tay                           ; Y = column
000675r 2  8A             txa
000676r 2  4A             lsr a
000677r 2  4A             lsr a
000678r 2  4A             lsr a
000679r 2  AA             tax                           ; X = row
00067Ar 2  BD rr rr       lda Marks,x
00067Dr 2  19 rr rr       ora MarkBits,y
000680r 2  9D rr rr       sta Marks,x
000683r 2  60             rts
000684r 2               
000684r 2               MarkTest:                       ; In: A = board index.  Out: C set if marked
000684r 2  AA             tax                           ;     Modifies: A, X, Y
000685r 2  29 07          and #(BOARD_STRIDE - 1)
000687r 2  A8             tay
000688r 2  8A             txa
000689r 2  4A             lsr a
00068Ar 2  4A             lsr a
00068Br 2  4A             lsr a
00068Cr 2  AA             tax
00068Dr 2  BD rr rr       lda Marks,x
000690r 2  39 rr rr       and MarkBits,y
000693r 2  F0 02          beq @No
000695r 2  38             sec
000696r 2  60             rts
000697r 2               @No:
000697r 2  18             clc
000698r 2  60             rts
000699r 2               
000699r 1               .include "../src/cascade.asm"
000699r 2               ; =============================================================================
000699r 2               ;   cascade.asm — Wizards Lab, clear resolution
000699r 2               ; =============================================================================
000699r 2               ;   SPEC.md section 8. A cascade runs from the moment a piece locks until no
000699r 2               ;   further matches exist, one step per iteration, with ChainStep counting the
000699r 2               ;   steps. The step order is fixed:
000699r 2               ;
000699r 2               ;       scan -> score matches -> enqueue reagents -> resolve queue
000699r 2               ;            -> animate -> remove -> level check -> gravity -> repeat
000699r 2               ;
000699r 2               ;   The effect queue always drains. Effects only ever remove tiles, never add
000699r 2               ;   them, and each cell can be marked at most once, so the queue is bounded by
000699r 2               ;   the 96 cells of the playfield.
000699r 2               ; =============================================================================
000699r 2               
000699r 2               ; -----------------------------------------------------------------------------
000699r 2               ;   CascadeBegin — called immediately after PieceLock
000699r 2               ;   Out: nothing.  Modifies: A
000699r 2               ; -----------------------------------------------------------------------------
000699r 2               CascadeBegin:
000699r 2  A9 01          lda #1
00069Br 2  8D rr rr       sta ChainStep                 ; The step about to run is step 1 (SPEC 8)
00069Er 2  A9 00          lda #0
0006A0r 2  8D rr rr       sta CascadeLo
0006A3r 2  8D rr rr       sta CascadeMid
0006A6r 2  8D rr rr       sta CascadeHi
0006A9r 2  8D rr rr       sta StarCount
0006ACr 2  8D rr rr       sta RunCount
0006AFr 2  4C rr rr       jmp EffectQClear
0006B2r 2               
0006B2r 2               ; -----------------------------------------------------------------------------
0006B2r 2               ;   CascadeStep — run one step's scan and take what it found off the board
0006B2r 2               ;   In:  nothing
0006B2r 2               ;   Out: C set if anything matched, and the caller should let the pile fall.
0006B2r 2               ;        C clear when nothing matched and the cascade has settled.
0006B2r 2               ;        Modifies: A, X, Y, Scan*, CellCount, Marks, RunCount
0006B2r 2               ;
0006B2r 2               ;   Steps 3 to 5 of SPEC 8 are still to come: P5 enqueues and resolves the
0006B2r 2               ;   reagents among the marked cells, and P6 puts the glow and the shatter
0006B2r 2               ;   between the scan and the removal. Both land between the calls below
0006B2r 2               ;   without moving any of them, which is the reason the step is split into a
0006B2r 2               ;   scan and a removal that a sub-state can sit between.
0006B2r 2               ;
0006B2r 2               ;   Step 2's per-run half is in MatchEmit, which is the one moment a run's
0006B2r 2               ;   length and colour are both in hand; what is left of it here is the bonus
0006B2r 2               ;   for having found several at once, which nothing knows until all four
0006B2r 2               ;   passes have finished.
0006B2r 2               ; -----------------------------------------------------------------------------
0006B2r 2               CascadeStep:
0006B2r 2  20 rr rr       jsr MatchScan
0006B5r 2  F0 20          beq @Settled                  ; RunCount is zero — nothing left to clear
0006B7r 2               
0006B7r 2  AE rr rr       ldx RunCount                  ; SPEC 8 step 2, last line, and SPEC 9.4
0006BAr 2  CA             dex                           ; MultiBonus is indexed by runs - 1 ...
0006BBr 2  E0 05          cpx #5
0006BDr 2  90 02          bcc @Multi
0006BFr 2  A2 04          ldx #4                        ;   ... and flattens out at 5
0006C1r 2               @Multi:
0006C1r 2  BD rr rr       lda MultiBonusLo,x
0006C4r 2  48             pha
0006C5r 2  BD rr rr       lda MultiBonusHi,x
0006C8r 2  AA             tax
0006C9r 2  68             pla
0006CAr 2  20 rr rr       jsr CascadeAdd
0006CDr 2               
0006CDr 2  20 rr rr       jsr CascadeRemove             ; SPEC 8 step 6
0006D0r 2  A5 rr          lda CellCount
0006D2r 2  20 rr rr       jsr ScoreLevelCheck           ; SPEC 8 step 7 — match and effect removals
0006D5r 2  38             sec                           ;   both count, and by here they are the same
0006D6r 2  60             rts                           ;   cells
0006D7r 2               @Settled:
0006D7r 2  18             clc
0006D8r 2  60             rts
0006D9r 2               
0006D9r 2               ; -----------------------------------------------------------------------------
0006D9r 2               ;   CascadeRemove — empty every marked cell and queue it for redraw
0006D9r 2               ;   In:  Marks
0006D9r 2               ;   Out: CellCount = cells removed.  Modifies: A, X, Y, CellCount, RedrawCol
0006D9r 2               ;   SPEC 8 step 6.
0006D9r 2               ;
0006D9r 2               ;   At most 96 cells and the ring holds 64 — but a marked cell is a cell that
0006D9r 2               ;   just matched, and a board cannot hold more matches than it holds tiles
0006D9r 2               ;   that a single piece completed. The worst real case is a handful. This one
0006D9r 2               ;   does NOT need the cursor treatment BoardGravityStep gets: gravity moves
0006D9r 2               ;   cells that were never marked, and can genuinely touch the whole well.
0006D9r 2               ;
0006D9r 2               ;   CellCount goes to ScoreLevelCheck — thirty cleared tiles is a level
0006D9r 2               ;   (SPEC 10.1) — and P6 will have animated these cells before they go.
0006D9r 2               ; -----------------------------------------------------------------------------
0006D9r 2               CascadeRemove:
0006D9r 2  A9 00          lda #0
0006DBr 2  85 rr          sta CellCount
0006DDr 2  AA             tax                           ; X = board index, walked a row at a time
0006DEr 2               @Row:
0006DEr 2  8A             txa
0006DFr 2  4A             lsr a
0006E0r 2  4A             lsr a
0006E1r 2  4A             lsr a
0006E2r 2  A8             tay
0006E3r 2  B9 rr rr       lda Marks,y
0006E6r 2  F0 27          beq @NextRow                  ; Nothing marked in this row, and most rows
0006E8r 2                                               ;   hold nothing marked
0006E8r 2               @Cell:
0006E8r 2  8A             txa
0006E9r 2  48             pha
0006EAr 2  20 rr rr       jsr MarkTest
0006EDr 2  68             pla
0006EEr 2  AA             tax                           ; MarkTest needs X, so the cursor comes back
0006EFr 2  90 0E          bcc @NextCell                 ;   through A. Neither PLA nor TAX touches C.
0006F1r 2  A9 00          lda #TILE_EMPTY
0006F3r 2  9D rr rr       sta Board,x
0006F6r 2  E6 rr          inc CellCount
0006F8r 2  8A             txa
0006F9r 2  48             pha
0006FAr 2  20 rr rr       jsr RenderCell
0006FDr 2  68             pla
0006FEr 2  AA             tax
0006FFr 2               @NextCell:
0006FFr 2  E8             inx
000700r 2  8A             txa
000701r 2  29 07          and #(BOARD_STRIDE - 1)
000703r 2  C9 06          cmp #BOARD_W
000705r 2  90 E1          bcc @Cell
000707r 2               
000707r 2  8A             txa                           ; X is on the row's first sentinel column;
000708r 2  18             clc                           ;   step over both of them
000709r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
00070Br 2  AA             tax
00070Cr 2  4C rr rr       jmp @Test
00070Fr 2               
00070Fr 2               @NextRow:
00070Fr 2  8A             txa
000710r 2  18             clc
000711r 2  69 08          adc #BOARD_STRIDE
000713r 2  AA             tax
000714r 2               @Test:
000714r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
000716r 2  90 C6          bcc @Row
000718r 2  60             rts
000719r 2               
000719r 2               ; -----------------------------------------------------------------------------
000719r 2               ;   CascadeSettle — apply the star multiplier and bank the points
000719r 2               ;   SPEC 8 SETTLE, SPEC 9.6 — the doubling covers the WHOLE cascade, including
000719r 2               ;   points scored before the star cleared.
000719r 2               ; -----------------------------------------------------------------------------
000719r 2               CascadeSettle:
000719r 2  AD rr rr       lda StarCount
00071Cr 2  C9 03          cmp #STAR_SHIFT_CAP
00071Er 2  90 02          bcc @Shift
000720r 2  A9 03          lda #STAR_SHIFT_CAP           ; x8 and no further, however many were caught
000722r 2               @Shift:
000722r 2  AA             tax
000723r 2  F0 06          beq @Bank
000725r 2               @Double:
000725r 2  20 rr rr       jsr CascadeDouble             ; A doubling in BCD is one self-addition
000728r 2  CA             dex
000729r 2  D0 FA          bne @Double
00072Br 2               @Bank:
00072Br 2  4C rr rr       jmp ScoreAdd                  ; Its carry is not read: ScoreHighCheck has
00072Er 2                                               ;   already raised the fanfare and the flash
00072Er 2                                               ;   itself, and does so exactly once
00072Er 2               
00072Er 2               ; -----------------------------------------------------------------------------
00072Er 2               ;   The five reagents (SPEC 7.3). Each marks its targets, scores them at
00072Er 2               ;   EffectValue[chain], and pushes any reagent it uncovers back onto the queue.
00072Er 2               ; -----------------------------------------------------------------------------
00072Er 2               EffectFireball:                   ; In: A = colour key. Every tile of it, board wide.
00072Er 2  60             rts                             ;     Prisms are immune — they have no colour.
00072Fr 2               
00072Fr 2               EffectBolt:                       ; In: X = row, Y = column. Row + column, <= 21 cells.
00072Fr 2  60             rts
000730r 2               
000730r 2               EffectBomb:                       ; In: X = row, Y = column. 3x3, clipped at the edges.
000730r 2  60             rts
000731r 2               
000731r 2               EffectStar:                       ; Removes nothing; StarCount += 1, capped later.
000731r 2  60             rts
000732r 2               
000732r 2               EffectPrism:                      ; Removes nothing; awards BONUS_PRISM.
000732r 2  60             rts
000733r 2               
000733r 2               ; -----------------------------------------------------------------------------
000733r 2               ;   The effect queue — a ring of (glyph, row, col) packed into two bytes.
000733r 2               ;   On overflow an effect is dropped rather than growing the buffer; with at
000733r 2               ;   most one reagent per piece, EFFECTQ_ENTRIES is not reachable in practice.
000733r 2               ; -----------------------------------------------------------------------------
000733r 2               EffectQClear:                   ; Real ahead of the rest of the queue, because
000733r 2  A9 00          lda #0                        ;   CascadeBegin has to start every cascade
000735r 2  8D rr rr       sta EffectQHead               ;   with an empty one and P5 is the phase that
000738r 2  8D rr rr       sta EffectQTail               ;   first puts something in it
00073Br 2  60             rts
00073Cr 2               
00073Cr 2               EffectQPush:                      ; In: A = glyph, X = row, Y = column
00073Cr 2  60             rts
00073Dr 2               
00073Dr 2               EffectQPop:                       ; Out: C clear if empty
00073Dr 2  18             clc
00073Er 2  60             rts
00073Fr 2               
00073Fr 1               .include "../src/score.asm"
00073Fr 2               ; =============================================================================
00073Fr 2               ;   score.asm — Wizards Lab, scoring
00073Fr 2               ; =============================================================================
00073Fr 2               ;   SPEC.md section 9. Seven digits of packed BCD in four bytes, low byte
00073Fr 2               ;   first; the top nibble of ScoreTop is held at zero. Every value in
00073Fr 2               ;   tables.inc is a multiple of ten, so scoring is a SED / ADC chain and never
00073Fr 2               ;   a multiply — the one place a tile count has to be multiplied by a table
00073Fr 2               ;   value, it is done as a loop of BCD additions, and the count is at most 21.
00073Fr 2               ;
00073Fr 2               ;   The score clamps at 9999999. It never wraps.
00073Fr 2               ;
00073Fr 2               ;   Display is always all seven digits, zero padded — see TextBcd. Nothing
00073Fr 2               ;   here strips a leading zero, and nothing downstream may either.
00073Fr 2               ;
00073Fr 2               ;   TWO WAYS IN, AND THEY ARE NOT INTERCHANGEABLE (D5):
00073Fr 2               ;
00073Fr 2               ;     CascadeAdd / CascadeAddTimes    points scored INSIDE a cascade. They go
00073Fr 2               ;                                     into Cascade{Lo,Mid,Hi} and stay there
00073Fr 2               ;                                     until CascadeSettle, because a star
00073Fr 2               ;                                     caught anywhere in the cascade doubles
00073Fr 2               ;                                     everything it scored, retroactively
00073Fr 2               ;                                     (SPEC 9.6).
00073Fr 2               ;     ScoreAward                      the awards SPEC 9.6 gives outside a
00073Fr 2               ;                                     cascade — the soft drop and the level-up
00073Fr 2               ;                                     bonus. These reach Score at once and a
00073Fr 2               ;                                     star never touches them.
00073Fr 2               ;
00073Fr 2               ;   Both funnel through ScoreBank, which is the only routine that writes
00073Fr 2               ;   Score, the only one that clamps, and the only one that can hand the high
00073Fr 2               ;   score over to the player.
00073Fr 2               ; =============================================================================
00073Fr 2               
00073Fr 2               ; -----------------------------------------------------------------------------
00073Fr 2               ;   ScoreHighInit — seed the session high score, once, at power-on
00073Fr 2               ;   SPEC 9.8 — the high score is not persisted; it starts at 0010000 on every
00073Fr 2               ;   power-on, which is the target the first game is played against. It then
00073Fr 2               ;   survives every game in the session, so this is deliberately NOT part of
00073Fr 2               ;   ScoreReset. Nothing may infer "cold boot" from the value being zero: BSS
00073Fr 2               ;   is not cleared on all three machines.
00073Fr 2               ;   Out: nothing.  Modifies: A
00073Fr 2               ; -----------------------------------------------------------------------------
00073Fr 2               ScoreHighInit:
00073Fr 2  A9 00          lda #HIGH_INIT_LO
000741r 2  8D rr rr       sta HighLo
000744r 2  A9 00          lda #HIGH_INIT_MID
000746r 2  8D rr rr       sta HighMid
000749r 2  A9 01          lda #HIGH_INIT_HI
00074Br 2  8D rr rr       sta HighHi
00074Er 2  A9 00          lda #HIGH_INIT_TOP
000750r 2  8D rr rr       sta HighTop
000753r 2  A9 01          lda #$01                      ; BCD — the level the target was "set" on
000755r 2  8D rr rr       sta HighLevel
000758r 2  60             rts
000759r 2               
000759r 2               ; -----------------------------------------------------------------------------
000759r 2               ;   ScoreReset — zero the score for a new game
000759r 2               ;   Out: nothing.  Modifies: A
000759r 2               ;
000759r 2               ;   The high score itself is NOT reset (SPEC 9.8) — but the two flags that say
000759r 2               ;   what this game has done about it are, or the second game of a session
000759r 2               ;   would never flash.
000759r 2               ; -----------------------------------------------------------------------------
000759r 2               ScoreReset:
000759r 2  A9 00          lda #0
00075Br 2  8D rr rr       sta ScoreLo
00075Er 2  8D rr rr       sta ScoreMid
000761r 2  8D rr rr       sta ScoreHi
000764r 2  8D rr rr       sta ScoreTop
000767r 2  8D rr rr       sta CascadeLo
00076Ar 2  8D rr rr       sta CascadeMid
00076Dr 2  8D rr rr       sta CascadeHi
000770r 2  8D rr rr       sta StarCount
000773r 2  8D rr rr       sta HighOwned
000776r 2  8D rr rr       sta HighFlash
000779r 2  8D rr rr       sta HighTimer
00077Cr 2  60             rts
00077Dr 2               
00077Dr 2               ; -----------------------------------------------------------------------------
00077Dr 2               ;   CascadeAdd — add a 16-bit BCD value to the cascade accumulator
00077Dr 2               ;   In:  A = low BCD byte, X = high BCD byte
00077Dr 2               ;   Out: nothing.  Modifies: A, flags.  PRESERVES X and Y.
00077Dr 2               ;
00077Dr 2               ;   Preserving X and Y is what lets CascadeAddTimes loop over this without
00077Dr 2               ;   spilling anything, and Tmp0-Tmp3 may not be held across a JSR anyway
00077Dr 2               ;   (zeropage.inc).
00077Dr 2               ; -----------------------------------------------------------------------------
00077Dr 2               CascadeAdd:
00077Dr 2  F8             sed
00077Er 2  18             clc
00077Fr 2  6D rr rr       adc CascadeLo
000782r 2  8D rr rr       sta CascadeLo
000785r 2  8A             txa
000786r 2  6D rr rr       adc CascadeMid
000789r 2  8D rr rr       sta CascadeMid
00078Cr 2  AD rr rr       lda CascadeHi
00078Fr 2  69 00          adc #0
000791r 2  8D rr rr       sta CascadeHi
000794r 2  D8             cld                           ; CLD leaves the carry alone
000795r 2  B0 01          bcs CascadeClamp
000797r 2  60             rts
000798r 2               
000798r 2               ; -----------------------------------------------------------------------------
000798r 2               ;   CascadeClamp — six nines, when an accumulate would have wrapped
000798r 2               ;   Out: nothing.  Modifies: A.  PRESERVES X and Y.
000798r 2               ;
000798r 2               ;   Not reachable by playing: nothing is ever ADDED to the board during a
000798r 2               ;   cascade, so one cascade can never remove more than the 96 cells the well
000798r 2               ;   holds, and 96 cells at the dearest tile value there is (650, SPEC 9.2)
000798r 2               ;   plus every bonus in section 9 comes to a little over 200,000 — a fifth of
000798r 2               ;   what three bytes hold, and an eighth of what it would take to wrap after
000798r 2               ;   the star cap has doubled it three times. It is here because "never wraps"
000798r 2               ;   in SPEC 9 has to be true of every accumulator on the path, not just of the
000798r 2               ;   one the player can see.
000798r 2               ; -----------------------------------------------------------------------------
000798r 2               CascadeClamp:
000798r 2  A9 99          lda #$99
00079Ar 2  8D rr rr       sta CascadeLo
00079Dr 2  8D rr rr       sta CascadeMid
0007A0r 2  8D rr rr       sta CascadeHi
0007A3r 2  60             rts
0007A4r 2               
0007A4r 2               ; -----------------------------------------------------------------------------
0007A4r 2               ;   CascadeAddTimes — add a value N times (the tiles-cleared multiply)
0007A4r 2               ;   In:  A = low BCD, X = high BCD, Y = count
0007A4r 2               ;   Out: nothing.  Modifies: A, Y, flags.  PRESERVES X.
0007A4r 2               ;
0007A4r 2               ;   SPEC 9 chose values that are all multiples of ten so that scoring is an
0007A4r 2               ;   ADC chain, but `length * TileValue[chain]` is still a multiply. The count
0007A4r 2               ;   is a run length — three to sixteen — so a loop of BCD additions is both
0007A4r 2               ;   smaller and, at these counts, faster than any multiply routine worth
0007A4r 2               ;   writing.
0007A4r 2               ; -----------------------------------------------------------------------------
0007A4r 2               CascadeAddTimes:
0007A4r 2  48             pha                           ; The low byte rides the stack, because
0007A5r 2               @Loop:                          ;   CascadeAdd returns in A
0007A5r 2  C0 00          cpy #0
0007A7r 2  F0 08          beq @Done
0007A9r 2  68             pla
0007AAr 2  48             pha
0007ABr 2  20 rr rr       jsr CascadeAdd
0007AEr 2  88             dey
0007AFr 2  D0 F4          bne @Loop
0007B1r 2               @Done:
0007B1r 2  68             pla
0007B2r 2  60             rts
0007B3r 2               
0007B3r 2               ; -----------------------------------------------------------------------------
0007B3r 2               ;   CascadeDouble — one BCD doubling of the cascade accumulator
0007B3r 2               ;   Out: nothing.  Modifies: A, flags.  PRESERVES X and Y.
0007B3r 2               ;   A doubling in BCD is a self-addition; three of them is the star cap.
0007B3r 2               ; -----------------------------------------------------------------------------
0007B3r 2               CascadeDouble:
0007B3r 2  F8             sed
0007B4r 2  18             clc
0007B5r 2  AD rr rr       lda CascadeLo
0007B8r 2  6D rr rr       adc CascadeLo
0007BBr 2  8D rr rr       sta CascadeLo
0007BEr 2  AD rr rr       lda CascadeMid
0007C1r 2  6D rr rr       adc CascadeMid
0007C4r 2  8D rr rr       sta CascadeMid
0007C7r 2  AD rr rr       lda CascadeHi
0007CAr 2  6D rr rr       adc CascadeHi
0007CDr 2  8D rr rr       sta CascadeHi
0007D0r 2  D8             cld
0007D1r 2  B0 C5          bcs CascadeClamp
0007D3r 2  60             rts
0007D4r 2               
0007D4r 2               ; -----------------------------------------------------------------------------
0007D4r 2               ;   ScoreAdd — bank the cascade accumulator into Score, clamped
0007D4r 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
0007D4r 2               ;   SPEC 9.8 — the high score updates live, so the player watches the overtake.
0007D4r 2               ; -----------------------------------------------------------------------------
0007D4r 2               ScoreAdd:
0007D4r 2  AD rr rr       lda CascadeLo
0007D7r 2  85 rr          sta Tmp0
0007D9r 2  AD rr rr       lda CascadeMid
0007DCr 2  85 rr          sta Tmp1
0007DEr 2  AD rr rr       lda CascadeHi
0007E1r 2  85 rr          sta Tmp2
0007E3r 2  4C rr rr       jmp ScoreBank
0007E6r 2               
0007E6r 2               ; -----------------------------------------------------------------------------
0007E6r 2               ;   ScoreAward — add a 16-bit BCD value straight to Score
0007E6r 2               ;   In:  A = low BCD byte, X = high BCD byte
0007E6r 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
0007E6r 2               ;
0007E6r 2               ;   The two awards SPEC 9.6 gives outside a cascade: one point a row for a
0007E6r 2               ;   soft drop, and BONUS_LEVELUP when the level advances. Neither is a cascade
0007E6r 2               ;   point and neither is doubled by a star, which is the whole reason they do
0007E6r 2               ;   not go through CascadeAdd.
0007E6r 2               ; -----------------------------------------------------------------------------
0007E6r 2               ScoreAward:
0007E6r 2  85 rr          sta Tmp0
0007E8r 2  86 rr          stx Tmp1
0007EAr 2  A9 00          lda #0
0007ECr 2  85 rr          sta Tmp2
0007EEr 2                 ; falls through into ScoreBank
0007EEr 2               
0007EEr 2               ; -----------------------------------------------------------------------------
0007EEr 2               ;   ScoreBank — Score += the three BCD bytes in Tmp0-Tmp2, clamped at 9999999
0007EEr 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
0007EEr 2               ;
0007EEr 2               ;   The only writer of Score. It redraws the field itself, because there is no
0007EEr 2               ;   other moment at which the score is known to have changed (SPEC 12.6 —
0007EEr 2               ;   nothing polls).
0007EEr 2               ; -----------------------------------------------------------------------------
0007EEr 2               ScoreBank:
0007EEr 2  F8             sed
0007EFr 2  18             clc
0007F0r 2  AD rr rr       lda ScoreLo
0007F3r 2  65 rr          adc Tmp0
0007F5r 2  8D rr rr       sta ScoreLo
0007F8r 2  AD rr rr       lda ScoreMid
0007FBr 2  65 rr          adc Tmp1
0007FDr 2  8D rr rr       sta ScoreMid
000800r 2  AD rr rr       lda ScoreHi
000803r 2  65 rr          adc Tmp2
000805r 2  8D rr rr       sta ScoreHi
000808r 2  AD rr rr       lda ScoreTop
00080Br 2  69 00          adc #0
00080Dr 2  8D rr rr       sta ScoreTop
000810r 2  D8             cld                           ; CLD leaves the carry alone
000811r 2  B0 07          bcs @Clamp
000813r 2  AD rr rr       lda ScoreTop                  ; The eighth digit is held at zero (SPEC 9),
000816r 2  C9 10          cmp #$10                      ;   so anything that reached it has overflowed
000818r 2  90 10          bcc @Drawn                    ;   the seven the panel shows
00081Ar 2               @Clamp:
00081Ar 2  A9 99          lda #$99
00081Cr 2  8D rr rr       sta ScoreLo
00081Fr 2  8D rr rr       sta ScoreMid
000822r 2  8D rr rr       sta ScoreHi
000825r 2  A9 09          lda #$09
000827r 2  8D rr rr       sta ScoreTop
00082Ar 2               @Drawn:
00082Ar 2  20 rr rr       jsr RenderScore
00082Dr 2                 ; falls through into ScoreHighCheck
00082Dr 2               
00082Dr 2               ; -----------------------------------------------------------------------------
00082Dr 2               ;   ScoreHighCheck — hand the high score over the moment the score reaches it
00082Dr 2               ;   Out: C set if the score is level with or past the high score — which, once
00082Dr 2               ;        it has been taken, is EVERY call. The one-shot is HighOwned below, not
00082Dr 2               ;        this flag; nothing currently reads it.  Modifies: A, X, Y, Tmp0
00082Dr 2               ;
00082Dr 2               ;   SPEC 9.8. The copy happens on every call once the score is level with the
00082Dr 2               ;   high score, not just on the first — that is what keeps HighLevel tracking
00082Dr 2               ;   the live level while a run is holding its own record, which is the point of
00082Dr 2               ;   the number: it says how deep you have to get to beat it.
00082Dr 2               ;
00082Dr 2               ;   The fanfare and the flash are the one-shot half, and HighOwned is what
00082Dr 2               ;   makes them one: without it every subsequent bank would fire them again,
00082Dr 2               ;   because from the overtake onward the score and the high score are equal.
00082Dr 2               ; -----------------------------------------------------------------------------
00082Dr 2               ScoreHighCheck:
00082Dr 2  AD rr rr       lda HighTop                   ; Four-byte compare, most significant first
000830r 2  CD rr rr       cmp ScoreTop
000833r 2  D0 16          bne @Test
000835r 2  AD rr rr       lda HighHi
000838r 2  CD rr rr       cmp ScoreHi
00083Br 2  D0 0E          bne @Test
00083Dr 2  AD rr rr       lda HighMid
000840r 2  CD rr rr       cmp ScoreMid
000843r 2  D0 06          bne @Test
000845r 2  AD rr rr       lda HighLo
000848r 2  CD rr rr       cmp ScoreLo
00084Br 2               @Test:
00084Br 2  90 02          bcc @Take                     ; high < score
00084Dr 2  D0 3E          bne @Behind                   ; high > score — nothing to do
00084Fr 2                                               ; equal: still copy, so HighLevel tracks
00084Fr 2               @Take:
00084Fr 2  AD rr rr       lda ScoreLo
000852r 2  8D rr rr       sta HighLo
000855r 2  AD rr rr       lda ScoreMid
000858r 2  8D rr rr       sta HighMid
00085Br 2  AD rr rr       lda ScoreHi
00085Er 2  8D rr rr       sta HighHi
000861r 2  AD rr rr       lda ScoreTop
000864r 2  8D rr rr       sta HighTop
000867r 2  20 rr rr       jsr ScoreLevelBcd             ; The level box under the digits is BCD; Level
00086Ar 2  8D rr rr       sta HighLevel                 ;   itself is binary (SPEC 12.2)
00086Dr 2  20 rr rr       jsr RenderHigh
000870r 2               
000870r 2  AD rr rr       lda HighOwned
000873r 2  D0 16          bne @Owned
000875r 2  EE rr rr       inc HighOwned
000878r 2  A9 0B          lda #SFX_HIGHSCORE            ; SPEC 9.8 — a longer fanfare, once
00087Ar 2  8D rr rr       sta SfxRequest
00087Dr 2  A9 06          lda #HIGH_FLASH_BLINKS
00087Fr 2  8D rr rr       sta HighFlash
000882r 2  AE rr rr       ldx Region
000885r 2  BD rr rr       lda BlinkHalf,x
000888r 2  8D rr rr       sta HighTimer
00088Br 2               @Owned:
00088Br 2  38             sec
00088Cr 2  60             rts
00088Dr 2               
00088Dr 2               @Behind:
00088Dr 2  18             clc
00088Er 2  60             rts
00088Fr 2               
00088Fr 2               ; -----------------------------------------------------------------------------
00088Fr 2               ;   ScoreLevelBcd — Level (binary 1-99) as one packed BCD byte
00088Fr 2               ;   Out: A = the level in BCD.  Modifies: A, X, Tmp0
00088Fr 2               ; -----------------------------------------------------------------------------
00088Fr 2               ScoreLevelBcd:
00088Fr 2  AD rr rr       lda Level
000892r 2  A2 00          ldx #0
000894r 2               @Tens:
000894r 2  C9 0A          cmp #10
000896r 2  90 05          bcc @Split
000898r 2  E9 0A          sbc #10                       ; Carry is set by the CMP that got us here
00089Ar 2  E8             inx
00089Br 2  D0 F7          bne @Tens                     ; Always — X tops out at 9
00089Dr 2               @Split:
00089Dr 2  85 rr          sta Tmp0                      ; Units
00089Fr 2  8A             txa
0008A0r 2  0A             asl a
0008A1r 2  0A             asl a
0008A2r 2  0A             asl a
0008A3r 2  0A             asl a
0008A4r 2  05 rr          ora Tmp0
0008A6r 2  60             rts
0008A7r 2               
0008A7r 2               ; -----------------------------------------------------------------------------
0008A7r 2               ;   ScoreSoftDrop — one point for one row descended under soft drop (SPEC 9.6)
0008A7r 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0-Tmp2
0008A7r 2               ;
0008A7r 2               ;   The one award in the game that is not a multiple of ten. BCD does not care.
0008A7r 2               ; -----------------------------------------------------------------------------
0008A7r 2               ScoreSoftDrop:
0008A7r 2  A9 01          lda #$01
0008A9r 2  A2 00          ldx #$00
0008ABr 2  4C rr rr       jmp ScoreAward
0008AEr 2               
0008AEr 2               ; -----------------------------------------------------------------------------
0008AEr 2               ;   ScoreLevelCheck — advance the level when 30 tiles have gone
0008AEr 2               ;   In:  A = tiles removed this step
0008AEr 2               ;   Out: C set if the level advanced.  Modifies: A, X, Y, Tmp0-Tmp2
0008AEr 2               ;   SPEC 10.1 — at most one advance per step, surplus carries over, so a big
0008AEr 2               ;   fireball chain can never skip a level. Match and effect removals both
0008AEr 2               ;   count, which is why the count comes from CascadeRemove and not from the
0008AEr 2               ;   scan: by then the two are the same cells.
0008AEr 2               ; -----------------------------------------------------------------------------
0008AEr 2               ScoreLevelCheck:
0008AEr 2  18             clc
0008AFr 2  6D rr rr       adc TilesCleared
0008B2r 2  8D rr rr       sta TilesCleared              ; A whole step can clear far more than thirty;
0008B5r 2  C9 1E          cmp #LEVEL_TILES              ;   the surplus stays here and buys the next
0008B7r 2  90 20          bcc @No                       ;   level on the next step
0008B9r 2  E9 1E          sbc #LEVEL_TILES              ; Carry is set by the CMP that got us here
0008BBr 2  8D rr rr       sta TilesCleared
0008BEr 2               
0008BEr 2  AD rr rr       lda Level
0008C1r 2  C9 63          cmp #LEVEL_MAX_SHOWN
0008C3r 2  B0 14          bcs @No                       ; The box is two digits wide (SPEC 10.1), and
0008C5r 2  EE rr rr       inc Level                     ;   nothing about level 100 is reachable in a
0008C8r 2  20 rr rr       jsr RenderLevel               ;   session anyway
0008CBr 2  A9 0A          lda #SFX_LEVELUP
0008CDr 2  8D rr rr       sta SfxRequest
0008D0r 2  A9 00          lda #<BONUS_LEVELUP           ; SPEC 9.6 — an award, not a cascade point, so
0008D2r 2  A2 10          ldx #>BONUS_LEVELUP           ;   a star in the same cascade does not double
0008D4r 2  20 rr rr       jsr ScoreAward                ;   it (D5)
0008D7r 2  38             sec
0008D8r 2  60             rts
0008D9r 2               @No:
0008D9r 2  18             clc
0008DAr 2  60             rts
0008DBr 2               
0008DBr 2               ; -----------------------------------------------------------------------------
0008DBr 2               ;   ScoreFlashTick — one frame of the HIGH field's overtake flash
0008DBr 2               ;   Out: nothing.  Modifies: A, X, Y
0008DBr 2               ;   SPEC 9.8, SPEC 14 — the blink period is 30 frames NTSC / 25 PAL, shared
0008DBr 2               ;   with the title screen's prompt, so HighFlash counts HALF blinks and
0008DBr 2               ;   HighTimer counts the frames of one.
0008DBr 2               ;
0008DBr 2               ;   HighFlash is odd on the dark half and even on the lit one, and it ends at
0008DBr 2               ;   zero, so the field is always left readable however the count is set.
0008DBr 2               ; -----------------------------------------------------------------------------
0008DBr 2               ScoreFlashTick:
0008DBr 2  AD rr rr       lda HighFlash
0008DEr 2  F0 1F          beq @Done
0008E0r 2  CE rr rr       dec HighTimer
0008E3r 2  D0 1A          bne @Done
0008E5r 2  CE rr rr       dec HighFlash
0008E8r 2  F0 12          beq @Show                     ; Out of blinks — end lit
0008EAr 2  AE rr rr       ldx Region
0008EDr 2  BD rr rr       lda BlinkHalf,x
0008F0r 2  8D rr rr       sta HighTimer
0008F3r 2  AD rr rr       lda HighFlash
0008F6r 2  4A             lsr a
0008F7r 2  90 03          bcc @Show
0008F9r 2  4C rr rr       jmp RenderHighBlank
0008FCr 2               @Show:
0008FCr 2  4C rr rr       jmp RenderHigh
0008FFr 2               @Done:
0008FFr 2  60             rts
000900r 2               
000900r 2               ; -----------------------------------------------------------------------------
000900r 2               ;   ScoreGravity — frames per row for the current level
000900r 2               ;   Out: A = frame count, from SpeedNTSC or SpeedPAL per Region.
000900r 2               ;        Modifies: A, X
000900r 2               ;   SPEC 10.2. Strictly this module is P4's, but the falling piece cannot fall
000900r 2               ;   without it, so it is real ahead of the rest of the file — the same reason
000900r 2               ;   ScoreHighInit landed here in P1.
000900r 2               ; -----------------------------------------------------------------------------
000900r 2               ScoreGravity:
000900r 2  AE rr rr       ldx Level
000903r 2  CA             dex                           ; The table is indexed by level - 1 ...
000904r 2  E0 10          cpx #LEVEL_SPEED_CAP
000906r 2  90 02          bcc @Level
000908r 2  A2 0F          ldx #LEVEL_SPEED_CAP - 1      ;   ... and stops improving at the cap
00090Ar 2               @Level:
00090Ar 2  AD rr rr       lda Region
00090Dr 2  D0 04          bne @Pal
00090Fr 2  BD rr rr       lda SpeedNTSC,x
000912r 2  60             rts
000913r 2               @Pal:
000913r 2  BD rr rr       lda SpeedPAL,x
000916r 2  60             rts
000917r 2               
000917r 1               .include "../src/render.asm"
000917r 2               ; =============================================================================
000917r 2               ;   render.asm — Wizards Lab, the dirty-cell renderer
000917r 2               ; =============================================================================
000917r 2               ;   SPEC.md section 12.6. The screen is never fully redrawn during play.
000917r 2               ;   Changed cells are appended to a ring and flushed once a frame, at most
000917r 2               ;   DIRTY_FLUSH_MAX per frame with the remainder carried over.
000917r 2               ;
000917r 2               ;   The cap is NOT a hardware write-spacing limit. S1 measured this loop at
000917r 2               ;   165 cycles a cell on the AC6502, which puts two VRAM data writes 165 us
000917r 2               ;   apart at 1 MHz and the closest two VDP PORT accesses 8 cycles apart —
000917r 2               ;   inside even a real TMS9918A's 8 us and 2 us windows with two orders of
000917r 2               ;   magnitude to spare, and further inside a pico9918's, which emulates VRAM
000917r 2               ;   in RP2040 memory and has no display contention at all. A 6502 at this
000917r 2               ;   clock cannot write a TMS9918 too fast however hard it tries.
000917r 2               ;
000917r 2               ;   The cap is a TIME BUDGET: DIRTY_FLUSH_MAX cells is what fits in vertical
000917r 2               ;   blank on the tightest of the three. See constants.inc and PLAN.md S1.
000917r 2               ;
000917r 2               ;   All screen access goes through HalPlotCell (see hal.inc). Nothing in this
000917r 2               ;   file knows where screen memory is.
000917r 2               ; =============================================================================
000917r 2               
000917r 2               ; -----------------------------------------------------------------------------
000917r 2               ;   RenderDirtyReset — empty the ring and cancel any outstanding board redraw
000917r 2               ;   Call this after anything that draws the whole screen behind the renderer's
000917r 2               ;   back (HalBlitScreen), because every queued cell then describes a screen
000917r 2               ;   that no longer exists.
000917r 2               ;   In:  nothing        Out: nothing.  Modifies: A
000917r 2               ; -----------------------------------------------------------------------------
000917r 2               RenderDirtyReset:
000917r 2  A9 00          lda #0
000919r 2  8D rr rr       sta DirtyCount
00091Cr 2  8D rr rr       sta DirtyHead
00091Fr 2  8D rr rr       sta DirtyTail
000922r 2  A9 FF          lda #$FF
000924r 2  8D rr rr       sta RedrawIdx
000927r 2  60             rts
000928r 2               
000928r 2               ; -----------------------------------------------------------------------------
000928r 2               ;   RenderMark — queue one panel cell
000928r 2               ;   In:  A = tile, X = panel column, Y = panel row
000928r 2               ;   Out: nothing.  Modifies: A, X.  PRESERVES Y and every byte of zero page.
000928r 2               ;
000928r 2               ;   The PANEL_X / PANEL_Y offset is applied here, once, so nothing upstream
000928r 2               ;   has to know which machine it is running on.
000928r 2               ;
000928r 2               ;   Preserving Y and zero page is a contract, not an accident: text.asm holds
000928r 2               ;   its string cursor across this call (see zeropage.inc). The three values
000928r 2               ;   ride the stack rather than scratch bytes because A, X and Y are all live
000928r 2               ;   at once and there is no fourth register to index the ring with.
000928r 2               ;
000928r 2               ;   A mark that arrives with the ring full is DROPPED, silently (D6).
000928r 2               ; -----------------------------------------------------------------------------
000928r 2               RenderMark:
000928r 2  48             pha                           ; Tile
000929r 2  98             tya
00092Ar 2  18             clc
00092Br 2  69 00          adc #PANEL_Y                  ; Panel row -> screen row
00092Dr 2  48             pha
00092Er 2  8A             txa
00092Fr 2  18             clc
000930r 2  69 00          adc #PANEL_X                  ; Panel column -> screen column
000932r 2  48             pha
000933r 2               
000933r 2  AD rr rr       lda DirtyCount
000936r 2  C9 40          cmp #DIRTY_ENTRIES
000938r 2  B0 1F          bcs @Full
00093Ar 2  EE rr rr       inc DirtyCount
00093Dr 2               
00093Dr 2  AE rr rr       ldx DirtyTail
000940r 2  68             pla
000941r 2  9D rr rr       sta Dirty+0,x                 ; Screen column
000944r 2  68             pla
000945r 2  9D rr rr       sta Dirty+1,x                 ; Screen row
000948r 2  68             pla
000949r 2  9D rr rr       sta Dirty+2,x                 ; Tile
00094Cr 2               
00094Cr 2  E8             inx                           ; Step one entry, wrapping the ring
00094Dr 2  E8             inx
00094Er 2  E8             inx
00094Fr 2  E0 C0          cpx #DIRTY_BYTES
000951r 2  90 02          bcc @Store
000953r 2  A2 00          ldx #0
000955r 2               @Store:
000955r 2  8E rr rr       stx DirtyTail
000958r 2  60             rts
000959r 2               
000959r 2               @Full:
000959r 2  68             pla                           ; Unwind and drop it. The cell is wrong until
00095Ar 2  68             pla                           ;   something marks it again.
00095Br 2  68             pla
00095Cr 2  60             rts
00095Dr 2               
00095Dr 2               ; -----------------------------------------------------------------------------
00095Dr 2               ;   RenderFlush — push up to DIRTY_FLUSH_MAX queued cells to the screen
00095Dr 2               ;   Called once per frame, from the top of the main loop.
00095Dr 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
00095Dr 2               ; -----------------------------------------------------------------------------
00095Dr 2               RenderFlush:
00095Dr 2  20 rr rr       jsr RenderBoardStep           ; Top the ring up from a board redraw, if one
000960r 2                                               ;   is outstanding, so it always makes progress
000960r 2  AD rr rr       lda DirtyCount
000963r 2  F0 31          beq @Done
000965r 2  C9 18          cmp #DIRTY_FLUSH_MAX
000967r 2  90 02          bcc @Budget
000969r 2  A9 18          lda #DIRTY_FLUSH_MAX
00096Br 2               @Budget:
00096Br 2  85 rr          sta FlushLeft
00096Dr 2               
00096Dr 2               @Cell:
00096Dr 2  AE rr rr       ldx DirtyHead
000970r 2  BD rr rr       lda Dirty+1,x
000973r 2  A8             tay                           ; Y = screen row
000974r 2  BD rr rr       lda Dirty+2,x
000977r 2  48             pha                           ; Tile
000978r 2  BD rr rr       lda Dirty+0,x
00097Br 2  AA             tax                           ; X = screen column
00097Cr 2  68             pla                           ; A = tile
00097Dr 2  20 rr rr       jsr HalPlotCell
000980r 2               
000980r 2  AD rr rr       lda DirtyHead                 ; Step one entry, wrapping the ring
000983r 2  18             clc
000984r 2  69 03          adc #3
000986r 2  C9 C0          cmp #DIRTY_BYTES
000988r 2  90 02          bcc @Store
00098Ar 2  A9 00          lda #0
00098Cr 2               @Store:
00098Cr 2  8D rr rr       sta DirtyHead
00098Fr 2  CE rr rr       dec DirtyCount
000992r 2  C6 rr          dec FlushLeft
000994r 2  D0 D7          bne @Cell
000996r 2               @Done:
000996r 2  60             rts
000997r 2               
000997r 2               ; -----------------------------------------------------------------------------
000997r 2               ;   RenderBoard — ask for the whole 6 x 16 well to be redrawn
000997r 2               ;   Used on state entry and after a pause, not per frame.
000997r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000997r 2               ;
000997r 2               ;   The well is 96 cells and the ring holds DIRTY_ENTRIES; a redraw therefore
000997r 2               ;   cannot be queued in one go. This only sets the cursor. RenderBoardStep,
000997r 2               ;   which RenderFlush calls every frame, feeds the ring as fast as it drains,
000997r 2               ;   so the redraw spreads over as many frames as it needs and never drops a
000997r 2               ;   cell.
000997r 2               ; -----------------------------------------------------------------------------
000997r 2               RenderBoard:
000997r 2  A9 00          lda #0
000999r 2  8D rr rr       sta RedrawIdx                 ; Board index 0 = row 0, column 0
00099Cr 2  60             rts                           ; And nothing else. Falling through into the
00099Dr 2                                               ;   step below would fill the ring here and
00099Dr 2                                               ;   drop whatever the caller marks next.
00099Dr 2               
00099Dr 2               ; -----------------------------------------------------------------------------
00099Dr 2               ;   RenderBoardStep — queue as much of an outstanding board redraw as fits
00099Dr 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
00099Dr 2               ;   Does nothing when RedrawIdx is $FF.
00099Dr 2               ; -----------------------------------------------------------------------------
00099Dr 2               RenderBoardStep:
00099Dr 2  AD rr rr       lda RedrawIdx
0009A0r 2  30 41          bmi @Done                     ; $FF — nothing outstanding
0009A2r 2               
0009A2r 2               @Cell:
0009A2r 2  AD rr rr       lda DirtyCount
0009A5r 2  C9 40          cmp #DIRTY_ENTRIES
0009A7r 2  B0 3A          bcs @Done                     ; Ring full — pick this cell up next frame
0009A9r 2               
0009A9r 2  AE rr rr       ldx RedrawIdx
0009ACr 2  8A             txa
0009ADr 2  29 07          and #(BOARD_STRIDE - 1)
0009AFr 2  18             clc
0009B0r 2  69 01          adc #WELL_ORIGIN_X
0009B2r 2  85 rr          sta RedrawCol
0009B4r 2  8A             txa
0009B5r 2  4A             lsr a                         ; Board index >> 3 is the row (stride 8)
0009B6r 2  4A             lsr a
0009B7r 2  4A             lsr a
0009B8r 2  18             clc
0009B9r 2  69 04          adc #WELL_ORIGIN_Y
0009BBr 2  A8             tay                           ; Y = panel row
0009BCr 2  BD rr rr       lda Board,x                   ; The board byte IS the tile — empty is $00,
0009BFr 2  A6 rr          ldx RedrawCol                 ;   which is TILE_BLANK (SPEC 3.3, 4.2)
0009C1r 2  20 rr rr       jsr RenderMark
0009C4r 2               
0009C4r 2  AE rr rr       ldx RedrawIdx                 ; Advance, stepping over the two sentinel
0009C7r 2  E8             inx                           ;   columns at the end of each row
0009C8r 2  8A             txa
0009C9r 2  29 07          and #(BOARD_STRIDE - 1)
0009CBr 2  C9 06          cmp #BOARD_W
0009CDr 2  90 05          bcc @Save
0009CFr 2  8A             txa
0009D0r 2  18             clc
0009D1r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
0009D3r 2  AA             tax
0009D4r 2               @Save:
0009D4r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
0009D6r 2  B0 06          bcs @Finish
0009D8r 2  8E rr rr       stx RedrawIdx
0009DBr 2  4C rr rr       jmp @Cell
0009DEr 2               
0009DEr 2               @Finish:
0009DEr 2  A9 FF          lda #$FF
0009E0r 2  8D rr rr       sta RedrawIdx
0009E3r 2               @Done:
0009E3r 2  60             rts
0009E4r 2               
0009E4r 2               ; -----------------------------------------------------------------------------
0009E4r 2               ;   RenderCell — queue one board cell by board index
0009E4r 2               ;   In:  X = board index (row * BOARD_STRIDE + column)
0009E4r 2               ;   Out: nothing.  Modifies: A, X, Y
0009E4r 2               ;   The single-cell form of RenderBoardStep, for the phases that move one tile
0009E4r 2               ;   at a time.
0009E4r 2               ; -----------------------------------------------------------------------------
0009E4r 2               RenderCell:
0009E4r 2  8A             txa
0009E5r 2  29 07          and #(BOARD_STRIDE - 1)
0009E7r 2  18             clc
0009E8r 2  69 01          adc #WELL_ORIGIN_X
0009EAr 2  85 rr          sta RedrawCol
0009ECr 2  8A             txa
0009EDr 2  4A             lsr a
0009EEr 2  4A             lsr a
0009EFr 2  4A             lsr a
0009F0r 2  18             clc
0009F1r 2  69 04          adc #WELL_ORIGIN_Y
0009F3r 2  A8             tay
0009F4r 2  BD rr rr       lda Board,x
0009F7r 2  A6 rr          ldx RedrawCol
0009F9r 2  4C rr rr       jmp RenderMark
0009FCr 2               
0009FCr 2               ; -----------------------------------------------------------------------------
0009FCr 2               ;   RenderPiece — queue the three falling cells at where the piece is now
0009FCr 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
0009FCr 2               ;
0009FCr 2               ;   RenderMark clobbers X and keeps Y, so the panel column is parked in
0009FCr 2               ;   RedrawCol and the panel row rides Y down the three cells. Cell C can never
0009FCr 2               ;   be lower than board row 15, so all three are always inside the well and
0009FCr 2               ;   there is nothing to clip.
0009FCr 2               ; -----------------------------------------------------------------------------
0009FCr 2               RenderPiece:
0009FCr 2  AD rr rr       lda PieceCol
0009FFr 2  18             clc
000A00r 2  69 01          adc #WELL_ORIGIN_X
000A02r 2  85 rr          sta RedrawCol
000A04r 2  AD rr rr       lda PieceRow
000A07r 2  18             clc
000A08r 2  69 04          adc #WELL_ORIGIN_Y
000A0Ar 2  A8             tay
000A0Br 2  AD rr rr       lda PieceA
000A0Er 2  A6 rr          ldx RedrawCol
000A10r 2  20 rr rr       jsr RenderMark
000A13r 2  C8             iny
000A14r 2  AD rr rr       lda PieceB
000A17r 2  A6 rr          ldx RedrawCol
000A19r 2  20 rr rr       jsr RenderMark
000A1Cr 2  C8             iny
000A1Dr 2  AD rr rr       lda PieceC
000A20r 2  A6 rr          ldx RedrawCol
000A22r 2  4C rr rr       jmp RenderMark
000A25r 2               
000A25r 2               ; -----------------------------------------------------------------------------
000A25r 2               ;   RenderPieceErase — blank the three cells the piece is leaving
000A25r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000A25r 2               ;
000A25r 2               ;   Three blanks rather than three board reads, because the cells under a
000A25r 2               ;   falling piece are always empty: every move and every gravity step tests
000A25r 2               ;   the target cells before it happens, and the one thing that writes them is
000A25r 2               ;   PieceLock, after which nothing erases the piece again (piece.asm).
000A25r 2               ; -----------------------------------------------------------------------------
000A25r 2               RenderPieceErase:
000A25r 2  AD rr rr       lda PieceCol
000A28r 2  18             clc
000A29r 2  69 01          adc #WELL_ORIGIN_X
000A2Br 2  85 rr          sta RedrawCol
000A2Dr 2  AD rr rr       lda PieceRow
000A30r 2  18             clc
000A31r 2  69 04          adc #WELL_ORIGIN_Y
000A33r 2  A8             tay
000A34r 2  A9 00          lda #TILE_EMPTY
000A36r 2  A6 rr          ldx RedrawCol
000A38r 2  20 rr rr       jsr RenderMark
000A3Br 2  C8             iny
000A3Cr 2  A9 00          lda #TILE_EMPTY
000A3Er 2  A6 rr          ldx RedrawCol
000A40r 2  20 rr rr       jsr RenderMark
000A43r 2  C8             iny
000A44r 2  A9 00          lda #TILE_EMPTY
000A46r 2  A6 rr          ldx RedrawCol
000A48r 2  4C rr rr       jmp RenderMark
000A4Br 2               
000A4Br 2               ; -----------------------------------------------------------------------------
000A4Br 2               ;   RenderNext — the preview, panel column NEXT_X, rows NEXT_Y..NEXT_Y+2
000A4Br 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000A4Br 2               ;
000A4Br 2               ;   All three cells every time. The play screen image ships with a piece
000A4Br 2               ;   already drawn in the NEXT box (SPEC 12.1), so this has to overwrite rather
000A4Br 2               ;   than assume it is drawing onto backdrop.
000A4Br 2               ; -----------------------------------------------------------------------------
000A4Br 2               RenderNext:
000A4Br 2  A0 10          ldy #NEXT_Y
000A4Dr 2  AD rr rr       lda NextA
000A50r 2  A2 0B          ldx #NEXT_X
000A52r 2  20 rr rr       jsr RenderMark
000A55r 2  C8             iny
000A56r 2  AD rr rr       lda NextB
000A59r 2  A2 0B          ldx #NEXT_X
000A5Br 2  20 rr rr       jsr RenderMark
000A5Er 2  C8             iny
000A5Fr 2  AD rr rr       lda NextC
000A62r 2  A2 0B          ldx #NEXT_X
000A64r 2  4C rr rr       jmp RenderMark
000A67r 2               
000A67r 2               ; -----------------------------------------------------------------------------
000A67r 2               ;   RenderScore / RenderHigh / RenderLevel — only called when a value changes
000A67r 2               ;   Nothing here compares anything: the caller knows when it changed a value
000A67r 2               ;   and these are not cheap enough to run every frame. SCORE_DIGITS cells is
000A67r 2               ;   most of a frame's flush budget on its own.
000A67r 2               ; -----------------------------------------------------------------------------
000A67r 2               RenderScore:
000A67r 2  A9 rr          lda #<ScoreLo
000A69r 2  85 rr          sta Ptr1
000A6Br 2  A9 rr          lda #>ScoreLo
000A6Dr 2  85 rr          sta Ptr1+1
000A6Fr 2  A2 0C          ldx #SCORE_X
000A71r 2  A0 05          ldy #SCORE_Y
000A73r 2  A9 07          lda #SCORE_DIGITS
000A75r 2  4C rr rr       jmp TextBcd
000A78r 2               
000A78r 2               RenderHigh:
000A78r 2  A9 rr          lda #<HighLo
000A7Ar 2  85 rr          sta Ptr1
000A7Cr 2  A9 rr          lda #>HighLo
000A7Er 2  85 rr          sta Ptr1+1
000A80r 2  A2 0C          ldx #HIGH_X
000A82r 2  A0 0A          ldy #HIGH_Y
000A84r 2  A9 07          lda #SCORE_DIGITS
000A86r 2  20 rr rr       jsr TextBcd
000A89r 2               
000A89r 2  A9 rr          lda #<HighLevel               ; The level it was set on, under the digits
000A8Br 2  85 rr          sta Ptr1
000A8Dr 2  A9 rr          lda #>HighLevel
000A8Fr 2  85 rr          sta Ptr1+1
000A91r 2  A2 0F          ldx #HIGHLVL_X
000A93r 2  A0 0B          ldy #HIGHLVL_Y
000A95r 2  A9 02          lda #LEVEL_DIGITS
000A97r 2  4C rr rr       jmp TextBcd
000A9Ar 2               
000A9Ar 2               ; -----------------------------------------------------------------------------
000A9Ar 2               ;   RenderHighBlank — the dark half of the HIGH field's overtake flash
000A9Ar 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y, TextCol
000A9Ar 2               ;   SPEC 9.8. The seven digits only; the level under them stays put, so the
000A9Ar 2               ;   box never looks empty and the flash costs seven cells of the budget.
000A9Ar 2               ; -----------------------------------------------------------------------------
000A9Ar 2               RenderHighBlank:
000A9Ar 2  A9 0C          lda #HIGH_X
000A9Cr 2  85 rr          sta TextCol                   ; Not X: RenderMark clobbers it
000A9Er 2               @Cell:
000A9Er 2  A9 00          lda #TILE_BLANK
000AA0r 2  A6 rr          ldx TextCol
000AA2r 2  A0 0A          ldy #HIGH_Y
000AA4r 2  20 rr rr       jsr RenderMark
000AA7r 2  E6 rr          inc TextCol
000AA9r 2  A5 rr          lda TextCol
000AABr 2  C9 13          cmp #(HIGH_X + SCORE_DIGITS)
000AADr 2  90 EF          bcc @Cell
000AAFr 2  60             rts
000AB0r 2               
000AB0r 2               RenderLevel:
000AB0r 2  AD rr rr       lda Level
000AB3r 2  4C rr rr       jmp TextLevel
000AB6r 2               
000AB6r 1               .include "../src/text.asm"
000AB6r 2               ; =============================================================================
000AB6r 2               ;   text.asm — Wizards Lab, text and numbers on the panel
000AB6r 2               ; =============================================================================
000AB6r 2               ;   The font lives in tile groups 2-6, forty glyphs in the order
000AB6r 2               ;
000AB6r 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
000AB6r 2               ;
000AB6r 2               ;   starting at FONT_BASE, so a digit is FONT_DIGIT_0 + value and a letter is
000AB6r 2               ;   FONT_LETTER_A + (letter - 'A'). Strings are stored pre-converted to tile
000AB6r 2               ;   numbers, terminated by TEXT_END, so drawing one is a copy with no
000AB6r 2               ;   translation. src/strings.inc holds them and the macro that encodes them.
000AB6r 2               ;
000AB6r 2               ;   Everything here draws through RenderMark, never to the screen: text is
000AB6r 2               ;   panel cells like any other and goes through the same one flush a frame.
000AB6r 2               ;   That is also why the cursor state lives in the zero-page block RenderMark
000AB6r 2               ;   promises not to touch (zeropage.inc) rather than in Tmp0-Tmp3.
000AB6r 2               ; =============================================================================
000AB6r 2               
000AB6r 2               ; -----------------------------------------------------------------------------
000AB6r 2               ;   TextDraw — draw a tile-encoded string
000AB6r 2               ;   In:  Ptr1 -> string (TEXT_END terminated), X = panel column, Y = panel row
000AB6r 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx
000AB6r 2               ; -----------------------------------------------------------------------------
000AB6r 2               TextDraw:
000AB6r 2  86 rr          stx TextCol
000AB8r 2  84 rr          sty TextRow
000ABAr 2  A9 00          lda #0
000ABCr 2  85 rr          sta TextIdx
000ABEr 2               @Char:
000ABEr 2  A4 rr          ldy TextIdx
000AC0r 2  B1 rr          lda (Ptr1),y
000AC2r 2  C9 FF          cmp #TEXT_END
000AC4r 2  F0 0D          beq @Done
000AC6r 2  A6 rr          ldx TextCol
000AC8r 2  A4 rr          ldy TextRow
000ACAr 2  20 rr rr       jsr RenderMark
000ACDr 2  E6 rr          inc TextCol
000ACFr 2  E6 rr          inc TextIdx
000AD1r 2  D0 EB          bne @Char                     ; Always — a string is never 256 tiles long
000AD3r 2               @Done:
000AD3r 2  60             rts
000AD4r 2               
000AD4r 2               ; -----------------------------------------------------------------------------
000AD4r 2               ;   TextBcd — draw a packed-BCD number, zero padded
000AD4r 2               ;   In:  Ptr1 -> BCD bytes (low first), A = digit count,
000AD4r 2               ;        X = panel column, Y = panel row
000AD4r 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx, TextByte,
000AD4r 2               ;        TextSkip
000AD4r 2               ;
000AD4r 2               ;   SCORE_DIGITS (7) for the score and the high score, 2 for the high score's
000AD4r 2               ;   level. The LEVEL box is not drawn with this — see TextLevel.
000AD4r 2               ;
000AD4r 2               ;   The count is in DIGITS, not bytes, because the score is seven digits in
000AD4r 2               ;   four bytes: the top nibble of the most significant byte is held at zero
000AD4r 2               ;   (SPEC 9) and must not be drawn, or the field would be eight cells wide and
000AD4r 2               ;   no longer centred. An odd count starts at the LOW nibble of the top byte.
000AD4r 2               ;
000AD4r 2               ;   **Every digit is drawn, every time.** A leading zero is a zero glyph, not
000AD4r 2               ;   a blank: 1250 draws as 0001250. There is no suppression pass and no
000AD4r 2               ;   right-alignment — the field is fixed width so a digit never changes
000AD4r 2               ;   column while the player is watching it (SPEC 9). This also makes the
000AD4r 2               ;   routine branchless, and lets RenderScore mark a fixed run of cells dirty.
000AD4r 2               ; -----------------------------------------------------------------------------
000AD4r 2               TextBcd:
000AD4r 2  86 rr          stx TextCol
000AD6r 2  84 rr          sty TextRow
000AD8r 2  48             pha                           ; Digit count
000AD9r 2  29 01          and #$01
000ADBr 2  85 rr          sta TextSkip                  ; Odd count: the top high nibble is not drawn
000ADDr 2  68             pla
000ADEr 2  18             clc
000ADFr 2  69 01          adc #1                        ; Bytes = (digits + 1) / 2
000AE1r 2  4A             lsr a
000AE2r 2  AA             tax
000AE3r 2  CA             dex
000AE4r 2  86 rr          stx TextIdx                   ; Start at the most significant byte
000AE6r 2               
000AE6r 2               @Byte:
000AE6r 2  A4 rr          ldy TextIdx
000AE8r 2  B1 rr          lda (Ptr1),y
000AEAr 2  85 rr          sta TextByte
000AECr 2               
000AECr 2  A5 rr          lda TextSkip
000AEEr 2  D0 09          bne @Low
000AF0r 2  A5 rr          lda TextByte
000AF2r 2  4A             lsr a
000AF3r 2  4A             lsr a
000AF4r 2  4A             lsr a
000AF5r 2  4A             lsr a
000AF6r 2  20 rr rr       jsr TextDigit
000AF9r 2               @Low:
000AF9r 2  A9 00          lda #0
000AFBr 2  85 rr          sta TextSkip
000AFDr 2  A5 rr          lda TextByte
000AFFr 2  29 0F          and #$0F
000B01r 2  20 rr rr       jsr TextDigit
000B04r 2               
000B04r 2  C6 rr          dec TextIdx
000B06r 2  10 DE          bpl @Byte
000B08r 2  60             rts
000B09r 2               
000B09r 2               ; -----------------------------------------------------------------------------
000B09r 2               ;   TextDigit — draw one digit at the cursor and step it right
000B09r 2               ;   In:  A = value 0-9      Modifies: A, X, Y, TextCol
000B09r 2               ; -----------------------------------------------------------------------------
000B09r 2               TextDigit:
000B09r 2  18             clc
000B0Ar 2  69 10          adc #FONT_DIGIT_0
000B0Cr 2  A6 rr          ldx TextCol
000B0Er 2  A4 rr          ldy TextRow
000B10r 2  20 rr rr       jsr RenderMark
000B13r 2  E6 rr          inc TextCol
000B15r 2  60             rts
000B16r 2               
000B16r 2               ; -----------------------------------------------------------------------------
000B16r 2               ;   TextBanner — centre a string in the one-row message band
000B16r 2               ;   In:  Ptr1 -> string
000B16r 2               ;   Out: nothing.  Modifies: A, X, Y and the text cursor
000B16r 2               ;
000B16r 2               ;   SPEC 12.2 — the band is panel row MSG_Y, full width, one row only. The
000B16r 2               ;   string arrives already wrapped as `~~ TEXT ~~` — two FONT_TILDE, a blank,
000B16r 2               ;   the text, a blank, two FONT_TILDE. Centring is (PANEL_W - length) / 2,
000B16r 2               ;   which is why banner strings are drawn even-length.
000B16r 2               ; -----------------------------------------------------------------------------
000B16r 2               TextBanner:
000B16r 2  A0 00          ldy #0
000B18r 2               @Len:
000B18r 2  B1 rr          lda (Ptr1),y
000B1Ar 2  C9 FF          cmp #TEXT_END
000B1Cr 2  F0 03          beq @Got
000B1Er 2  C8             iny
000B1Fr 2  D0 F7          bne @Len
000B21r 2               @Got:
000B21r 2  98             tya
000B22r 2  85 rr          sta TextIdx
000B24r 2  A9 16          lda #PANEL_W
000B26r 2  38             sec
000B27r 2  E5 rr          sbc TextIdx
000B29r 2  4A             lsr a                         ; (PANEL_W - length) / 2
000B2Ar 2  AA             tax
000B2Br 2  A0 16          ldy #MSG_Y
000B2Dr 2  4C rr rr       jmp TextDraw
000B30r 2               
000B30r 2               ; -----------------------------------------------------------------------------
000B30r 2               ;   TextBannerClear — blank the message band back to backdrop
000B30r 2               ;   Out: nothing.  Modifies: A, X, Y
000B30r 2               ;
000B30r 2               ;   Columns MSG_X .. MSG_X + MSG_W - 1 only. The shelf tiles at either end of
000B30r 2               ;   the band belong to the static screen image and are never redrawn.
000B30r 2               ; -----------------------------------------------------------------------------
000B30r 2               TextBannerClear:
000B30r 2  A9 02          lda #MSG_X
000B32r 2  85 rr          sta TextCol                   ; Not X: RenderMark clobbers it
000B34r 2               @Cell:
000B34r 2  A9 00          lda #TILE_BLANK
000B36r 2  A6 rr          ldx TextCol
000B38r 2  A0 16          ldy #MSG_Y
000B3Ar 2  20 rr rr       jsr RenderMark
000B3Dr 2  E6 rr          inc TextCol
000B3Fr 2  A5 rr          lda TextCol
000B41r 2  C9 14          cmp #(MSG_X + MSG_W)
000B43r 2  90 EF          bcc @Cell
000B45r 2  60             rts
000B46r 2               
000B46r 2               ; -----------------------------------------------------------------------------
000B46r 2               ;   TextLevel — the LEVEL box, tens above units in one column
000B46r 2               ;   In:  A = level (binary, 1-99)
000B46r 2               ;   Out: nothing.  Modifies: A, X, Y, TextByte
000B46r 2               ;   SPEC 12.2 — LEVEL_X, tens at LEVEL_Y and units at LEVEL_Y + 1. Always two
000B46r 2               ;   digits: level 5 draws "0" over "5".
000B46r 2               ; -----------------------------------------------------------------------------
000B46r 2               TextLevel:
000B46r 2  A2 00          ldx #0
000B48r 2               @Tens:
000B48r 2  C9 0A          cmp #10
000B4Ar 2  90 05          bcc @Split
000B4Cr 2  E9 0A          sbc #10                       ; Carry is set by the CMP that got us here
000B4Er 2  E8             inx
000B4Fr 2  D0 F7          bne @Tens                     ; Always — X tops out at 9
000B51r 2               @Split:
000B51r 2  85 rr          sta TextByte                  ; Units
000B53r 2  8A             txa
000B54r 2  18             clc
000B55r 2  69 10          adc #FONT_DIGIT_0
000B57r 2  A2 12          ldx #LEVEL_X
000B59r 2  A0 11          ldy #LEVEL_Y
000B5Br 2  20 rr rr       jsr RenderMark
000B5Er 2  A5 rr          lda TextByte
000B60r 2  18             clc
000B61r 2  69 10          adc #FONT_DIGIT_0
000B63r 2  A2 12          ldx #LEVEL_X
000B65r 2  A0 12          ldy #LEVEL_Y + 1
000B67r 2  4C rr rr       jmp RenderMark
000B6Ar 2               
000B6Ar 1               .include "../src/audio.asm"
000B6Ar 2               ; =============================================================================
000B6Ar 2               ;   audio.asm — Wizards Lab, sound
000B6Ar 2               ; =============================================================================
000B6Ar 2               ;   SPEC.md section 16. Out of scope for the first playable build, but the
000B6Ar 2               ;   hook is here from the start so game logic never has to be revisited to add
000B6Ar 2               ;   it: logic writes an effect id to SfxRequest and forgets about it.
000B6Ar 2               ;
000B6Ar 2               ;   The AC6502 and the C64 both have a SID and can share a driver — only the
000B6Ar 2               ;   register base differs ($9800 against $D400). The VIC-20 needs its own,
000B6Ar 2               ;   against $900A-$900E.
000B6Ar 2               ; =============================================================================
000B6Ar 2               
000B6Ar 2               SFX_MOVE        = 1
000B6Ar 2               SFX_ROTATE      = 2
000B6Ar 2               SFX_LOCK        = 3
000B6Ar 2               SFX_MATCH       = 4
000B6Ar 2               SFX_FIREBALL    = 5
000B6Ar 2               SFX_BOLT        = 6
000B6Ar 2               SFX_BOMB        = 7
000B6Ar 2               SFX_STAR        = 8
000B6Ar 2               SFX_PRISM       = 9
000B6Ar 2               SFX_LEVELUP     = 10
000B6Ar 2               SFX_HIGHSCORE   = 11
000B6Ar 2               SFX_GAMEOVER    = 12
000B6Ar 2               
000B6Ar 2               ; -----------------------------------------------------------------------------
000B6Ar 2               ;   AudioInit — silence everything
000B6Ar 2               ; -----------------------------------------------------------------------------
000B6Ar 2               AudioInit:
000B6Ar 2  A9 00          lda #0
000B6Cr 2  8D rr rr       sta SfxRequest
000B6Fr 2  8D rr rr       sta SfxTimer
000B72r 2  60             rts
000B73r 2               
000B73r 2               ; -----------------------------------------------------------------------------
000B73r 2               ;   AudioTick — called once per frame, consumes SfxRequest
000B73r 2               ; -----------------------------------------------------------------------------
000B73r 2               AudioTick:
000B73r 2                 ; TODO: start a new effect when SfxRequest is non-zero, then advance the
000B73r 2                 ; envelope of whatever is playing. Calls HalSfx for the register writes.
000B73r 2  A9 00          lda #0
000B75r 2  8D rr rr       sta SfxRequest
000B78r 2  60             rts
000B79r 2               
000B79r 1               
000B79r 1               ; =============================================================================
000B79r 1               ;   HAL — VIC-I, hi-res text
000B79r 1               ; =============================================================================
000B79r 1               
000B79r 1               ; -----------------------------------------------------------------------------
000B79r 1               ;   HalInitVideo — 22 x 23 cells, custom charset in RAM, everything black
000B79r 1               ; -----------------------------------------------------------------------------
000B79r 1               HalInitVideo:
000B79r 1                 ; Screen centring. The KERNAL normally sets these, but an autostart cart
000B79r 1                 ; takes over before it gets that far, so they are still at their power-on
000B79r 1                 ; values and the picture sits in the wrong place. The right pair depends on
000B79r 1                 ; the region, which is why HalDetectRegion runs before this.
000B79r 1  A2 05          ldx #$05                      ; NTSC
000B7Br 1  A0 19          ldy #$19
000B7Dr 1  AD rr rr       lda Region
000B80r 1  F0 04          beq @Centre
000B82r 1  A2 0C          ldx #$0C                      ; PAL
000B84r 1  A0 26          ldy #$26
000B86r 1               @Centre:
000B86r 1  8E 00 90       stx VIC_CR0                   ; Horizontal centring (bit 7 = interlace, off)
000B89r 1  8C 01 90       sty VIC_CR1                   ; Vertical centring
000B8Cr 1               
000B8Cr 1  A9 96          lda #$96                      ; 22 columns, video matrix bit 9 set -> $1E00
000B8Er 1  8D 02 90       sta VIC_CR2
000B91r 1  A9 2E          lda #$2E                      ; 23 rows (46 half-lines), 8-pixel characters
000B93r 1  8D 03 90       sta VIC_CR3
000B96r 1  A9 FD          lda #$FD                      ; Screen $1E00, character set $1400
000B98r 1  8D 05 90       sta VIC_CR5
000B9Br 1  A9 08          lda #$08                      ; Black background, black border, normal video
000B9Dr 1  8D 0F 90       sta VIC_CRF
000BA0r 1               
000BA0r 1  20 rr rr       jsr LoadTileset
000BA3r 1                 ; falls through
000BA3r 1               
000BA3r 1               ; -----------------------------------------------------------------------------
000BA3r 1               ;   HalClearScreen — blank tiles, white colour RAM
000BA3r 1               ; -----------------------------------------------------------------------------
000BA3r 1               HalClearScreen:
000BA3r 1  A2 00          ldx #0                        ; 506 cells = one full page plus 250
000BA5r 1               @Page0:
000BA5r 1  A9 00          lda #TILE_BLANK
000BA7r 1  9D 00 1E       sta SCREEN + $0000,x
000BAAr 1  A9 01          lda #1                        ; White
000BACr 1  9D 00 96       sta COLRAM + $0000,x
000BAFr 1  E8             inx
000BB0r 1  D0 F3          bne @Page0
000BB2r 1               @Page1:
000BB2r 1  A9 00          lda #TILE_BLANK
000BB4r 1  9D 00 1F       sta SCREEN + $0100,x
000BB7r 1  A9 01          lda #1
000BB9r 1  9D 00 97       sta COLRAM + $0100,x
000BBCr 1  E8             inx
000BBDr 1  E0 FA          cpx #250                      ; $1E00 + 506 = $1FFA, the end of the matrix
000BBFr 1  D0 F1          bne @Page1
000BC1r 1  60             rts
000BC2r 1               
000BC2r 1               ; -----------------------------------------------------------------------------
000BC2r 1               ;   LoadTileset — copy 2 K of patterns from BLK3 into RAM at $1400
000BC2r 1               ;   The VIC chip cannot see cartridge ROM, so this copy is not optional.
000BC2r 1               ;   PLACEHOLDER ART: Tileset is data/tileset.bin. See data/README.md.
000BC2r 1               ; -----------------------------------------------------------------------------
000BC2r 1               LoadTileset:
000BC2r 1  A9 rr          lda #<Tileset
000BC4r 1  85 rr          sta SrcPtr
000BC6r 1  A9 rr          lda #>Tileset
000BC8r 1  85 rr          sta SrcPtr+1
000BCAr 1  A9 00          lda #<CHARSET_RAM
000BCCr 1  85 rr          sta DstPtr
000BCEr 1  A9 14          lda #>CHARSET_RAM
000BD0r 1  85 rr          sta DstPtr+1
000BD2r 1               
000BD2r 1  A2 08          ldx #8                        ; 8 x 256 = 2048 bytes
000BD4r 1  A0 00          ldy #0
000BD6r 1               @Byte:
000BD6r 1  B1 rr          lda (SrcPtr),y
000BD8r 1  91 rr          sta (DstPtr),y
000BDAr 1  C8             iny
000BDBr 1  D0 F9          bne @Byte
000BDDr 1  E6 rr          inc SrcPtr+1
000BDFr 1  E6 rr          inc DstPtr+1
000BE1r 1  CA             dex
000BE2r 1  D0 F2          bne @Byte
000BE4r 1  60             rts
000BE5r 1               
000BE5r 1               ; -----------------------------------------------------------------------------
000BE5r 1               ;   HalWaitFrame — sync on the top of the raster
000BE5r 1               ; -----------------------------------------------------------------------------
000BE5r 1               HalWaitFrame:
000BE5r 1               @NotTop:
000BE5r 1  AD 04 90       lda VIC_CR4                   ; Raster line / 2
000BE8r 1  F0 FB          beq @NotTop                   ; Leave the top of the frame first...
000BEAr 1               @Top:
000BEAr 1  AD 04 90       lda VIC_CR4
000BEDr 1  D0 FB          bne @Top                      ; ...then wait for it to come round again
000BEFr 1  60             rts
000BF0r 1               
000BF0r 1               ; -----------------------------------------------------------------------------
000BF0r 1               ;   HalPlotCell — In: A = tile, X = screen column, Y = screen row
000BF0r 1               ; -----------------------------------------------------------------------------
000BF0r 1               HalPlotCell:
000BF0r 1  48             pha                           ; Hold the tile; RowPtrs needs A
000BF1r 1  20 rr rr       jsr RowPtrs                   ; ScreenPtr / ColorPtr = start of row Y
000BF4r 1  8A             txa
000BF5r 1  A8             tay                           ; Y = column
000BF6r 1  68             pla                           ; A = tile
000BF7r 1  91 rr          sta (ScreenPtr),y
000BF9r 1  AA             tax                           ; The tile is its own colour lookup index
000BFAr 1  BD rr rr       lda TileColorVIC,x
000BFDr 1  91 rr          sta (ColorPtr),y
000BFFr 1  60             rts
000C00r 1               
000C00r 1               ; -----------------------------------------------------------------------------
000C00r 1               ;   RowPtrs — In: Y = screen row.  Out: ScreenPtr, ColorPtr at that row
000C00r 1               ; -----------------------------------------------------------------------------
000C00r 1               RowPtrs:
000C00r 1  B9 rr rr       lda RowLo,y
000C03r 1  85 rr          sta ScreenPtr
000C05r 1  85 rr          sta ColorPtr
000C07r 1  B9 rr rr       lda RowHi,y
000C0Ar 1  85 rr          sta ScreenPtr+1
000C0Cr 1  18             clc
000C0Dr 1  69 78          adc #(>COLRAM - >SCREEN)      ; Colour RAM mirrors the matrix, page-offset
000C0Fr 1  85 rr          sta ColorPtr+1
000C11r 1  60             rts
000C12r 1               
000C12r 1               ; -----------------------------------------------------------------------------
000C12r 1               ;   HalBlitScreen — draw a full 506-byte screen plus its colour image
000C12r 1               ;   In: SrcPtr -> name table, Ptr1 -> colour table
000C12r 1               ; -----------------------------------------------------------------------------
000C12r 1               HalBlitScreen:
000C12r 1  A0 00          ldy #0                        ; 506 cells = one full page plus 250
000C14r 1               @Page0:
000C14r 1  B1 rr          lda (SrcPtr),y
000C16r 1  99 00 1E       sta SCREEN + $0000,y
000C19r 1  B1 rr          lda (Ptr1),y
000C1Br 1  99 00 96       sta COLRAM + $0000,y
000C1Er 1  C8             iny
000C1Fr 1  D0 F3          bne @Page0
000C21r 1               
000C21r 1  E6 rr          inc SrcPtr+1
000C23r 1  E6 rr          inc Ptr1+1
000C25r 1  A0 00          ldy #0
000C27r 1               @Page1:
000C27r 1  B1 rr          lda (SrcPtr),y
000C29r 1  99 00 1F       sta SCREEN + $0100,y
000C2Cr 1  B1 rr          lda (Ptr1),y
000C2Er 1  99 00 97       sta COLRAM + $0100,y
000C31r 1  C8             iny
000C32r 1  C0 FA          cpy #250                      ; Anything past here is not screen memory
000C34r 1  D0 F1          bne @Page1
000C36r 1  60             rts
000C37r 1               
000C37r 1               ; -----------------------------------------------------------------------------
000C37r 1               ;   HalReadInput — joystick and keyboard, folded into one active-high mask
000C37r 1               ;
000C37r 1               ;   The VIC splits its stick across two chips: up, down, left and fire are on
000C37r 1               ;   VIA1 $9111, but RIGHT is on VIA2 $9120 bit 7 — which is also the last of
000C37r 1               ;   the eight keyboard row lines. That collision is PLAN.md S4, and it turns
000C37r 1               ;   out not to be one:
000C37r 1               ;
000C37r 1               ;     Every key this game reads lives in matrix rows 1-6. Row 0 is the top
000C37r 1               ;     number row and row 7 the rest of it, and the game wants neither. So DDRB
000C37r 1               ;     is set ONCE to $7F and never touched again — PB0-PB6 drive the six rows
000C37r 1               ;     that matter, PB7 stays an input for the RIGHT switch, and the two never
000C37r 1               ;     take turns.
000C37r 1               ;
000C37r 1               ;   That is better than flipping the DDR twice a frame, and not only because
000C37r 1               ;   it is shorter: driving PB7 high while a closed RIGHT switch pulls it to
000C37r 1               ;   ground puts the VIA's output stage against the joystick, and never
000C37r 1               ;   configuring PB7 as an output means that cannot happen at all.
000C37r 1               ; -----------------------------------------------------------------------------
000C37r 1               HalReadInput:
000C37r 1  AD 13 91       lda $9113                     ; VIA1 DDR: the joystick lines are inputs
000C3Ar 1  29 C3          and #%11000011
000C3Cr 1  8D 13 91       sta $9113
000C3Fr 1               
000C3Fr 1  A9 7F          lda #%01111111                ; VIA2 DDRB: rows 0-6 out, RIGHT switch in
000C41r 1  8D 22 91       sta $9122
000C44r 1  A9 00          lda #$00                      ; VIA2 DDRA: the column lines are inputs
000C46r 1  8D 23 91       sta $9123
000C49r 1               
000C49r 1  AD 11 91       lda $9111                     ; Active low: bit2 U, bit3 D, bit4 L, bit5 fire
000C4Cr 1  49 FF          eor #$FF
000C4Er 1  29 3C          and #%00111100                ; Only those four; PA7 here is not the stick
000C50r 1  85 rr          sta Tmp0
000C52r 1               
000C52r 1  AD 20 91       lda $9120
000C55r 1  49 FF          eor #$FF
000C57r 1  29 80          and #$80                      ; Fold RIGHT in as bit 7 of the same byte
000C59r 1  05 rr          ora Tmp0
000C5Br 1  85 rr          sta Tmp0
000C5Dr 1               
000C5Dr 1  A9 00          lda #0
000C5Fr 1  85 rr          sta Tmp1
000C61r 1               
000C61r 1  A5 rr          lda Tmp0
000C63r 1  29 04          and #%00000100                  ; VIA1 bit 2
000C65r 1  F0 06          beq @NoUp
000C67r 1  A5 rr          lda Tmp1
000C69r 1  09 01          ora #INPUT_UP
000C6Br 1  85 rr          sta Tmp1
000C6Dr 1               @NoUp:
000C6Dr 1  A5 rr          lda Tmp0
000C6Fr 1  29 08          and #%00001000                  ; VIA1 bit 3
000C71r 1  F0 06          beq @NoDown
000C73r 1  A5 rr          lda Tmp1
000C75r 1  09 02          ora #INPUT_DOWN
000C77r 1  85 rr          sta Tmp1
000C79r 1               @NoDown:
000C79r 1  A5 rr          lda Tmp0
000C7Br 1  29 10          and #%00010000                  ; VIA1 bit 4
000C7Dr 1  F0 06          beq @NoLeft
000C7Fr 1  A5 rr          lda Tmp1
000C81r 1  09 04          ora #INPUT_LEFT
000C83r 1  85 rr          sta Tmp1
000C85r 1               @NoLeft:
000C85r 1  A5 rr          lda Tmp0
000C87r 1  29 80          and #%10000000                  ; VIA2 PB7, folded in above
000C89r 1  F0 06          beq @NoRight
000C8Br 1  A5 rr          lda Tmp1
000C8Dr 1  09 08          ora #INPUT_RIGHT
000C8Fr 1  85 rr          sta Tmp1
000C91r 1               @NoRight:
000C91r 1  A5 rr          lda Tmp0
000C93r 1  29 20          and #%00100000                  ; VIA1 bit 5
000C95r 1  F0 06          beq @NoFire
000C97r 1  A5 rr          lda Tmp1
000C99r 1  09 10          ora #INPUT_FIRE
000C9Br 1  85 rr          sta Tmp1
000C9Dr 1               @NoFire:
000C9Dr 1               
000C9Dr 1  20 rr rr       jsr ScanKeys
000CA0r 1  05 rr          ora Tmp1
000CA2r 1  60             rts
000CA3r 1               
000CA3r 1               ; -----------------------------------------------------------------------------
000CA3r 1               ;   ScanKeys — the keyboard matrix, as the same active-high mask
000CA3r 1               ;   Out: A = INPUT_* bits.  Modifies: A, X, Tmp2
000CA3r 1               ;
000CA3r 1               ;   VIA2 $9120 drives the rows (one bit LOW selects one row) and $9121 reads
000CA3r 1               ;   the columns, active low. Every key the game uses is in KeyTable below;
000CA3r 1               ;   the two cursor keys come after it because SHIFT turns them around, and
000CA3r 1               ;   knowing whether SHIFT is down means having scanned the table first.
000CA3r 1               ; -----------------------------------------------------------------------------
000CA3r 1               KEY_SHIFT           = %01000000 ; Scratch inside this file only — INPUT_MASK
000CA3r 1                                               ;   strips it before the mask leaves here
000CA3r 1               
000CA3r 1               ScanKeys:
000CA3r 1  A9 00          lda #0
000CA5r 1  85 rr          sta Tmp2
000CA7r 1  A2 00          ldx #0
000CA9r 1               @Key:
000CA9r 1  BD rr rr       lda KeyTable,x
000CACr 1  F0 19          beq @Cursors                  ; $00 drives every row at once — the
000CAEr 1  8D 20 91       sta $9120                     ;   terminator, because it is not a row mask
000CB1r 1  AD 21 91       lda $9121
000CB4r 1  49 FF          eor #$FF                      ; Active low in, active high out
000CB6r 1  3D rr rr       and KeyTable+1,x
000CB9r 1  F0 07          beq @Next
000CBBr 1  A5 rr          lda Tmp2
000CBDr 1  1D rr rr       ora KeyTable+2,x
000CC0r 1  85 rr          sta Tmp2
000CC2r 1               @Next:
000CC2r 1  E8             inx
000CC3r 1  E8             inx
000CC4r 1  E8             inx
000CC5r 1  D0 E2          bne @Key                      ; Always — the table is far shorter than 256
000CC7r 1               
000CC7r 1                 ; --- the two cursor keys, which SHIFT turns around (SPEC 11.2) ------------
000CC7r 1                 ;   Unshifted they are RIGHT and DOWN, shifted LEFT and UP, which is exactly
000CC7r 1                 ;   the four the game wants and the reason for reading the matrix rather
000CC7r 1                 ;   than letting the KERNAL translate a keystroke into one character.
000CC7r 1               @Cursors:
000CC7r 1  A9 FB          lda #%11111011                ; Row 2 — CRSR RIGHT shares it with A and D
000CC9r 1  8D 20 91       sta $9120
000CCCr 1  AD 21 91       lda $9121
000CCFr 1  29 80          and #%10000000                ; Column 7
000CD1r 1  D0 0F          bne @NoLeftRight              ; Still high, so not pressed
000CD3r 1  A2 08          ldx #INPUT_RIGHT
000CD5r 1  A5 rr          lda Tmp2
000CD7r 1  29 40          and #KEY_SHIFT
000CD9r 1  F0 02          beq @LeftRight
000CDBr 1  A2 04          ldx #INPUT_LEFT
000CDDr 1               @LeftRight:
000CDDr 1  8A             txa
000CDEr 1  05 rr          ora Tmp2
000CE0r 1  85 rr          sta Tmp2
000CE2r 1               @NoLeftRight:
000CE2r 1               
000CE2r 1  A9 F7          lda #%11110111                ; Row 3 — CRSR DOWN, next to LSHIFT
000CE4r 1  8D 20 91       sta $9120
000CE7r 1  AD 21 91       lda $9121
000CEAr 1  29 80          and #%10000000
000CECr 1  D0 0F          bne @NoUpDown
000CEEr 1  A2 02          ldx #INPUT_DOWN
000CF0r 1  A5 rr          lda Tmp2
000CF2r 1  29 40          and #KEY_SHIFT
000CF4r 1  F0 02          beq @UpDown
000CF6r 1  A2 01          ldx #INPUT_UP
000CF8r 1               @UpDown:
000CF8r 1  8A             txa
000CF9r 1  05 rr          ora Tmp2
000CFBr 1  85 rr          sta Tmp2
000CFDr 1               @NoUpDown:
000CFDr 1               
000CFDr 1  A5 rr          lda Tmp2
000CFFr 1  29 3F          and #INPUT_MASK               ; Drop KEY_SHIFT — it is not an input
000D01r 1  60             rts
000D02r 1               
000D02r 1               ; -----------------------------------------------------------------------------
000D02r 1               ;   KeyTable — row mask, column mask, input bit.  Terminated by $00.
000D02r 1               ;   Rows 1-6 only; see HalReadInput above for why that matters.
000D02r 1               ; -----------------------------------------------------------------------------
000D02r 1               KeyTable:
000D02r 1  FD 02 01       .byte %11111101, %00000010, INPUT_UP      ; W        row 1, col 1
000D05r 1  FB 02 04       .byte %11111011, %00000010, INPUT_LEFT    ; A        row 2, col 1
000D08r 1  DF 02 02       .byte %11011111, %00000010, INPUT_DOWN    ; S        row 5, col 1
000D0Br 1  FB 04 08       .byte %11111011, %00000100, INPUT_RIGHT   ; D        row 2, col 2
000D0Er 1  BF 01 10       .byte %10111111, %00000001, INPUT_FIRE    ; Q        row 6, col 0
000D11r 1  FD 20 20       .byte %11111101, %00100000, INPUT_PAUSE   ; P        row 1, col 5
000D14r 1  EF 01 01       .byte %11101111, %00000001, INPUT_UP      ; SPACE    row 4, col 0
000D17r 1  FD 80 10       .byte %11111101, %10000000, INPUT_FIRE    ; RETURN   row 1, col 7
000D1Ar 1  F7 02 40       .byte %11110111, %00000010, KEY_SHIFT     ; LSHIFT   row 3, col 1
000D1Dr 1  EF 40 40       .byte %11101111, %01000000, KEY_SHIFT     ; RSHIFT   row 4, col 6
000D20r 1  00             .byte $00
000D21r 1               
000D21r 1               ; -----------------------------------------------------------------------------
000D21r 1               ;   HalDetectRegion — NTSC has 261 raster lines, PAL 312
000D21r 1               ;   $9004 carries the line number halved, so the highest value it reaches is
000D21r 1               ;   about $82 on NTSC and $9C on PAL. Sample it and take the maximum.
000D21r 1               ; -----------------------------------------------------------------------------
000D21r 1               HalDetectRegion:
000D21r 1  A9 00          lda #0
000D23r 1  85 rr          sta Tmp0                      ; Highest line seen
000D25r 1  A2 00          ldx #0
000D27r 1  A0 00          ldy #0
000D29r 1               @Sample:
000D29r 1  AD 04 90       lda VIC_CR4
000D2Cr 1  C5 rr          cmp Tmp0
000D2Er 1  90 02          bcc @Next
000D30r 1  85 rr          sta Tmp0
000D32r 1               @Next:
000D32r 1  C8             iny
000D33r 1  D0 F4          bne @Sample
000D35r 1  E8             inx
000D36r 1  E0 40          cpx #64                       ; 16384 samples — comfortably over one frame
000D38r 1  D0 EF          bne @Sample
000D3Ar 1               
000D3Ar 1  A5 rr          lda Tmp0
000D3Cr 1  C9 90          cmp #$90
000D3Er 1  90 03          bcc @Ntsc
000D40r 1  A9 01          lda #1                        ; PAL
000D42r 1  60             rts
000D43r 1               @Ntsc:
000D43r 1  A9 00          lda #0
000D45r 1  60             rts
000D46r 1               
000D46r 1               ; -----------------------------------------------------------------------------
000D46r 1               ;   HalSfx — TODO: VIC-I sound, $900A-$900E. Its own driver; no SID here.
000D46r 1               ; -----------------------------------------------------------------------------
000D46r 1               HalSfx:
000D46r 1  60             rts
000D47r 1               
000D47r 1               ; =============================================================================
000D47r 1               ;   Data
000D47r 1               ; =============================================================================
000D47r 1               
000D47r 1               .segment "RODATA"
000000r 1               
000000r 1               .include "../data/tilecolor-vic20.inc"
000000r 2               ; =============================================================================
000000r 2               ;   tilecolor-vic20.inc — VIC-20 tile -> colour RAM table
000000r 2               ; =============================================================================
000000r 2               ;   Generated from SPEC.md section 4.3 and Appendix A. Spec-derived data, not
000000r 2               ;   artwork: edit this file by hand, it is never overwritten by an editor
000000r 2               ;   export. Tile groups 16-31 (tiles 128-255) are the margin artwork and their
000000r 2               ;   colours are the artist's to choose.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               
000000r 2               ;   256 bytes, indexed by tile number. Render is:
000000r 2               ;       SCREEN,x = tile   /   COLRAM,x = TileColor,tile
000000r 2               ;   VIC-20 hi-res text mode: colours 0-7 only (bit 3 selects
000000r 2               ;   multicolor and must stay clear).
000000r 2               
000000r 2               TileColorVIC:
000000r 2  01 01 01 01    .res 8, $01                      ; tiles   0-7    group 0  UI / well frame        white
000004r 2  01 01 01 01  
000008r 2  01 01 01 01    .res 8, $01                      ; tiles   8-15   group 1  UI accents             gray
00000Cr 2  01 01 01 01  
000010r 2  01 01 01 01    .res 8, $01                      ; tiles  16-23   group 2  Font  0 1 2 3 4 5 6 7  white
000014r 2  01 01 01 01  
000018r 2  01 01 01 01    .res 8, $01                      ; tiles  24-31   group 3  Font  8 9 A B C D E F  white
00001Cr 2  01 01 01 01  
000020r 2  01 01 01 01    .res 8, $01                      ; tiles  32-39   group 4  Font  G H I J K L M N  white
000024r 2  01 01 01 01  
000028r 2  01 01 01 01    .res 8, $01                      ; tiles  40-47   group 5  Font  O P Q R S T U V  white
00002Cr 2  01 01 01 01  
000030r 2  01 01 01 01    .res 8, $01                      ; tiles  48-55   group 6  Font  W X Y Z . x ! -  white
000034r 2  01 01 01 01  
000038r 2  01 01 01 01    .res 8, $01                      ; tiles  56-63   group 7  VFX                    white
00003Cr 2  01 01 01 01  
000040r 2  02 02 02 02    .res 8, $02                      ; tiles  64-71   group 8  POTION 0  RED
000044r 2  02 02 02 02  
000048r 2  07 07 07 07    .res 8, $07                      ; tiles  72-79   group 9  POTION 1  YELLOW
00004Cr 2  07 07 07 07  
000050r 2  05 05 05 05    .res 8, $05                      ; tiles  80-87   group 10 POTION 2  GREEN
000054r 2  05 05 05 05  
000058r 2  03 03 03 03    .res 8, $03                      ; tiles  88-95   group 11 POTION 3  CYAN
00005Cr 2  03 03 03 03  
000060r 2  06 06 06 06    .res 8, $06                      ; tiles  96-103  group 12 POTION 4  BLUE
000064r 2  06 06 06 06  
000068r 2  04 04 04 04    .res 8, $04                      ; tiles 104-111  group 13 POTION 5  PURPLE
00006Cr 2  04 04 04 04  
000070r 2  01 01 01 01    .res 8, $01                      ; tiles 112-119  group 14 POTION 6  WILD / prism white
000074r 2  01 01 01 01  
000078r 2  02 02 02 02    .res 8, $02                      ; tiles 120-127  group 15 Wall / stone           red
00007Cr 2  02 02 02 02  
000080r 2  01 01 01 01    .res 8, $01                      ; tiles 128-135  group 16 artwork
000084r 2  01 01 01 01  
000088r 2  02 02 02 02    .res 8, $02                      ; tiles 136-143  group 17 artwork
00008Cr 2  02 02 02 02  
000090r 2  05 05 05 05    .res 8, $05                      ; tiles 144-151  group 18 artwork
000094r 2  05 05 05 05  
000098r 2  07 07 07 07    .res 8, $07                      ; tiles 152-159  group 19 artwork
00009Cr 2  07 07 07 07  
0000A0r 2  06 06 06 06    .res 8, $06                      ; tiles 160-167  group 20 artwork
0000A4r 2  06 06 06 06  
0000A8r 2  05 05 05 05    .res 8, $05                      ; tiles 168-175  group 21 artwork
0000ACr 2  05 05 05 05  
0000B0r 2  02 02 02 02    .res 8, $02                      ; tiles 176-183  group 22 artwork
0000B4r 2  02 02 02 02  
0000B8r 2  03 03 03 03    .res 8, $03                      ; tiles 184-191  group 23 artwork
0000BCr 2  03 03 03 03  
0000C0r 2  07 07 07 07    .res 8, $07                      ; tiles 192-199  group 24 artwork
0000C4r 2  07 07 07 07  
0000C8r 2  06 06 06 06    .res 8, $06                      ; tiles 200-207  group 25 artwork
0000CCr 2  06 06 06 06  
0000D0r 2  04 04 04 04    .res 8, $04                      ; tiles 208-215  group 26 artwork
0000D4r 2  04 04 04 04  
0000D8r 2  05 05 05 05    .res 8, $05                      ; tiles 216-223  group 27 artwork
0000DCr 2  05 05 05 05  
0000E0r 2  02 02 02 02    .res 8, $02                      ; tiles 224-231  group 28 artwork
0000E4r 2  02 02 02 02  
0000E8r 2  01 01 01 01    .res 8, $01                      ; tiles 232-239  group 29 artwork
0000ECr 2  01 01 01 01  
0000F0r 2  01 01 01 01    .res 8, $01                      ; tiles 240-247  group 30 artwork
0000F4r 2  01 01 01 01  
0000F8r 2  01 01 01 01    .res 8, $01                      ; tiles 248-255  group 31 artwork
0000FCr 2  01 01 01 01  
000100r 2               
000100r 1               .include "../src/tables.inc"
000100r 2               ; =============================================================================
000100r 2               ;   tables.inc — Wizards Lab, spec-derived lookup tables
000100r 2               ; =============================================================================
000100r 2               ;   Straight out of SPEC.md sections 5.3, 9 and 10. Hand-authored, never
000100r 2               ;   overwritten by an editor export. Included once, from the RODATA segment.
000100r 2               ;
000100r 2               ;   Score values above 99 do not fit in a byte, so every scoring table is a
000100r 2               ;   pair of parallel arrays — low BCD byte and high BCD byte — indexed by the
000100r 2               ;   same value.
000100r 2               ; =============================================================================
000100r 2               
000100r 2               ; --- Gravity, frames per row (SPEC 10.2) -------------------------------------
000100r 2               ;   Indexed by (level - 1), clamped to LEVEL_SPEED_CAP - 1.
000100r 2               ;   PAL is round(NTSC * 50/60), so wall-clock speed matches across regions.
000100r 2               
000100r 2               SpeedNTSC:
000100r 2  30 2B 26 22    .byte  48, 43, 38, 34, 30, 26, 23, 20   ; levels  1- 8   0.800s .. 0.333s
000104r 2  1E 1A 17 14  
000108r 2  11 0F 0D 0B    .byte  17, 15, 13, 11,  9,  8,  7,  6   ; levels  9-16   0.283s .. 0.100s
00010Cr 2  09 08 07 06  
000110r 2               
000110r 2               SpeedPAL:
000110r 2  28 24 20 1C    .byte  40, 36, 32, 28, 25, 22, 19, 17   ; levels  1- 8   0.800s .. 0.340s
000114r 2  19 16 13 11  
000118r 2  0E 0D 0B 09    .byte  14, 13, 11,  9,  8,  7,  6,  5   ; levels  9-16   0.280s .. 0.100s
00011Cr 2  08 07 06 05  
000120r 2               
000120r 2               ; --- Frame counts that differ by region (SPEC 5.6, 11.3, 14) -----------------
000120r 2               ;   Indexed by Region: 0 = NTSC, 1 = PAL. PAL is round(NTSC * 50/60) wherever
000120r 2               ;   the difference is worth a frame, so a piece takes the same number of
000120r 2               ;   SECONDS to lock on both machines rather than the same number of frames.
000120r 2               ;
000120r 2               ;   Two bytes each rather than one table of pairs, because every read is
000120r 2               ;   `ldx Region / lda Name,x` and a pair table would need the index doubled.
000120r 2               
000120r 2               LockDelay:                              ; SPEC 5.6
000120r 2  10 0E          .byte 16, 14
000122r 2               AreDelay:                               ; Entry delay after a cascade settles
000122r 2  0C 0A          .byte 12, 10
000124r 2               DasInitial:                             ; SPEC 11.3 — first repeat
000124r 2  0C 0A          .byte 12, 10
000126r 2               DasRepeat:                              ; ...and every one after it
000126r 2  04 03          .byte  4,  3
000128r 2               SoftDropRate:                           ; Frames per row while DOWN is held.
000128r 2  03 02          .byte  3,  2                          ;   Never used when gravity is faster.
00012Ar 2               BlinkHalf:                              ; SPEC 14 — half of the 30 / 25 frame
00012Ar 2  0F 0D          .byte 15, 13                          ;   blink period, which is what a
00012Cr 2                                                       ;   blinking field actually counts
00012Cr 2               
00012Cr 2               ; --- Per-tile value for MATCH removals (SPEC 9.1) ----------------------------
00012Cr 2               ;   Indexed by (chain - 1), clamped to 7.   20 50 100 200 300 400 500 600
00012Cr 2               TileValueLo:
00012Cr 2  20 50 00 00    .byte $20, $50, $00, $00, $00, $00, $00, $00
000130r 2  00 00 00 00  
000134r 2               TileValueHi:
000134r 2  00 00 01 02    .byte $00, $00, $01, $02, $03, $04, $05, $06
000138r 2  03 04 05 06  
00013Cr 2               
00013Cr 2               ; --- Per-tile value for EFFECT removals (SPEC 9.2) ---------------------------
00013Cr 2               ;   Indexed by (chain - 1), clamped to 7.   30 60 120 240 350 450 550 650
00013Cr 2               EffectValueLo:
00013Cr 2  30 60 20 40    .byte $30, $60, $20, $40, $50, $50, $50, $50
000140r 2  50 50 50 50  
000144r 2               EffectValueHi:
000144r 2  00 00 01 02    .byte $00, $00, $01, $02, $03, $04, $05, $06
000148r 2  03 04 05 06  
00014Cr 2               
00014Cr 2               ; --- Run length bonus (SPEC 9.3) ---------------------------------------------
00014Cr 2               ;   Indexed by (length - 3), clamped to 4.  0 100 300 600 1000
00014Cr 2               LengthBonusLo:
00014Cr 2  00 00 00 00    .byte $00, $00, $00, $00, $00
000150r 2  00           
000151r 2               LengthBonusHi:
000151r 2  00 01 03 06    .byte $00, $01, $03, $06, $10
000155r 2  10           
000156r 2               
000156r 2               ; --- Simultaneous run bonus (SPEC 9.4) ---------------------------------------
000156r 2               ;   Indexed by (runs - 1), clamped to 4.    0 200 500 1000 2000
000156r 2               MultiBonusLo:
000156r 2  00 00 00 00    .byte $00, $00, $00, $00, $00
00015Ar 2  00           
