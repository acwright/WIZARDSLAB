000000r 1               .setcpu "65C02"
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Wizards Lab — AC6502
000000r 1               ; =============================================================================
000000r 1               ;   A 16 K cartridge for the A.C. Wright 6502, running the TMS9918 in
000000r 1               ;   Graphics Mode I: 32 x 24 cells of 8 x 8 pixels, 256 patterns, and colour
000000r 1               ;   assigned one foreground/background pair per group of eight patterns.
000000r 1               ;
000000r 1               ;   That colour model is the strictest of the three targets, so it is the one
000000r 1               ;   the whole tileset is laid out against — each potion colour owns one group,
000000r 1               ;   and every glyph of that colour lives inside it. See SPEC.md section 4.
000000r 1               ;
000000r 1               ;   This file is the platform half of the contract in src/hal.inc. Everything
000000r 1               ;   it includes from src/ is shared, byte for byte, with the VIC-20 and C64.
000000r 1               ;
000000r 1               ;   Built with AC6502-16K.cfg.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               .include "../include/ac6502.inc"
000000r 2               ; =============================================================================
000000r 2               ;   6502.inc — External include file for the 6502 system
000000r 2               ; =============================================================================
000000r 2               ;
000000r 2               ;   CPU:       WDC 65C02S
000000r 2               ;   BIOS:      v1.5
000000r 2               ;   Assembler: ca65 (cc65 toolchain) — uses := for absolute symbols
000000r 2               ;
000000r 2               ;   Include this file in external projects to access Kernal routines,
000000r 2               ;   IO hardware registers, system variables, and useful constants.
000000r 2               ;
000000r 2               ;   MEMORY MAP
000000r 2               ;   ----------
000000r 2               ;   $0000-$0003   Zero Page: System pointers (see below)
000000r 2               ;   $0004-$0023   Zero Page: Reserved by BASIC interpreter
000000r 2               ;   $0024-$0039   Zero Page: System scratch (CF, serial, delay, monitor, XModem)
000000r 2               ;   $003A-$00FF   Zero Page: Free for user programs
000000r 2               ;   $0100-$01FF   CPU Stack
000000r 2               ;   $0200-$02FF   Input Buffer (ring buffer, managed by Kernal)
000000r 2               ;   $0300-$03FF   Kernal Variables (vectors, cursor, HW flags, etc.)
000000r 2               ;   $0400-$05FF   User Variables / BASIC workspace
000000r 2               ;   $0600-$07FF   FS sector buffer (clobbered by any FS/St routine call)
000000r 2               ;   $0800-$7FFF   Program RAM (30 KB — load address for user code)
000000r 2               ;   $8000-$83FF   IO 1: Banked RAM Low  (256 × ~1 KB banks)
000000r 2               ;   $8400-$87FF   IO 2: Banked RAM High (256 × ~1 KB banks)
000000r 2               ;   $8800-$881F   IO 3: RTC (DS1511Y)
000000r 2               ;   $8C00-$8C07   IO 4: Storage (CompactFlash, 8-bit IDE)
000000r 2               ;   $9000-$9003   IO 5: Serial (R65C51 ACIA)
000000r 2               ;   $9400-$940F   IO 6: GPIO (65C22 VIA — keyboard & joysticks)
000000r 2               ;   $9800-$981C   IO 7: Sound (SID / ARMSID)
000000r 2               ;   $9C00-$9C01   IO 8: Video (TMS9918 / pico9918)
000000r 2               ;   $A000-$A0FF   Kernal Jump Table (stable entry points)
000000r 2               ;   $A100-$B7FF   Kernal Implementation
000000r 2               ;   $B800-$BFFF   Character Set ROM (2 KB, 256 × 8-byte patterns)
000000r 2               ;   $C000-$EDFF   BASIC Interpreter
000000r 2               ;   $EE00-$FEFF   Machine Code Monitor
000000r 2               ;   $FF00-$FFF9   Wozmon (mini monitor)
000000r 2               ;   $FFFA-$FFFF   CPU Vectors (NMI, RESET, IRQ)
000000r 2               ;
000000r 2               ;   BOOT SEQUENCE
000000r 2               ;   -------------
000000r 2               ;   On RESET the BIOS probes all eight IO slots, initializes detected
000000r 2               ;   hardware, and auto-selects video or serial console.  If neither is
000000r 2               ;   found, IO_MODE is left unchanged (no halt — cartridges with their
000000r 2               ;   own display hardware can still boot).  A startup beep plays (if SID
000000r 2               ;   is present) for audible feedback, then BOOT_VECTOR ($035B) is
000000r 2               ;   checked — if non-zero, execution jumps there (cartridge takeover).
000000r 2               ;   Otherwise a console check halts if no video/serial is found, then
000000r 2               ;   the splash screen and boot menu are displayed.  ENTER launches
000000r 2               ;   BASIC; ESC enters the Monitor.  A 5-second timeout auto-boots BASIC.
000000r 2               ;   The splash is drawn on whichever console is active — centred on the
000000r 2               ;   40-column screen, or left-aligned as plain text over serial.
000000r 2               ;
000000r 2               ;   GRACEFUL DEGRADATION
000000r 2               ;   --------------------
000000r 2               ;   Every Kernal routine that drives a card checks HW_PRESENT first, so
000000r 2               ;   a call on a machine without that card is safe rather than a crash.
000000r 2               ;   Routines with nothing to report back return silently (video and SID);
000000r 2               ;   routines that move data report failure in the carry (CompactFlash).
000000r 2               ;   The per-routine notes below say which behaviour each one has.
000000r 2               ;
000000r 2               ;   CARTRIDGE SUPPORT
000000r 2               ;   -----------------
000000r 2               ;   Cartridges overlay $C000-$FFFF (BASIC, Monitor, Wozmon, vectors).
000000r 2               ;   The Kernal ($A000-$B7FF) and character set ($B800-$BFFF) remain
000000r 2               ;   accessible.  Use KernalInit ($A078) to initialize all hardware and
000000r 2               ;   return via RTS — interrupts are left disabled so the cart can set
000000r 2               ;   up its own handlers first.  See usage patterns in the BIOS README.
000000r 2               ;
000000r 2               ;   IO_MODE
000000r 2               ;   -------
000000r 2               ;   Bit 0 of IO_MODE selects the console output device:
000000r 2               ;     0 = Video (TMS9918)    1 = Serial (R65C51)
000000r 2               ;   Chrout ($A000) dispatches automatically based on IO_MODE.
000000r 2               ;   Use SetIOMode / GetIOMode to change or query the active console.
000000r 2               ;
000000r 2               ;   CALLING CONVENTION
000000r 2               ;   ------------------
000000r 2               ;   Kernal routines are called via JSR to the jump table addresses below.
000000r 2               ;   Parameters are passed in A, X, Y, and/or zero-page pointers as
000000r 2               ;   documented per routine.  Carry flag is used for success/error returns
000000r 2               ;   (C=0 success, C=1 error) where noted.
000000r 2               ;
000000r 2               ;   HW_PRESENT BITMASK
000000r 2               ;   -------------------
000000r 2               ;   After boot, HW_PRESENT ($030D) contains a bitmask of detected hardware.
000000r 2               ;   Test individual bits before calling hardware-specific routines.
000000r 2               ;   Example:
000000r 2               ;     lda HW_PRESENT
000000r 2               ;     and #HW_VID          ; Is video card present?
000000r 2               ;     beq @NoVideo         ; Skip if not
000000r 2               ;
000000r 2               ; =============================================================================
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 1: ZERO PAGE POINTERS
000000r 2               ; =============================================================================
000000r 2               ; These zero page locations are used by the Kernal.  External programs may
000000r 2               ; use STR_PTR and CF_BUF_PTR/CF_LBA as parameters to Kernal calls.
000000r 2               ; Locations $3A-$FF are free for user programs.
000000r 2               
000000r 2               STR_PTR             := $02               ; 2 bytes — String pointer (used by FsLoadFile, FsSaveFile, FsDeleteFile, etc.)
000000r 2               CF_BUF_PTR          := $24               ; 2 bytes — CF sector data buffer pointer
000000r 2               CF_LBA              := $26               ; 4 bytes — CF 28-bit LBA address (little-endian)
000000r 2               XFER_PTR            := $2A               ; 2 bytes — XModem transfer data pointer (source for XModemSave, dest for XModemLoad)
000000r 2               
000000r 2               ; Safe zero page range for user programs:
000000r 2               ; $3A-$FF (198 bytes free)
000000r 2               ; Note: $2E-$35 belong to the Monitor and $36-$39 to XModemLoad/XModemSave;
000000r 2               ;       neither range survives a call into those routines
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 2: SYSTEM VARIABLES ($0300-$03FF)
000000r 2               ; =============================================================================
000000r 2               
000000r 2               IRQ_PTR             := $0300             ; 2 bytes — IRQ handler vector (writable; default: internal Irq handler)
000000r 2               BRK_PTR             := $0302             ; 2 bytes — BRK handler vector (writable; default: enters Monitor)
000000r 2               NMI_PTR             := $0304             ; 2 bytes — NMI handler vector (writable; default: RTI)
000000r 2               
000000r 2               IO_MODE             := $0306             ; 1 byte  — Console output mode (bit 0: 0=video, 1=serial)
000000r 2               VID_CURSOR_X        := $0307             ; 1 byte  — Video cursor column (0-39)
000000r 2               VID_CURSOR_Y        := $0308             ; 1 byte  — Video cursor row (0-23)
000000r 2               
000000r 2               HW_PRESENT          := $030D             ; 1 byte  — Hardware present bitmask (set during boot probe)
000000r 2               CF_DISK             := $030F             ; 1 byte  — Current CF disk bank (0–255); base LBA = CF_DISK × FS_DISK_SECTORS; reset to 0 on boot
000000r 2               
000000r 2               ; HW_PRESENT bit definitions (bit order matches IO slot numbers):
000000r 2               HW_RAM_L            = %00000001          ; Bit 0: RAM card low  (IO 1, $8000-$83FF)
000000r 2               HW_RAM_H            = %00000010          ; Bit 1: RAM card high (IO 2, $8400-$87FF)
000000r 2               HW_RTC              = %00000100          ; Bit 2: RTC card      (IO 3, DS1511Y)
000000r 2               HW_CF               = %00001000          ; Bit 3: Storage card   (IO 4, CompactFlash)
000000r 2               HW_SC               = %00010000          ; Bit 4: Serial card    (IO 5, R65C51)
000000r 2               HW_GPIO             = %00100000          ; Bit 5: GPIO card      (IO 6, 65C22 VIA — keyboard/joysticks)
000000r 2               HW_SID              = %01000000          ; Bit 6: Sound card     (IO 7, SID/ARMSID)
000000r 2               HW_VID              = %10000000          ; Bit 7: Video card     (IO 8, TMS9918/pico9918)
000000r 2               
000000r 2               ; BRK register save area (populated by the BRK handler before entering Monitor):
000000r 2               BRK_P               := $0310             ; Saved processor status (P)
000000r 2               BRK_PCL             := $0311             ; Saved PC low byte (points to BRK instruction + 2)
000000r 2               BRK_PCH             := $0312             ; Saved PC high byte
000000r 2               BRK_A               := $0313             ; Saved accumulator
000000r 2               BRK_X               := $0314             ; Saved X register
000000r 2               BRK_Y               := $0315             ; Saved Y register
000000r 2               BRK_SP              := $0316             ; Saved stack pointer
000000r 2               
000000r 2               XFER_REMAIN         := $0317             ; 2 bytes — XModem byte count (output from XModemLoad; input to XModemSave)
000000r 2               XFER_IO_SAVE        := $0319             ; 1 byte  — Saved IO_MODE during XModem transfer (internal use)
000000r 2               
000000r 2               ; RTC scratch (used by RtcWriteDate to pass century):
000000r 2               RTC_BUF_CENT        := $030B             ; Century value for RtcReadDate / RtcWriteDate
000000r 2               
000000r 2               ; Cartridge / boot redirect vector:
000000r 2               BOOT_VECTOR         := $035B             ; 2 bytes — Boot redirect address (0=normal boot)
000000r 2                                                        ;   Set after KernalInit to redirect Reset flow
000000r 2                                                        ;   KernalInit zeroes this; write after init returns
000000r 2               FS_IO_ADDR          := $037F             ; 2 bytes — Load/save target address for FsLoadFileAddr / FsSaveFileAddr
000000r 2               FS_FILE_SIZE        := $034A             ; 2 bytes — File size in bytes (set by caller for FsSaveFileAddr; populated by FsLoadFileAddr)
000000r 2               
000000r 2               ; Program image handoff (v1.3):
000000r 2               PRG_IMAGE_END       := $038E             ; 2 bytes — End address of a program image placed at
000000r 2                                                        ;   PROGRAM_START by a loader running outside BASIC
000000r 2                                                        ;   (e.g. the Monitor's L command); 0 = none.
000000r 2                                                        ;   KernalInit zeroes it; BASIC consumes and re-zeroes it
000000r 2                                                        ;   on entry, so a stale value is never acted on twice.
000000r 2                                                        ;   A loader that drops a .prg at $0800 and then hands
000000r 2                                                        ;   off to BASIC should write the end address here so
000000r 2                                                        ;   the attached machine code survives LOAD/SAVE.
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 3: KEY MEMORY LOCATIONS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               INPUT_BUFFER        := $0200             ; $0200-$02FF — 256-byte ring buffer (keyboard/serial input)
000000r 2               PROGRAM_START       := $0800             ; User programs and BASIC programs load here
000000r 2               ;                                        ; Program space extends to $7FFF (30 KB)
000000r 2               MEMORY_TOP          := $8000             ; First address past usable RAM (IO space starts here)
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 4: KERNAL JUMP TABLE ($A000-$A0FF)
000000r 2               ; =============================================================================
000000r 2               ; All entry points are stable 3-byte JMP instructions.  Call via JSR.
000000r 2               ; Unimplemented slots return immediately (RTS).
000000r 2               
000000r 2               ; --- Character I/O ---
000000r 2               Chrout              := $A000             ; Output character (dispatched by IO_MODE)
000000r 2                                                        ;   In: A = character
000000r 2                                                        ;   Preserves: A, X, Y
000000r 2                                                        ;   Handles CR ($0D), LF ($0A), BS ($08), BEL ($07) in video mode
000000r 2               
000000r 2               Chrin               := $A003             ; Input character from buffer (non-blocking poll)
000000r 2                                                        ;   Out: A = character, C=1 if char available, C=0 if not
000000r 2                                                        ;   Caller must loop until C=1 for blocking behavior
000000r 2                                                        ;   Echoes character via Chrout
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               WriteBuffer         := $A006             ; Write byte to input ring buffer
000000r 2                                                        ;   In: A = byte to write
000000r 2                                                        ;   Modifies: X
000000r 2               
000000r 2               ReadBuffer          := $A009             ; Read byte from input ring buffer
000000r 2                                                        ;   Out: A = byte read
000000r 2                                                        ;   Modifies: X, A
000000r 2               
000000r 2               BufferSize          := $A00C             ; Get number of unread bytes in input buffer
000000r 2                                                        ;   Out: A = count
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- IO Mode ---
000000r 2               SetIOMode           := $A00F             ; Set IO_MODE
000000r 2                                                        ;   In: A = mode (bit 0: 0=video, 1=serial)
000000r 2               
000000r 2               GetIOMode           := $A012             ; Get IO_MODE
000000r 2                                                        ;   Out: A = current IO_MODE
000000r 2               
000000r 2               ; --- Video (TMS9918 / pico9918) ---
000000r 2               InitVideo           := $A015             ; Initialize TMS9918 (text mode, 40×24)
000000r 2                                                        ;   Writes the 8 mode registers, then reloads the
000000r 2                                                        ;   character set into the pattern table (VRAM $0800)
000000r 2                                                        ;   A program that switched the VDP to a graphics mode
000000r 2                                                        ;   can fully restore text mode with this one call
000000r 2                                                        ;   STR_PTR is used internally but saved and restored
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoClear          := $A018             ; Clear screen (fill with spaces), reset cursor to (0,0)
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoPutChar        := $A01B             ; Write character at cursor position (no cursor advance)
000000r 2                                                        ;   In: A = character
000000r 2               
000000r 2               VideoSetCursor      := $A01E             ; Set cursor position
000000r 2                                                        ;   In: X = column (0-39), Y = row (0-23)
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               VideoGetCursor      := $A021             ; Get cursor position
000000r 2                                                        ;   Out: X = column (0-39), Y = row (0-23)
000000r 2               
000000r 2               VideoScroll         := $A024             ; Scroll screen up one line, clear bottom row
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoSetColor       := $A027             ; Set TMS9918 text color
000000r 2                                                        ;   In: A = color byte (high nibble = foreground, low nibble = background)
000000r 2                                                        ;   See TMS9918 Color Constants below
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               VideoChroutRaw      := $A02A             ; Output char to video with no control-code handling
000000r 2                                                        ;   In: A = character code (0-255)
000000r 2                                                        ;   Preserves: A, X, Y
000000r 2                                                        ;   Always renders glyph, never interprets CR/LF/BS/BEL
000000r 2               
000000r 2               ; --- Sound (SID / ARMSID) ---
000000r 2               InitSID             := $A02D             ; Initialize SID (clear all registers, volume=15)
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               Beep                := $A030             ; Play short beep tone (~475 Hz)
000000r 2                                                        ;   Skips silently if no SID detected
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               SidPlayNote         := $A033             ; Play note on a SID voice
000000r 2                                                        ;   In: A = voice (0-2), X = freq low, Y = freq high
000000r 2                                                        ;   Uses triangle waveform, ADSR: A=0 D=9 S=F R=8
000000r 2                                                        ;   Full sustain holds the note flat until gated off
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SidSilence          := $A036             ; Silence all 3 SID voices (gate off only)
000000r 2                                                        ;   Frequencies are left intact — the envelope release
000000r 2                                                        ;   rings the tone out.  Zeroing freq would freeze the
000000r 2                                                        ;   waveform and decay a DC offset (audible thump)
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SidSetVolume        := $A039             ; Set SID master volume
000000r 2                                                        ;   In: A = volume (0-15); only the low nibble is used
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- Filesystem (disk-banked, 16-file directory per disk) ---
000000r 2               ;   The CF card is divided into 256 disk banks of 1 MB each (FS_DISK_SECTORS
000000r 2               ;   sectors × 512 bytes).  CF_DISK ($030F) selects the active bank (reset to
000000r 2               ;   0 on boot).  Use FsSetDisk / FsGetDisk to change it at runtime.  Each
000000r 2               ;   bank has its own directory at the first sector, holding up to 16 entries
000000r 2               ;   (8.3 filenames, space-padded, case-insensitive).  All FS routines and
000000r 2               ;   StReadSector / StWriteSector operate on the selected bank automatically.
000000r 2               ;   Pass null-terminated "NAME.EXT" string via STR_PTR ($02-$03).
000000r 2               ;   Use FsLoadFileAddr / FsSaveFileAddr for load-to-address transfers.
000000r 2               ;   The extension is inert — nothing in the BIOS branches on it, so .PRG, .BAS
000000r 2               ;   and .FOO behave identically.  What a file means is decided by the routine
000000r 2               ;   that loads it, never by its name.
000000r 2               ;   All FS routines use $0600-$07FF as a 512-byte sector buffer.
000000r 2               
000000r 2               FsLoadFile          := $A03C             ; Load file from CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 not found or error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSaveFile          := $A03F             ; Save file to CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsDeleteFile        := $A042             ; Delete file from CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 not found or error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- Keyboard / GPIO ---
000000r 2               InitKB              := $A045             ; Initialize VIA for keyboard input
000000r 2                                                        ;   Configures Port A/B as inputs, enables CB1/CA1 IRQs
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- Joysticks ---
000000r 2               ;   Both ports are ACTIVE LOW — each line is pulled up through 1K and grounded
000000r 2               ;   by its switch — and both routines return the port read raw.  So a held
000000r 2               ;   button is a 0 bit and an untouched stick reads $FF:
000000r 2               ;
000000r 2               ;     Bit:  7   6   5   4   3   2   1   0
000000r 2               ;           R   L   D   U   Y   X   B   A
000000r 2               ;
000000r 2               ;   Test a direction with:  lda ... / and #%00010000 / beq @UpHeld
000000r 2               ;
000000r 2               ;   Neither routine checks HW_PRESENT — with no GPIO card fitted they read a
000000r 2               ;   floating bus and the value is meaningless.  Test HW_GPIO first if the card
000000r 2               ;   may be absent.  (BASIC's JOY() does this and reports $FF.)
000000r 2               ;
000000r 2               ;   Both routines release both encoders (KBDisable), read the port, then
000000r 2               ;   re-enable them (KBEnable).  The interrupt state is left alone.
000000r 2               
000000r 2               ReadJoystick1       := $A048             ; Read joystick 1 (VIA Port B)
000000r 2                                                        ;   Out: A = bitmask (active low, see above)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               ReadJoystick2       := $A04B             ; Read joystick 2 (VIA Port A)
000000r 2                                                        ;   Out: A = bitmask (active low, see above)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               ; --- Serial (R65C51) ---
000000r 2               InitSC              := $A04E             ; Initialize serial card (8-N-1, 19200 baud)
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SerialChrout        := $A051             ; Direct serial output (bypasses IO_MODE)
000000r 2                                                        ;   In: A = character
000000r 2                                                        ;   Blocks until TX register is empty
000000r 2               
000000r 2               ; --- Serial Transfer ---
000000r 2               XModemLoad          := $A054             ; Receive data via XModem into memory
000000r 2                                                        ;   Protocol: standard XModem (128-byte blocks, checksum)
000000r 2                                                        ;   In: XFER_PTR = destination address
000000r 2                                                        ;   Out: C=0 success, XFER_PTR advanced past last byte written
000000r 2                                                        ;        XFER_REMAIN = total bytes received
000000r 2                                                        ;        C=1 transfer failed (timeout or CAN received)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               XModemSave          := $A057             ; Send data via XModem from memory
000000r 2                                                        ;   Protocol: standard XModem (128-byte blocks, checksum)
000000r 2                                                        ;   In: XFER_PTR = source address, XFER_REMAIN = byte count
000000r 2                                                        ;   Out: C=0 success, C=1 transfer failed (timeout or CAN received)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- RTC (DS1511Y) ---
000000r 2               RtcReadTime         := $A05A             ; Read current time
000000r 2                                                        ;   Out: A = hours, X = minutes, Y = seconds (all binary)
000000r 2               
000000r 2               RtcReadDate         := $A05D             ; Read current date
000000r 2                                                        ;   Out: A = day, X = month, Y = year (all binary)
000000r 2                                                        ;   RTC_BUF_CENT ($030B) = century
000000r 2               
000000r 2               RtcWriteTime        := $A060             ; Set RTC time
000000r 2                                                        ;   In: A = hours, X = minutes, Y = seconds (all binary)
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               RtcWriteDate        := $A063             ; Set RTC date
000000r 2                                                        ;   In: A = day, X = month, Y = year (all binary)
000000r 2                                                        ;   RTC_BUF_CENT ($030B) must hold century
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               RtcReadNVRAM        := $A066             ; Read byte from DS1511Y NVRAM (256 bytes)
000000r 2                                                        ;   In: X = address ($00-$FF)
000000r 2                                                        ;   Out: A = data byte
000000r 2               
000000r 2               RtcWriteNVRAM       := $A069             ; Write byte to DS1511Y NVRAM
000000r 2                                                        ;   In: X = address ($00-$FF), A = data byte
000000r 2               
000000r 2               ; --- CompactFlash Storage ---
000000r 2               StReadSector        := $A06C             ; Read one 512-byte sector
000000r 2                                                        ;   In: CF_LBA ($26-$29) = LBA, CF_BUF_PTR ($24-$25) = dest
000000r 2                                                        ;   Out: C=0 success, C=1 error; CF_BUF_PTR advanced by 512
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               StWriteSector       := $A06F             ; Write one 512-byte sector
000000r 2                                                        ;   In: CF_LBA ($26-$29) = LBA, CF_BUF_PTR ($24-$25) = source
000000r 2                                                        ;   Out: C=0 success, C=1 error; CF_BUF_PTR advanced by 512
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               StWaitReady         := $A072             ; Wait for CF to become ready (BSY=0, RDY=1)
000000r 2                                                        ;   Out: C=0 ready, C=1 timeout/error
000000r 2                                                        ;   Returns C=1 at once if the boot probe found no CF
000000r 2                                                        ;   card, rather than spinning out the full timeout.
000000r 2                                                        ;   Every FS and sector routine passes through here, so
000000r 2                                                        ;   an empty slot fails fast throughout the stack
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- Timing ---
000000r 2               SysDelay            := $A075             ; Delay for specified centiseconds (10 ms units)
000000r 2                                                        ;   In: A = low byte, X = high byte (16-bit count)
000000r 2                                                        ;   Uses VIA T1 if available, else software loop
000000r 2                                                        ;   Modifies: A, X, Y (X/Y clobbered only in software-fallback path)
000000r 2               
000000r 2               ; --- System / Cartridge Support ---
000000r 2               KernalInit          := $A078             ; Initialize all hardware (vectors, probe & init all I/O)
000000r 2                                                        ;   Caller MUST reset the stack pointer before JSR:
000000r 2                                                        ;     ldx #$ff / txs / jsr KernalInit
000000r 2                                                        ;   Zeroes BOOT_VECTOR, PRG_IMAGE_END and CF_DISK;
000000r 2                                                        ;   sets HW_PRESENT, IO_MODE, IRQ/BRK/NMI ptrs
000000r 2                                                        ;   Does NOT reset the stack pointer
000000r 2                                                        ;   Does NOT enable interrupts (caller must CLI)
000000r 2                                                        ;   Does NOT play beep, display splash, or enter boot menu
000000r 2                                                        ;   Does NOT halt if no console is detected
000000r 2                                                        ;   Modifies: All registers, flags
000000r 2               
000000r 2               KernalVersion       := $A07B             ; Get BIOS version
000000r 2                                                        ;   Out: A = major version, X = minor version
000000r 2               
000000r 2               ; --- Disk-banking & addressed storage (v1.1) ---
000000r 2               ;   CF_DISK ($030F) selects the current disk bank (0–255).
000000r 2               ;   All FS routines, StReadSector, and StWriteSector address the selected
000000r 2               ;   bank automatically.  Bank changes survive until the next reset.
000000r 2               
000000r 2               FsLoadFileAddr      := $A07E             ; Load named file from current disk to FS_IO_ADDR
000000r 2                                                        ;   In: STR_PTR = null-terminated filename
000000r 2                                                        ;       FS_IO_ADDR ($037F) = destination address
000000r 2                                                        ;   Out: C=0 success, FS_FILE_SIZE = bytes loaded; C=1 error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSaveFileAddr      := $A081             ; Save FS_FILE_SIZE bytes from FS_IO_ADDR to a named file
000000r 2                                                        ;   In: STR_PTR = filename
000000r 2                                                        ;       FS_IO_ADDR ($037F) = source address
000000r 2                                                        ;       FS_FILE_SIZE ($034A) = byte count
000000r 2                                                        ;   Out: C=0 success, C=1 error (disk full or write error)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsFormatDisk        := $A084             ; Zero the current disk's directory (erases all 16 entries)
000000r 2                                                        ;   Out: C=0 success, C=1 write error
000000r 2                                                        ;   No confirmation prompt — caller is responsible
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSetDisk           := $A087             ; Select the current CF disk bank
000000r 2                                                        ;   In: A = disk number (0–255) → stored in CF_DISK ($030F)
000000r 2                                                        ;   Modifies: Flags
000000r 2               
000000r 2               FsGetDisk           := $A08A             ; Get the current CF disk bank
000000r 2                                                        ;   Out: A = CF_DISK value (0–255)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               FsPrintDisk         := $A08D             ; Print "DISK n" + CRLF via Chrout (decimal, no leading zeros)
000000r 2                                                        ;   Uses current CF_DISK
000000r 2                                                        ;   Modifies: Flags, A, X, Y
000000r 2               
000000r 2               ; --- General Output Utilities (console routed by IO_MODE via Chrout) ---
000000r 2               PrintStr            := $A090             ; Print a NUL-terminated string
000000r 2                                                        ;   In : A = string addr low, Y = string addr high
000000r 2                                                        ;   Modifies: Flags, A, Y, STR_PTR (X preserved)
000000r 2               PrintCRLF           := $A093             ; Print CR ($0D) then LF ($0A)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               PrintDecU16         := $A096             ; Print an unsigned 16-bit value as decimal
000000r 2                                                        ;   In : A = value low, X = value high (no leading zeros)
000000r 2                                                        ;   Modifies: Flags, A, X, Y, FS_FILE_SIZE, FS_DIR_IDX
000000r 2               
000000r 2               ; --- Keyboard Encoder Control (raw GPIO port access) ---
000000r 2               ;   Both keyboard encoders drive the VIA ports the joysticks share.  Disable
000000r 2               ;   them to read GPIO_PORTA/GPIO_PORTB directly, then re-enable them.  The
000000r 2               ;   ReadJoystick routines do this for you; call these only for custom reads.
000000r 2               KBDisable           := $A099             ; Release both encoders and wait for them to let go
000000r 2                                                        ;   Busy-waits ~200 us so the ports settle before reading
000000r 2                                                        ;   Safe to call while the caller owns the VIA timers
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               KBEnable            := $A09C             ; Re-enable both keyboard encoders
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 5: IO HARDWARE REGISTERS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Banked RAM Low (IO 1: $8000-$83FF) ---
000000r 2               ;   256 banks × ~1 KB each.  Write bank number to latch, then access data window.
000000r 2               RAM_DATA_L          := $8000             ; R/W data window ($8000-$83FE)
000000r 2               RAM_BANK_L          := $83FF             ; Write-only bank latch ($00-$FF)
000000r 2               
000000r 2               ; --- Banked RAM High (IO 2: $8400-$87FF) ---
000000r 2               RAM_DATA_H          := $8400             ; R/W data window ($8400-$87FE)
000000r 2               RAM_BANK_H          := $87FF             ; Write-only bank latch ($00-$FF)
000000r 2               
000000r 2               ; --- RTC (DS1511Y) (IO 3: $8800-$881F) ---
000000r 2               RTC_SEC             := $8800             ; Seconds      (BCD, 00-59)
000000r 2               RTC_MIN             := $8801             ; Minutes      (BCD, 00-59)
000000r 2               RTC_HR              := $8802             ; Hours        (BCD, 00-23, 24h mode)
000000r 2               RTC_DAY             := $8803             ; Day of week  (1-7)
000000r 2               RTC_DATE            := $8804             ; Day of month (BCD, 01-31)
000000r 2               RTC_MON             := $8805             ; Month        (BCD, 01-12)
000000r 2               RTC_YR              := $8806             ; Year         (BCD, 00-99)
000000r 2               RTC_CENT            := $8807             ; Century      (BCD, 00-39)
000000r 2               RTC_ALARM_SEC       := $8808             ; Alarm seconds
000000r 2               RTC_ALARM_MIN       := $8809             ; Alarm minutes
000000r 2               RTC_ALARM_HR        := $880A             ; Alarm hours
000000r 2               RTC_ALARM_DATE      := $880B             ; Alarm day of month
000000r 2               RTC_WD_L            := $880C             ; Watchdog low
000000r 2               RTC_WD_H            := $880D             ; Watchdog high
000000r 2               RTC_CTRL_A          := $880E             ; Control Register A
000000r 2               RTC_CTRL_B          := $880F             ; Control Register B
000000r 2               RTC_RAM_ADDR        := $8810             ; NVRAM address register
000000r 2               RTC_RAM_DATA        := $8813             ; NVRAM data register
000000r 2               ; Control Register B bits:
000000r 2               RTC_CTRL_B_TE       := %10000000         ; Transfer Enable — set to inhibit clock updates during write
000000r 2               ; Month register ($8805) — the upper 3 bits are oscillator/SQW control, not month data.
000000r 2               ; Always mask with RTC_MON_MASK when reading the month, and preserve these bits on write.
000000r 2               RTC_MON_MASK        := %00011111         ; Month value occupies the low 5 bits
000000r 2               RTC_MON_EOSC        := %10000000         ; Oscillator Start/Stop (0 = oscillator running)
000000r 2               RTC_MON_E32K        := %01000000         ; 32 kHz square-wave enable (1 = SQW output disabled)
000000r 2               RTC_MON_BB32        := %00100000         ; Battery-backup 32 kHz SQW enable (1 = enabled in backup)
000000r 2               
000000r 2               ; --- CompactFlash / Storage (IO 4: $8C00-$8C07) ---
000000r 2               ;   8-bit IDE (True IDE) mode.  The BIOS issues Set Features $01 at boot
000000r 2               ;   to enable 8-bit data transfers.
000000r 2               ST_DATA             := $8C00             ; R/W — Data register
000000r 2               ST_ERROR            := $8C01             ; Read — Error register
000000r 2               ST_FEATURE          := $8C01             ; Write — Feature register
000000r 2               ST_SECT_CNT         := $8C02             ; R/W — Sector count
000000r 2               ST_LBA_0            := $8C03             ; R/W — LBA bits 0-7
000000r 2               ST_LBA_1            := $8C04             ; R/W — LBA bits 8-15
000000r 2               ST_LBA_2            := $8C05             ; R/W — LBA bits 16-23
000000r 2               ST_LBA_3            := $8C06             ; R/W — LBA bits 24-27 + drive/mode
000000r 2               ST_STATUS           := $8C07             ; Read — Status register
000000r 2               ST_CMD              := $8C07             ; Write — Command register
000000r 2               
000000r 2               ; CF Status Register bits:
000000r 2               ST_STATUS_ERR       := %00000001         ; Error occurred
000000r 2               ST_STATUS_IDX       := %00000010         ; Index mark
000000r 2               ST_STATUS_CORR      := %00000100         ; Corrected data
000000r 2               ST_STATUS_DRQ       := %00001000         ; Data request — ready for data transfer
000000r 2               ST_STATUS_DSC       := %00010000         ; Drive seek complete
000000r 2               ST_STATUS_DWF       := %00100000         ; Drive write fault
000000r 2               ST_STATUS_RDY       := %01000000         ; Drive ready
000000r 2               ST_STATUS_BSY       := %10000000         ; Drive busy — all other bits invalid while set
000000r 2               
000000r 2               ; CF Error Register bits:
000000r 2               ST_ERR_AMNF         := %00000001         ; Address mark not found
000000r 2               ST_ERR_ABRT         := %00000100         ; Command aborted
000000r 2               ST_ERR_IDNF         := %00010000         ; ID not found
000000r 2               ST_ERR_UNC          := %01000000         ; Uncorrectable data error
000000r 2               ST_ERR_BBK          := %10000000         ; Bad block detected
000000r 2               
000000r 2               ; ATA Command bytes:
000000r 2               ST_CMD_READ         := $20               ; Read Sectors
000000r 2               ST_CMD_WRITE        := $30               ; Write Sectors
000000r 2               ST_CMD_SET_FEAT     := $EF               ; Set Features
000000r 2               ST_FEAT_8BIT        := $01               ; Feature: Enable 8-bit data I/O
000000r 2               ST_LBA3_MASTER      := $E0               ; LBA mode, master drive (bits 7-5=111, bit 4=0)
000000r 2               
000000r 2               ; Filesystem constants:
000000r 2               FS_DIR_LBA          = 0                  ; Directory sector at LBA 0
000000r 2               FS_DATA_START       = 1                  ; Data sectors start at LBA 1
000000r 2               FS_MAX_FILES        = 16                 ; Maximum directory entries
000000r 2               FS_ENTRY_SIZE       = 32                 ; Bytes per directory entry
000000r 2               FS_ENTRY_FLAGS      = 11                 ; Offset: flags byte within entry
000000r 2               FS_ENTRY_START      = 12                 ; Offset: start sector (2 bytes, little-endian)
000000r 2               FS_ENTRY_FSIZE      = 14                 ; Offset: file size (2 bytes, little-endian)
000000r 2               FS_FLAG_USED        = %00000001          ; Flags bit 0: entry in use
000000r 2               FS_DISK_SECTORS     = 2048               ; Sectors per disk bank (2048 × 512 bytes = 1 MB); 256 banks = 256 MB total
000000r 2               
000000r 2               ; XModem protocol constants (used with XModemLoad / XModemSave):
000000r 2               XMODEM_SOH          = $01                ; Start of Header
000000r 2               XMODEM_EOT          = $04                ; End of Transmission
000000r 2               XMODEM_ACK          = $06                ; Acknowledge
000000r 2               XMODEM_NAK          = $15                ; Negative Acknowledge (receiver sends to initiate transfer)
000000r 2               XMODEM_CAN          = $18                ; Cancel
000000r 2               XMODEM_SUB          = $1A                ; Padding byte (fills unused bytes in last block)
000000r 2               XMODEM_BLKSZ        = 128                ; Data bytes per block
000000r 2               XMODEM_MAXRETRY     = 10                 ; Max retries per block during transfer
000000r 2               XMODEM_STARTRETRY   = 60                 ; Retries waiting for initial connect (~60s)
000000r 2               
000000r 2               ; --- Serial Card (R65C51 ACIA) (IO 5: $9000-$9003) ---
000000r 2               ;   Default config after InitSC: 8-N-1, 19200 baud, RX IRQ enabled
000000r 2               SC_DATA             := $9000             ; R/W — Data register
000000r 2               SC_RESET            := $9001             ; Write — Programmatic reset (write any value)
000000r 2               SC_STATUS           := $9001             ; Read — Status register
000000r 2               SC_CMD              := $9002             ; R/W — Command register
000000r 2               SC_CTRL             := $9003             ; R/W — Control register
000000r 2               
000000r 2               ; Serial Status Register bits:
000000r 2               SC_STATUS_IRQ       := %10000000         ; Interrupt occurred
000000r 2               SC_STATUS_DSR       := %01000000         ; Data Set Ready
000000r 2               SC_STATUS_DCD       := %00100000         ; Data Carrier Detect
000000r 2               SC_STATUS_TDRE      := %00010000         ; TX Data Register Empty (ready to send)
000000r 2               SC_STATUS_RDRF      := %00001000         ; RX Data Register Full (byte available)
000000r 2               SC_STATUS_OVR       := %00000100         ; Overrun error
000000r 2               SC_STATUS_FRME      := %00000010         ; Framing error
000000r 2               SC_STATUS_PARE      := %00000001         ; Parity error
000000r 2               
000000r 2               ; --- GPIO / Input Board (65C22 VIA) (IO 6: $9400-$940F) ---
000000r 2               ;   Port B = matrix keyboard / joystick 1
000000r 2               ;   Port A = PS/2 keyboard / joystick 2
000000r 2               ;   CB1/CA1 IRQs fire when a key scancode is ready
000000r 2               GPIO_PORTB          := $9400             ; Port B data (active keyboard/joystick 1 data)
000000r 2               GPIO_PORTA          := $9401             ; Port A data (active keyboard/joystick 2 data)
000000r 2               GPIO_DDRB           := $9402             ; Port B data direction (0=input, 1=output per bit)
000000r 2               GPIO_DDRA           := $9403             ; Port A data direction
000000r 2               GPIO_T1CL           := $9404             ; Timer 1 counter low (read=counter, write=latch)
000000r 2               GPIO_T1CH           := $9405             ; Timer 1 counter high (write starts timer)
000000r 2               GPIO_T1LL           := $9406             ; Timer 1 latch low
000000r 2               GPIO_T1LH           := $9407             ; Timer 1 latch high
000000r 2               GPIO_T2CL           := $9408             ; Timer 2 counter low
000000r 2               GPIO_T2CH           := $9409             ; Timer 2 counter high
000000r 2               GPIO_SR             := $940A             ; Shift register
000000r 2               GPIO_ACR            := $940B             ; Auxiliary control register
000000r 2               GPIO_PCR            := $940C             ; Peripheral control register
000000r 2               GPIO_IFR            := $940D             ; Interrupt flag register
000000r 2               GPIO_IER            := $940E             ; Interrupt enable register
000000r 2               GPIO_ORA            := $940F             ; Port A (no handshake)
000000r 2               
000000r 2               ; VIA Peripheral Control Register (PCR) mode bits:
000000r 2               GPIO_PCR_CB2_LO     := %11000000         ; CB2 = manual output low  (enable matrix keyboard encoder)
000000r 2               GPIO_PCR_CB2_HI     := %11100000         ; CB2 = manual output high (disable matrix keyboard encoder)
000000r 2               GPIO_PCR_CB1_NEG    := %00000000         ; CB1 = active on falling edge
000000r 2               GPIO_PCR_CA2_LO     := %00001100         ; CA2 = manual output low  (enable PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA2_HI     := %00001110         ; CA2 = manual output high (disable PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA1_NEG    := %00000000         ; CA1 = active on falling edge
000000r 2               
000000r 2               ; VIA Interrupt flag/enable bits:
000000r 2               GPIO_INT_CB1        := %00010000         ; Bit 4: CB1 interrupt (matrix keyboard data ready)
000000r 2               GPIO_INT_CA1        := %00000010         ; Bit 1: CA1 interrupt (PS/2 keyboard data ready)
000000r 2               GPIO_IER_SET        := %10000000         ; IER bit 7: 1=set named bits, 0=clear named bits
000000r 2               
000000r 2               ; --- Sound Card (SID / ARMSID) (IO 7: $9800-$981C) ---
000000r 2               ;   MOS 6581/8580 compatible.  3 voices, each with independent frequency,
000000r 2               ;   pulse width, waveform, and ADSR envelope.  Global filter and volume.
000000r 2               
000000r 2               ; Voice 1:
000000r 2               SID_V1_FREQ_LO      := $9800             ; Frequency low byte
000000r 2               SID_V1_FREQ_HI      := $9801             ; Frequency high byte
000000r 2               SID_V1_PW_LO        := $9802             ; Pulse width low byte (bits 0-7)
000000r 2               SID_V1_PW_HI        := $9803             ; Pulse width high nibble (bits 0-3)
000000r 2               SID_V1_CTRL         := $9804             ; Control register (waveform + gate)
000000r 2               SID_V1_AD           := $9805             ; Attack (high nibble) / Decay (low nibble)
000000r 2               SID_V1_SR           := $9806             ; Sustain (high nibble) / Release (low nibble)
000000r 2               
000000r 2               ; Voice 2:
000000r 2               SID_V2_FREQ_LO      := $9807
000000r 2               SID_V2_FREQ_HI      := $9808
000000r 2               SID_V2_PW_LO        := $9809
000000r 2               SID_V2_PW_HI        := $980A
000000r 2               SID_V2_CTRL         := $980B
000000r 2               SID_V2_AD           := $980C
000000r 2               SID_V2_SR           := $980D
000000r 2               
000000r 2               ; Voice 3:
000000r 2               SID_V3_FREQ_LO      := $980E
000000r 2               SID_V3_FREQ_HI      := $980F
000000r 2               SID_V3_PW_LO        := $9810
000000r 2               SID_V3_PW_HI        := $9811
000000r 2               SID_V3_CTRL         := $9812
000000r 2               SID_V3_AD           := $9813
000000r 2               SID_V3_SR           := $9814
000000r 2               
000000r 2               ; Global SID registers:
000000r 2               SID_FC_LO           := $9815             ; Filter cutoff low (bits 0-2)
000000r 2               SID_FC_HI           := $9816             ; Filter cutoff high (bits 0-7)
000000r 2               SID_RES_FILT        := $9817             ; Resonance (high nibble) / Filter enable per voice (bits 0-2)
000000r 2               SID_MODE_VOL        := $9818             ; Filter mode (high nibble) / Master volume (low nibble, 0-15)
000000r 2               SID_PADDLE_X        := $9819             ; Paddle X (read-only)
000000r 2               SID_PADDLE_Y        := $981A             ; Paddle Y (read-only)
000000r 2               SID_OSC3            := $981B             ; Oscillator 3 output (read-only)
000000r 2               SID_ENV3            := $981C             ; Envelope 3 output (read-only)
000000r 2               
000000r 2               ; SID Voice Control Register bits (apply to SID_Vn_CTRL):
000000r 2               SID_CTRL_GATE       := %00000001         ; Gate: 1=start attack, 0=start release
000000r 2               SID_CTRL_SYNC       := %00000010         ; Hard sync with preceding voice
000000r 2               SID_CTRL_RING       := %00000100         ; Ring modulation with preceding voice
000000r 2               SID_CTRL_TEST       := %00001000         ; Test bit (resets oscillator)
000000r 2               SID_CTRL_TRIANGLE   := %00010000         ; Triangle waveform
000000r 2               SID_CTRL_SAWTOOTH   := %00100000         ; Sawtooth waveform
000000r 2               SID_CTRL_PULSE      := %01000000         ; Pulse waveform
000000r 2               SID_CTRL_NOISE      := %10000000         ; Noise waveform
000000r 2               
000000r 2               ; SID Filter Mode bits (high nibble of SID_MODE_VOL):
000000r 2               SID_FILT_LP         := %00010000         ; Low-pass filter
000000r 2               SID_FILT_BP         := %00100000         ; Band-pass filter
000000r 2               SID_FILT_HP         := %01000000         ; High-pass filter
000000r 2               SID_FILT_3OFF       := %10000000         ; Disconnect voice 3 from output
000000r 2               
000000r 2               ; --- SID Frequency Table (1 MHz clock, equal temperament) ---
000000r 2               ;   Freq register = round(Hz × 16777216 / 1000000)
000000r 2               ;   Covers octaves 2-7 (C2=65 Hz to B7=3951 Hz), all 12 chromatic notes.
000000r 2               ;   Sharps and flats are provided as aliases (e.g. SID_NOTE_CS4 = SID_NOTE_Db4).
000000r 2               ;   Use SidPlayNote: A=voice (0-2), X=freq low byte, Y=freq high byte.
000000r 2               ;   Example: ldx #<SID_NOTE_A4 / ldy #>SID_NOTE_A4
000000r 2               
000000r 2               ; Octave 2 (C2=65.41 Hz .. B2=123.47 Hz)
000000r 2               SID_NOTE_C2         = $0449              ; ~65 Hz
000000r 2               SID_NOTE_CS2        = $048B              ; ~69 Hz
000000r 2               SID_NOTE_Db2        = SID_NOTE_CS2
000000r 2               SID_NOTE_D2         = $04D0              ; ~73 Hz
000000r 2               SID_NOTE_DS2        = $0519              ; ~78 Hz
000000r 2               SID_NOTE_Eb2        = SID_NOTE_DS2
000000r 2               SID_NOTE_E2         = $0567              ; ~82 Hz
000000r 2               SID_NOTE_F2         = $05B9              ; ~87 Hz
000000r 2               SID_NOTE_FS2        = $0610              ; ~93 Hz
000000r 2               SID_NOTE_Gb2        = SID_NOTE_FS2
000000r 2               SID_NOTE_G2         = $066C              ; ~98 Hz
000000r 2               SID_NOTE_GS2        = $06CE              ; ~104 Hz
000000r 2               SID_NOTE_Ab2        = SID_NOTE_GS2
000000r 2               SID_NOTE_A2         = $0735              ; ~110 Hz
000000r 2               SID_NOTE_AS2        = $07A3              ; ~117 Hz
000000r 2               SID_NOTE_Bb2        = SID_NOTE_AS2
000000r 2               SID_NOTE_B2         = $0817              ; ~123 Hz
000000r 2               
000000r 2               ; Octave 3 (C3=130.81 Hz .. B3=246.94 Hz)
000000r 2               SID_NOTE_C3         = $0893              ; ~131 Hz
000000r 2               SID_NOTE_CS3        = $0915              ; ~139 Hz
000000r 2               SID_NOTE_Db3        = SID_NOTE_CS3
000000r 2               SID_NOTE_D3         = $099F              ; ~147 Hz
000000r 2               SID_NOTE_DS3        = $0A32              ; ~156 Hz
000000r 2               SID_NOTE_Eb3        = SID_NOTE_DS3
000000r 2               SID_NOTE_E3         = $0ACD              ; ~165 Hz
000000r 2               SID_NOTE_F3         = $0B72              ; ~175 Hz
000000r 2               SID_NOTE_FS3        = $0C20              ; ~185 Hz
000000r 2               SID_NOTE_Gb3        = SID_NOTE_FS3
000000r 2               SID_NOTE_G3         = $0CD8              ; ~196 Hz
000000r 2               SID_NOTE_GS3        = $0D9C              ; ~208 Hz
000000r 2               SID_NOTE_Ab3        = SID_NOTE_GS3
000000r 2               SID_NOTE_A3         = $0E6B              ; ~220 Hz
000000r 2               SID_NOTE_AS3        = $0F46              ; ~233 Hz
000000r 2               SID_NOTE_Bb3        = SID_NOTE_AS3
000000r 2               SID_NOTE_B3         = $102F              ; ~247 Hz
000000r 2               
000000r 2               ; Octave 4 (C4=261.63 Hz .. B4=493.88 Hz) — middle octave
000000r 2               SID_NOTE_C4         = $1125              ; ~262 Hz (Middle C)
000000r 2               SID_NOTE_CS4        = $122A              ; ~277 Hz
000000r 2               SID_NOTE_Db4        = SID_NOTE_CS4
000000r 2               SID_NOTE_D4         = $133F              ; ~294 Hz
000000r 2               SID_NOTE_DS4        = $1464              ; ~311 Hz
000000r 2               SID_NOTE_Eb4        = SID_NOTE_DS4
000000r 2               SID_NOTE_E4         = $159A              ; ~330 Hz
000000r 2               SID_NOTE_F4         = $16E3              ; ~349 Hz
000000r 2               SID_NOTE_FS4        = $183F              ; ~370 Hz
000000r 2               SID_NOTE_Gb4        = SID_NOTE_FS4
000000r 2               SID_NOTE_G4         = $19B1              ; ~392 Hz
000000r 2               SID_NOTE_GS4        = $1B38              ; ~415 Hz
000000r 2               SID_NOTE_Ab4        = SID_NOTE_GS4
000000r 2               SID_NOTE_A4         = $1CD6              ; ~440 Hz (Concert A)
000000r 2               SID_NOTE_AS4        = $1E8D              ; ~466 Hz
000000r 2               SID_NOTE_Bb4        = SID_NOTE_AS4
000000r 2               SID_NOTE_B4         = $205E              ; ~494 Hz
000000r 2               
000000r 2               ; Octave 5 (C5=523.25 Hz .. B5=987.77 Hz)
000000r 2               SID_NOTE_C5         = $224B              ; ~523 Hz
000000r 2               SID_NOTE_CS5        = $2455              ; ~554 Hz
000000r 2               SID_NOTE_Db5        = SID_NOTE_CS5
000000r 2               SID_NOTE_D5         = $267E              ; ~587 Hz
000000r 2               SID_NOTE_DS5        = $28C8              ; ~622 Hz
000000r 2               SID_NOTE_Eb5        = SID_NOTE_DS5
000000r 2               SID_NOTE_E5         = $2B34              ; ~659 Hz
000000r 2               SID_NOTE_F5         = $2DC6              ; ~698 Hz
000000r 2               SID_NOTE_FS5        = $307F              ; ~740 Hz
000000r 2               SID_NOTE_Gb5        = SID_NOTE_FS5
000000r 2               SID_NOTE_G5         = $3361              ; ~784 Hz
000000r 2               SID_NOTE_GS5        = $366F              ; ~831 Hz
000000r 2               SID_NOTE_Ab5        = SID_NOTE_GS5
000000r 2               SID_NOTE_A5         = $39AC              ; ~880 Hz
000000r 2               SID_NOTE_AS5        = $3D1A              ; ~932 Hz
000000r 2               SID_NOTE_Bb5        = SID_NOTE_AS5
000000r 2               SID_NOTE_B5         = $40BC              ; ~988 Hz
000000r 2               
000000r 2               ; Octave 6 (C6=1046.50 Hz .. B6=1975.53 Hz)
000000r 2               SID_NOTE_C6         = $4495              ; ~1047 Hz
000000r 2               SID_NOTE_CS6        = $48A9              ; ~1109 Hz
000000r 2               SID_NOTE_Db6        = SID_NOTE_CS6
000000r 2               SID_NOTE_D6         = $4CFC              ; ~1175 Hz
000000r 2               SID_NOTE_DS6        = $518F              ; ~1245 Hz
000000r 2               SID_NOTE_Eb6        = SID_NOTE_DS6
000000r 2               SID_NOTE_E6         = $5669              ; ~1319 Hz
000000r 2               SID_NOTE_F6         = $5B8C              ; ~1397 Hz
000000r 2               SID_NOTE_FS6        = $60FE              ; ~1480 Hz
000000r 2               SID_NOTE_Gb6        = SID_NOTE_FS6
000000r 2               SID_NOTE_G6         = $66C2              ; ~1568 Hz
000000r 2               SID_NOTE_GS6        = $6CDF              ; ~1661 Hz
000000r 2               SID_NOTE_Ab6        = SID_NOTE_GS6
000000r 2               SID_NOTE_A6         = $7358              ; ~1760 Hz
000000r 2               SID_NOTE_AS6        = $7A34              ; ~1865 Hz
000000r 2               SID_NOTE_Bb6        = SID_NOTE_AS6
000000r 2               SID_NOTE_B6         = $8178              ; ~1976 Hz
000000r 2               
000000r 2               ; Octave 7 (C7=2093.00 Hz .. A7=3520.00 Hz; B7 overflows 16-bit register)
000000r 2               SID_NOTE_C7         = $892B              ; ~2093 Hz
000000r 2               SID_NOTE_CS7        = $9153              ; ~2217 Hz
000000r 2               SID_NOTE_Db7        = SID_NOTE_CS7
000000r 2               SID_NOTE_D7         = $99F7              ; ~2349 Hz
000000r 2               SID_NOTE_DS7        = $A31F              ; ~2489 Hz
000000r 2               SID_NOTE_Eb7        = SID_NOTE_DS7
000000r 2               SID_NOTE_E7         = $ACD2              ; ~2637 Hz
000000r 2               SID_NOTE_F7         = $B719              ; ~2794 Hz
000000r 2               SID_NOTE_FS7        = $C1FC              ; ~2960 Hz
000000r 2               SID_NOTE_Gb7        = SID_NOTE_FS7
000000r 2               SID_NOTE_G7         = $CD85              ; ~3136 Hz
000000r 2               SID_NOTE_GS7        = $D9BD              ; ~3322 Hz
000000r 2               SID_NOTE_Ab7        = SID_NOTE_GS7
000000r 2               SID_NOTE_A7         = $E6B0              ; ~3520 Hz
000000r 2               SID_NOTE_AS7        = $F467              ; ~3729 Hz
000000r 2               SID_NOTE_Bb7        = SID_NOTE_AS7
000000r 2               ; Note: B7 (~3951 Hz = $102F0) exceeds the 16-bit SID register — not defined
000000r 2               
000000r 2               ; --- Video Card (TMS9918 / pico9918) (IO 8: $9C00-$9C01) ---
000000r 2               ;   Text mode: 40 columns × 24 rows.  Name table at VRAM $0000 (960 bytes).
000000r 2               ;   Pattern table at VRAM $0800 (2 KB, 256 × 8-byte character patterns).
000000r 2               ;   To write to a VRAM address: write low byte to VC_REG, then (high | $40) to VC_REG.
000000r 2               ;   To read from a VRAM address: write low byte to VC_REG, then high byte to VC_REG.
000000r 2               ;   Register writes: write data byte to VC_REG, then (reg# | $80) to VC_REG.
000000r 2               VC_DATA             := $9C00             ; R/W — VRAM data (auto-increments address)
000000r 2               VC_REG              := $9C01             ; Write — Address/register port
000000r 2               VC_STATUS           := $9C01             ; Read — Status register
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 6: USEFUL CONSTANTS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- BIOS Version ---
000000r 2               BIOS_VERSION_MAJOR  = 1
000000r 2               BIOS_VERSION_MINOR  = 5
000000r 2               
000000r 2               ; --- ASCII Control Characters ---
000000r 2               CHAR_BEL            = $07                ; Bell (Beep via SID)
000000r 2               CHAR_BS             = $08                ; Backspace (cursor left + erase in video mode)
000000r 2               CHAR_LF             = $0A                ; Line Feed (cursor down, scroll if at bottom)
000000r 2               CHAR_CR             = $0D                ; Carriage Return (cursor to column 0)
000000r 2               CHAR_ESC            = $1B                ; Escape
000000r 2               CHAR_SPACE          = $20                ; Space
000000r 2               
000000r 2               ; --- Video Dimensions ---
000000r 2               VID_COLS            = 40                 ; Screen width in columns
000000r 2               VID_ROWS            = 24                 ; Screen height in rows
000000r 2               VID_NAME_TABLE      = $0000              ; VRAM address of name table (40×24 = 960 bytes)
000000r 2               VID_PATTERN_TABLE   = $0800              ; VRAM address of pattern/character table (2048 bytes)
000000r 2               
000000r 2               ; --- TMS9918 Color Constants (for VideoSetColor) ---
000000r 2               ;   Pass as: (foreground << 4) | background
000000r 2               ;   Example: white on black = $F0, green on black = $20
000000r 2               TMS_TRANSPARENT     = $0
000000r 2               TMS_BLACK           = $1
000000r 2               TMS_MED_GREEN       = $2
000000r 2               TMS_LT_GREEN        = $3
000000r 2               TMS_DK_BLUE         = $4
000000r 2               TMS_LT_BLUE         = $5
000000r 2               TMS_DK_RED          = $6
000000r 2               TMS_CYAN            = $7
000000r 2               TMS_MED_RED         = $8
000000r 2               TMS_LT_RED          = $9
000000r 2               TMS_DK_YELLOW       = $A
000000r 2               TMS_LT_YELLOW       = $B
000000r 2               TMS_DK_GREEN        = $C
000000r 2               TMS_MAGENTA         = $D
000000r 2               TMS_GRAY            = $E
000000r 2               TMS_WHITE           = $F
000000r 2               
000000r 2               ; --- Monitor Entry Points ---
000000r 2               ;   The machine code monitor lives at $EE00 and is entered normally via BRK.
000000r 2               ;   These are useful if you want to jump there directly.
000000r 2               MONITOR_ENTRY       := $EE00             ; Cold entry (from boot menu or user code)
000000r 2               MONITOR_BRK_ENTRY   := $EE03             ; BRK entry (displays saved registers)
000000r 2               
000000r 1               
000000r 1               ; --- Platform constants (hal.inc) --------------------------------------------
000000r 1               SCR_COLS         = 32
000000r 1               SCR_ROWS         = 24
000000r 1               SCR_CELLS        = SCR_COLS * SCR_ROWS     ; 768
000000r 1               PANEL_X             = 5             ; (32 - 22) / 2 — exact centring
000000r 1               PANEL_Y             = 0
000000r 1               HAS_COLOR_RAM       = 0             ; Colour lives in the VDP colour table
000000r 1               
000000r 1               ; --- VRAM map (SPEC Appendix C.1) --------------------------------------------
000000r 1               VRAM_PATTERNS       = $0000         ; 2 K, 256 patterns x 8 bytes
000000r 1               VRAM_NAMES          = $1400         ; 768, the 32 x 24 name table
000000r 1               VRAM_SPRITES        = $1B00         ; Sprite attributes — disabled below
000000r 1               VRAM_COLORS         = $2000         ; 32, one byte per 8-pattern group
000000r 1               
000000r 1               .include "../src/constants.inc"
000000r 2               ; =============================================================================
000000r 2               ;   constants.inc — Wizards Lab, shared game constants
000000r 2               ; =============================================================================
000000r 2               ;   Everything here comes straight out of SPEC.md. If a number changes there,
000000r 2               ;   it changes here, and nowhere else. Nothing in this file is platform
000000r 2               ;   specific — see the per-platform WizardsLab.asm for PANEL_X / PANEL_Y and
000000r 2               ;   the hardware addresses.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Board (SPEC 3) ----------------------------------------------------------
000000r 2               BOARD_W             = 6         ; Playfield columns
000000r 2               BOARD_H             = 16        ; Playfield rows
000000r 2               BOARD_STRIDE        = 8         ; Bytes per row — two wasted, on purpose
000000r 2               BOARD_ROWS_ALLOC    = 20        ; 16 playfield + 2 floor sentinels + 2 reserved
000000r 2               BOARD_BYTES         = BOARD_ROWS_ALLOC * BOARD_STRIDE    ; 160
000000r 2               SPAWN_COL           = 2         ; 0-indexed, left of centre
000000r 2               MATCH_MIN           = 3         ; Run length that clears
000000r 2               
000000r 2               ; --- Tile encoding (SPEC 4) --------------------------------------------------
000000r 2               ;   tile = COLOR_BASE + (color << 3) + glyph
000000r 2               ;   The board byte IS the tile index. No translation on the way to the screen.
000000r 2               TILE_EMPTY          = $00
000000r 2               TILE_WALL           = $FF
000000r 2               COLOR_BASE          = $40
000000r 2               COLOR_MASK          = $F8       ; AND this and you have the colour key
000000r 2               GLYPH_MASK          = $07
000000r 2               WILD_BASE           = $70       ; Colour 6 — the prism
000000r 2               NUM_COLORS          = 6
000000r 2               
000000r 2               COLOR_RED           = 0
000000r 2               COLOR_YELLOW        = 1
000000r 2               COLOR_GREEN         = 2
000000r 2               COLOR_CYAN          = 3
000000r 2               COLOR_BLUE          = 4
000000r 2               COLOR_PURPLE        = 5
000000r 2               COLOR_WILD          = 6
000000r 2               
000000r 2               GLYPH_POTION        = 0
000000r 2               GLYPH_FIREBALL      = 1
000000r 2               GLYPH_BOLT          = 2
000000r 2               GLYPH_BOMB          = 3
000000r 2               GLYPH_STAR          = 4
000000r 2               GLYPH_GLOW          = 6         ; Match-flash frame. Potion colours only —
000000r 2                                               ;   WILD_BASE + GLYPH_GLOW is an arrow, not a
000000r 2                                               ;   glow, so the prism never takes this path.
000000r 2                                               ;   See PRISM_BLIP below and SPEC 4.4.
000000r 2               
000000r 2               ; --- Named tiles -------------------------------------------------------------
000000r 2               TILE_BLANK          = 0
000000r 2               TILE_BAR_H          = 1
000000r 2               TILE_BAR_V          = 2
000000r 2               TILE_COR_TL         = 3
000000r 2               TILE_COR_TR         = 4
000000r 2               TILE_COR_BL         = 5
000000r 2               TILE_COR_BR         = 6
000000r 2               TILE_WASH           = 7         ; PAUSE / dim wash, white
000000r 2               FONT_BASE           = 16        ; '0'..'9' then 'A'..'Z' then . x ! ~
000000r 2               FONT_DIGIT_0        = 16
000000r 2               FONT_LETTER_A       = 26
000000r 2               FONT_DOT            = 52        ; A CENTRED dot, not a baseline period — it is
000000r 2                                               ;   also frame 0 of the removal ring below
000000r 2               FONT_TIMES          = 53
000000r 2               FONT_BANG           = 54
000000r 2               FONT_TILDE          = 55        ; The banner ornament, ~~~LIKE THIS~~~
000000r 2               TEXT_END            = $FF       ; String terminator. Shares its value with
000000r 2                                               ;   TILE_WALL, which costs nothing: no string
000000r 2                                               ;   ever contains tile 255.
000000r 2               
000000r 2               ; The removal ring (SPEC 14). One animation, used for every removal there is:
000000r 2               ; the match shatter, the bomb blast, the star. It opens outward
000000r 2               ;
000000r 2               ;       FONT_DOT -> VFX_REMOVE1 -> VFX_REMOVE2 -> VFX_REMOVE3 -> empty
000000r 2               ;
000000r 2               ; and the prism's blip-out runs the same tiles closed inward (PRISM_BLIP).
000000r 2               VFX_REMOVE1         = 56
000000r 2               VFX_REMOVE2         = 57
000000r 2               VFX_REMOVE3         = 58
000000r 2               VFX_BEAM_H          = 59        ; The bolt's row
000000r 2               VFX_BEAM_V          = 60        ; The bolt's column
000000r 2               VFX_BEAM_CROSS      = 61        ; Drawn once, at the bolt's own cell
000000r 2               ARROW_UP            = 62        ; The title screen's controls (SPEC 13.1).
000000r 2               ARROW_DOWN          = 63        ;   Up and down live in group 7, left and
000000r 2               ARROW_LEFT          = 118       ;   right in group 14 — whichever white group
000000r 2               ARROW_RIGHT         = 119       ;   had a slot spare. Nothing indexes them.
000000r 2               
000000r 2               ; Group 14 is the prism's. Slots +0..+3 are its idle rotation and +4..+5 its
000000r 2               ; blip-out; there is no glow slot (SPEC A.3).
000000r 2               PRISM_SPIN          = WILD_BASE ; Four frames, WILD_BASE + 0..3
000000r 2               PRISM_SPIN_FRAMES   = 4
000000r 2               PRISM_BLIP          = WILD_BASE + 4     ; Two frames, then VFX_REMOVE2,
000000r 2                                                       ;   VFX_REMOVE1, FONT_DOT, empty
000000r 2               
000000r 2               ; Group 15 is the stone group: the petrified glyph set at the same offsets the
000000r 2               ; potions use, so a cell petrifies into its own shape —
000000r 2               ;
000000r 2               ;       petrified = PETRIFY_BASE + (tile & GLYPH_MASK)     for glyphs 0-4
000000r 2               ;
000000r 2               ; — and then the two tiles the margins are built from.
000000r 2               PETRIFY_BASE        = 120       ; +0 potion, +1 fireball, +2 bolt,
000000r 2                                               ;   +3 bomb, +4 star
000000r 2               TILE_RESERVED       = 125       ; Held for a sixth glyph, if one is ever added
000000r 2               TILE_SHELF          = 126       ; The shelf the panel stands on
000000r 2               TILE_BRICK          = 127       ; Brick — the margin fill
000000r 2               FRAME_DIM           = 8         ; Group 1 is group 0 byte for byte, one colour
000000r 2                                               ;   quieter, so frame_tile + FRAME_DIM is any
000000r 2                                               ;   frame piece's dim twin (SPEC A.3)
000000r 2               ART_BASE            = 128       ; Groups 16-31 — one hatch in sixteen colours,
000000r 2                                               ;   the title screen's magic field (SPEC 13.1)
000000r 2               ART_TILES           = 128
000000r 2               
000000r 2               ; --- Panel geometry (SPEC 12) ------------------------------------------------
000000r 2               ;   One 22 x 24 panel, rendered identically on all three machines. PANEL_Y is
000000r 2               ;   0 everywhere; only PANEL_X differs. The panel is vertically symmetric —
000000r 2               ;   backdrop row, band row, backdrop row, eighteen rows of frame, backdrop row,
000000r 2               ;   band row, backdrop row — which is why 24 is the height. The AC6502 is the
000000r 2               ;   exact fit; the VIC-20 clips panel row 23 off the bottom and the C64 has one
000000r 2               ;   spare screen row (24) below the panel. See SPEC 12.4.
000000r 2               PANEL_W             = 22
000000r 2               PANEL_H             = 24
000000r 2               
000000r 2               WELL_ORIGIN_X       = 1         ; Panel-relative: board (0,0) lives here
000000r 2               WELL_ORIGIN_Y       = 4
000000r 2               
000000r 2               SCORE_X             = 12        ; 7 digits, cols 12-18
000000r 2               SCORE_Y             = 5
000000r 2               HIGH_X              = 12        ; 7 digits, cols 12-18
000000r 2               HIGH_Y              = 10
000000r 2               HIGHLVL_X           = 15        ; Level the high score was set on, 2 digits;
000000r 2                                               ;   the 'L' at col 14 is in the static image
000000r 2               HIGHLVL_Y           = 11
000000r 2               LEVEL_X             = 18        ; Single column: tens above units
000000r 2               LEVEL_Y             = 17        ; Tens at LEVEL_Y, units at LEVEL_Y + 1
000000r 2               NEXT_X              = 11        ; Single tile column
000000r 2               NEXT_Y              = 16        ; Cells A, B, C at NEXT_Y, +1, +2
000000r 2               MSG_X               = 2         ; The band's OWNED cells. Panel columns 0-1 and
000000r 2               MSG_W               = 18        ;   20-21 of row 22 are shelf in the static
000000r 2               MSG_Y               = 22        ;   image and code never touches them; the
000000r 2                                               ;   banner still centres on the full PANEL_W,
000000r 2                                               ;   which lands in the same place for an
000000r 2                                               ;   even-length string (SPEC 12.2).
000000r 2               
000000r 2               MSG_CHAIN_LEN       = 14        ; `~~ CHAIN x0 ~~` (strings.inc)
000000r 2               MSG_CHAIN_DIGIT     = 10        ; Where the digit sits inside it
000000r 2               CHAIN_DIGIT_X       = (PANEL_W - MSG_CHAIN_LEN) / 2 + MSG_CHAIN_DIGIT
000000r 2                                               ; TextBanner centres on PANEL_W, so the one
000000r 2                                               ;   cell the chain banner overwrites afterwards
000000r 2                                               ;   is worked out here rather than counted off
000000r 2                                               ;   the screen
000000r 2               CHAIN_MAX_SHOWN     = 9         ; One digit. A chain past 9 says 9 rather than
000000r 2                                               ;   drawing a glyph that is not a numeral
000000r 2               
000000r 2               SCORE_DIGITS        = 7         ; Always all 7 drawn, zero padded
000000r 2               LEVEL_DIGITS        = 2         ; Always zero padded — level 5 draws "0" / "5"
000000r 2               
000000r 2               ; --- Piece and timing (SPEC 5.6, 11.3, 14) -----------------------------------
000000r 2               ;   Every duration in the game is a frame count, and most of them differ
000000r 2               ;   between NTSC and PAL so that wall-clock speed matches. Those live in
000000r 2               ;   tables.inc as two-entry tables indexed by Region, not here — a constant
000000r 2               ;   that is not one number is not a constant. The ones below are the same on
000000r 2               ;   both machines.
000000r 2               LOCK_RESET_MAX      = 4         ; Horizontal moves that may reset the lock
000000r 2                                               ;   delay, per piece. Rotation never resets it.
000000r 2               FALL_FRAMES         = 2         ; Frames a row while the pile falls into the
000000r 2                                               ;   holes a clear left (SPEC 14). The one
000000r 2                                               ;   duration in the game that is the same on
000000r 2                                               ;   both regions, because SPEC 14 says so: at
000000r 2                                               ;   two frames there is nothing to round.
000000r 2               
000000r 2               ; --- Animation (SPEC 14) -----------------------------------------------------
000000r 2               ;   A clear step animates in two windows, and everything SPEC 14 lists happens
000000r 2               ;   inside one of them. A window lasts as long as the LONGEST thing in it:
000000r 2               ;
000000r 2               ;     GLOW      the matched cells' glow glyph, the bolt's beams and the
000000r 2               ;               fireball's white flash. GlowFrames, or the longer FlashFrames
000000r 2               ;               when a fireball fired (tables.inc)
000000r 2               ;     SHATTER   the removal ring, and the prism's blip-out running alongside
000000r 2               ;               it. SHATTER_STEPS ring frames, or BLIP_STEPS when a marked
000000r 2               ;               prism is winking out with them
000000r 2               ;
000000r 2               ;   The two counts below are the SAME on both regions, for the reason
000000r 2               ;   FALL_FRAMES is: they are a tile count times VFX_FRAMES, and two frames a
000000r 2               ;   tile does not round to 1.67. SPEC 14 says so.
000000r 2               VFX_FRAMES          = 2         ; Frames each tile of a removal ring holds
000000r 2               SHATTER_STEPS       = 3         ; VFX_REMOVE1..3           — 6 frames
000000r 2               BLIP_STEPS          = 5         ; PRISM_BLIP, +1, VFX_REMOVE2, VFX_REMOVE1,
000000r 2                                               ;   FONT_DOT               — 10 frames
000000r 2               PRISM_SPIN_RATE     = 8         ; Frames per idle rotation frame (SPEC 14).
000000r 2                                               ;   The only tile on the board that moves when
000000r 2                                               ;   nothing is happening
000000r 2               PETRIFY_FRAMES      = 2         ; Frames per row of the game-over petrify
000000r 2                                               ;   (SPEC 13.4). Same number as FALL_FRAMES
000000r 2                                               ;   and not the same thing, so it is its own
000000r 2                                               ;   constant
000000r 2               TINT_NONE           = $01       ; TintColor when nothing is flashing white.
000000r 2                                               ;   Every real colour key has its low three
000000r 2                                               ;   bits clear, so $01 is a value no masked
000000r 2                                               ;   tile can equal — which is what lets the
000000r 2                                               ;   Commodores' HalPlotCell test the tint with
000000r 2                                               ;   one CMP and no separate "is anything
000000r 2                                               ;   flashing at all" branch (SPEC 4.6)
000000r 2               
000000r 2               ; --- The title screen (SPEC 13.1) --------------------------------------------
000000r 2               ;   Panel-relative, and every one of them is a measurement off the drawn
000000r 2               ;   screen rather than a choice: `make artwork` owns data/screen-title-*.bin
000000r 2               ;   and the numbers below have to agree with it. The magic field is the block
000000r 2               ;   of hatch tiles at rows 8-9 and the prompt is the ten cells that say
000000r 2               ;   PRESS FIRE, which is the one string code redraws over its own image.
000000r 2               FIELD_X             = 4         ; The magic field, 14 x 2 (SPEC 13.1)
000000r 2               FIELD_Y             = 8
000000r 2               FIELD_W             = 14
000000r 2               FIELD_CELLS         = FIELD_W * 2       ; 28, and one of them changes a frame
000000r 2               PROMPT_X            = 6         ; `PRESS FIRE`, blinked at SPEC 14's period
000000r 2               PROMPT_Y            = 11
000000r 2               PROMPT_LEN          = 10
000000r 2               
000000r 2               ; --- Game over (SPEC 13.4) ---------------------------------------------------
000000r 2               GAMEOVER_SECS       = 10        ; Seconds on the game-over screen before it
000000r 2                                               ;   returns to the title by itself. SECONDS,
000000r 2                                               ;   not frames: 600 does not fit in a byte and
000000r 2                                               ;   would not be the same wall clock on both
000000r 2                                               ;   regions if it did, so the timeout counts
000000r 2                                               ;   seconds and SecondFrames counts the frames
000000r 2                                               ;   of one (tables.inc)
000000r 2               
000000r 2               ; --- Levels (SPEC 10) --------------------------------------------------------
000000r 2               LEVEL_TILES         = 30        ; Tiles cleared per level
000000r 2               LEVEL_SPEED_CAP     = 16        ; Speed stops improving here
000000r 2               LEVEL_MAX_SHOWN     = 99
000000r 2               
000000r 2               ; --- Scoring (SPEC 9) --------------------------------------------------------
000000r 2               BONUS_FIREBALL      = $0500     ; BCD
000000r 2               BONUS_BOLT          = $0300
000000r 2               BONUS_BOMB          = $0300
000000r 2               BONUS_PRISM         = $0400
000000r 2               BONUS_LEVELUP       = $1000
000000r 2               STAR_SHIFT_CAP      = 3         ; Three doublings — x8
000000r 2               HIGH_FLASH_BLINKS   = 6         ; Half-blinks of the HIGH field when the score
000000r 2                                               ;   overtakes it (SPEC 9.8) — three dark, three
000000r 2                                               ;   lit, ending lit. At SPEC 14's 30-frame
000000r 2                                               ;   blink period that is about a second and a
000000r 2                                               ;   half, and play never stops for it.
000000r 2               SCORE_BYTES         = 4         ; 8 nibbles packed BCD; the top one stays 0,
000000r 2                                               ;   so 7 digits show and the score wraps at
000000r 2                                               ;   10,000,000.
000000r 2               HIGH_INIT_LO        = $00       ; 0010000
000000r 2               HIGH_INIT_MID       = $00
000000r 2               HIGH_INIT_HI        = $01
000000r 2               HIGH_INIT_TOP       = $00
000000r 2               
000000r 2               ; --- Audio (SPEC 16) ---------------------------------------------------------
000000r 2               ;   Twelve effects, one channel. The id IS the priority: SPEC 16 lists them
000000r 2               ;   from the quietest event to the loudest, so a request takes the channel only
000000r 2               ;   when its id is at least the id of whatever is already playing, and a
000000r 2               ;   fireball is never talked over by the blip of the move that set it off
000000r 2               ;   (audio.asm). Two things have been added above the twelve since — read on;
000000r 2               ;   the ordering rule is what decides where they go and it decides it easily.
000000r 2               SFX_MOVE            = 1
000000r 2               SFX_ROTATE          = 2
000000r 2               SFX_LOCK            = 3
000000r 2               SFX_MATCH           = 4
000000r 2               SFX_FIREBALL        = 5
000000r 2               SFX_BOLT            = 6
000000r 2               SFX_BOMB            = 7
000000r 2               SFX_STAR            = 8
000000r 2               SFX_PRISM           = 9
000000r 2               SFX_LEVELUP         = 10
000000r 2               SFX_HIGHSCORE       = 11
000000r 2               SFX_GAMEOVER        = 12
000000r 2               SFX_COUNT           = 12        ; ...which is where SPEC 16's list ends
000000r 2               
000000r 2               ;   A THIRTEENTH EVENT that SPEC 16 does not have: the game announcing itself.
000000r 2               ;   It is above the game-over run in the ordering deliberately — a game that
000000r 2               ;   has just started is the loudest thing that has ever happened on this
000000r 2               ;   machine, and nothing may talk over it, least of all the blip of the first
000000r 2               ;   move the player makes while it is still going.
000000r 2               SFX_START           = 13
000000r 2               
000000r 2               ;   ...and three that are NOT EVENTS AT ALL. The title screen's ambience is
000000r 2               ;   built out of the same step lists as everything else (tables.inc), so its
000000r 2               ;   sounds need ids to be indexed by, and the ids have to sit above the events
000000r 2               ;   because that is where the table has room. They are therefore the LOUDEST
000000r 2               ;   ids in the game, which would be exactly wrong if anything ever asked for
000000r 2               ;   one: nothing may. The ambience calls SfxBeginShifted directly, on a frame
000000r 2               ;   where the channel is already known to be silent, and never goes near
000000r 2               ;   SfxPlay (ambience.asm).
000000r 2               SFX_BUBBLE          = 14        ; A bloop rising out of the cauldron
000000r 2               SFX_GLOOP           = 15        ; ...a heavier one turning over, and falling
000000r 2               SFX_SEETHE          = 16        ; ...and the churn underneath both
000000r 2               SFX_CAULDRON        = 14        ; The first of the three. An id below this one
000000r 2                                               ;   that the ambience plays was borrowed from
000000r 2                                               ;   the game and earns the longer gap after it
000000r 2                                               ;   (AMB_GAP_EVENT); one at or above it is the
000000r 2                                               ;   cauldron and does not
000000r 2               
000000r 2               SFX_STEP_BYTES      = 3         ; frames, timbre, note (tables.inc)
000000r 2               SFX_CHAIN_SHIFT     = 2         ; Semitones the match chime rises per chain
000000r 2               SFX_CHAIN_MAX       = 8         ;   link, and the most it ever rises (SPEC 16)
000000r 2               
000000r 2               ; --- The title screen's ambience ---------------------------------------------
000000r 2               ;   Sounds of the lab rather than a tune: a cauldron bubbling away under the
000000r 2               ;   title, and every so often one of the game's own effects drifting past at
000000r 2               ;   half volume, as though an experiment two benches over just went off.
000000r 2               ;   ambience.asm sequences it; AmbTable (tables.inc) is the mix.
000000r 2               AMB_ENTRIES         = 32        ; Rows in AmbTable. A power of two, so five
000000r 2                                               ;   random bits pick one evenly with an AND.
000000r 2                                               ;   Thirty-two rather than sixteen because it
000000r 2                                               ;   is how often a borrowed effect comes up
000000r 2                                               ;   that this table tunes, and halving that
000000r 2                                               ;   without dropping any of the five means
000000r 2                                               ;   twice the rows (tables.inc)
000000r 2               AMB_SHIFT_RANGE     = 8         ; Semitones a sound may be pitched up by, so no
000000r 2                                               ;   two bubbles are the same size. Every list
000000r 2                                               ;   below is written low enough that +7 stays
000000r 2                                               ;   inside NOTE_MAX.
000000r 2               AMB_GAP_MIN         = 7         ; Frames of quiet between one sound and the
000000r 2               AMB_GAP_RANGE       = 26        ;   next: 7 to 32, rolled every time
000000r 2               AMB_GAP_EVENT       = 40        ; ...and this much more after a borrowed game
000000r 2                                               ;   effect, so the lab goes back to simmering
000000r 2                                               ;   instead of chattering
000000r 2               
000000r 2               ;   A step names a TIMBRE, not a waveform, because the two sound chips have
000000r 2               ;   nothing in common below that level. A timbre is a voice AND an octave:
000000r 2               ;   SOFT sounds an octave below the written note, BUZZ at it, BRIGHT an octave
000000r 2               ;   above. On a SID that is a waveform plus a shift of the frequency; on the
000000r 2               ;   VIC-I it is a choice between three oscillators that are already an octave
000000r 2               ;   apart, so the octave costs nothing there at all (hal.inc).
000000r 2               TIMBRE_OFF          = 0         ; Silence — the note is ignored
000000r 2               TIMBRE_SOFT         = 1         ; triangle / VIC bass       — an octave down
000000r 2               TIMBRE_BUZZ         = 2         ; sawtooth / VIC alto       — as written
000000r 2               TIMBRE_BRIGHT       = 3         ; pulse    / VIC soprano    — an octave up
000000r 2               TIMBRE_NOISE        = 4         ; noise    / VIC noise
000000r 2               TIMBRE_COUNT        = 5
000000r 2               
000000r 2               ;   Bit 7 of the same byte is a LEVEL and not a voice. Both sound chips have
000000r 2               ;   one master volume and no per-voice one, so "quieter" cannot be a property
000000r 2               ;   of a note — it is a register the platform writes on its way past, and the
000000r 2               ;   cheapest place to carry the choice is the byte already going there. It is
000000r 2               ;   set for everything the title screen plays and clear for everything the game
000000r 2               ;   plays (audio.asm, hal.inc), which is the whole of its use.
000000r 2               TIMBRE_QUIET        = $80       ; ...OR it into a timbre
000000r 2               TIMBRE_MASK         = $7F       ; ...and AND it back off, which every HalSfx
000000r 2                                               ;   does first, so a quiet TIMBRE_OFF is still
000000r 2                                               ;   silence and not a fifth voice
000000r 2               
000000r 2               ;   A note is a count of semitones above C3, so one number means the same pitch
000000r 2               ;   on both sound chips and each platform keeps its own NOTE_MAX + 1 entry
000000r 2               ;   table to turn it into register values. Write a note as an octave plus a
000000r 2               ;   degree — OCT_4 + SEMI_G is G4.
000000r 2               OCT_3               = 0
000000r 2               OCT_4               = 12
000000r 2               OCT_5               = 24
000000r 2               OCT_6               = 36
000000r 2               SEMI_C              = 0
000000r 2               SEMI_D              = 2
000000r 2               SEMI_E              = 4
000000r 2               SEMI_F              = 5
000000r 2               SEMI_G              = 7
000000r 2               SEMI_A              = 9
000000r 2               SEMI_B              = 11
000000r 2               NOTE_MAX            = 36        ; C6, the top of both note tables. A chain
000000r 2                                               ;   transposing the match chime past it is
000000r 2                                               ;   clamped rather than allowed to index off
000000r 2                                               ;   the end (audio.asm)
000000r 2               
000000r 2               ; --- Reagent probability, out of 256 (SPEC 5.3) ------------------------------
000000r 2               PSPECIAL_BANDS      = 5
000000r 2               
000000r 2               ; --- Input bitmask (SPEC 11.1) -----------------------------------------------
000000r 2               ;   Active HIGH. Each platform inverts and remaps its own hardware into this.
000000r 2               INPUT_UP            = %00000001 ; Rotate forward
000000r 2               INPUT_DOWN          = %00000010 ; Soft drop
000000r 2               INPUT_LEFT          = %00000100
000000r 2               INPUT_RIGHT         = %00001000
000000r 2               INPUT_FIRE          = %00010000 ; Rotate reverse / confirm
000000r 2               INPUT_PAUSE         = %00100000
000000r 2               INPUT_MASK          = %00111111 ; Everything the game reads. Bits 6-7 are free
000000r 2                                               ;   for a platform to use as scratch inside
000000r 2                                               ;   HalReadInput, as long as it strips them.
000000r 2               
000000r 2               ; --- Game states (SPEC 13) ---------------------------------------------------
000000r 2               STATE_TITLE         = 0
000000r 2               STATE_PLAY          = 1
000000r 2               STATE_PAUSE         = 2
000000r 2               STATE_GAMEOVER      = 3
000000r 2               
000000r 2               ; --- Play sub-states (SPEC 8) ------------------------------------------------
000000r 2               PLAY_FALLING        = 0
000000r 2               PLAY_LOCKING        = 1
000000r 2               PLAY_GLOW           = 2
000000r 2               PLAY_SHATTER        = 3
000000r 2               PLAY_GRAVITY        = 4
000000r 2               PLAY_ARE            = 5
000000r 2               
000000r 2               ; --- Buffer sizes (SPEC 17.1) ------------------------------------------------
000000r 2               MARKS_BYTES         = 16        ; One byte per row, bits 0-5
000000r 2               EFFECTQ_ENTRIES     = 48        ; ONE byte each — the board index of a pending
000000r 2               EFFECTQ_BYTES       = EFFECTQ_ENTRIES   ;   detonation, and nothing else.
000000r 2                                               ;   SPEC 8 budgeted two bytes for a packed
000000r 2                                               ;   glyph/row/column, which is a copy of what
000000r 2                                               ;   the board already holds: cells are not
000000r 2                                               ;   zeroed until step 6 and the queue is drained
000000r 2                                               ;   in step 4, so the tile is still there when
000000r 2                                               ;   the effect pops and its glyph and colour are
000000r 2                                               ;   one `lda Board,x` away. Half the RAM for
000000r 2                                               ;   nothing (SPEC 17.1).
000000r 2                                               ;   A ring keeps one slot free, so 47 pending
000000r 2                                               ;   detonations. On overflow an effect is
000000r 2                                               ;   dropped rather than growing the buffer (D6);
000000r 2                                               ;   at one reagent a piece it is not reachable.
000000r 2               DIRTY_ENTRIES       = 64        ; 3 bytes each: offset lo, offset hi, tile
000000r 2               DIRTY_BYTES         = DIRTY_ENTRIES * 3
000000r 2               DIRTY_FLUSH_MAX     = 24        ; Cells pushed to the screen per frame.
000000r 2                                               ;   MEASURED, not estimated (PLAN.md S1). A
000000r 2                                               ;   flush costs 165 cycles a cell on the
000000r 2                                               ;   AC6502 and about 132 on the Commodores, so
000000r 2                                               ;   24 cells is 3965 cycles — inside vertical
000000r 2                                               ;   blank on all three, and tightest on the
000000r 2                                               ;   AC6502 at 1 MHz, whose 70 blank lines are
000000r 2                                               ;   roughly 4450. It is also a quarter of the
000000r 2                                               ;   96-cell well, so a full redraw is exactly
000000r 2                                               ;   four frames.
000000r 2                                               ;   Overrunning vblank is not dangerous on any
000000r 2                                               ;   of the three — no VRAM write spacing is
000000r 2                                               ;   anywhere near violated (S1) — it only
000000r 2                                               ;   risks a cell landing a frame late. This is
000000r 2                                               ;   a budget, not a hardware limit.
000000r 2               
000000r 1               .include "../src/zeropage.inc"
000000r 2               ; =============================================================================
000000r 2               ;   zeropage.inc — Wizards Lab, zero page allocation
000000r 2               ; =============================================================================
000000r 2               ;   The ZEROPAGE segment is placed at $40 on every platform. That window is
000000r 2               ;   free on all three:
000000r 2               ;
000000r 2               ;     AC6502   $003A-$00FF free for user programs (6502.inc memory map)
000000r 2               ;     VIC-20   all of page zero, once the cartridge stops calling the KERNAL
000000r 2               ;     C64      all of page zero EXCEPT $00/$01, which are the processor port
000000r 2               ;
000000r 2               ;   Starting at $40 clears the C64's port bytes and the AC6502's system
000000r 2               ;   scratch with room to spare, and keeps one number in three linker configs.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               .segment "ZEROPAGE"
000000r 2               
000000r 2  xx xx        Ptr1:           .res 2      ; General pointer — free across any call boundary
000002r 2  xx xx        Ptr2:           .res 2      ; General pointer
000004r 2  xx xx        SrcPtr:         .res 2      ; Block copy source
000006r 2  xx xx        DstPtr:         .res 2      ; Block copy destination
000008r 2  xx xx        ScreenPtr:      .res 2      ; Current screen row base
00000Ar 2  xx xx        ColorPtr:       .res 2      ; Current colour RAM row base (Commodore only)
00000Cr 2               
00000Cr 2  xx           RngLo:          .res 1      ; 16-bit LFSR state — never both zero
00000Dr 2  xx           RngHi:          .res 1
00000Er 2               
00000Er 2  xx           Tmp0:           .res 1      ; Scratch. Never live across a JSR.
00000Fr 2  xx           Tmp1:           .res 1
000010r 2  xx           Tmp2:           .res 1
000011r 2  xx           Tmp3:           .res 1
000012r 2               
000012r 2               ; --- The match scanner (SPEC 6.2) --------------------------------------------
000012r 2               ;   One line of one pass at a time. The cursor is a BOARD INDEX rather than a
000012r 2               ;   row and a column, because all four passes are the same walk with a
000012r 2               ;   different step: +1 horizontal, +8 vertical, +9 diagonal, +7 anti-diagonal.
000012r 2  xx           ScanIdx:        .res 1      ; Where the cursor was when a run ended: ScanLine
000013r 2                                           ;   keeps it in X and spills it only here
000013r 2  xx           ScanStep:       .res 1      ; What to add to reach the next cell of this line
000014r 2  xx           ScanColor:      .res 1      ; Colour key of the run in progress ($FF = unset)
000015r 2  xx           ScanLen:        .res 1      ; Cells in it so far, wildcards included
000016r 2  xx           ScanEnd:        .res 1      ; Walk-back cursor while a finished run is marked
000017r 2  xx           ScanTop:        .res 1      ; Row base of the top of the pile. Every pass
000018r 2                                           ;   starts there rather than at row 0, which is
000018r 2                                           ;   most of the cost of a scan (match.asm)
000018r 2               
000018r 2               ; --- Board walks that call the renderer (SPEC 8 steps 6 and 8) ---------------
000018r 2               ;   RenderCell clobbers A, X and Y, so a walk that marks what it changes
000018r 2               ;   cannot keep its cursor in a register. GravIdx also has to survive from one
000018r 2               ;   frame to the next: a row of falling is a cursor and not a bulk enqueue,
000018r 2               ;   because a full well is more cells than the dirty ring holds (D12,
000018r 2               ;   SPEC 12.6).
000018r 2  xx           GravIdx:        .res 1      ; Cell the fall is walking up from, $FF when the
000019r 2                                           ;   row is finished
000019r 2  xx           GravMoved:      .res 1      ; Non-zero if this row of falling moved anything
00001Ar 2  xx           CellCount:      .res 1      ; Cells CascadeRemove has taken off the board
00001Br 2               
00001Br 2               ; --- Reagent effects (SPEC 7.3, SPEC 8 step 4) -------------------------------
00001Br 2               ;   EffectHit marks a cell, scores it and enqueues whatever it holds, so it
00001Br 2               ;   clobbers A, X and Y — which means a walk that offers it cells cannot keep
00001Br 2               ;   its cursor in a register either. Same reason GravIdx exists, and the same
00001Br 2               ;   reason these are not Tmp0-Tmp3: those are dead across a JSR.
00001Br 2  xx           EffectIdx:      .res 1      ; The cell the walk in progress is on
00001Cr 2  xx           EffectEnd:      .res 1      ; Where it stops. The bolt's row end, or the bomb's
00001Dr 2                                           ;   last row
00001Dr 2  xx           EffectRow:      .res 1      ; First cell of the bomb's current row
00001Er 2  xx           EffectArg:      .res 1      ; What the walk is looking for: the fireball's
00001Fr 2                                           ;   colour key, or the bomb's last column
00001Fr 2               
00001Fr 2               ; --- Animation walks (SPEC 14) -----------------------------------------------
00001Fr 2               ;   The glow, the beams and the shatter all walk MARKS and mark what they find,
00001Fr 2               ;   so their cursors cannot live in registers either — RenderMark clobbers A
00001Fr 2               ;   and X. There are two of them because the beam pass NESTS: the outer walk is
00001Fr 2               ;   over the marked cells, looking for bolts, and the inner one is over the
00001Fr 2               ;   cross each bolt draws.
00001Fr 2  xx           AnimMode:       .res 1      ; Which of the four the walk is doing
000020r 2  xx           AnimIdx:        .res 1      ; Outer cursor — the marked cell being animated
000021r 2  xx           AnimCur:        .res 1      ; Inner cursor — the beam cell being drawn
000022r 2  xx           AnimEnd:        .res 1      ; Where the inner walk stops
000023r 2  xx           AnimArg:        .res 1      ; What it is drawing, or the bolt's own column
000024r 2               
000024r 2               ; --- Render and text scratch -------------------------------------------------
000024r 2               ;   These ARE live across a JSR, unlike Tmp0-Tmp3, because text.asm calls
000024r 2               ;   RenderMark once per cell and has to remember where it is. That is safe
000024r 2               ;   only because RenderMark touches nothing here: it clobbers A, X and the
000024r 2               ;   stack and nothing else (see render.asm). Do not call anything else from a
000024r 2               ;   loop that holds one of these.
000024r 2  xx           TextCol:        .res 1      ; Panel column the next glyph goes in
000025r 2  xx           TextRow:        .res 1      ; Panel row the string is drawn on
000026r 2  xx           TextIdx:        .res 1      ; Cursor within the string, or the BCD byte index
000027r 2  xx           TextByte:       .res 1      ; The BCD byte being split into two digits
000028r 2  xx           TextSkip:       .res 1      ; Non-zero while the first high nibble is skipped
000029r 2  xx           FlushLeft:      .res 1      ; Cells left in this frame's flush budget
00002Ar 2  xx           RedrawCol:      .res 1      ; Panel column of the cell being marked. Shared by
00002Br 2                                           ;   every routine that marks a run of cells in one
00002Br 2                                           ;   column, because RenderMark clobbers X.
00002Br 2               
00002Br 1               .include "../src/ram.inc"
00002Br 2               ; =============================================================================
00002Br 2               ;   ram.inc — Wizards Lab, work RAM
00002Br 2               ; =============================================================================
00002Br 2               ;   SPEC.md section 17.1. Around 530 bytes, which is what lets the whole game
00002Br 2               ;   fit the VIC-20's 1 KB of usable work RAM — the tightest of the three
00002Br 2               ;   targets, and therefore the one the layout is designed against.
00002Br 2               ;
00002Br 2               ;   Every platform places the BSS segment somewhere different (see each
00002Br 2               ;   linker config); nothing in this file cares where.
00002Br 2               ; =============================================================================
00002Br 2               
00002Br 2               .segment "BSS"
000000r 2               
000000r 2               ; --- The board (SPEC 3.2) ----------------------------------------------------
000000r 2               ;   20 rows x 8 stride. Columns 6-7 of every row and rows 16-19 entirely are
000000r 2               ;   permanent $FF sentinels, so scans walk off the edge and stop by themselves.
000000r 2               ;   Page-align it: address(row,col) = Board + (row << 3) + col.
000000r 2               .align 256
000000r 2  xx xx xx xx  Board:          .res BOARD_BYTES
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
0000A0r 2               
0000A0r 2               ; --- Match / cascade state (SPEC 6.2, 8) -------------------------------------
0000A0r 2  xx xx xx xx  Marks:          .res MARKS_BYTES        ; One byte per row, bits 0-5 = columns
0000A4r 2  xx xx xx xx  
0000A8r 2  xx xx xx xx  
0000B0r 2  xx xx xx xx  EffectQ:        .res EFFECTQ_BYTES      ; Ring of pending reagent detonations —
0000B4r 2  xx xx xx xx  
0000B8r 2  xx xx xx xx  
0000E0r 2                                                       ;   the board INDEX of each, one byte,
0000E0r 2                                                       ;   because the tile is still on the
0000E0r 2                                                       ;   board when the entry pops
0000E0r 2                                                       ;   (constants.inc, SPEC 8)
0000E0r 2  xx           EffectQHead:    .res 1
0000E1r 2  xx           EffectQTail:    .res 1
0000E2r 2  xx           RunCount:       .res 1                  ; Runs resolved in the current step
0000E3r 2  xx           ChainStep:      .res 1                  ; 1 on the first step of a cascade
0000E4r 2  xx           StarCount:      .res 1                  ; Doublings pending, capped at 3
0000E5r 2  xx           CascadeLo:      .res 1                  ; Cascade point accumulator, packed BCD
0000E6r 2  xx           CascadeMid:     .res 1
0000E7r 2  xx           CascadeHi:      .res 1
0000E8r 2               
0000E8r 2               ; --- Animation (SPEC 14) -----------------------------------------------------
0000E8r 2  xx           AnimStep:       .res 1                  ; Ring frame the shatter is showing,
0000E9r 2                                                       ;   0 .. AnimSteps - 1
0000E9r 2  xx           AnimSteps:      .res 1                  ; SHATTER_STEPS, or BLIP_STEPS when a
0000EAr 2                                                       ;   marked prism is blipping out along
0000EAr 2                                                       ;   with the rest (constants.inc)
0000EAr 2  xx           TintColor:      .res 1                  ; Colour key currently drawn WHITE — the
0000EBr 2                                                       ;   fireball flash (SPEC 4.6) — or
0000EBr 2                                                       ;   TINT_NONE. Read by HalPlotCell on
0000EBr 2                                                       ;   the Commodores and written to the
0000EBr 2                                                       ;   VDP colour table on the AC6502;
0000EBr 2                                                       ;   HalColorFlash is the only thing that
0000EBr 2                                                       ;   sets it (hal.inc)
0000EBr 2  xx           PrismFrame:     .res 1                  ; Idle rotation frame, 0-3
0000ECr 2  xx           PrismTimer:     .res 1                  ; Frames until the next one
0000EDr 2  xx           PetrifyRow:     .res 1                  ; Board row the game-over petrify is
0000EEr 2                                                       ;   working up from, $FF when it is done
0000EEr 2  xx           TitleTimer:     .res 1                  ; Frames until the title prompt's next
0000EFr 2                                                       ;   half-blink (SPEC 13.1, 14)
0000EFr 2  xx           TitlePhase:     .res 1                  ; 0 while it is lit, 1 while it is dark
0000F0r 2               
0000F0r 2               ; --- Render (SPEC 12.6) ------------------------------------------------------
0000F0r 2               ;   A ring of DIRTY_ENTRIES cells waiting to be pushed to the screen, three
0000F0r 2               ;   bytes each: SCREEN column, SCREEN row, tile. Not a 16-bit screen offset —
0000F0r 2               ;   HalPlotCell takes a column and a row (hal.inc), and every platform reaches
0000F0r 2               ;   a cell through a per-row pointer table (SPEC 12.3), so an offset would only
0000F0r 2               ;   have to be taken apart again at the far end.
0000F0r 2               ;
0000F0r 2               ;   A ring rather than a list with a resume index, because a frame that flushes
0000F0r 2               ;   its cap leaves a remainder and the next frame's marks have to go somewhere.
0000F0r 2               ;   Head and tail are BYTE offsets into Dirty, not entry numbers, so stepping
0000F0r 2               ;   one entry is an add of 3 and never a multiply.
0000F0r 2  xx xx xx xx  Dirty:          .res DIRTY_BYTES        ; screen col, screen row, tile
0000F4r 2  xx xx xx xx  
0000F8r 2  xx xx xx xx  
0001B0r 2  xx           DirtyCount:     .res 1                  ; Entries pending, 0..DIRTY_ENTRIES
0001B1r 2  xx           DirtyHead:      .res 1                  ; Byte offset of the oldest pending
0001B2r 2  xx           DirtyTail:      .res 1                  ; Byte offset the next mark goes to
0001B3r 2  xx           RedrawIdx:      .res 1                  ; Board index RenderBoardStep resumes
0001B4r 2                                                       ;   at, or $FF when no redraw is
0001B4r 2                                                       ;   outstanding
0001B4r 2  xx           RedrawWash:     .res 1                  ; TILE_WASH while the cursor above is
0001B5r 2                                                       ;   painting the PAUSE wash rather than
0001B5r 2                                                       ;   the board, zero otherwise. Both are
0001B5r 2                                                       ;   96 cells against a 64-entry ring, so
0001B5r 2                                                       ;   both have to be a cursor (D12) and
0001B5r 2                                                       ;   one byte is cheaper than a second
0001B5r 2                                                       ;   one (SPEC 13.3)
0001B5r 2               
0001B5r 2               ; --- The falling piece (SPEC 5) ----------------------------------------------
0001B5r 2  xx           PieceCol:       .res 1
0001B6r 2  xx           PieceRow:       .res 1                  ; Row of cell A (the top cell)
0001B7r 2  xx           PieceA:         .res 1                  ; Tile bytes, top to bottom
0001B8r 2  xx           PieceB:         .res 1
0001B9r 2  xx           PieceC:         .res 1
0001BAr 2  xx           NextA:          .res 1                  ; The preview piece
0001BBr 2  xx           NextB:          .res 1
0001BCr 2  xx           NextC:          .res 1
0001BDr 2  xx           PieceDirty:     .res 1                  ; Non-zero when the three cells need
0001BEr 2                                                       ;   drawing. Not drawn on the spot,
0001BEr 2                                                       ;   because a full-board redraw may be
0001BEr 2                                                       ;   in flight and would paint over
0001BEr 2                                                       ;   them — see StatePlay (D14).
0001BEr 2               
0001BEr 2               ; --- Progress (SPEC 9, 10) ---------------------------------------------------
0001BEr 2  xx           ScoreLo:        .res 1                  ; 7 digits packed BCD, low byte first;
0001BFr 2  xx           ScoreMid:       .res 1                  ;   the top nibble of ScoreTop stays 0
0001C0r 2  xx           ScoreHi:        .res 1
0001C1r 2  xx           ScoreTop:       .res 1
0001C2r 2  xx           HighLo:         .res 1
0001C3r 2  xx           HighMid:        .res 1
0001C4r 2  xx           HighHi:         .res 1
0001C5r 2  xx           HighTop:        .res 1
0001C6r 2  xx           HighLevel:      .res 1                  ; Level the high score was set on, BCD
0001C7r 2  xx           HighOwned:      .res 1                  ; Non-zero once THIS game has taken the
0001C8r 2                                                       ;   high score. From the overtake on,
0001C8r 2                                                       ;   score and high score are equal and
0001C8r 2                                                       ;   every bank copies again, so without
0001C8r 2                                                       ;   this the one-shot fanfare and flash
0001C8r 2                                                       ;   would fire on every one (SPEC 9.8)
0001C8r 2  xx           HighFlash:      .res 1                  ; Half-blinks of the HIGH field left to
0001C9r 2                                                       ;   run. Odd = dark, even = lit, and it
0001C9r 2                                                       ;   ends at zero, so the field is always
0001C9r 2                                                       ;   left readable
0001C9r 2  xx           HighTimer:      .res 1                  ; Frames until the next half-blink
0001CAr 2  xx           Level:          .res 1                  ; Binary, 1-99
0001CBr 2  xx           TilesCleared:   .res 1                  ; Toward the next level, carries past 30
0001CCr 2               
0001CCr 2               ; --- Timers, all in frames (SPEC 14) -----------------------------------------
0001CCr 2  xx           GravityTimer:   .res 1
0001CDr 2  xx           LockTimer:      .res 1
0001CEr 2  xx           LockResets:     .res 1
0001CFr 2  xx           DasTimer:       .res 1
0001D0r 2  xx           DasDir:         .res 1
0001D1r 2  xx           AreTimer:       .res 1
0001D2r 2  xx           AnimTimer:      .res 1
0001D3r 2  xx           BannerTimer:    .res 1
0001D4r 2  xx           FrameCounter:   .res 1                  ; Free-running from power-on; seeds RNG
0001D5r 2               
0001D5r 2               ; --- Input (SPEC 11.1) -------------------------------------------------------
0001D5r 2  xx           InputNow:       .res 1
0001D6r 2  xx           InputPrev:      .res 1
0001D7r 2  xx           InputEdge:      .res 1                  ; Newly pressed this frame
0001D8r 2               
0001D8r 2               ; --- State machine (SPEC 13) -------------------------------------------------
0001D8r 2  xx           GameState:      .res 1                  ; STATE_*
0001D9r 2  xx           PlayState:      .res 1                  ; PLAY_*
0001DAr 2  xx           OverSecs:       .res 1                  ; Seconds left on the game-over screen,
0001DBr 2                                                       ;   and ZERO until the petrify has
0001DBr 2                                                       ;   finished and the banner is up. That
0001DBr 2                                                       ;   double duty is what makes the setup
0001DBr 2                                                       ;   a one-shot without a second flag:
0001DBr 2                                                       ;   the count never rests at zero,
0001DBr 2                                                       ;   because reaching it returns to the
0001DBr 2                                                       ;   title in the same frame (SPEC 13.4)
0001DBr 2  xx           OverTimer:      .res 1                  ; Frames until the next second of it
0001DCr 2  xx           Region:         .res 1                  ; 0 = NTSC, 1 = PAL
0001DDr 2  xx           NeedsRedraw:    .res 1
0001DEr 2               
0001DEr 2               ; --- Audio (SPEC 16) ---------------------------------------------------------
0001DEr 2               ;   Seven bytes, not the sixteen SPEC 17.1 budgeted — five for SPEC 16's
0001DEr 2               ;   channel and two more for the title screen's ambience. The effect data is a
0001DEr 2               ;   step list in ROM (tables.inc) and the driver is a cursor into it, so the
0001DEr 2               ;   only thing RAM has to hold is where in that list the one playing channel is.
0001DEr 2  xx           SfxRequest:     .res 1                  ; Effect asked for THIS frame, or 0.
0001DFr 2                                                       ;   Logic writes it through SfxPlay,
0001DFr 2                                                       ;   which keeps the loudest of several
0001DFr 2                                                       ;   in one frame; AudioTick consumes and
0001DFr 2                                                       ;   clears it (audio.asm)
0001DFr 2  xx           SfxId:          .res 1                  ; Effect playing, or 0 for silence. It
0001E0r 2                                                       ;   is also the priority a new request
0001E0r 2                                                       ;   has to beat (constants.inc)
0001E0r 2  xx           SfxStepIdx:     .res 1                  ; Byte offset into SfxSteps of the NEXT
0001E1r 2                                                       ;   step — which is why that table has
0001E1r 2                                                       ;   to stay under 256 bytes
0001E1r 2  xx           SfxTimer:       .res 1                  ; Frames left in the step now sounding
0001E2r 2  xx           SfxShift:       .res 1                  ; Semitones added to every note of the
0001E3r 2                                                       ;   effect playing. Zero for eleven of
0001E3r 2                                                       ;   the twelve; the match chime sets it
0001E3r 2                                                       ;   from the chain (SPEC 16)
0001E3r 2  xx           SfxLevel:       .res 1                  ; TIMBRE_QUIET while the title screen
0001E4r 2                                                       ;   owns the channel, 0 while the game
0001E4r 2                                                       ;   does. ORed into every timbre on its
0001E4r 2                                                       ;   way to the platform (audio.asm), and
0001E4r 2                                                       ;   it doubles as the flag that says the
0001E4r 2                                                       ;   ambience is running at all — the two
0001E4r 2                                                       ;   are the same fact, because the title
0001E4r 2                                                       ;   screen is the only thing that turns
0001E4r 2                                                       ;   the volume down and the only thing
0001E4r 2                                                       ;   that bubbles (ambience.asm)
0001E4r 2  xx           AmbTimer:       .res 1                  ; Frames of quiet left before the lab
0001E5r 2                                                       ;   makes its next noise. Counted only
0001E5r 2                                                       ;   on frames where nothing is sounding,
0001E5r 2                                                       ;   so a long effect does not eat the gap
0001E5r 2                                                       ;   that follows it
0001E5r 2               
0001E5r 1               .include "../src/hal.inc"
0001E5r 2               ; =============================================================================
0001E5r 2               ;   hal.inc — Wizards Lab, the platform contract
0001E5r 2               ; =============================================================================
0001E5r 2               ;   Everything in src/ is shared, unmodified, by all three machines. The only
0001E5r 2               ;   things that differ are collected here: each platform's WizardsLab.asm must
0001E5r 2               ;   define these constants and implement these eight routines, and nothing
0001E5r 2               ;   else in src/ may touch hardware directly.
0001E5r 2               ;
0001E5r 2               ;   This file declares nothing. It is the documentation for the boundary, kept
0001E5r 2               ;   next to the code it constrains so it cannot drift out of date unnoticed.
0001E5r 2               ;
0001E5r 2               ;   CONSTANTS the platform must define BEFORE including the shared sources
0001E5r 2               ;   ---------------------------------------------------------------------
0001E5r 2               ;     PANEL_X, PANEL_Y      Where the 22 x 24 panel sits on this screen.
0001E5r 2               ;                             AC6502  5, 0      VIC-20  0, 0      C64  9, 0
0001E5r 2               ;                           PANEL_Y is 0 everywhere; the VIC-20 clips panel
0001E5r 2               ;                           row 23 and the C64 has one spare row below it.
0001E5r 2               ;     SCR_COLS           32 / 22 / 40
0001E5r 2               ;     SCR_ROWS           24 / 23 / 25
0001E5r 2               ;     HAS_COLOR_RAM         1 on the Commodores, 0 on the AC6502, whose colour
0001E5r 2               ;                           lives in the VDP colour table instead.
0001E5r 2               ;
0001E5r 2               ;   ROUTINES the platform must implement
0001E5r 2               ;   ------------------------------------
0001E5r 2               ;     HalInitVideo      Bring up the video hardware: black background and
0001E5r 2               ;                       border, the correct text/tile mode, tileset in place,
0001E5r 2               ;                       colours configured, screen cleared. Called once.
0001E5r 2               ;                       In:  nothing        Out: nothing
0001E5r 2               ;
0001E5r 2               ;     HalWaitFrame      Block until the start of the next vertical blank.
0001E5r 2               ;                       Everything below is called only between frames.
0001E5r 2               ;                       In:  nothing        Out: nothing
0001E5r 2               ;
0001E5r 2               ;     HalPlotCell       Write one cell, colour included where the platform has
0001E5r 2               ;                       per-cell colour — white instead, for any tile whose
0001E5r 2               ;                       colour key is TintColor (see HalColorFlash).
0001E5r 2               ;                       In:  A = tile, X = screen column, Y = screen row
0001E5r 2               ;                       Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
0001E5r 2               ;
0001E5r 2               ;     HalBlitScreen     Draw a whole static screen from a name-table image in
0001E5r 2               ;                       ROM: SCR_COLS * SCR_ROWS bytes, row-major, plus
0001E5r 2               ;                       the matching colour image where the platform needs one.
0001E5r 2               ;                       In:  SrcPtr -> name table, Ptr1 -> colour table
0001E5r 2               ;                       Out: nothing
0001E5r 2               ;
0001E5r 2               ;     HalReadInput      Read stick and keyboard, fold both into one mask.
0001E5r 2               ;                       In:  nothing
0001E5r 2               ;                       Out: A = INPUT_* bits, ACTIVE HIGH
0001E5r 2               ;
0001E5r 2               ;     HalDetectRegion   Decide NTSC or PAL so the timing tables can be picked.
0001E5r 2               ;                       In:  nothing        Out: A = 0 NTSC, 1 PAL
0001E5r 2               ;
0001E5r 2               ;     HalColorFlash     Draw every tile of one colour white, or stop doing so.
0001E5r 2               ;                       The fireball's detonation (SPEC 4.6, 14).
0001E5r 2               ;                       In:  A = colour key ($40..$68), or TINT_NONE for none
0001E5r 2               ;                       Out: nothing.  Modifies: A, X, Y, and TintColor, which
0001E5r 2               ;                            it OWNS: nothing else may write that byte.
0001E5r 2               ;                       The platform must handle the transition, not just the
0001E5r 2               ;                       new value — a second call with a different colour puts
0001E5r 2               ;                       the first one back before lighting the second.
0001E5r 2               ;                       On the AC6502 this is ONE byte in the VDP colour table,
0001E5r 2               ;                       because a tile's colour there belongs to its 8-pattern
0001E5r 2               ;                       group and not to the cell. On the Commodores colour is
0001E5r 2               ;                       per cell, so HalPlotCell reads TintColor instead and
0001E5r 2               ;                       substitutes white for any tile of that colour as it
0001E5r 2               ;                       draws it — which also means every tinted cell has to be
0001E5r 2               ;                       re-marked, and the animation is already marking all of
0001E5r 2               ;                       them (anim.asm).
0001E5r 2               ;
0001E5r 2               ;     HalSfx            Sound ONE note, in one timbre, at one of two levels,
0001E5r 2               ;                       until told otherwise.
0001E5r 2               ;                       In:  A = TIMBRE_* (constants.inc), optionally with
0001E5r 2               ;                            TIMBRE_QUIET (bit 7) set; X = note in semitones
0001E5r 2               ;                            above C3, 0..NOTE_MAX. TIMBRE_OFF ends whatever is
0001E5r 2               ;                            sounding and ignores X.
0001E5r 2               ;                       Out: nothing.  Modifies: A, X, Y, Tmp0-Tmp2
0001E5r 2               ;                       This is NOT "play effect 4". Which effect is playing,
0001E5r 2               ;                       which step of it, how long the step lasts and what
0001E5r 2               ;                       note it is are all shared code (audio.asm), because
0001E5r 2               ;                       none of that differs between a SID and a VIC-I; what
0001E5r 2               ;                       does differ is the register values one note comes out
0001E5r 2               ;                       as, and that is the whole of this routine. SPEC 16
0001E5r 2               ;                       expected the split one level lower — a SID driver
0001E5r 2               ;                       shared by two machines and a third written twice —
0001E5r 2               ;                       and this is the same code shared by three (D22).
0001E5r 2               ;                       A timbre is a voice AND an octave: SOFT sounds an
0001E5r 2               ;                       octave below the note it is given, BUZZ at it, BRIGHT
0001E5r 2               ;                       an octave above. On a SID that is a waveform and a
0001E5r 2               ;                       shift; on the VIC-I the three tone oscillators are
0001E5r 2               ;                       already an octave apart, so it is free.
0001E5r 2               ;                       Bit 7 is neither. It is a LEVEL — quiet, for the title
0001E5r 2               ;                       screen's ambience (src/ambience.asm) — and both chips
0001E5r 2               ;                       have only a master volume to put it in, so every
0001E5r 2               ;                       implementation must MASK IT OFF (TIMBRE_MASK) before it
0001E5r 2               ;                       compares or indexes anything. A quiet TIMBRE_OFF is
0001E5r 2               ;                       silence, not a fifth voice.
0001E5r 2               ;                       A machine with no sound card must still return: the
0001E5r 2               ;                       AC6502's is optional hardware and the game plays
0001E5r 2               ;                       silently on one that has none.
0001E5r 2               ;
0001E5r 2               ;   The shared code assumes nothing about interrupts. Each platform may drive
0001E5r 2               ;   HalWaitFrame from a raster IRQ, a timer, or a status-register poll.
0001E5r 2               ; =============================================================================
0001E5r 2               
0001E5r 1               
0001E5r 1               ; =============================================================================
0001E5r 1               ;   Cartridge entry
0001E5r 1               ; =============================================================================
0001E5r 1               
0001E5r 1               .segment "CODE"
000000r 1               
000000r 1               CartReset:
000000r 1  78             sei
000001r 1  D8             cld
000002r 1  A2 FF          ldx #$FF
000004r 1  9A             txs                           ; Nothing did this for us
000005r 1  20 78 A0       jsr KernalInit                ; Probe and initialise every card, IRQs left off
000008r 1               
000008r 1  20 rr rr       jsr GameInit                  ; Never returns
00000Br 1               
00000Br 1               ; --- Shared game code --------------------------------------------------------
00000Br 1               .include "../src/main.asm"
00000Br 2               ; =============================================================================
00000Br 2               ;   main.asm — Wizards Lab, shared entry point and main loop
00000Br 2               ; =============================================================================
00000Br 2               ;   Included by every platform's WizardsLab.asm after that file has defined
00000Br 2               ;   PANEL_X / PANEL_Y and its half of the HAL (see hal.inc). Nothing below
00000Br 2               ;   touches hardware.
00000Br 2               ;
00000Br 2               ;   BUILD STATUS
00000Br 2               ;   ------------
00000Br 2               ;   Pieces spawn, steer, rotate, fall and lock, runs of three or more clear,
00000Br 2               ;   the pile falls into the holes, chains keep going until nothing matches, all
00000Br 2               ;   of it scores and ramps the level, the five reagents fire and set each other
00000Br 2               ;   off, a clear glows and shatters on the frame clock instead of happening
00000Br 2               ;   between two frames, the arcade loop around all of it is closed — title,
00000Br 2               ;   play, pause, game over, title — and every event of SPEC 16 makes a noise
00000Br 2               ;   (PLAN.md P2 to P8). The game is complete; what is left is real hardware
00000Br 2               ;   (P10).
00000Br 2               ; =============================================================================
00000Br 2               
00000Br 2               ; -----------------------------------------------------------------------------
00000Br 2               ;   GameInit — one-time setup, called from the cartridge entry point
00000Br 2               ; -----------------------------------------------------------------------------
00000Br 2               GameInit:
00000Br 2  20 rr rr       jsr HalDetectRegion
00000Er 2  8D rr rr       sta Region
000011r 2               
000011r 2  20 rr rr       jsr HalInitVideo              ; Tiles in place, screen black and cleared
000014r 2  20 rr rr       jsr AudioInit
000017r 2  20 rr rr       jsr RenderDirtyReset
00001Ar 2               
00001Ar 2  A9 00          lda #0
00001Cr 2  8D rr rr       sta FrameCounter
00001Fr 2  20 rr rr       jsr RngSeed                   ; A zero LFSR state sticks at zero forever, and
000022r 2                                               ;   BSS is not cleared on all three machines, so
000022r 2                                               ;   seed it once here just to get it out of that
000022r 2                                               ;   hole. This is NOT the game's seed — SPEC 15
000022r 2                                               ;   forbids a constant one, and StateTitle
000022r 2                                               ;   reseeds from the player's reaction time
000022r 2                                               ;   before the first piece is ever rolled.
000022r 2  A9 00          lda #0
000024r 2  8D rr rr       sta InputNow
000027r 2  8D rr rr       sta InputPrev
00002Ar 2  8D rr rr       sta InputEdge
00002Dr 2  8D rr rr       sta TitlePhase                ; The title prompt starts lit, and the game-over
000030r 2  8D rr rr       sta OverSecs                  ;   screen starts un-entered. Both are BSS, and
000033r 2                                               ;   BSS is not cleared on all three machines.
000033r 2  A9 01          lda #1
000035r 2  8D rr rr       sta PrismTimer                ; A zero here would DEC to 255 and stall the
000038r 2                                               ;   prism's rotation for four seconds
000038r 2  A9 01          lda #TINT_NONE                ; BSS is not cleared on all three machines, and
00003Ar 2  8D rr rr       sta TintColor                 ;   a garbage colour key here would draw the
00003Dr 2                                               ;   title screen's tiles of that colour white
00003Dr 2                                               ;   on the Commodores. Set before anything
00003Dr 2                                               ;   plots a cell, not in HalColorFlash, which
00003Dr 2                                               ;   reads it to undo the last flash (hal.inc).
00003Dr 2               
00003Dr 2  20 rr rr       jsr ScoreHighInit             ; Once a session, before the first ScoreReset
000040r 2  20 rr rr       jsr ScoreReset
000043r 2  20 rr rr       jsr BoardClear
000046r 2               
000046r 2               .ifdef WL_DEBUG
000046r 2  20 rr rr       jsr GameStart                 ; TEMPORARY: skip the title and start playing,
000049r 2                                               ;   because a headless machine has no input
000049r 2                                               ;   attached and would sit on the title screen
000049r 2                                               ;   forever. Nothing else about the build
000049r 2                                               ;   differs any more (PLAN.md section 3).
000049r 2               .else
000049r 2                 lda #STATE_TITLE
000049r 2                 sta GameState
000049r 2                 lda #1
000049r 2                 sta NeedsRedraw
000049r 2               .endif
000049r 2                 ; falls through into GameLoop
000049r 2               
000049r 2               ; -----------------------------------------------------------------------------
000049r 2               ;   GameLoop — never returns
000049r 2               ; -----------------------------------------------------------------------------
000049r 2               GameLoop:
000049r 2  20 rr rr       jsr HalWaitFrame
00004Cr 2  EE rr rr       inc FrameCounter              ; Free-running from power-on; seeds the RNG
00004Fr 2               
00004Fr 2  20 rr rr       jsr RenderFlush               ; Screen writes happen in vertical blank only
000052r 2  20 rr rr       jsr InputPoll
000055r 2               
000055r 2  AD rr rr       lda GameState                 ; Dispatch on the current screen state
000058r 2  C9 00          cmp #STATE_TITLE
00005Ar 2  F0 0E          beq @Title
00005Cr 2  C9 01          cmp #STATE_PLAY
00005Er 2  F0 10          beq @Play
000060r 2  C9 02          cmp #STATE_PAUSE
000062r 2  F0 12          beq @Pause
000064r 2  20 rr rr       jsr StateGameOver             ; JSR, not JMP — every state handler ends in an
000067r 2  4C rr rr       jmp @Audio                    ;   RTS, and a JMP here would hand that RTS the
00006Ar 2                                               ;   return address of the JSR GameInit that the
00006Ar 2                                               ;   cart entry point never expects back. The
00006Ar 2                                               ;   first loss unwound the loop into GameInit;
00006Ar 2                                               ;   the second pulled from an empty stack.
00006Ar 2               
00006Ar 2               @Title:
00006Ar 2  20 rr rr       jsr StateTitle
00006Dr 2  4C rr rr       jmp @Audio
000070r 2               @Play:
000070r 2  20 rr rr       jsr StatePlay
000073r 2  4C rr rr       jmp @Audio
000076r 2               @Pause:
000076r 2  20 rr rr       jsr StatePause
000079r 2               
000079r 2               @Audio:
000079r 2  20 rr rr       jsr AudioTick
00007Cr 2  4C rr rr       jmp GameLoop
00007Fr 2               
00007Fr 2               ; =============================================================================
00007Fr 2               ;   States (SPEC 13)
00007Fr 2               ; =============================================================================
00007Fr 2               
00007Fr 2               ; -----------------------------------------------------------------------------
00007Fr 2               ;   StateTitle — blinking prompt over the drawn screen, and the magic field
00007Fr 2               ;   SPEC 13.1. There are no help pages: the controls are part of the screen
00007Fr 2               ;   image, so the only things moving here are the prompt and the field.
00007Fr 2               ;
00007Fr 2               ;   Nothing below ticks the sound. The title screen's ambience hangs off the
00007Fr 2               ;   silent branch of AudioTick instead, because what it is filling is the gaps
00007Fr 2               ;   between sounds and this routine cannot see them (ambience.asm).
00007Fr 2               ; -----------------------------------------------------------------------------
00007Fr 2               StateTitle:
00007Fr 2  AD rr rr       lda NeedsRedraw
000082r 2  F0 11          beq @Live
000084r 2  A9 00          lda #0
000086r 2  8D rr rr       sta NeedsRedraw
000089r 2  20 rr rr       jsr DrawTitleScreen
00008Cr 2  20 rr rr       jsr RenderDirtyReset          ; A full blit went behind the renderer's back
00008Fr 2               
00008Fr 2  20 rr rr       jsr AnimTitleBegin            ; ...and the prompt blinks from lit, so it never
000092r 2                                               ;   starts a second visit dark
000092r 2  20 rr rr       jsr AmbienceBegin             ; ...and the lab starts murmuring under it
000095r 2               @Live:
000095r 2  20 rr rr       jsr AnimTitleField            ; The two things that move here, and the whole
000098r 2  20 rr rr       jsr AnimTitleBlink            ;   of the screen's animation (SPEC 13.1)
00009Br 2               
00009Br 2  AD rr rr       lda InputEdge
00009Er 2  29 11          and #(INPUT_FIRE | INPUT_UP)  ; Fire, or SPACE, which the keyboards fold
0000A0r 2  F0 06          beq @Done                     ;   into UP so it can rotate in play (D15)
0000A2r 2               
0000A2r 2  20 rr rr       jsr RngSeed                   ; SPEC 15 — seed from reaction time, not a constant
0000A5r 2  20 rr rr       jsr GameStart
0000A8r 2               @Done:
0000A8r 2  60             rts
0000A9r 2               
0000A9r 2               ; -----------------------------------------------------------------------------
0000A9r 2               ;   GameStart — enter play from the title screen
0000A9r 2               ; -----------------------------------------------------------------------------
0000A9r 2               GameStart:
0000A9r 2  20 rr rr       jsr AmbienceEnd               ; The cauldron stops HERE, mid-bubble if it has
0000ACr 2                                               ;   to: the next noise this machine makes
0000ACr 2                                               ;   belongs to the game (ambience.asm)
0000ACr 2  A9 0D          lda #SFX_START                ; ...and it is this one — the game-over run
0000AEr 2  20 rr rr       jsr SfxPlay                   ;   climbed instead of fallen (tables.inc). The
0000B1r 2                                               ;   loudest id there is, so the first move the
0000B1r 2                                               ;   player makes cannot blip over it
0000B1r 2  20 rr rr       jsr ScoreReset
0000B4r 2  20 rr rr       jsr BoardClear
0000B7r 2               
0000B7r 2  A9 01          lda #1
0000B9r 2  8D rr rr       sta Level
0000BCr 2  A9 00          lda #0
0000BEr 2  8D rr rr       sta TilesCleared
0000C1r 2  8D rr rr       sta DasDir                    ; No direction is held into a new game
0000C4r 2  8D rr rr       sta DasTimer
0000C7r 2  8D rr rr       sta PieceDirty
0000CAr 2  8D rr rr       sta BannerTimer               ; Nothing from the last game is still up
0000CDr 2  8D rr rr       sta PrismFrame
0000D0r 2  A9 01          lda #1
0000D2r 2  8D rr rr       sta PrismTimer
0000D5r 2  A9 01          lda #TINT_NONE                ; ...and no colour is still flashing white, on
0000D7r 2  20 rr rr       jsr HalColorFlash             ;   a machine where that is a VDP register and
0000DAr 2                                               ;   not a byte of RAM (SPEC 4.6)
0000DAr 2               
0000DAr 2  20 rr rr       jsr DrawPlayScreen            ; The whole screen at once, behind the
0000DDr 2  20 rr rr       jsr RenderDirtyReset          ;   renderer's back — so drop anything queued
0000E0r 2                                               ;   against the screen that just went away
0000E0r 2               
0000E0r 2  20 rr rr       jsr TextBannerClear           ; The play image ships with the band reading
0000E3r 2                                               ;   `~~ PAUSED ~~` (SPEC 12.1); play owns it,
0000E3r 2                                               ;   and so does whatever the last game left in
0000E3r 2                                               ;   it — GAME OVER stays up until here
0000E3r 2  20 rr rr       jsr RenderScore               ; The panel fields are code's, not the image's
0000E6r 2  20 rr rr       jsr RenderHigh
0000E9r 2  20 rr rr       jsr RenderLevel
0000ECr 2  20 rr rr       jsr RenderBoard               ; Queued across as many frames as it takes
0000EFr 2               
0000EFr 2  20 rr rr       jsr PieceGenerateNext         ; Fill the preview...
0000F2r 2  20 rr rr       jsr PieceSpawn                ; ...then promote it and refill. The board is
0000F5r 2  20 rr rr       jsr PieceGenerateNext         ;   empty, so the spawn cannot be blocked.
0000F8r 2  20 rr rr       jsr RenderNext
0000FBr 2               
0000FBr 2  A9 00          lda #PLAY_FALLING
0000FDr 2  8D rr rr       sta PlayState
000100r 2  A9 01          lda #STATE_PLAY
000102r 2  8D rr rr       sta GameState
000105r 2  60             rts
000106r 2               
000106r 2               ; -----------------------------------------------------------------------------
000106r 2               ;   StatePlay — the game
000106r 2               ;   SPEC 13.2. One frame is: advance whatever the play sub-state is doing,
000106r 2               ;   then queue whatever changed. Cascades run as sub-states rather than in a
000106r 2               ;   blocking loop so animation stays on the frame clock.
000106r 2               ; -----------------------------------------------------------------------------
000106r 2               StatePlay:
000106r 2  20 rr rr       jsr ScoreFlashTick            ; SPEC 9.8 — the HIGH field blinking after an
000109r 2                                               ;   overtake. Play never stops for it, so it
000109r 2                                               ;   ticks alongside whatever the sub-state is
000109r 2                                               ;   doing rather than inside one.
000109r 2  20 rr rr       jsr AnimBannerTick            ; ...and neither does it for a banner (SPEC 14)
00010Cr 2  20 rr rr       jsr AnimPrismTick             ; ...nor for the one tile that moves at rest
00010Fr 2               
00010Fr 2  AD rr rr       lda InputEdge
000112r 2  29 20          and #INPUT_PAUSE
000114r 2  D0 52          bne @ToPause
000116r 2               
000116r 2  AD rr rr       lda PlayState
000119r 2  C9 00          cmp #PLAY_FALLING
00011Br 2  F0 17          beq @Falling
00011Dr 2  C9 01          cmp #PLAY_LOCKING
00011Fr 2  F0 19          beq @Locking
000121r 2  C9 02          cmp #PLAY_GLOW
000123r 2  F0 1B          beq @Glow
000125r 2  C9 03          cmp #PLAY_SHATTER
000127r 2  F0 1D          beq @Shatter
000129r 2  C9 04          cmp #PLAY_GRAVITY
00012Br 2  F0 1F          beq @Gravity
00012Dr 2  C9 05          cmp #PLAY_ARE
00012Fr 2  F0 21          beq @Are
000131r 2  4C rr rr       jmp @Draw                     ; Not a state anything sets
000134r 2               
000134r 2               @Falling:
000134r 2  20 rr rr       jsr PlayFalling
000137r 2  4C rr rr       jmp @Draw
00013Ar 2               @Locking:
00013Ar 2  20 rr rr       jsr PlayLocking
00013Dr 2  4C rr rr       jmp @Draw
000140r 2               @Glow:
000140r 2  20 rr rr       jsr PlayGlow
000143r 2  4C rr rr       jmp @Draw
000146r 2               @Shatter:
000146r 2  20 rr rr       jsr PlayShatter
000149r 2  4C rr rr       jmp @Draw
00014Cr 2               @Gravity:
00014Cr 2  20 rr rr       jsr PlayGravity
00014Fr 2  4C rr rr       jmp @Draw
000152r 2               @Are:
000152r 2  20 rr rr       jsr PlayAre
000155r 2               
000155r 2                 ; --- draw the piece, once whatever else wanted the screen has finished ----
000155r 2                 ;   D14. RenderBoard is a cursor that feeds the ring over several frames
000155r 2                 ;   (D12), so marks made while one is outstanding are drawn BEFORE the
000155r 2                 ;   redraw reaches those cells and are then painted over. Holding the piece
000155r 2                 ;   back until the redraw has finished is one byte and always right; the
000155r 2                 ;   alternative is a piece that vanishes for four frames after every pause.
000155r 2               @Draw:
000155r 2  AD rr rr       lda PieceDirty
000158r 2  F0 0D          beq @Done
00015Ar 2  AD rr rr       lda RedrawIdx
00015Dr 2  10 08          bpl @Done                     ; A board redraw is still in flight
00015Fr 2  A9 00          lda #0
000161r 2  8D rr rr       sta PieceDirty
000164r 2  20 rr rr       jsr RenderPiece
000167r 2               @Done:
000167r 2  60             rts
000168r 2               
000168r 2               @ToPause:
000168r 2  A9 02          lda #STATE_PAUSE
00016Ar 2  8D rr rr       sta GameState
00016Dr 2  A9 rr          lda #<MsgPaused               ; SPEC 12.2 — without this the screen does not
00016Fr 2  85 rr          sta Ptr1                      ;   change at all on a pause, and a paused game
000171r 2  A9 rr          lda #>MsgPaused               ;   is indistinguishable from a hung one
000173r 2  85 rr          sta Ptr1+1
000175r 2  20 rr rr       jsr TextBanner
000178r 2  4C rr rr       jmp RenderWash                ; SPEC 13.3 — the well is covered, not blanked,
00017Br 2                                               ;   so a pause cannot be used to study the
00017Br 2                                               ;   board. Queued as a cursor because 96 cells
00017Br 2                                               ;   do not fit the ring (render.asm, D12), and
00017Br 2                                               ;   AFTER the banner, so the banner's marks are
00017Br 2                                               ;   in the ring before the wash starts filling
00017Br 2                                               ;   it
00017Br 2               
00017Br 2               ; -----------------------------------------------------------------------------
00017Br 2               ;   PlayFalling — steer the piece, and drop it a row when the timer runs out
00017Br 2               ;   SPEC 5.5, 5.6, 11.3
00017Br 2               ; -----------------------------------------------------------------------------
00017Br 2               PlayFalling:
00017Br 2  20 rr rr       jsr PieceControl              ; Rotation and DAS; the result is ignored here
00017Er 2                                               ;   because there is no lock delay to reset yet
00017Er 2  20 rr rr       jsr PieceFallRate
000181r 2  85 rr          sta Tmp0
000183r 2  AD rr rr       lda GravityTimer              ; Pressing DOWN mid-wait must shorten the wait
000186r 2  C5 rr          cmp Tmp0                      ;   in progress, not just the next one
000188r 2  90 05          bcc @Tick
00018Ar 2  A5 rr          lda Tmp0
00018Cr 2  8D rr rr       sta GravityTimer
00018Fr 2               @Tick:
00018Fr 2  CE rr rr       dec GravityTimer
000192r 2  D0 1E          bne @Done
000194r 2  20 rr rr       jsr PieceStep
000197r 2  B0 0B          bcs @Land
000199r 2  20 rr rr       jsr PieceFallRate             ; ...and C tells us whose rate the row that
00019Cr 2  8D rr rr       sta GravityTimer              ;   just fell used. STA leaves it alone.
00019Fr 2  B0 11          bcs @Done
0001A1r 2  4C rr rr       jmp ScoreSoftDrop             ; SPEC 9.6 — one point, one row
0001A4r 2               
0001A4r 2               @Land:
0001A4r 2  AE rr rr       ldx Region
0001A7r 2  BD rr rr       lda LockDelay,x
0001AAr 2  8D rr rr       sta LockTimer
0001ADr 2  A9 01          lda #PLAY_LOCKING
0001AFr 2  8D rr rr       sta PlayState
0001B2r 2               @Done:
0001B2r 2  60             rts
0001B3r 2               
0001B3r 2               ; -----------------------------------------------------------------------------
0001B3r 2               ;   PlayLocking — the lock delay, and the moves that may reset it
0001B3r 2               ;   SPEC 5.6 — a horizontal move resets the delay LOCK_RESET_MAX times; after
0001B3r 2               ;   that it runs out regardless. Rotation never resets it. A move that opens a
0001B3r 2               ;   gap underneath resumes falling, and the reset count carries.
0001B3r 2               ; -----------------------------------------------------------------------------
0001B3r 2               PlayLocking:
0001B3r 2  20 rr rr       jsr PieceControl
0001B6r 2  90 13          bcc @Settled
0001B8r 2  AD rr rr       lda LockResets
0001BBr 2  C9 04          cmp #LOCK_RESET_MAX
0001BDr 2  B0 0C          bcs @Settled
0001BFr 2  EE rr rr       inc LockResets
0001C2r 2  AE rr rr       ldx Region
0001C5r 2  BD rr rr       lda LockDelay,x
0001C8r 2  8D rr rr       sta LockTimer
0001CBr 2               
0001CBr 2               @Settled:
0001CBr 2  20 rr rr       jsr PieceCanFall
0001CEr 2  90 0C          bcc @Tick
0001D0r 2  A9 00          lda #PLAY_FALLING             ; It moved over a hole — fall again. SPEC 5.6
0001D2r 2  8D rr rr       sta PlayState                 ;   says the lock counter clears here and the
0001D5r 2                                               ;   reset count does not; nothing reads
0001D5r 2                                               ;   LockTimer while falling and the next
0001D5r 2                                               ;   landing loads it fresh, so it is already
0001D5r 2                                               ;   clear in every sense that matters.
0001D5r 2  20 rr rr       jsr PieceFallRate
0001D8r 2  8D rr rr       sta GravityTimer
0001DBr 2  60             rts
0001DCr 2               
0001DCr 2               @Tick:
0001DCr 2  CE rr rr       dec LockTimer
0001DFr 2  D0 09          bne @Done
0001E1r 2  20 rr rr       jsr PieceLock
0001E4r 2  20 rr rr       jsr CascadeBegin              ; SPEC 8 — the cascade starts the moment the
0001E7r 2  4C rr rr       jmp CascadeEnter              ;   piece is board, and runs as sub-states
0001EAr 2               @Done:
0001EAr 2  60             rts
0001EBr 2               
0001EBr 2               ; -----------------------------------------------------------------------------
0001EBr 2               ;   CascadeEnter — run one cascade step and choose the sub-state after it
0001EBr 2               ;   In:  ChainStep set        Out: PlayState set.  Modifies: A, X, Y
0001EBr 2               ;   SPEC 8, D4. Called from the lock, and again from the bottom of every fall.
0001EBr 2               ;
0001EBr 2               ;   A step that marks something hands over to PLAY_GLOW, and the removal and
0001EBr 2               ;   the fall follow it twelve frames later; a step that finds nothing is where
0001EBr 2               ;   the cascade settles and the next piece is queued.
0001EBr 2               ;
0001EBr 2               ;   Nothing has come off the board when CascadeScan returns — that is the whole
0001EBr 2               ;   point of the split (cascade.asm). CascadeFinish does the taking, at the far
0001EBr 2               ;   end of PLAY_SHATTER.
0001EBr 2               ; -----------------------------------------------------------------------------
0001EBr 2               CascadeEnter:
0001EBr 2  20 rr rr       jsr CascadeScan
0001EEr 2  90 08          bcc @Settle
0001F0r 2  A9 04          lda #SFX_MATCH                ; SPEC 16 effect 4, and the chime is pitched by
0001F2r 2  20 rr rr       jsr SfxPlay                   ;   ChainStep when AudioTick starts it. A
0001F5r 2                                               ;   reagent that fired inside the scan has
0001F5r 2                                               ;   already asked for a louder sound and keeps
0001F5r 2                                               ;   the channel (audio.asm)
0001F5r 2  4C rr rr       jmp AnimGlowBegin             ; SPEC 8 step 5
0001F8r 2               
0001F8r 2               @Settle:
0001F8r 2  20 rr rr       jsr CascadeSettle             ; The star multiplier and the bank (SPEC 8
0001FBr 2                                               ;   SETTLE)
0001FBr 2  AD rr rr       lda ChainStep                 ; SPEC 8 SETTLE, SPEC 14 — a chain of two links
0001FEr 2  38             sec                           ;   or more is worth saying out loud. ChainStep
0001FFr 2  E9 01          sbc #1                        ;   counts the step that found nothing as well,
000201r 2  C9 02          cmp #2                        ;   so the links are one fewer
000203r 2  90 03          bcc @Are
000205r 2  20 rr rr       jsr AnimBannerChain
000208r 2               
000208r 2               @Are:
000208r 2  AE rr rr       ldx Region
00020Br 2  BD rr rr       lda AreDelay,x
00020Er 2  8D rr rr       sta AreTimer
000211r 2  A9 05          lda #PLAY_ARE
000213r 2  8D rr rr       sta PlayState
000216r 2  60             rts
000217r 2               
000217r 2               ; -----------------------------------------------------------------------------
000217r 2               ;   PlayGlow — hold the glow, the beams and the fireball's flash (SPEC 14)
000217r 2               ;   The window is one timer however many things are showing inside it: they all
000217r 2               ;   start together and the longest decides how long it lasts (anim.asm).
000217r 2               ; -----------------------------------------------------------------------------
000217r 2               PlayGlow:
000217r 2  CE rr rr       dec AnimTimer
00021Ar 2  D0 03          bne @Done
00021Cr 2  4C rr rr       jmp AnimGlowEnd               ; ...which starts the shatter
00021Fr 2               @Done:
00021Fr 2  60             rts
000220r 2               
000220r 2               ; -----------------------------------------------------------------------------
000220r 2               ;   PlayShatter — the removal ring, VFX_FRAMES a tile (SPEC 14)
000220r 2               ;   The board is finally emptied at the end of this, not at the start of it:
000220r 2               ;   every frame up to here has been drawing over cells that still hold their
000220r 2               ;   own tiles (cascade.asm).
000220r 2               ; -----------------------------------------------------------------------------
000220r 2               PlayShatter:
000220r 2  CE rr rr       dec AnimTimer
000223r 2  D0 20          bne @Done
000225r 2  EE rr rr       inc AnimStep
000228r 2  AD rr rr       lda AnimStep
00022Br 2  CD rr rr       cmp AnimSteps
00022Er 2  B0 0A          bcs @Over
000230r 2  A9 02          lda #VFX_FRAMES
000232r 2  8D rr rr       sta AnimTimer
000235r 2  A9 03          lda #ANIM_SHATTER
000237r 2  4C rr rr       jmp AnimMarked
00023Ar 2               
00023Ar 2               @Over:
00023Ar 2  20 rr rr       jsr CascadeFinish             ; SPEC 8 steps 6 and 7
00023Dr 2  20 rr rr       jsr BoardGravityBegin         ; ...and let what was above it fall
000240r 2  A9 04          lda #PLAY_GRAVITY
000242r 2  8D rr rr       sta PlayState
000245r 2               @Done:
000245r 2  60             rts
000246r 2               
000246r 2               ; -----------------------------------------------------------------------------
000246r 2               ;   PlayGravity — the pile falls into the holes the clear left
000246r 2               ;   SPEC 8 step 8, SPEC 14 — a row every FALL_FRAMES, and when a row moves
000246r 2               ;   nothing the board has settled and the next step scans it.
000246r 2               ;
000246r 2               ;   The row itself may take more than one frame: BoardGravityStep is a cursor
000246r 2               ;   that stops when the dirty ring is full (board.asm). The beat only starts
000246r 2               ;   once the row has actually landed, so a heavy board falls a little slower
000246r 2               ;   rather than losing cells off the screen.
000246r 2               ; -----------------------------------------------------------------------------
000246r 2               PlayGravity:
000246r 2  A5 rr          lda GravIdx
000248r 2  10 0C          bpl @Working                  ; A row is still coming down
00024Ar 2               
00024Ar 2  CE rr rr       dec AnimTimer
00024Dr 2  D0 11          bne @Done
00024Fr 2  A5 rr          lda GravMoved
000251r 2  F0 0E          beq @Landed                   ; The last row moved nothing: everything is
000253r 2  20 rr rr       jsr BoardGravityBegin         ;   resting on something
000256r 2               
000256r 2               @Working:
000256r 2  20 rr rr       jsr BoardGravityStep
000259r 2  90 05          bcc @Done                     ; The ring filled — the rest waits for a flush
00025Br 2  A9 02          lda #FALL_FRAMES              ; The row is down; hold it there for the beat
00025Dr 2  8D rr rr       sta AnimTimer
000260r 2               @Done:
000260r 2  60             rts
000261r 2               
000261r 2               @Landed:
000261r 2  EE rr rr       inc ChainStep                 ; SPEC 8 step 9
000264r 2  4C rr rr       jmp CascadeEnter
000267r 2               
000267r 2               ; -----------------------------------------------------------------------------
000267r 2               ;   PlayAre — the entry delay, then the next piece
000267r 2               ;   SPEC 5.6, 13.4 — a blocked spawn is game over.
000267r 2               ; -----------------------------------------------------------------------------
000267r 2               PlayAre:
000267r 2  CE rr rr       dec AreTimer
00026Ar 2  D0 10          bne @Done
00026Cr 2  20 rr rr       jsr PieceSpawn
00026Fr 2  B0 0C          bcs @Over
000271r 2  20 rr rr       jsr PieceGenerateNext
000274r 2  20 rr rr       jsr RenderNext
000277r 2  A9 00          lda #PLAY_FALLING
000279r 2  8D rr rr       sta PlayState
00027Cr 2               @Done:
00027Cr 2  60             rts
00027Dr 2               
00027Dr 2               @Over:
00027Dr 2  A9 0C          lda #SFX_GAMEOVER
00027Fr 2  20 rr rr       jsr SfxPlay
000282r 2  20 rr rr       jsr AnimPetrifyBegin          ; The well turns to stone from the floor up
000285r 2  A9 00          lda #0                        ;   while StateGameOver holds the input off
000287r 2  8D rr rr       sta OverSecs                  ; The screen proper has not started yet — the
00028Ar 2                                               ;   petrify runs first (SPEC 13.4 step 2)
00028Ar 2  A9 03          lda #STATE_GAMEOVER
00028Cr 2  8D rr rr       sta GameState
00028Fr 2  60             rts
000290r 2               
000290r 2               ; -----------------------------------------------------------------------------
000290r 2               ;   StatePause
000290r 2               ; -----------------------------------------------------------------------------
000290r 2               StatePause:
000290r 2  AD rr rr       lda InputEdge
000293r 2  29 30          and #(INPUT_PAUSE | INPUT_FIRE)
000295r 2  F0 17          beq @Done
000297r 2  A9 01          lda #STATE_PLAY
000299r 2  8D rr rr       sta GameState
00029Cr 2  20 rr rr       jsr TextBannerClear           ; The banner comes down...
00029Fr 2  20 rr rr       jsr RenderBoard               ; ...the board goes back up...
0002A2r 2  AD rr rr       lda PlayState                 ;   ...and the piece on top of it, once the
0002A5r 2  C9 02          cmp #PLAY_GLOW                ;   redraw has gone by (D14) — but only while
0002A7r 2  B0 05          bcs @Done                     ;   there IS one. From GLOW on up the piece is
0002A9r 2  A9 01          lda #1                        ;   in the board and PieceA-C are stale; the
0002ABr 2  8D rr rr       sta PieceDirty                ;   cascade may have taken those cells away
0002AEr 2               @Done:                          ;   entirely.
0002AEr 2  60             rts
0002AFr 2               
0002AFr 2               ; -----------------------------------------------------------------------------
0002AFr 2               ;   StateGameOver — petrify, banner, fanfare, back to the title
0002AFr 2               ;   SPEC 13.4, in its own order: the well sets to stone, THEN the band says so,
0002AFr 2               ;   and only then does the screen start counting itself out.
0002AFr 2               ;
0002AFr 2               ;   OverSecs is the phase as well as the count. It is zero for the length of
0002AFr 2               ;   the petrify and never zero afterwards, because the frame it would reach
0002AFr 2               ;   zero is the frame this state ends — so the one-shot in the middle needs no
0002AFr 2               ;   flag of its own.
0002AFr 2               ;
0002AFr 2               ;   Nothing here ticks the banner down (AnimBannerTick is StatePlay's), which
0002AFr 2               ;   is what leaves GAME OVER up for the whole ten seconds rather than the 45
0002AFr 2               ;   frames every other banner gets. GameStart clears the band on the way out.
0002AFr 2               ; -----------------------------------------------------------------------------
0002AFr 2               StateGameOver:
0002AFr 2  20 rr rr       jsr AnimPetrifyTick           ; SPEC 13.4 step 2, a row every PETRIFY_FRAMES
0002B2r 2  B0 56          bcs @Done                     ; Still setting. A press during the petrify is
0002B4r 2                                               ;   ignored rather than queued: the animation
0002B4r 2                                               ;   is the game telling the player it is over
0002B4r 2                                               ;   and skipping it reads as a dropped input.
0002B4r 2  AD rr rr       lda OverSecs
0002B7r 2  D0 2A          bne @Waiting
0002B9r 2               
0002B9r 2  20 rr rr       jsr AnimBannerOver            ; SPEC 13.4 step 3
0002BCr 2  AD rr rr       lda HighOwned                 ; Step 4 — the fanfare and the flash, but only
0002BFr 2  F0 13          beq @Start                    ;   if THIS game took the record. HighOwned is
0002C1r 2                                               ;   what says so, and ScoreReset clears it for
0002C1r 2                                               ;   the next one (score.asm, SPEC 9.8)
0002C1r 2  A9 0B          lda #SFX_HIGHSCORE
0002C3r 2  20 rr rr       jsr SfxPlay
0002C6r 2  A9 06          lda #HIGH_FLASH_BLINKS
0002C8r 2  8D rr rr       sta HighFlash
0002CBr 2  AE rr rr       ldx Region
0002CEr 2  BD rr rr       lda BlinkHalf,x
0002D1r 2  8D rr rr       sta HighTimer
0002D4r 2               @Start:
0002D4r 2  A9 0A          lda #GAMEOVER_SECS
0002D6r 2  8D rr rr       sta OverSecs
0002D9r 2  AE rr rr       ldx Region
0002DCr 2  BD rr rr       lda SecondFrames,x
0002DFr 2  8D rr rr       sta OverTimer
0002E2r 2  60             rts
0002E3r 2               
0002E3r 2               @Waiting:
0002E3r 2  20 rr rr       jsr ScoreFlashTick            ; The HIGH field blinks here for the same
0002E6r 2                                               ;   reason it does in play — nothing else is
0002E6r 2                                               ;   calling it now that StatePlay has stopped
0002E6r 2  CE rr rr       dec OverTimer
0002E9r 2  D0 0E          bne @Input
0002EBr 2  AE rr rr       ldx Region
0002EEr 2  BD rr rr       lda SecondFrames,x
0002F1r 2  8D rr rr       sta OverTimer
0002F4r 2  CE rr rr       dec OverSecs
0002F7r 2  F0 07          beq @ToTitle                  ; SPEC 13.4 step 5 — ten seconds, unattended
0002F9r 2               @Input:
0002F9r 2  AD rr rr       lda InputEdge
0002FCr 2  29 11          and #(INPUT_FIRE | INPUT_UP)  ; Fire, or SPACE (D15)
0002FEr 2  F0 0A          beq @Done
000300r 2               @ToTitle:
000300r 2  A9 00          lda #STATE_TITLE
000302r 2  8D rr rr       sta GameState
000305r 2  A9 01          lda #1
000307r 2  8D rr rr       sta NeedsRedraw
00030Ar 2               @Done:
00030Ar 2  60             rts
00030Br 2               
00030Br 2               ; =============================================================================
00030Br 2               ;   Static screen drawing
00030Br 2               ; =============================================================================
00030Br 2               ;   The whole static layout — panel frame, labels, and the margin artwork that
00030Br 2               ;   fills the screen either side of it — comes out of the editors as one
00030Br 2               ;   name-table image per platform. Code only ever draws over the top of it:
00030Br 2               ;   the well, the score and level digits, the preview, and the message band.
00030Br 2               ;
00030Br 2               ;   All six images are real. They come out of artwork/WizardsLab.tms9918 —
00030Br 2               ;   the master — by way of `make artwork`. See data/README.md.
00030Br 2               ; =============================================================================
00030Br 2               
00030Br 2               DrawTitleScreen:
00030Br 2  A9 rr          lda #<TitleScreen
00030Dr 2  85 rr          sta SrcPtr
00030Fr 2  A9 rr          lda #>TitleScreen
000311r 2  85 rr          sta SrcPtr+1
000313r 2  A9 rr          lda #<TitleColor
000315r 2  85 rr          sta Ptr1
000317r 2  A9 rr          lda #>TitleColor
000319r 2  85 rr          sta Ptr1+1
00031Br 2  4C rr rr       jmp HalBlitScreen
00031Er 2               
00031Er 2               DrawPlayScreen:
00031Er 2  A9 rr          lda #<PlayScreen
000320r 2  85 rr          sta SrcPtr
000322r 2  A9 rr          lda #>PlayScreen
000324r 2  85 rr          sta SrcPtr+1
000326r 2  A9 rr          lda #<PlayColor
000328r 2  85 rr          sta Ptr1
00032Ar 2  A9 rr          lda #>PlayColor
00032Cr 2  85 rr          sta Ptr1+1
00032Er 2  4C rr rr       jmp HalBlitScreen
000331r 2               
000331r 1               .include "../src/rng.asm"
000331r 2               ; =============================================================================
000331r 2               ;   rng.asm — Wizards Lab, random numbers
000331r 2               ; =============================================================================
000331r 2               ;   A 16-bit Galois LFSR with the conventional $B400 taps, which is maximal
000331r 2               ;   length: it visits all 65535 non-zero states before repeating. Eight shifts
000331r 2               ;   per call, one whole byte out.
000331r 2               ;
000331r 2               ;   Seeding matters more than the generator does. A fixed seed would deal the
000331r 2               ;   same first three pieces every session and the game would feel dead, so the
000331r 2               ;   seed is taken from the free-running frame counter at the moment the player
000331r 2               ;   presses fire on the title screen — human reaction time is the entropy.
000331r 2               ;
000331r 2               ;   SPEC.md section 15.
000331r 2               ; =============================================================================
000331r 2               
000331r 2               ; -----------------------------------------------------------------------------
000331r 2               ;   RngSeed — seed from the frame counter
000331r 2               ;   In:  nothing (reads FrameCounter)
000331r 2               ;   Out: nothing.  Modifies: A
000331r 2               ; -----------------------------------------------------------------------------
000331r 2               RngSeed:
000331r 2  AD rr rr       lda FrameCounter
000334r 2  09 01          ora #$01                      ; Never let the state reach zero — it sticks
000336r 2  85 rr          sta RngLo
000338r 2  49 5A          eor #$5A                      ; Spread one byte of entropy over both halves
00033Ar 2  85 rr          sta RngHi
00033Cr 2  60             rts
00033Dr 2               
00033Dr 2               ; -----------------------------------------------------------------------------
00033Dr 2               ;   RngNext — next pseudo-random byte
00033Dr 2               ;   In:  nothing
00033Dr 2               ;   Out: A = random 0-255.  Modifies: A, X, flags
00033Dr 2               ; -----------------------------------------------------------------------------
00033Dr 2               RngNext:
00033Dr 2  A2 08          ldx #8                        ; Eight shifts give one whole output byte
00033Fr 2               @Bit:
00033Fr 2  46 rr          lsr RngHi                     ; Shift the 16-bit state right one place,
000341r 2  66 rr          ror RngLo                     ;   the bit falling out of bit 0 lands in C
000343r 2  90 06          bcc @NoTap
000345r 2  A5 rr          lda RngHi
000347r 2  49 B4          eor #$B4                      ; Galois feedback mask $B400
000349r 2  85 rr          sta RngHi
00034Br 2               @NoTap:
00034Br 2  CA             dex
00034Cr 2  D0 F1          bne @Bit
00034Er 2  A5 rr          lda RngLo
000350r 2  60             rts
000351r 2               
000351r 2               ; -----------------------------------------------------------------------------
000351r 2               ;   RngRange — a random number below a small limit
000351r 2               ;   In:  A = limit, 1-128
000351r 2               ;   Out: A = 0 .. limit-1.  Modifies: A, X, Tmp0, Tmp1.  PRESERVES Y.
000351r 2               ;
000351r 2               ;   Not a modulo. `random % 6` throws four of the 256 outcomes into the low
000351r 2               ;   values and leaves colours 0-3 a shade likelier than 4-5; this takes the
000351r 2               ;   HIGH byte of (random * limit) instead, which spreads the remainder evenly
000351r 2               ;   across the range and costs a fixed eight shifts either way.
000351r 2               ;
000351r 2               ;   The eight-bit multiply keeps only the high byte: the low half falls out of
000351r 2               ;   the accumulator one bit at a time and is never wanted.
000351r 2               ;
000351r 2               ;   Y is preserved so a caller can loop over the three cells of a piece with
000351r 2               ;   it (piece.asm does).
000351r 2               ; -----------------------------------------------------------------------------
000351r 2               RngRange:
000351r 2  48             pha                           ; The limit — RngNext wants A
000352r 2  20 rr rr       jsr RngNext
000355r 2  85 rr          sta Tmp0                      ; The random byte
000357r 2  68             pla
000358r 2  85 rr          sta Tmp1                      ; The limit, shifted out one bit at a time
00035Ar 2  A9 00          lda #0
00035Cr 2  A2 08          ldx #8
00035Er 2               @Bit:
00035Er 2  46 rr          lsr Tmp1                      ; Next multiplier bit into C
000360r 2  90 03          bcc @NoAdd
000362r 2  18             clc
000363r 2  65 rr          adc Tmp0                      ; Partial product, carry out into C
000365r 2               @NoAdd:
000365r 2  6A             ror a                         ; Shift the accumulator down, carry in at bit 7
000366r 2  CA             dex
000367r 2  D0 F5          bne @Bit
000369r 2  60             rts
00036Ar 2               
00036Ar 1               .include "../src/input.asm"
00036Ar 2               ; =============================================================================
00036Ar 2               ;   input.asm — Wizards Lab, input conditioning
00036Ar 2               ; =============================================================================
00036Ar 2               ;   SPEC.md section 11. HalReadInput hands back one active-high mask however
00036Ar 2               ;   the platform likes; everything above this line works on that mask and
00036Ar 2               ;   never touches hardware.
00036Ar 2               ;
00036Ar 2               ;   Auto-repeat applies to LEFT and RIGHT only. Rotate does NOT repeat — up
00036Ar 2               ;   must be released and pressed again. That is not a preference: a repeating
00036Ar 2               ;   rotate makes a three-cell Columns piece impossible to aim.
00036Ar 2               ; =============================================================================
00036Ar 2               
00036Ar 2               ; -----------------------------------------------------------------------------
00036Ar 2               ;   InputPoll — read the hardware and work out what is newly pressed
00036Ar 2               ;   In:  nothing
00036Ar 2               ;   Out: InputNow, InputPrev, InputEdge updated.  Modifies: A
00036Ar 2               ; -----------------------------------------------------------------------------
00036Ar 2               InputPoll:
00036Ar 2  AD rr rr       lda InputNow
00036Dr 2  8D rr rr       sta InputPrev
000370r 2  20 rr rr       jsr HalReadInput
000373r 2  8D rr rr       sta InputNow
000376r 2  4D rr rr       eor InputPrev                 ; Bits that changed
000379r 2  2D rr rr       and InputNow                  ; ...and are now down = newly pressed
00037Cr 2  8D rr rr       sta InputEdge
00037Fr 2  60             rts
000380r 2               
000380r 2               ; -----------------------------------------------------------------------------
000380r 2               ;   InputShift — LEFT/RIGHT with delayed auto shift
000380r 2               ;   Out: A = INPUT_LEFT, INPUT_RIGHT, or 0 if no move should happen this frame.
000380r 2               ;        Modifies: A, X
000380r 2               ;   SPEC 11.3 — initial delay 12 frames NTSC / 10 PAL, then 4 / 3.
000380r 2               ;
000380r 2               ;   A fresh press fires on the same frame it arrives; the delay is what comes
000380r 2               ;   after it, not before it, so a tap is always exactly one column.
000380r 2               ;
000380r 2               ;   Holding both directions at once is not something a stick can do, but two
000380r 2               ;   keys can. LEFT wins, and it wins consistently, so the piece sits still
000380r 2               ;   rather than shivering between the two.
000380r 2               ; -----------------------------------------------------------------------------
000380r 2               InputShift:
000380r 2  AD rr rr       lda InputNow
000383r 2  29 04          and #INPUT_LEFT
000385r 2  D0 07          bne @Dir
000387r 2  AD rr rr       lda InputNow
00038Ar 2  29 08          and #INPUT_RIGHT
00038Cr 2  F0 2A          beq @None
00038Er 2               
00038Er 2               @Dir:
00038Er 2  CD rr rr       cmp DasDir
000391r 2  F0 10          beq @Held
000393r 2               
000393r 2  8D rr rr       sta DasDir                    ; A new direction: fire now, then wait
000396r 2  AE rr rr       ldx Region
000399r 2  BD rr rr       lda DasInitial,x
00039Cr 2  8D rr rr       sta DasTimer
00039Fr 2  AD rr rr       lda DasDir
0003A2r 2  60             rts
0003A3r 2               
0003A3r 2               @Held:
0003A3r 2  CE rr rr       dec DasTimer                  ; Always loaded non-zero, so this cannot wrap
0003A6r 2  D0 0D          bne @Wait
0003A8r 2  AE rr rr       ldx Region
0003ABr 2  BD rr rr       lda DasRepeat,x
0003AEr 2  8D rr rr       sta DasTimer
0003B1r 2  AD rr rr       lda DasDir
0003B4r 2  60             rts
0003B5r 2               
0003B5r 2               @Wait:
0003B5r 2  A9 00          lda #0
0003B7r 2  60             rts
0003B8r 2               
0003B8r 2               @None:
0003B8r 2  8D rr rr       sta DasDir                    ; A is already 0 — release, so the next press
0003BBr 2  60             rts                           ;   counts as fresh
0003BCr 2               
0003BCr 1               .include "../src/board.asm"
0003BCr 2               ; =============================================================================
0003BCr 2               ;   board.asm — Wizards Lab, the playfield
0003BCr 2               ; =============================================================================
0003BCr 2               ;   SPEC.md section 3. The board is 20 rows of 8 bytes, page-aligned, with
0003BCr 2               ;   columns 6-7 and rows 16-19 held permanently at $FF. Those sentinels are
0003BCr 2               ;   what let every scan in match.asm run without a bounds check.
0003BCr 2               ;
0003BCr 2               ;   address(row, col) = Board + (row << 3) + col
0003BCr 2               ; =============================================================================
0003BCr 2               
0003BCr 2               ; -----------------------------------------------------------------------------
0003BCr 2               ;   BoardClear — empty the playfield and lay the sentinels back down
0003BCr 2               ;   In:  nothing        Out: nothing.  Modifies: A, X
0003BCr 2               ;
0003BCr 2               ;   Walls first over the whole 160 bytes, then the six playfield columns of
0003BCr 2               ;   the sixteen playfield rows punched back out to empty. Doing it in that
0003BCr 2               ;   order means the sentinels can never be forgotten: everything that is not
0003BCr 2               ;   explicitly playfield is a wall.
0003BCr 2               ;
0003BCr 2               ;   The wall loop counts UP and ends on a CPX. Counting down from 159 to a BPL
0003BCr 2               ;   looks tidier and is wrong: 159 is $9F, bit 7 already set, so the branch
0003BCr 2               ;   falls through after the first store and the other 159 bytes keep whatever
0003BCr 2               ;   the machine powered up with. That went unnoticed for a whole phase,
0003BCr 2               ;   because nothing read a sentinel until the falling piece needed a floor.
0003BCr 2               ; -----------------------------------------------------------------------------
0003BCr 2               BoardClear:
0003BCr 2  A9 FF          lda #TILE_WALL
0003BEr 2  A2 00          ldx #0
0003C0r 2               @Wall:
0003C0r 2  9D rr rr       sta Board,x
0003C3r 2  E8             inx
0003C4r 2  E0 A0          cpx #BOARD_BYTES
0003C6r 2  D0 F8          bne @Wall
0003C8r 2               
0003C8r 2  A2 00          ldx #0                        ; X walks the row bases, 0, 8, 16, ...
0003CAr 2               @Row:
0003CAr 2  A9 00          lda #TILE_EMPTY               ; Reloaded every row: the TXA below eats it
0003CCr 2  9D rr rr 9D    .repeat BOARD_W, COL
0003D0r 2  rr rr 9D rr  
0003D4r 2  rr 9D rr rr  
0003DEr 2                   sta Board + COL, x
0003DEr 2                 .endrepeat
0003DEr 2  8A             txa
0003DFr 2  18             clc
0003E0r 2  69 08          adc #BOARD_STRIDE
0003E2r 2  AA             tax
0003E3r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
0003E5r 2  90 E3          bcc @Row
0003E7r 2  60             rts
0003E8r 2               
0003E8r 2               ; -----------------------------------------------------------------------------
0003E8r 2               ;   BoardRowPtr — point Ptr1 at the start of a board row
0003E8r 2               ;   In:  A = row        Out: Ptr1 = &Board[row][0].  Modifies: A, Ptr1
0003E8r 2               ;
0003E8r 2               ;   Board is page-aligned and 160 bytes, so row * 8 is at most 152 and the low
0003E8r 2               ;   byte can never carry into the high one.
0003E8r 2               ; -----------------------------------------------------------------------------
0003E8r 2               BoardRowPtr:
0003E8r 2  0A             asl a
0003E9r 2  0A             asl a
0003EAr 2  0A             asl a
0003EBr 2  18             clc
0003ECr 2  69 rr          adc #<Board
0003EEr 2  85 rr          sta Ptr1
0003F0r 2  A9 rr          lda #>Board
0003F2r 2  85 rr          sta Ptr1+1
0003F4r 2  60             rts
0003F5r 2               
0003F5r 2               ; -----------------------------------------------------------------------------
0003F5r 2               ;   BoardGravityBegin / BoardGravityStep — the pile falls, one row at a time
0003F5r 2               ;   SPEC 8 step 8, SPEC 14: tiles descend one row every FALL_FRAMES.
0003F5r 2               ;
0003F5r 2               ;   A row of falling is one pass over the board, bottom to top, moving every
0003F5r 2               ;   tile that has an empty cell under it down into it. Repeat until a pass
0003F5r 2               ;   moves nothing and the columns are compacted — but repeat it a row at a
0003F5r 2               ;   time, because the fall is animated and a column that dropped four rows in
0003F5r 2               ;   one frame would read as a teleport.
0003F5r 2               ;
0003F5r 2               ;   Walking BOTTOM TO TOP is what makes a whole column fall together rather
0003F5r 2               ;   than one tile a frame: by the time the pass reaches a tile, the tile below
0003F5r 2               ;   it has already moved and left the gap.
0003F5r 2               ;
0003F5r 2               ;   The pass is a CURSOR, not a loop that runs to completion (D12, SPEC 12.6).
0003F5r 2               ;   Sixty tiles falling is a hundred-odd changed cells and the dirty ring holds
0003F5r 2               ;   64, so the pass stops when the ring is full and picks up where it stopped
0003F5r 2               ;   next frame. Nothing is dropped and the board is a legal board at every
0003F5r 2               ;   point it stops — one frame's worth of columns has fallen a row and the
0003F5r 2               ;   rest has not, which is a stagger nobody can see.
0003F5r 2               ;
0003F5r 2               ;   The two sentinel columns need no special case: a wall's "cell below" is
0003F5r 2               ;   another wall, so columns 6 and 7 never move.
0003F5r 2               ; -----------------------------------------------------------------------------
0003F5r 2               GRAV_TOP = (BOARD_H - 1) * BOARD_STRIDE - 1     ; The last cell of row 14, the
0003F5r 2                                                               ;   lowest row that can fall at
0003F5r 2                                                               ;   all. Row 15 is on the floor
0003F5r 2               BoardGravityBegin:
0003F5r 2  A9 77          lda #GRAV_TOP
0003F7r 2  85 rr          sta GravIdx
0003F9r 2  A9 00          lda #0
0003FBr 2  85 rr          sta GravMoved
0003FDr 2  60             rts
0003FEr 2               
0003FEr 2               ; -----------------------------------------------------------------------------
0003FEr 2               ;   BoardGravityStep — carry on with the current row of falling
0003FEr 2               ;   In:  nothing
0003FEr 2               ;   Out: C set when the row is finished; GravMoved non-zero if it moved
0003FEr 2               ;        anything. Modifies: A, X, Y, GravIdx, GravMoved, RedrawCol
0003FEr 2               ; -----------------------------------------------------------------------------
0003FEr 2               BoardGravityStep:
0003FEr 2  A5 rr          lda GravIdx
000400r 2  30 3F          bmi @Finished                 ; $FF — the row is already done
000402r 2               
000402r 2               @Cell:
000402r 2  AD rr rr       lda DirtyCount                ; Room for both cells of a move, or wait for
000405r 2  C9 3E          cmp #(DIRTY_ENTRIES - 2)      ;   the flush. A mark dropped here would never
000407r 2  B0 3A          bcs @Later                    ;   be marked again (D6 is survivable only
000409r 2                                               ;   because nothing that MUST land uses it)
000409r 2               
000409r 2  A6 rr          ldx GravIdx
00040Br 2  BD rr rr       lda Board,x
00040Er 2  F0 2D          beq @Next                     ; Nothing here to fall
000410r 2  BD rr rr       lda Board + BOARD_STRIDE,x
000413r 2  D0 28          bne @Next                     ; Something under it — a tile, or the floor
000415r 2               
000415r 2  BD rr rr       lda Board,x                   ; Move it down one row
000418r 2  9D rr rr       sta Board + BOARD_STRIDE,x
00041Br 2  A9 00          lda #TILE_EMPTY
00041Dr 2  9D rr rr       sta Board,x
000420r 2  E6 rr          inc GravMoved
000422r 2               
000422r 2  A5 rr          lda GravIdx                   ; The cell it LEFT only needs redrawing if it
000424r 2  C9 08          cmp #BOARD_STRIDE             ;   is going to stay empty. If there is a tile
000426r 2  90 07          bcc @Vacated                  ;   above it, that tile lands here later in
000428r 2  A6 rr          ldx GravIdx                   ;   this same pass and its own arrival mark
00042Ar 2  BD rr rr       lda Board - BOARD_STRIDE,x    ;   covers the cell. Half the marks of a
00042Dr 2  D0 05          bne @Arrived                  ;   sliding column, which is what the ring
00042Fr 2               @Vacated:                       ;   pressure is made of.
00042Fr 2  A6 rr          ldx GravIdx
000431r 2  20 rr rr       jsr RenderCell
000434r 2               @Arrived:
000434r 2  A5 rr          lda GravIdx
000436r 2  18             clc
000437r 2  69 08          adc #BOARD_STRIDE
000439r 2  AA             tax
00043Ar 2  20 rr rr       jsr RenderCell
00043Dr 2               
00043Dr 2               @Next:
00043Dr 2  C6 rr          dec GravIdx                   ; Down to 0, then $FF, which ends the pass —
00043Fr 2  10 C1          bpl @Cell                     ;   GRAV_TOP is 119, so bit 7 starts clear
000441r 2                                               ;   (see PLAN.md section 3)
000441r 2               @Finished:
000441r 2  38             sec
000442r 2  60             rts
000443r 2               
000443r 2               @Later:
000443r 2  18             clc                           ; Ring full: the rest of this row waits a frame
000444r 2  60             rts
000445r 2               
000445r 1               .include "../src/piece.asm"
000445r 2               ; =============================================================================
000445r 2               ;   piece.asm — Wizards Lab, the falling piece
000445r 2               ; =============================================================================
000445r 2               ;   SPEC.md section 5. A piece is three independently generated cells stacked
000445r 2               ;   vertically, A on top. At most one of the three carries a reagent, which is
000445r 2               ;   enforced by rolling once for the piece rather than once per cell.
000445r 2               ;
000445r 2               ;   The piece is NOT in the board while it falls. Board cells under it stay
000445r 2               ;   empty until PieceLock writes them, which is what makes the movement tests
000445r 2               ;   below a plain read of the three target cells and what lets the erase be
000445r 2               ;   three blanks rather than three board reads.
000445r 2               ;
000445r 2               ;   Nothing here draws. Every routine that changes where the piece is or what
000445r 2               ;   it holds sets PieceDirty and lets StatePlay pick the moment (D14).
000445r 2               ; =============================================================================
000445r 2               
000445r 2               ; -----------------------------------------------------------------------------
000445r 2               ;   PieceIndex — board index of the piece's top cell
000445r 2               ;   In:  nothing
000445r 2               ;   Out: A = X = PieceRow * BOARD_STRIDE + PieceCol.  Modifies: A, X
000445r 2               ;
000445r 2               ;   Cells B and C are one and two strides on from it, and the cell below C is
000445r 2               ;   three — which is the only address arithmetic the rest of this file needs.
000445r 2               ;   Row 16 and beyond is a wall row, so "below C" is always a legal read.
000445r 2               ; -----------------------------------------------------------------------------
000445r 2               PieceIndex:
000445r 2  AD rr rr       lda PieceRow
000448r 2  0A             asl a
000449r 2  0A             asl a
00044Ar 2  0A             asl a                         ; row * 8
00044Br 2  18             clc
00044Cr 2  6D rr rr       adc PieceCol
00044Fr 2  AA             tax
000450r 2  60             rts
000451r 2               
000451r 2               ; -----------------------------------------------------------------------------
000451r 2               ;   PieceGenerateNext — roll the preview piece into NextA/NextB/NextC
000451r 2               ;   In:  nothing (reads Level)
000451r 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0, Tmp1
000451r 2               ;   SPEC 5.2, 5.3 — colours uniform over 0-5, then one reagent roll.
000451r 2               ; -----------------------------------------------------------------------------
000451r 2               PieceGenerateNext:
000451r 2  A0 00          ldy #0                        ; RngRange preserves Y, so it can index the
000453r 2               @Color:                         ;   three cells across the call
000453r 2  A9 06          lda #NUM_COLORS
000455r 2  20 rr rr       jsr RngRange                  ; 0-5, uniform (SPEC 5.2)
000458r 2  0A             asl a
000459r 2  0A             asl a
00045Ar 2  0A             asl a                         ; colour << 3 ...
00045Br 2  18             clc
00045Cr 2  69 40          adc #COLOR_BASE               ;   ... + base, glyph 0, so it is a potion
00045Er 2  99 rr rr       sta NextA,y                   ; NextA/B/C are three consecutive bytes
000461r 2  C8             iny
000462r 2  C0 03          cpy #3
000464r 2  90 ED          bcc @Color
000466r 2               
000466r 2                 ; --- does this piece carry a reagent at all? (SPEC 5.3) -------------------
000466r 2                 ;   One roll for the whole piece, which both caps it at one reagent and
000466r 2                 ;   costs three rolls fewer than asking each cell.
000466r 2  20 rr rr       jsr RngNext
000469r 2  85 rr          sta Tmp0                      ; The roll. Nothing below calls out until it
00046Br 2                                               ;   has been compared, so Tmp0 is safe.
00046Br 2  AE rr rr       ldx Level
00046Er 2  CA             dex                           ; LevelBand is indexed by level - 1 ...
00046Fr 2  E0 10          cpx #16
000471r 2  90 02          bcc @Band
000473r 2  A2 0F          ldx #15                       ;   ... and clamped: band 4 is "13 and up"
000475r 2               @Band:
000475r 2  BD rr rr       lda LevelBand,x
000478r 2  AA             tax                           ; X = band 0-4
000479r 2  A5 rr          lda Tmp0
00047Br 2  DD rr rr       cmp PSpecial,x                ; C clear = the roll came in under the chance
00047Er 2  B0 2E          bcs @Done
000480r 2               
000480r 2                 ; --- which cell, and which reagent ----------------------------------------
000480r 2  8A             txa
000481r 2  48             pha                           ; The band, across the cell roll
000482r 2  A9 03          lda #3
000484r 2  20 rr rr       jsr RngRange                  ; 0, 1 or 2 — uniform over A, B and C
000487r 2  A8             tay                           ; Y survives the type roll below
000488r 2  68             pla
000489r 2  0A             asl a
00048Ar 2  0A             asl a                         ; band * 4 — ReagentThresholds is four
00048Br 2  48             pha                           ;   thresholds per band
00048Cr 2  20 rr rr       jsr RngNext
00048Fr 2  85 rr          sta Tmp0                      ; The type roll
000491r 2  68             pla
000492r 2  AA             tax
000493r 2  A5 rr          lda Tmp0
000495r 2               
000495r 2  DD rr rr       cmp ReagentThresholds+0,x     ; The cumulative-weight compare chain SPEC 5.3
000498r 2  90 15          bcc @Fireball                 ;   recommends over a 1280-byte lookup
00049Ar 2  DD rr rr       cmp ReagentThresholds+1,x
00049Dr 2  90 14          bcc @Bolt
00049Fr 2  DD rr rr       cmp ReagentThresholds+2,x
0004A2r 2  90 13          bcc @Bomb
0004A4r 2  DD rr rr       cmp ReagentThresholds+3,x
0004A7r 2  90 12          bcc @Star
0004A9r 2               
0004A9r 2  A9 70          lda #WILD_BASE                ; A Prism discards the colour it rolled and
0004ABr 2  99 rr rr       sta NextA,y                   ;   joins group 14 (SPEC 5.2)
0004AEr 2               @Done:
0004AEr 2  60             rts
0004AFr 2               
0004AFr 2               @Fireball:
0004AFr 2  A9 01          lda #GLYPH_FIREBALL
0004B1r 2  D0 0A          bne @Apply                    ; Always — every glyph below is non-zero
0004B3r 2               @Bolt:
0004B3r 2  A9 02          lda #GLYPH_BOLT
0004B5r 2  D0 06          bne @Apply
0004B7r 2               @Bomb:
0004B7r 2  A9 03          lda #GLYPH_BOMB
0004B9r 2  D0 02          bne @Apply
0004BBr 2               @Star:
0004BBr 2  A9 04          lda #GLYPH_STAR
0004BDr 2               @Apply:
0004BDr 2  19 rr rr       ora NextA,y                   ; The cell's glyph nibble is 0, so an ORA sets
0004C0r 2  99 rr rr       sta NextA,y                   ;   the reagent and keeps the rolled colour
0004C3r 2  60             rts
0004C4r 2               
0004C4r 2               ; -----------------------------------------------------------------------------
0004C4r 2               ;   PieceSpawn — promote the preview to the falling piece
0004C4r 2               ;   In:  nothing
0004C4r 2               ;   Out: C set if the spawn cells were occupied (game over)
0004C4r 2               ;        Modifies: A, X
0004C4r 2               ;   SPEC 5.4 — spawn column SPAWN_COL, rows 0-2, visible immediately.
0004C4r 2               ;
0004C4r 2               ;   The preview is copied whether or not the spawn succeeds; on a blocked
0004C4r 2               ;   spawn nothing looks at the piece again.
0004C4r 2               ; -----------------------------------------------------------------------------
0004C4r 2               PieceSpawn:
0004C4r 2  AD rr rr       lda NextA
0004C7r 2  8D rr rr       sta PieceA
0004CAr 2  AD rr rr       lda NextB
0004CDr 2  8D rr rr       sta PieceB
0004D0r 2  AD rr rr       lda NextC
0004D3r 2  8D rr rr       sta PieceC
0004D6r 2               
0004D6r 2  A9 02          lda #SPAWN_COL
0004D8r 2  8D rr rr       sta PieceCol
0004DBr 2  A9 00          lda #0
0004DDr 2  8D rr rr       sta PieceRow
0004E0r 2  8D rr rr       sta LockTimer
0004E3r 2  8D rr rr       sta LockResets                ; The reset allowance is per piece (SPEC 5.6)
0004E6r 2               
0004E6r 2  AD rr rr       lda Board + 0 * BOARD_STRIDE + SPAWN_COL
0004E9r 2  0D rr rr       ora Board + 1 * BOARD_STRIDE + SPAWN_COL
0004ECr 2  0D rr rr       ora Board + 2 * BOARD_STRIDE + SPAWN_COL
0004EFr 2  D0 0D          bne @Blocked
0004F1r 2               
0004F1r 2  20 rr rr       jsr ScoreGravity
0004F4r 2  8D rr rr       sta GravityTimer
0004F7r 2  A9 01          lda #1
0004F9r 2  8D rr rr       sta PieceDirty                ; Drawn immediately — there is no off-screen
0004FCr 2  18             clc                           ;   entry (SPEC 5.4)
0004FDr 2  60             rts
0004FEr 2               
0004FEr 2               @Blocked:
0004FEr 2  38             sec
0004FFr 2  60             rts
000500r 2               
000500r 2               ; -----------------------------------------------------------------------------
000500r 2               ;   PieceMoveLeft / PieceMoveRight — one column, if all three cells are free
000500r 2               ;   Out: C set if the move happened (the caller resets the lock timer).
000500r 2               ;        Modifies: A, X
000500r 2               ;   SPEC 5.5 — no wall kicks; a 1-wide piece has nothing to kick off.
000500r 2               ;
000500r 2               ;   The right edge needs no bounds check: column 6 is a permanent $FF sentinel
000500r 2               ;   and fails the emptiness test on its own (SPEC 3.2). The LEFT edge does,
000500r 2               ;   because column -1 of row 0 is the byte before a page-aligned Board and
000500r 2               ;   belongs to nobody.
000500r 2               ; -----------------------------------------------------------------------------
000500r 2               PieceMoveLeft:
000500r 2  AD rr rr       lda PieceCol
000503r 2  F0 18          beq @No                       ; Column 0 — there is no sentinel to the left
000505r 2  20 rr rr       jsr PieceIndex
000508r 2  CA             dex
000509r 2  BD rr rr       lda Board + 0 * BOARD_STRIDE,x
00050Cr 2  1D rr rr       ora Board + 1 * BOARD_STRIDE,x
00050Fr 2  1D rr rr       ora Board + 2 * BOARD_STRIDE,x
000512r 2  D0 09          bne @No
000514r 2  20 rr rr       jsr RenderPieceErase
000517r 2  CE rr rr       dec PieceCol
00051Ar 2  4C rr rr       jmp PieceShifted
00051Dr 2               
00051Dr 2               @No:
00051Dr 2  18             clc
00051Er 2  60             rts
00051Fr 2               
00051Fr 2               PieceMoveRight:
00051Fr 2  20 rr rr       jsr PieceIndex
000522r 2  E8             inx
000523r 2  BD rr rr       lda Board + 0 * BOARD_STRIDE,x
000526r 2  1D rr rr       ora Board + 1 * BOARD_STRIDE,x
000529r 2  1D rr rr       ora Board + 2 * BOARD_STRIDE,x
00052Cr 2  D0 09          bne @No
00052Er 2  20 rr rr       jsr RenderPieceErase
000531r 2  EE rr rr       inc PieceCol
000534r 2  4C rr rr       jmp PieceShifted
000537r 2               @No:
000537r 2  18             clc
000538r 2  60             rts
000539r 2               
000539r 2               ; -----------------------------------------------------------------------------
000539r 2               ;   PieceShifted — a horizontal move landed (SPEC 16 effect 1)
000539r 2               ;   Out: C set.  Modifies: A
000539r 2               ;   Separate from PieceMoved because gravity goes through THAT and a row of
000539r 2               ;   falling makes no noise: the blip belongs to the player's hand, not to the
000539r 2               ;   piece changing cells.
000539r 2               ; -----------------------------------------------------------------------------
000539r 2               PieceShifted:
000539r 2  A9 01          lda #SFX_MOVE
00053Br 2  20 rr rr       jsr SfxPlay
00053Er 2                 ; falls through
00053Er 2               
00053Er 2               ; -----------------------------------------------------------------------------
00053Er 2               ;   PieceMoved — mark the piece for redraw and report success
00053Er 2               ;   Out: C set.  Modifies: A
00053Er 2               ; -----------------------------------------------------------------------------
00053Er 2               PieceMoved:
00053Er 2  A9 01          lda #1
000540r 2  8D rr rr       sta PieceDirty
000543r 2  38             sec
000544r 2  60             rts
000545r 2               
000545r 2               ; -----------------------------------------------------------------------------
000545r 2               ;   PieceRotate / PieceRotateBack — cycle the three cells
000545r 2               ;   Out: nothing.  Modifies: A, X
000545r 2               ;   SPEC 5.5 — (A,B,C) -> (B,C,A) forward, (C,A,B) back. Always succeeds: the
000545r 2               ;   footprint never changes, so there is nothing to test and nothing to erase.
000545r 2               ;   Rotation does not reset the lock delay (SPEC 5.6).
000545r 2               ; -----------------------------------------------------------------------------
000545r 2               PieceRotate:
000545r 2  AD rr rr       lda PieceA
000548r 2  AE rr rr       ldx PieceB
00054Br 2  8E rr rr       stx PieceA
00054Er 2  AE rr rr       ldx PieceC
000551r 2  8E rr rr       stx PieceB
000554r 2  8D rr rr       sta PieceC
000557r 2  A9 01          lda #1
000559r 2  8D rr rr       sta PieceDirty
00055Cr 2  A9 02          lda #SFX_ROTATE               ; SPEC 16 effect 2 — both directions, one sound
00055Er 2  4C rr rr       jmp SfxPlay
000561r 2               
000561r 2               PieceRotateBack:
000561r 2  AD rr rr       lda PieceC
000564r 2  AE rr rr       ldx PieceB
000567r 2  8E rr rr       stx PieceC
00056Ar 2  AE rr rr       ldx PieceA
00056Dr 2  8E rr rr       stx PieceB
000570r 2  8D rr rr       sta PieceA
000573r 2  A9 01          lda #1
000575r 2  8D rr rr       sta PieceDirty
000578r 2  A9 02          lda #SFX_ROTATE
00057Ar 2  4C rr rr       jmp SfxPlay
00057Dr 2               
00057Dr 2               ; -----------------------------------------------------------------------------
00057Dr 2               ;   PieceCanFall — is the cell below C free?
00057Dr 2               ;   Out: C set if the piece can descend one row.  Modifies: A, X
00057Dr 2               ;   Three strides past cell A. With C on row 15 that reads row 18, which is a
00057Dr 2               ;   permanent wall row, so the floor needs no special case (SPEC 3.2).
00057Dr 2               ; -----------------------------------------------------------------------------
00057Dr 2               PieceCanFall:
00057Dr 2  20 rr rr       jsr PieceIndex
000580r 2  BD rr rr       lda Board + 3 * BOARD_STRIDE,x
000583r 2  D0 02          bne @No
000585r 2  38             sec
000586r 2  60             rts
000587r 2               @No:
000587r 2  18             clc
000588r 2  60             rts
000589r 2               
000589r 2               ; -----------------------------------------------------------------------------
000589r 2               ;   PieceStep — one row of gravity
000589r 2               ;   Out: C set if the piece has landed and the lock delay should start.
000589r 2               ;        Modifies: A, X
000589r 2               ; -----------------------------------------------------------------------------
000589r 2               PieceStep:
000589r 2  20 rr rr       jsr PieceCanFall
00058Cr 2  90 0B          bcc @Landed
00058Er 2  20 rr rr       jsr RenderPieceErase
000591r 2  EE rr rr       inc PieceRow
000594r 2  20 rr rr       jsr PieceMoved
000597r 2  18             clc                           ; Moved, so it has not landed
000598r 2  60             rts
000599r 2               @Landed:
000599r 2  38             sec
00059Ar 2  60             rts
00059Br 2               
00059Br 2               ; -----------------------------------------------------------------------------
00059Br 2               ;   PieceLock — write the three cells into the board
00059Br 2               ;   Out: nothing.  Modifies: A, X, Y
00059Br 2               ;   SPEC 5.6 — after this the caller runs a cascade.
00059Br 2               ;
00059Br 2               ;   Once the board holds the piece, drawing the piece and drawing those three
00059Br 2               ;   board cells are the same three writes, so RenderPiece does the queueing.
00059Br 2               ; -----------------------------------------------------------------------------
00059Br 2               PieceLock:
00059Br 2  20 rr rr       jsr PieceIndex
00059Er 2  AD rr rr       lda PieceA
0005A1r 2  9D rr rr       sta Board + 0 * BOARD_STRIDE,x
0005A4r 2  AD rr rr       lda PieceB
0005A7r 2  9D rr rr       sta Board + 1 * BOARD_STRIDE,x
0005AAr 2  AD rr rr       lda PieceC
0005ADr 2  9D rr rr       sta Board + 2 * BOARD_STRIDE,x
0005B0r 2               
0005B0r 2  20 rr rr       jsr RenderPiece
0005B3r 2  A9 00          lda #0
0005B5r 2  8D rr rr       sta PieceDirty                ; It is board now; nothing owes it a redraw
0005B8r 2  A9 03          lda #SFX_LOCK                 ; SPEC 16 effect 3. A match in the same frame is
0005BAr 2  4C rr rr       jmp SfxPlay                   ;   louder and takes the channel off it
0005BDr 2                                               ;   (audio.asm)
0005BDr 2               
0005BDr 2               ; -----------------------------------------------------------------------------
0005BDr 2               ;   PieceFallRate — frames per row for this frame
0005BDr 2               ;   Out: A = frame count, C CLEAR if that rate is the soft drop's.
0005BDr 2               ;        Modifies: A, X, Tmp0
0005BDr 2               ;   SPEC 5.5, 11.3 — soft drop substitutes its own rate and is ignored when
0005BDr 2               ;   gravity is already the faster of the two (levels 14+ on NTSC).
0005BDr 2               ;
0005BDr 2               ;   The carry is what pays for the soft drop: SPEC 9.6 gives a point per row
0005BDr 2               ;   "descended under soft drop", and a row that fell at gravity's rate with
0005BDr 2               ;   DOWN held down was not one, so holding DOWN at level 16 earns nothing.
0005BDr 2               ;   Working it out here costs nothing — the comparison has already happened.
0005BDr 2               ; -----------------------------------------------------------------------------
0005BDr 2               PieceFallRate:
0005BDr 2  20 rr rr       jsr ScoreGravity              ; Speed[level] for this region
0005C0r 2  85 rr          sta Tmp0
0005C2r 2  AD rr rr       lda InputNow
0005C5r 2  29 02          and #INPUT_DOWN
0005C7r 2  F0 0A          beq @Gravity
0005C9r 2  AE rr rr       ldx Region
0005CCr 2  BD rr rr       lda SoftDropRate,x
0005CFr 2  C5 rr          cmp Tmp0                      ; C clear = soft drop is the faster
0005D1r 2  90 04          bcc @Soft
0005D3r 2               @Gravity:
0005D3r 2  A5 rr          lda Tmp0
0005D5r 2  38             sec
0005D6r 2  60             rts
0005D7r 2               @Soft:
0005D7r 2  18             clc
0005D8r 2  60             rts
0005D9r 2               
0005D9r 2               ; -----------------------------------------------------------------------------
0005D9r 2               ;   PieceControl — apply this frame's input to the piece
0005D9r 2               ;   Out: C set if a horizontal move succeeded (the caller may reset the lock
0005D9r 2               ;        delay).  Modifies: A, X, Y
0005D9r 2               ;
0005D9r 2               ;   Rotation is edge triggered and never repeats: UP has to be released and
0005D9r 2               ;   pressed again. SPEC 11.3 calls that non-negotiable and it is — a
0005D9r 2               ;   repeating rotate makes a three-cell piece impossible to aim. Left and
0005D9r 2               ;   right go through InputShift, which is where the repeat lives.
0005D9r 2               ; -----------------------------------------------------------------------------
0005D9r 2               PieceControl:
0005D9r 2  AD rr rr       lda InputEdge
0005DCr 2  29 01          and #INPUT_UP
0005DEr 2  F0 03          beq @NoRotate
0005E0r 2  20 rr rr       jsr PieceRotate
0005E3r 2               @NoRotate:
0005E3r 2  AD rr rr       lda InputEdge
0005E6r 2  29 10          and #INPUT_FIRE
0005E8r 2  F0 03          beq @NoBack
0005EAr 2  20 rr rr       jsr PieceRotateBack
0005EDr 2               @NoBack:
0005EDr 2  20 rr rr       jsr InputShift
0005F0r 2  C9 04          cmp #INPUT_LEFT
0005F2r 2  F0 06          beq @Left
0005F4r 2  C9 08          cmp #INPUT_RIGHT
0005F6r 2  F0 05          beq @Right
0005F8r 2  18             clc
0005F9r 2  60             rts
0005FAr 2               @Left:
0005FAr 2  4C rr rr       jmp PieceMoveLeft
0005FDr 2               @Right:
0005FDr 2  4C rr rr       jmp PieceMoveRight
000600r 2               
000600r 1               .include "../src/match.asm"
000600r 2               ; =============================================================================
000600r 2               ;   match.asm — Wizards Lab, the match scanner
000600r 2               ; =============================================================================
000600r 2               ;   SPEC.md section 6. Four passes — horizontal, vertical, and both diagonals —
000600r 2               ;   each walking its axis and tracking a run colour and length. A run of three
000600r 2               ;   or more sets the MARK bit for each of its cells.
000600r 2               ;
000600r 2               ;   Colour comparison is the whole trick:
000600r 2               ;
000600r 2               ;       lda cell
000600r 2               ;       and #COLOR_MASK         ; the low three bits are the glyph, ignore them
000600r 2               ;       cmp ScanColor
000600r 2               ;
000600r 2               ;   which is why a red potion, a red fireball and a red star all match. The
000600r 2               ;   glyph decides what happens on removal, never whether cells match.
000600r 2               ;
000600r 2               ;   Wildcards (SPEC 6.3): a WILD cell continues any run. If the run has no
000600r 2               ;   colour yet it stays unset and is adopted from the first non-wild cell, so
000600r 2               ;   one prism can close a red horizontal run and a blue vertical run at once.
000600r 2               ;
000600r 2               ;   THE FOUR PASSES ARE ONE LOOP. A line is a start cell and a step, and the
000600r 2               ;   step is the only thing that differs: +1 across, +8 down, +9 down-right,
000600r 2               ;   +7 down-left. Every one of them ends on a sentinel rather than on a bounds
000600r 2               ;   check, which is what the 8-byte stride was bought for (SPEC 3.2):
000600r 2               ;
000600r 2               ;     across   from column 5, +1 lands on column 6      — wall
000600r 2               ;     down     from row 15,   +8 lands on row 16        — wall row
000600r 2               ;     down-r   from column 5, +9 lands on row+1 col 6   — wall
000600r 2               ;     down-l   from column 0, +7 lands on THIS row's column 7 — wall
000600r 2               ;
000600r 2               ;   The last one is the reason the left edge needs no test either: the byte
000600r 2               ;   before column 0 belongs to the row above, and it is already a wall.
000600r 2               ; =============================================================================
000600r 2               
000600r 2               ; -----------------------------------------------------------------------------
000600r 2               ;   MatchScan — find every run on the board
000600r 2               ;   In:  nothing
000600r 2               ;   Out: Marks filled, RunCount set, Z set if nothing matched.
000600r 2               ;        Modifies: A, X, Y, Scan*
000600r 2               ; -----------------------------------------------------------------------------
000600r 2               MatchScan:
000600r 2  20 rr rr       jsr MarksClear
000603r 2  A9 00          lda #0
000605r 2  8D rr rr       sta RunCount
000608r 2               
000608r 2  20 rr rr       jsr ScanFindTop               ; Everything below skips the empty air above
00060Br 2  A5 rr          lda ScanTop                   ;   the pile, which on most boards is most of
00060Dr 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE) ;   the board
00060Fr 2  B0 0C          bcs @Done                     ; Nothing on the board at all
000611r 2               
000611r 2  20 rr rr       jsr MatchScanHorizontal
000614r 2  20 rr rr       jsr MatchScanVertical
000617r 2  20 rr rr       jsr MatchScanDiagonal
00061Ar 2  20 rr rr       jsr MatchScanAntiDiagonal
00061Dr 2               @Done:
00061Dr 2  AD rr rr       lda RunCount                  ; Z set when nothing matched
000620r 2  60             rts
000621r 2               
000621r 2               ; -----------------------------------------------------------------------------
000621r 2               ;   ScanFindTop — board index of the first row that holds anything
000621r 2               ;   Out: ScanTop = row base, or BOARD_H * BOARD_STRIDE if the board is empty.
000621r 2               ;        Modifies: A, X, ScanTop
000621r 2               ;
000621r 2               ;   Every pass below starts here instead of at row 0. A pile six rows deep is
000621r 2               ;   scanned as six rows: 178 cells against 448, and the four passes come in
000621r 2               ;   under a third of the frame instead of over two whole ones. Finding it costs
000621r 2               ;   about 45 cycles a row of empty air, which is the cheapest part of the scan.
000621r 2               ;
000621r 2               ;   Correct as well as quick, and for a reason worth writing down: a line that
000621r 2               ;   reaches the pile at all must CROSS the pile's top row, because every one of
000621r 2               ;   the four steps moves down at most one row at a time. Starting the diagonals
000621r 2               ;   on that row rather than on row 0 therefore misses nothing.
000621r 2               ; -----------------------------------------------------------------------------
000621r 2               ScanFindTop:
000621r 2  A2 00          ldx #0
000623r 2               @Row:
000623r 2  BD rr rr       lda Board + 0,x               ; The six playfield columns; the two sentinel
000626r 2  1D rr rr       ora Board + 1,x               ;   ones would make every row look occupied
000629r 2  1D rr rr       ora Board + 2,x
00062Cr 2  1D rr rr       ora Board + 3,x
00062Fr 2  1D rr rr       ora Board + 4,x
000632r 2  1D rr rr       ora Board + 5,x
000635r 2  D0 09          bne @Found
000637r 2  8A             txa
000638r 2  18             clc
000639r 2  69 08          adc #BOARD_STRIDE
00063Br 2  AA             tax
00063Cr 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
00063Er 2  90 E3          bcc @Row
000640r 2               @Found:
000640r 2  86 rr          stx ScanTop
000642r 2  60             rts
000643r 2               
000643r 2               ; -----------------------------------------------------------------------------
000643r 2               ;   The four passes (SPEC 6.2). Each sets a step and hands ScanLine its start
000643r 2               ;   cells; the start cell rides the stack because ScanLine needs both index
000643r 2               ;   registers and the scratch bytes below it.
000643r 2               ; -----------------------------------------------------------------------------
000643r 2               MatchScanHorizontal:            ; Every row of the pile, column 0 rightward
000643r 2  A9 01          lda #1
000645r 2  85 rr          sta ScanStep
000647r 2  A5 rr          lda ScanTop
000649r 2               @Line:
000649r 2  48             pha
00064Ar 2  20 rr rr       jsr ScanLine
00064Dr 2  68             pla
00064Er 2  18             clc
00064Fr 2  69 08          adc #BOARD_STRIDE
000651r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000653r 2  90 F4          bcc @Line
000655r 2  60             rts
000656r 2               
000656r 2               MatchScanVertical:              ; 6 columns, top of the pile downward
000656r 2  A9 08          lda #BOARD_STRIDE
000658r 2  85 rr          sta ScanStep
00065Ar 2  4C rr rr       jmp ScanTopRow
00065Dr 2               
00065Dr 2               MatchScanDiagonal:              ; down-right: the top row, then the left edge
00065Dr 2  A9 09          lda #(BOARD_STRIDE + 1)
00065Fr 2  85 rr          sta ScanStep
000661r 2  20 rr rr       jsr ScanTopRow
000664r 2  A9 00          lda #0
000666r 2  4C rr rr       jmp ScanEdgeColumn
000669r 2               
000669r 2               MatchScanAntiDiagonal:          ; down-left: the top row, then the right edge
000669r 2  A9 07          lda #(BOARD_STRIDE - 1)
00066Br 2  85 rr          sta ScanStep
00066Dr 2  20 rr rr       jsr ScanTopRow
000670r 2  A9 05          lda #(BOARD_W - 1)
000672r 2  4C rr rr       jmp ScanEdgeColumn
000675r 2               
000675r 2               ; -----------------------------------------------------------------------------
000675r 2               ;   ScanTopRow — scan a line from each of the six cells of the pile's top row
000675r 2               ;   ScanEdgeColumn — and from the rows below it, in the column in A
000675r 2               ;   In:  ScanStep set, ScanTop set; A = column (ScanEdgeColumn only)
000675r 2               ;
000675r 2               ;   Between them those are every start cell a diagonal needs, and the top row
000675r 2               ;   alone is every start cell the vertical pass needs. The top row is scanned
000675r 2               ;   by the first, so the second skips it rather than scanning the longest
000675r 2               ;   diagonal twice.
000675r 2               ; -----------------------------------------------------------------------------
000675r 2               ScanTopRow:
000675r 2  A5 rr          lda ScanTop
000677r 2               @Line:
000677r 2  48             pha
000678r 2  20 rr rr       jsr ScanLine
00067Br 2  68             pla
00067Cr 2  18             clc
00067Dr 2  69 01          adc #1
00067Fr 2  48             pha                           ; Six columns of that row, whichever row it
000680r 2  29 07          and #(BOARD_STRIDE - 1)       ;   is, so it is the COLUMN that ends the loop
000682r 2  C9 06          cmp #BOARD_W                  ;   and not the index
000684r 2  68             pla                           ; PLA leaves C alone
000685r 2  90 F0          bcc @Line
000687r 2  60             rts
000688r 2               
000688r 2               ScanEdgeColumn:
000688r 2  18             clc
000689r 2  65 rr          adc ScanTop                   ; That column, on the pile's top row...
00068Br 2  18             clc
00068Cr 2  69 08          adc #BOARD_STRIDE             ;   ...and then the row below it
00068Er 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000690r 2  B0 0C          bcs @Done                     ; The pile is one row deep — there is no below
000692r 2               @Line:
000692r 2  48             pha
000693r 2  20 rr rr       jsr ScanLine
000696r 2  68             pla
000697r 2  18             clc
000698r 2  69 08          adc #BOARD_STRIDE
00069Ar 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
00069Cr 2  90 F4          bcc @Line
00069Er 2               @Done:
00069Er 2  60             rts
00069Fr 2               
00069Fr 2               ; -----------------------------------------------------------------------------
00069Fr 2               ;   ScanLine — walk one line, marking every run of MATCH_MIN or more
00069Fr 2               ;   In:  A = start board index, ScanStep = direction
00069Fr 2               ;   Out: nothing.  Modifies: A, X, Scan*, Marks, RunCount
00069Fr 2               ;
00069Fr 2               ;   ONLY A WALL ENDS THE LINE. A hole in the middle of a row breaks the run
00069Fr 2               ;   and the walk carries on past it, because the cells beyond it are a run of
00069Fr 2               ;   their own — a line that stopped at the first empty cell would never look
00069Fr 2               ;   below the top of the pile at all, which is very nearly the whole board.
00069Fr 2               ;
00069Fr 2               ;   A colour change ends the run and starts a new one at the cell that broke
00069Fr 2               ;   it — the cell that broke a red run is the first cell of the blue one, and
00069Fr 2               ;   any prisms that were riding the red run stay with the red run. SPEC 6.3
00069Fr 2               ;   gives a wildcard to the run it is already in, not to both.
00069Fr 2               ; -----------------------------------------------------------------------------
00069Fr 2               ScanLine:
00069Fr 2  AA             tax                           ; The cursor lives in X for the whole line:
0006A0r 2  A9 FF          lda #$FF                      ;   this loop runs about four hundred times a
0006A2r 2  85 rr          sta ScanColor                 ;   scan and every cycle in it is four hundred
0006A4r 2  A9 00          lda #0                        ;   cycles of the frame
0006A6r 2  85 rr          sta ScanLen
0006A8r 2               
0006A8r 2               @Cell:
0006A8r 2  BD rr rr       lda Board,x
0006ABr 2  F0 41          beq @Gap                      ; A hole breaks the run, not the line
0006ADr 2  C9 FF          cmp #TILE_WALL
0006AFr 2  F0 52          beq @End                      ; A wall is where the line stops
0006B1r 2  29 F8          and #COLOR_MASK               ; The colour key, glyph discarded (SPEC 4.2)
0006B3r 2  C5 rr          cmp ScanColor
0006B5r 2  F0 19          beq @Grow                     ; Same colour — the commonest case, first
0006B7r 2  C9 70          cmp #WILD_BASE
0006B9r 2  F0 15          beq @Grow                     ; A prism continues any run (SPEC 6.3)
0006BBr 2               
0006BBr 2  A8             tay                           ; A different colour. Park it: everything
0006BCr 2  A5 rr          lda ScanColor                 ;   below either adopts it or starts a run
0006BEr 2  30 0E          bmi @Adopt                    ;   with it. $FF is the only value here with
0006C0r 2                                               ;   bit 7 set — colours are $40 to $70
0006C0r 2  A5 rr          lda ScanLen
0006C2r 2  C9 03          cmp #MATCH_MIN
0006C4r 2  B0 14          bcs @Close                    ; The run it broke was long enough to mark
0006C6r 2               
0006C6r 2  84 rr          sty ScanColor                 ; It was not, so no call and no marking: this
0006C8r 2  A9 01          lda #1                        ;   cell is simply the start of the next run.
0006CAr 2  85 rr          sta ScanLen                   ;   Five adjacent cells in six differ in
0006CCr 2  D0 04          bne @Advance                  ;   colour, so this is the path that decides
0006CEr 2                                               ;   what a scan costs
0006CEr 2               @Adopt:
0006CEr 2  84 rr          sty ScanColor
0006D0r 2               @Grow:
0006D0r 2  E6 rr          inc ScanLen
0006D2r 2               @Advance:
0006D2r 2  8A             txa
0006D3r 2  18             clc
0006D4r 2  65 rr          adc ScanStep
0006D6r 2  AA             tax
0006D7r 2  4C rr rr       jmp @Cell
0006DAr 2               
0006DAr 2               @Close:
0006DAr 2  86 rr          stx ScanIdx
0006DCr 2  20 rr rr       jsr MatchEmit                 ; Mark it — and MatchEmit leaves ScanLen zero
0006DFr 2  A6 rr          ldx ScanIdx
0006E1r 2  BD rr rr       lda Board,x
0006E4r 2  29 F8          and #COLOR_MASK
0006E6r 2  85 rr          sta ScanColor
0006E8r 2  A9 01          lda #1
0006EAr 2  85 rr          sta ScanLen
0006ECr 2  D0 E4          bne @Advance                  ; Always
0006EEr 2               
0006EEr 2               @Gap:
0006EEr 2  A5 rr          lda ScanLen
0006F0r 2  F0 E0          beq @Advance                  ; Nothing running — step over the hole. This
0006F2r 2                                               ;   is the cell the scan meets most often, so
0006F2r 2                                               ;   it is the one that must not call anything
0006F2r 2  86 rr          stx ScanIdx
0006F4r 2  20 rr rr       jsr MatchEmit                 ; Close the run the hole broke...
0006F7r 2  A6 rr          ldx ScanIdx
0006F9r 2  A9 FF          lda #$FF
0006FBr 2  85 rr          sta ScanColor                 ;   ...and start again on the far side of it
0006FDr 2  A9 00          lda #0
0006FFr 2  85 rr          sta ScanLen
000701r 2  F0 CF          beq @Advance                  ; Always
000703r 2               
000703r 2               @End:
000703r 2  A5 rr          lda ScanLen
000705r 2  F0 05          beq @Nothing                  ; The line ran out with nothing in hand
000707r 2  86 rr          stx ScanIdx
000709r 2  4C rr rr       jmp MatchEmit                 ; Whatever was running ends with the line
00070Cr 2               @Nothing:
00070Cr 2  60             rts
00070Dr 2               
00070Dr 2               ; -----------------------------------------------------------------------------
00070Dr 2               ;   MatchEmit — a run has ended; mark it if it was long enough
00070Dr 2               ;   In:  ScanIdx = one cell PAST the run's last, ScanLen, ScanColor, ScanStep
00070Dr 2               ;   Out: nothing.  Modifies: A, X, Y, ScanEnd, ScanLen, RunCount, Marks
00070Dr 2               ;
00070Dr 2               ;   Runs are marked, not removed: a cell can be in a horizontal run and a
00070Dr 2               ;   vertical one at once, and it clears once while both runs score (SPEC 6.1).
00070Dr 2               ;   The union is what the MARKS bitmap is for.
00070Dr 2               ;
00070Dr 2               ;   SCORING HAPPENS HERE, before the mark loop and for the same reason the
00070Dr 2               ;   comment above used to promise it would: ScanLen still describes the run at
00070Dr 2               ;   this point and nowhere else, because the mark loop counts it down to zero
00070Dr 2               ;   on its way back along the line. MatchScoreRun leaves it alone.
00070Dr 2               ; -----------------------------------------------------------------------------
00070Dr 2               MatchEmit:
00070Dr 2  A5 rr          lda ScanLen
00070Fr 2  C9 03          cmp #MATCH_MIN
000711r 2  90 1D          bcc @Done                     ; Two in a row is not a run
000713r 2               
000713r 2  EE rr rr       inc RunCount
000716r 2  20 rr rr       jsr MatchScoreRun             ; SPEC 8 step 2, per run
000719r 2  A5 rr          lda ScanIdx
00071Br 2  38             sec
00071Cr 2  E5 rr          sbc ScanStep                  ; Back onto the run's last cell
00071Er 2  85 rr          sta ScanEnd
000720r 2               @Mark:
000720r 2  A5 rr          lda ScanEnd
000722r 2  20 rr rr       jsr MarkSet
000725r 2  A5 rr          lda ScanEnd
000727r 2  38             sec
000728r 2  E5 rr          sbc ScanStep
00072Ar 2  85 rr          sta ScanEnd
00072Cr 2  C6 rr          dec ScanLen
00072Er 2  D0 F0          bne @Mark
000730r 2               @Done:
000730r 2  60             rts
000731r 2               
000731r 2               ; -----------------------------------------------------------------------------
000731r 2               ;   MatchScoreRun — the two per-run awards of SPEC 8 step 2
000731r 2               ;   In:  ScanLen = run length, ChainStep = the cascade step this is
000731r 2               ;   Out: nothing.  Modifies: A, X, Y.  Leaves ScanLen and ScanColor alone.
000731r 2               ;
000731r 2               ;       cascade_pts += length * TileValue[chain]
000731r 2               ;       cascade_pts += LengthBonus[length]
000731r 2               ;
000731r 2               ;   A cell in a horizontal run AND a vertical one is scored by both, and
000731r 2               ;   removed once (SPEC 6.1) — which is why this is per run and not per marked
000731r 2               ;   cell, and why it runs before the union in MARKS has anything to say.
000731r 2               ;
000731r 2               ;   MultiBonus is NOT here: it is per step, not per run, and CascadeScan adds
000731r 2               ;   it once the four passes have finished counting.
000731r 2               ; -----------------------------------------------------------------------------
000731r 2               MatchScoreRun:
000731r 2  AE rr rr       ldx ChainStep
000734r 2  CA             dex                           ; TileValue is indexed by chain - 1 ...
000735r 2  E0 08          cpx #8
000737r 2  90 02          bcc @Chain
000739r 2  A2 07          ldx #7                        ;   ... and flattens out at 8 (SPEC 9.1)
00073Br 2               @Chain:
00073Br 2  A4 rr          ldy ScanLen                   ; The multiply is Y additions (score.asm)
00073Dr 2  BD rr rr       lda TileValueLo,x
000740r 2  48             pha
000741r 2  BD rr rr       lda TileValueHi,x
000744r 2  AA             tax
000745r 2  68             pla
000746r 2  20 rr rr       jsr CascadeAddTimes
000749r 2               
000749r 2  A6 rr          ldx ScanLen
00074Br 2  CA             dex
00074Cr 2  CA             dex
00074Dr 2  CA             dex                           ; LengthBonus is indexed by length - 3 ...
00074Er 2  E0 05          cpx #5
000750r 2  90 02          bcc @Length
000752r 2  A2 04          ldx #4                        ;   ... and flattens out at 7 (SPEC 9.3). A
000754r 2               @Length:                        ;   vertical run can be all sixteen rows long
000754r 2  BD rr rr       lda LengthBonusLo,x
000757r 2  48             pha
000758r 2  BD rr rr       lda LengthBonusHi,x
00075Br 2  AA             tax
00075Cr 2  68             pla
00075Dr 2  4C rr rr       jmp CascadeAdd
000760r 2               
000760r 2               ; -----------------------------------------------------------------------------
000760r 2               ;   MarksClear / MarkSet / MarkTest — the 16-byte bitmap
000760r 2               ;   One byte per row, bits 0-5 = columns 0-5. Union of runs is a free ORA.
000760r 2               ;
000760r 2               ;   MarkBits has eight entries rather than six so that the two sentinel
000760r 2               ;   columns index it harmlessly: bits 6 and 7 of a Marks byte are never set,
000760r 2               ;   so a walk over the whole 8-byte stride can test every cell it meets
000760r 2               ;   without first asking whether the cell is a wall.
000760r 2               ; -----------------------------------------------------------------------------
000760r 2               MarkBits:
000760r 2  01 02 04 08    .byte $01, $02, $04, $08, $10, $20, $40, $80
000764r 2  10 20 40 80  
000768r 2               
000768r 2               MarksClear:
000768r 2  A9 00          lda #0
00076Ar 2  A2 00          ldx #0
00076Cr 2               @Row:
00076Cr 2  9D rr rr       sta Marks,x
00076Fr 2  E8             inx
000770r 2  E0 10          cpx #MARKS_BYTES
000772r 2  D0 F8          bne @Row
000774r 2  60             rts
000775r 2               
000775r 2               MarkSet:                        ; In: A = board index.  Modifies: A, X, Y
000775r 2  AA             tax
000776r 2  29 07          and #(BOARD_STRIDE - 1)
000778r 2  A8             tay                           ; Y = column
000779r 2  8A             txa
00077Ar 2  4A             lsr a
00077Br 2  4A             lsr a
00077Cr 2  4A             lsr a
00077Dr 2  AA             tax                           ; X = row
00077Er 2  BD rr rr       lda Marks,x
000781r 2  19 rr rr       ora MarkBits,y
000784r 2  9D rr rr       sta Marks,x
000787r 2  60             rts
000788r 2               
000788r 2               MarkTest:                       ; In: A = board index.  Out: C set if marked
000788r 2  AA             tax                           ;     Modifies: A, X, Y
000789r 2  29 07          and #(BOARD_STRIDE - 1)
00078Br 2  A8             tay
00078Cr 2  8A             txa
00078Dr 2  4A             lsr a
00078Er 2  4A             lsr a
00078Fr 2  4A             lsr a
000790r 2  AA             tax
000791r 2  BD rr rr       lda Marks,x
000794r 2  39 rr rr       and MarkBits,y
000797r 2  F0 02          beq @No
000799r 2  38             sec
00079Ar 2  60             rts
00079Br 2               @No:
00079Br 2  18             clc
00079Cr 2  60             rts
00079Dr 2               
00079Dr 1               .include "../src/cascade.asm"
00079Dr 2               ; =============================================================================
00079Dr 2               ;   cascade.asm — Wizards Lab, clear resolution
00079Dr 2               ; =============================================================================
00079Dr 2               ;   SPEC.md section 8. A cascade runs from the moment a piece locks until no
00079Dr 2               ;   further matches exist, one step per iteration, with ChainStep counting the
00079Dr 2               ;   steps. The step order is fixed:
00079Dr 2               ;
00079Dr 2               ;       scan -> score matches -> enqueue reagents -> resolve queue
00079Dr 2               ;            -> animate -> remove -> level check -> gravity -> repeat
00079Dr 2               ;
00079Dr 2               ;   The effect queue always drains. Effects only ever remove tiles, never add
00079Dr 2               ;   them, and each cell can be marked at most once, so the queue is bounded by
00079Dr 2               ;   the 96 cells of the playfield.
00079Dr 2               ; =============================================================================
00079Dr 2               
00079Dr 2               ; -----------------------------------------------------------------------------
00079Dr 2               ;   CascadeBegin — called immediately after PieceLock
00079Dr 2               ;   Out: nothing.  Modifies: A
00079Dr 2               ; -----------------------------------------------------------------------------
00079Dr 2               CascadeBegin:
00079Dr 2  A9 01          lda #1
00079Fr 2  8D rr rr       sta ChainStep                 ; The step about to run is step 1 (SPEC 8)
0007A2r 2  A9 00          lda #0
0007A4r 2  8D rr rr       sta CascadeLo
0007A7r 2  8D rr rr       sta CascadeMid
0007AAr 2  8D rr rr       sta CascadeHi
0007ADr 2  8D rr rr       sta StarCount
0007B0r 2  8D rr rr       sta RunCount
0007B3r 2  4C rr rr       jmp EffectQClear
0007B6r 2               
0007B6r 2               ; -----------------------------------------------------------------------------
0007B6r 2               ;   CascadeScan — steps 1 to 4: find the runs, score them, fire the reagents
0007B6r 2               ;   In:  nothing
0007B6r 2               ;   Out: C set if anything is marked and the step has something to animate.
0007B6r 2               ;        C clear when nothing matched and the cascade has settled.
0007B6r 2               ;        Modifies: A, X, Y, Scan*, Marks, RunCount, Cascade*, StarCount
0007B6r 2               ;
0007B6r 2               ;   Steps 3 and 4 are the reagents, and they run between the scan and the
0007B6r 2               ;   removal because everything they do is add cells to Marks: by the time
0007B6r 2               ;   CascadeRemove walks the bitmap it cannot tell a cell the scan found from
0007B6r 2               ;   a cell a fireball took, and does not need to.
0007B6r 2               ;
0007B6r 2               ;   NOTHING HAS LEFT THE BOARD WHEN THIS RETURNS. Step 5 — the glow and the
0007B6r 2               ;   shatter (anim.asm) — happens between here and CascadeFinish below, over
0007B6r 2               ;   several frames, and it can only draw a cell's own colour and its own
0007B6r 2               ;   reagent because the cell is still sitting there saying what it is. That
0007B6r 2               ;   split is what the whole of P6 rests on, and it is the same property that
0007B6r 2               ;   let P5 make an effect queue entry one byte.
0007B6r 2               ;
0007B6r 2               ;   Step 2's per-run half is in MatchEmit, which is the one moment a run's
0007B6r 2               ;   length and colour are both in hand; what is left of it here is the bonus
0007B6r 2               ;   for having found several at once, which nothing knows until all four
0007B6r 2               ;   passes have finished.
0007B6r 2               ; -----------------------------------------------------------------------------
0007B6r 2               CascadeScan:
0007B6r 2  20 rr rr       jsr MatchScan
0007B9r 2  F0 1E          beq @Settled                  ; RunCount is zero — nothing left to clear
0007BBr 2               
0007BBr 2  AE rr rr       ldx RunCount                  ; SPEC 8 step 2, last line, and SPEC 9.4
0007BEr 2  CA             dex                           ; MultiBonus is indexed by runs - 1 ...
0007BFr 2  E0 05          cpx #5
0007C1r 2  90 02          bcc @Multi
0007C3r 2  A2 04          ldx #4                        ;   ... and flattens out at 5
0007C5r 2               @Multi:
0007C5r 2  BD rr rr       lda MultiBonusLo,x
0007C8r 2  48             pha
0007C9r 2  BD rr rr       lda MultiBonusHi,x
0007CCr 2  AA             tax
0007CDr 2  68             pla
0007CEr 2  20 rr rr       jsr CascadeAdd
0007D1r 2               
0007D1r 2  20 rr rr       jsr EffectEnqueueMarked       ; SPEC 8 step 3
0007D4r 2  20 rr rr       jsr EffectResolve             ; SPEC 8 step 4
0007D7r 2  38             sec
0007D8r 2  60             rts
0007D9r 2               @Settled:
0007D9r 2  18             clc
0007DAr 2  60             rts
0007DBr 2               
0007DBr 2               ; -----------------------------------------------------------------------------
0007DBr 2               ;   CascadeFinish — steps 6 and 7, once the animation has finished with them
0007DBr 2               ;   In:  Marks, as CascadeScan left it
0007DBr 2               ;   Out: nothing.  Modifies: A, X, Y, CellCount, Board, Level
0007DBr 2               ; -----------------------------------------------------------------------------
0007DBr 2               CascadeFinish:
0007DBr 2  20 rr rr       jsr CascadeRemove             ; SPEC 8 step 6
0007DEr 2  A5 rr          lda CellCount
0007E0r 2  4C rr rr       jmp ScoreLevelCheck           ; SPEC 8 step 7 — match and effect removals
0007E3r 2                                               ;   both count, and by here they are the same
0007E3r 2                                               ;   cells
0007E3r 2               
0007E3r 2               ; -----------------------------------------------------------------------------
0007E3r 2               ;   CascadeRemove — empty every marked cell and queue it for redraw
0007E3r 2               ;   In:  Marks
0007E3r 2               ;   Out: CellCount = cells removed.  Modifies: A, X, Y, CellCount, RedrawCol
0007E3r 2               ;   SPEC 8 step 6.
0007E3r 2               ;
0007E3r 2               ;   Every marked cell is zeroed in one go, because the gravity that follows
0007E3r 2               ;   needs a board that is finished changing. Only the REDRAW is rationed: at
0007E3r 2               ;   most 96 cells can be marked and the dirty ring holds 64, and P5 made that
0007E3r 2               ;   reachable — a bolt is 21 cells on its own and a chain of them is most of
0007E3r 2               ;   the well. A mark dropped by a full ring is never made again (D6), so
0007E3r 2               ;   rather than drop one this falls back to RenderBoard, the whole-well cursor
0007E3r 2               ;   RenderFlush already feeds a frame at a time (D12). Four frames of redraw
0007E3r 2               ;   instead of a hole in the screen, and only on the rare huge step: a plain
0007E3r 2               ;   three-in-a-row never comes near the cap.
0007E3r 2               ;
0007E3r 2               ;   CellCount goes to ScoreLevelCheck — thirty cleared tiles is a level
0007E3r 2               ;   (SPEC 10.1). By the time this runs the cells have already glowed and
0007E3r 2               ;   shattered (anim.asm); what it draws over them is the empty well behind.
0007E3r 2               ; -----------------------------------------------------------------------------
0007E3r 2               CascadeRemove:
0007E3r 2  A9 00          lda #0
0007E5r 2  85 rr          sta CellCount
0007E7r 2  AA             tax                           ; X = board index, walked a row at a time
0007E8r 2               @Row:
0007E8r 2  8A             txa
0007E9r 2  4A             lsr a
0007EAr 2  4A             lsr a
0007EBr 2  4A             lsr a
0007ECr 2  A8             tay
0007EDr 2  B9 rr rr       lda Marks,y
0007F0r 2  F0 38          beq @NextRow                  ; Nothing marked in this row, and most rows
0007F2r 2                                               ;   hold nothing marked
0007F2r 2               @Cell:
0007F2r 2  8A             txa
0007F3r 2  48             pha
0007F4r 2  20 rr rr       jsr MarkTest
0007F7r 2  68             pla
0007F8r 2  AA             tax                           ; MarkTest needs X, so the cursor comes back
0007F9r 2  90 1F          bcc @NextCell                 ;   through A. Neither PLA nor TAX touches C.
0007FBr 2  A9 00          lda #TILE_EMPTY
0007FDr 2  9D rr rr       sta Board,x
000800r 2  E6 rr          inc CellCount
000802r 2               
000802r 2  AD rr rr       lda DirtyCount                ; Room to mark this one?
000805r 2  C9 40          cmp #DIRTY_ENTRIES
000807r 2  B0 0A          bcs @Bulk                     ; No — redraw the lot instead of losing it
000809r 2  8A             txa
00080Ar 2  48             pha
00080Br 2  20 rr rr       jsr RenderCell
00080Er 2  68             pla
00080Fr 2  AA             tax
000810r 2  4C rr rr       jmp @NextCell
000813r 2               @Bulk:
000813r 2  8A             txa
000814r 2  48             pha
000815r 2  20 rr rr       jsr RenderBoard               ; Sets the cursor and nothing else, so the
000818r 2  68             pla                           ;   cells already queued still land and the
000819r 2  AA             tax                           ;   redraw overwrites them with the same values
00081Ar 2               @NextCell:
00081Ar 2  E8             inx
00081Br 2  8A             txa
00081Cr 2  29 07          and #(BOARD_STRIDE - 1)
00081Er 2  C9 06          cmp #BOARD_W
000820r 2  90 D0          bcc @Cell
000822r 2               
000822r 2  8A             txa                           ; X is on the row's first sentinel column;
000823r 2  18             clc                           ;   step over both of them
000824r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000826r 2  AA             tax
000827r 2  4C rr rr       jmp @Test
00082Ar 2               
00082Ar 2               @NextRow:
00082Ar 2  8A             txa
00082Br 2  18             clc
00082Cr 2  69 08          adc #BOARD_STRIDE
00082Er 2  AA             tax
00082Fr 2               @Test:
00082Fr 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
000831r 2  90 B5          bcc @Row
000833r 2  60             rts
000834r 2               
000834r 2               ; -----------------------------------------------------------------------------
000834r 2               ;   CascadeSettle — apply the star multiplier and bank the points
000834r 2               ;   SPEC 8 SETTLE, SPEC 9.6 — the doubling covers the WHOLE cascade, including
000834r 2               ;   points scored before the star cleared.
000834r 2               ; -----------------------------------------------------------------------------
000834r 2               CascadeSettle:
000834r 2  AD rr rr       lda StarCount
000837r 2  C9 03          cmp #STAR_SHIFT_CAP
000839r 2  90 02          bcc @Shift
00083Br 2  A9 03          lda #STAR_SHIFT_CAP           ; x8 and no further, however many were caught
00083Dr 2               @Shift:
00083Dr 2  AA             tax
00083Er 2  F0 06          beq @Bank
000840r 2               @Double:
000840r 2  20 rr rr       jsr CascadeDouble             ; A doubling in BCD is one self-addition
000843r 2  CA             dex
000844r 2  D0 FA          bne @Double
000846r 2               @Bank:
000846r 2  4C rr rr       jmp ScoreAdd                  ; Its carry is not read: ScoreHighCheck has
000849r 2                                               ;   already raised the fanfare and the flash
000849r 2                                               ;   itself, and does so exactly once
000849r 2               
000849r 2               
000849r 2               ; =============================================================================
000849r 2               ;   The reagents (SPEC 7)
000849r 2               ; =============================================================================
000849r 2               ;   Steps 3 and 4 of SPEC 8, and the five effects between them. The shape is:
000849r 2               ;
000849r 2               ;     EffectEnqueueMarked   walks MARKS once the scan has finished, and offers
000849r 2               ;                           every matched cell to EffectEnqueue
000849r 2               ;     EffectEnqueue         decides what a cell being removed is worth — a
000849r 2               ;                           prism pays, a star counts, a fireball/bolt/bomb
000849r 2               ;                           queues
000849r 2               ;     EffectResolve         drains the queue, detonating each in turn
000849r 2               ;     EffectFireball/Bolt/  list the cells a detonation reaches, and offer each
000849r 2               ;       Bomb                one to EffectHit
000849r 2               ;     EffectHit             marks it, scores it, and offers it to
000849r 2               ;                           EffectEnqueue in its turn — which is the whole of
000849r 2               ;                           SPEC 7.2's chain reaction, in one routine
000849r 2               ;
000849r 2               ;   TERMINATION IS STRUCTURAL, not a limit. An effect only ever MARKS cells and
000849r 2               ;   never adds one, and EffectHit refuses a cell that is already marked, so a
000849r 2               ;   cell can be pushed at most once and the loop is bounded by the 96 cells of
000849r 2               ;   the well.
000849r 2               ;
000849r 2               ;   Nothing here touches the board. Marked cells are still sitting there,
000849r 2               ;   readable, until CascadeRemove zeroes them in step 6 — which is what lets a
000849r 2               ;   queue entry be a board index and nothing else (constants.inc).
000849r 2               ; =============================================================================
000849r 2               
000849r 2               ; -----------------------------------------------------------------------------
000849r 2               ;   EffectEnqueueMarked — SPEC 8 step 3
000849r 2               ;   In:  Marks, as MatchScan left it
000849r 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectQ, StarCount, Cascade*
000849r 2               ;
000849r 2               ;   Nothing called from here marks anything, so the bitmap being walked cannot
000849r 2               ;   change underneath the walk. Step 4 is where marking starts, and the cells
000849r 2               ;   it marks enqueue themselves as they are marked (EffectHit) rather than
000849r 2               ;   waiting for a second pass over MARKS.
000849r 2               ;
000849r 2               ;   It has to be a pass over the union rather than part of MatchEmit's mark
000849r 2               ;   loop: a cell in a horizontal run AND a vertical one is marked twice and
000849r 2               ;   would then detonate twice (SPEC 6.1).
000849r 2               ; -----------------------------------------------------------------------------
000849r 2               EffectEnqueueMarked:
000849r 2  A9 00          lda #0
00084Br 2  85 rr          sta EffectIdx
00084Dr 2               @Row:
00084Dr 2  A5 rr          lda EffectIdx
00084Fr 2  4A             lsr a
000850r 2  4A             lsr a
000851r 2  4A             lsr a
000852r 2  A8             tay
000853r 2  B9 rr rr       lda Marks,y
000856r 2  F0 20          beq @NextRow                  ; Nothing marked in this row, which is most
000858r 2                                               ;   rows of most steps
000858r 2               @Cell:
000858r 2  A5 rr          lda EffectIdx
00085Ar 2  20 rr rr       jsr MarkTest
00085Dr 2  90 05          bcc @NextCell
00085Fr 2  A6 rr          ldx EffectIdx
000861r 2  20 rr rr       jsr EffectEnqueue
000864r 2               @NextCell:
000864r 2  E6 rr          inc EffectIdx
000866r 2  A5 rr          lda EffectIdx
000868r 2  29 07          and #(BOARD_STRIDE - 1)
00086Ar 2  C9 06          cmp #BOARD_W
00086Cr 2  90 EA          bcc @Cell
00086Er 2               
00086Er 2  A5 rr          lda EffectIdx                 ; On the row's first sentinel column; step
000870r 2  18             clc                           ;   over both of them
000871r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000873r 2  85 rr          sta EffectIdx
000875r 2  4C rr rr       jmp @Test
000878r 2               
000878r 2               @NextRow:
000878r 2  A5 rr          lda EffectIdx
00087Ar 2  18             clc
00087Br 2  69 08          adc #BOARD_STRIDE
00087Dr 2  85 rr          sta EffectIdx
00087Fr 2               @Test:
00087Fr 2  A5 rr          lda EffectIdx
000881r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000883r 2  90 C8          bcc @Row
000885r 2  60             rts
000886r 2               
000886r 2               ; -----------------------------------------------------------------------------
000886r 2               ;   EffectEnqueue — a marked cell is going; make what it holds count
000886r 2               ;   In:  X = board index of a cell that is ALREADY marked
000886r 2               ;   Out: nothing.  Modifies: A, X, Y
000886r 2               ;
000886r 2               ;   Called exactly once per removed cell — from step 3 for the cells the scan
000886r 2               ;   found, and from EffectHit for every cell an effect takes. Three outcomes:
000886r 2               ;
000886r 2               ;     a prism   pays BONUS_PRISM here and now and is never queued: it has no
000886r 2               ;               effect to fire, only a bonus (SPEC 7.3)
000886r 2               ;     a star    counts into StarCount and is never queued either — SPEC 8
000886r 2               ;               step 3 is explicit that stars are counted, not queued
000886r 2               ;     the rest  go on the queue, and pay their trigger bonus when they pop
000886r 2               ;
000886r 2               ;   THE COLOUR IS TESTED BEFORE THE GLYPH, and that order is not cosmetic. A
000886r 2               ;   prism is glyph 0 of colour 6, indistinguishable from a plain potion by its
000886r 2               ;   glyph alone — and from P6 onward the board may hold any of the prism's four
000886r 2               ;   idle rotation frames, whose low three bits read as a bolt or a bomb and
000886r 2               ;   would detonate one. Colour 6 is the only test that stays true.
000886r 2               ; -----------------------------------------------------------------------------
000886r 2               EffectEnqueue:
000886r 2  BD rr rr       lda Board,x
000889r 2  29 F8          and #COLOR_MASK
00088Br 2  C9 70          cmp #WILD_BASE
00088Dr 2  F0 12          beq @Prism
00088Fr 2  BD rr rr       lda Board,x
000892r 2  29 07          and #GLYPH_MASK
000894r 2  F0 0A          beq @Done                     ; A plain potion, which is most of the board
000896r 2  C9 04          cmp #GLYPH_STAR
000898r 2  F0 0A          beq @Star
00089Ar 2  B0 04          bcs @Done                     ; Glyphs 5-7 are animation frames (SPEC 4.4),
00089Cr 2                                               ;   never reagents
00089Cr 2  8A             txa
00089Dr 2  4C rr rr       jmp EffectQPush               ; Fireball, bolt or bomb — glyphs 1 to 3
0008A0r 2               @Done:
0008A0r 2  60             rts
0008A1r 2               @Prism:
0008A1r 2  4C rr rr       jmp EffectPrism               ; Both of these are the far side of the three
0008A4r 2               @Star:                          ;   detonations below, well out of branch range
0008A4r 2  4C rr rr       jmp EffectStar
0008A7r 2               
0008A7r 2               ; -----------------------------------------------------------------------------
0008A7r 2               ;   EffectHit — one cell of one detonation
0008A7r 2               ;   In:  X = board index
0008A7r 2               ;   Out: nothing.  Modifies: A, X, Y
0008A7r 2               ;
0008A7r 2               ;   The whole of SPEC 8 step 4's inner loop, which is why every effect below
0008A7r 2               ;   is nothing but a list of cells to offer it.
0008A7r 2               ;
0008A7r 2               ;   A cell that is empty, a wall, or already marked is not a target. "Not
0008A7r 2               ;   already marked" is what makes the queue terminate and what stops a cell
0008A7r 2               ;   being paid for twice; testing the WALL here is what lets the walks above
0008A7r 2               ;   run over the two sentinel columns without bounds checks of their own. A
0008A7r 2               ;   marked sentinel would be zeroed by CascadeRemove and the well would grow
0008A7r 2               ;   a hole in its floor.
0008A7r 2               ; -----------------------------------------------------------------------------
0008A7r 2               EffectHit:
0008A7r 2  BD rr rr       lda Board,x
0008AAr 2  F0 1A          beq @Done                     ; Empty
0008ACr 2  C9 FF          cmp #TILE_WALL
0008AEr 2  F0 16          beq @Done                     ; A sentinel is never a target
0008B0r 2  8A             txa
0008B1r 2  48             pha
0008B2r 2  20 rr rr       jsr MarkTest
0008B5r 2  68             pla
0008B6r 2  AA             tax                           ; Neither PLA nor TAX touches C
0008B7r 2  B0 0D          bcs @Done                     ; Already going
0008B9r 2               
0008B9r 2  8A             txa
0008BAr 2  48             pha                           ; MarkSet takes the index in A, which PHA left
0008BBr 2  20 rr rr       jsr MarkSet                   ;   alone
0008BEr 2  20 rr rr       jsr EffectScoreCell           ; SPEC 9.2, per cell an effect took
0008C1r 2  68             pla
0008C2r 2  AA             tax
0008C3r 2  4C rr rr       jmp EffectEnqueue             ; ...and if it was a reagent, it fires too
0008C6r 2               @Done:
0008C6r 2  60             rts
0008C7r 2               
0008C7r 2               ; -----------------------------------------------------------------------------
0008C7r 2               ;   EffectScoreCell — EffectValue[chain] for one cell taken by an effect
0008C7r 2               ;   Out: nothing.  Modifies: A, X, Y
0008C7r 2               ;   SPEC 9.2 — deliberately dearer than a matched tile at low chain depth, so
0008C7r 2               ;   that the first reagent a player ever sets off feels better than plain play.
0008C7r 2               ; -----------------------------------------------------------------------------
0008C7r 2               EffectScoreCell:
0008C7r 2  AE rr rr       ldx ChainStep
0008CAr 2  CA             dex                           ; Indexed by chain - 1 ...
0008CBr 2  E0 08          cpx #8
0008CDr 2  90 02          bcc @Chain
0008CFr 2  A2 07          ldx #7                        ;   ... and flattens out at 8
0008D1r 2               @Chain:
0008D1r 2  BD rr rr       lda EffectValueLo,x
0008D4r 2  48             pha
0008D5r 2  BD rr rr       lda EffectValueHi,x
0008D8r 2  AA             tax
0008D9r 2  68             pla
0008DAr 2  4C rr rr       jmp CascadeAdd
0008DDr 2               
0008DDr 2               ; -----------------------------------------------------------------------------
0008DDr 2               ;   EffectResolve — drain the queue (SPEC 8 step 4)
0008DDr 2               ;   Out: nothing.  Modifies: A, X, Y, Effect*, Marks, Cascade*, StarCount
0008DDr 2               ;
0008DDr 2               ;   The detonation runs first and the trigger bonus is paid on the way back,
0008DDr 2               ;   which is the order SPEC 8 step 4 sets out. It makes no difference to the
0008DDr 2               ;   total — everything lands in the same accumulator — but it does mean the
0008DDr 2               ;   glyph has to survive a routine that clobbers all three registers, and the
0008DDr 2               ;   stack is the cheapest place to put it.
0008DDr 2               ; -----------------------------------------------------------------------------
0008DDr 2               EffectResolve:
0008DDr 2               @Loop:
0008DDr 2  20 rr rr       jsr EffectQPop
0008E0r 2  90 45          bcc @Done                     ; Empty — the step is finished
0008E2r 2               
0008E2r 2  AA             tax                           ; X = the detonating cell
0008E3r 2  BD rr rr       lda Board,x                   ; Still on the board: step 6 has not run
0008E6r 2  29 07          and #GLYPH_MASK
0008E8r 2  48             pha
0008E9r 2  C9 01          cmp #GLYPH_FIREBALL
0008EBr 2  F0 0F          beq @Fireball
0008EDr 2  C9 02          cmp #GLYPH_BOLT
0008EFr 2  F0 20          beq @Bolt
0008F1r 2               
0008F1r 2  A9 07          lda #SFX_BOMB                 ; Glyph 3 — nothing else ever reaches here
0008F3r 2  20 rr rr       jsr SfxPlay
0008F6r 2  20 rr rr       jsr EffectBomb
0008F9r 2  4C rr rr       jmp @Bonus
0008FCr 2               
0008FCr 2               @Fireball:
0008FCr 2  A9 05          lda #SFX_FIREBALL
0008FEr 2  20 rr rr       jsr SfxPlay
000901r 2  BD rr rr       lda Board,x
000904r 2  29 F8          and #COLOR_MASK               ; Its own colour, which can never be wild
000906r 2  48             pha
000907r 2  20 rr rr       jsr HalColorFlash             ; SPEC 4.6, 14 — every tile of that colour goes
00090Ar 2  68             pla                           ;   white for the glow window, which is one VDP
00090Br 2                                               ;   colour byte here and one compare a cell on
00090Br 2                                               ;   the Commodores. AnimGlowBegin reads
00090Br 2                                               ;   TintColor to find out that it happened
00090Br 2  20 rr rr       jsr EffectFireball
00090Er 2  4C rr rr       jmp @Bonus
000911r 2               
000911r 2               @Bolt:
000911r 2  A9 06          lda #SFX_BOLT
000913r 2  20 rr rr       jsr SfxPlay
000916r 2  20 rr rr       jsr EffectBolt
000919r 2               
000919r 2               @Bonus:
000919r 2  68             pla
00091Ar 2  A8             tay                           ; TriggerBonus is indexed by glyph (SPEC 9.5),
00091Br 2  B9 rr rr       lda TriggerBonusLo,y          ;   and is paid however the reagent was removed
00091Er 2  BE rr rr       ldx TriggerBonusHi,y
000921r 2  20 rr rr       jsr CascadeAdd
000924r 2  4C rr rr       jmp @Loop
000927r 2               @Done:
000927r 2  60             rts
000928r 2               
000928r 2               ; -----------------------------------------------------------------------------
000928r 2               ;   The five reagents (SPEC 7.3). Each lists the cells it reaches and leaves
000928r 2               ;   the marking, the scoring and the chain reaction to EffectHit.
000928r 2               ; -----------------------------------------------------------------------------
000928r 2               
000928r 2               ; -----------------------------------------------------------------------------
000928r 2               ;   EffectFireball — every remaining tile of one colour, board wide
000928r 2               ;   In:  A = the colour key ($40 to $68)
000928r 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectArg, Marks, Cascade*
000928r 2               ;   SPEC 7.3 — the signature reagent, and the reason a chain goes three deep.
000928r 2               ;
000928r 2               ;   PRISMS ARE IMMUNE AND IT COSTS NOTHING TO MAKE THEM SO (SPEC 7.4). A prism
000928r 2               ;   is colour 6 and a fireball's colour never is, so the compare below is the
000928r 2               ;   immunity — there is no special case to forget. An empty cell and a wall
000928r 2               ;   fail it for the same reason, which is why this walks all eight columns of
000928r 2               ;   every row rather than stepping over the sentinels.
000928r 2               ;
000928r 2               ;   The fireball's own cell is already marked, so it is not a target of itself,
000928r 2               ;   and a second fireball of the same colour in the same step finds nothing
000928r 2               ;   left to take — and still pays its trigger bonus (SPEC 7.3).
000928r 2               ; -----------------------------------------------------------------------------
000928r 2               EffectFireball:
000928r 2  85 rr          sta EffectArg                 ; The colour it is hunting
00092Ar 2  A9 00          lda #0
00092Cr 2  85 rr          sta EffectIdx
00092Er 2               @Cell:
00092Er 2  A6 rr          ldx EffectIdx
000930r 2  BD rr rr       lda Board,x
000933r 2  29 F8          and #COLOR_MASK
000935r 2  C5 rr          cmp EffectArg
000937r 2  D0 03          bne @Next
000939r 2  20 rr rr       jsr EffectHit
00093Cr 2               @Next:
00093Cr 2  E6 rr          inc EffectIdx
00093Er 2  A5 rr          lda EffectIdx
000940r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000942r 2  90 EA          bcc @Cell
000944r 2  60             rts
000945r 2               
000945r 2               ; -----------------------------------------------------------------------------
000945r 2               ;   EffectBolt — the whole row and the whole column through the bolt's cell
000945r 2               ;   In:  X = board index
000945r 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectEnd, EffectArg, Marks
000945r 2               ;   SPEC 7.3 — up to 6 + 16 - 1 = 21 cells, and the only reagent that reaches
000945r 2               ;   something buried at the bottom of a column.
000945r 2               ;
000945r 2               ;   Neither walk needs clipping: a row is six cells wherever it is, and a
000945r 2               ;   column is sixteen. The bolt's own cell is offered twice, once by each, and
000945r 2               ;   is refused both times because it was marked before this was called.
000945r 2               ; -----------------------------------------------------------------------------
000945r 2               EffectBolt:
000945r 2  8A             txa
000946r 2  29 07          and #(BOARD_STRIDE - 1)
000948r 2  85 rr          sta EffectArg                 ; Its column, for the second walk
00094Ar 2  8A             txa
00094Br 2  29 F8          and #(256 - BOARD_STRIDE)     ; $F8 — its row base
00094Dr 2  85 rr          sta EffectIdx
00094Fr 2  18             clc
000950r 2  69 06          adc #BOARD_W
000952r 2  85 rr          sta EffectEnd                 ; One past the row's last playfield cell
000954r 2               @Row:
000954r 2  A6 rr          ldx EffectIdx
000956r 2  20 rr rr       jsr EffectHit
000959r 2  E6 rr          inc EffectIdx
00095Br 2  A5 rr          lda EffectIdx
00095Dr 2  C5 rr          cmp EffectEnd
00095Fr 2  90 F3          bcc @Row
000961r 2               
000961r 2  A5 rr          lda EffectArg                 ; The column, row 0 downward
000963r 2  85 rr          sta EffectIdx
000965r 2               @Col:
000965r 2  A6 rr          ldx EffectIdx
000967r 2  20 rr rr       jsr EffectHit
00096Ar 2  A5 rr          lda EffectIdx
00096Cr 2  18             clc
00096Dr 2  69 08          adc #BOARD_STRIDE
00096Fr 2  85 rr          sta EffectIdx
000971r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000973r 2  90 F0          bcc @Col
000975r 2  60             rts
000976r 2               
000976r 2               ; -----------------------------------------------------------------------------
000976r 2               ;   EffectBomb — the 3 x 3 block centred on the bomb, clipped at the edges
000976r 2               ;   In:  X = board index
000976r 2               ;   Out: nothing.  Modifies: A, X, Y, Effect*, Tmp0, Tmp1, Marks, Cascade*
000976r 2               ;   SPEC 7.3 — up to 9 cells, and the reagent most likely to catch another.
000976r 2               ;
000976r 2               ;   BOTH SPANS ARE CLIPPED, and the row span has to be: row 0 minus one row is
000976r 2               ;   index minus 8, which underflows a byte and reads the BSS in front of a
000976r 2               ;   page-aligned Board. The column span could lean on the sentinels the way
000976r 2               ;   every other walk in the game does — except at row 0, column 0, where
000976r 2               ;   "one to the left" is index $FF and off the end of the board. Clipping both
000976r 2               ;   is smaller than special-casing one corner.
000976r 2               ;
000976r 2               ;   Tmp0 and Tmp1 are finished with before the first JSR, which is what the
000976r 2               ;   rule about them says (zeropage.inc).
000976r 2               ; -----------------------------------------------------------------------------
000976r 2               EffectBomb:
000976r 2  8A             txa                           ; --- the column span ---
000977r 2  29 07          and #(BOARD_STRIDE - 1)
000979r 2  A8             tay
00097Ar 2  F0 01          beq @Left                     ; Column 0 — the block starts there
00097Cr 2  88             dey
00097Dr 2               @Left:
00097Dr 2  84 rr          sty Tmp0                      ; First column of the block
00097Fr 2  8A             txa
000980r 2  29 07          and #(BOARD_STRIDE - 1)
000982r 2  C9 05          cmp #(BOARD_W - 1)
000984r 2  B0 02          bcs @Right                    ; Already against the right wall
000986r 2  69 01          adc #1                        ; C is clear — the CMP above failed
000988r 2               @Right:
000988r 2  85 rr          sta EffectArg                 ; Last column of the block
00098Ar 2               
00098Ar 2  8A             txa                           ; --- the row span ---
00098Br 2  29 F8          and #(256 - BOARD_STRIDE)
00098Dr 2  85 rr          sta Tmp1                      ; The bomb's own row base
00098Fr 2  F0 03          beq @Top                      ; Row 0 — the block starts there
000991r 2  38             sec
000992r 2  E9 08          sbc #BOARD_STRIDE
000994r 2               @Top:
000994r 2  18             clc
000995r 2  65 rr          adc Tmp0
000997r 2  85 rr          sta EffectRow                 ; First cell of the block's first row
000999r 2               
000999r 2  A5 rr          lda Tmp1
00099Br 2  C9 78          cmp #((BOARD_H - 1) * BOARD_STRIDE)
00099Dr 2  B0 03          bcs @Bottom                   ; Row 15 — the block ends there
00099Fr 2  18             clc
0009A0r 2  69 08          adc #BOARD_STRIDE
0009A2r 2               @Bottom:
0009A2r 2  18             clc
0009A3r 2  65 rr          adc Tmp0
0009A5r 2  85 rr          sta EffectEnd                 ; First cell of the block's LAST row
0009A7r 2               
0009A7r 2               @Rows:
0009A7r 2  A5 rr          lda EffectRow
0009A9r 2  85 rr          sta EffectIdx
0009ABr 2               @Cell:
0009ABr 2  A6 rr          ldx EffectIdx
0009ADr 2  20 rr rr       jsr EffectHit
0009B0r 2  A5 rr          lda EffectIdx
0009B2r 2  29 07          and #(BOARD_STRIDE - 1)
0009B4r 2  C5 rr          cmp EffectArg
0009B6r 2  E6 rr          inc EffectIdx                 ; INC touches N and Z only, so the CMP's carry
0009B8r 2  90 F1          bcc @Cell                     ;   is still the one being branched on
0009BAr 2               
0009BAr 2  A5 rr          lda EffectRow
0009BCr 2  C5 rr          cmp EffectEnd
0009BEr 2  B0 07          bcs @Done                     ; That was the last row of the block
0009C0r 2  18             clc
0009C1r 2  69 08          adc #BOARD_STRIDE
0009C3r 2  85 rr          sta EffectRow
0009C5r 2  D0 E0          bne @Rows                     ; Always — a row base past the first is >= 8
0009C7r 2               @Done:
0009C7r 2  60             rts
0009C8r 2               
0009C8r 2               ; -----------------------------------------------------------------------------
0009C8r 2               ;   EffectStar — removes nothing; it multiplies (SPEC 7.3)
0009C8r 2               ;   Out: nothing.  Modifies: A
0009C8r 2               ;
0009C8r 2               ;   The cap is not applied here. SPEC 9.6 doubles the WHOLE cascade up to three
0009C8r 2               ;   times at the end, so the count has to survive to CascadeSettle, which is
0009C8r 2               ;   where min(StarCount, STAR_SHIFT_CAP) is taken. A cascade cannot remove more
0009C8r 2               ;   than the 96 cells of the well, so the count cannot wrap on its way there.
0009C8r 2               ; -----------------------------------------------------------------------------
0009C8r 2               EffectStar:
0009C8r 2  EE rr rr       inc StarCount
0009CBr 2  A9 08          lda #SFX_STAR
0009CDr 2  20 rr rr       jsr SfxPlay
0009D0r 2  60             rts
0009D1r 2               
0009D1r 2               ; -----------------------------------------------------------------------------
0009D1r 2               ;   EffectPrism — removes nothing; a flat bonus per prism cleared (SPEC 9.5)
0009D1r 2               ;   Out: nothing.  Modifies: A, X
0009D1r 2               ;
0009D1r 2               ;   It goes through CascadeAdd and not ScoreAward, so a star in the same
0009D1r 2               ;   cascade doubles it: SPEC 9.6 exempts only the soft drop and the level
0009D1r 2               ;   bonus from the multiplier (D5, D18).
0009D1r 2               ; -----------------------------------------------------------------------------
0009D1r 2               EffectPrism:
0009D1r 2  A9 09          lda #SFX_PRISM
0009D3r 2  20 rr rr       jsr SfxPlay
0009D6r 2  A9 00          lda #<BONUS_PRISM
0009D8r 2  A2 04          ldx #>BONUS_PRISM
0009DAr 2  4C rr rr       jmp CascadeAdd
0009DDr 2               
0009DDr 2               ; -----------------------------------------------------------------------------
0009DDr 2               ;   The effect queue — a ring of board indices, one byte an entry.
0009DDr 2               ;
0009DDr 2               ;   The board still holds every pending reagent when its entry pops, because
0009DDr 2               ;   nothing is zeroed until step 6, so the glyph and the colour SPEC 8 packs
0009DDr 2               ;   into the entry are one `lda Board,x` away and storing them again would be
0009DDr 2               ;   storing a copy of the board (constants.inc).
0009DDr 2               ;
0009DDr 2               ;   Head and tail are entry numbers; the ring keeps one slot free, so it holds
0009DDr 2               ;   EFFECTQ_ENTRIES - 1. On overflow the effect is DROPPED and the cascade
0009DDr 2               ;   carries on (D6) — the cell is still marked, still scored and still removed,
0009DDr 2               ;   it simply does not detonate. With at most one reagent a piece, 47 pending
0009DDr 2               ;   detonations is not somewhere a real board goes.
0009DDr 2               ; -----------------------------------------------------------------------------
0009DDr 2               EffectQClear:
0009DDr 2  A9 00          lda #0
0009DFr 2  8D rr rr       sta EffectQHead
0009E2r 2  8D rr rr       sta EffectQTail
0009E5r 2  60             rts
0009E6r 2               
0009E6r 2               ; -----------------------------------------------------------------------------
0009E6r 2               ;   EffectQPush — In: A = board index.  Modifies: A, X, Y
0009E6r 2               ; -----------------------------------------------------------------------------
0009E6r 2               EffectQPush:
0009E6r 2  AE rr rr       ldx EffectQTail
0009E9r 2  AC rr rr       ldy EffectQTail
0009ECr 2  C8             iny
0009EDr 2  C0 30          cpy #EFFECTQ_ENTRIES
0009EFr 2  90 02          bcc @Store
0009F1r 2  A0 00          ldy #0                        ; Wrap
0009F3r 2               @Store:
0009F3r 2  CC rr rr       cpy EffectQHead
0009F6r 2  F0 06          beq @Full                     ; One slot free is the ring being full
0009F8r 2  9D rr rr       sta EffectQ,x
0009FBr 2  8C rr rr       sty EffectQTail
0009FEr 2               @Full:
0009FEr 2  60             rts
0009FFr 2               
0009FFr 2               ; -----------------------------------------------------------------------------
0009FFr 2               ;   EffectQPop — Out: C set and A = board index; C clear when empty
0009FFr 2               ;   Modifies: A, X
0009FFr 2               ; -----------------------------------------------------------------------------
0009FFr 2               EffectQPop:
0009FFr 2  AE rr rr       ldx EffectQHead
000A02r 2  EC rr rr       cpx EffectQTail
000A05r 2  F0 0F          beq @Empty
000A07r 2  BD rr rr       lda EffectQ,x
000A0Ar 2  E8             inx
000A0Br 2  E0 30          cpx #EFFECTQ_ENTRIES
000A0Dr 2  90 02          bcc @Store
000A0Fr 2  A2 00          ldx #0                        ; Wrap
000A11r 2               @Store:
000A11r 2  8E rr rr       stx EffectQHead
000A14r 2  38             sec
000A15r 2  60             rts
000A16r 2               @Empty:
000A16r 2  18             clc
000A17r 2  60             rts
000A18r 2               
000A18r 1               .include "../src/anim.asm"
000A18r 2               ; =============================================================================
000A18r 2               ;   anim.asm — Wizards Lab, the animations a clear is made of
000A18r 2               ; =============================================================================
000A18r 2               ;   SPEC.md section 14, and step 5 of SPEC 8. Everything here is a frame's
000A18r 2               ;   worth of work and then a return: nothing waits, nothing loops on a timer,
000A18r 2               ;   and the main loop never stops for any of it (D4).
000A18r 2               ;
000A18r 2               ;   A CLEAR STEP ANIMATES IN TWO WINDOWS, and every event SPEC 14 lists lands
000A18r 2               ;   inside one of them:
000A18r 2               ;
000A18r 2               ;     PLAY_GLOW      matched cells wear glyph +6 of their own colour, the
000A18r 2               ;                    bolt's beams lie over its row and column, and the
000A18r 2               ;                    fireball's colour is white board-wide. GlowFrames, or the
000A18r 2               ;                    longer FlashFrames when a fireball fired
000A18r 2               ;     PLAY_SHATTER   the removal ring opens outward over every marked cell,
000A18r 2               ;                    two frames a tile, with a marked prism's blip-out closing
000A18r 2               ;                    inward beside it. SHATTER_STEPS ring frames, or the
000A18r 2               ;                    prism's BLIP_STEPS when there is one
000A18r 2               ;
000A18r 2               ;   A window is as long as the LONGEST thing in it, which is the one rule that
000A18r 2               ;   makes the durations in SPEC 14 hold without a timer per effect.
000A18r 2               ;
000A18r 2               ;   THE BOARD IS UNTOUCHED THE WHOLE TIME. Marked cells are not zeroed until
000A18r 2               ;   CascadeRemove runs at the end of the shatter (SPEC 8 step 6), so every
000A18r 2               ;   routine below can read a cell to find out what it is while drawing
000A18r 2               ;   something else entirely over it — which is also what let P5 make an effect
000A18r 2               ;   queue entry one byte (cascade.asm). Nothing here writes Board except the
000A18r 2               ;   prism's idle rotation and the game-over petrify, both of which change what
000A18r 2               ;   a cell IS and not merely what it shows.
000A18r 2               ;
000A18r 2               ;   THE COLOUR IS TESTED BEFORE THE GLYPH, everywhere, for the reason P5 found
000A18r 2               ;   the hard way: a prism is glyph 0 of colour 6 and, now that it rotates, its
000A18r 2               ;   board byte is WILD_BASE + 0..3, whose low three bits read as a bolt or a
000A18r 2               ;   bomb. Colour 6 is the only test that stays true.
000A18r 2               ; =============================================================================
000A18r 2               
000A18r 2               ANIM_GLOW           = 0         ; The four passes AnimMarked can make over the
000A18r 2               ANIM_BEAM           = 1         ;   marked cells. AnimMode picks one; the walk
000A18r 2               ANIM_UNBEAM         = 2         ;   itself is the same 30 bytes for all four
000A18r 2               ANIM_SHATTER        = 3         ;   and is written once.
000A18r 2               
000A18r 2               ; -----------------------------------------------------------------------------
000A18r 2               ;   AnimMarked — run one pass over every marked cell
000A18r 2               ;   In:  A = ANIM_*      Out: nothing.  Modifies: A, X, Y, Anim*, and whatever
000A18r 2               ;        the pass itself touches
000A18r 2               ;
000A18r 2               ;   The same walk as EffectEnqueueMarked (cascade.asm) and for the same reason:
000A18r 2               ;   MARKS is the union of everything the step is taking, and a cell in a
000A18r 2               ;   horizontal run AND a vertical one appears in it once. Marks are read only
000A18r 2               ;   here — no pass sets one — so the bitmap cannot change underneath the walk.
000A18r 2               ;
000A18r 2               ;   The cursor is in memory rather than in X because everything the passes call
000A18r 2               ;   ends at RenderMark, which clobbers A and X (D13).
000A18r 2               ; -----------------------------------------------------------------------------
000A18r 2               AnimMarked:
000A18r 2  85 rr          sta AnimMode
000A1Ar 2  A9 00          lda #0
000A1Cr 2  85 rr          sta AnimIdx
000A1Er 2               @Row:
000A1Er 2  A5 rr          lda AnimIdx
000A20r 2  4A             lsr a
000A21r 2  4A             lsr a
000A22r 2  4A             lsr a
000A23r 2  A8             tay
000A24r 2  B9 rr rr       lda Marks,y
000A27r 2  F0 20          beq @NextRow                  ; Nothing marked in this row, which is most
000A29r 2                                               ;   rows of most steps
000A29r 2               @Cell:
000A29r 2  A5 rr          lda AnimIdx
000A2Br 2  20 rr rr       jsr MarkTest
000A2Er 2  90 05          bcc @NextCell
000A30r 2  A6 rr          ldx AnimIdx
000A32r 2  20 rr rr       jsr AnimCell
000A35r 2               @NextCell:
000A35r 2  E6 rr          inc AnimIdx
000A37r 2  A5 rr          lda AnimIdx
000A39r 2  29 07          and #(BOARD_STRIDE - 1)
000A3Br 2  C9 06          cmp #BOARD_W
000A3Dr 2  90 EA          bcc @Cell
000A3Fr 2               
000A3Fr 2  A5 rr          lda AnimIdx                   ; On the row's first sentinel column; step
000A41r 2  18             clc                           ;   over both of them
000A42r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000A44r 2  85 rr          sta AnimIdx
000A46r 2  4C rr rr       jmp @Test
000A49r 2               
000A49r 2               @NextRow:
000A49r 2  A5 rr          lda AnimIdx
000A4Br 2  18             clc
000A4Cr 2  69 08          adc #BOARD_STRIDE
000A4Er 2  85 rr          sta AnimIdx
000A50r 2               @Test:
000A50r 2  A5 rr          lda AnimIdx
000A52r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000A54r 2  90 C8          bcc @Row
000A56r 2  60             rts
000A57r 2               
000A57r 2               ; -----------------------------------------------------------------------------
000A57r 2               ;   AnimCell — one marked cell, in whichever pass is running
000A57r 2               ;   In:  X = board index, AnimMode      Out: nothing.  Modifies: A, X, Y
000A57r 2               ; -----------------------------------------------------------------------------
000A57r 2               AnimCell:
000A57r 2  A5 rr          lda AnimMode
000A59r 2  F0 1A          beq AnimCellGlow
000A5Br 2  C9 03          cmp #ANIM_SHATTER
000A5Dr 2  F0 2A          beq AnimCellShatter
000A5Fr 2                 ; falls through into the two beam passes, which are the same test
000A5Fr 2               
000A5Fr 2               ; -----------------------------------------------------------------------------
000A5Fr 2               ;   AnimCellBolt — is this cell a bolt? If so, draw or undraw its cross
000A5Fr 2               ;   In:  X = board index      Out: nothing.  Modifies: A, X, Y, Anim*
000A5Fr 2               ;
000A5Fr 2               ;   The beams are their own pass and not a case inside the glow, because a
000A5Fr 2               ;   beam goes OVER a glow: a cell in a bolt's row is very often also a matched
000A5Fr 2               ;   cell, and both have to be drawn in that order.
000A5Fr 2               ; -----------------------------------------------------------------------------
000A5Fr 2               AnimCellBolt:
000A5Fr 2  BD rr rr       lda Board,x
000A62r 2  29 F8          and #COLOR_MASK
000A64r 2  C9 70          cmp #WILD_BASE
000A66r 2  F0 0C          beq @Done                     ; Colour before glyph: a rotating prism's low
000A68r 2                                               ;   three bits say "bolt" and it is not one
000A68r 2  BD rr rr       lda Board,x
000A6Br 2  29 07          and #GLYPH_MASK
000A6Dr 2  C9 02          cmp #GLYPH_BOLT
000A6Fr 2  D0 03          bne @Done
000A71r 2  4C rr rr       jmp AnimBeam
000A74r 2               @Done:
000A74r 2  60             rts
000A75r 2               
000A75r 2               ; -----------------------------------------------------------------------------
000A75r 2               ;   AnimCellGlow — glyph +6 of the cell's own colour (SPEC 14)
000A75r 2               ;   In:  X = board index      Out: nothing.  Modifies: A, X, Y, AnimSteps
000A75r 2               ;
000A75r 2               ;   A MARKED PRISM SITS THE GLOW OUT. Group 14's slot +6 is an arrow, not a
000A75r 2               ;   glow (SPEC A.3), so `WILD_BASE + GLYPH_GLOW` must never be constructed —
000A75r 2               ;   the prism holds whatever rotation frame it was on and blips out later
000A75r 2               ;   instead. Meeting one here is also how the shatter window learns it has to
000A75r 2               ;   run BLIP_STEPS rather than SHATTER_STEPS, which saves a second walk.
000A75r 2               ; -----------------------------------------------------------------------------
000A75r 2               AnimCellGlow:
000A75r 2  BD rr rr       lda Board,x
000A78r 2  29 F8          and #COLOR_MASK
000A7Ar 2  C9 70          cmp #WILD_BASE
000A7Cr 2  F0 05          beq @Prism
000A7Er 2  09 06          ora #GLYPH_GLOW               ; The colour key's low three bits are clear, so
000A80r 2  4C rr rr       jmp RenderCellAs              ;   an ORA is the whole conversion (SPEC 4.2)
000A83r 2               @Prism:
000A83r 2  A9 05          lda #BLIP_STEPS
000A85r 2  8D rr rr       sta AnimSteps
000A88r 2  60             rts
000A89r 2               
000A89r 2               ; -----------------------------------------------------------------------------
000A89r 2               ;   AnimCellShatter — the ring frame this cell is showing right now
000A89r 2               ;   In:  X = board index, AnimStep      Out: nothing.  Modifies: A, X, Y
000A89r 2               ;   SPEC 14, Appendix A.3 — one ring, opening outward for everything except a
000A89r 2               ;   prism, which runs it closed inward.
000A89r 2               ; -----------------------------------------------------------------------------
000A89r 2               AnimCellShatter:
000A89r 2  BD rr rr       lda Board,x
000A8Cr 2  29 F8          and #COLOR_MASK
000A8Er 2  C9 70          cmp #WILD_BASE
000A90r 2  F0 0D          beq @Blip
000A92r 2  AC rr rr       ldy AnimStep
000A95r 2  C0 04          cpy #(SHATTER_STEPS + 1)
000A97r 2  B0 0F          bcs @Done                     ; The ring is spent and the cell already blank.
000A99r 2  B9 rr rr       lda VfxShatter,y              ;   Only reachable while a prism holds the
000A9Cr 2  4C rr rr       jmp RenderCellAs              ;   window open for its last two frames
000A9Fr 2               @Blip:
000A9Fr 2  AC rr rr       ldy AnimStep
000AA2r 2  B9 rr rr       lda VfxBlip,y
000AA5r 2  4C rr rr       jmp RenderCellAs
000AA8r 2               @Done:
000AA8r 2  60             rts
000AA9r 2               
000AA9r 2               ; -----------------------------------------------------------------------------
000AA9r 2               ;   AnimBeam — the bolt's beams, along its whole row and its whole column
000AA9r 2               ;   In:  X = board index of the bolt; AnimIdx holds the same index, because
000AA9r 2               ;        this is only ever reached from AnimMarked's cursor
000AA9r 2               ;   Out: nothing.  Modifies: A, X, Y, AnimCur, AnimEnd, AnimArg
000AA9r 2               ;   SPEC 14, Appendix A.3.
000AA9r 2               ;
000AA9r 2               ;   The beams cover EVERY cell of the row and the column, empty ones included.
000AA9r 2               ;   A beam has to butt against its neighbours to read as a beam, and the cells
000AA9r 2               ;   the bolt found empty were never marked — so those are also the cells the
000AA9r 2               ;   ANIM_UNBEAM pass exists to put back, since nothing else would ever draw
000AA9r 2               ;   them again.
000AA9r 2               ;
000AA9r 2               ;   The cross goes down last, over both walks, because it is the one cell that
000AA9r 2               ;   belongs to each.
000AA9r 2               ; -----------------------------------------------------------------------------
000AA9r 2               AnimBeam:
000AA9r 2  8A             txa
000AAAr 2  29 07          and #(BOARD_STRIDE - 1)
000AACr 2  85 rr          sta AnimArg                   ; Its column, for the second walk
000AAEr 2  8A             txa
000AAFr 2  29 F8          and #(256 - BOARD_STRIDE)     ; $F8 — its row base
000AB1r 2  85 rr          sta AnimCur
000AB3r 2  18             clc
000AB4r 2  69 06          adc #BOARD_W
000AB6r 2  85 rr          sta AnimEnd                   ; One past the row's last playfield cell
000AB8r 2               @Row:
000AB8r 2  A6 rr          ldx AnimCur
000ABAr 2  A9 3B          lda #VFX_BEAM_H
000ABCr 2  20 rr rr       jsr AnimBeamCell
000ABFr 2  E6 rr          inc AnimCur
000AC1r 2  A5 rr          lda AnimCur
000AC3r 2  C5 rr          cmp AnimEnd
000AC5r 2  90 F1          bcc @Row
000AC7r 2               
000AC7r 2  A5 rr          lda AnimArg                   ; The column, row 0 downward
000AC9r 2  85 rr          sta AnimCur
000ACBr 2               @Col:
000ACBr 2  A6 rr          ldx AnimCur
000ACDr 2  A9 3C          lda #VFX_BEAM_V
000ACFr 2  20 rr rr       jsr AnimBeamCell
000AD2r 2  A5 rr          lda AnimCur
000AD4r 2  18             clc
000AD5r 2  69 08          adc #BOARD_STRIDE
000AD7r 2  85 rr          sta AnimCur
000AD9r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000ADBr 2  90 EE          bcc @Col
000ADDr 2               
000ADDr 2  A6 rr          ldx AnimIdx                   ; The bolt's own cell. The outer walk is still
000ADFr 2  A9 3D          lda #VFX_BEAM_CROSS           ;   standing on it, which is cheaper than
000AE1r 2                 ; falls through                ;   keeping a copy across both walks
000AE1r 2               
000AE1r 2               ; -----------------------------------------------------------------------------
000AE1r 2               ;   AnimBeamCell — one cell of a beam, drawn or put back
000AE1r 2               ;   In:  X = board index, A = beam tile      Modifies: A, X, Y
000AE1r 2               ;
000AE1r 2               ;   On the way back only the cells that are NOT marked need anything: the
000AE1r 2               ;   marked ones are about to be drawn by the shatter, twice a frame apart, and
000AE1r 2               ;   drawing them here as well would only queue two marks for one cell.
000AE1r 2               ;
000AE1r 2               ;   THE RESTORE IS THE ONE MARK IN THE WHOLE ANIMATION THAT CANNOT BE DROPPED.
000AE1r 2               ;   Every other one is made again within a few frames — a lost glow is covered
000AE1r 2               ;   by the shatter six frames later, a lost ring frame by CascadeRemove at the
000AE1r 2               ;   end of it — but a beam laid over an EMPTY cell has nothing behind it that
000AE1r 2               ;   anything will ever draw again, and D6's drop-on-overflow would leave a
000AE1r 2               ;   white beam sitting in the well for the rest of the game. Five bolts in one
000AE1r 2               ;   run put 110 beam cells through here against a 64-entry ring, so this is
000AE1r 2               ;   reachable and not theoretical. It takes the same way out CascadeRemove
000AE1r 2               ;   does: the whole-well redraw cursor, which repaints every one of them from
000AE1r 2               ;   the board (D12).
000AE1r 2               ; -----------------------------------------------------------------------------
000AE1r 2               AnimBeamCell:
000AE1r 2  A4 rr          ldy AnimMode
000AE3r 2  C0 01          cpy #ANIM_BEAM
000AE5r 2  D0 03          bne @Restore
000AE7r 2  4C rr rr       jmp RenderCellAs
000AEAr 2               @Restore:
000AEAr 2  8A             txa
000AEBr 2  48             pha                           ; MarkTest takes the index in A and clobbers
000AECr 2  20 rr rr       jsr MarkTest                  ;   X; neither PLA nor TAX touches C
000AEFr 2  68             pla
000AF0r 2  AA             tax
000AF1r 2  B0 0D          bcs @Done                     ; Marked — the shatter has it
000AF3r 2  AD rr rr       lda DirtyCount
000AF6r 2  C9 40          cmp #DIRTY_ENTRIES
000AF8r 2  B0 03          bcs @Bulk                     ; No room, and this cell must not be lost
000AFAr 2  4C rr rr       jmp RenderCell                ; Board,x — empty, in every case that gets here
000AFDr 2               @Bulk:
000AFDr 2  4C rr rr       jmp RenderBoard               ; Sets the cursor and nothing else; the cells
000B00r 2                                               ;   already queued still land and the redraw
000B00r 2                                               ;   goes over them with the same values
000B00r 2               @Done:
000B00r 2  60             rts
000B01r 2               
000B01r 2               ; =============================================================================
000B01r 2               ;   The two windows
000B01r 2               ; =============================================================================
000B01r 2               
000B01r 2               ; -----------------------------------------------------------------------------
000B01r 2               ;   AnimGlowBegin — SPEC 8 step 5, first half. Called with MARKS filled and
000B01r 2               ;   the effect queue drained, from CascadeEnter.
000B01r 2               ;   Out: PlayState = PLAY_GLOW.  Modifies: A, X, Y, Anim*
000B01r 2               ;
000B01r 2               ;   The fireball's flash is already lit: EffectResolve calls HalColorFlash as
000B01r 2               ;   it detonates, so TintColor arriving here as anything but TINT_NONE is how
000B01r 2               ;   this knows a fireball fired and the window has to be the longer one
000B01r 2               ;   (SPEC 14). Two fireballs of different colours in one step leave the LAST
000B01r 2               ;   one's colour flashing — one byte can only name one group, and the other's
000B01r 2               ;   cells still glow and still shatter.
000B01r 2               ; -----------------------------------------------------------------------------
000B01r 2               AnimGlowBegin:
000B01r 2  A9 03          lda #SHATTER_STEPS            ; Raised to BLIP_STEPS by AnimCellGlow if it
000B03r 2  8D rr rr       sta AnimSteps                 ;   meets a marked prism
000B06r 2  A9 00          lda #ANIM_GLOW
000B08r 2  20 rr rr       jsr AnimMarked
000B0Br 2  A9 01          lda #ANIM_BEAM
000B0Dr 2  20 rr rr       jsr AnimMarked
000B10r 2               
000B10r 2  AE rr rr       ldx Region
000B13r 2  BD rr rr       lda GlowFrames,x
000B16r 2  AC rr rr       ldy TintColor
000B19r 2  C0 01          cpy #TINT_NONE
000B1Br 2  F0 08          beq @Time
000B1Dr 2  BD rr rr       lda FlashFrames,x
000B20r 2  48             pha
000B21r 2  20 rr rr       jsr RenderNext                ; The preview is redrawn so that a piece of the
000B24r 2  68             pla                           ;   flashing colour goes white there too. On
000B25r 2                                               ;   the AC6502 the whole group recolours and
000B25r 2                                               ;   this changes nothing; on the Commodores the
000B25r 2                                               ;   tint is per cell and this is the only way
000B25r 2                                               ;   those three cells hear about it (SPEC 4.6)
000B25r 2               @Time:
000B25r 2  8D rr rr       sta AnimTimer
000B28r 2  A9 02          lda #PLAY_GLOW
000B2Ar 2  8D rr rr       sta PlayState
000B2Dr 2  60             rts
000B2Er 2               
000B2Er 2               ; -----------------------------------------------------------------------------
000B2Er 2               ;   AnimGlowEnd — take the beams and the flash down, and start the shatter
000B2Er 2               ;   Out: PlayState = PLAY_SHATTER.  Modifies: A, X, Y, Anim*
000B2Er 2               ; -----------------------------------------------------------------------------
000B2Er 2               AnimGlowEnd:
000B2Er 2  A9 02          lda #ANIM_UNBEAM
000B30r 2  20 rr rr       jsr AnimMarked
000B33r 2               
000B33r 2  AD rr rr       lda TintColor
000B36r 2  C9 01          cmp #TINT_NONE
000B38r 2  F0 08          beq AnimShatterBegin
000B3Ar 2  A9 01          lda #TINT_NONE
000B3Cr 2  20 rr rr       jsr HalColorFlash             ; The flash ends with the window; every cell it
000B3Fr 2  20 rr rr       jsr RenderNext                ;   covered is marked and about to be redrawn
000B42r 2                                               ;   by the shatter, so only the preview needs
000B42r 2                                               ;   asking for again
000B42r 2                 ; falls through
000B42r 2               
000B42r 2               ; -----------------------------------------------------------------------------
000B42r 2               ;   AnimShatterBegin — SPEC 8 step 5, second half
000B42r 2               ;   Out: PlayState = PLAY_SHATTER.  Modifies: A, X, Y, Anim*
000B42r 2               ;   Frame 0 of the ring goes up now rather than next frame, so the window is
000B42r 2               ;   AnimSteps * VFX_FRAMES frames long and every tile of it holds for
000B42r 2               ;   VFX_FRAMES, the last one included.
000B42r 2               ; -----------------------------------------------------------------------------
000B42r 2               AnimShatterBegin:
000B42r 2  A9 00          lda #0
000B44r 2  8D rr rr       sta AnimStep
000B47r 2  A9 02          lda #VFX_FRAMES
000B49r 2  8D rr rr       sta AnimTimer
000B4Cr 2  A9 03          lda #PLAY_SHATTER
000B4Er 2  8D rr rr       sta PlayState
000B51r 2  A9 03          lda #ANIM_SHATTER
000B53r 2  4C rr rr       jmp AnimMarked
000B56r 2               
000B56r 2               ; =============================================================================
000B56r 2               ;   The prism at rest (SPEC 7.3, 14)
000B56r 2               ; =============================================================================
000B56r 2               
000B56r 2               ; -----------------------------------------------------------------------------
000B56r 2               ;   AnimPrismTick — advance the idle rotation, one frame every PRISM_SPIN_RATE
000B56r 2               ;   Out: nothing.  Modifies: A, X, Y, AnimIdx, AnimArg, PrismFrame, PrismTimer
000B56r 2               ;
000B56r 2               ;   The only tile in the game that moves when nothing is happening, and the
000B56r 2               ;   only place other than the petrify that WRITES a tile to the board without
000B56r 2               ;   the board having changed: a prism's cell really does hold WILD_BASE + 0..3
000B56r 2               ;   from here on. Everything that reads a cell masks the colour first, so the
000B56r 2               ;   glyph bits carrying a frame number rather than a zero is invisible to the
000B56r 2               ;   scan, to gravity and to the effects — but it is exactly why P5 made
000B56r 2               ;   EffectEnqueue test the colour before the glyph, and why the petrify below
000B56r 2               ;   does too.
000B56r 2               ;
000B56r 2               ;   IT DOES NOT RUN DURING THE GLOW OR THE SHATTER. A marked prism has to hold
000B56r 2               ;   still for the glow window and then play its blip-out, and it is cheaper to
000B56r 2               ;   stand the whole walk down for those twelve frames than to test every cell
000B56r 2               ;   against MARKS.
000B56r 2               ;
000B56r 2               ;   The walk is the 96 cells of the well every eighth frame whether a prism is
000B56r 2               ;   on the board or not — about 150 cycles a frame amortised, against a board
000B56r 2               ;   scan's eleven thousand. Remembering where the prisms are would cost more
000B56r 2               ;   than it saves, and would have to be kept right through gravity.
000B56r 2               ; -----------------------------------------------------------------------------
000B56r 2               AnimPrismTick:
000B56r 2  AD rr rr       lda PlayState
000B59r 2  C9 02          cmp #PLAY_GLOW
000B5Br 2  F0 4B          beq @Done
000B5Dr 2  C9 03          cmp #PLAY_SHATTER
000B5Fr 2  F0 47          beq @Done
000B61r 2  CE rr rr       dec PrismTimer
000B64r 2  D0 42          bne @Done
000B66r 2               
000B66r 2  A9 08          lda #PRISM_SPIN_RATE
000B68r 2  8D rr rr       sta PrismTimer
000B6Br 2  EE rr rr       inc PrismFrame
000B6Er 2  AD rr rr       lda PrismFrame
000B71r 2  29 03          and #(PRISM_SPIN_FRAMES - 1)
000B73r 2  8D rr rr       sta PrismFrame
000B76r 2  09 70          ora #PRISM_SPIN               ; WILD_BASE + frame (SPEC A.3)
000B78r 2  85 rr          sta AnimArg
000B7Ar 2               
000B7Ar 2  A9 00          lda #0
000B7Cr 2  85 rr          sta AnimIdx
000B7Er 2               @Cell:
000B7Er 2  A6 rr          ldx AnimIdx
000B80r 2  BD rr rr       lda Board,x
000B83r 2  29 F8          and #COLOR_MASK
000B85r 2  C9 70          cmp #WILD_BASE
000B87r 2  D0 08          bne @Next
000B89r 2  A5 rr          lda AnimArg
000B8Br 2  9D rr rr       sta Board,x
000B8Er 2  20 rr rr       jsr RenderCell
000B91r 2               @Next:
000B91r 2  E6 rr          inc AnimIdx
000B93r 2  A5 rr          lda AnimIdx
000B95r 2  29 07          and #(BOARD_STRIDE - 1)
000B97r 2  C9 06          cmp #BOARD_W
000B99r 2  90 07          bcc @Test
000B9Br 2  A5 rr          lda AnimIdx                   ; Over the two sentinel columns
000B9Dr 2  18             clc
000B9Er 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000BA0r 2  85 rr          sta AnimIdx
000BA2r 2               @Test:
000BA2r 2  A5 rr          lda AnimIdx
000BA4r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000BA6r 2  90 D6          bcc @Cell
000BA8r 2               @Done:
000BA8r 2  60             rts
000BA9r 2               
000BA9r 2               ; =============================================================================
000BA9r 2               ;   The message band (SPEC 12.2, 14)
000BA9r 2               ; =============================================================================
000BA9r 2               
000BA9r 2               ; -----------------------------------------------------------------------------
000BA9r 2               ;   AnimBannerShow — put a banner up for BannerFrames
000BA9r 2               ;   In:  Ptr1 -> string      Out: nothing.  Modifies: A, X, Y and the text
000BA9r 2               ;        cursor
000BA9r 2               ; -----------------------------------------------------------------------------
000BA9r 2               AnimBannerShow:
000BA9r 2  20 rr rr       jsr TextBanner
000BACr 2  AE rr rr       ldx Region
000BAFr 2  BD rr rr       lda BannerFrames,x
000BB2r 2  8D rr rr       sta BannerTimer
000BB5r 2  60             rts
000BB6r 2               
000BB6r 2               ; -----------------------------------------------------------------------------
000BB6r 2               ;   AnimBannerTick — one frame of whatever banner is up
000BB6r 2               ;   Out: nothing.  Modifies: A, X, Y
000BB6r 2               ;   Play never stops for a banner: it ticks alongside the sub-states, like the
000BB6r 2               ;   high-score flash it shares its clock with (SPEC 9.8).
000BB6r 2               ; -----------------------------------------------------------------------------
000BB6r 2               AnimBannerTick:
000BB6r 2  AD rr rr       lda BannerTimer
000BB9r 2  F0 08          beq @Done
000BBBr 2  CE rr rr       dec BannerTimer
000BBEr 2  D0 03          bne @Done
000BC0r 2  4C rr rr       jmp TextBannerClear
000BC3r 2               @Done:
000BC3r 2  60             rts
000BC4r 2               
000BC4r 2               ; -----------------------------------------------------------------------------
000BC4r 2               ;   AnimBannerLevel — "~~ LEVEL UP ~~" (SPEC 10.1, 14)
000BC4r 2               ; -----------------------------------------------------------------------------
000BC4r 2               AnimBannerLevel:
000BC4r 2  A9 rr          lda #<MsgLevelUp
000BC6r 2  85 rr          sta Ptr1
000BC8r 2  A9 rr          lda #>MsgLevelUp
000BCAr 2  85 rr          sta Ptr1+1
000BCCr 2  4C rr rr       jmp AnimBannerShow
000BCFr 2               
000BCFr 2               ; -----------------------------------------------------------------------------
000BCFr 2               ;   AnimBannerChain — "~~ CHAIN xN ~~" (SPEC 8 SETTLE, 14)
000BCFr 2               ;   In:  A = links in the cascade      Modifies: A, X, Y and the text cursor
000BCFr 2               ;
000BCFr 2               ;   The banner is a fixed-length string with a placeholder digit, overwritten
000BCFr 2               ;   afterwards at CHAIN_DIGIT_X — which is a constant only because the string
000BCFr 2               ;   is MSG_CHAIN_LEN cells long and TextBanner centres on PANEL_W
000BCFr 2               ;   (constants.inc). A chain past 9 says 9 rather than drawing whatever tile
000BCFr 2               ;   FONT_DIGIT_0 + 10 turns out to be.
000BCFr 2               ; -----------------------------------------------------------------------------
000BCFr 2               AnimBannerChain:
000BCFr 2  C9 0A          cmp #(CHAIN_MAX_SHOWN + 1)
000BD1r 2  90 02          bcc @Show
000BD3r 2  A9 09          lda #CHAIN_MAX_SHOWN
000BD5r 2               @Show:
000BD5r 2  48             pha
000BD6r 2  A9 rr          lda #<MsgChain
000BD8r 2  85 rr          sta Ptr1
000BDAr 2  A9 rr          lda #>MsgChain
000BDCr 2  85 rr          sta Ptr1+1
000BDEr 2  20 rr rr       jsr AnimBannerShow
000BE1r 2  68             pla
000BE2r 2  18             clc
000BE3r 2  69 10          adc #FONT_DIGIT_0
000BE5r 2  A2 0E          ldx #CHAIN_DIGIT_X
000BE7r 2  A0 16          ldy #MSG_Y
000BE9r 2  4C rr rr       jmp RenderMark
000BECr 2               
000BECr 2               ; -----------------------------------------------------------------------------
000BECr 2               ;   AnimBannerOver — "~~ GAME OVER! ~~" (SPEC 13.4 step 3)
000BECr 2               ;   Nothing takes it down again: StateGameOver does not call AnimBannerTick, so
000BECr 2               ;   the band holds this until the screen itself ends and GameStart clears it.
000BECr 2               ; -----------------------------------------------------------------------------
000BECr 2               AnimBannerOver:
000BECr 2  A9 rr          lda #<MsgGameOver
000BEEr 2  85 rr          sta Ptr1
000BF0r 2  A9 rr          lda #>MsgGameOver
000BF2r 2  85 rr          sta Ptr1+1
000BF4r 2  4C rr rr       jmp AnimBannerShow
000BF7r 2               
000BF7r 2               ; =============================================================================
000BF7r 2               ;   The title screen (SPEC 13.1)
000BF7r 2               ; =============================================================================
000BF7r 2               ;   Two moving things over one drawn image, and between them they are the whole
000BF7r 2               ;   of the title screen: there are no help pages, because the controls are part
000BF7r 2               ;   of the artwork and a page nobody is reading teaches nothing.
000BF7r 2               ; =============================================================================
000BF7r 2               
000BF7r 2               ; -----------------------------------------------------------------------------
000BF7r 2               ;   AnimTitleBegin — the blink starts lit, with the image the artist drew
000BF7r 2               ;   Out: nothing.  Modifies: A, X
000BF7r 2               ;   Called from the redraw, so entering the title twice in a session cannot
000BF7r 2               ;   leave the prompt dark for the first half period.
000BF7r 2               ; -----------------------------------------------------------------------------
000BF7r 2               AnimTitleBegin:
000BF7r 2  AE rr rr       ldx Region
000BFAr 2  BD rr rr       lda BlinkHalf,x
000BFDr 2  8D rr rr       sta TitleTimer
000C00r 2  A9 00          lda #0
000C02r 2  8D rr rr       sta TitlePhase                ; The drawn screen already says PRESS FIRE
000C05r 2  60             rts
000C06r 2               
000C06r 2               ; -----------------------------------------------------------------------------
000C06r 2               ;   AnimTitleBlink — one frame of the prompt (SPEC 13.1, 14)
000C06r 2               ;   Out: nothing.  Modifies: A, X, Y, the text cursor, TitleTimer, TitlePhase
000C06r 2               ;
000C06r 2               ;   SPEC 14's blink period is 30 frames NTSC and 25 PAL, and BlinkHalf is half
000C06r 2               ;   of one — the same table and the same shape as the HIGH field's overtake
000C06r 2               ;   flash (score.asm), which is the other thing in the game that blinks. This
000C06r 2               ;   one free-runs instead of counting itself out.
000C06r 2               ; -----------------------------------------------------------------------------
000C06r 2               AnimTitleBlink:
000C06r 2  CE rr rr       dec TitleTimer
000C09r 2  D0 2B          bne @Done
000C0Br 2  AE rr rr       ldx Region
000C0Er 2  BD rr rr       lda BlinkHalf,x
000C11r 2  8D rr rr       sta TitleTimer
000C14r 2  AD rr rr       lda TitlePhase
000C17r 2  49 01          eor #$01
000C19r 2  8D rr rr       sta TitlePhase
000C1Cr 2  F0 09          beq @Show
000C1Er 2               
000C1Er 2  A9 0A          lda #PROMPT_LEN               ; The dark half
000C20r 2  A2 06          ldx #PROMPT_X
000C22r 2  A0 0B          ldy #PROMPT_Y
000C24r 2  4C rr rr       jmp TextClearRun
000C27r 2               @Show:
000C27r 2  A9 rr          lda #<MsgPressFire            ; ...and back, byte for byte as the title image
000C29r 2  85 rr          sta Ptr1                      ;   has it (strings.inc)
000C2Br 2  A9 rr          lda #>MsgPressFire
000C2Dr 2  85 rr          sta Ptr1+1
000C2Fr 2  A2 06          ldx #PROMPT_X
000C31r 2  A0 0B          ldy #PROMPT_Y
000C33r 2  4C rr rr       jmp TextDraw
000C36r 2               @Done:
000C36r 2  60             rts
000C37r 2               
000C37r 2               ; -----------------------------------------------------------------------------
000C37r 2               ;   AnimTitleField — one cell of the magic field, every frame (SPEC 13.1)
000C37r 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0, Tmp1
000C37r 2               ;
000C37r 2               ;   Tiles 128-255 are one diagonal hatch in sixteen colours (SPEC Appendix A),
000C37r 2               ;   so writing a random one of them into a random one of the block's 28 cells
000C37r 2               ;   makes the whole block crawl. Two random bytes and one RenderMark: the
000C37r 2               ;   cheapest animation in the game, and the reason the title screen needs no
000C37r 2               ;   art beyond the page it is drawn on.
000C37r 2               ;
000C37r 2               ;   The tile is rolled BEFORE the cell and parked on the stack, because
000C37r 2               ;   RngRange has to be the last call — nothing here may hold a value in
000C37r 2               ;   Tmp0-Tmp3 across it (zeropage.inc).
000C37r 2               ; -----------------------------------------------------------------------------
000C37r 2               AnimTitleField:
000C37r 2  20 rr rr       jsr RngNext
000C3Ar 2  29 7F          and #(ART_TILES - 1)          ; ART_BASE is 128 and so is ART_TILES, so the
000C3Cr 2  09 80          ora #ART_BASE                 ;   range is exactly the top bit set
000C3Er 2  48             pha
000C3Fr 2               
000C3Fr 2  A9 1C          lda #FIELD_CELLS
000C41r 2  20 rr rr       jsr RngRange                  ; 0 .. 27, evenly — not a modulo (rng.asm)
000C44r 2  A0 08          ldy #FIELD_Y
000C46r 2  C9 0E          cmp #FIELD_W
000C48r 2  90 03          bcc @Have
000C4Ar 2  E9 0E          sbc #FIELD_W                  ; C is set by the CMP that got us here
000C4Cr 2  C8             iny                           ; The second row of the block
000C4Dr 2               @Have:
000C4Dr 2  18             clc
000C4Er 2  69 04          adc #FIELD_X
000C50r 2  AA             tax                           ; X = panel column, Y = panel row
000C51r 2  68             pla                           ; A = tile
000C52r 2  4C rr rr       jmp RenderMark
000C55r 2               
000C55r 2               ; =============================================================================
000C55r 2               ;   Game over (SPEC 13.4)
000C55r 2               ; =============================================================================
000C55r 2               
000C55r 2               ; -----------------------------------------------------------------------------
000C55r 2               ;   AnimPetrifyBegin — start the well turning to stone from the floor up
000C55r 2               ;   Out: nothing.  Modifies: A
000C55r 2               ; -----------------------------------------------------------------------------
000C55r 2               AnimPetrifyBegin:
000C55r 2  A9 0F          lda #(BOARD_H - 1)
000C57r 2  8D rr rr       sta PetrifyRow
000C5Ar 2  A9 02          lda #PETRIFY_FRAMES
000C5Cr 2  8D rr rr       sta AnimTimer
000C5Fr 2  60             rts
000C60r 2               
000C60r 2               ; -----------------------------------------------------------------------------
000C60r 2               ;   AnimPetrifyTick — one frame of it
000C60r 2               ;   Out: C set while it is still running, clear once the well is stone.
000C60r 2               ;        Modifies: A, X, Y, AnimIdx, AnimEnd, AnimTimer, PetrifyRow, Board
000C60r 2               ;   SPEC 13.4 — a row every PETRIFY_FRAMES, bottom upward, 32 frames in all.
000C60r 2               ;
000C60r 2               ;   Each cell sets as ITS OWN SHAPE, because group 15 holds the petrified
000C60r 2               ;   glyphs at the same five offsets the potions use (SPEC A.3): one AND and
000C60r 2               ;   one ORA, and a bomb sets as a stone bomb at the exact moment the player is
000C60r 2               ;   looking hardest at the board. Empty cells stay empty — the pile petrifies,
000C60r 2               ;   not the well.
000C60r 2               ;
000C60r 2               ;   A prism has no stone twin, so it sets as the plain one. Testing the colour
000C60r 2               ;   first is what keeps it off `PETRIFY_BASE + 3`, a stone bomb, which is what
000C60r 2               ;   a rotating prism's glyph bits would otherwise buy (AnimPrismTick above).
000C60r 2               ; -----------------------------------------------------------------------------
000C60r 2               AnimPetrifyTick:
000C60r 2  AD rr rr       lda PetrifyRow
000C63r 2  30 42          bmi @Finished                 ; $FF — the whole well is stone
000C65r 2  CE rr rr       dec AnimTimer
000C68r 2  D0 3B          bne @Running
000C6Ar 2               
000C6Ar 2  A9 02          lda #PETRIFY_FRAMES
000C6Cr 2  8D rr rr       sta AnimTimer
000C6Fr 2  AD rr rr       lda PetrifyRow
000C72r 2  0A             asl a                         ; Row base — the board's stride is 8
000C73r 2  0A             asl a
000C74r 2  0A             asl a
000C75r 2  85 rr          sta AnimIdx
000C77r 2  18             clc
000C78r 2  69 06          adc #BOARD_W
000C7Ar 2  85 rr          sta AnimEnd
000C7Cr 2               @Cell:
000C7Cr 2  A6 rr          ldx AnimIdx
000C7Er 2  BD rr rr       lda Board,x
000C81r 2  F0 17          beq @Next                     ; Empty stays empty (SPEC 13.4)
000C83r 2  29 F8          and #COLOR_MASK
000C85r 2  C9 70          cmp #WILD_BASE
000C87r 2  F0 09          beq @Prism
000C89r 2  BD rr rr       lda Board,x
000C8Cr 2  29 07          and #GLYPH_MASK
000C8Er 2  09 78          ora #PETRIFY_BASE
000C90r 2  D0 02          bne @Set                      ; Always — PETRIFY_BASE is 120
000C92r 2               @Prism:
000C92r 2  A9 78          lda #PETRIFY_BASE
000C94r 2               @Set:
000C94r 2  9D rr rr       sta Board,x
000C97r 2  20 rr rr       jsr RenderCell
000C9Ar 2               @Next:
000C9Ar 2  E6 rr          inc AnimIdx
000C9Cr 2  A5 rr          lda AnimIdx
000C9Er 2  C5 rr          cmp AnimEnd
000CA0r 2  90 DA          bcc @Cell
000CA2r 2  CE rr rr       dec PetrifyRow
000CA5r 2               @Running:
000CA5r 2  38             sec
000CA6r 2  60             rts
000CA7r 2               @Finished:
000CA7r 2  18             clc
000CA8r 2  60             rts
000CA9r 2               
000CA9r 1               .include "../src/score.asm"
000CA9r 2               ; =============================================================================
000CA9r 2               ;   score.asm — Wizards Lab, scoring
000CA9r 2               ; =============================================================================
000CA9r 2               ;   SPEC.md section 9. Seven digits of packed BCD in four bytes, low byte
000CA9r 2               ;   first; the top nibble of ScoreTop is held at zero. Every value in
000CA9r 2               ;   tables.inc is a multiple of ten, so scoring is a SED / ADC chain and never
000CA9r 2               ;   a multiply — the one place a tile count has to be multiplied by a table
000CA9r 2               ;   value, it is done as a loop of BCD additions, and the count is at most 21.
000CA9r 2               ;
000CA9r 2               ;   The score clamps at 9999999. It never wraps.
000CA9r 2               ;
000CA9r 2               ;   Display is always all seven digits, zero padded — see TextBcd. Nothing
000CA9r 2               ;   here strips a leading zero, and nothing downstream may either.
000CA9r 2               ;
000CA9r 2               ;   TWO WAYS IN, AND THEY ARE NOT INTERCHANGEABLE (D5):
000CA9r 2               ;
000CA9r 2               ;     CascadeAdd / CascadeAddTimes    points scored INSIDE a cascade. They go
000CA9r 2               ;                                     into Cascade{Lo,Mid,Hi} and stay there
000CA9r 2               ;                                     until CascadeSettle, because a star
000CA9r 2               ;                                     caught anywhere in the cascade doubles
000CA9r 2               ;                                     everything it scored, retroactively
000CA9r 2               ;                                     (SPEC 9.6).
000CA9r 2               ;     ScoreAward                      the awards SPEC 9.6 gives outside a
000CA9r 2               ;                                     cascade — the soft drop and the level-up
000CA9r 2               ;                                     bonus. These reach Score at once and a
000CA9r 2               ;                                     star never touches them.
000CA9r 2               ;
000CA9r 2               ;   Both funnel through ScoreBank, which is the only routine that writes
000CA9r 2               ;   Score, the only one that clamps, and the only one that can hand the high
000CA9r 2               ;   score over to the player.
000CA9r 2               ; =============================================================================
000CA9r 2               
000CA9r 2               ; -----------------------------------------------------------------------------
000CA9r 2               ;   ScoreHighInit — seed the session high score, once, at power-on
000CA9r 2               ;   SPEC 9.8 — the high score is not persisted; it starts at 0010000 on every
000CA9r 2               ;   power-on, which is the target the first game is played against. It then
000CA9r 2               ;   survives every game in the session, so this is deliberately NOT part of
000CA9r 2               ;   ScoreReset. Nothing may infer "cold boot" from the value being zero: BSS
000CA9r 2               ;   is not cleared on all three machines.
000CA9r 2               ;   Out: nothing.  Modifies: A
000CA9r 2               ; -----------------------------------------------------------------------------
000CA9r 2               ScoreHighInit:
000CA9r 2  A9 00          lda #HIGH_INIT_LO
000CABr 2  8D rr rr       sta HighLo
000CAEr 2  A9 00          lda #HIGH_INIT_MID
000CB0r 2  8D rr rr       sta HighMid
000CB3r 2  A9 01          lda #HIGH_INIT_HI
000CB5r 2  8D rr rr       sta HighHi
000CB8r 2  A9 00          lda #HIGH_INIT_TOP
000CBAr 2  8D rr rr       sta HighTop
000CBDr 2  A9 01          lda #$01                      ; BCD — the level the target was "set" on
000CBFr 2  8D rr rr       sta HighLevel
000CC2r 2  60             rts
000CC3r 2               
000CC3r 2               ; -----------------------------------------------------------------------------
000CC3r 2               ;   ScoreReset — zero the score for a new game
000CC3r 2               ;   Out: nothing.  Modifies: A
000CC3r 2               ;
000CC3r 2               ;   The high score itself is NOT reset (SPEC 9.8) — but the two flags that say
000CC3r 2               ;   what this game has done about it are, or the second game of a session
000CC3r 2               ;   would never flash.
000CC3r 2               ; -----------------------------------------------------------------------------
000CC3r 2               ScoreReset:
000CC3r 2  A9 00          lda #0
000CC5r 2  8D rr rr       sta ScoreLo
000CC8r 2  8D rr rr       sta ScoreMid
000CCBr 2  8D rr rr       sta ScoreHi
000CCEr 2  8D rr rr       sta ScoreTop
000CD1r 2  8D rr rr       sta CascadeLo
000CD4r 2  8D rr rr       sta CascadeMid
000CD7r 2  8D rr rr       sta CascadeHi
000CDAr 2  8D rr rr       sta StarCount
000CDDr 2  8D rr rr       sta HighOwned
000CE0r 2  8D rr rr       sta HighFlash
000CE3r 2  8D rr rr       sta HighTimer
000CE6r 2  60             rts
000CE7r 2               
000CE7r 2               ; -----------------------------------------------------------------------------
000CE7r 2               ;   CascadeAdd — add a 16-bit BCD value to the cascade accumulator
000CE7r 2               ;   In:  A = low BCD byte, X = high BCD byte
000CE7r 2               ;   Out: nothing.  Modifies: A, flags.  PRESERVES X and Y.
000CE7r 2               ;
000CE7r 2               ;   Preserving X and Y is what lets CascadeAddTimes loop over this without
000CE7r 2               ;   spilling anything, and Tmp0-Tmp3 may not be held across a JSR anyway
000CE7r 2               ;   (zeropage.inc).
000CE7r 2               ; -----------------------------------------------------------------------------
000CE7r 2               CascadeAdd:
000CE7r 2  F8             sed
000CE8r 2  18             clc
000CE9r 2  6D rr rr       adc CascadeLo
000CECr 2  8D rr rr       sta CascadeLo
000CEFr 2  8A             txa
000CF0r 2  6D rr rr       adc CascadeMid
000CF3r 2  8D rr rr       sta CascadeMid
000CF6r 2  AD rr rr       lda CascadeHi
000CF9r 2  69 00          adc #0
000CFBr 2  8D rr rr       sta CascadeHi
000CFEr 2  D8             cld                           ; CLD leaves the carry alone
000CFFr 2  B0 01          bcs CascadeClamp
000D01r 2  60             rts
000D02r 2               
000D02r 2               ; -----------------------------------------------------------------------------
000D02r 2               ;   CascadeClamp — six nines, when an accumulate would have wrapped
000D02r 2               ;   Out: nothing.  Modifies: A.  PRESERVES X and Y.
000D02r 2               ;
000D02r 2               ;   Not reachable by playing: nothing is ever ADDED to the board during a
000D02r 2               ;   cascade, so one cascade can never remove more than the 96 cells the well
000D02r 2               ;   holds, and 96 cells at the dearest tile value there is (650, SPEC 9.2)
000D02r 2               ;   plus every bonus in section 9 comes to a little over 200,000 — a fifth of
000D02r 2               ;   what three bytes hold, and an eighth of what it would take to wrap after
000D02r 2               ;   the star cap has doubled it three times. It is here because "never wraps"
000D02r 2               ;   in SPEC 9 has to be true of every accumulator on the path, not just of the
000D02r 2               ;   one the player can see.
000D02r 2               ; -----------------------------------------------------------------------------
000D02r 2               CascadeClamp:
000D02r 2  A9 99          lda #$99
000D04r 2  8D rr rr       sta CascadeLo
000D07r 2  8D rr rr       sta CascadeMid
000D0Ar 2  8D rr rr       sta CascadeHi
000D0Dr 2  60             rts
000D0Er 2               
000D0Er 2               ; -----------------------------------------------------------------------------
000D0Er 2               ;   CascadeAddTimes — add a value N times (the tiles-cleared multiply)
000D0Er 2               ;   In:  A = low BCD, X = high BCD, Y = count
000D0Er 2               ;   Out: nothing.  Modifies: A, Y, flags.  PRESERVES X.
000D0Er 2               ;
000D0Er 2               ;   SPEC 9 chose values that are all multiples of ten so that scoring is an
000D0Er 2               ;   ADC chain, but `length * TileValue[chain]` is still a multiply. The count
000D0Er 2               ;   is a run length — three to sixteen — so a loop of BCD additions is both
000D0Er 2               ;   smaller and, at these counts, faster than any multiply routine worth
000D0Er 2               ;   writing.
000D0Er 2               ; -----------------------------------------------------------------------------
000D0Er 2               CascadeAddTimes:
000D0Er 2  48             pha                           ; The low byte rides the stack, because
000D0Fr 2               @Loop:                          ;   CascadeAdd returns in A
000D0Fr 2  C0 00          cpy #0
000D11r 2  F0 08          beq @Done
000D13r 2  68             pla
000D14r 2  48             pha
000D15r 2  20 rr rr       jsr CascadeAdd
000D18r 2  88             dey
000D19r 2  D0 F4          bne @Loop
000D1Br 2               @Done:
000D1Br 2  68             pla
000D1Cr 2  60             rts
000D1Dr 2               
000D1Dr 2               ; -----------------------------------------------------------------------------
000D1Dr 2               ;   CascadeDouble — one BCD doubling of the cascade accumulator
000D1Dr 2               ;   Out: nothing.  Modifies: A, flags.  PRESERVES X and Y.
000D1Dr 2               ;   A doubling in BCD is a self-addition; three of them is the star cap.
000D1Dr 2               ; -----------------------------------------------------------------------------
000D1Dr 2               CascadeDouble:
000D1Dr 2  F8             sed
000D1Er 2  18             clc
000D1Fr 2  AD rr rr       lda CascadeLo
000D22r 2  6D rr rr       adc CascadeLo
000D25r 2  8D rr rr       sta CascadeLo
000D28r 2  AD rr rr       lda CascadeMid
000D2Br 2  6D rr rr       adc CascadeMid
000D2Er 2  8D rr rr       sta CascadeMid
000D31r 2  AD rr rr       lda CascadeHi
000D34r 2  6D rr rr       adc CascadeHi
000D37r 2  8D rr rr       sta CascadeHi
000D3Ar 2  D8             cld
000D3Br 2  B0 C5          bcs CascadeClamp
000D3Dr 2  60             rts
000D3Er 2               
000D3Er 2               ; -----------------------------------------------------------------------------
000D3Er 2               ;   ScoreAdd — bank the cascade accumulator into Score, clamped
000D3Er 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
000D3Er 2               ;   SPEC 9.8 — the high score updates live, so the player watches the overtake.
000D3Er 2               ; -----------------------------------------------------------------------------
000D3Er 2               ScoreAdd:
000D3Er 2  AD rr rr       lda CascadeLo
000D41r 2  85 rr          sta Tmp0
000D43r 2  AD rr rr       lda CascadeMid
000D46r 2  85 rr          sta Tmp1
000D48r 2  AD rr rr       lda CascadeHi
000D4Br 2  85 rr          sta Tmp2
000D4Dr 2  4C rr rr       jmp ScoreBank
000D50r 2               
000D50r 2               ; -----------------------------------------------------------------------------
000D50r 2               ;   ScoreAward — add a 16-bit BCD value straight to Score
000D50r 2               ;   In:  A = low BCD byte, X = high BCD byte
000D50r 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
000D50r 2               ;
000D50r 2               ;   The two awards SPEC 9.6 gives outside a cascade: one point a row for a
000D50r 2               ;   soft drop, and BONUS_LEVELUP when the level advances. Neither is a cascade
000D50r 2               ;   point and neither is doubled by a star, which is the whole reason they do
000D50r 2               ;   not go through CascadeAdd.
000D50r 2               ; -----------------------------------------------------------------------------
000D50r 2               ScoreAward:
000D50r 2  85 rr          sta Tmp0
000D52r 2  86 rr          stx Tmp1
000D54r 2  A9 00          lda #0
000D56r 2  85 rr          sta Tmp2
000D58r 2                 ; falls through into ScoreBank
000D58r 2               
000D58r 2               ; -----------------------------------------------------------------------------
000D58r 2               ;   ScoreBank — Score += the three BCD bytes in Tmp0-Tmp2, clamped at 9999999
000D58r 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
000D58r 2               ;
000D58r 2               ;   The only writer of Score. It redraws the field itself, because there is no
000D58r 2               ;   other moment at which the score is known to have changed (SPEC 12.6 —
000D58r 2               ;   nothing polls).
000D58r 2               ; -----------------------------------------------------------------------------
000D58r 2               ScoreBank:
000D58r 2  F8             sed
000D59r 2  18             clc
000D5Ar 2  AD rr rr       lda ScoreLo
000D5Dr 2  65 rr          adc Tmp0
000D5Fr 2  8D rr rr       sta ScoreLo
000D62r 2  AD rr rr       lda ScoreMid
000D65r 2  65 rr          adc Tmp1
000D67r 2  8D rr rr       sta ScoreMid
000D6Ar 2  AD rr rr       lda ScoreHi
000D6Dr 2  65 rr          adc Tmp2
000D6Fr 2  8D rr rr       sta ScoreHi
000D72r 2  AD rr rr       lda ScoreTop
000D75r 2  69 00          adc #0
000D77r 2  8D rr rr       sta ScoreTop
000D7Ar 2  D8             cld                           ; CLD leaves the carry alone
000D7Br 2  B0 07          bcs @Clamp
000D7Dr 2  AD rr rr       lda ScoreTop                  ; The eighth digit is held at zero (SPEC 9),
000D80r 2  C9 10          cmp #$10                      ;   so anything that reached it has overflowed
000D82r 2  90 10          bcc @Drawn                    ;   the seven the panel shows
000D84r 2               @Clamp:
000D84r 2  A9 99          lda #$99
000D86r 2  8D rr rr       sta ScoreLo
000D89r 2  8D rr rr       sta ScoreMid
000D8Cr 2  8D rr rr       sta ScoreHi
000D8Fr 2  A9 09          lda #$09
000D91r 2  8D rr rr       sta ScoreTop
000D94r 2               @Drawn:
000D94r 2  20 rr rr       jsr RenderScore
000D97r 2                 ; falls through into ScoreHighCheck
000D97r 2               
000D97r 2               ; -----------------------------------------------------------------------------
000D97r 2               ;   ScoreHighCheck — hand the high score over the moment the score reaches it
000D97r 2               ;   Out: C set if the score is level with or past the high score — which, once
000D97r 2               ;        it has been taken, is EVERY call. The one-shot is HighOwned below, not
000D97r 2               ;        this flag; nothing currently reads it.  Modifies: A, X, Y, Tmp0
000D97r 2               ;
000D97r 2               ;   SPEC 9.8. The copy happens on every call once the score is level with the
000D97r 2               ;   high score, not just on the first — that is what keeps HighLevel tracking
000D97r 2               ;   the live level while a run is holding its own record, which is the point of
000D97r 2               ;   the number: it says how deep you have to get to beat it.
000D97r 2               ;
000D97r 2               ;   The fanfare and the flash are the one-shot half, and HighOwned is what
000D97r 2               ;   makes them one: without it every subsequent bank would fire them again,
000D97r 2               ;   because from the overtake onward the score and the high score are equal.
000D97r 2               ; -----------------------------------------------------------------------------
000D97r 2               ScoreHighCheck:
000D97r 2  AD rr rr       lda HighTop                   ; Four-byte compare, most significant first
000D9Ar 2  CD rr rr       cmp ScoreTop
000D9Dr 2  D0 16          bne @Test
000D9Fr 2  AD rr rr       lda HighHi
000DA2r 2  CD rr rr       cmp ScoreHi
000DA5r 2  D0 0E          bne @Test
000DA7r 2  AD rr rr       lda HighMid
000DAAr 2  CD rr rr       cmp ScoreMid
000DADr 2  D0 06          bne @Test
000DAFr 2  AD rr rr       lda HighLo
000DB2r 2  CD rr rr       cmp ScoreLo
000DB5r 2               @Test:
000DB5r 2  90 02          bcc @Take                     ; high < score
000DB7r 2  D0 3E          bne @Behind                   ; high > score — nothing to do
000DB9r 2                                               ; equal: still copy, so HighLevel tracks
000DB9r 2               @Take:
000DB9r 2  AD rr rr       lda ScoreLo
000DBCr 2  8D rr rr       sta HighLo
000DBFr 2  AD rr rr       lda ScoreMid
000DC2r 2  8D rr rr       sta HighMid
000DC5r 2  AD rr rr       lda ScoreHi
000DC8r 2  8D rr rr       sta HighHi
000DCBr 2  AD rr rr       lda ScoreTop
000DCEr 2  8D rr rr       sta HighTop
000DD1r 2  20 rr rr       jsr ScoreLevelBcd             ; The level box under the digits is BCD; Level
000DD4r 2  8D rr rr       sta HighLevel                 ;   itself is binary (SPEC 12.2)
000DD7r 2  20 rr rr       jsr RenderHigh
000DDAr 2               
000DDAr 2  AD rr rr       lda HighOwned
000DDDr 2  D0 16          bne @Owned
000DDFr 2  EE rr rr       inc HighOwned
000DE2r 2  A9 0B          lda #SFX_HIGHSCORE            ; SPEC 9.8 — a longer fanfare, once
000DE4r 2  20 rr rr       jsr SfxPlay
000DE7r 2  A9 06          lda #HIGH_FLASH_BLINKS
000DE9r 2  8D rr rr       sta HighFlash
000DECr 2  AE rr rr       ldx Region
000DEFr 2  BD rr rr       lda BlinkHalf,x
000DF2r 2  8D rr rr       sta HighTimer
000DF5r 2               @Owned:
000DF5r 2  38             sec
000DF6r 2  60             rts
000DF7r 2               
000DF7r 2               @Behind:
000DF7r 2  18             clc
000DF8r 2  60             rts
000DF9r 2               
000DF9r 2               ; -----------------------------------------------------------------------------
000DF9r 2               ;   ScoreLevelBcd — Level (binary 1-99) as one packed BCD byte
000DF9r 2               ;   Out: A = the level in BCD.  Modifies: A, X, Tmp0
000DF9r 2               ; -----------------------------------------------------------------------------
000DF9r 2               ScoreLevelBcd:
000DF9r 2  AD rr rr       lda Level
000DFCr 2  A2 00          ldx #0
000DFEr 2               @Tens:
000DFEr 2  C9 0A          cmp #10
000E00r 2  90 05          bcc @Split
000E02r 2  E9 0A          sbc #10                       ; Carry is set by the CMP that got us here
000E04r 2  E8             inx
000E05r 2  D0 F7          bne @Tens                     ; Always — X tops out at 9
000E07r 2               @Split:
000E07r 2  85 rr          sta Tmp0                      ; Units
000E09r 2  8A             txa
000E0Ar 2  0A             asl a
000E0Br 2  0A             asl a
000E0Cr 2  0A             asl a
000E0Dr 2  0A             asl a
000E0Er 2  05 rr          ora Tmp0
000E10r 2  60             rts
000E11r 2               
000E11r 2               ; -----------------------------------------------------------------------------
000E11r 2               ;   ScoreSoftDrop — one point for one row descended under soft drop (SPEC 9.6)
000E11r 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0-Tmp2
000E11r 2               ;
000E11r 2               ;   The one award in the game that is not a multiple of ten. BCD does not care.
000E11r 2               ; -----------------------------------------------------------------------------
000E11r 2               ScoreSoftDrop:
000E11r 2  A9 01          lda #$01
000E13r 2  A2 00          ldx #$00
000E15r 2  4C rr rr       jmp ScoreAward
000E18r 2               
000E18r 2               ; -----------------------------------------------------------------------------
000E18r 2               ;   ScoreLevelCheck — advance the level when 30 tiles have gone
000E18r 2               ;   In:  A = tiles removed this step
000E18r 2               ;   Out: C set if the level advanced.  Modifies: A, X, Y, Tmp0-Tmp2
000E18r 2               ;   SPEC 10.1 — at most one advance per step, surplus carries over, so a big
000E18r 2               ;   fireball chain can never skip a level. Match and effect removals both
000E18r 2               ;   count, which is why the count comes from CascadeRemove and not from the
000E18r 2               ;   scan: by then the two are the same cells.
000E18r 2               ; -----------------------------------------------------------------------------
000E18r 2               ScoreLevelCheck:
000E18r 2  18             clc
000E19r 2  6D rr rr       adc TilesCleared
000E1Cr 2  8D rr rr       sta TilesCleared              ; A whole step can clear far more than thirty;
000E1Fr 2  C9 1E          cmp #LEVEL_TILES              ;   the surplus stays here and buys the next
000E21r 2  90 23          bcc @No                       ;   level on the next step
000E23r 2  E9 1E          sbc #LEVEL_TILES              ; Carry is set by the CMP that got us here
000E25r 2  8D rr rr       sta TilesCleared
000E28r 2               
000E28r 2  AD rr rr       lda Level
000E2Br 2  C9 63          cmp #LEVEL_MAX_SHOWN
000E2Dr 2  B0 17          bcs @No                       ; The box is two digits wide (SPEC 10.1), and
000E2Fr 2  EE rr rr       inc Level                     ;   nothing about level 100 is reachable in a
000E32r 2  20 rr rr       jsr RenderLevel               ;   session anyway
000E35r 2  20 rr rr       jsr AnimBannerLevel           ; SPEC 14 — and play carries straight on; the
000E38r 2                                               ;   band clears itself BannerFrames later
000E38r 2  A9 0A          lda #SFX_LEVELUP
000E3Ar 2  20 rr rr       jsr SfxPlay
000E3Dr 2  A9 00          lda #<BONUS_LEVELUP           ; SPEC 9.6 — an award, not a cascade point, so
000E3Fr 2  A2 10          ldx #>BONUS_LEVELUP           ;   a star in the same cascade does not double
000E41r 2  20 rr rr       jsr ScoreAward                ;   it (D5)
000E44r 2  38             sec
000E45r 2  60             rts
000E46r 2               @No:
000E46r 2  18             clc
000E47r 2  60             rts
000E48r 2               
000E48r 2               ; -----------------------------------------------------------------------------
000E48r 2               ;   ScoreFlashTick — one frame of the HIGH field's overtake flash
000E48r 2               ;   Out: nothing.  Modifies: A, X, Y
000E48r 2               ;   SPEC 9.8, SPEC 14 — the blink period is 30 frames NTSC / 25 PAL, shared
000E48r 2               ;   with the title screen's prompt, so HighFlash counts HALF blinks and
000E48r 2               ;   HighTimer counts the frames of one.
000E48r 2               ;
000E48r 2               ;   HighFlash is odd on the dark half and even on the lit one, and it ends at
000E48r 2               ;   zero, so the field is always left readable however the count is set.
000E48r 2               ; -----------------------------------------------------------------------------
000E48r 2               ScoreFlashTick:
000E48r 2  AD rr rr       lda HighFlash
000E4Br 2  F0 1F          beq @Done
000E4Dr 2  CE rr rr       dec HighTimer
000E50r 2  D0 1A          bne @Done
000E52r 2  CE rr rr       dec HighFlash
000E55r 2  F0 12          beq @Show                     ; Out of blinks — end lit
000E57r 2  AE rr rr       ldx Region
000E5Ar 2  BD rr rr       lda BlinkHalf,x
000E5Dr 2  8D rr rr       sta HighTimer
000E60r 2  AD rr rr       lda HighFlash
000E63r 2  4A             lsr a
000E64r 2  90 03          bcc @Show
000E66r 2  4C rr rr       jmp RenderHighBlank
000E69r 2               @Show:
000E69r 2  4C rr rr       jmp RenderHigh
000E6Cr 2               @Done:
000E6Cr 2  60             rts
000E6Dr 2               
000E6Dr 2               ; -----------------------------------------------------------------------------
000E6Dr 2               ;   ScoreGravity — frames per row for the current level
000E6Dr 2               ;   Out: A = frame count, from SpeedNTSC or SpeedPAL per Region.
000E6Dr 2               ;        Modifies: A, X
000E6Dr 2               ;   SPEC 10.2. Strictly this module is P4's, but the falling piece cannot fall
000E6Dr 2               ;   without it, so it is real ahead of the rest of the file — the same reason
000E6Dr 2               ;   ScoreHighInit landed here in P1.
000E6Dr 2               ; -----------------------------------------------------------------------------
000E6Dr 2               ScoreGravity:
000E6Dr 2  AE rr rr       ldx Level
000E70r 2  CA             dex                           ; The table is indexed by level - 1 ...
000E71r 2  E0 10          cpx #LEVEL_SPEED_CAP
000E73r 2  90 02          bcc @Level
000E75r 2  A2 0F          ldx #LEVEL_SPEED_CAP - 1      ;   ... and stops improving at the cap
000E77r 2               @Level:
000E77r 2  AD rr rr       lda Region
000E7Ar 2  D0 04          bne @Pal
000E7Cr 2  BD rr rr       lda SpeedNTSC,x
000E7Fr 2  60             rts
000E80r 2               @Pal:
000E80r 2  BD rr rr       lda SpeedPAL,x
000E83r 2  60             rts
000E84r 2               
000E84r 1               .include "../src/render.asm"
000E84r 2               ; =============================================================================
000E84r 2               ;   render.asm — Wizards Lab, the dirty-cell renderer
000E84r 2               ; =============================================================================
000E84r 2               ;   SPEC.md section 12.6. The screen is never fully redrawn during play.
000E84r 2               ;   Changed cells are appended to a ring and flushed once a frame, at most
000E84r 2               ;   DIRTY_FLUSH_MAX per frame with the remainder carried over.
000E84r 2               ;
000E84r 2               ;   The cap is NOT a hardware write-spacing limit. S1 measured this loop at
000E84r 2               ;   165 cycles a cell on the AC6502, which puts two VRAM data writes 165 us
000E84r 2               ;   apart at 1 MHz and the closest two VDP PORT accesses 8 cycles apart —
000E84r 2               ;   inside even a real TMS9918A's 8 us and 2 us windows with two orders of
000E84r 2               ;   magnitude to spare, and further inside a pico9918's, which emulates VRAM
000E84r 2               ;   in RP2040 memory and has no display contention at all. A 6502 at this
000E84r 2               ;   clock cannot write a TMS9918 too fast however hard it tries.
000E84r 2               ;
000E84r 2               ;   The cap is a TIME BUDGET: DIRTY_FLUSH_MAX cells is what fits in vertical
000E84r 2               ;   blank on the tightest of the three. See constants.inc and PLAN.md S1.
000E84r 2               ;
000E84r 2               ;   All screen access goes through HalPlotCell (see hal.inc). Nothing in this
000E84r 2               ;   file knows where screen memory is.
000E84r 2               ; =============================================================================
000E84r 2               
000E84r 2               ; -----------------------------------------------------------------------------
000E84r 2               ;   RenderDirtyReset — empty the ring and cancel any outstanding board redraw
000E84r 2               ;   Call this after anything that draws the whole screen behind the renderer's
000E84r 2               ;   back (HalBlitScreen), because every queued cell then describes a screen
000E84r 2               ;   that no longer exists.
000E84r 2               ;   In:  nothing        Out: nothing.  Modifies: A
000E84r 2               ; -----------------------------------------------------------------------------
000E84r 2               RenderDirtyReset:
000E84r 2  A9 00          lda #0
000E86r 2  8D rr rr       sta DirtyCount
000E89r 2  8D rr rr       sta DirtyHead
000E8Cr 2  8D rr rr       sta DirtyTail
000E8Fr 2  8D rr rr       sta RedrawWash
000E92r 2  A9 FF          lda #$FF
000E94r 2  8D rr rr       sta RedrawIdx
000E97r 2  60             rts
000E98r 2               
000E98r 2               ; -----------------------------------------------------------------------------
000E98r 2               ;   RenderMark — queue one panel cell
000E98r 2               ;   In:  A = tile, X = panel column, Y = panel row
000E98r 2               ;   Out: nothing.  Modifies: A, X.  PRESERVES Y and every byte of zero page.
000E98r 2               ;
000E98r 2               ;   The PANEL_X / PANEL_Y offset is applied here, once, so nothing upstream
000E98r 2               ;   has to know which machine it is running on.
000E98r 2               ;
000E98r 2               ;   Preserving Y and zero page is a contract, not an accident: text.asm holds
000E98r 2               ;   its string cursor across this call (see zeropage.inc). The three values
000E98r 2               ;   ride the stack rather than scratch bytes because A, X and Y are all live
000E98r 2               ;   at once and there is no fourth register to index the ring with.
000E98r 2               ;
000E98r 2               ;   A mark that arrives with the ring full is DROPPED, silently (D6).
000E98r 2               ; -----------------------------------------------------------------------------
000E98r 2               RenderMark:
000E98r 2  48             pha                           ; Tile
000E99r 2  98             tya
000E9Ar 2  18             clc
000E9Br 2  69 00          adc #PANEL_Y                  ; Panel row -> screen row
000E9Dr 2  48             pha
000E9Er 2  8A             txa
000E9Fr 2  18             clc
000EA0r 2  69 05          adc #PANEL_X                  ; Panel column -> screen column
000EA2r 2  48             pha
000EA3r 2               
000EA3r 2  AD rr rr       lda DirtyCount
000EA6r 2  C9 40          cmp #DIRTY_ENTRIES
000EA8r 2  B0 1F          bcs @Full
000EAAr 2  EE rr rr       inc DirtyCount
000EADr 2               
000EADr 2  AE rr rr       ldx DirtyTail
000EB0r 2  68             pla
000EB1r 2  9D rr rr       sta Dirty+0,x                 ; Screen column
000EB4r 2  68             pla
000EB5r 2  9D rr rr       sta Dirty+1,x                 ; Screen row
000EB8r 2  68             pla
000EB9r 2  9D rr rr       sta Dirty+2,x                 ; Tile
000EBCr 2               
000EBCr 2  E8             inx                           ; Step one entry, wrapping the ring
000EBDr 2  E8             inx
000EBEr 2  E8             inx
000EBFr 2  E0 C0          cpx #DIRTY_BYTES
000EC1r 2  90 02          bcc @Store
000EC3r 2  A2 00          ldx #0
000EC5r 2               @Store:
000EC5r 2  8E rr rr       stx DirtyTail
000EC8r 2  60             rts
000EC9r 2               
000EC9r 2               @Full:
000EC9r 2  68             pla                           ; Unwind and drop it. The cell is wrong until
000ECAr 2  68             pla                           ;   something marks it again.
000ECBr 2  68             pla
000ECCr 2  60             rts
000ECDr 2               
000ECDr 2               ; -----------------------------------------------------------------------------
000ECDr 2               ;   RenderFlush — push up to DIRTY_FLUSH_MAX queued cells to the screen
000ECDr 2               ;   Called once per frame, from the top of the main loop.
000ECDr 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
000ECDr 2               ; -----------------------------------------------------------------------------
000ECDr 2               RenderFlush:
000ECDr 2  20 rr rr       jsr RenderBoardStep           ; Top the ring up from a board redraw, if one
000ED0r 2                                               ;   is outstanding, so it always makes progress
000ED0r 2  AD rr rr       lda DirtyCount
000ED3r 2  F0 31          beq @Done
000ED5r 2  C9 18          cmp #DIRTY_FLUSH_MAX
000ED7r 2  90 02          bcc @Budget
000ED9r 2  A9 18          lda #DIRTY_FLUSH_MAX
000EDBr 2               @Budget:
000EDBr 2  85 rr          sta FlushLeft
000EDDr 2               
000EDDr 2               @Cell:
000EDDr 2  AE rr rr       ldx DirtyHead
000EE0r 2  BD rr rr       lda Dirty+1,x
000EE3r 2  A8             tay                           ; Y = screen row
000EE4r 2  BD rr rr       lda Dirty+2,x
000EE7r 2  48             pha                           ; Tile
000EE8r 2  BD rr rr       lda Dirty+0,x
000EEBr 2  AA             tax                           ; X = screen column
000EECr 2  68             pla                           ; A = tile
000EEDr 2  20 rr rr       jsr HalPlotCell
000EF0r 2               
000EF0r 2  AD rr rr       lda DirtyHead                 ; Step one entry, wrapping the ring
000EF3r 2  18             clc
000EF4r 2  69 03          adc #3
000EF6r 2  C9 C0          cmp #DIRTY_BYTES
000EF8r 2  90 02          bcc @Store
000EFAr 2  A9 00          lda #0
000EFCr 2               @Store:
000EFCr 2  8D rr rr       sta DirtyHead
000EFFr 2  CE rr rr       dec DirtyCount
000F02r 2  C6 rr          dec FlushLeft
000F04r 2  D0 D7          bne @Cell
000F06r 2               @Done:
000F06r 2  60             rts
000F07r 2               
000F07r 2               ; -----------------------------------------------------------------------------
000F07r 2               ;   RenderBoard — ask for the whole 6 x 16 well to be redrawn
000F07r 2               ;   Used on state entry and after a pause, not per frame.
000F07r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000F07r 2               ;
000F07r 2               ;   The well is 96 cells and the ring holds DIRTY_ENTRIES; a redraw therefore
000F07r 2               ;   cannot be queued in one go. This only sets the cursor. RenderBoardStep,
000F07r 2               ;   which RenderFlush calls every frame, feeds the ring as fast as it drains,
000F07r 2               ;   so the redraw spreads over as many frames as it needs and never drops a
000F07r 2               ;   cell.
000F07r 2               ; -----------------------------------------------------------------------------
000F07r 2               RenderBoard:
000F07r 2  A9 00          lda #0
000F09r 2  8D rr rr       sta RedrawWash                ; From the board, not the PAUSE wash
000F0Cr 2  8D rr rr       sta RedrawIdx                 ; Board index 0 = row 0, column 0
000F0Fr 2  60             rts                           ; And nothing else. Falling through into the
000F10r 2                                               ;   step below would fill the ring here and
000F10r 2                                               ;   drop whatever the caller marks next.
000F10r 2               
000F10r 2               ; -----------------------------------------------------------------------------
000F10r 2               ;   RenderWash — ask for the well to be covered rather than shown
000F10r 2               ;   In:  nothing        Out: nothing.  Modifies: A
000F10r 2               ;   SPEC 13.3 — pausing washes all 96 cells with TILE_WASH so the board cannot
000F10r 2               ;   be studied while the clock is stopped. A wash and not a blank: a blanked
000F10r 2               ;   well reads as a crash, a stippled one reads as covered.
000F10r 2               ;
000F10r 2               ;   The same cursor as RenderBoard, because it is the same 96 cells against
000F10r 2               ;   the same 64-entry ring, and it is undone the same way — the resume calls
000F10r 2               ;   RenderBoard, which turns the flag off and repaints every cell from the
000F10r 2               ;   board it never stopped being (D12).
000F10r 2               ; -----------------------------------------------------------------------------
000F10r 2               RenderWash:
000F10r 2  A9 07          lda #TILE_WASH
000F12r 2  8D rr rr       sta RedrawWash
000F15r 2  A9 00          lda #0
000F17r 2  8D rr rr       sta RedrawIdx
000F1Ar 2  60             rts
000F1Br 2               
000F1Br 2               ; -----------------------------------------------------------------------------
000F1Br 2               ;   RenderBoardStep — queue as much of an outstanding board redraw as fits
000F1Br 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000F1Br 2               ;   Does nothing when RedrawIdx is $FF.
000F1Br 2               ; -----------------------------------------------------------------------------
000F1Br 2               RenderBoardStep:
000F1Br 2  AD rr rr       lda RedrawIdx
000F1Er 2  30 46          bmi @Done                     ; $FF — nothing outstanding
000F20r 2               
000F20r 2               @Cell:
000F20r 2  AD rr rr       lda DirtyCount
000F23r 2  C9 40          cmp #DIRTY_ENTRIES
000F25r 2  B0 3F          bcs @Done                     ; Ring full — pick this cell up next frame
000F27r 2               
000F27r 2  AE rr rr       ldx RedrawIdx
000F2Ar 2  8A             txa
000F2Br 2  29 07          and #(BOARD_STRIDE - 1)
000F2Dr 2  18             clc
000F2Er 2  69 01          adc #WELL_ORIGIN_X
000F30r 2  85 rr          sta RedrawCol
000F32r 2  8A             txa
000F33r 2  4A             lsr a                         ; Board index >> 3 is the row (stride 8)
000F34r 2  4A             lsr a
000F35r 2  4A             lsr a
000F36r 2  18             clc
000F37r 2  69 04          adc #WELL_ORIGIN_Y
000F39r 2  A8             tay                           ; Y = panel row
000F3Ar 2  AD rr rr       lda RedrawWash                ; The PAUSE wash is the same walk drawing one
000F3Dr 2  D0 03          bne @Tile                     ;   tile over every cell instead (SPEC 13.3)
000F3Fr 2  BD rr rr       lda Board,x                   ; The board byte IS the tile — empty is $00,
000F42r 2               @Tile:                          ;   which is TILE_BLANK (SPEC 3.3, 4.2)
000F42r 2  A6 rr          ldx RedrawCol
000F44r 2  20 rr rr       jsr RenderMark
000F47r 2               
000F47r 2  AE rr rr       ldx RedrawIdx                 ; Advance, stepping over the two sentinel
000F4Ar 2  E8             inx                           ;   columns at the end of each row
000F4Br 2  8A             txa
000F4Cr 2  29 07          and #(BOARD_STRIDE - 1)
000F4Er 2  C9 06          cmp #BOARD_W
000F50r 2  90 05          bcc @Save
000F52r 2  8A             txa
000F53r 2  18             clc
000F54r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000F56r 2  AA             tax
000F57r 2               @Save:
000F57r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
000F59r 2  B0 06          bcs @Finish
000F5Br 2  8E rr rr       stx RedrawIdx
000F5Er 2  4C rr rr       jmp @Cell
000F61r 2               
000F61r 2               @Finish:
000F61r 2  A9 FF          lda #$FF
000F63r 2  8D rr rr       sta RedrawIdx
000F66r 2               @Done:
000F66r 2  60             rts
000F67r 2               
000F67r 2               ; -----------------------------------------------------------------------------
000F67r 2               ;   RenderCell — queue one board cell by board index
000F67r 2               ;   In:  X = board index (row * BOARD_STRIDE + column)
000F67r 2               ;   Out: nothing.  Modifies: A, X, Y
000F67r 2               ;   The single-cell form of RenderBoardStep, for the phases that move one tile
000F67r 2               ;   at a time.
000F67r 2               ; -----------------------------------------------------------------------------
000F67r 2               RenderCell:
000F67r 2  BD rr rr       lda Board,x                   ; The board byte IS the tile (SPEC 3.3)
000F6Ar 2                 ; falls through
000F6Ar 2               
000F6Ar 2               ; -----------------------------------------------------------------------------
000F6Ar 2               ;   RenderCellAs — queue one board cell showing something else entirely
000F6Ar 2               ;   In:  X = board index, A = tile
000F6Ar 2               ;   Out: nothing.  Modifies: A, X, Y
000F6Ar 2               ;
000F6Ar 2               ;   The animation frames are the only tiles in the game that are NOT what the
000F6Ar 2               ;   board holds: a glow glyph, a beam, a ring frame and a blip frame are all
000F6Ar 2               ;   drawn over a cell whose board byte still says what it really is, right up
000F6Ar 2               ;   until CascadeRemove zeroes it (anim.asm, SPEC 8 step 5). Everything else
000F6Ar 2               ;   goes through RenderCell above and never has to think about it.
000F6Ar 2               ; -----------------------------------------------------------------------------
000F6Ar 2               RenderCellAs:
000F6Ar 2  48             pha
000F6Br 2  8A             txa
000F6Cr 2  29 07          and #(BOARD_STRIDE - 1)
000F6Er 2  18             clc
000F6Fr 2  69 01          adc #WELL_ORIGIN_X
000F71r 2  85 rr          sta RedrawCol
000F73r 2  8A             txa
000F74r 2  4A             lsr a
000F75r 2  4A             lsr a
000F76r 2  4A             lsr a
000F77r 2  18             clc
000F78r 2  69 04          adc #WELL_ORIGIN_Y
000F7Ar 2  A8             tay
000F7Br 2  68             pla
000F7Cr 2  A6 rr          ldx RedrawCol
000F7Er 2  4C rr rr       jmp RenderMark
000F81r 2               
000F81r 2               ; -----------------------------------------------------------------------------
000F81r 2               ;   RenderPiece — queue the three falling cells at where the piece is now
000F81r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000F81r 2               ;
000F81r 2               ;   RenderMark clobbers X and keeps Y, so the panel column is parked in
000F81r 2               ;   RedrawCol and the panel row rides Y down the three cells. Cell C can never
000F81r 2               ;   be lower than board row 15, so all three are always inside the well and
000F81r 2               ;   there is nothing to clip.
000F81r 2               ; -----------------------------------------------------------------------------
000F81r 2               RenderPiece:
000F81r 2  AD rr rr       lda PieceCol
000F84r 2  18             clc
000F85r 2  69 01          adc #WELL_ORIGIN_X
000F87r 2  85 rr          sta RedrawCol
000F89r 2  AD rr rr       lda PieceRow
000F8Cr 2  18             clc
000F8Dr 2  69 04          adc #WELL_ORIGIN_Y
000F8Fr 2  A8             tay
000F90r 2  AD rr rr       lda PieceA
000F93r 2  A6 rr          ldx RedrawCol
000F95r 2  20 rr rr       jsr RenderMark
000F98r 2  C8             iny
000F99r 2  AD rr rr       lda PieceB
000F9Cr 2  A6 rr          ldx RedrawCol
000F9Er 2  20 rr rr       jsr RenderMark
000FA1r 2  C8             iny
000FA2r 2  AD rr rr       lda PieceC
000FA5r 2  A6 rr          ldx RedrawCol
000FA7r 2  4C rr rr       jmp RenderMark
000FAAr 2               
000FAAr 2               ; -----------------------------------------------------------------------------
000FAAr 2               ;   RenderPieceErase — blank the three cells the piece is leaving
000FAAr 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000FAAr 2               ;
000FAAr 2               ;   Three blanks rather than three board reads, because the cells under a
000FAAr 2               ;   falling piece are always empty: every move and every gravity step tests
000FAAr 2               ;   the target cells before it happens, and the one thing that writes them is
000FAAr 2               ;   PieceLock, after which nothing erases the piece again (piece.asm).
000FAAr 2               ; -----------------------------------------------------------------------------
000FAAr 2               RenderPieceErase:
000FAAr 2  AD rr rr       lda PieceCol
000FADr 2  18             clc
000FAEr 2  69 01          adc #WELL_ORIGIN_X
000FB0r 2  85 rr          sta RedrawCol
000FB2r 2  AD rr rr       lda PieceRow
000FB5r 2  18             clc
000FB6r 2  69 04          adc #WELL_ORIGIN_Y
000FB8r 2  A8             tay
000FB9r 2  A9 00          lda #TILE_EMPTY
000FBBr 2  A6 rr          ldx RedrawCol
000FBDr 2  20 rr rr       jsr RenderMark
000FC0r 2  C8             iny
000FC1r 2  A9 00          lda #TILE_EMPTY
000FC3r 2  A6 rr          ldx RedrawCol
000FC5r 2  20 rr rr       jsr RenderMark
000FC8r 2  C8             iny
000FC9r 2  A9 00          lda #TILE_EMPTY
000FCBr 2  A6 rr          ldx RedrawCol
000FCDr 2  4C rr rr       jmp RenderMark
000FD0r 2               
000FD0r 2               ; -----------------------------------------------------------------------------
000FD0r 2               ;   RenderNext — the preview, panel column NEXT_X, rows NEXT_Y..NEXT_Y+2
000FD0r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000FD0r 2               ;
000FD0r 2               ;   All three cells every time. The play screen image ships with a piece
000FD0r 2               ;   already drawn in the NEXT box (SPEC 12.1), so this has to overwrite rather
000FD0r 2               ;   than assume it is drawing onto backdrop.
000FD0r 2               ; -----------------------------------------------------------------------------
000FD0r 2               RenderNext:
000FD0r 2  A0 10          ldy #NEXT_Y
000FD2r 2  AD rr rr       lda NextA
000FD5r 2  A2 0B          ldx #NEXT_X
000FD7r 2  20 rr rr       jsr RenderMark
000FDAr 2  C8             iny
000FDBr 2  AD rr rr       lda NextB
000FDEr 2  A2 0B          ldx #NEXT_X
000FE0r 2  20 rr rr       jsr RenderMark
000FE3r 2  C8             iny
000FE4r 2  AD rr rr       lda NextC
000FE7r 2  A2 0B          ldx #NEXT_X
000FE9r 2  4C rr rr       jmp RenderMark
000FECr 2               
000FECr 2               ; -----------------------------------------------------------------------------
000FECr 2               ;   RenderScore / RenderHigh / RenderLevel — only called when a value changes
000FECr 2               ;   Nothing here compares anything: the caller knows when it changed a value
000FECr 2               ;   and these are not cheap enough to run every frame. SCORE_DIGITS cells is
000FECr 2               ;   most of a frame's flush budget on its own.
000FECr 2               ; -----------------------------------------------------------------------------
000FECr 2               RenderScore:
000FECr 2  A9 rr          lda #<ScoreLo
000FEEr 2  85 rr          sta Ptr1
000FF0r 2  A9 rr          lda #>ScoreLo
000FF2r 2  85 rr          sta Ptr1+1
000FF4r 2  A2 0C          ldx #SCORE_X
000FF6r 2  A0 05          ldy #SCORE_Y
000FF8r 2  A9 07          lda #SCORE_DIGITS
000FFAr 2  4C rr rr       jmp TextBcd
000FFDr 2               
000FFDr 2               RenderHigh:
000FFDr 2  A9 rr          lda #<HighLo
000FFFr 2  85 rr          sta Ptr1
001001r 2  A9 rr          lda #>HighLo
001003r 2  85 rr          sta Ptr1+1
001005r 2  A2 0C          ldx #HIGH_X
001007r 2  A0 0A          ldy #HIGH_Y
001009r 2  A9 07          lda #SCORE_DIGITS
00100Br 2  20 rr rr       jsr TextBcd
00100Er 2               
00100Er 2  A9 rr          lda #<HighLevel               ; The level it was set on, under the digits
001010r 2  85 rr          sta Ptr1
001012r 2  A9 rr          lda #>HighLevel
001014r 2  85 rr          sta Ptr1+1
001016r 2  A2 0F          ldx #HIGHLVL_X
001018r 2  A0 0B          ldy #HIGHLVL_Y
00101Ar 2  A9 02          lda #LEVEL_DIGITS
00101Cr 2  4C rr rr       jmp TextBcd
00101Fr 2               
00101Fr 2               ; -----------------------------------------------------------------------------
00101Fr 2               ;   RenderHighBlank — the dark half of the HIGH field's overtake flash
00101Fr 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y, TextCol
00101Fr 2               ;   SPEC 9.8. The seven digits only; the level under them stays put, so the
00101Fr 2               ;   box never looks empty and the flash costs seven cells of the budget.
00101Fr 2               ; -----------------------------------------------------------------------------
00101Fr 2               RenderHighBlank:
00101Fr 2  A9 07          lda #SCORE_DIGITS
001021r 2  A2 0C          ldx #HIGH_X
001023r 2  A0 0A          ldy #HIGH_Y
001025r 2  4C rr rr       jmp TextClearRun
001028r 2               
001028r 2               RenderLevel:
001028r 2  AD rr rr       lda Level
00102Br 2  4C rr rr       jmp TextLevel
00102Er 2               
00102Er 1               .include "../src/text.asm"
00102Er 2               ; =============================================================================
00102Er 2               ;   text.asm — Wizards Lab, text and numbers on the panel
00102Er 2               ; =============================================================================
00102Er 2               ;   The font lives in tile groups 2-6, forty glyphs in the order
00102Er 2               ;
00102Er 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
00102Er 2               ;
00102Er 2               ;   starting at FONT_BASE, so a digit is FONT_DIGIT_0 + value and a letter is
00102Er 2               ;   FONT_LETTER_A + (letter - 'A'). Strings are stored pre-converted to tile
00102Er 2               ;   numbers, terminated by TEXT_END, so drawing one is a copy with no
00102Er 2               ;   translation. src/strings.inc holds them and the macro that encodes them.
00102Er 2               ;
00102Er 2               ;   Everything here draws through RenderMark, never to the screen: text is
00102Er 2               ;   panel cells like any other and goes through the same one flush a frame.
00102Er 2               ;   That is also why the cursor state lives in the zero-page block RenderMark
00102Er 2               ;   promises not to touch (zeropage.inc) rather than in Tmp0-Tmp3.
00102Er 2               ; =============================================================================
00102Er 2               
00102Er 2               ; -----------------------------------------------------------------------------
00102Er 2               ;   TextDraw — draw a tile-encoded string
00102Er 2               ;   In:  Ptr1 -> string (TEXT_END terminated), X = panel column, Y = panel row
00102Er 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx
00102Er 2               ; -----------------------------------------------------------------------------
00102Er 2               TextDraw:
00102Er 2  86 rr          stx TextCol
001030r 2  84 rr          sty TextRow
001032r 2  A9 00          lda #0
001034r 2  85 rr          sta TextIdx
001036r 2               @Char:
001036r 2  A4 rr          ldy TextIdx
001038r 2  B1 rr          lda (Ptr1),y
00103Ar 2  C9 FF          cmp #TEXT_END
00103Cr 2  F0 0D          beq @Done
00103Er 2  A6 rr          ldx TextCol
001040r 2  A4 rr          ldy TextRow
001042r 2  20 rr rr       jsr RenderMark
001045r 2  E6 rr          inc TextCol
001047r 2  E6 rr          inc TextIdx
001049r 2  D0 EB          bne @Char                     ; Always — a string is never 256 tiles long
00104Br 2               @Done:
00104Br 2  60             rts
00104Cr 2               
00104Cr 2               ; -----------------------------------------------------------------------------
00104Cr 2               ;   TextBcd — draw a packed-BCD number, zero padded
00104Cr 2               ;   In:  Ptr1 -> BCD bytes (low first), A = digit count,
00104Cr 2               ;        X = panel column, Y = panel row
00104Cr 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx, TextByte,
00104Cr 2               ;        TextSkip
00104Cr 2               ;
00104Cr 2               ;   SCORE_DIGITS (7) for the score and the high score, 2 for the high score's
00104Cr 2               ;   level. The LEVEL box is not drawn with this — see TextLevel.
00104Cr 2               ;
00104Cr 2               ;   The count is in DIGITS, not bytes, because the score is seven digits in
00104Cr 2               ;   four bytes: the top nibble of the most significant byte is held at zero
00104Cr 2               ;   (SPEC 9) and must not be drawn, or the field would be eight cells wide and
00104Cr 2               ;   no longer centred. An odd count starts at the LOW nibble of the top byte.
00104Cr 2               ;
00104Cr 2               ;   **Every digit is drawn, every time.** A leading zero is a zero glyph, not
00104Cr 2               ;   a blank: 1250 draws as 0001250. There is no suppression pass and no
00104Cr 2               ;   right-alignment — the field is fixed width so a digit never changes
00104Cr 2               ;   column while the player is watching it (SPEC 9). This also makes the
00104Cr 2               ;   routine branchless, and lets RenderScore mark a fixed run of cells dirty.
00104Cr 2               ; -----------------------------------------------------------------------------
00104Cr 2               TextBcd:
00104Cr 2  86 rr          stx TextCol
00104Er 2  84 rr          sty TextRow
001050r 2  48             pha                           ; Digit count
001051r 2  29 01          and #$01
001053r 2  85 rr          sta TextSkip                  ; Odd count: the top high nibble is not drawn
001055r 2  68             pla
001056r 2  18             clc
001057r 2  69 01          adc #1                        ; Bytes = (digits + 1) / 2
001059r 2  4A             lsr a
00105Ar 2  AA             tax
00105Br 2  CA             dex
00105Cr 2  86 rr          stx TextIdx                   ; Start at the most significant byte
00105Er 2               
00105Er 2               @Byte:
00105Er 2  A4 rr          ldy TextIdx
001060r 2  B1 rr          lda (Ptr1),y
001062r 2  85 rr          sta TextByte
001064r 2               
001064r 2  A5 rr          lda TextSkip
001066r 2  D0 09          bne @Low
001068r 2  A5 rr          lda TextByte
00106Ar 2  4A             lsr a
00106Br 2  4A             lsr a
00106Cr 2  4A             lsr a
00106Dr 2  4A             lsr a
00106Er 2  20 rr rr       jsr TextDigit
001071r 2               @Low:
001071r 2  A9 00          lda #0
001073r 2  85 rr          sta TextSkip
001075r 2  A5 rr          lda TextByte
001077r 2  29 0F          and #$0F
001079r 2  20 rr rr       jsr TextDigit
00107Cr 2               
00107Cr 2  C6 rr          dec TextIdx
00107Er 2  10 DE          bpl @Byte
001080r 2  60             rts
001081r 2               
001081r 2               ; -----------------------------------------------------------------------------
001081r 2               ;   TextDigit — draw one digit at the cursor and step it right
001081r 2               ;   In:  A = value 0-9      Modifies: A, X, Y, TextCol
001081r 2               ; -----------------------------------------------------------------------------
001081r 2               TextDigit:
001081r 2  18             clc
001082r 2  69 10          adc #FONT_DIGIT_0
001084r 2  A6 rr          ldx TextCol
001086r 2  A4 rr          ldy TextRow
001088r 2  20 rr rr       jsr RenderMark
00108Br 2  E6 rr          inc TextCol
00108Dr 2  60             rts
00108Er 2               
00108Er 2               ; -----------------------------------------------------------------------------
00108Er 2               ;   TextBanner — centre a string in the one-row message band
00108Er 2               ;   In:  Ptr1 -> string
00108Er 2               ;   Out: nothing.  Modifies: A, X, Y and the text cursor
00108Er 2               ;
00108Er 2               ;   SPEC 12.2 — the band is panel row MSG_Y, full width, one row only. The
00108Er 2               ;   string arrives already wrapped as `~~ TEXT ~~` — two FONT_TILDE, a blank,
00108Er 2               ;   the text, a blank, two FONT_TILDE. Centring is (PANEL_W - length) / 2,
00108Er 2               ;   which is why banner strings are drawn even-length.
00108Er 2               ;
00108Er 2               ;   THE BAND EITHER SIDE OF THE STRING IS BLANKED, and only that. Banners are
00108Er 2               ;   not all the same width — `~~ PAUSED ~~` is two cells narrower than
00108Er 2               ;   `~~ LEVEL UP ~~`, which is exactly what pausing during a level-up meets —
00108Er 2               ;   so a shorter one drawn straight over a longer one would leave the tail of
00108Er 2               ;   the old ornament sitting either side of it. Blanking the WHOLE band first
00108Er 2               ;   would fix that too, and cost 18 marks on top of the string's: past
00108Er 2               ;   DIRTY_FLUSH_MAX, so every banner in the game would take an extra frame to
00108Er 2               ;   arrive. Blanking the margins costs only the cells the string is not
00108Er 2               ;   covering — six for the narrowest banner in the game, two for the widest.
00108Er 2               ; -----------------------------------------------------------------------------
00108Er 2               TextBanner:
00108Er 2  A0 00          ldy #0
001090r 2               @Len:
001090r 2  B1 rr          lda (Ptr1),y
001092r 2  C9 FF          cmp #TEXT_END
001094r 2  F0 03          beq @Got
001096r 2  C8             iny
001097r 2  D0 F7          bne @Len
001099r 2               @Got:
001099r 2  98             tya
00109Ar 2  85 rr          sta TextIdx
00109Cr 2  A9 16          lda #PANEL_W
00109Er 2  38             sec
00109Fr 2  E5 rr          sbc TextIdx
0010A1r 2  4A             lsr a                         ; (PANEL_W - length) / 2
0010A2r 2  85 rr          sta TextByte                  ; Where the string starts...
0010A4r 2  18             clc
0010A5r 2  65 rr          adc TextIdx
0010A7r 2  85 rr          sta TextSkip                  ; ...and one cell past where it ends. Neither
0010A9r 2                                               ;   is TextCol / TextRow / TextIdx, because
0010A9r 2                                               ;   TextClearRun below takes those
0010A9r 2               
0010A9r 2  A5 rr          lda TextByte                  ; The band to the left of it
0010ABr 2  38             sec
0010ACr 2  E9 02          sbc #MSG_X
0010AEr 2  F0 07          beq @Right
0010B0r 2  A2 02          ldx #MSG_X
0010B2r 2  A0 16          ldy #MSG_Y
0010B4r 2  20 rr rr       jsr TextClearRun
0010B7r 2               @Right:
0010B7r 2  A9 14          lda #(MSG_X + MSG_W)          ; ...and to the right
0010B9r 2  38             sec
0010BAr 2  E5 rr          sbc TextSkip
0010BCr 2  F0 07          beq @Draw
0010BEr 2  A6 rr          ldx TextSkip
0010C0r 2  A0 16          ldy #MSG_Y
0010C2r 2  20 rr rr       jsr TextClearRun
0010C5r 2               @Draw:
0010C5r 2  A6 rr          ldx TextByte
0010C7r 2  A0 16          ldy #MSG_Y
0010C9r 2  4C rr rr       jmp TextDraw
0010CCr 2               
0010CCr 2               ; -----------------------------------------------------------------------------
0010CCr 2               ;   TextBannerClear — blank the message band back to backdrop
0010CCr 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx
0010CCr 2               ;
0010CCr 2               ;   Columns MSG_X .. MSG_X + MSG_W - 1 only. The shelf tiles at either end of
0010CCr 2               ;   the band belong to the static screen image and are never redrawn.
0010CCr 2               ; -----------------------------------------------------------------------------
0010CCr 2               TextBannerClear:
0010CCr 2  A9 12          lda #MSG_W
0010CEr 2  A2 02          ldx #MSG_X
0010D0r 2  A0 16          ldy #MSG_Y
0010D2r 2                 ; falls through
0010D2r 2               
0010D2r 2               ; -----------------------------------------------------------------------------
0010D2r 2               ;   TextClearRun — blank a horizontal run of panel cells
0010D2r 2               ;   In:  A = width (never 0), X = panel column, Y = panel row
0010D2r 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx
0010D2r 2               ;
0010D2r 2               ;   Three callers wanted this loop with different numbers in it: the message
0010D2r 2               ;   band above, the HIGH field's dark half (SPEC 9.8) and the title screen's
0010D2r 2               ;   blinking prompt (SPEC 13.1). The cursor is in memory for the usual reason —
0010D2r 2               ;   RenderMark clobbers A and X and keeps only Y (D13).
0010D2r 2               ; -----------------------------------------------------------------------------
0010D2r 2               TextClearRun:
0010D2r 2  85 rr          sta TextIdx                   ; Cells left
0010D4r 2  86 rr          stx TextCol
0010D6r 2  84 rr          sty TextRow
0010D8r 2               @Cell:
0010D8r 2  A9 00          lda #TILE_BLANK
0010DAr 2  A6 rr          ldx TextCol
0010DCr 2  A4 rr          ldy TextRow
0010DEr 2  20 rr rr       jsr RenderMark
0010E1r 2  E6 rr          inc TextCol
0010E3r 2  C6 rr          dec TextIdx
0010E5r 2  D0 F1          bne @Cell
0010E7r 2  60             rts
0010E8r 2               
0010E8r 2               ; -----------------------------------------------------------------------------
0010E8r 2               ;   TextLevel — the LEVEL box, tens above units in one column
0010E8r 2               ;   In:  A = level (binary, 1-99)
0010E8r 2               ;   Out: nothing.  Modifies: A, X, Y, TextByte
0010E8r 2               ;   SPEC 12.2 — LEVEL_X, tens at LEVEL_Y and units at LEVEL_Y + 1. Always two
0010E8r 2               ;   digits: level 5 draws "0" over "5".
0010E8r 2               ; -----------------------------------------------------------------------------
0010E8r 2               TextLevel:
0010E8r 2  A2 00          ldx #0
0010EAr 2               @Tens:
0010EAr 2  C9 0A          cmp #10
0010ECr 2  90 05          bcc @Split
0010EEr 2  E9 0A          sbc #10                       ; Carry is set by the CMP that got us here
0010F0r 2  E8             inx
0010F1r 2  D0 F7          bne @Tens                     ; Always — X tops out at 9
0010F3r 2               @Split:
0010F3r 2  85 rr          sta TextByte                  ; Units
0010F5r 2  8A             txa
0010F6r 2  18             clc
0010F7r 2  69 10          adc #FONT_DIGIT_0
0010F9r 2  A2 12          ldx #LEVEL_X
0010FBr 2  A0 11          ldy #LEVEL_Y
0010FDr 2  20 rr rr       jsr RenderMark
001100r 2  A5 rr          lda TextByte
001102r 2  18             clc
001103r 2  69 10          adc #FONT_DIGIT_0
001105r 2  A2 12          ldx #LEVEL_X
001107r 2  A0 12          ldy #LEVEL_Y + 1
001109r 2  4C rr rr       jmp RenderMark
00110Cr 2               
00110Cr 1               .include "../src/audio.asm"
00110Cr 2               ; =============================================================================
00110Cr 2               ;   audio.asm — Wizards Lab, sound
00110Cr 2               ; =============================================================================
00110Cr 2               ;   SPEC.md section 16. Twelve effects, one channel, and none of it knows what
00110Cr 2               ;   a sound chip is: an effect is a list of STEPS in ROM (tables.inc), a step
00110Cr 2               ;   is a duration, a timbre and a note, and pushing one at the hardware is
00110Cr 2               ;   HalSfx's whole job (hal.inc).
00110Cr 2               ;
00110Cr 2               ;   That split is the opposite way round from the one SPEC 16 assumed. It said
00110Cr 2               ;   the AC6502 and the C64 would share a SID driver and the VIC-20 would need
00110Cr 2               ;   its own, which is true of the twenty lines that write registers and of
00110Cr 2               ;   nothing else: the sequencing, the priority, the envelope of an effect
00110Cr 2               ;   across frames and every note in the game are the same on all three, so
00110Cr 2               ;   they live here and are shared by all three rather than by two (PLAN.md
00110Cr 2               ;   D22). What each platform still owns is a note table and five stores.
00110Cr 2               ;
00110Cr 2               ;   ONE CHANNEL. The id is the priority — SPEC 16 lists the twelve from the
00110Cr 2               ;   quietest event to the loudest — so a request takes the channel only if its
00110Cr 2               ;   id is at least the id of what is already playing. That is what keeps the
00110Cr 2               ;   move blip out of the middle of a fireball, and it is why SfxPlay exists
00110Cr 2               ;   rather than logic storing into SfxRequest: a lock, a match and a bomb can
00110Cr 2               ;   all be requested in ONE frame, and last-write-wins would pick whichever
00110Cr 2               ;   the code happened to reach last.
00110Cr 2               ;
00110Cr 2               ;   AND ONE LEVEL. Neither sound chip has a per-voice volume, so "quieter"
00110Cr 2               ;   cannot be a property of a note: it is a master register the platform writes
00110Cr 2               ;   on its way past, and the byte that carries the choice to it is the timbre,
00110Cr 2               ;   bit 7 (constants.inc). Nothing the GAME plays ever sets it. It exists for
00110Cr 2               ;   the title screen, which plays the same twelve effects at half volume
00110Cr 2               ;   underneath a cauldron (ambience.asm).
00110Cr 2               ;
00110Cr 2               ;   Nothing here waits, loops over cells, or touches the screen. AudioTick is
00110Cr 2               ;   fifteen cycles on a frame where nothing changes and a step's worth of
00110Cr 2               ;   register writes on a frame where something does, so it cannot delay a
00110Cr 2               ;   frame however the frame is going.
00110Cr 2               ; =============================================================================
00110Cr 2               
00110Cr 2               ; -----------------------------------------------------------------------------
00110Cr 2               ;   AudioInit — silence, and whatever the sound chip needs to be told once
00110Cr 2               ;   Out: nothing.  Modifies: A, X
00110Cr 2               ; -----------------------------------------------------------------------------
00110Cr 2               AudioInit:
00110Cr 2  A9 00          lda #0
00110Er 2  8D rr rr       sta SfxRequest
001111r 2  8D rr rr       sta SfxId
001114r 2  8D rr rr       sta SfxTimer
001117r 2  8D rr rr       sta SfxShift
00111Ar 2  8D rr rr       sta SfxStepIdx
00111Dr 2  8D rr rr       sta SfxLevel                  ; Full volume, and no ambience — the title
001120r 2                                               ;   screen turns both on for itself
001120r 2  A2 00          ldx #0
001122r 2  A9 00          lda #TIMBRE_OFF
001124r 2  4C rr rr       jmp HalSfx
001127r 2               
001127r 2               ; -----------------------------------------------------------------------------
001127r 2               ;   SfxPlay — ask for an effect
001127r 2               ;   In:  A = SFX_* id
001127r 2               ;   Out: nothing.  Modifies: A only — X, Y and zero page are untouched, because
001127r 2               ;        half the callers are in the middle of a walk that is holding a cursor
001127r 2               ;        in a register (cascade.asm).
001127r 2               ;
001127r 2               ;   The loudest request in a frame is the one that survives, and the id is the
001127r 2               ;   loudness. A quieter one is not queued for later: by the next frame the
001127r 2               ;   event it belonged to is over.
001127r 2               ; -----------------------------------------------------------------------------
001127r 2               SfxPlay:
001127r 2  CD rr rr       cmp SfxRequest
00112Ar 2  90 03          bcc @Done                     ; Something at least as loud is already asked
00112Cr 2  8D rr rr       sta SfxRequest                ;   for this frame
00112Fr 2               @Done:
00112Fr 2  60             rts
001130r 2               
001130r 2               ; -----------------------------------------------------------------------------
001130r 2               ;   AudioTick — one frame of sound. Called from the bottom of the main loop.
001130r 2               ;   Out: nothing.  Modifies: A, X, Y
001130r 2               ; -----------------------------------------------------------------------------
001130r 2               AudioTick:
001130r 2  AD rr rr       lda SfxRequest
001133r 2  F0 0D          beq @Advance                  ; Nothing asked for — carry on with what plays
001135r 2  A2 00          ldx #0
001137r 2  8E rr rr       stx SfxRequest                ; Consumed either way: a request that loses is
00113Ar 2  CD rr rr       cmp SfxId                     ;   dropped, not held over
00113Dr 2  90 03          bcc @Advance
00113Fr 2  4C rr rr       jmp SfxBegin
001142r 2               
001142r 2               @Advance:
001142r 2  AD rr rr       lda SfxId
001145r 2  F0 09          beq @Idle                     ; Silent...
001147r 2  CE rr rr       dec SfxTimer
00114Ar 2  D0 03          bne @Done                     ; The step still has frames left in it
00114Cr 2  4C rr rr       jmp SfxStep                   ; ...and when it does not, the next one starts
00114Fr 2               @Done:
00114Fr 2  60             rts
001150r 2               
001150r 2               @Idle:                          ; ...and silence is where the title screen puts
001150r 2  4C rr rr       jmp AmbienceTick              ;   its cauldron. Nine cycles and an RTS in
001153r 2                                               ;   play, where the ambience is off
001153r 2               
001153r 2               ; -----------------------------------------------------------------------------
001153r 2               ;   SfxBegin — start an effect from its first step
001153r 2               ;   In:  A = SFX_* id
001153r 2               ;   Out: nothing.  Modifies: A, X, Y
001153r 2               ;
001153r 2               ;   Eleven of the twelve play at the pitch tables.inc wrote them at. The match
001153r 2               ;   chime is the one SPEC 16 says rises with the chain, and it rises by
001153r 2               ;   transposing the whole effect rather than by having a step list per depth —
001153r 2               ;   which is the whole of what this routine does before it hands over to
001153r 2               ;   SfxBeginShifted below.
001153r 2               ; -----------------------------------------------------------------------------
001153r 2               SfxBegin:
001153r 2  A2 00          ldx #0
001155r 2  C9 04          cmp #SFX_MATCH
001157r 2  D0 12          bne SfxBeginShifted
001159r 2               
001159r 2  48             pha                           ; The id; SfxBeginShifted wants it in A
00115Ar 2  AD rr rr       lda ChainStep                 ; 1 on the first step of a cascade (SPEC 8)
00115Dr 2  F0 0B          beq @Flat                     ; Never zero in practice; X is already 0
00115Fr 2  38             sec
001160r 2  E9 01          sbc #1
001162r 2  0A             asl a                         ; SFX_CHAIN_SHIFT semitones a link
001163r 2  C9 09          cmp #(SFX_CHAIN_MAX + 1)
001165r 2  90 02          bcc @Capped
001167r 2  A9 08          lda #SFX_CHAIN_MAX
001169r 2               @Capped:
001169r 2  AA             tax
00116Ar 2               @Flat:
00116Ar 2  68             pla
00116Br 2                 ; falls through
00116Br 2               
00116Br 2               ; -----------------------------------------------------------------------------
00116Br 2               ;   SfxBeginShifted — start an effect transposed by a given number of semitones
00116Br 2               ;   In:  A = SFX_* id, X = semitones to add to every note of it
00116Br 2               ;   Out: nothing.  Modifies: A, X, Y
00116Br 2               ;
00116Br 2               ;   Split out of SfxBegin for the title screen's ambience, which pitches every
00116Br 2               ;   bubble by a fresh random amount and would otherwise have to write SfxShift
00116Br 2               ;   after SfxBegin had already played the first step at the wrong pitch
00116Br 2               ;   (ambience.asm). It takes the channel unconditionally and is not a request:
00116Br 2               ;   the only caller outside SfxBegin knows the channel is silent because it is
00116Br 2               ;   only reached on a frame where it was.
00116Br 2               ; -----------------------------------------------------------------------------
00116Br 2               SfxBeginShifted:
00116Br 2  8D rr rr       sta SfxId
00116Er 2  8E rr rr       stx SfxShift
001171r 2  AE rr rr       ldx SfxId
001174r 2  BD rr rr       lda SfxOffsets - 1,x          ; The id is 1-based; the table is not
001177r 2  8D rr rr       sta SfxStepIdx
00117Ar 2                 ; falls through into the first step
00117Ar 2               
00117Ar 2               ; -----------------------------------------------------------------------------
00117Ar 2               ;   SfxStep — play the step at SfxStepIdx and advance past it
00117Ar 2               ;   Out: nothing.  Modifies: A, X, Y
00117Ar 2               ;   A zero frame count is the end of the effect and returns the channel to
00117Ar 2               ;   silence — which is a real event on a SID, where it is the gate coming down.
00117Ar 2               ; -----------------------------------------------------------------------------
00117Ar 2               SfxStep:
00117Ar 2  AE rr rr       ldx SfxStepIdx
00117Dr 2  BD rr rr       lda SfxSteps,x
001180r 2  F0 25          beq @End
001182r 2  8D rr rr       sta SfxTimer
001185r 2               
001185r 2  BD rr rr       lda SfxSteps + 2,x            ; The note...
001188r 2  18             clc
001189r 2  6D rr rr       adc SfxShift                  ;   ...transposed, for the match chime
00118Cr 2  C9 25          cmp #(NOTE_MAX + 1)
00118Er 2  90 02          bcc @Note
001190r 2  A9 24          lda #NOTE_MAX                 ; Both note tables stop at C6 and a chain deep
001192r 2               @Note:                          ;   enough to push past it clamps rather than
001192r 2  A8             tay                           ;   reading off the end of one
001193r 2  BD rr rr       lda SfxSteps + 1,x            ; The timbre...
001196r 2  0D rr rr       ora SfxLevel                  ;   ...and how loud, which is bit 7 of the same
001199r 2                                               ;   byte and is zero for everything the game
001199r 2                                               ;   itself plays (constants.inc). A step whose
001199r 2                                               ;   timbre is TIMBRE_OFF — a rest — comes out of
001199r 2                                               ;   here as $80, and every HalSfx masks the bit
001199r 2                                               ;   off before it looks, so a quiet rest is
001199r 2                                               ;   still a rest
001199r 2  48             pha
00119Ar 2  8A             txa
00119Br 2  18             clc
00119Cr 2  69 03          adc #SFX_STEP_BYTES
00119Er 2  8D rr rr       sta SfxStepIdx
0011A1r 2  98             tya
0011A2r 2  AA             tax                           ; X = note
0011A3r 2  68             pla                           ; A = timbre
0011A4r 2  4C rr rr       jmp HalSfx
0011A7r 2               
0011A7r 2               @End:
0011A7r 2  A9 00          lda #0
0011A9r 2  8D rr rr       sta SfxId
0011ACr 2  A2 00          ldx #0
0011AEr 2  AD rr rr       lda SfxLevel                  ; TIMBRE_OFF at the level the channel is AT, and
0011B1r 2                                               ;   TIMBRE_OFF is zero, so the level is the
0011B1r 2                                               ;   whole byte. Letting go at full volume
0011B1r 2                                               ;   instead would put the master register back
0011B1r 2                                               ;   up before the SID's release tail of a quiet
0011B1r 2                                               ;   note had finished, and every bubble on the
0011B1r 2                                               ;   title screen would end in a click
0011B1r 2                                               ;   (include/sid.inc)
0011B1r 2  4C rr rr       jmp HalSfx
0011B4r 2               
0011B4r 1               .include "../src/ambience.asm"
0011B4r 2               ; =============================================================================
0011B4r 2               ;   ambience.asm — Wizards Lab, the sound of the title screen
0011B4r 2               ; =============================================================================
0011B4r 2               ;   SPEC 13.1 gives the title screen two moving things and no sound at all.
0011B4r 2               ;   This is a third: not music, which one channel and no envelope cannot carry
0011B4r 2               ;   for thirty seconds without becoming a nursery rhyme, but the ROOM. A
0011B4r 2               ;   cauldron bubbling away somewhere under the page, and every so often one of
0011B4r 2               ;   the game's own effects drifting past at half volume as though an experiment
0011B4r 2               ;   two benches over just went off.
0011B4r 2               ;
0011B4r 2               ;   HOW IT FITS IN ONE CHANNEL. It does not mix, because nothing here can mix:
0011B4r 2               ;   there is one voice and no way to sum two sounds into it. What it does
0011B4r 2               ;   instead is fill the gaps. AudioTick calls this from the frame where the
0011B4r 2               ;   channel fell silent and from no other (audio.asm), so the ambience only
0011B4r 2               ;   ever speaks when nothing else is speaking, and a bubble is not a special
0011B4r 2               ;   case of anything — it is an effect out of the same table, begun through the
0011B4r 2               ;   same driver, at half volume and a random pitch.
0011B4r 2               ;
0011B4r 2               ;   That last part is what stops it sounding like a loop. There are three
0011B4r 2               ;   cauldron sounds; there are thirty-two entries in AmbTable saying how often
0011B4r 2               ;   each of them and each of the five borrowed effects comes up; every one is
0011B4r 2               ;   transposed by a fresh 0-7 semitones as it starts; and the quiet between
0011B4r 2               ;   them is rolled every time. Two random bytes and a table lookup per sound.
0011B4r 2               ;
0011B4r 2               ;   WHY IT NEEDS NO OFF SWITCH IN PLAY. SfxLevel is both the volume and the
0011B4r 2               ;   flag, and the game never sets it. A frame of play reaches AmbienceTick only
0011B4r 2               ;   when nothing is sounding, reads one byte, finds zero and returns: nine
0011B4r 2               ;   cycles, and no branch anywhere else in the audio path (ram.inc).
0011B4r 2               ; =============================================================================
0011B4r 2               
0011B4r 2               ; -----------------------------------------------------------------------------
0011B4r 2               ;   AmbienceBegin — the lab starts murmuring
0011B4r 2               ;   Out: nothing.  Modifies: A
0011B4r 2               ;   Called from the title screen's redraw, beside AnimTitleBegin, so a second
0011B4r 2               ;   visit in a session sounds like the first one (main.asm).
0011B4r 2               ; -----------------------------------------------------------------------------
0011B4r 2               AmbienceBegin:
0011B4r 2  A9 80          lda #TIMBRE_QUIET             ; Half volume from here until GameStart, and
0011B6r 2  8D rr rr       sta SfxLevel                  ;   the flag that says this routine is live
0011B9r 2  A9 07          lda #AMB_GAP_MIN
0011BBr 2  8D rr rr       sta AmbTimer                  ; A beat before the first sound, not a bloop on
0011BEr 2  60             rts                           ;   the frame the screen appears — the title
0011BFr 2                                               ;   arrives from a game-over fanfare as often as
0011BFr 2                                               ;   from a cold boot, and a cauldron that starts
0011BFr 2                                               ;   ON the cut reads as part of the fanfare
0011BFr 2               
0011BFr 2               ; -----------------------------------------------------------------------------
0011BFr 2               ;   AmbienceEnd — and stops
0011BFr 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0-Tmp2 (HalSfx)
0011BFr 2               ;
0011BFr 2               ;   Cuts whatever is sounding rather than letting it finish, because what
0011BFr 2               ;   follows this is the play screen and the first thing on it is a piece
0011BFr 2               ;   spawning. A bubble carried over the cut would be the game's first noise.
0011BFr 2               ; -----------------------------------------------------------------------------
0011BFr 2               AmbienceEnd:
0011BFr 2  A9 00          lda #0
0011C1r 2  8D rr rr       sta SfxLevel
0011C4r 2  8D rr rr       sta SfxId
0011C7r 2  8D rr rr       sta SfxRequest                ; Nothing on the title screen asks for a sound,
0011CAr 2                                               ;   but a byte of BSS is not a promise
0011CAr 2  A2 00          ldx #0
0011CCr 2  A9 00          lda #TIMBRE_OFF
0011CEr 2  4C rr rr       jmp HalSfx
0011D1r 2               
0011D1r 2               ; -----------------------------------------------------------------------------
0011D1r 2               ;   AmbienceTick — one frame of it, from AudioTick's silent branch
0011D1r 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0, Tmp1
0011D1r 2               ;
0011D1r 2               ;   The gap is counted HERE and not in the main loop, which is the reason this
0011D1r 2               ;   hangs off the silent branch rather than off StateTitle: a sound that runs
0011D1r 2               ;   forty frames should be followed by the full gap, not by whatever is left of
0011D1r 2               ;   one that was ticking down underneath it. Silence is the only thing the
0011D1r 2               ;   timer measures.
0011D1r 2               ; -----------------------------------------------------------------------------
0011D1r 2               AmbienceTick:
0011D1r 2  AD rr rr       lda SfxLevel
0011D4r 2  F0 2E          beq @Done                     ; The game is playing — this is the whole cost
0011D6r 2  CE rr rr       dec AmbTimer
0011D9r 2  D0 29          bne @Done                     ; Still quiet
0011DBr 2               
0011DBr 2  20 rr rr       jsr RngNext
0011DEr 2  29 1F          and #(AMB_ENTRIES - 1)        ; A power-of-two table, so a masked byte picks
0011E0r 2  AA             tax                           ;   one evenly without RngRange
0011E1r 2  BD rr rr       lda AmbTable,x
0011E4r 2  48             pha                           ; The sound, parked while the pitch is rolled —
0011E5r 2                                               ;   nothing may hold a value in Tmp0-Tmp3
0011E5r 2                                               ;   across RngRange (zeropage.inc)
0011E5r 2  A9 08          lda #AMB_SHIFT_RANGE
0011E7r 2  20 rr rr       jsr RngRange                  ; 0 .. 7 semitones up: what makes two bubbles
0011EAr 2  AA             tax                           ;   two different sizes rather than one sound
0011EBr 2  68             pla
0011ECr 2  20 rr rr       jsr SfxBeginShifted           ; The channel is silent — that is the only
0011EFr 2                                               ;   frame this routine runs on — so it is taken
0011EFr 2                                               ;   outright and not asked for (audio.asm)
0011EFr 2               
0011EFr 2  A9 1A          lda #AMB_GAP_RANGE
0011F1r 2  20 rr rr       jsr RngRange
0011F4r 2  18             clc
0011F5r 2  69 07          adc #AMB_GAP_MIN              ; AMB_GAP_MIN .. MIN + RANGE - 1 frames of quiet
0011F7r 2  AE rr rr       ldx SfxId                     ; What just started, read back off the channel
0011FAr 2  E0 0E          cpx #SFX_CAULDRON             ;   rather than remembered across two calls
0011FCr 2  B0 03          bcs @Set                      ; The cauldron carries straight on...
0011FEr 2  18             clc
0011FFr 2  69 28          adc #AMB_GAP_EVENT            ; ...but the lab goes quiet for a while after
001201r 2               @Set:                           ;   something actually happens in it
001201r 2  8D rr rr       sta AmbTimer
001204r 2               @Done:
001204r 2  60             rts
001205r 2               
001205r 1               
001205r 1               ; =============================================================================
001205r 1               ;   HAL — TMS9918 Graphics Mode I
001205r 1               ; =============================================================================
001205r 1               
001205r 1               ; -----------------------------------------------------------------------------
001205r 1               ;   VdpSetWrite — point the VDP at a VRAM address for writing
001205r 1               ;   In:  A = address low, X = address high
001205r 1               ; -----------------------------------------------------------------------------
001205r 1               VdpSetWrite:
001205r 1  8D 01 9C       sta VC_REG
001208r 1  8A             txa
001209r 1  09 40          ora #$40                      ; Bit 6 selects write
00120Br 1  8D 01 9C       sta VC_REG
00120Er 1  60             rts
00120Fr 1               
00120Fr 1               ; -----------------------------------------------------------------------------
00120Fr 1               ;   VdpSetReg — write a VDP control register
00120Fr 1               ;   In:  A = value, X = register number
00120Fr 1               ; -----------------------------------------------------------------------------
00120Fr 1               VdpSetReg:
00120Fr 1  8D 01 9C       sta VC_REG
001212r 1  8A             txa
001213r 1  09 80          ora #$80
001215r 1  8D 01 9C       sta VC_REG
001218r 1  60             rts
001219r 1               
001219r 1               ; -----------------------------------------------------------------------------
001219r 1               ;   HalInitVideo — Graphics I, tiles loaded, screen cleared, everything black
001219r 1               ; -----------------------------------------------------------------------------
001219r 1               HalInitVideo:
001219r 1  A2 00          ldx #0                        ; R0: external VDP disabled, Graphics I
00121Br 1  A9 00          lda #$00
00121Dr 1  20 rr rr       jsr VdpSetReg
001220r 1  A2 01          ldx #1                        ; R1: 16 K, display on, IRQ enabled, 8x8 sprites
001222r 1  A9 E0          lda #$E0                      ; The IE bit stays SET even though this game
001224r 1  20 rr rr       jsr VdpSetReg                 ;   polls: HalWaitFrame reads the status
001227r 1                                               ;   register for the vblank flag, and the flag
001227r 1                                               ;   only raises when IE is on. The CPU's own I
001227r 1                                               ;   flag is never cleared, so the interrupt is
001227r 1                                               ;   asserted and simply ignored — reading the
001227r 1                                               ;   status register acknowledges it.
001227r 1  A2 02          ldx #2                        ; R2: name table    $1400 / $400
001229r 1  A9 05          lda #$05
00122Br 1  20 rr rr       jsr VdpSetReg
00122Er 1  A2 03          ldx #3                        ; R3: colour table  $2000 / $40
001230r 1  A9 80          lda #$80
001232r 1  20 rr rr       jsr VdpSetReg
001235r 1  A2 04          ldx #4                        ; R4: pattern table $0000 / $800
001237r 1  A9 00          lda #$00
001239r 1  20 rr rr       jsr VdpSetReg
00123Cr 1  A2 05          ldx #5                        ; R5: sprite attrs  $1B00 / $80
00123Er 1  A9 36          lda #$36
001240r 1  20 rr rr       jsr VdpSetReg
001243r 1  A2 06          ldx #6                        ; R6: sprite patterns $0000
001245r 1  A9 00          lda #$00
001247r 1  20 rr rr       jsr VdpSetReg
00124Ar 1  A2 07          ldx #7                        ; R7: backdrop black
00124Cr 1  A9 01          lda #$01
00124Er 1  20 rr rr       jsr VdpSetReg
001251r 1               
001251r 1  20 rr rr       jsr LoadTileset
001254r 1  20 rr rr       jsr LoadColorTable
001257r 1  20 rr rr       jsr DisableSprites
00125Ar 1                 ; falls through
00125Ar 1               
00125Ar 1               ; -----------------------------------------------------------------------------
00125Ar 1               ;   HalClearScreen — fill the name table with the blank tile
00125Ar 1               ; -----------------------------------------------------------------------------
00125Ar 1               HalClearScreen:
00125Ar 1  A9 00          lda #<VRAM_NAMES
00125Cr 1  A2 14          ldx #>VRAM_NAMES
00125Er 1  20 rr rr       jsr VdpSetWrite
001261r 1  A2 03          ldx #3                        ; 3 x 256 = 768 cells
001263r 1  A0 00          ldy #0
001265r 1               @Cell:
001265r 1  A9 00          lda #TILE_BLANK
001267r 1  8D 00 9C       sta VC_DATA
00126Ar 1  C8             iny
00126Br 1  D0 F8          bne @Cell
00126Dr 1  CA             dex
00126Er 1  D0 F5          bne @Cell
001270r 1  60             rts
001271r 1               
001271r 1               ; -----------------------------------------------------------------------------
001271r 1               ;   LoadTileset — 2 K of patterns into VRAM
001271r 1               ;   PLACEHOLDER ART: Tileset is data/tileset.bin. See data/README.md.
001271r 1               ; -----------------------------------------------------------------------------
001271r 1               LoadTileset:
001271r 1  A9 00          lda #<VRAM_PATTERNS
001273r 1  A2 00          ldx #>VRAM_PATTERNS
001275r 1  20 rr rr       jsr VdpSetWrite
001278r 1               
001278r 1  A9 rr          lda #<Tileset
00127Ar 1  85 rr          sta SrcPtr
00127Cr 1  A9 rr          lda #>Tileset
00127Er 1  85 rr          sta SrcPtr+1
001280r 1               
001280r 1  A2 08          ldx #8                        ; 8 x 256 = 2048 bytes
001282r 1  A0 00          ldy #0
001284r 1               @Byte:
001284r 1  B1 rr          lda (SrcPtr),y
001286r 1  8D 00 9C       sta VC_DATA
001289r 1  C8             iny
00128Ar 1  D0 F8          bne @Byte
00128Cr 1  E6 rr          inc SrcPtr+1
00128Er 1  CA             dex
00128Fr 1  D0 F3          bne @Byte
001291r 1  60             rts
001292r 1               
001292r 1               ; -----------------------------------------------------------------------------
001292r 1               ;   LoadColorTable — 32 bytes, one per 8-pattern group
001292r 1               ;   This is what makes a tile red: its pattern number selects the group, and
001292r 1               ;   the group's byte here selects the colour. Nothing is per cell.
001292r 1               ; -----------------------------------------------------------------------------
001292r 1               LoadColorTable:
001292r 1  A9 00          lda #<VRAM_COLORS
001294r 1  A2 20          ldx #>VRAM_COLORS
001296r 1  20 rr rr       jsr VdpSetWrite
001299r 1  A0 00          ldy #0
00129Br 1               @Byte:
00129Br 1  B9 rr rr       lda TileColorTMS,y
00129Er 1  8D 00 9C       sta VC_DATA
0012A1r 1  C8             iny
0012A2r 1  C0 20          cpy #32
0012A4r 1  D0 F5          bne @Byte
0012A6r 1  60             rts
0012A7r 1               
0012A7r 1               ; -----------------------------------------------------------------------------
0012A7r 1               ;   DisableSprites — park every sprite off screen
0012A7r 1               ;   The game uses none; $D0 in the first Y byte terminates the sprite list.
0012A7r 1               ; -----------------------------------------------------------------------------
0012A7r 1               DisableSprites:
0012A7r 1  A9 00          lda #<VRAM_SPRITES
0012A9r 1  A2 1B          ldx #>VRAM_SPRITES
0012ABr 1  20 rr rr       jsr VdpSetWrite
0012AEr 1  A9 D0          lda #$D0
0012B0r 1  8D 00 9C       sta VC_DATA
0012B3r 1  60             rts
0012B4r 1               
0012B4r 1               ; -----------------------------------------------------------------------------
0012B4r 1               ;   HalWaitFrame — poll the VDP status register for vertical blank
0012B4r 1               ;   No raster interrupt here, and the status poll is self-syncing.
0012B4r 1               ; -----------------------------------------------------------------------------
0012B4r 1               HalWaitFrame:
0012B4r 1               @Wait:
0012B4r 1  AD 01 9C       lda VC_STATUS
0012B7r 1  29 80          and #$80                      ; Bit 7 sets at the end of each frame
0012B9r 1  F0 F9          beq @Wait
0012BBr 1  60             rts
0012BCr 1               
0012BCr 1               ; -----------------------------------------------------------------------------
0012BCr 1               ;   HalPlotCell — In: A = tile, X = screen column, Y = screen row
0012BCr 1               ; -----------------------------------------------------------------------------
0012BCr 1               HalPlotCell:
0012BCr 1  48             pha
0012BDr 1  20 rr rr       jsr NameAddr                  ; Ptr1 = VRAM_NAMES + row * 32 + col
0012C0r 1  A5 rr          lda Ptr1
0012C2r 1  A6 rr          ldx Ptr1+1
0012C4r 1  20 rr rr       jsr VdpSetWrite
0012C7r 1  68             pla
0012C8r 1  8D 00 9C       sta VC_DATA
0012CBr 1  60             rts
0012CCr 1               
0012CCr 1               ; -----------------------------------------------------------------------------
0012CCr 1               ;   NameAddr — In: X = column, Y = row.  Out: Ptr1 = name table address
0012CCr 1               ; -----------------------------------------------------------------------------
0012CCr 1               NameAddr:
0012CCr 1  98             tya
0012CDr 1  29 07          and #$07
0012CFr 1  0A             asl a                         ; (row & 7) * 32 lands in bits 5-7...
0012D0r 1  0A             asl a
0012D1r 1  0A             asl a
0012D2r 1  0A             asl a
0012D3r 1  0A             asl a
0012D4r 1  85 rr          sta Ptr1
0012D6r 1  8A             txa
0012D7r 1  05 rr          ora Ptr1                      ; ...leaving bits 0-4 free for the column
0012D9r 1  85 rr          sta Ptr1
0012DBr 1  98             tya
0012DCr 1  4A             lsr a                         ; row >> 3 is the page within the name table
0012DDr 1  4A             lsr a
0012DEr 1  4A             lsr a
0012DFr 1  18             clc
0012E0r 1  69 14          adc #>VRAM_NAMES
0012E2r 1  85 rr          sta Ptr1+1
0012E4r 1  60             rts
0012E5r 1               
0012E5r 1               ; -----------------------------------------------------------------------------
0012E5r 1               ;   HalBlitScreen — draw a full 768-byte name table image
0012E5r 1               ;   In: SrcPtr -> image. Ptr1 (colour) is ignored: this machine has no colour
0012E5r 1               ;   RAM, so the same image drives every platform's layout and only the palette
0012E5r 1               ;   mechanism differs.
0012E5r 1               ; -----------------------------------------------------------------------------
0012E5r 1               HalBlitScreen:
0012E5r 1  A9 00          lda #<VRAM_NAMES
0012E7r 1  A2 14          ldx #>VRAM_NAMES
0012E9r 1  20 rr rr       jsr VdpSetWrite
0012ECr 1               
0012ECr 1  A2 03          ldx #3                        ; 3 full pages
0012EEr 1  A0 00          ldy #0
0012F0r 1               @Byte:
0012F0r 1  B1 rr          lda (SrcPtr),y
0012F2r 1  8D 00 9C       sta VC_DATA
0012F5r 1  C8             iny
0012F6r 1  D0 F8          bne @Byte
0012F8r 1  E6 rr          inc SrcPtr+1
0012FAr 1  CA             dex
0012FBr 1  D0 F3          bne @Byte
0012FDr 1  60             rts
0012FEr 1               
0012FEr 1               ; -----------------------------------------------------------------------------
0012FEr 1               ;   HalReadInput — joystick 1 and the keyboard, in one active-high mask
0012FEr 1               ;   The port is active low, %RLDUYXBA (ac6502.inc).
0012FEr 1               ;
0012FEr 1               ;   This machine has no key matrix to scan. Two encoders sit on the VIA ports
0012FEr 1               ;   the joysticks share and hand over one ASCII byte per keystroke, strobing
0012FEr 1               ;   CB1 (matrix keyboard) or CA1 (PS/2) when it is ready. There is no key-up
0012FEr 1               ;   event and no way to ask whether a key is still down, so a key here is a
0012FEr 1               ;   ONE-FRAME PULSE rather than a held bit: the edge-triggered controls
0012FEr 1               ;   (rotate, pause, fire) work exactly as they do on a stick, and the held
0012FEr 1               ;   ones (left, right, soft drop) advance once per keystroke and once per
0012FEr 1               ;   encoder auto-repeat. DAS never engages from the keyboard, because the bit
0012FEr 1               ;   is never down two frames running.
0012FEr 1               ;
0012FEr 1               ;   Polled, not interrupt driven: the IFR flag raises on the strobe whether or
0012FEr 1               ;   not the VIA is allowed to assert IRQ, and this cartridge never clears the
0012FEr 1               ;   CPU's I flag (D7). Reading the port takes the byte and clears the flag.
0012FEr 1               ; -----------------------------------------------------------------------------
0012FEr 1               HalReadInput:
0012FEr 1  AD 0D 03       lda HW_PRESENT
001301r 1  29 20          and #HW_GPIO                  ; No GPIO card means a floating bus, not input
001303r 1  F0 51          beq @None
001305r 1               
001305r 1  20 rr rr       jsr ScanKeys                  ; BEFORE the joystick: ReadJoystick1 releases
001308r 1  85 rr          sta Tmp2                      ;   both encoders, and a key pending at that
00130Ar 1                                               ;   moment would go with them
00130Ar 1               
00130Ar 1  20 48 A0       jsr ReadJoystick1
00130Dr 1  49 FF          eor #$FF                      ; Active low in, active high out
00130Fr 1  85 rr          sta Tmp0
001311r 1               
001311r 1  A9 00          lda #0
001313r 1  85 rr          sta Tmp1
001315r 1               
001315r 1  A5 rr          lda Tmp0
001317r 1  29 10          and #%00010000                  ; U
001319r 1  F0 06          beq @NoUp
00131Br 1  A5 rr          lda Tmp1
00131Dr 1  09 01          ora #INPUT_UP
00131Fr 1  85 rr          sta Tmp1
001321r 1               @NoUp:
001321r 1  A5 rr          lda Tmp0
001323r 1  29 20          and #%00100000                  ; D
001325r 1  F0 06          beq @NoDown
001327r 1  A5 rr          lda Tmp1
001329r 1  09 02          ora #INPUT_DOWN
00132Br 1  85 rr          sta Tmp1
00132Dr 1               @NoDown:
00132Dr 1  A5 rr          lda Tmp0
00132Fr 1  29 40          and #%01000000                  ; L
001331r 1  F0 06          beq @NoLeft
001333r 1  A5 rr          lda Tmp1
001335r 1  09 04          ora #INPUT_LEFT
001337r 1  85 rr          sta Tmp1
001339r 1               @NoLeft:
001339r 1  A5 rr          lda Tmp0
00133Br 1  29 80          and #%10000000                  ; R
00133Dr 1  F0 06          beq @NoRight
00133Fr 1  A5 rr          lda Tmp1
001341r 1  09 08          ora #INPUT_RIGHT
001343r 1  85 rr          sta Tmp1
001345r 1               @NoRight:
001345r 1  A5 rr          lda Tmp0
001347r 1  29 01          and #%00000001                  ; A
001349r 1  F0 06          beq @NoFire
00134Br 1  A5 rr          lda Tmp1
00134Dr 1  09 10          ora #INPUT_FIRE
00134Fr 1  85 rr          sta Tmp1
001351r 1               @NoFire:
001351r 1               
001351r 1  A5 rr          lda Tmp1
001353r 1  05 rr          ora Tmp2
001355r 1  60             rts
001356r 1               
001356r 1               @None:
001356r 1  A9 00          lda #0
001358r 1  60             rts
001359r 1               
001359r 1               ; -----------------------------------------------------------------------------
001359r 1               ;   ScanKeys — whatever the two encoders have strobed since the last frame
001359r 1               ;   Out: A = INPUT_* bits.  Modifies: A, X, Tmp2
001359r 1               ;   Both are checked, so either keyboard drives the game.
001359r 1               ; -----------------------------------------------------------------------------
001359r 1               ScanKeys:
001359r 1  A9 00          lda #0
00135Br 1  85 rr          sta Tmp2
00135Dr 1               
00135Dr 1  AD 0D 94       lda GPIO_IFR
001360r 1  29 10          and #GPIO_INT_CB1             ; Matrix keyboard encoder, on port B
001362r 1  F0 0A          beq @Ps2
001364r 1  AD 00 94       lda GPIO_PORTB                ; Reading it takes the byte and clears CB1
001367r 1  20 rr rr       jsr KeyBit
00136Ar 1  05 rr          ora Tmp2
00136Cr 1  85 rr          sta Tmp2
00136Er 1               
00136Er 1               @Ps2:
00136Er 1  AD 0D 94       lda GPIO_IFR
001371r 1  29 02          and #GPIO_INT_CA1             ; PS/2 encoder, on port A
001373r 1  F0 0A          beq @Done
001375r 1  AD 01 94       lda GPIO_PORTA
001378r 1  20 rr rr       jsr KeyBit
00137Br 1  05 rr          ora Tmp2
00137Dr 1  85 rr          sta Tmp2
00137Fr 1               
00137Fr 1               @Done:
00137Fr 1  A5 rr          lda Tmp2
001381r 1  60             rts
001382r 1               
001382r 1               ; -----------------------------------------------------------------------------
001382r 1               ;   KeyBit — one ASCII byte to one input bit
001382r 1               ;   In:  A = character      Out: A = INPUT_* bit, or 0 for anything else
001382r 1               ;   SPEC 11.2. The arrow keys are not here: the encoders define no code for
001382r 1               ;   them, so WASD is the whole of the keyboard control scheme on this machine.
001382r 1               ; -----------------------------------------------------------------------------
001382r 1               KeyBit:
001382r 1  C9 0D          cmp #$0D                      ; RETURN — confirm
001384r 1  F0 2D          beq @Fire
001386r 1  C9 20          cmp #' '                      ; SPACE — rotate, and start (D15)
001388r 1  F0 1D          beq @Up
00138Ar 1  09 20          ora #$20                      ; Fold to lower case. Anything that is not a
00138Cr 1  C9 77          cmp #'w'                      ;   letter simply matches nothing below.
00138Er 1  F0 17          beq @Up
001390r 1  C9 73          cmp #'s'
001392r 1  F0 16          beq @Down
001394r 1  C9 61          cmp #'a'
001396r 1  F0 15          beq @Left
001398r 1  C9 64          cmp #'d'
00139Ar 1  F0 14          beq @Right
00139Cr 1  C9 71          cmp #'q'
00139Er 1  F0 13          beq @Fire
0013A0r 1  C9 70          cmp #'p'
0013A2r 1  F0 12          beq @Pause
0013A4r 1  A9 00          lda #0
0013A6r 1  60             rts
0013A7r 1               
0013A7r 1               @Up:
0013A7r 1  A9 01          lda #INPUT_UP
0013A9r 1  60             rts
0013AAr 1               @Down:
0013AAr 1  A9 02          lda #INPUT_DOWN
0013ACr 1  60             rts
0013ADr 1               @Left:
0013ADr 1  A9 04          lda #INPUT_LEFT
0013AFr 1  60             rts
0013B0r 1               @Right:
0013B0r 1  A9 08          lda #INPUT_RIGHT
0013B2r 1  60             rts
0013B3r 1               @Fire:
0013B3r 1  A9 10          lda #INPUT_FIRE
0013B5r 1  60             rts
0013B6r 1               @Pause:
0013B6r 1  A9 20          lda #INPUT_PAUSE
0013B8r 1  60             rts
0013B9r 1               
0013B9r 1               ; -----------------------------------------------------------------------------
0013B9r 1               ;   HalDetectRegion — the TMS9918 here is 60 Hz
0013B9r 1               ; -----------------------------------------------------------------------------
0013B9r 1               HalDetectRegion:
0013B9r 1  A9 00          lda #0                        ; NTSC
0013BBr 1  60             rts
0013BCr 1               
0013BCr 1               ; -----------------------------------------------------------------------------
0013BCr 1               ;   HalColorFlash — the fireball's detonation (SPEC 4.6, 14)
0013BCr 1               ;   In:  A = colour key ($40..$68), or TINT_NONE.  Modifies: A, X, Y, TintColor
0013BCr 1               ;
0013BCr 1               ;   ONE BYTE. A tile's colour on this machine belongs to its 8-pattern group
0013BCr 1               ;   and not to the cell, so turning every red tile on the board white is a
0013BCr 1               ;   single write to the VDP colour table — and its undo is another. SPEC 4.6
0013BCr 1               ;   calls this the fireball's free trick and it is not an exaggeration: the
0013BCr 1               ;   Commodores' equivalent costs a compare on every cell they draw for as long
0013BCr 1               ;   as the flash lasts, and this costs nothing at all once it is lit.
0013BCr 1               ;
0013BCr 1               ;   The group index is the colour key >> 3, because both the tile map and the
0013BCr 1               ;   colour table are eight patterns to a group (SPEC Appendix A).
0013BCr 1               ;
0013BCr 1               ;   The old colour goes back BEFORE the new one is lit, so two fireballs of
0013BCr 1               ;   different colours in one step leave exactly one group flashing rather than
0013BCr 1               ;   one group flashing and another stuck white for the rest of the game.
0013BCr 1               ; -----------------------------------------------------------------------------
0013BCr 1               HalColorFlash:
0013BCr 1  48             pha
0013BDr 1  AC rr rr       ldy TintColor
0013C0r 1  C0 01          cpy #TINT_NONE
0013C2r 1  F0 0B          beq @Light                    ; Nothing lit — nothing to put back
0013C4r 1  98             tya
0013C5r 1  4A             lsr a
0013C6r 1  4A             lsr a
0013C7r 1  4A             lsr a
0013C8r 1  A8             tay
0013C9r 1  B9 rr rr       lda TileColorTMS,y            ; Its own colour, straight out of the table the
0013CCr 1  20 rr rr       jsr VdpPutColor               ;   init loaded from
0013CFr 1               
0013CFr 1               @Light:
0013CFr 1  68             pla
0013D0r 1  8D rr rr       sta TintColor
0013D3r 1  C9 01          cmp #TINT_NONE
0013D5r 1  F0 0E          beq @Done
0013D7r 1  4A             lsr a
0013D8r 1  4A             lsr a
0013D9r 1  4A             lsr a
0013DAr 1  A8             tay
0013DBr 1  B9 rr rr       lda TileColorTMS,y
0013DEr 1  29 0F          and #$0F                      ; Keep the background nibble — black (SPEC 4.3)
0013E0r 1  09 F0          ora #$F0                      ; ...and make the foreground white
0013E2r 1  20 rr rr       jsr VdpPutColor
0013E5r 1               @Done:
0013E5r 1  60             rts
0013E6r 1               
0013E6r 1               ; -----------------------------------------------------------------------------
0013E6r 1               ;   VdpPutColor — In: A = colour byte, Y = group 0-31.  Modifies: A, X, Y
0013E6r 1               ; -----------------------------------------------------------------------------
0013E6r 1               VdpPutColor:
0013E6r 1  48             pha
0013E7r 1  98             tya
0013E8r 1  18             clc
0013E9r 1  69 00          adc #<VRAM_COLORS             ; 32 bytes, one per group; the low byte of the
0013EBr 1  A2 20          ldx #>VRAM_COLORS             ;   table's address is zero so this cannot carry
0013EDr 1  20 rr rr       jsr VdpSetWrite
0013F0r 1  68             pla
0013F1r 1  8D 00 9C       sta VC_DATA
0013F4r 1  60             rts
0013F5r 1               
0013F5r 1               ; -----------------------------------------------------------------------------
0013F5r 1               ;   HalSfx — one note on the SID at $9800 (hal.inc)
0013F5r 1               ;   In:  A = TIMBRE_*, X = note.  Out: nothing.  Modifies: A, X, Y, Tmp0-Tmp2
0013F5r 1               ;
0013F5r 1               ;   The sound card is the one piece of this machine the game uses and cannot
0013F5r 1               ;   count on — HW_PRESENT bit 6 is set by the BIOS probe at boot, and a machine
0013F5r 1               ;   with an empty IO 7 leaves it clear. Writing to an absent card's addresses
0013F5r 1               ;   is a read of a floating bus away from being harmless, and "harmless" is not
0013F5r 1               ;   a thing to build a frame on: the guard is four cycles and the game plays
0013F5r 1               ;   through in silence without it (PLAN.md P8).
0013F5r 1               ; -----------------------------------------------------------------------------
0013F5r 1               HalSfx:
0013F5r 1  48             pha
0013F6r 1  AD 0D 03       lda HW_PRESENT
0013F9r 1  29 40          and #HW_SID
0013FBr 1  F0 04          beq @None
0013FDr 1  68             pla
0013FEr 1  4C rr rr       jmp SidSfx                    ; include/sid.inc, shared with the C64
001401r 1               @None:
001401r 1  68             pla
001402r 1  60             rts
001403r 1               
001403r 1               SID_BASE = $9800                ; IO 7 (ac6502.inc). The C64's is $D400 and
001403r 1               .include "../include/sid.inc"   ;   nothing else about the two differs
001403r 2               ; =============================================================================
001403r 2               ;   sid.inc — the SID half of the HAL, shared by the two machines that have one
001403r 2               ; =============================================================================
001403r 2               ;   SPEC.md section 16: the AC6502 and the C64 "share SID driver code almost
001403r 2               ;   verbatim (register base differs: $9800 vs $D400)". This is that code, and
001403r 2               ;   the base is all that differs — the platform defines SID_BASE and includes
001403r 2               ;   this file once, from inside its CODE segment.
001403r 2               ;
001403r 2               ;   It is the one file in include/ that is not a list of equates. It has
001403r 2               ;   nowhere else to be: it belongs to two platforms and not to the third, so
001403r 2               ;   it cannot live in either WizardsLab.asm without one machine including the
001403r 2               ;   other's, and it cannot live in src/, where nothing touches hardware
001403r 2               ;   (PLAN.md D2, D22).
001403r 2               ;
001403r 2               ;   What it does NOT contain is a driver in the sequencing sense. Which effect
001403r 2               ;   is playing, which step of it, how long the step lasts and what note it is
001403r 2               ;   are all in src/audio.asm and shared by all three machines; SidSfx is asked
001403r 2               ;   for one note in one timbre and writes eleven registers.
001403r 2               ;
001403r 2               ;   ONE VOICE. Voice 1 only — the game plays one sound at a time by design
001403r 2               ;   (audio.asm), and voices 2 and 3 are left silent rather than half-used.
001403r 2               ;
001403r 2               ;   Leaves the RODATA segment selected; every caller declares its own segment
001403r 2               ;   immediately afterwards.
001403r 2               ; =============================================================================
001403r 2               
001403r 2               ; --- Register offsets from SID_BASE ------------------------------------------
001403r 2               SID_FREQ_LO         = 0
001403r 2               SID_FREQ_HI         = 1
001403r 2               SID_PW_LO           = 2
001403r 2               SID_PW_HI           = 3
001403r 2               SID_CTRL            = 4         ; Waveform in the high nibble, GATE in bit 0
001403r 2               SID_AD              = 5
001403r 2               SID_SR              = 6
001403r 2               SID_VOL             = 24        ; Master volume, low nibble
001403r 2               
001403r 2               ; --- The two levels (constants.inc) ------------------------------------------
001403r 2               ;   A SID has no per-voice volume, so this register is the only place a
001403r 2               ;   "quieter" can live. The game plays at full; the title screen's ambience
001403r 2               ;   plays under it (ambience.asm).
001403r 2               SID_VOL_FULL        = $0F
001403r 2               SID_VOL_QUIET       = $06
001403r 2               
001403r 2               ; -----------------------------------------------------------------------------
001403r 2               ;   SidSfx — HalSfx for a SID (hal.inc)
001403r 2               ;   In:  A = TIMBRE_*, optionally + TIMBRE_QUIET; X = note (semitones above C3;
001403r 2               ;        ignored when A is TIMBRE_OFF)
001403r 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0-Tmp2
001403r 2               ; -----------------------------------------------------------------------------
001403r 2               SidSfx:
001403r 2                 ; --- the level, which is bit 7 of the timbre and not a voice --------------
001403r 2                 ;   Written before the note rather than with it, so the volume is already
001403r 2                 ;   where it belongs when the gate comes up. Masked off first and on every
001403r 2                 ;   path, which is what makes a QUIET TIMBRE_OFF ($80) still silence.
001403r 2  A0 0F          ldy #SID_VOL_FULL
001405r 2  C9 80          cmp #TIMBRE_QUIET
001407r 2  90 04          bcc @Level
001409r 2  29 7F          and #TIMBRE_MASK
00140Br 2  A0 06          ldy #SID_VOL_QUIET
00140Dr 2               @Level:
00140Dr 2  8C 18 98       sty SID_BASE + SID_VOL
001410r 2               
001410r 2  C9 00          cmp #TIMBRE_OFF
001412r 2  F0 50          beq SidGateOff
001414r 2               
001414r 2  85 rr          sta Tmp0                      ; The timbre, 1..4 — an index into the three
001416r 2                                               ;   tables at the bottom of this file
001416r 2  BD rr rr       lda SidNoteLo,x
001419r 2  85 rr          sta Tmp1
00141Br 2  BD rr rr       lda SidNoteHi,x
00141Er 2  85 rr          sta Tmp2
001420r 2               
001420r 2                 ; --- the timbre's octave (constants.inc) ----------------------------------
001420r 2                 ;   A SID frequency register is linear in Hz, so an octave is a shift. On the
001420r 2                 ;   VIC-20 the same octave is free, because its three tone oscillators are
001420r 2                 ;   already an octave apart and the timbre picks between them.
001420r 2  A4 rr          ldy Tmp0
001422r 2  C0 01          cpy #TIMBRE_SOFT
001424r 2  D0 04          bne @NotSoft
001426r 2  46 rr          lsr Tmp2                      ; Down one
001428r 2  66 rr          ror Tmp1
00142Ar 2               @NotSoft:
00142Ar 2  C0 03          cpy #TIMBRE_BRIGHT
00142Cr 2  D0 04          bne @NotBright
00142Er 2  06 rr          asl Tmp1                      ; Up one
001430r 2  26 rr          rol Tmp2
001432r 2               @NotBright:
001432r 2               
001432r 2                 ; --- the hard restart ------------------------------------------------------
001432r 2                 ;   Gate down with a zeroed envelope BEFORE the new note. Without it the
001432r 2                 ;   SID's envelope generator can be caught mid-release and skip the attack
001432r 2                 ;   of the note that follows — the ADSR delay bug — and every step of every
001432r 2                 ;   effect comes through here, so a skipped attack is a silent sound effect
001432r 2                 ;   rather than a quiet one.
001432r 2  A9 00          lda #0
001434r 2  8D 04 98       sta SID_BASE + SID_CTRL
001437r 2  8D 05 98       sta SID_BASE + SID_AD
00143Ar 2  8D 06 98       sta SID_BASE + SID_SR
00143Dr 2               
00143Dr 2  A5 rr          lda Tmp1
00143Fr 2  8D 00 98       sta SID_BASE + SID_FREQ_LO
001442r 2  A5 rr          lda Tmp2
001444r 2  8D 01 98       sta SID_BASE + SID_FREQ_HI
001447r 2  A9 00          lda #$00                      ; A 50% pulse, which is a square wave. Only
001449r 2  8D 02 98       sta SID_BASE + SID_PW_LO      ;   TIMBRE_BRIGHT reads it, and it never
00144Cr 2  A9 08          lda #$08                      ;   changes, so it is written with everything
00144Er 2  8D 03 98       sta SID_BASE + SID_PW_HI      ;   else rather than kept as state
001451r 2               
001451r 2  B9 rr rr       lda SidAD - 1,y               ; The timbre tables are 1-based: TIMBRE_OFF
001454r 2  8D 05 98       sta SID_BASE + SID_AD         ;   never reaches them
001457r 2  B9 rr rr       lda SidSR - 1,y
00145Ar 2  8D 06 98       sta SID_BASE + SID_SR
00145Dr 2               
00145Dr 2  B9 rr rr       lda SidWave - 1,y
001460r 2  8D 04 98       sta SID_BASE + SID_CTRL       ; Waveform and GATE — the note starts here
001463r 2  60             rts
001464r 2               
001464r 2               ; -----------------------------------------------------------------------------
001464r 2               ;   SidGateOff — end whatever is sounding
001464r 2               ;   The release does the rest. Voice 1 keeps its frequency and waveform, which
001464r 2               ;   costs nothing and means the next note writes the same registers either way.
001464r 2               ; -----------------------------------------------------------------------------
001464r 2               SidGateOff:
001464r 2  A9 00          lda #0
001466r 2  8D 04 98       sta SID_BASE + SID_CTRL
001469r 2  60             rts
00146Ar 2               
00146Ar 2               ; =============================================================================
00146Ar 2               ;   SID tables
00146Ar 2               ; =============================================================================
00146Ar 2               
00146Ar 2               .segment "RODATA"
000000r 2               
000000r 2               ; --- Waveform and envelope by timbre, indexed 1..4 (constants.inc) -----------
000000r 2               ;   TIMBRE_SOFT   triangle, decaying to a low sustain — the lock's thunk and
000000r 2               ;                 the game-over run
000000r 2               ;   TIMBRE_BUZZ   sawtooth, full sustain
000000r 2               ;   TIMBRE_BRIGHT pulse, full sustain — chimes, blips and fanfares
000000r 2               ;   TIMBRE_NOISE  noise, no sustain at all: it decays to nothing on its own,
000000r 2               ;                 which is what makes a crack a crack rather than a hiss that
000000r 2               ;                 lasts exactly as long as its step
000000r 2               SidWave:
000000r 2  11 21 41 81    .byte $11, $21, $41, $81      ; ...and bit 0 of each is the gate, set
000004r 2               SidAD:
000004r 2  08 00 00 05    .byte $08, $00, $00, $05      ; Attack 0 on all four — a sound effect that
000008r 2                                               ;   fades in is a sound effect that is late
000008r 2               SidSR:
000008r 2  40 F0 C0 00    .byte $40, $F0, $C0, $00
00000Cr 2               
00000Cr 2               ; --- Note table: semitones above C3, C3 to C6 (NOTE_MAX) ---------------------
00000Cr 2               ;   Register value = round(Hz * 16777216 / 1000000), equal temperament from
00000Cr 2               ;   A4 = 440 Hz. That is the AC6502's 1 MHz SID clock exactly and the C64's
00000Cr 2               ;   within 2.3% either way — under half a semitone, and the SAME fraction for
00000Cr 2               ;   every note, so a C64 plays this perfectly in tune with itself and a hair
00000Cr 2               ;   sharp of an AC6502. Its two regions are a uniform transposition of each
00000Cr 2               ;   other for the same reason, which is why there is no second table here and
00000Cr 2               ;   nothing in this file reads Region.
00000Cr 2               ;
00000Cr 2               ;   The octave a note actually sounds in is the timbre's (constants.inc), so
00000Cr 2               ;   TIMBRE_BRIGHT doubles what it reads here and TIMBRE_SOFT halves it. C6
00000Cr 2               ;   doubled is 35114, well inside the register.
00000Cr 2               SidNoteLo:
00000Cr 2  93 15 9F 32    .byte $93, $15, $9F, $32, $CD, $72, $20, $D8, $9C, $6B, $46, $2F   ; C3-B3
000010r 2  CD 72 20 D8  
000014r 2  9C 6B 46 2F  
000018r 2  25 2A 3F 64    .byte $25, $2A, $3F, $64, $9A, $E3, $3F, $B1, $38, $D6, $8D, $5E   ; C4-B4
00001Cr 2  9A E3 3F B1  
000020r 2  38 D6 8D 5E  
000024r 2  4B 55 7E C8    .byte $4B, $55, $7E, $C8, $34, $C6, $7F, $61, $6F, $AC, $1A, $BC   ; C5-B5
000028r 2  34 C6 7F 61  
00002Cr 2  6F AC 1A BC  
000030r 2  95             .byte $95                                                          ; C6
000031r 2               SidNoteHi:
000031r 2  08 09 09 0A    .byte $08, $09, $09, $0A, $0A, $0B, $0C, $0C, $0D, $0E, $0F, $10   ; C3-B3
000035r 2  0A 0B 0C 0C  
000039r 2  0D 0E 0F 10  
00003Dr 2  11 12 13 14    .byte $11, $12, $13, $14, $15, $16, $18, $19, $1B, $1C, $1E, $20   ; C4-B4
000041r 2  15 16 18 19  
000045r 2  1B 1C 1E 20  
000049r 2  22 24 26 28    .byte $22, $24, $26, $28, $2B, $2D, $30, $33, $36, $39, $3D, $40   ; C5-B5
00004Dr 2  2B 2D 30 33  
000051r 2  36 39 3D 40  
000055r 2  44             .byte $44                                                          ; C6
000056r 2               
000056r 1               
000056r 1               ; =============================================================================
000056r 1               ;   Data
000056r 1               ; =============================================================================
000056r 1               
000056r 1               .segment "RODATA"
000056r 1               
000056r 1               .include "../data/tilecolor-tms9918.inc"
000056r 2               ; =============================================================================
000056r 2               ;   tilecolor-tms9918.inc — TMS9918 Graphics I colour table
000056r 2               ; =============================================================================
000056r 2               ;   Generated from SPEC.md section 4.3 and Appendix A. Spec-derived data, not
000056r 2               ;   artwork: edit this file by hand, it is never overwritten by an editor
000056r 2               ;   export. Tile groups 16-31 (tiles 128-255) are the margin artwork and their
000056r 2               ;   colours are the artist's to choose.
000056r 2               ; =============================================================================
000056r 2               
000056r 2               
000056r 2               ;   32 bytes -> VDP colour table. Each byte is (foreground << 4) | background;
000056r 2               ;   background is 1 (black) throughout, matching the backdrop register.
000056r 2               
000056r 2               TileColorTMS:
000056r 2  F1             .byte $F1                        ; group 0  tiles   0-7    UI / well frame        white
000057r 2  E1             .byte $E1                        ; group 1  tiles   8-15   UI accents             gray
000058r 2  F1             .byte $F1                        ; group 2  tiles  16-23   Font  0 1 2 3 4 5 6 7  white
000059r 2  F1             .byte $F1                        ; group 3  tiles  24-31   Font  8 9 A B C D E F  white
00005Ar 2  F1             .byte $F1                        ; group 4  tiles  32-39   Font  G H I J K L M N  white
00005Br 2  F1             .byte $F1                        ; group 5  tiles  40-47   Font  O P Q R S T U V  white
00005Cr 2  F1             .byte $F1                        ; group 6  tiles  48-55   Font  W X Y Z . x ! -  white
00005Dr 2  F1             .byte $F1                        ; group 7  tiles  56-63   VFX                    white
00005Er 2  81             .byte $81                        ; group 8  tiles  64-71   POTION 0  RED
00005Fr 2  B1             .byte $B1                        ; group 9  tiles  72-79   POTION 1  YELLOW
000060r 2  31             .byte $31                        ; group 10 tiles  80-87   POTION 2  GREEN
000061r 2  71             .byte $71                        ; group 11 tiles  88-95   POTION 3  CYAN
000062r 2  51             .byte $51                        ; group 12 tiles  96-103  POTION 4  BLUE
000063r 2  D1             .byte $D1                        ; group 13 tiles 104-111  POTION 5  PURPLE
000064r 2  F1             .byte $F1                        ; group 14 tiles 112-119  POTION 6  WILD / prism white
000065r 2  61             .byte $61                        ; group 15 tiles 120-127  Wall / stone           dark red
000066r 2  E1             .byte $E1                        ; group 16 tiles 128-135  artwork
000067r 2  61             .byte $61                        ; group 17 tiles 136-143  artwork
000068r 2  C1             .byte $C1                        ; group 18 tiles 144-151  artwork
000069r 2  A1             .byte $A1                        ; group 19 tiles 152-159  artwork
00006Ar 2  41             .byte $41                        ; group 20 tiles 160-167  artwork
00006Br 2  21             .byte $21                        ; group 21 tiles 168-175  artwork
00006Cr 2  91             .byte $91                        ; group 22 tiles 176-183  artwork
00006Dr 2  71             .byte $71                        ; group 23 tiles 184-191  artwork
00006Er 2  B1             .byte $B1                        ; group 24 tiles 192-199  artwork
00006Fr 2  51             .byte $51                        ; group 25 tiles 200-207  artwork
000070r 2  D1             .byte $D1                        ; group 26 tiles 208-215  artwork
000071r 2  31             .byte $31                        ; group 27 tiles 216-223  artwork
000072r 2  81             .byte $81                        ; group 28 tiles 224-231  artwork
000073r 2  F1             .byte $F1                        ; group 29 tiles 232-239  artwork
000074r 2  E1             .byte $E1                        ; group 30 tiles 240-247  artwork
000075r 2  F1             .byte $F1                        ; group 31 tiles 248-255  artwork
000076r 2               
000076r 1               .include "../src/tables.inc"
000076r 2               ; =============================================================================
000076r 2               ;   tables.inc — Wizards Lab, spec-derived lookup tables
000076r 2               ; =============================================================================
000076r 2               ;   Straight out of SPEC.md sections 5.3, 9, 10, 14 and 16. Hand-authored,
000076r 2               ;   never overwritten by an editor export. Included once, from the RODATA
000076r 2               ;   segment.
000076r 2               ;
000076r 2               ;   Score values above 99 do not fit in a byte, so every scoring table is a
000076r 2               ;   pair of parallel arrays — low BCD byte and high BCD byte — indexed by the
000076r 2               ;   same value.
000076r 2               ; =============================================================================
000076r 2               
000076r 2               ; --- Gravity, frames per row (SPEC 10.2) -------------------------------------
000076r 2               ;   Indexed by (level - 1), clamped to LEVEL_SPEED_CAP - 1.
000076r 2               ;   PAL is round(NTSC * 50/60), so wall-clock speed matches across regions.
000076r 2               
000076r 2               SpeedNTSC:
000076r 2  30 2B 26 22    .byte  48, 43, 38, 34, 30, 26, 23, 20   ; levels  1- 8   0.800s .. 0.333s
00007Ar 2  1E 1A 17 14  
00007Er 2  11 0F 0D 0B    .byte  17, 15, 13, 11,  9,  8,  7,  6   ; levels  9-16   0.283s .. 0.100s
000082r 2  09 08 07 06  
000086r 2               
000086r 2               SpeedPAL:
000086r 2  28 24 20 1C    .byte  40, 36, 32, 28, 25, 22, 19, 17   ; levels  1- 8   0.800s .. 0.340s
00008Ar 2  19 16 13 11  
00008Er 2  0E 0D 0B 09    .byte  14, 13, 11,  9,  8,  7,  6,  5   ; levels  9-16   0.280s .. 0.100s
000092r 2  08 07 06 05  
000096r 2               
000096r 2               ; --- Frame counts that differ by region (SPEC 5.6, 11.3, 14) -----------------
000096r 2               ;   Indexed by Region: 0 = NTSC, 1 = PAL. PAL is round(NTSC * 50/60) wherever
000096r 2               ;   the difference is worth a frame, so a piece takes the same number of
000096r 2               ;   SECONDS to lock on both machines rather than the same number of frames.
000096r 2               ;
000096r 2               ;   Two bytes each rather than one table of pairs, because every read is
000096r 2               ;   `ldx Region / lda Name,x` and a pair table would need the index doubled.
000096r 2               
000096r 2               LockDelay:                              ; SPEC 5.6
000096r 2  10 0E          .byte 16, 14
000098r 2               AreDelay:                               ; Entry delay after a cascade settles
000098r 2  0C 0A          .byte 12, 10
00009Ar 2               DasInitial:                             ; SPEC 11.3 — first repeat
00009Ar 2  0C 0A          .byte 12, 10
00009Cr 2               DasRepeat:                              ; ...and every one after it
00009Cr 2  04 03          .byte  4,  3
00009Er 2               SoftDropRate:                           ; Frames per row while DOWN is held.
00009Er 2  03 02          .byte  3,  2                          ;   Never used when gravity is faster.
0000A0r 2               BlinkHalf:                              ; SPEC 14 — half of the 30 / 25 frame
0000A0r 2  0F 0D          .byte 15, 13                          ;   blink period, which is what a
0000A2r 2                                                       ;   blinking field actually counts
0000A2r 2               GlowFrames:                             ; SPEC 14 — the GLOW window: the match
0000A2r 2  06 05          .byte  6,  5                          ;   glow and the bolt's beams
0000A4r 2               FlashFrames:                            ; ...and what the window grows to when
0000A4r 2  08 07          .byte  8,  7                          ;   a fireball fired, because its flash
0000A6r 2                                                       ;   is the longer of the two and both
0000A6r 2                                                       ;   are showing at once (constants.inc)
0000A6r 2               BannerFrames:                           ; SPEC 14 — how long LEVEL UP and
0000A6r 2  2D 26          .byte 45, 38                          ;   CHAIN xN stay in the message band
0000A8r 2               SecondFrames:                           ; One second, which is the unit the
0000A8r 2  3C 32          .byte 60, 50                          ;   game-over timeout is counted in
0000AAr 2                                                       ;   (SPEC 13.4). The only entry here
0000AAr 2                                                       ;   that is not a duration out of
0000AAr 2                                                       ;   SPEC 14 but the frame rate itself
0000AAr 2               
0000AAr 2               ; --- The two removal animations (SPEC 14, Appendix A.3) ----------------------
0000AAr 2               ;   One ring, run in both directions. Indexed by AnimStep, which advances every
0000AAr 2               ;   VFX_FRAMES frames.
0000AAr 2               ;
0000AAr 2               ;   Potions, reagents, the bomb blast and the star all open OUTWARD and are
0000AAr 2               ;   gone in SHATTER_STEPS frames; the fourth entry only ever comes up when a
0000AAr 2               ;   marked prism is blipping out beside them and holding the window open, and
0000AAr 2               ;   it blanks the cell rather than leaving the last ring frame sitting there
0000AAr 2               ;   for four more frames.
0000AAr 2               
0000AAr 2               VfxShatter:
0000AAr 2  38 39 3A 00    .byte VFX_REMOVE1, VFX_REMOVE2, VFX_REMOVE3, TILE_EMPTY
0000AEr 2               
0000AEr 2               ;   The prism closes INWARD, and does not pass through the glow (SPEC A.3 —
0000AEr 2               ;   group 14 has no glyph +6). Five frames, so a step that clears one runs
0000AEr 2               ;   BLIP_STEPS rather than SHATTER_STEPS.
0000AEr 2               
0000AEr 2               VfxBlip:
0000AEr 2  74 75 39 38    .byte PRISM_BLIP, PRISM_BLIP + 1, VFX_REMOVE2, VFX_REMOVE1, FONT_DOT
0000B2r 2  34           
