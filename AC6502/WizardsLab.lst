0000FBr 2  5C           
0000FCr 2               
0000FCr 2               ; --- Reagent type, cumulative thresholds out of 256 (SPEC 5.3) ---------------
0000FCr 2               ;   Four thresholds per band; a roll at or above the last one is a Prism.
0000FCr 2               ;       roll <  [0] -> Fireball
0000FCr 2               ;       roll <  [1] -> Bolt
0000FCr 2               ;       roll <  [2] -> Bomb
0000FCr 2               ;       roll <  [3] -> Star
0000FCr 2               ;       else        -> Prism
0000FCr 2               ReagentThresholds:
0000FCr 2  4D 8A C3 EC    .byte  77, 138, 195, 236             ; band 0   levels  1-3
000100r 2  4D 8D C0 EE    .byte  77, 141, 192, 238             ; band 1   levels  4-6
000104r 2  52 92 C5 EE    .byte  82, 146, 197, 238             ; band 2   levels  7-9
000108r 2  4F 8D C3 EE    .byte  79, 141, 195, 238             ; band 3   levels 10-12
00010Cr 2  4F 8F C7 F0    .byte  79, 143, 199, 240             ; band 4   levels 13+
000110r 2               
000110r 2               ; --- Reagent trigger bonuses, indexed by glyph (SPEC 9.5) --------------------
000110r 2               ;   Glyph 0 potion and 4 star award nothing here (the star multiplies instead).
000110r 2               TriggerBonusLo:
000110r 2  00 00 00 00    .byte $00, $00, $00, $00, $00, $00, $00, $00
000114r 2  00 00 00 00  
000118r 2               TriggerBonusHi:
000118r 2  00 05 03 03    .byte $00, $05, $03, $03, $00, $00, $00, $00
00011Cr 2  00 00 00 00  
000120r 2               
000120r 2               ; --- The twelve sound effects (SPEC 16) --------------------------------------
000120r 2               ;   An effect is a list of STEPS and a step is three bytes: how many FRAMES it
000120r 2               ;   lasts, its TIMBRE, and its NOTE in semitones above C3 (constants.inc). A
000120r 2               ;   zero frame count ends the list. Nothing here is a register value: a note
000120r 2               ;   means the same pitch on both sound chips and each platform turns it into
000120r 2               ;   whatever its own hardware wants (audio.asm, hal.inc).
000120r 2               ;
000120r 2               ;   SPEC 16 gives each effect a CHARACTER and not a tune — "short blip",
000120r 2               ;   "dull thunk", "descending noise sweep" — and the notes below are the
000120r 2               ;   reading of it. What is not a choice is the range: the VIC-I's oscillator
000120r 2               ;   value runs out of resolution above C5, where consecutive semitones start
000120r 2               ;   landing on the same number, so everything melodic is WRITTEN inside C3-C5
000120r 2               ;   and lifted by its timbre instead. TIMBRE_BRIGHT is already an octave up.
000120r 2               ;
000120r 2               ;   SfxStepIdx is a byte offset into SfxSteps, so this table has to stay under
000120r 2               ;   256 bytes. It is 196 — 144 for SPEC 16's twelve, 25 for the thirteenth that
000120r 2               ;   starts a game, and 27 for the three at the bottom that belong to the title
000120r 2               ;   screen's ambience rather than to the game (constants.inc, ambience.asm).
000120r 2               
000120r 2               SfxOffsets:                             ; Indexed by (SFX_* id - 1)
000120r 2  00             .byte SfxMove     - SfxSteps
000121r 2  04             .byte SfxRotate   - SfxSteps
000122r 2  0B             .byte SfxLock     - SfxSteps
000123r 2  12             .byte SfxMatch    - SfxSteps
000124r 2  19             .byte SfxFireball - SfxSteps
000125r 2  29             .byte SfxBolt     - SfxSteps
000126r 2  2D             .byte SfxBomb     - SfxSteps
000127r 2  34             .byte SfxStar     - SfxSteps
000128r 2  41             .byte SfxPrism    - SfxSteps
000129r 2  54             .byte SfxLevelUp  - SfxSteps
00012Ar 2  61             .byte SfxHighScore- SfxSteps
00012Br 2  77             .byte SfxGameOver - SfxSteps
00012Cr 2  90             .byte SfxStart    - SfxSteps          ; 13 is an event SPEC 16 does not have
00012Dr 2  A9             .byte SfxBubble   - SfxSteps          ; 14-16 are the title screen's, and are
00012Er 2  B3             .byte SfxGloop    - SfxSteps          ;   not events — see the ambience at the
00012Fr 2  BA             .byte SfxSeethe   - SfxSteps          ;   bottom of this file
000130r 2               
000130r 2               SfxSteps:
000130r 2               
000130r 2               SfxMove:                                ; 1 — short blip                2 frames
000130r 2  02 03 13       .byte  2, TIMBRE_BRIGHT, OCT_4 + SEMI_G
000133r 2  00             .byte  0
000134r 2               
000134r 2               SfxRotate:                              ; 2 — rising two-step           6 frames
000134r 2  03 03 0C       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_C
000137r 2  03 03 13       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_G
00013Ar 2  00             .byte  0
00013Br 2               
00013Br 2               SfxLock:                                ; 3 — dull thunk                6 frames
00013Br 2  02 04 0C       .byte  2, TIMBRE_NOISE,  OCT_4 + SEMI_C
00013Er 2  04 01 0C       .byte  4, TIMBRE_SOFT,   OCT_4 + SEMI_C
000141r 2  00             .byte  0
000142r 2               
000142r 2               SfxMatch:                               ; 4 — bright chime              9 frames
000142r 2  03 03 0C       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_C   ; ...and the whole thing is
000145r 2  06 03 10       .byte  6, TIMBRE_BRIGHT, OCT_4 + SEMI_E   ;   transposed up by the chain
000148r 2  00             .byte  0                                  ;   (SPEC 16, audio.asm)
000149r 2               
000149r 2               SfxFireball:                            ; 5 — descending noise sweep   10 frames
000149r 2  02 04 24       .byte  2, TIMBRE_NOISE,  OCT_6 + SEMI_C
00014Cr 2  02 04 1F       .byte  2, TIMBRE_NOISE,  OCT_5 + SEMI_G
00014Fr 2  02 04 1A       .byte  2, TIMBRE_NOISE,  OCT_5 + SEMI_D
000152r 2  02 04 15       .byte  2, TIMBRE_NOISE,  OCT_4 + SEMI_A
000155r 2  02 04 10       .byte  2, TIMBRE_NOISE,  OCT_4 + SEMI_E
000158r 2  00             .byte  0
000159r 2               
000159r 2               SfxBolt:                                ; 6 — fast noise crack          3 frames
000159r 2  03 04 21       .byte  3, TIMBRE_NOISE,  OCT_5 + SEMI_A
00015Cr 2  00             .byte  0
00015Dr 2               
00015Dr 2               SfxBomb:                                ; 7 — low noise thump          10 frames
00015Dr 2  02 04 0E       .byte  2, TIMBRE_NOISE,  OCT_4 + SEMI_D
000160r 2  08 04 04       .byte  8, TIMBRE_NOISE,  OCT_3 + SEMI_E
000163r 2  00             .byte  0
000164r 2               
000164r 2               SfxStar:                                ; 8 — sparkle arpeggio          8 frames
000164r 2  02 03 0C       .byte  2, TIMBRE_BRIGHT, OCT_4 + SEMI_C
000167r 2  02 03 10       .byte  2, TIMBRE_BRIGHT, OCT_4 + SEMI_E
00016Ar 2  02 03 13       .byte  2, TIMBRE_BRIGHT, OCT_4 + SEMI_G
00016Dr 2  02 03 18       .byte  2, TIMBRE_BRIGHT, OCT_5 + SEMI_C
000170r 2  00             .byte  0
000171r 2               
000171r 2               SfxPrism:                               ; 9 — shimmer                  12 frames
000171r 2  02 02 18       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_C   ; The one effect that wants an edge
000174r 2  02 02 1C       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_E   ;   to it rather than a bell: a
000177r 2  02 02 18       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_C   ;   sawtooth beating between two
00017Ar 2  02 02 1C       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_E   ;   notes six times in a fifth of
00017Dr 2  02 02 18       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_C   ;   a second
000180r 2  02 02 1C       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_E
000183r 2  00             .byte  0
000184r 2               
000184r 2               SfxLevelUp:                             ; 10 — fanfare                 25 frames
000184r 2  05 03 0C       .byte  5, TIMBRE_BRIGHT, OCT_4 + SEMI_C
000187r 2  05 03 10       .byte  5, TIMBRE_BRIGHT, OCT_4 + SEMI_E
00018Ar 2  05 03 13       .byte  5, TIMBRE_BRIGHT, OCT_4 + SEMI_G
00018Dr 2  0A 03 18       .byte 10, TIMBRE_BRIGHT, OCT_5 + SEMI_C
000190r 2  00             .byte  0
000191r 2               
000191r 2               SfxHighScore:                           ; 11 — longer fanfare          40 frames
000191r 2  04 03 0C       .byte  4, TIMBRE_BRIGHT, OCT_4 + SEMI_C
000194r 2  04 03 10       .byte  4, TIMBRE_BRIGHT, OCT_4 + SEMI_E
000197r 2  04 03 13       .byte  4, TIMBRE_BRIGHT, OCT_4 + SEMI_G
00019Ar 2  04 03 18       .byte  4, TIMBRE_BRIGHT, OCT_5 + SEMI_C
00019Dr 2  04 03 13       .byte  4, TIMBRE_BRIGHT, OCT_4 + SEMI_G
0001A0r 2  04 03 18       .byte  4, TIMBRE_BRIGHT, OCT_5 + SEMI_C
0001A3r 2  10 03 1C       .byte 16, TIMBRE_BRIGHT, OCT_5 + SEMI_E
0001A6r 2  00             .byte  0
0001A7r 2               
0001A7r 2               SfxGameOver:                            ; 12 — descending minor run    58 frames
0001A7r 2  06 01 15       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_A
0001AAr 2  06 01 13       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_G
0001ADr 2  06 01 11       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_F
0001B0r 2  06 01 10       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_E
0001B3r 2  06 01 0E       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_D
0001B6r 2  06 01 0C       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_C
0001B9r 2  06 01 0B       .byte  6, TIMBRE_SOFT,   OCT_3 + SEMI_B
0001BCr 2  10 01 09       .byte 16, TIMBRE_SOFT,   OCT_3 + SEMI_A
0001BFr 2  00             .byte  0
0001C0r 2               
0001C0r 2               ; --- ...and the thirteenth, which is that one backwards ----------------------
0001C0r 2               ;   The game announcing itself (constants.inc). SPEC 16 has no such effect and
0001C0r 2               ;   the game had no sound at all for the transition that matters most: the
0001C0r 2               ;   screen changes, a piece is already falling, and nothing says so.
0001C0r 2               ;
0001C0r 2               ;   It is the GAME-OVER RUN CLIMBED — the same eight notes of A minor in the
0001C0r 2               ;   other order, so the game opens with the phrase that will close it, played
0001C0r 2               ;   backwards. Two things about it are not mirrored, and both are the point:
0001C0r 2               ;
0001C0r 2               ;     BRIGHT, not SOFT. A timbre is a voice and an octave (constants.inc), so
0001C0r 2               ;     the same written notes come out two octaves above the game-over run
0001C0r 2               ;     rather than beside it. The contour is the quotation; the colour is what
0001C0r 2               ;     says which end of the game you are at.
0001C0r 2               ;
0001C0r 2               ;     THREE FRAMES A STEP, not six. A loss is allowed to take its time because
0001C0r 2               ;     nothing is happening afterwards. A start is not: the first piece is
0001C0r 2               ;     already falling while this plays, and 33 frames is about as long as a
0001C0r 2               ;     sound can hold the top of a screen the player has started using.
0001C0r 2               ;
0001C0r 2               ;   A scale and not an arpeggio, which is what keeps it clear of the two
0001C0r 2               ;   fanfares above — those leap, this walks.
0001C0r 2               
0001C0r 2               SfxStart:                               ; 13 — the run, climbed       33 frames
0001C0r 2  03 03 09       .byte  3, TIMBRE_BRIGHT, OCT_3 + SEMI_A
0001C3r 2  03 03 0B       .byte  3, TIMBRE_BRIGHT, OCT_3 + SEMI_B
0001C6r 2  03 03 0C       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_C
0001C9r 2  03 03 0E       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_D
0001CCr 2  03 03 10       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_E
0001CFr 2  03 03 11       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_F
0001D2r 2  03 03 13       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_G
0001D5r 2  0C 03 15       .byte 12, TIMBRE_BRIGHT, OCT_4 + SEMI_A   ; ...and arrives, rather than
0001D8r 2  00             .byte  0                                  ;   stopping
0001D9r 2               
0001D9r 2               ; --- The cauldron (constants.inc) --------------------------------------------
0001D9r 2               ;   Three more step lists, in the same table and read by the same driver, and
0001D9r 2               ;   the only things about them that are not effects are that no event asks for
0001D9r 2               ;   one and that the ambience pitches each one up by a random 0-7 semitones
0001D9r 2               ;   before it plays. That transposition is what turns three lists into a boil:
0001D9r 2               ;   a bubble is a bubble whatever size it is, and a cauldron of one size sounds
0001D9r 2               ;   like a machine.
0001D9r 2               ;
0001D9r 2               ;   All three are TIMBRE_SOFT or TIMBRE_NOISE and all three are written in the
0001D9r 2               ;   bottom octave and a half, because everything up here has to sit UNDER the
0001D9r 2               ;   title screen rather than on top of it. Nothing bright bubbles.
0001D9r 2               
0001D9r 2               SfxBubble:                              ; 13 — a bloop, rising      8 frames
0001D9r 2  03 01 0C       .byte  3, TIMBRE_SOFT,   OCT_4 + SEMI_C   ; TIMBRE_SOFT sounds an octave
0001DCr 2  03 01 13       .byte  3, TIMBRE_SOFT,   OCT_4 + SEMI_G   ;   below what is written, so this
0001DFr 2  02 01 18       .byte  2, TIMBRE_SOFT,   OCT_5 + SEMI_C   ;   is C3 to C4 (constants.inc)
0001E2r 2  00             .byte  0
0001E3r 2               
0001E3r 2               SfxGloop:                               ; 14 — a heavier one, falling  6 frames
0001E3r 2  02 01 13       .byte  2, TIMBRE_SOFT,   OCT_4 + SEMI_G
0001E6r 2  04 01 0C       .byte  4, TIMBRE_SOFT,   OCT_4 + SEMI_C
0001E9r 2  00             .byte  0
0001EAr 2               
0001EAr 2               SfxSeethe:                              ; 15 — the churn under both    9 frames
0001EAr 2  03 04 07       .byte  3, TIMBRE_NOISE,  OCT_3 + SEMI_G   ; Low noise, dropping: the sound a
0001EDr 2  04 04 00       .byte  4, TIMBRE_NOISE,  OCT_3 + SEMI_C   ;   pot makes between bubbles
0001F0r 2  02 00 00       .byte  2, TIMBRE_OFF,    0                ; A REST, and a legal step — the
0001F3r 2  00             .byte  0                                  ;   driver hands TIMBRE_OFF to the
0001F4r 2                                                           ;   platform like any other timbre
0001F4r 2                                                           ;   and gets silence for a beat,
0001F4r 2                                                           ;   which keeps the churn from
0001F4r 2                                                           ;   running straight into whatever
0001F4r 2                                                           ;   the next roll deals
0001F4r 2               
0001F4r 2               ; --- The mix (ambience.asm) --------------------------------------------------
0001F4r 2               ;   Rolled once per sound, indexed by five random bits, so the shape of the
0001F4r 2               ;   ambience is this table and nothing else: twenty-seven bubbles of one kind
0001F4r 2               ;   or another to five borrowed effects, which is one thing happening in the
0001F4r 2               ;   lab for every five or six the cauldron does. Change the balance by changing
0001F4r 2               ;   the entries — there is no other knob and no code to edit.
0001F4r 2               ;
0001F4r 2               ;   THIRTY-TWO ROWS AND NOT SIXTEEN, which is the whole of how the borrowed
0001F4r 2               ;   effects were halved after the first version came out too busy: the five of
0001F4r 2               ;   them are the same five, spread over twice as many rolls. Doing it the other
0001F4r 2               ;   way — dropping two or three of the five from a sixteen-row table — would
0001F4r 2               ;   have changed which sounds the lab makes as well as how often it makes one,
0001F4r 2               ;   and the mix among them was not the problem.
0001F4r 2               ;
0001F4r 2               ;   The five borrowed ones are the game's own sounds (SPEC 16), played half
0001F4r 2               ;   volume and out of context: the prism's shimmer and the star's arpeggio read
0001F4r 2               ;   as apparatus, the bolt's crack as a spark somewhere off to the side, the
0001F4r 2               ;   lock's thunk as something heavy being set down, and the match chime as a
0001F4r 2               ;   phial being touched. Nothing louder than those — a game-over run drifting
0001F4r 2               ;   past the title screen would sound like a fault, not a laboratory.
0001F4r 2               ;
0001F4r 2               ;   Position means nothing here; only the counts do. Every roll is independent,
0001F4r 2               ;   so the five are spread out to be read rather than to be heard that way.
0001F4r 2               
0001F4r 2               AmbTable:
0001F4r 2  0E 10 0E 09    .byte SFX_BUBBLE, SFX_SEETHE, SFX_BUBBLE, SFX_PRISM
0001F8r 2  0F 0E 0E 10    .byte SFX_GLOOP,  SFX_BUBBLE, SFX_BUBBLE, SFX_SEETHE
0001FCr 2  0E 0F 06 0E    .byte SFX_BUBBLE, SFX_GLOOP,  SFX_BOLT,   SFX_BUBBLE
000200r 2  0F 10 0E 0E    .byte SFX_GLOOP,  SFX_SEETHE, SFX_BUBBLE, SFX_BUBBLE
000204r 2  04 0E 0F 0E    .byte SFX_MATCH,  SFX_BUBBLE, SFX_GLOOP,  SFX_BUBBLE
000208r 2  10 0E 0F 08    .byte SFX_SEETHE, SFX_BUBBLE, SFX_GLOOP,  SFX_STAR
00020Cr 2  0F 0E 10 0E    .byte SFX_GLOOP,  SFX_BUBBLE, SFX_SEETHE, SFX_BUBBLE
000210r 2  0E 03 0F 0E    .byte SFX_BUBBLE, SFX_LOCK,   SFX_GLOOP,  SFX_BUBBLE
000214r 2               
000214r 2               
000214r 1               .include "../src/strings.inc"
000214r 2               ; =============================================================================
000214r 2               ;   strings.inc — Wizards Lab, tile-encoded text
000214r 2               ; =============================================================================
000214r 2               ;   Strings are stored as TILE numbers, not ASCII, terminated by TEXT_END, so
000214r 2               ;   TextDraw is a copy with no translation at run time (see text.asm). The
000214r 2               ;   translation happens here instead, at assembly time, in TileStr.
000214r 2               ;
000214r 2               ;   Hand-authored, never overwritten by an editor export (D3). Included once,
000214r 2               ;   from each platform's RODATA segment.
000214r 2               ; =============================================================================
000214r 2               
000214r 2               ; -----------------------------------------------------------------------------
000214r 2               ;   TileChar / TileStr — ASCII source, tile bytes out
000214r 2               ;   The font is forty glyphs in one run from FONT_BASE:
000214r 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
000214r 2               ;   and a space is TILE_BLANK. Anything else is not in the tileset and is an
000214r 2               ;   assembly error rather than a wrong glyph on the screen.
000214r 2               ; -----------------------------------------------------------------------------
000214r 2               .macro TileChar c
000214r 2                 .if c = ' '
000214r 2                   .byte TILE_BLANK
000214r 2                 .elseif (c >= '0') .and (c <= '9')
000214r 2                   .byte FONT_DIGIT_0 + (c - '0')
000214r 2                 .elseif (c >= 'A') .and (c <= 'Z')
000214r 2                   .byte FONT_LETTER_A + (c - 'A')
000214r 2                 .elseif c = '.'
000214r 2                   .byte FONT_DOT
000214r 2                 .elseif c = 'x'
000214r 2                   .byte FONT_TIMES
000214r 2                 .elseif c = '!'
000214r 2                   .byte FONT_BANG
000214r 2                 .elseif c = '~'
000214r 2                   .byte FONT_TILDE
000214r 2                 .else
000214r 2                   .error "strings.inc: no tile for this character"
000214r 2                 .endif
000214r 2               .endmacro
000214r 2               
000214r 2               .macro TileStr s
000214r 2                 .repeat .strlen(s), I
000214r 2                   TileChar {.strat(s, I)}
000214r 2                 .endrepeat
000214r 2                 .byte TEXT_END
000214r 2               .endmacro
000214r 2               
000214r 2               ; -----------------------------------------------------------------------------
000214r 2               ;   Banners — SPEC 12.2, 13.3
000214r 2               ;   Even length, so (PANEL_W - length) / 2 centres exactly. The band is 18
000214r 2               ;   cells of backdrop between two shelf tiles either side, so a banner has 18
000214r 2               ;   to play with before it starts overwriting the artwork.
000214r 2               ;
000214r 2               ;   MsgPaused matches the play screen image byte for byte on purpose: the
000214r 2               ;   artwork ships with the band already reading `~~ PAUSED ~~` (see SPEC 12.1),
000214r 2               ;   so entering play clears the band and pausing draws this straight back.
000214r 2               ; -----------------------------------------------------------------------------
000214r 2               MsgPaused:
000214r 2  37 37 00 29    TileStr "~~ PAUSED ~~"                 ; 12 cells, centres at panel column 5
000218r 2  1A 2E 2C 1E  
00021Cr 2  1D 00 37 37  
000221r 2               
000221r 2               MsgLevelUp:
000221r 2  37 37 00 25    TileStr "~~ LEVEL UP ~~"               ; 14 cells, centres at panel column 4
000225r 2  1E 2F 1E 25  
000229r 2  00 2E 29 00  
000230r 2               
000230r 2               ; `GAME OVER` is nine characters, so a symmetric ornament around it is always
000230r 2               ; an ODD length and would sit half a cell left of centre. The bang makes it
000230r 2               ; even and is the reason it is there; SPEC 13.4 records the wording.
000230r 2               MsgGameOver:
000230r 2  37 37 00 20    TileStr "~~ GAME OVER! ~~"             ; 16 cells, centres at panel column 3
000234r 2  1A 26 1E 00  
000238r 2  28 2F 1E 2B  
000241r 2               
000241r 2               ; The chain banner carries a number, and TextDraw copies bytes rather than
000241r 2               ; formatting them, so the digit is a placeholder that CascadeSettle overwrites
000241r 2               ; with one RenderMark at CHAIN_DIGIT_X (constants.inc). Keeping the length at
000241r 2               ; MSG_CHAIN_LEN is what makes that column a constant instead of a measurement.
000241r 2               MsgChain:
000241r 2  37 37 00 1C    TileStr "~~ CHAIN x0 ~~"               ; 14 cells; the `0` is panel column 14
000245r 2  21 1A 22 27  
000249r 2  00 35 10 00  
000250r 2               
000250r 2               ; -----------------------------------------------------------------------------
000250r 2               ;   The title screen's prompt (SPEC 13.1)
000250r 2               ;   Not a banner: it is ten cells of the DRAWN title image, and the only reason
000250r 2               ;   the string exists at all is that blinking it means putting it back. It must
000250r 2               ;   match data/screen-title-*.bin at PROMPT_X, PROMPT_Y byte for byte, or the
000250r 2               ;   first blink would redraw the screen slightly differently from the way the
000250r 2               ;   artist drew it.
000250r 2               ; -----------------------------------------------------------------------------
000250r 2               MsgPressFire:
000250r 2  29 2B 1E 2C    TileStr "PRESS FIRE"                   ; PROMPT_LEN cells (constants.inc)
000254r 2  2C 00 1F 22  
000258r 2  2B 1E FF     
00025Br 2               
00025Br 1               
00025Br 1               ; --- PLACEHOLDER ART — replace via TMS9918-EDITOR, see data/README.md --------
00025Br 1  00 00 00 00  TitleScreen:  .incbin "../data/screen-title-ac6502.bin"
00025Fr 1  00 00 00 00  
000263r 1  00 00 00 00  
00055Br 1  7F 7F 7F 7F  PlayScreen:   .incbin "../data/screen-play-ac6502.bin"
00055Fr 1  7F 7E 7E 7E  
000563r 1  7E 7E 7E 7E  
00085Br 1               TitleColor    = TitleScreen      ; No colour RAM on this machine
00085Br 1               PlayColor     = PlayScreen
00085Br 1               
00085Br 1               .segment "TILES"
000000r 1               
000000r 1  00 00 00 00  Tileset:      .incbin "../data/tileset.bin"
000004r 1  00 00 00 00  
000008r 1  00 00 7E AB  
000800r 1               
000800r 1               ; =============================================================================
000800r 1               ;   Interrupt trampolines and CPU vectors
000800r 1               ; =============================================================================
000800r 1               ;   KernalInit has already pointed the RAM vectors at the default handlers, so
000800r 1               ;   bouncing through them keeps keyboard and serial input alive without this
000800r 1               ;   cartridge writing a handler of its own.
000800r 1               
000800r 1               .segment "CODE"
00146Ar 1               
00146Ar 1               IrqTrampoline:
00146Ar 1  6C 00 03       jmp (IRQ_PTR)
00146Dr 1               
00146Dr 1               NmiTrampoline:
00146Dr 1  6C 04 03       jmp (NMI_PTR)
001470r 1               
001470r 1               .segment "VECTORS"
000000r 1               
000000r 1  rr rr        .word   NmiTrampoline           ; NMI
000002r 1  rr rr        .word   CartReset               ; RESET — the cartridge entry point
000004r 1  rr rr        .word   IrqTrampoline           ; IRQ
000004r 1               
