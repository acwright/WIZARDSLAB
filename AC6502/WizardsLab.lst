000000r 1               .setcpu "65C02"
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Wizards Lab — AC6502
000000r 1               ; =============================================================================
000000r 1               ;   A 16 K cartridge for the A.C. Wright 6502, running the TMS9918 in
000000r 1               ;   Graphics Mode I: 32 x 24 cells of 8 x 8 pixels, 256 patterns, and colour
000000r 1               ;   assigned one foreground/background pair per group of eight patterns.
000000r 1               ;
000000r 1               ;   That colour model is the strictest of the three targets, so it is the one
000000r 1               ;   the whole tileset is laid out against — each potion colour owns one group,
000000r 1               ;   and every glyph of that colour lives inside it. See SPEC.md section 4.
000000r 1               ;
000000r 1               ;   This file is the platform half of the contract in src/hal.inc. Everything
000000r 1               ;   it includes from src/ is shared, byte for byte, with the VIC-20 and C64.
000000r 1               ;
000000r 1               ;   Built with AC6502-16K.cfg.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               .include "../include/ac6502.inc"
000000r 2               ; =============================================================================
000000r 2               ;   6502.inc — External include file for the 6502 system
000000r 2               ; =============================================================================
000000r 2               ;
000000r 2               ;   CPU:       WDC 65C02S
000000r 2               ;   BIOS:      v1.5
000000r 2               ;   Assembler: ca65 (cc65 toolchain) — uses := for absolute symbols
000000r 2               ;
000000r 2               ;   Include this file in external projects to access Kernal routines,
000000r 2               ;   IO hardware registers, system variables, and useful constants.
000000r 2               ;
000000r 2               ;   MEMORY MAP
000000r 2               ;   ----------
000000r 2               ;   $0000-$0003   Zero Page: System pointers (see below)
000000r 2               ;   $0004-$0023   Zero Page: Reserved by BASIC interpreter
000000r 2               ;   $0024-$0039   Zero Page: System scratch (CF, serial, delay, monitor, XModem)
000000r 2               ;   $003A-$00FF   Zero Page: Free for user programs
000000r 2               ;   $0100-$01FF   CPU Stack
000000r 2               ;   $0200-$02FF   Input Buffer (ring buffer, managed by Kernal)
000000r 2               ;   $0300-$03FF   Kernal Variables (vectors, cursor, HW flags, etc.)
000000r 2               ;   $0400-$05FF   User Variables / BASIC workspace
000000r 2               ;   $0600-$07FF   FS sector buffer (clobbered by any FS/St routine call)
000000r 2               ;   $0800-$7FFF   Program RAM (30 KB — load address for user code)
000000r 2               ;   $8000-$83FF   IO 1: Banked RAM Low  (256 × ~1 KB banks)
000000r 2               ;   $8400-$87FF   IO 2: Banked RAM High (256 × ~1 KB banks)
000000r 2               ;   $8800-$881F   IO 3: RTC (DS1511Y)
000000r 2               ;   $8C00-$8C07   IO 4: Storage (CompactFlash, 8-bit IDE)
000000r 2               ;   $9000-$9003   IO 5: Serial (R65C51 ACIA)
000000r 2               ;   $9400-$940F   IO 6: GPIO (65C22 VIA — keyboard & joysticks)
000000r 2               ;   $9800-$981C   IO 7: Sound (SID / ARMSID)
000000r 2               ;   $9C00-$9C01   IO 8: Video (TMS9918 / pico9918)
000000r 2               ;   $A000-$A0FF   Kernal Jump Table (stable entry points)
000000r 2               ;   $A100-$B7FF   Kernal Implementation
000000r 2               ;   $B800-$BFFF   Character Set ROM (2 KB, 256 × 8-byte patterns)
000000r 2               ;   $C000-$EDFF   BASIC Interpreter
000000r 2               ;   $EE00-$FEFF   Machine Code Monitor
000000r 2               ;   $FF00-$FFF9   Wozmon (mini monitor)
000000r 2               ;   $FFFA-$FFFF   CPU Vectors (NMI, RESET, IRQ)
000000r 2               ;
000000r 2               ;   BOOT SEQUENCE
000000r 2               ;   -------------
000000r 2               ;   On RESET the BIOS probes all eight IO slots, initializes detected
000000r 2               ;   hardware, and auto-selects video or serial console.  If neither is
000000r 2               ;   found, IO_MODE is left unchanged (no halt — cartridges with their
000000r 2               ;   own display hardware can still boot).  A startup beep plays (if SID
000000r 2               ;   is present) for audible feedback, then BOOT_VECTOR ($035B) is
000000r 2               ;   checked — if non-zero, execution jumps there (cartridge takeover).
000000r 2               ;   Otherwise a console check halts if no video/serial is found, then
000000r 2               ;   the splash screen and boot menu are displayed.  ENTER launches
000000r 2               ;   BASIC; ESC enters the Monitor.  A 5-second timeout auto-boots BASIC.
000000r 2               ;   The splash is drawn on whichever console is active — centred on the
000000r 2               ;   40-column screen, or left-aligned as plain text over serial.
000000r 2               ;
000000r 2               ;   GRACEFUL DEGRADATION
000000r 2               ;   --------------------
000000r 2               ;   Every Kernal routine that drives a card checks HW_PRESENT first, so
000000r 2               ;   a call on a machine without that card is safe rather than a crash.
000000r 2               ;   Routines with nothing to report back return silently (video and SID);
000000r 2               ;   routines that move data report failure in the carry (CompactFlash).
000000r 2               ;   The per-routine notes below say which behaviour each one has.
000000r 2               ;
000000r 2               ;   CARTRIDGE SUPPORT
000000r 2               ;   -----------------
000000r 2               ;   Cartridges overlay $C000-$FFFF (BASIC, Monitor, Wozmon, vectors).
000000r 2               ;   The Kernal ($A000-$B7FF) and character set ($B800-$BFFF) remain
000000r 2               ;   accessible.  Use KernalInit ($A078) to initialize all hardware and
000000r 2               ;   return via RTS — interrupts are left disabled so the cart can set
000000r 2               ;   up its own handlers first.  See usage patterns in the BIOS README.
000000r 2               ;
000000r 2               ;   IO_MODE
000000r 2               ;   -------
000000r 2               ;   Bit 0 of IO_MODE selects the console output device:
000000r 2               ;     0 = Video (TMS9918)    1 = Serial (R65C51)
000000r 2               ;   Chrout ($A000) dispatches automatically based on IO_MODE.
000000r 2               ;   Use SetIOMode / GetIOMode to change or query the active console.
000000r 2               ;
000000r 2               ;   CALLING CONVENTION
000000r 2               ;   ------------------
000000r 2               ;   Kernal routines are called via JSR to the jump table addresses below.
000000r 2               ;   Parameters are passed in A, X, Y, and/or zero-page pointers as
000000r 2               ;   documented per routine.  Carry flag is used for success/error returns
000000r 2               ;   (C=0 success, C=1 error) where noted.
000000r 2               ;
000000r 2               ;   HW_PRESENT BITMASK
000000r 2               ;   -------------------
000000r 2               ;   After boot, HW_PRESENT ($030D) contains a bitmask of detected hardware.
000000r 2               ;   Test individual bits before calling hardware-specific routines.
000000r 2               ;   Example:
000000r 2               ;     lda HW_PRESENT
000000r 2               ;     and #HW_VID          ; Is video card present?
000000r 2               ;     beq @NoVideo         ; Skip if not
000000r 2               ;
000000r 2               ; =============================================================================
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 1: ZERO PAGE POINTERS
000000r 2               ; =============================================================================
000000r 2               ; These zero page locations are used by the Kernal.  External programs may
000000r 2               ; use STR_PTR and CF_BUF_PTR/CF_LBA as parameters to Kernal calls.
000000r 2               ; Locations $3A-$FF are free for user programs.
000000r 2               
000000r 2               STR_PTR             := $02               ; 2 bytes — String pointer (used by FsLoadFile, FsSaveFile, FsDeleteFile, etc.)
000000r 2               CF_BUF_PTR          := $24               ; 2 bytes — CF sector data buffer pointer
000000r 2               CF_LBA              := $26               ; 4 bytes — CF 28-bit LBA address (little-endian)
000000r 2               XFER_PTR            := $2A               ; 2 bytes — XModem transfer data pointer (source for XModemSave, dest for XModemLoad)
000000r 2               
000000r 2               ; Safe zero page range for user programs:
000000r 2               ; $3A-$FF (198 bytes free)
000000r 2               ; Note: $2E-$35 belong to the Monitor and $36-$39 to XModemLoad/XModemSave;
000000r 2               ;       neither range survives a call into those routines
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 2: SYSTEM VARIABLES ($0300-$03FF)
000000r 2               ; =============================================================================
000000r 2               
000000r 2               IRQ_PTR             := $0300             ; 2 bytes — IRQ handler vector (writable; default: internal Irq handler)
000000r 2               BRK_PTR             := $0302             ; 2 bytes — BRK handler vector (writable; default: enters Monitor)
000000r 2               NMI_PTR             := $0304             ; 2 bytes — NMI handler vector (writable; default: RTI)
000000r 2               
000000r 2               IO_MODE             := $0306             ; 1 byte  — Console output mode (bit 0: 0=video, 1=serial)
000000r 2               VID_CURSOR_X        := $0307             ; 1 byte  — Video cursor column (0-39)
000000r 2               VID_CURSOR_Y        := $0308             ; 1 byte  — Video cursor row (0-23)
000000r 2               
000000r 2               HW_PRESENT          := $030D             ; 1 byte  — Hardware present bitmask (set during boot probe)
000000r 2               CF_DISK             := $030F             ; 1 byte  — Current CF disk bank (0–255); base LBA = CF_DISK × FS_DISK_SECTORS; reset to 0 on boot
000000r 2               
000000r 2               ; HW_PRESENT bit definitions (bit order matches IO slot numbers):
000000r 2               HW_RAM_L            = %00000001          ; Bit 0: RAM card low  (IO 1, $8000-$83FF)
000000r 2               HW_RAM_H            = %00000010          ; Bit 1: RAM card high (IO 2, $8400-$87FF)
000000r 2               HW_RTC              = %00000100          ; Bit 2: RTC card      (IO 3, DS1511Y)
000000r 2               HW_CF               = %00001000          ; Bit 3: Storage card   (IO 4, CompactFlash)
000000r 2               HW_SC               = %00010000          ; Bit 4: Serial card    (IO 5, R65C51)
000000r 2               HW_GPIO             = %00100000          ; Bit 5: GPIO card      (IO 6, 65C22 VIA — keyboard/joysticks)
000000r 2               HW_SID              = %01000000          ; Bit 6: Sound card     (IO 7, SID/ARMSID)
000000r 2               HW_VID              = %10000000          ; Bit 7: Video card     (IO 8, TMS9918/pico9918)
000000r 2               
000000r 2               ; BRK register save area (populated by the BRK handler before entering Monitor):
000000r 2               BRK_P               := $0310             ; Saved processor status (P)
000000r 2               BRK_PCL             := $0311             ; Saved PC low byte (points to BRK instruction + 2)
000000r 2               BRK_PCH             := $0312             ; Saved PC high byte
000000r 2               BRK_A               := $0313             ; Saved accumulator
000000r 2               BRK_X               := $0314             ; Saved X register
000000r 2               BRK_Y               := $0315             ; Saved Y register
000000r 2               BRK_SP              := $0316             ; Saved stack pointer
000000r 2               
000000r 2               XFER_REMAIN         := $0317             ; 2 bytes — XModem byte count (output from XModemLoad; input to XModemSave)
000000r 2               XFER_IO_SAVE        := $0319             ; 1 byte  — Saved IO_MODE during XModem transfer (internal use)
000000r 2               
000000r 2               ; RTC scratch (used by RtcWriteDate to pass century):
000000r 2               RTC_BUF_CENT        := $030B             ; Century value for RtcReadDate / RtcWriteDate
000000r 2               
000000r 2               ; Cartridge / boot redirect vector:
000000r 2               BOOT_VECTOR         := $035B             ; 2 bytes — Boot redirect address (0=normal boot)
000000r 2                                                        ;   Set after KernalInit to redirect Reset flow
000000r 2                                                        ;   KernalInit zeroes this; write after init returns
000000r 2               FS_IO_ADDR          := $037F             ; 2 bytes — Load/save target address for FsLoadFileAddr / FsSaveFileAddr
000000r 2               FS_FILE_SIZE        := $034A             ; 2 bytes — File size in bytes (set by caller for FsSaveFileAddr; populated by FsLoadFileAddr)
000000r 2               
000000r 2               ; Program image handoff (v1.3):
000000r 2               PRG_IMAGE_END       := $038E             ; 2 bytes — End address of a program image placed at
000000r 2                                                        ;   PROGRAM_START by a loader running outside BASIC
000000r 2                                                        ;   (e.g. the Monitor's L command); 0 = none.
000000r 2                                                        ;   KernalInit zeroes it; BASIC consumes and re-zeroes it
000000r 2                                                        ;   on entry, so a stale value is never acted on twice.
000000r 2                                                        ;   A loader that drops a .prg at $0800 and then hands
000000r 2                                                        ;   off to BASIC should write the end address here so
000000r 2                                                        ;   the attached machine code survives LOAD/SAVE.
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 3: KEY MEMORY LOCATIONS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               INPUT_BUFFER        := $0200             ; $0200-$02FF — 256-byte ring buffer (keyboard/serial input)
000000r 2               PROGRAM_START       := $0800             ; User programs and BASIC programs load here
000000r 2               ;                                        ; Program space extends to $7FFF (30 KB)
000000r 2               MEMORY_TOP          := $8000             ; First address past usable RAM (IO space starts here)
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 4: KERNAL JUMP TABLE ($A000-$A0FF)
000000r 2               ; =============================================================================
000000r 2               ; All entry points are stable 3-byte JMP instructions.  Call via JSR.
000000r 2               ; Unimplemented slots return immediately (RTS).
000000r 2               
000000r 2               ; --- Character I/O ---
000000r 2               Chrout              := $A000             ; Output character (dispatched by IO_MODE)
000000r 2                                                        ;   In: A = character
000000r 2                                                        ;   Preserves: A, X, Y
000000r 2                                                        ;   Handles CR ($0D), LF ($0A), BS ($08), BEL ($07) in video mode
000000r 2               
000000r 2               Chrin               := $A003             ; Input character from buffer (non-blocking poll)
000000r 2                                                        ;   Out: A = character, C=1 if char available, C=0 if not
000000r 2                                                        ;   Caller must loop until C=1 for blocking behavior
000000r 2                                                        ;   Echoes character via Chrout
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               WriteBuffer         := $A006             ; Write byte to input ring buffer
000000r 2                                                        ;   In: A = byte to write
000000r 2                                                        ;   Modifies: X
000000r 2               
000000r 2               ReadBuffer          := $A009             ; Read byte from input ring buffer
000000r 2                                                        ;   Out: A = byte read
000000r 2                                                        ;   Modifies: X, A
000000r 2               
000000r 2               BufferSize          := $A00C             ; Get number of unread bytes in input buffer
000000r 2                                                        ;   Out: A = count
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- IO Mode ---
000000r 2               SetIOMode           := $A00F             ; Set IO_MODE
000000r 2                                                        ;   In: A = mode (bit 0: 0=video, 1=serial)
000000r 2               
000000r 2               GetIOMode           := $A012             ; Get IO_MODE
000000r 2                                                        ;   Out: A = current IO_MODE
000000r 2               
000000r 2               ; --- Video (TMS9918 / pico9918) ---
000000r 2               InitVideo           := $A015             ; Initialize TMS9918 (text mode, 40×24)
000000r 2                                                        ;   Writes the 8 mode registers, then reloads the
000000r 2                                                        ;   character set into the pattern table (VRAM $0800)
000000r 2                                                        ;   A program that switched the VDP to a graphics mode
000000r 2                                                        ;   can fully restore text mode with this one call
000000r 2                                                        ;   STR_PTR is used internally but saved and restored
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoClear          := $A018             ; Clear screen (fill with spaces), reset cursor to (0,0)
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoPutChar        := $A01B             ; Write character at cursor position (no cursor advance)
000000r 2                                                        ;   In: A = character
000000r 2               
000000r 2               VideoSetCursor      := $A01E             ; Set cursor position
000000r 2                                                        ;   In: X = column (0-39), Y = row (0-23)
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               VideoGetCursor      := $A021             ; Get cursor position
000000r 2                                                        ;   Out: X = column (0-39), Y = row (0-23)
000000r 2               
000000r 2               VideoScroll         := $A024             ; Scroll screen up one line, clear bottom row
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoSetColor       := $A027             ; Set TMS9918 text color
000000r 2                                                        ;   In: A = color byte (high nibble = foreground, low nibble = background)
000000r 2                                                        ;   See TMS9918 Color Constants below
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               VideoChroutRaw      := $A02A             ; Output char to video with no control-code handling
000000r 2                                                        ;   In: A = character code (0-255)
000000r 2                                                        ;   Preserves: A, X, Y
000000r 2                                                        ;   Always renders glyph, never interprets CR/LF/BS/BEL
000000r 2               
000000r 2               ; --- Sound (SID / ARMSID) ---
000000r 2               InitSID             := $A02D             ; Initialize SID (clear all registers, volume=15)
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               Beep                := $A030             ; Play short beep tone (~475 Hz)
000000r 2                                                        ;   Skips silently if no SID detected
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               SidPlayNote         := $A033             ; Play note on a SID voice
000000r 2                                                        ;   In: A = voice (0-2), X = freq low, Y = freq high
000000r 2                                                        ;   Uses triangle waveform, ADSR: A=0 D=9 S=F R=8
000000r 2                                                        ;   Full sustain holds the note flat until gated off
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SidSilence          := $A036             ; Silence all 3 SID voices (gate off only)
000000r 2                                                        ;   Frequencies are left intact — the envelope release
000000r 2                                                        ;   rings the tone out.  Zeroing freq would freeze the
000000r 2                                                        ;   waveform and decay a DC offset (audible thump)
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SidSetVolume        := $A039             ; Set SID master volume
000000r 2                                                        ;   In: A = volume (0-15); only the low nibble is used
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- Filesystem (disk-banked, 16-file directory per disk) ---
000000r 2               ;   The CF card is divided into 256 disk banks of 1 MB each (FS_DISK_SECTORS
000000r 2               ;   sectors × 512 bytes).  CF_DISK ($030F) selects the active bank (reset to
000000r 2               ;   0 on boot).  Use FsSetDisk / FsGetDisk to change it at runtime.  Each
000000r 2               ;   bank has its own directory at the first sector, holding up to 16 entries
000000r 2               ;   (8.3 filenames, space-padded, case-insensitive).  All FS routines and
000000r 2               ;   StReadSector / StWriteSector operate on the selected bank automatically.
000000r 2               ;   Pass null-terminated "NAME.EXT" string via STR_PTR ($02-$03).
000000r 2               ;   Use FsLoadFileAddr / FsSaveFileAddr for load-to-address transfers.
000000r 2               ;   The extension is inert — nothing in the BIOS branches on it, so .PRG, .BAS
000000r 2               ;   and .FOO behave identically.  What a file means is decided by the routine
000000r 2               ;   that loads it, never by its name.
000000r 2               ;   All FS routines use $0600-$07FF as a 512-byte sector buffer.
000000r 2               
000000r 2               FsLoadFile          := $A03C             ; Load file from CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 not found or error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSaveFile          := $A03F             ; Save file to CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsDeleteFile        := $A042             ; Delete file from CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 not found or error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- Keyboard / GPIO ---
000000r 2               InitKB              := $A045             ; Initialize VIA for keyboard input
000000r 2                                                        ;   Configures Port A/B as inputs, enables CB1/CA1 IRQs
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- Joysticks ---
000000r 2               ;   Both ports are ACTIVE LOW — each line is pulled up through 1K and grounded
000000r 2               ;   by its switch — and both routines return the port read raw.  So a held
000000r 2               ;   button is a 0 bit and an untouched stick reads $FF:
000000r 2               ;
000000r 2               ;     Bit:  7   6   5   4   3   2   1   0
000000r 2               ;           R   L   D   U   Y   X   B   A
000000r 2               ;
000000r 2               ;   Test a direction with:  lda ... / and #%00010000 / beq @UpHeld
000000r 2               ;
000000r 2               ;   Neither routine checks HW_PRESENT — with no GPIO card fitted they read a
000000r 2               ;   floating bus and the value is meaningless.  Test HW_GPIO first if the card
000000r 2               ;   may be absent.  (BASIC's JOY() does this and reports $FF.)
000000r 2               ;
000000r 2               ;   Both routines release both encoders (KBDisable), read the port, then
000000r 2               ;   re-enable them (KBEnable).  The interrupt state is left alone.
000000r 2               
000000r 2               ReadJoystick1       := $A048             ; Read joystick 1 (VIA Port B)
000000r 2                                                        ;   Out: A = bitmask (active low, see above)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               ReadJoystick2       := $A04B             ; Read joystick 2 (VIA Port A)
000000r 2                                                        ;   Out: A = bitmask (active low, see above)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               ; --- Serial (R65C51) ---
000000r 2               InitSC              := $A04E             ; Initialize serial card (8-N-1, 19200 baud)
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SerialChrout        := $A051             ; Direct serial output (bypasses IO_MODE)
000000r 2                                                        ;   In: A = character
000000r 2                                                        ;   Blocks until TX register is empty
000000r 2               
000000r 2               ; --- Serial Transfer ---
000000r 2               XModemLoad          := $A054             ; Receive data via XModem into memory
000000r 2                                                        ;   Protocol: standard XModem (128-byte blocks, checksum)
000000r 2                                                        ;   In: XFER_PTR = destination address
000000r 2                                                        ;   Out: C=0 success, XFER_PTR advanced past last byte written
000000r 2                                                        ;        XFER_REMAIN = total bytes received
000000r 2                                                        ;        C=1 transfer failed (timeout or CAN received)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               XModemSave          := $A057             ; Send data via XModem from memory
000000r 2                                                        ;   Protocol: standard XModem (128-byte blocks, checksum)
000000r 2                                                        ;   In: XFER_PTR = source address, XFER_REMAIN = byte count
000000r 2                                                        ;   Out: C=0 success, C=1 transfer failed (timeout or CAN received)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- RTC (DS1511Y) ---
000000r 2               RtcReadTime         := $A05A             ; Read current time
000000r 2                                                        ;   Out: A = hours, X = minutes, Y = seconds (all binary)
000000r 2               
000000r 2               RtcReadDate         := $A05D             ; Read current date
000000r 2                                                        ;   Out: A = day, X = month, Y = year (all binary)
000000r 2                                                        ;   RTC_BUF_CENT ($030B) = century
000000r 2               
000000r 2               RtcWriteTime        := $A060             ; Set RTC time
000000r 2                                                        ;   In: A = hours, X = minutes, Y = seconds (all binary)
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               RtcWriteDate        := $A063             ; Set RTC date
000000r 2                                                        ;   In: A = day, X = month, Y = year (all binary)
000000r 2                                                        ;   RTC_BUF_CENT ($030B) must hold century
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               RtcReadNVRAM        := $A066             ; Read byte from DS1511Y NVRAM (256 bytes)
000000r 2                                                        ;   In: X = address ($00-$FF)
000000r 2                                                        ;   Out: A = data byte
000000r 2               
000000r 2               RtcWriteNVRAM       := $A069             ; Write byte to DS1511Y NVRAM
000000r 2                                                        ;   In: X = address ($00-$FF), A = data byte
000000r 2               
000000r 2               ; --- CompactFlash Storage ---
000000r 2               StReadSector        := $A06C             ; Read one 512-byte sector
000000r 2                                                        ;   In: CF_LBA ($26-$29) = LBA, CF_BUF_PTR ($24-$25) = dest
000000r 2                                                        ;   Out: C=0 success, C=1 error; CF_BUF_PTR advanced by 512
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               StWriteSector       := $A06F             ; Write one 512-byte sector
000000r 2                                                        ;   In: CF_LBA ($26-$29) = LBA, CF_BUF_PTR ($24-$25) = source
000000r 2                                                        ;   Out: C=0 success, C=1 error; CF_BUF_PTR advanced by 512
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               StWaitReady         := $A072             ; Wait for CF to become ready (BSY=0, RDY=1)
000000r 2                                                        ;   Out: C=0 ready, C=1 timeout/error
000000r 2                                                        ;   Returns C=1 at once if the boot probe found no CF
000000r 2                                                        ;   card, rather than spinning out the full timeout.
000000r 2                                                        ;   Every FS and sector routine passes through here, so
000000r 2                                                        ;   an empty slot fails fast throughout the stack
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- Timing ---
000000r 2               SysDelay            := $A075             ; Delay for specified centiseconds (10 ms units)
000000r 2                                                        ;   In: A = low byte, X = high byte (16-bit count)
000000r 2                                                        ;   Uses VIA T1 if available, else software loop
000000r 2                                                        ;   Modifies: A, X, Y (X/Y clobbered only in software-fallback path)
000000r 2               
000000r 2               ; --- System / Cartridge Support ---
000000r 2               KernalInit          := $A078             ; Initialize all hardware (vectors, probe & init all I/O)
000000r 2                                                        ;   Caller MUST reset the stack pointer before JSR:
000000r 2                                                        ;     ldx #$ff / txs / jsr KernalInit
000000r 2                                                        ;   Zeroes BOOT_VECTOR, PRG_IMAGE_END and CF_DISK;
000000r 2                                                        ;   sets HW_PRESENT, IO_MODE, IRQ/BRK/NMI ptrs
000000r 2                                                        ;   Does NOT reset the stack pointer
000000r 2                                                        ;   Does NOT enable interrupts (caller must CLI)
000000r 2                                                        ;   Does NOT play beep, display splash, or enter boot menu
000000r 2                                                        ;   Does NOT halt if no console is detected
000000r 2                                                        ;   Modifies: All registers, flags
000000r 2               
000000r 2               KernalVersion       := $A07B             ; Get BIOS version
000000r 2                                                        ;   Out: A = major version, X = minor version
000000r 2               
000000r 2               ; --- Disk-banking & addressed storage (v1.1) ---
000000r 2               ;   CF_DISK ($030F) selects the current disk bank (0–255).
000000r 2               ;   All FS routines, StReadSector, and StWriteSector address the selected
000000r 2               ;   bank automatically.  Bank changes survive until the next reset.
000000r 2               
000000r 2               FsLoadFileAddr      := $A07E             ; Load named file from current disk to FS_IO_ADDR
000000r 2                                                        ;   In: STR_PTR = null-terminated filename
000000r 2                                                        ;       FS_IO_ADDR ($037F) = destination address
000000r 2                                                        ;   Out: C=0 success, FS_FILE_SIZE = bytes loaded; C=1 error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSaveFileAddr      := $A081             ; Save FS_FILE_SIZE bytes from FS_IO_ADDR to a named file
000000r 2                                                        ;   In: STR_PTR = filename
000000r 2                                                        ;       FS_IO_ADDR ($037F) = source address
000000r 2                                                        ;       FS_FILE_SIZE ($034A) = byte count
000000r 2                                                        ;   Out: C=0 success, C=1 error (disk full or write error)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsFormatDisk        := $A084             ; Zero the current disk's directory (erases all 16 entries)
000000r 2                                                        ;   Out: C=0 success, C=1 write error
000000r 2                                                        ;   No confirmation prompt — caller is responsible
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSetDisk           := $A087             ; Select the current CF disk bank
000000r 2                                                        ;   In: A = disk number (0–255) → stored in CF_DISK ($030F)
000000r 2                                                        ;   Modifies: Flags
000000r 2               
000000r 2               FsGetDisk           := $A08A             ; Get the current CF disk bank
000000r 2                                                        ;   Out: A = CF_DISK value (0–255)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               FsPrintDisk         := $A08D             ; Print "DISK n" + CRLF via Chrout (decimal, no leading zeros)
000000r 2                                                        ;   Uses current CF_DISK
000000r 2                                                        ;   Modifies: Flags, A, X, Y
000000r 2               
000000r 2               ; --- General Output Utilities (console routed by IO_MODE via Chrout) ---
000000r 2               PrintStr            := $A090             ; Print a NUL-terminated string
000000r 2                                                        ;   In : A = string addr low, Y = string addr high
000000r 2                                                        ;   Modifies: Flags, A, Y, STR_PTR (X preserved)
000000r 2               PrintCRLF           := $A093             ; Print CR ($0D) then LF ($0A)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               PrintDecU16         := $A096             ; Print an unsigned 16-bit value as decimal
000000r 2                                                        ;   In : A = value low, X = value high (no leading zeros)
000000r 2                                                        ;   Modifies: Flags, A, X, Y, FS_FILE_SIZE, FS_DIR_IDX
000000r 2               
000000r 2               ; --- Keyboard Encoder Control (raw GPIO port access) ---
000000r 2               ;   Both keyboard encoders drive the VIA ports the joysticks share.  Disable
000000r 2               ;   them to read GPIO_PORTA/GPIO_PORTB directly, then re-enable them.  The
000000r 2               ;   ReadJoystick routines do this for you; call these only for custom reads.
000000r 2               KBDisable           := $A099             ; Release both encoders and wait for them to let go
000000r 2                                                        ;   Busy-waits ~200 us so the ports settle before reading
000000r 2                                                        ;   Safe to call while the caller owns the VIA timers
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               KBEnable            := $A09C             ; Re-enable both keyboard encoders
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 5: IO HARDWARE REGISTERS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Banked RAM Low (IO 1: $8000-$83FF) ---
000000r 2               ;   256 banks × ~1 KB each.  Write bank number to latch, then access data window.
000000r 2               RAM_DATA_L          := $8000             ; R/W data window ($8000-$83FE)
000000r 2               RAM_BANK_L          := $83FF             ; Write-only bank latch ($00-$FF)
000000r 2               
000000r 2               ; --- Banked RAM High (IO 2: $8400-$87FF) ---
000000r 2               RAM_DATA_H          := $8400             ; R/W data window ($8400-$87FE)
000000r 2               RAM_BANK_H          := $87FF             ; Write-only bank latch ($00-$FF)
000000r 2               
000000r 2               ; --- RTC (DS1511Y) (IO 3: $8800-$881F) ---
000000r 2               RTC_SEC             := $8800             ; Seconds      (BCD, 00-59)
000000r 2               RTC_MIN             := $8801             ; Minutes      (BCD, 00-59)
000000r 2               RTC_HR              := $8802             ; Hours        (BCD, 00-23, 24h mode)
000000r 2               RTC_DAY             := $8803             ; Day of week  (1-7)
000000r 2               RTC_DATE            := $8804             ; Day of month (BCD, 01-31)
000000r 2               RTC_MON             := $8805             ; Month        (BCD, 01-12)
000000r 2               RTC_YR              := $8806             ; Year         (BCD, 00-99)
000000r 2               RTC_CENT            := $8807             ; Century      (BCD, 00-39)
000000r 2               RTC_ALARM_SEC       := $8808             ; Alarm seconds
000000r 2               RTC_ALARM_MIN       := $8809             ; Alarm minutes
000000r 2               RTC_ALARM_HR        := $880A             ; Alarm hours
000000r 2               RTC_ALARM_DATE      := $880B             ; Alarm day of month
000000r 2               RTC_WD_L            := $880C             ; Watchdog low
000000r 2               RTC_WD_H            := $880D             ; Watchdog high
000000r 2               RTC_CTRL_A          := $880E             ; Control Register A
000000r 2               RTC_CTRL_B          := $880F             ; Control Register B
000000r 2               RTC_RAM_ADDR        := $8810             ; NVRAM address register
000000r 2               RTC_RAM_DATA        := $8813             ; NVRAM data register
000000r 2               ; Control Register B bits:
000000r 2               RTC_CTRL_B_TE       := %10000000         ; Transfer Enable — set to inhibit clock updates during write
000000r 2               ; Month register ($8805) — the upper 3 bits are oscillator/SQW control, not month data.
000000r 2               ; Always mask with RTC_MON_MASK when reading the month, and preserve these bits on write.
000000r 2               RTC_MON_MASK        := %00011111         ; Month value occupies the low 5 bits
000000r 2               RTC_MON_EOSC        := %10000000         ; Oscillator Start/Stop (0 = oscillator running)
000000r 2               RTC_MON_E32K        := %01000000         ; 32 kHz square-wave enable (1 = SQW output disabled)
000000r 2               RTC_MON_BB32        := %00100000         ; Battery-backup 32 kHz SQW enable (1 = enabled in backup)
000000r 2               
000000r 2               ; --- CompactFlash / Storage (IO 4: $8C00-$8C07) ---
000000r 2               ;   8-bit IDE (True IDE) mode.  The BIOS issues Set Features $01 at boot
000000r 2               ;   to enable 8-bit data transfers.
000000r 2               ST_DATA             := $8C00             ; R/W — Data register
000000r 2               ST_ERROR            := $8C01             ; Read — Error register
000000r 2               ST_FEATURE          := $8C01             ; Write — Feature register
000000r 2               ST_SECT_CNT         := $8C02             ; R/W — Sector count
000000r 2               ST_LBA_0            := $8C03             ; R/W — LBA bits 0-7
000000r 2               ST_LBA_1            := $8C04             ; R/W — LBA bits 8-15
000000r 2               ST_LBA_2            := $8C05             ; R/W — LBA bits 16-23
000000r 2               ST_LBA_3            := $8C06             ; R/W — LBA bits 24-27 + drive/mode
000000r 2               ST_STATUS           := $8C07             ; Read — Status register
000000r 2               ST_CMD              := $8C07             ; Write — Command register
000000r 2               
000000r 2               ; CF Status Register bits:
000000r 2               ST_STATUS_ERR       := %00000001         ; Error occurred
000000r 2               ST_STATUS_IDX       := %00000010         ; Index mark
000000r 2               ST_STATUS_CORR      := %00000100         ; Corrected data
000000r 2               ST_STATUS_DRQ       := %00001000         ; Data request — ready for data transfer
000000r 2               ST_STATUS_DSC       := %00010000         ; Drive seek complete
000000r 2               ST_STATUS_DWF       := %00100000         ; Drive write fault
000000r 2               ST_STATUS_RDY       := %01000000         ; Drive ready
000000r 2               ST_STATUS_BSY       := %10000000         ; Drive busy — all other bits invalid while set
000000r 2               
000000r 2               ; CF Error Register bits:
000000r 2               ST_ERR_AMNF         := %00000001         ; Address mark not found
000000r 2               ST_ERR_ABRT         := %00000100         ; Command aborted
000000r 2               ST_ERR_IDNF         := %00010000         ; ID not found
000000r 2               ST_ERR_UNC          := %01000000         ; Uncorrectable data error
000000r 2               ST_ERR_BBK          := %10000000         ; Bad block detected
000000r 2               
000000r 2               ; ATA Command bytes:
000000r 2               ST_CMD_READ         := $20               ; Read Sectors
000000r 2               ST_CMD_WRITE        := $30               ; Write Sectors
000000r 2               ST_CMD_SET_FEAT     := $EF               ; Set Features
000000r 2               ST_FEAT_8BIT        := $01               ; Feature: Enable 8-bit data I/O
000000r 2               ST_LBA3_MASTER      := $E0               ; LBA mode, master drive (bits 7-5=111, bit 4=0)
000000r 2               
000000r 2               ; Filesystem constants:
000000r 2               FS_DIR_LBA          = 0                  ; Directory sector at LBA 0
000000r 2               FS_DATA_START       = 1                  ; Data sectors start at LBA 1
000000r 2               FS_MAX_FILES        = 16                 ; Maximum directory entries
000000r 2               FS_ENTRY_SIZE       = 32                 ; Bytes per directory entry
000000r 2               FS_ENTRY_FLAGS      = 11                 ; Offset: flags byte within entry
000000r 2               FS_ENTRY_START      = 12                 ; Offset: start sector (2 bytes, little-endian)
000000r 2               FS_ENTRY_FSIZE      = 14                 ; Offset: file size (2 bytes, little-endian)
000000r 2               FS_FLAG_USED        = %00000001          ; Flags bit 0: entry in use
000000r 2               FS_DISK_SECTORS     = 2048               ; Sectors per disk bank (2048 × 512 bytes = 1 MB); 256 banks = 256 MB total
000000r 2               
000000r 2               ; XModem protocol constants (used with XModemLoad / XModemSave):
000000r 2               XMODEM_SOH          = $01                ; Start of Header
000000r 2               XMODEM_EOT          = $04                ; End of Transmission
000000r 2               XMODEM_ACK          = $06                ; Acknowledge
000000r 2               XMODEM_NAK          = $15                ; Negative Acknowledge (receiver sends to initiate transfer)
000000r 2               XMODEM_CAN          = $18                ; Cancel
000000r 2               XMODEM_SUB          = $1A                ; Padding byte (fills unused bytes in last block)
000000r 2               XMODEM_BLKSZ        = 128                ; Data bytes per block
000000r 2               XMODEM_MAXRETRY     = 10                 ; Max retries per block during transfer
000000r 2               XMODEM_STARTRETRY   = 60                 ; Retries waiting for initial connect (~60s)
000000r 2               
000000r 2               ; --- Serial Card (R65C51 ACIA) (IO 5: $9000-$9003) ---
000000r 2               ;   Default config after InitSC: 8-N-1, 19200 baud, RX IRQ enabled
000000r 2               SC_DATA             := $9000             ; R/W — Data register
000000r 2               SC_RESET            := $9001             ; Write — Programmatic reset (write any value)
000000r 2               SC_STATUS           := $9001             ; Read — Status register
000000r 2               SC_CMD              := $9002             ; R/W — Command register
000000r 2               SC_CTRL             := $9003             ; R/W — Control register
000000r 2               
000000r 2               ; Serial Status Register bits:
000000r 2               SC_STATUS_IRQ       := %10000000         ; Interrupt occurred
000000r 2               SC_STATUS_DSR       := %01000000         ; Data Set Ready
000000r 2               SC_STATUS_DCD       := %00100000         ; Data Carrier Detect
000000r 2               SC_STATUS_TDRE      := %00010000         ; TX Data Register Empty (ready to send)
000000r 2               SC_STATUS_RDRF      := %00001000         ; RX Data Register Full (byte available)
000000r 2               SC_STATUS_OVR       := %00000100         ; Overrun error
000000r 2               SC_STATUS_FRME      := %00000010         ; Framing error
000000r 2               SC_STATUS_PARE      := %00000001         ; Parity error
000000r 2               
000000r 2               ; --- GPIO / Input Board (65C22 VIA) (IO 6: $9400-$940F) ---
000000r 2               ;   Port B = matrix keyboard / joystick 1
000000r 2               ;   Port A = PS/2 keyboard / joystick 2
000000r 2               ;   CB1/CA1 IRQs fire when a key scancode is ready
000000r 2               GPIO_PORTB          := $9400             ; Port B data (active keyboard/joystick 1 data)
000000r 2               GPIO_PORTA          := $9401             ; Port A data (active keyboard/joystick 2 data)
000000r 2               GPIO_DDRB           := $9402             ; Port B data direction (0=input, 1=output per bit)
000000r 2               GPIO_DDRA           := $9403             ; Port A data direction
000000r 2               GPIO_T1CL           := $9404             ; Timer 1 counter low (read=counter, write=latch)
000000r 2               GPIO_T1CH           := $9405             ; Timer 1 counter high (write starts timer)
000000r 2               GPIO_T1LL           := $9406             ; Timer 1 latch low
000000r 2               GPIO_T1LH           := $9407             ; Timer 1 latch high
000000r 2               GPIO_T2CL           := $9408             ; Timer 2 counter low
000000r 2               GPIO_T2CH           := $9409             ; Timer 2 counter high
000000r 2               GPIO_SR             := $940A             ; Shift register
000000r 2               GPIO_ACR            := $940B             ; Auxiliary control register
000000r 2               GPIO_PCR            := $940C             ; Peripheral control register
000000r 2               GPIO_IFR            := $940D             ; Interrupt flag register
000000r 2               GPIO_IER            := $940E             ; Interrupt enable register
000000r 2               GPIO_ORA            := $940F             ; Port A (no handshake)
000000r 2               
000000r 2               ; VIA Peripheral Control Register (PCR) mode bits:
000000r 2               GPIO_PCR_CB2_LO     := %11000000         ; CB2 = manual output low  (enable matrix keyboard encoder)
000000r 2               GPIO_PCR_CB2_HI     := %11100000         ; CB2 = manual output high (disable matrix keyboard encoder)
000000r 2               GPIO_PCR_CB1_NEG    := %00000000         ; CB1 = active on falling edge
000000r 2               GPIO_PCR_CA2_LO     := %00001100         ; CA2 = manual output low  (enable PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA2_HI     := %00001110         ; CA2 = manual output high (disable PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA1_NEG    := %00000000         ; CA1 = active on falling edge
000000r 2               
000000r 2               ; VIA Interrupt flag/enable bits:
000000r 2               GPIO_INT_CB1        := %00010000         ; Bit 4: CB1 interrupt (matrix keyboard data ready)
000000r 2               GPIO_INT_CA1        := %00000010         ; Bit 1: CA1 interrupt (PS/2 keyboard data ready)
000000r 2               GPIO_IER_SET        := %10000000         ; IER bit 7: 1=set named bits, 0=clear named bits
000000r 2               
000000r 2               ; --- Sound Card (SID / ARMSID) (IO 7: $9800-$981C) ---
000000r 2               ;   MOS 6581/8580 compatible.  3 voices, each with independent frequency,
000000r 2               ;   pulse width, waveform, and ADSR envelope.  Global filter and volume.
000000r 2               
000000r 2               ; Voice 1:
000000r 2               SID_V1_FREQ_LO      := $9800             ; Frequency low byte
000000r 2               SID_V1_FREQ_HI      := $9801             ; Frequency high byte
000000r 2               SID_V1_PW_LO        := $9802             ; Pulse width low byte (bits 0-7)
000000r 2               SID_V1_PW_HI        := $9803             ; Pulse width high nibble (bits 0-3)
000000r 2               SID_V1_CTRL         := $9804             ; Control register (waveform + gate)
000000r 2               SID_V1_AD           := $9805             ; Attack (high nibble) / Decay (low nibble)
000000r 2               SID_V1_SR           := $9806             ; Sustain (high nibble) / Release (low nibble)
000000r 2               
000000r 2               ; Voice 2:
000000r 2               SID_V2_FREQ_LO      := $9807
000000r 2               SID_V2_FREQ_HI      := $9808
000000r 2               SID_V2_PW_LO        := $9809
000000r 2               SID_V2_PW_HI        := $980A
000000r 2               SID_V2_CTRL         := $980B
000000r 2               SID_V2_AD           := $980C
000000r 2               SID_V2_SR           := $980D
000000r 2               
000000r 2               ; Voice 3:
000000r 2               SID_V3_FREQ_LO      := $980E
000000r 2               SID_V3_FREQ_HI      := $980F
000000r 2               SID_V3_PW_LO        := $9810
000000r 2               SID_V3_PW_HI        := $9811
000000r 2               SID_V3_CTRL         := $9812
000000r 2               SID_V3_AD           := $9813
000000r 2               SID_V3_SR           := $9814
000000r 2               
000000r 2               ; Global SID registers:
000000r 2               SID_FC_LO           := $9815             ; Filter cutoff low (bits 0-2)
000000r 2               SID_FC_HI           := $9816             ; Filter cutoff high (bits 0-7)
000000r 2               SID_RES_FILT        := $9817             ; Resonance (high nibble) / Filter enable per voice (bits 0-2)
000000r 2               SID_MODE_VOL        := $9818             ; Filter mode (high nibble) / Master volume (low nibble, 0-15)
000000r 2               SID_PADDLE_X        := $9819             ; Paddle X (read-only)
000000r 2               SID_PADDLE_Y        := $981A             ; Paddle Y (read-only)
000000r 2               SID_OSC3            := $981B             ; Oscillator 3 output (read-only)
000000r 2               SID_ENV3            := $981C             ; Envelope 3 output (read-only)
000000r 2               
000000r 2               ; SID Voice Control Register bits (apply to SID_Vn_CTRL):
000000r 2               SID_CTRL_GATE       := %00000001         ; Gate: 1=start attack, 0=start release
000000r 2               SID_CTRL_SYNC       := %00000010         ; Hard sync with preceding voice
000000r 2               SID_CTRL_RING       := %00000100         ; Ring modulation with preceding voice
000000r 2               SID_CTRL_TEST       := %00001000         ; Test bit (resets oscillator)
000000r 2               SID_CTRL_TRIANGLE   := %00010000         ; Triangle waveform
000000r 2               SID_CTRL_SAWTOOTH   := %00100000         ; Sawtooth waveform
000000r 2               SID_CTRL_PULSE      := %01000000         ; Pulse waveform
000000r 2               SID_CTRL_NOISE      := %10000000         ; Noise waveform
000000r 2               
000000r 2               ; SID Filter Mode bits (high nibble of SID_MODE_VOL):
000000r 2               SID_FILT_LP         := %00010000         ; Low-pass filter
000000r 2               SID_FILT_BP         := %00100000         ; Band-pass filter
000000r 2               SID_FILT_HP         := %01000000         ; High-pass filter
000000r 2               SID_FILT_3OFF       := %10000000         ; Disconnect voice 3 from output
000000r 2               
000000r 2               ; --- SID Frequency Table (1 MHz clock, equal temperament) ---
000000r 2               ;   Freq register = round(Hz × 16777216 / 1000000)
000000r 2               ;   Covers octaves 2-7 (C2=65 Hz to B7=3951 Hz), all 12 chromatic notes.
000000r 2               ;   Sharps and flats are provided as aliases (e.g. SID_NOTE_CS4 = SID_NOTE_Db4).
000000r 2               ;   Use SidPlayNote: A=voice (0-2), X=freq low byte, Y=freq high byte.
000000r 2               ;   Example: ldx #<SID_NOTE_A4 / ldy #>SID_NOTE_A4
000000r 2               
000000r 2               ; Octave 2 (C2=65.41 Hz .. B2=123.47 Hz)
000000r 2               SID_NOTE_C2         = $0449              ; ~65 Hz
000000r 2               SID_NOTE_CS2        = $048B              ; ~69 Hz
000000r 2               SID_NOTE_Db2        = SID_NOTE_CS2
000000r 2               SID_NOTE_D2         = $04D0              ; ~73 Hz
000000r 2               SID_NOTE_DS2        = $0519              ; ~78 Hz
000000r 2               SID_NOTE_Eb2        = SID_NOTE_DS2
000000r 2               SID_NOTE_E2         = $0567              ; ~82 Hz
000000r 2               SID_NOTE_F2         = $05B9              ; ~87 Hz
000000r 2               SID_NOTE_FS2        = $0610              ; ~93 Hz
000000r 2               SID_NOTE_Gb2        = SID_NOTE_FS2
000000r 2               SID_NOTE_G2         = $066C              ; ~98 Hz
000000r 2               SID_NOTE_GS2        = $06CE              ; ~104 Hz
000000r 2               SID_NOTE_Ab2        = SID_NOTE_GS2
000000r 2               SID_NOTE_A2         = $0735              ; ~110 Hz
000000r 2               SID_NOTE_AS2        = $07A3              ; ~117 Hz
000000r 2               SID_NOTE_Bb2        = SID_NOTE_AS2
000000r 2               SID_NOTE_B2         = $0817              ; ~123 Hz
000000r 2               
000000r 2               ; Octave 3 (C3=130.81 Hz .. B3=246.94 Hz)
000000r 2               SID_NOTE_C3         = $0893              ; ~131 Hz
000000r 2               SID_NOTE_CS3        = $0915              ; ~139 Hz
000000r 2               SID_NOTE_Db3        = SID_NOTE_CS3
000000r 2               SID_NOTE_D3         = $099F              ; ~147 Hz
000000r 2               SID_NOTE_DS3        = $0A32              ; ~156 Hz
000000r 2               SID_NOTE_Eb3        = SID_NOTE_DS3
000000r 2               SID_NOTE_E3         = $0ACD              ; ~165 Hz
000000r 2               SID_NOTE_F3         = $0B72              ; ~175 Hz
000000r 2               SID_NOTE_FS3        = $0C20              ; ~185 Hz
000000r 2               SID_NOTE_Gb3        = SID_NOTE_FS3
000000r 2               SID_NOTE_G3         = $0CD8              ; ~196 Hz
000000r 2               SID_NOTE_GS3        = $0D9C              ; ~208 Hz
000000r 2               SID_NOTE_Ab3        = SID_NOTE_GS3
000000r 2               SID_NOTE_A3         = $0E6B              ; ~220 Hz
000000r 2               SID_NOTE_AS3        = $0F46              ; ~233 Hz
000000r 2               SID_NOTE_Bb3        = SID_NOTE_AS3
000000r 2               SID_NOTE_B3         = $102F              ; ~247 Hz
000000r 2               
000000r 2               ; Octave 4 (C4=261.63 Hz .. B4=493.88 Hz) — middle octave
000000r 2               SID_NOTE_C4         = $1125              ; ~262 Hz (Middle C)
000000r 2               SID_NOTE_CS4        = $122A              ; ~277 Hz
000000r 2               SID_NOTE_Db4        = SID_NOTE_CS4
000000r 2               SID_NOTE_D4         = $133F              ; ~294 Hz
000000r 2               SID_NOTE_DS4        = $1464              ; ~311 Hz
000000r 2               SID_NOTE_Eb4        = SID_NOTE_DS4
000000r 2               SID_NOTE_E4         = $159A              ; ~330 Hz
000000r 2               SID_NOTE_F4         = $16E3              ; ~349 Hz
000000r 2               SID_NOTE_FS4        = $183F              ; ~370 Hz
000000r 2               SID_NOTE_Gb4        = SID_NOTE_FS4
000000r 2               SID_NOTE_G4         = $19B1              ; ~392 Hz
000000r 2               SID_NOTE_GS4        = $1B38              ; ~415 Hz
000000r 2               SID_NOTE_Ab4        = SID_NOTE_GS4
000000r 2               SID_NOTE_A4         = $1CD6              ; ~440 Hz (Concert A)
000000r 2               SID_NOTE_AS4        = $1E8D              ; ~466 Hz
000000r 2               SID_NOTE_Bb4        = SID_NOTE_AS4
000000r 2               SID_NOTE_B4         = $205E              ; ~494 Hz
000000r 2               
000000r 2               ; Octave 5 (C5=523.25 Hz .. B5=987.77 Hz)
000000r 2               SID_NOTE_C5         = $224B              ; ~523 Hz
000000r 2               SID_NOTE_CS5        = $2455              ; ~554 Hz
000000r 2               SID_NOTE_Db5        = SID_NOTE_CS5
000000r 2               SID_NOTE_D5         = $267E              ; ~587 Hz
000000r 2               SID_NOTE_DS5        = $28C8              ; ~622 Hz
000000r 2               SID_NOTE_Eb5        = SID_NOTE_DS5
000000r 2               SID_NOTE_E5         = $2B34              ; ~659 Hz
000000r 2               SID_NOTE_F5         = $2DC6              ; ~698 Hz
000000r 2               SID_NOTE_FS5        = $307F              ; ~740 Hz
000000r 2               SID_NOTE_Gb5        = SID_NOTE_FS5
000000r 2               SID_NOTE_G5         = $3361              ; ~784 Hz
000000r 2               SID_NOTE_GS5        = $366F              ; ~831 Hz
000000r 2               SID_NOTE_Ab5        = SID_NOTE_GS5
000000r 2               SID_NOTE_A5         = $39AC              ; ~880 Hz
000000r 2               SID_NOTE_AS5        = $3D1A              ; ~932 Hz
000000r 2               SID_NOTE_Bb5        = SID_NOTE_AS5
000000r 2               SID_NOTE_B5         = $40BC              ; ~988 Hz
000000r 2               
000000r 2               ; Octave 6 (C6=1046.50 Hz .. B6=1975.53 Hz)
000000r 2               SID_NOTE_C6         = $4495              ; ~1047 Hz
000000r 2               SID_NOTE_CS6        = $48A9              ; ~1109 Hz
000000r 2               SID_NOTE_Db6        = SID_NOTE_CS6
000000r 2               SID_NOTE_D6         = $4CFC              ; ~1175 Hz
000000r 2               SID_NOTE_DS6        = $518F              ; ~1245 Hz
000000r 2               SID_NOTE_Eb6        = SID_NOTE_DS6
000000r 2               SID_NOTE_E6         = $5669              ; ~1319 Hz
000000r 2               SID_NOTE_F6         = $5B8C              ; ~1397 Hz
000000r 2               SID_NOTE_FS6        = $60FE              ; ~1480 Hz
000000r 2               SID_NOTE_Gb6        = SID_NOTE_FS6
000000r 2               SID_NOTE_G6         = $66C2              ; ~1568 Hz
000000r 2               SID_NOTE_GS6        = $6CDF              ; ~1661 Hz
000000r 2               SID_NOTE_Ab6        = SID_NOTE_GS6
000000r 2               SID_NOTE_A6         = $7358              ; ~1760 Hz
000000r 2               SID_NOTE_AS6        = $7A34              ; ~1865 Hz
000000r 2               SID_NOTE_Bb6        = SID_NOTE_AS6
000000r 2               SID_NOTE_B6         = $8178              ; ~1976 Hz
000000r 2               
000000r 2               ; Octave 7 (C7=2093.00 Hz .. A7=3520.00 Hz; B7 overflows 16-bit register)
000000r 2               SID_NOTE_C7         = $892B              ; ~2093 Hz
000000r 2               SID_NOTE_CS7        = $9153              ; ~2217 Hz
000000r 2               SID_NOTE_Db7        = SID_NOTE_CS7
000000r 2               SID_NOTE_D7         = $99F7              ; ~2349 Hz
000000r 2               SID_NOTE_DS7        = $A31F              ; ~2489 Hz
000000r 2               SID_NOTE_Eb7        = SID_NOTE_DS7
000000r 2               SID_NOTE_E7         = $ACD2              ; ~2637 Hz
000000r 2               SID_NOTE_F7         = $B719              ; ~2794 Hz
000000r 2               SID_NOTE_FS7        = $C1FC              ; ~2960 Hz
000000r 2               SID_NOTE_Gb7        = SID_NOTE_FS7
000000r 2               SID_NOTE_G7         = $CD85              ; ~3136 Hz
000000r 2               SID_NOTE_GS7        = $D9BD              ; ~3322 Hz
000000r 2               SID_NOTE_Ab7        = SID_NOTE_GS7
000000r 2               SID_NOTE_A7         = $E6B0              ; ~3520 Hz
000000r 2               SID_NOTE_AS7        = $F467              ; ~3729 Hz
000000r 2               SID_NOTE_Bb7        = SID_NOTE_AS7
000000r 2               ; Note: B7 (~3951 Hz = $102F0) exceeds the 16-bit SID register — not defined
000000r 2               
000000r 2               ; --- Video Card (TMS9918 / pico9918) (IO 8: $9C00-$9C01) ---
000000r 2               ;   Text mode: 40 columns × 24 rows.  Name table at VRAM $0000 (960 bytes).
000000r 2               ;   Pattern table at VRAM $0800 (2 KB, 256 × 8-byte character patterns).
000000r 2               ;   To write to a VRAM address: write low byte to VC_REG, then (high | $40) to VC_REG.
000000r 2               ;   To read from a VRAM address: write low byte to VC_REG, then high byte to VC_REG.
000000r 2               ;   Register writes: write data byte to VC_REG, then (reg# | $80) to VC_REG.
000000r 2               VC_DATA             := $9C00             ; R/W — VRAM data (auto-increments address)
000000r 2               VC_REG              := $9C01             ; Write — Address/register port
000000r 2               VC_STATUS           := $9C01             ; Read — Status register
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 6: USEFUL CONSTANTS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- BIOS Version ---
000000r 2               BIOS_VERSION_MAJOR  = 1
000000r 2               BIOS_VERSION_MINOR  = 5
000000r 2               
000000r 2               ; --- ASCII Control Characters ---
000000r 2               CHAR_BEL            = $07                ; Bell (Beep via SID)
000000r 2               CHAR_BS             = $08                ; Backspace (cursor left + erase in video mode)
000000r 2               CHAR_LF             = $0A                ; Line Feed (cursor down, scroll if at bottom)
000000r 2               CHAR_CR             = $0D                ; Carriage Return (cursor to column 0)
000000r 2               CHAR_ESC            = $1B                ; Escape
000000r 2               CHAR_SPACE          = $20                ; Space
000000r 2               
000000r 2               ; --- Video Dimensions ---
000000r 2               VID_COLS            = 40                 ; Screen width in columns
000000r 2               VID_ROWS            = 24                 ; Screen height in rows
000000r 2               VID_NAME_TABLE      = $0000              ; VRAM address of name table (40×24 = 960 bytes)
000000r 2               VID_PATTERN_TABLE   = $0800              ; VRAM address of pattern/character table (2048 bytes)
000000r 2               
000000r 2               ; --- TMS9918 Color Constants (for VideoSetColor) ---
000000r 2               ;   Pass as: (foreground << 4) | background
000000r 2               ;   Example: white on black = $F0, green on black = $20
000000r 2               TMS_TRANSPARENT     = $0
000000r 2               TMS_BLACK           = $1
000000r 2               TMS_MED_GREEN       = $2
000000r 2               TMS_LT_GREEN        = $3
000000r 2               TMS_DK_BLUE         = $4
000000r 2               TMS_LT_BLUE         = $5
000000r 2               TMS_DK_RED          = $6
000000r 2               TMS_CYAN            = $7
000000r 2               TMS_MED_RED         = $8
000000r 2               TMS_LT_RED          = $9
000000r 2               TMS_DK_YELLOW       = $A
000000r 2               TMS_LT_YELLOW       = $B
000000r 2               TMS_DK_GREEN        = $C
000000r 2               TMS_MAGENTA         = $D
000000r 2               TMS_GRAY            = $E
000000r 2               TMS_WHITE           = $F
000000r 2               
000000r 2               ; --- Monitor Entry Points ---
000000r 2               ;   The machine code monitor lives at $EE00 and is entered normally via BRK.
000000r 2               ;   These are useful if you want to jump there directly.
000000r 2               MONITOR_ENTRY       := $EE00             ; Cold entry (from boot menu or user code)
000000r 2               MONITOR_BRK_ENTRY   := $EE03             ; BRK entry (displays saved registers)
000000r 2               
000000r 1               
000000r 1               ; --- Platform constants (hal.inc) --------------------------------------------
000000r 1               SCR_COLS         = 32
000000r 1               SCR_ROWS         = 24
000000r 1               SCR_CELLS        = SCR_COLS * SCR_ROWS     ; 768
000000r 1               PANEL_X             = 5             ; (32 - 22) / 2 — exact centring
000000r 1               PANEL_Y             = 0
000000r 1               HAS_COLOR_RAM       = 0             ; Colour lives in the VDP colour table
000000r 1               
000000r 1               ; --- VRAM map (SPEC Appendix C.1) --------------------------------------------
000000r 1               VRAM_PATTERNS       = $0000         ; 2 K, 256 patterns x 8 bytes
000000r 1               VRAM_NAMES          = $1400         ; 768, the 32 x 24 name table
000000r 1               VRAM_SPRITES        = $1B00         ; Sprite attributes — disabled below
000000r 1               VRAM_COLORS         = $2000         ; 32, one byte per 8-pattern group
000000r 1               
000000r 1               .include "../src/constants.inc"
000000r 2               ; =============================================================================
000000r 2               ;   constants.inc — Wizards Lab, shared game constants
000000r 2               ; =============================================================================
000000r 2               ;   Everything here comes straight out of SPEC.md. If a number changes there,
000000r 2               ;   it changes here, and nowhere else. Nothing in this file is platform
000000r 2               ;   specific — see the per-platform WizardsLab.asm for PANEL_X / PANEL_Y and
000000r 2               ;   the hardware addresses.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Board (SPEC 3) ----------------------------------------------------------
000000r 2               BOARD_W             = 6         ; Playfield columns
000000r 2               BOARD_H             = 16        ; Playfield rows
000000r 2               BOARD_STRIDE        = 8         ; Bytes per row — two wasted, on purpose
000000r 2               BOARD_ROWS_ALLOC    = 20        ; 16 playfield + 2 floor sentinels + 2 reserved
000000r 2               BOARD_BYTES         = BOARD_ROWS_ALLOC * BOARD_STRIDE    ; 160
000000r 2               SPAWN_COL           = 2         ; 0-indexed, left of centre
000000r 2               MATCH_MIN           = 3         ; Run length that clears
000000r 2               
000000r 2               ; --- Tile encoding (SPEC 4) --------------------------------------------------
000000r 2               ;   tile = COLOR_BASE + (color << 3) + glyph
000000r 2               ;   The board byte IS the tile index. No translation on the way to the screen.
000000r 2               TILE_EMPTY          = $00
000000r 2               TILE_WALL           = $FF
000000r 2               COLOR_BASE          = $40
000000r 2               COLOR_MASK          = $F8       ; AND this and you have the colour key
000000r 2               GLYPH_MASK          = $07
000000r 2               WILD_BASE           = $70       ; Colour 6 — the prism
000000r 2               NUM_COLORS          = 6
000000r 2               
000000r 2               COLOR_RED           = 0
000000r 2               COLOR_YELLOW        = 1
000000r 2               COLOR_GREEN         = 2
000000r 2               COLOR_CYAN          = 3
000000r 2               COLOR_BLUE          = 4
000000r 2               COLOR_PURPLE        = 5
000000r 2               COLOR_WILD          = 6
000000r 2               
000000r 2               GLYPH_POTION        = 0
000000r 2               GLYPH_FIREBALL      = 1
000000r 2               GLYPH_BOLT          = 2
000000r 2               GLYPH_BOMB          = 3
000000r 2               GLYPH_STAR          = 4
000000r 2               GLYPH_GLOW          = 6         ; Match-flash frame. Potion colours only —
000000r 2                                               ;   WILD_BASE + GLYPH_GLOW is an arrow, not a
000000r 2                                               ;   glow, so the prism never takes this path.
000000r 2                                               ;   See PRISM_BLIP below and SPEC 4.4.
000000r 2               
000000r 2               ; --- Named tiles -------------------------------------------------------------
000000r 2               TILE_BLANK          = 0
000000r 2               TILE_BAR_H          = 1
000000r 2               TILE_BAR_V          = 2
000000r 2               TILE_COR_TL         = 3
000000r 2               TILE_COR_TR         = 4
000000r 2               TILE_COR_BL         = 5
000000r 2               TILE_COR_BR         = 6
000000r 2               TILE_WASH           = 7         ; PAUSE / dim wash, white
000000r 2               FONT_BASE           = 16        ; '0'..'9' then 'A'..'Z' then . x ! ~
000000r 2               FONT_DIGIT_0        = 16
000000r 2               FONT_LETTER_A       = 26
000000r 2               FONT_DOT            = 52        ; A CENTRED dot, not a baseline period — it is
000000r 2                                               ;   also frame 0 of the removal ring below
000000r 2               FONT_TIMES          = 53
000000r 2               FONT_BANG           = 54
000000r 2               FONT_TILDE          = 55        ; The banner ornament, ~~~LIKE THIS~~~
000000r 2               TEXT_END            = $FF       ; String terminator. Shares its value with
000000r 2                                               ;   TILE_WALL, which costs nothing: no string
000000r 2                                               ;   ever contains tile 255.
000000r 2               
000000r 2               ; The removal ring (SPEC 14). One animation, used for every removal there is:
000000r 2               ; the match shatter, the bomb blast, the star. It opens outward
000000r 2               ;
000000r 2               ;       FONT_DOT -> VFX_REMOVE1 -> VFX_REMOVE2 -> VFX_REMOVE3 -> empty
000000r 2               ;
000000r 2               ; and the prism's blip-out runs the same tiles closed inward (PRISM_BLIP).
000000r 2               VFX_REMOVE1         = 56
000000r 2               VFX_REMOVE2         = 57
000000r 2               VFX_REMOVE3         = 58
000000r 2               VFX_BEAM_H          = 59        ; The bolt's row
000000r 2               VFX_BEAM_V          = 60        ; The bolt's column
000000r 2               VFX_BEAM_CROSS      = 61        ; Drawn once, at the bolt's own cell
000000r 2               ARROW_UP            = 62        ; The title screen's controls (SPEC 13.1).
000000r 2               ARROW_DOWN          = 63        ;   Up and down live in group 7, left and
000000r 2               ARROW_LEFT          = 118       ;   right in group 14 — whichever white group
000000r 2               ARROW_RIGHT         = 119       ;   had a slot spare. Nothing indexes them.
000000r 2               
000000r 2               ; Group 14 is the prism's. Slots +0..+3 are its idle rotation and +4..+5 its
000000r 2               ; blip-out; there is no glow slot (SPEC A.3).
000000r 2               PRISM_SPIN          = WILD_BASE ; Four frames, WILD_BASE + 0..3
000000r 2               PRISM_SPIN_FRAMES   = 4
000000r 2               PRISM_BLIP          = WILD_BASE + 4     ; Two frames, then VFX_REMOVE2,
000000r 2                                                       ;   VFX_REMOVE1, FONT_DOT, empty
000000r 2               
000000r 2               ; Group 15 is the stone group: the petrified glyph set at the same offsets the
000000r 2               ; potions use, so a cell petrifies into its own shape —
000000r 2               ;
000000r 2               ;       petrified = PETRIFY_BASE + (tile & GLYPH_MASK)     for glyphs 0-4
000000r 2               ;
000000r 2               ; — and then the two tiles the margins are built from.
000000r 2               PETRIFY_BASE        = 120       ; +0 potion, +1 fireball, +2 bolt,
000000r 2                                               ;   +3 bomb, +4 star
000000r 2               TILE_RESERVED       = 125       ; Held for a sixth glyph, if one is ever added
000000r 2               TILE_SHELF          = 126       ; The shelf the panel stands on
000000r 2               TILE_BRICK          = 127       ; Brick — the margin fill
000000r 2               FRAME_DIM           = 8         ; Group 1 is group 0 byte for byte, one colour
000000r 2                                               ;   quieter, so frame_tile + FRAME_DIM is any
000000r 2                                               ;   frame piece's dim twin (SPEC A.3)
000000r 2               ART_BASE            = 128       ; Groups 16-31 — one hatch in sixteen colours,
000000r 2                                               ;   the title screen's magic field (SPEC 13.1)
000000r 2               ART_TILES           = 128
000000r 2               
000000r 2               ; --- Panel geometry (SPEC 12) ------------------------------------------------
000000r 2               ;   One 22 x 24 panel, rendered identically on all three machines. PANEL_Y is
000000r 2               ;   0 everywhere; only PANEL_X differs. The panel is vertically symmetric —
000000r 2               ;   backdrop row, band row, backdrop row, eighteen rows of frame, backdrop row,
000000r 2               ;   band row, backdrop row — which is why 24 is the height. The AC6502 is the
000000r 2               ;   exact fit; the VIC-20 clips panel row 23 off the bottom and the C64 has one
000000r 2               ;   spare screen row (24) below the panel. See SPEC 12.4.
000000r 2               PANEL_W             = 22
000000r 2               PANEL_H             = 24
000000r 2               
000000r 2               WELL_ORIGIN_X       = 1         ; Panel-relative: board (0,0) lives here
000000r 2               WELL_ORIGIN_Y       = 4
000000r 2               
000000r 2               SCORE_X             = 12        ; 7 digits, cols 12-18
000000r 2               SCORE_Y             = 5
000000r 2               HIGH_X              = 12        ; 7 digits, cols 12-18
000000r 2               HIGH_Y              = 10
000000r 2               HIGHLVL_X           = 15        ; Level the high score was set on, 2 digits;
000000r 2                                               ;   the 'L' at col 14 is in the static image
000000r 2               HIGHLVL_Y           = 11
000000r 2               LEVEL_X             = 18        ; Single column: tens above units
000000r 2               LEVEL_Y             = 17        ; Tens at LEVEL_Y, units at LEVEL_Y + 1
000000r 2               NEXT_X              = 11        ; Single tile column
000000r 2               NEXT_Y              = 16        ; Cells A, B, C at NEXT_Y, +1, +2
000000r 2               MSG_X               = 2         ; The band's OWNED cells. Panel columns 0-1 and
000000r 2               MSG_W               = 18        ;   20-21 of row 22 are shelf in the static
000000r 2               MSG_Y               = 22        ;   image and code never touches them; the
000000r 2                                               ;   banner still centres on the full PANEL_W,
000000r 2                                               ;   which lands in the same place for an
000000r 2                                               ;   even-length string (SPEC 12.2).
000000r 2               
000000r 2               MSG_CHAIN_LEN       = 14        ; `~~ CHAIN x0 ~~` (strings.inc)
000000r 2               MSG_CHAIN_DIGIT     = 10        ; Where the digit sits inside it
000000r 2               CHAIN_DIGIT_X       = (PANEL_W - MSG_CHAIN_LEN) / 2 + MSG_CHAIN_DIGIT
000000r 2                                               ; TextBanner centres on PANEL_W, so the one
000000r 2                                               ;   cell the chain banner overwrites afterwards
000000r 2                                               ;   is worked out here rather than counted off
000000r 2                                               ;   the screen
000000r 2               CHAIN_MAX_SHOWN     = 9         ; One digit. A chain past 9 says 9 rather than
000000r 2                                               ;   drawing a glyph that is not a numeral
000000r 2               
000000r 2               SCORE_DIGITS        = 7         ; Always all 7 drawn, zero padded
000000r 2               LEVEL_DIGITS        = 2         ; Always zero padded — level 5 draws "0" / "5"
000000r 2               
000000r 2               ; --- Piece and timing (SPEC 5.6, 11.3, 14) -----------------------------------
000000r 2               ;   Every duration in the game is a frame count, and most of them differ
000000r 2               ;   between NTSC and PAL so that wall-clock speed matches. Those live in
000000r 2               ;   tables.inc as two-entry tables indexed by Region, not here — a constant
000000r 2               ;   that is not one number is not a constant. The ones below are the same on
000000r 2               ;   both machines.
000000r 2               LOCK_RESET_MAX      = 4         ; Horizontal moves that may reset the lock
000000r 2                                               ;   delay, per piece. Rotation never resets it.
000000r 2               FALL_FRAMES         = 2         ; Frames a row while the pile falls into the
000000r 2                                               ;   holes a clear left (SPEC 14). The one
000000r 2                                               ;   duration in the game that is the same on
000000r 2                                               ;   both regions, because SPEC 14 says so: at
000000r 2                                               ;   two frames there is nothing to round.
000000r 2               
000000r 2               ; --- Animation (SPEC 14) -----------------------------------------------------
000000r 2               ;   A clear step animates in two windows, and everything SPEC 14 lists happens
000000r 2               ;   inside one of them. A window lasts as long as the LONGEST thing in it:
000000r 2               ;
000000r 2               ;     GLOW      the matched cells' glow glyph, the bolt's beams and the
000000r 2               ;               fireball's white flash. GlowFrames, or the longer FlashFrames
000000r 2               ;               when a fireball fired (tables.inc)
000000r 2               ;     SHATTER   the removal ring, and the prism's blip-out running alongside
000000r 2               ;               it. SHATTER_STEPS ring frames, or BLIP_STEPS when a marked
000000r 2               ;               prism is winking out with them
000000r 2               ;
000000r 2               ;   The two counts below are the SAME on both regions, for the reason
000000r 2               ;   FALL_FRAMES is: they are a tile count times VFX_FRAMES, and two frames a
000000r 2               ;   tile does not round to 1.67. SPEC 14 says so.
000000r 2               VFX_FRAMES          = 2         ; Frames each tile of a removal ring holds
000000r 2               SHATTER_STEPS       = 3         ; VFX_REMOVE1..3           — 6 frames
000000r 2               BLIP_STEPS          = 5         ; PRISM_BLIP, +1, VFX_REMOVE2, VFX_REMOVE1,
000000r 2                                               ;   FONT_DOT               — 10 frames
000000r 2               PRISM_SPIN_RATE     = 8         ; Frames per idle rotation frame (SPEC 14).
000000r 2                                               ;   The only tile on the board that moves when
000000r 2                                               ;   nothing is happening
000000r 2               PETRIFY_FRAMES      = 2         ; Frames per row of the game-over petrify
000000r 2                                               ;   (SPEC 13.4). Same number as FALL_FRAMES
000000r 2                                               ;   and not the same thing, so it is its own
000000r 2                                               ;   constant
000000r 2               TINT_NONE           = $01       ; TintColor when nothing is flashing white.
000000r 2                                               ;   Every real colour key has its low three
000000r 2                                               ;   bits clear, so $01 is a value no masked
000000r 2                                               ;   tile can equal — which is what lets the
000000r 2                                               ;   Commodores' HalPlotCell test the tint with
000000r 2                                               ;   one CMP and no separate "is anything
000000r 2                                               ;   flashing at all" branch (SPEC 4.6)
000000r 2               
000000r 2               ; --- The title screen (SPEC 13.1) --------------------------------------------
000000r 2               ;   Panel-relative, and every one of them is a measurement off the drawn
000000r 2               ;   screen rather than a choice: `make artwork` owns data/screen-title-*.bin
000000r 2               ;   and the numbers below have to agree with it. The magic field is the block
000000r 2               ;   of hatch tiles at rows 8-9 and the prompt is the ten cells that say
000000r 2               ;   PRESS FIRE, which is the one string code redraws over its own image.
000000r 2               FIELD_X             = 4         ; The magic field, 14 x 2 (SPEC 13.1)
000000r 2               FIELD_Y             = 8
000000r 2               FIELD_W             = 14
000000r 2               FIELD_CELLS         = FIELD_W * 2       ; 28, and one of them changes a frame
000000r 2               PROMPT_X            = 6         ; `PRESS FIRE`, blinked at SPEC 14's period
000000r 2               PROMPT_Y            = 11
000000r 2               PROMPT_LEN          = 10
000000r 2               
000000r 2               ; --- Game over (SPEC 13.4) ---------------------------------------------------
000000r 2               GAMEOVER_SECS       = 10        ; Seconds on the game-over screen before it
000000r 2                                               ;   returns to the title by itself. SECONDS,
000000r 2                                               ;   not frames: 600 does not fit in a byte and
000000r 2                                               ;   would not be the same wall clock on both
000000r 2                                               ;   regions if it did, so the timeout counts
000000r 2                                               ;   seconds and SecondFrames counts the frames
000000r 2                                               ;   of one (tables.inc)
000000r 2               
000000r 2               ; --- Levels (SPEC 10) --------------------------------------------------------
000000r 2               LEVEL_TILES         = 30        ; Tiles cleared per level
000000r 2               LEVEL_SPEED_CAP     = 16        ; Speed stops improving here
000000r 2               LEVEL_MAX_SHOWN     = 99
000000r 2               
000000r 2               ; --- Scoring (SPEC 9) --------------------------------------------------------
000000r 2               BONUS_FIREBALL      = $0500     ; BCD
000000r 2               BONUS_BOLT          = $0300
000000r 2               BONUS_BOMB          = $0300
000000r 2               BONUS_PRISM         = $0400
000000r 2               BONUS_LEVELUP       = $1000
000000r 2               STAR_SHIFT_CAP      = 3         ; Three doublings — x8
000000r 2               HIGH_FLASH_BLINKS   = 6         ; Half-blinks of the HIGH field when the score
000000r 2                                               ;   overtakes it (SPEC 9.8) — three dark, three
000000r 2                                               ;   lit, ending lit. At SPEC 14's 30-frame
000000r 2                                               ;   blink period that is about a second and a
000000r 2                                               ;   half, and play never stops for it.
000000r 2               SCORE_BYTES         = 4         ; 8 nibbles packed BCD; the top one stays 0,
000000r 2                                               ;   so 7 digits show and the score wraps at
000000r 2                                               ;   10,000,000.
000000r 2               HIGH_INIT_LO        = $00       ; 0010000
000000r 2               HIGH_INIT_MID       = $00
000000r 2               HIGH_INIT_HI        = $01
000000r 2               HIGH_INIT_TOP       = $00
000000r 2               
000000r 2               ; --- Reagent probability, out of 256 (SPEC 5.3) ------------------------------
000000r 2               PSPECIAL_BANDS      = 5
000000r 2               
000000r 2               ; --- Input bitmask (SPEC 11.1) -----------------------------------------------
000000r 2               ;   Active HIGH. Each platform inverts and remaps its own hardware into this.
000000r 2               INPUT_UP            = %00000001 ; Rotate forward
000000r 2               INPUT_DOWN          = %00000010 ; Soft drop
000000r 2               INPUT_LEFT          = %00000100
000000r 2               INPUT_RIGHT         = %00001000
000000r 2               INPUT_FIRE          = %00010000 ; Rotate reverse / confirm
000000r 2               INPUT_PAUSE         = %00100000
000000r 2               INPUT_MASK          = %00111111 ; Everything the game reads. Bits 6-7 are free
000000r 2                                               ;   for a platform to use as scratch inside
000000r 2                                               ;   HalReadInput, as long as it strips them.
000000r 2               
000000r 2               ; --- Game states (SPEC 13) ---------------------------------------------------
000000r 2               STATE_TITLE         = 0
000000r 2               STATE_PLAY          = 1
000000r 2               STATE_PAUSE         = 2
000000r 2               STATE_GAMEOVER      = 3
000000r 2               
000000r 2               ; --- Play sub-states (SPEC 8) ------------------------------------------------
000000r 2               PLAY_FALLING        = 0
000000r 2               PLAY_LOCKING        = 1
000000r 2               PLAY_GLOW           = 2
000000r 2               PLAY_SHATTER        = 3
000000r 2               PLAY_GRAVITY        = 4
000000r 2               PLAY_ARE            = 5
000000r 2               
000000r 2               ; --- Buffer sizes (SPEC 17.1) ------------------------------------------------
000000r 2               MARKS_BYTES         = 16        ; One byte per row, bits 0-5
000000r 2               EFFECTQ_ENTRIES     = 48        ; ONE byte each — the board index of a pending
000000r 2               EFFECTQ_BYTES       = EFFECTQ_ENTRIES   ;   detonation, and nothing else.
000000r 2                                               ;   SPEC 8 budgeted two bytes for a packed
000000r 2                                               ;   glyph/row/column, which is a copy of what
000000r 2                                               ;   the board already holds: cells are not
000000r 2                                               ;   zeroed until step 6 and the queue is drained
000000r 2                                               ;   in step 4, so the tile is still there when
000000r 2                                               ;   the effect pops and its glyph and colour are
000000r 2                                               ;   one `lda Board,x` away. Half the RAM for
000000r 2                                               ;   nothing (SPEC 17.1).
000000r 2                                               ;   A ring keeps one slot free, so 47 pending
000000r 2                                               ;   detonations. On overflow an effect is
000000r 2                                               ;   dropped rather than growing the buffer (D6);
000000r 2                                               ;   at one reagent a piece it is not reachable.
000000r 2               DIRTY_ENTRIES       = 64        ; 3 bytes each: offset lo, offset hi, tile
000000r 2               DIRTY_BYTES         = DIRTY_ENTRIES * 3
000000r 2               DIRTY_FLUSH_MAX     = 24        ; Cells pushed to the screen per frame.
000000r 2                                               ;   MEASURED, not estimated (PLAN.md S1). A
000000r 2                                               ;   flush costs 165 cycles a cell on the
000000r 2                                               ;   AC6502 and about 132 on the Commodores, so
000000r 2                                               ;   24 cells is 3965 cycles — inside vertical
000000r 2                                               ;   blank on all three, and tightest on the
000000r 2                                               ;   AC6502 at 1 MHz, whose 70 blank lines are
000000r 2                                               ;   roughly 4450. It is also a quarter of the
000000r 2                                               ;   96-cell well, so a full redraw is exactly
000000r 2                                               ;   four frames.
000000r 2                                               ;   Overrunning vblank is not dangerous on any
000000r 2                                               ;   of the three — no VRAM write spacing is
000000r 2                                               ;   anywhere near violated (S1) — it only
000000r 2                                               ;   risks a cell landing a frame late. This is
000000r 2                                               ;   a budget, not a hardware limit.
000000r 2               
000000r 1               .include "../src/zeropage.inc"
000000r 2               ; =============================================================================
000000r 2               ;   zeropage.inc — Wizards Lab, zero page allocation
000000r 2               ; =============================================================================
000000r 2               ;   The ZEROPAGE segment is placed at $40 on every platform. That window is
000000r 2               ;   free on all three:
000000r 2               ;
000000r 2               ;     AC6502   $003A-$00FF free for user programs (6502.inc memory map)
000000r 2               ;     VIC-20   all of page zero, once the cartridge stops calling the KERNAL
000000r 2               ;     C64      all of page zero EXCEPT $00/$01, which are the processor port
000000r 2               ;
000000r 2               ;   Starting at $40 clears the C64's port bytes and the AC6502's system
000000r 2               ;   scratch with room to spare, and keeps one number in three linker configs.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               .segment "ZEROPAGE"
000000r 2               
000000r 2  xx xx        Ptr1:           .res 2      ; General pointer — free across any call boundary
000002r 2  xx xx        Ptr2:           .res 2      ; General pointer
000004r 2  xx xx        SrcPtr:         .res 2      ; Block copy source
000006r 2  xx xx        DstPtr:         .res 2      ; Block copy destination
000008r 2  xx xx        ScreenPtr:      .res 2      ; Current screen row base
00000Ar 2  xx xx        ColorPtr:       .res 2      ; Current colour RAM row base (Commodore only)
00000Cr 2               
00000Cr 2  xx           RngLo:          .res 1      ; 16-bit LFSR state — never both zero
00000Dr 2  xx           RngHi:          .res 1
00000Er 2               
00000Er 2  xx           Tmp0:           .res 1      ; Scratch. Never live across a JSR.
00000Fr 2  xx           Tmp1:           .res 1
000010r 2  xx           Tmp2:           .res 1
000011r 2  xx           Tmp3:           .res 1
000012r 2               
000012r 2               ; --- The match scanner (SPEC 6.2) --------------------------------------------
000012r 2               ;   One line of one pass at a time. The cursor is a BOARD INDEX rather than a
000012r 2               ;   row and a column, because all four passes are the same walk with a
000012r 2               ;   different step: +1 horizontal, +8 vertical, +9 diagonal, +7 anti-diagonal.
000012r 2  xx           ScanIdx:        .res 1      ; Where the cursor was when a run ended: ScanLine
000013r 2                                           ;   keeps it in X and spills it only here
000013r 2  xx           ScanStep:       .res 1      ; What to add to reach the next cell of this line
000014r 2  xx           ScanColor:      .res 1      ; Colour key of the run in progress ($FF = unset)
000015r 2  xx           ScanLen:        .res 1      ; Cells in it so far, wildcards included
000016r 2  xx           ScanEnd:        .res 1      ; Walk-back cursor while a finished run is marked
000017r 2  xx           ScanTop:        .res 1      ; Row base of the top of the pile. Every pass
000018r 2                                           ;   starts there rather than at row 0, which is
000018r 2                                           ;   most of the cost of a scan (match.asm)
000018r 2               
000018r 2               ; --- Board walks that call the renderer (SPEC 8 steps 6 and 8) ---------------
000018r 2               ;   RenderCell clobbers A, X and Y, so a walk that marks what it changes
000018r 2               ;   cannot keep its cursor in a register. GravIdx also has to survive from one
000018r 2               ;   frame to the next: a row of falling is a cursor and not a bulk enqueue,
000018r 2               ;   because a full well is more cells than the dirty ring holds (D12,
000018r 2               ;   SPEC 12.6).
000018r 2  xx           GravIdx:        .res 1      ; Cell the fall is walking up from, $FF when the
000019r 2                                           ;   row is finished
000019r 2  xx           GravMoved:      .res 1      ; Non-zero if this row of falling moved anything
00001Ar 2  xx           CellCount:      .res 1      ; Cells CascadeRemove has taken off the board
00001Br 2               
00001Br 2               ; --- Reagent effects (SPEC 7.3, SPEC 8 step 4) -------------------------------
00001Br 2               ;   EffectHit marks a cell, scores it and enqueues whatever it holds, so it
00001Br 2               ;   clobbers A, X and Y — which means a walk that offers it cells cannot keep
00001Br 2               ;   its cursor in a register either. Same reason GravIdx exists, and the same
00001Br 2               ;   reason these are not Tmp0-Tmp3: those are dead across a JSR.
00001Br 2  xx           EffectIdx:      .res 1      ; The cell the walk in progress is on
00001Cr 2  xx           EffectEnd:      .res 1      ; Where it stops. The bolt's row end, or the bomb's
00001Dr 2                                           ;   last row
00001Dr 2  xx           EffectRow:      .res 1      ; First cell of the bomb's current row
00001Er 2  xx           EffectArg:      .res 1      ; What the walk is looking for: the fireball's
00001Fr 2                                           ;   colour key, or the bomb's last column
00001Fr 2               
00001Fr 2               ; --- Animation walks (SPEC 14) -----------------------------------------------
00001Fr 2               ;   The glow, the beams and the shatter all walk MARKS and mark what they find,
00001Fr 2               ;   so their cursors cannot live in registers either — RenderMark clobbers A
00001Fr 2               ;   and X. There are two of them because the beam pass NESTS: the outer walk is
00001Fr 2               ;   over the marked cells, looking for bolts, and the inner one is over the
00001Fr 2               ;   cross each bolt draws.
00001Fr 2  xx           AnimMode:       .res 1      ; Which of the four the walk is doing
000020r 2  xx           AnimIdx:        .res 1      ; Outer cursor — the marked cell being animated
000021r 2  xx           AnimCur:        .res 1      ; Inner cursor — the beam cell being drawn
000022r 2  xx           AnimEnd:        .res 1      ; Where the inner walk stops
000023r 2  xx           AnimArg:        .res 1      ; What it is drawing, or the bolt's own column
000024r 2               
000024r 2               ; --- Render and text scratch -------------------------------------------------
000024r 2               ;   These ARE live across a JSR, unlike Tmp0-Tmp3, because text.asm calls
000024r 2               ;   RenderMark once per cell and has to remember where it is. That is safe
000024r 2               ;   only because RenderMark touches nothing here: it clobbers A, X and the
000024r 2               ;   stack and nothing else (see render.asm). Do not call anything else from a
000024r 2               ;   loop that holds one of these.
000024r 2  xx           TextCol:        .res 1      ; Panel column the next glyph goes in
000025r 2  xx           TextRow:        .res 1      ; Panel row the string is drawn on
000026r 2  xx           TextIdx:        .res 1      ; Cursor within the string, or the BCD byte index
000027r 2  xx           TextByte:       .res 1      ; The BCD byte being split into two digits
000028r 2  xx           TextSkip:       .res 1      ; Non-zero while the first high nibble is skipped
000029r 2  xx           FlushLeft:      .res 1      ; Cells left in this frame's flush budget
00002Ar 2  xx           RedrawCol:      .res 1      ; Panel column of the cell being marked. Shared by
00002Br 2                                           ;   every routine that marks a run of cells in one
00002Br 2                                           ;   column, because RenderMark clobbers X.
00002Br 2               
00002Br 1               .include "../src/ram.inc"
00002Br 2               ; =============================================================================
00002Br 2               ;   ram.inc — Wizards Lab, work RAM
00002Br 2               ; =============================================================================
00002Br 2               ;   SPEC.md section 17.1. Around 530 bytes, which is what lets the whole game
00002Br 2               ;   fit the VIC-20's 1 KB of usable work RAM — the tightest of the three
00002Br 2               ;   targets, and therefore the one the layout is designed against.
00002Br 2               ;
00002Br 2               ;   Every platform places the BSS segment somewhere different (see each
00002Br 2               ;   linker config); nothing in this file cares where.
00002Br 2               ; =============================================================================
00002Br 2               
00002Br 2               .segment "BSS"
000000r 2               
000000r 2               ; --- The board (SPEC 3.2) ----------------------------------------------------
000000r 2               ;   20 rows x 8 stride. Columns 6-7 of every row and rows 16-19 entirely are
000000r 2               ;   permanent $FF sentinels, so scans walk off the edge and stop by themselves.
000000r 2               ;   Page-align it: address(row,col) = Board + (row << 3) + col.
000000r 2               .align 256
000000r 2  xx xx xx xx  Board:          .res BOARD_BYTES
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
0000A0r 2               
0000A0r 2               ; --- Match / cascade state (SPEC 6.2, 8) -------------------------------------
0000A0r 2  xx xx xx xx  Marks:          .res MARKS_BYTES        ; One byte per row, bits 0-5 = columns
0000A4r 2  xx xx xx xx  
0000A8r 2  xx xx xx xx  
0000B0r 2  xx xx xx xx  EffectQ:        .res EFFECTQ_BYTES      ; Ring of pending reagent detonations —
0000B4r 2  xx xx xx xx  
0000B8r 2  xx xx xx xx  
0000E0r 2                                                       ;   the board INDEX of each, one byte,
0000E0r 2                                                       ;   because the tile is still on the
0000E0r 2                                                       ;   board when the entry pops
0000E0r 2                                                       ;   (constants.inc, SPEC 8)
0000E0r 2  xx           EffectQHead:    .res 1
0000E1r 2  xx           EffectQTail:    .res 1
0000E2r 2  xx           RunCount:       .res 1                  ; Runs resolved in the current step
0000E3r 2  xx           ChainStep:      .res 1                  ; 1 on the first step of a cascade
0000E4r 2  xx           StarCount:      .res 1                  ; Doublings pending, capped at 3
0000E5r 2  xx           CascadeLo:      .res 1                  ; Cascade point accumulator, packed BCD
0000E6r 2  xx           CascadeMid:     .res 1
0000E7r 2  xx           CascadeHi:      .res 1
0000E8r 2               
0000E8r 2               ; --- Animation (SPEC 14) -----------------------------------------------------
0000E8r 2  xx           AnimStep:       .res 1                  ; Ring frame the shatter is showing,
0000E9r 2                                                       ;   0 .. AnimSteps - 1
0000E9r 2  xx           AnimSteps:      .res 1                  ; SHATTER_STEPS, or BLIP_STEPS when a
0000EAr 2                                                       ;   marked prism is blipping out along
0000EAr 2                                                       ;   with the rest (constants.inc)
0000EAr 2  xx           TintColor:      .res 1                  ; Colour key currently drawn WHITE — the
0000EBr 2                                                       ;   fireball flash (SPEC 4.6) — or
0000EBr 2                                                       ;   TINT_NONE. Read by HalPlotCell on
0000EBr 2                                                       ;   the Commodores and written to the
0000EBr 2                                                       ;   VDP colour table on the AC6502;
0000EBr 2                                                       ;   HalColorFlash is the only thing that
0000EBr 2                                                       ;   sets it (hal.inc)
0000EBr 2  xx           PrismFrame:     .res 1                  ; Idle rotation frame, 0-3
0000ECr 2  xx           PrismTimer:     .res 1                  ; Frames until the next one
0000EDr 2  xx           PetrifyRow:     .res 1                  ; Board row the game-over petrify is
0000EEr 2                                                       ;   working up from, $FF when it is done
0000EEr 2  xx           TitleTimer:     .res 1                  ; Frames until the title prompt's next
0000EFr 2                                                       ;   half-blink (SPEC 13.1, 14)
0000EFr 2  xx           TitlePhase:     .res 1                  ; 0 while it is lit, 1 while it is dark
0000F0r 2               
0000F0r 2               ; --- Render (SPEC 12.6) ------------------------------------------------------
0000F0r 2               ;   A ring of DIRTY_ENTRIES cells waiting to be pushed to the screen, three
0000F0r 2               ;   bytes each: SCREEN column, SCREEN row, tile. Not a 16-bit screen offset —
0000F0r 2               ;   HalPlotCell takes a column and a row (hal.inc), and every platform reaches
0000F0r 2               ;   a cell through a per-row pointer table (SPEC 12.3), so an offset would only
0000F0r 2               ;   have to be taken apart again at the far end.
0000F0r 2               ;
0000F0r 2               ;   A ring rather than a list with a resume index, because a frame that flushes
0000F0r 2               ;   its cap leaves a remainder and the next frame's marks have to go somewhere.
0000F0r 2               ;   Head and tail are BYTE offsets into Dirty, not entry numbers, so stepping
0000F0r 2               ;   one entry is an add of 3 and never a multiply.
0000F0r 2  xx xx xx xx  Dirty:          .res DIRTY_BYTES        ; screen col, screen row, tile
0000F4r 2  xx xx xx xx  
0000F8r 2  xx xx xx xx  
0001B0r 2  xx           DirtyCount:     .res 1                  ; Entries pending, 0..DIRTY_ENTRIES
0001B1r 2  xx           DirtyHead:      .res 1                  ; Byte offset of the oldest pending
0001B2r 2  xx           DirtyTail:      .res 1                  ; Byte offset the next mark goes to
0001B3r 2  xx           RedrawIdx:      .res 1                  ; Board index RenderBoardStep resumes
0001B4r 2                                                       ;   at, or $FF when no redraw is
0001B4r 2                                                       ;   outstanding
0001B4r 2  xx           RedrawWash:     .res 1                  ; TILE_WASH while the cursor above is
0001B5r 2                                                       ;   painting the PAUSE wash rather than
0001B5r 2                                                       ;   the board, zero otherwise. Both are
0001B5r 2                                                       ;   96 cells against a 64-entry ring, so
0001B5r 2                                                       ;   both have to be a cursor (D12) and
0001B5r 2                                                       ;   one byte is cheaper than a second
0001B5r 2                                                       ;   one (SPEC 13.3)
0001B5r 2               
0001B5r 2               ; --- The falling piece (SPEC 5) ----------------------------------------------
0001B5r 2  xx           PieceCol:       .res 1
0001B6r 2  xx           PieceRow:       .res 1                  ; Row of cell A (the top cell)
0001B7r 2  xx           PieceA:         .res 1                  ; Tile bytes, top to bottom
0001B8r 2  xx           PieceB:         .res 1
0001B9r 2  xx           PieceC:         .res 1
0001BAr 2  xx           NextA:          .res 1                  ; The preview piece
0001BBr 2  xx           NextB:          .res 1
0001BCr 2  xx           NextC:          .res 1
0001BDr 2  xx           PieceDirty:     .res 1                  ; Non-zero when the three cells need
0001BEr 2                                                       ;   drawing. Not drawn on the spot,
0001BEr 2                                                       ;   because a full-board redraw may be
0001BEr 2                                                       ;   in flight and would paint over
0001BEr 2                                                       ;   them — see StatePlay (D14).
0001BEr 2               
0001BEr 2               ; --- Progress (SPEC 9, 10) ---------------------------------------------------
0001BEr 2  xx           ScoreLo:        .res 1                  ; 7 digits packed BCD, low byte first;
0001BFr 2  xx           ScoreMid:       .res 1                  ;   the top nibble of ScoreTop stays 0
0001C0r 2  xx           ScoreHi:        .res 1
0001C1r 2  xx           ScoreTop:       .res 1
0001C2r 2  xx           HighLo:         .res 1
0001C3r 2  xx           HighMid:        .res 1
0001C4r 2  xx           HighHi:         .res 1
0001C5r 2  xx           HighTop:        .res 1
0001C6r 2  xx           HighLevel:      .res 1                  ; Level the high score was set on, BCD
0001C7r 2  xx           HighOwned:      .res 1                  ; Non-zero once THIS game has taken the
0001C8r 2                                                       ;   high score. From the overtake on,
0001C8r 2                                                       ;   score and high score are equal and
0001C8r 2                                                       ;   every bank copies again, so without
0001C8r 2                                                       ;   this the one-shot fanfare and flash
0001C8r 2                                                       ;   would fire on every one (SPEC 9.8)
0001C8r 2  xx           HighFlash:      .res 1                  ; Half-blinks of the HIGH field left to
0001C9r 2                                                       ;   run. Odd = dark, even = lit, and it
0001C9r 2                                                       ;   ends at zero, so the field is always
0001C9r 2                                                       ;   left readable
0001C9r 2  xx           HighTimer:      .res 1                  ; Frames until the next half-blink
0001CAr 2  xx           Level:          .res 1                  ; Binary, 1-99
0001CBr 2  xx           TilesCleared:   .res 1                  ; Toward the next level, carries past 30
0001CCr 2               
0001CCr 2               ; --- Timers, all in frames (SPEC 14) -----------------------------------------
0001CCr 2  xx           GravityTimer:   .res 1
0001CDr 2  xx           LockTimer:      .res 1
0001CEr 2  xx           LockResets:     .res 1
0001CFr 2  xx           DasTimer:       .res 1
0001D0r 2  xx           DasDir:         .res 1
0001D1r 2  xx           AreTimer:       .res 1
0001D2r 2  xx           AnimTimer:      .res 1
0001D3r 2  xx           BannerTimer:    .res 1
0001D4r 2  xx           FrameCounter:   .res 1                  ; Free-running from power-on; seeds RNG
0001D5r 2               
0001D5r 2               ; --- Input (SPEC 11.1) -------------------------------------------------------
0001D5r 2  xx           InputNow:       .res 1
0001D6r 2  xx           InputPrev:      .res 1
0001D7r 2  xx           InputEdge:      .res 1                  ; Newly pressed this frame
0001D8r 2               
0001D8r 2               ; --- State machine (SPEC 13) -------------------------------------------------
0001D8r 2  xx           GameState:      .res 1                  ; STATE_*
0001D9r 2  xx           PlayState:      .res 1                  ; PLAY_*
0001DAr 2  xx           OverSecs:       .res 1                  ; Seconds left on the game-over screen,
0001DBr 2                                                       ;   and ZERO until the petrify has
0001DBr 2                                                       ;   finished and the banner is up. That
0001DBr 2                                                       ;   double duty is what makes the setup
0001DBr 2                                                       ;   a one-shot without a second flag:
0001DBr 2                                                       ;   the count never rests at zero,
0001DBr 2                                                       ;   because reaching it returns to the
0001DBr 2                                                       ;   title in the same frame (SPEC 13.4)
0001DBr 2  xx           OverTimer:      .res 1                  ; Frames until the next second of it
0001DCr 2  xx           Region:         .res 1                  ; 0 = NTSC, 1 = PAL
0001DDr 2  xx           NeedsRedraw:    .res 1
0001DEr 2               
0001DEr 2               ; --- Audio (SPEC 16) ---------------------------------------------------------
0001DEr 2  xx           SfxRequest:     .res 1                  ; Written by logic, consumed by AudioTick
0001DFr 2  xx           SfxTimer:       .res 1
0001E0r 2  xx xx xx xx  SfxState:       .res 14
0001E4r 2  xx xx xx xx  
0001E8r 2  xx xx xx xx  
0001EEr 2               
0001EEr 1               .include "../src/hal.inc"
0001EEr 2               ; =============================================================================
0001EEr 2               ;   hal.inc — Wizards Lab, the platform contract
0001EEr 2               ; =============================================================================
0001EEr 2               ;   Everything in src/ is shared, unmodified, by all three machines. The only
0001EEr 2               ;   things that differ are collected here: each platform's WizardsLab.asm must
0001EEr 2               ;   define these constants and implement these eight routines, and nothing
0001EEr 2               ;   else in src/ may touch hardware directly.
0001EEr 2               ;
0001EEr 2               ;   This file declares nothing. It is the documentation for the boundary, kept
0001EEr 2               ;   next to the code it constrains so it cannot drift out of date unnoticed.
0001EEr 2               ;
0001EEr 2               ;   CONSTANTS the platform must define BEFORE including the shared sources
0001EEr 2               ;   ---------------------------------------------------------------------
0001EEr 2               ;     PANEL_X, PANEL_Y      Where the 22 x 24 panel sits on this screen.
0001EEr 2               ;                             AC6502  5, 0      VIC-20  0, 0      C64  9, 0
0001EEr 2               ;                           PANEL_Y is 0 everywhere; the VIC-20 clips panel
0001EEr 2               ;                           row 23 and the C64 has one spare row below it.
0001EEr 2               ;     SCR_COLS           32 / 22 / 40
0001EEr 2               ;     SCR_ROWS           24 / 23 / 25
0001EEr 2               ;     HAS_COLOR_RAM         1 on the Commodores, 0 on the AC6502, whose colour
0001EEr 2               ;                           lives in the VDP colour table instead.
0001EEr 2               ;
0001EEr 2               ;   ROUTINES the platform must implement
0001EEr 2               ;   ------------------------------------
0001EEr 2               ;     HalInitVideo      Bring up the video hardware: black background and
0001EEr 2               ;                       border, the correct text/tile mode, tileset in place,
0001EEr 2               ;                       colours configured, screen cleared. Called once.
0001EEr 2               ;                       In:  nothing        Out: nothing
0001EEr 2               ;
0001EEr 2               ;     HalWaitFrame      Block until the start of the next vertical blank.
0001EEr 2               ;                       Everything below is called only between frames.
0001EEr 2               ;                       In:  nothing        Out: nothing
0001EEr 2               ;
0001EEr 2               ;     HalPlotCell       Write one cell, colour included where the platform has
0001EEr 2               ;                       per-cell colour — white instead, for any tile whose
0001EEr 2               ;                       colour key is TintColor (see HalColorFlash).
0001EEr 2               ;                       In:  A = tile, X = screen column, Y = screen row
0001EEr 2               ;                       Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
0001EEr 2               ;
0001EEr 2               ;     HalBlitScreen     Draw a whole static screen from a name-table image in
0001EEr 2               ;                       ROM: SCR_COLS * SCR_ROWS bytes, row-major, plus
0001EEr 2               ;                       the matching colour image where the platform needs one.
0001EEr 2               ;                       In:  SrcPtr -> name table, Ptr1 -> colour table
0001EEr 2               ;                       Out: nothing
0001EEr 2               ;
0001EEr 2               ;     HalReadInput      Read stick and keyboard, fold both into one mask.
0001EEr 2               ;                       In:  nothing
0001EEr 2               ;                       Out: A = INPUT_* bits, ACTIVE HIGH
0001EEr 2               ;
0001EEr 2               ;     HalDetectRegion   Decide NTSC or PAL so the timing tables can be picked.
0001EEr 2               ;                       In:  nothing        Out: A = 0 NTSC, 1 PAL
0001EEr 2               ;
0001EEr 2               ;     HalColorFlash     Draw every tile of one colour white, or stop doing so.
0001EEr 2               ;                       The fireball's detonation (SPEC 4.6, 14).
0001EEr 2               ;                       In:  A = colour key ($40..$68), or TINT_NONE for none
0001EEr 2               ;                       Out: nothing.  Modifies: A, X, Y, and TintColor, which
0001EEr 2               ;                            it OWNS: nothing else may write that byte.
0001EEr 2               ;                       The platform must handle the transition, not just the
0001EEr 2               ;                       new value — a second call with a different colour puts
0001EEr 2               ;                       the first one back before lighting the second.
0001EEr 2               ;                       On the AC6502 this is ONE byte in the VDP colour table,
0001EEr 2               ;                       because a tile's colour there belongs to its 8-pattern
0001EEr 2               ;                       group and not to the cell. On the Commodores colour is
0001EEr 2               ;                       per cell, so HalPlotCell reads TintColor instead and
0001EEr 2               ;                       substitutes white for any tile of that colour as it
0001EEr 2               ;                       draws it — which also means every tinted cell has to be
0001EEr 2               ;                       re-marked, and the animation is already marking all of
0001EEr 2               ;                       them (anim.asm).
0001EEr 2               ;
0001EEr 2               ;     HalSfx            Start a sound effect. May be a bare RTS until audio
0001EEr 2               ;                       exists.
0001EEr 2               ;                       In:  A = effect id (SPEC 16)
0001EEr 2               ;                       Out: nothing
0001EEr 2               ;
0001EEr 2               ;   The shared code assumes nothing about interrupts. Each platform may drive
0001EEr 2               ;   HalWaitFrame from a raster IRQ, a timer, or a status-register poll.
0001EEr 2               ; =============================================================================
0001EEr 2               
0001EEr 1               
0001EEr 1               ; =============================================================================
0001EEr 1               ;   Cartridge entry
0001EEr 1               ; =============================================================================
0001EEr 1               
0001EEr 1               .segment "CODE"
000000r 1               
000000r 1               CartReset:
000000r 1  78             sei
000001r 1  D8             cld
000002r 1  A2 FF          ldx #$FF
000004r 1  9A             txs                           ; Nothing did this for us
000005r 1  20 78 A0       jsr KernalInit                ; Probe and initialise every card, IRQs left off
000008r 1               
000008r 1  20 rr rr       jsr GameInit                  ; Never returns
00000Br 1               
00000Br 1               ; --- Shared game code --------------------------------------------------------
00000Br 1               .include "../src/main.asm"
00000Br 2               ; =============================================================================
00000Br 2               ;   main.asm — Wizards Lab, shared entry point and main loop
00000Br 2               ; =============================================================================
00000Br 2               ;   Included by every platform's WizardsLab.asm after that file has defined
00000Br 2               ;   PANEL_X / PANEL_Y and its half of the HAL (see hal.inc). Nothing below
00000Br 2               ;   touches hardware.
00000Br 2               ;
00000Br 2               ;   BUILD STATUS
00000Br 2               ;   ------------
00000Br 2               ;   Pieces spawn, steer, rotate, fall and lock, runs of three or more clear,
00000Br 2               ;   the pile falls into the holes, chains keep going until nothing matches, all
00000Br 2               ;   of it scores and ramps the level, the five reagents fire and set each other
00000Br 2               ;   off, a clear glows and shatters on the frame clock instead of happening
00000Br 2               ;   between two frames, and the arcade loop around all of it is closed: title,
00000Br 2               ;   play, pause, game over, title (PLAN.md P2 to P7). What is left is the sound
00000Br 2               ;   (P8).
00000Br 2               ; =============================================================================
00000Br 2               
00000Br 2               ; -----------------------------------------------------------------------------
00000Br 2               ;   GameInit — one-time setup, called from the cartridge entry point
00000Br 2               ; -----------------------------------------------------------------------------
00000Br 2               GameInit:
00000Br 2  20 rr rr       jsr HalDetectRegion
00000Er 2  8D rr rr       sta Region
000011r 2               
000011r 2  20 rr rr       jsr HalInitVideo              ; Tiles in place, screen black and cleared
000014r 2  20 rr rr       jsr AudioInit
000017r 2  20 rr rr       jsr RenderDirtyReset
00001Ar 2               
00001Ar 2  A9 00          lda #0
00001Cr 2  8D rr rr       sta FrameCounter
00001Fr 2  20 rr rr       jsr RngSeed                   ; A zero LFSR state sticks at zero forever, and
000022r 2                                               ;   BSS is not cleared on all three machines, so
000022r 2                                               ;   seed it once here just to get it out of that
000022r 2                                               ;   hole. This is NOT the game's seed — SPEC 15
000022r 2                                               ;   forbids a constant one, and StateTitle
000022r 2                                               ;   reseeds from the player's reaction time
000022r 2                                               ;   before the first piece is ever rolled.
000022r 2  A9 00          lda #0
000024r 2  8D rr rr       sta InputNow
000027r 2  8D rr rr       sta InputPrev
00002Ar 2  8D rr rr       sta InputEdge
00002Dr 2  8D rr rr       sta TitlePhase                ; The title prompt starts lit, and the game-over
000030r 2  8D rr rr       sta OverSecs                  ;   screen starts un-entered. Both are BSS, and
000033r 2                                               ;   BSS is not cleared on all three machines.
000033r 2  A9 01          lda #1
000035r 2  8D rr rr       sta PrismTimer                ; A zero here would DEC to 255 and stall the
000038r 2                                               ;   prism's rotation for four seconds
000038r 2  A9 01          lda #TINT_NONE                ; BSS is not cleared on all three machines, and
00003Ar 2  8D rr rr       sta TintColor                 ;   a garbage colour key here would draw the
00003Dr 2                                               ;   title screen's tiles of that colour white
00003Dr 2                                               ;   on the Commodores. Set before anything
00003Dr 2                                               ;   plots a cell, not in HalColorFlash, which
00003Dr 2                                               ;   reads it to undo the last flash (hal.inc).
00003Dr 2               
00003Dr 2  20 rr rr       jsr ScoreHighInit             ; Once a session, before the first ScoreReset
000040r 2  20 rr rr       jsr ScoreReset
000043r 2  20 rr rr       jsr BoardClear
000046r 2               
000046r 2               .ifdef WL_DEBUG
000046r 2                 jsr GameStart                 ; TEMPORARY: skip the title and start playing,
000046r 2                                               ;   because a headless machine has no input
000046r 2                                               ;   attached and would sit on the title screen
000046r 2                                               ;   forever. Nothing else about the build
000046r 2                                               ;   differs any more (PLAN.md section 3).
000046r 2               .else
000046r 2  A9 00          lda #STATE_TITLE
000048r 2  8D rr rr       sta GameState
00004Br 2  A9 01          lda #1
00004Dr 2  8D rr rr       sta NeedsRedraw
000050r 2               .endif
000050r 2                 ; falls through into GameLoop
000050r 2               
000050r 2               ; -----------------------------------------------------------------------------
000050r 2               ;   GameLoop — never returns
000050r 2               ; -----------------------------------------------------------------------------
000050r 2               GameLoop:
000050r 2  20 rr rr       jsr HalWaitFrame
000053r 2  EE rr rr       inc FrameCounter              ; Free-running from power-on; seeds the RNG
000056r 2               
000056r 2  20 rr rr       jsr RenderFlush               ; Screen writes happen in vertical blank only
000059r 2  20 rr rr       jsr InputPoll
00005Cr 2               
00005Cr 2  AD rr rr       lda GameState                 ; Dispatch on the current screen state
00005Fr 2  C9 00          cmp #STATE_TITLE
000061r 2  F0 0E          beq @Title
000063r 2  C9 01          cmp #STATE_PLAY
000065r 2  F0 10          beq @Play
000067r 2  C9 02          cmp #STATE_PAUSE
000069r 2  F0 12          beq @Pause
00006Br 2  20 rr rr       jsr StateGameOver             ; JSR, not JMP — every state handler ends in an
00006Er 2  4C rr rr       jmp @Audio                    ;   RTS, and a JMP here would hand that RTS the
000071r 2                                               ;   return address of the JSR GameInit that the
000071r 2                                               ;   cart entry point never expects back. The
000071r 2                                               ;   first loss unwound the loop into GameInit;
000071r 2                                               ;   the second pulled from an empty stack.
000071r 2               
000071r 2               @Title:
000071r 2  20 rr rr       jsr StateTitle
000074r 2  4C rr rr       jmp @Audio
000077r 2               @Play:
000077r 2  20 rr rr       jsr StatePlay
00007Ar 2  4C rr rr       jmp @Audio
00007Dr 2               @Pause:
00007Dr 2  20 rr rr       jsr StatePause
000080r 2               
000080r 2               @Audio:
000080r 2  20 rr rr       jsr AudioTick
000083r 2  4C rr rr       jmp GameLoop
000086r 2               
000086r 2               ; =============================================================================
000086r 2               ;   States (SPEC 13)
000086r 2               ; =============================================================================
000086r 2               
000086r 2               ; -----------------------------------------------------------------------------
000086r 2               ;   StateTitle — blinking prompt over the drawn screen, and the magic field
000086r 2               ;   SPEC 13.1. There are no help pages: the controls are part of the screen
000086r 2               ;   image, so the only things moving here are the prompt and the field.
000086r 2               ; -----------------------------------------------------------------------------
000086r 2               StateTitle:
000086r 2  AD rr rr       lda NeedsRedraw
000089r 2  F0 0E          beq @Live
00008Br 2  A9 00          lda #0
00008Dr 2  8D rr rr       sta NeedsRedraw
000090r 2  20 rr rr       jsr DrawTitleScreen
000093r 2  20 rr rr       jsr RenderDirtyReset          ; A full blit went behind the renderer's back
000096r 2               
000096r 2  20 rr rr       jsr AnimTitleBegin            ; ...and the prompt blinks from lit, so it never
000099r 2                                               ;   starts a second visit dark
000099r 2               @Live:
000099r 2  20 rr rr       jsr AnimTitleField            ; The two things that move here, and the whole
00009Cr 2  20 rr rr       jsr AnimTitleBlink            ;   of the screen's animation (SPEC 13.1)
00009Fr 2               
00009Fr 2  AD rr rr       lda InputEdge
0000A2r 2  29 11          and #(INPUT_FIRE | INPUT_UP)  ; Fire, or SPACE, which the keyboards fold
0000A4r 2  F0 06          beq @Done                     ;   into UP so it can rotate in play (D15)
0000A6r 2               
0000A6r 2  20 rr rr       jsr RngSeed                   ; SPEC 15 — seed from reaction time, not a constant
0000A9r 2  20 rr rr       jsr GameStart
0000ACr 2               @Done:
0000ACr 2  60             rts
0000ADr 2               
0000ADr 2               ; -----------------------------------------------------------------------------
0000ADr 2               ;   GameStart — enter play from the title screen
0000ADr 2               ; -----------------------------------------------------------------------------
0000ADr 2               GameStart:
0000ADr 2  20 rr rr       jsr ScoreReset
0000B0r 2  20 rr rr       jsr BoardClear
0000B3r 2               
0000B3r 2  A9 01          lda #1
0000B5r 2  8D rr rr       sta Level
0000B8r 2  A9 00          lda #0
0000BAr 2  8D rr rr       sta TilesCleared
0000BDr 2  8D rr rr       sta DasDir                    ; No direction is held into a new game
0000C0r 2  8D rr rr       sta DasTimer
0000C3r 2  8D rr rr       sta PieceDirty
0000C6r 2  8D rr rr       sta BannerTimer               ; Nothing from the last game is still up
0000C9r 2  8D rr rr       sta PrismFrame
0000CCr 2  A9 01          lda #1
0000CEr 2  8D rr rr       sta PrismTimer
0000D1r 2  A9 01          lda #TINT_NONE                ; ...and no colour is still flashing white, on
0000D3r 2  20 rr rr       jsr HalColorFlash             ;   a machine where that is a VDP register and
0000D6r 2                                               ;   not a byte of RAM (SPEC 4.6)
0000D6r 2               
0000D6r 2  20 rr rr       jsr DrawPlayScreen            ; The whole screen at once, behind the
0000D9r 2  20 rr rr       jsr RenderDirtyReset          ;   renderer's back — so drop anything queued
0000DCr 2                                               ;   against the screen that just went away
0000DCr 2               
0000DCr 2  20 rr rr       jsr TextBannerClear           ; The play image ships with the band reading
0000DFr 2                                               ;   `~~ PAUSED ~~` (SPEC 12.1); play owns it,
0000DFr 2                                               ;   and so does whatever the last game left in
0000DFr 2                                               ;   it — GAME OVER stays up until here
0000DFr 2  20 rr rr       jsr RenderScore               ; The panel fields are code's, not the image's
0000E2r 2  20 rr rr       jsr RenderHigh
0000E5r 2  20 rr rr       jsr RenderLevel
0000E8r 2  20 rr rr       jsr RenderBoard               ; Queued across as many frames as it takes
0000EBr 2               
0000EBr 2  20 rr rr       jsr PieceGenerateNext         ; Fill the preview...
0000EEr 2  20 rr rr       jsr PieceSpawn                ; ...then promote it and refill. The board is
0000F1r 2  20 rr rr       jsr PieceGenerateNext         ;   empty, so the spawn cannot be blocked.
0000F4r 2  20 rr rr       jsr RenderNext
0000F7r 2               
0000F7r 2  A9 00          lda #PLAY_FALLING
0000F9r 2  8D rr rr       sta PlayState
0000FCr 2  A9 01          lda #STATE_PLAY
0000FEr 2  8D rr rr       sta GameState
000101r 2  60             rts
000102r 2               
000102r 2               ; -----------------------------------------------------------------------------
000102r 2               ;   StatePlay — the game
000102r 2               ;   SPEC 13.2. One frame is: advance whatever the play sub-state is doing,
000102r 2               ;   then queue whatever changed. Cascades run as sub-states rather than in a
000102r 2               ;   blocking loop so animation stays on the frame clock.
000102r 2               ; -----------------------------------------------------------------------------
000102r 2               StatePlay:
000102r 2  20 rr rr       jsr ScoreFlashTick            ; SPEC 9.8 — the HIGH field blinking after an
000105r 2                                               ;   overtake. Play never stops for it, so it
000105r 2                                               ;   ticks alongside whatever the sub-state is
000105r 2                                               ;   doing rather than inside one.
000105r 2  20 rr rr       jsr AnimBannerTick            ; ...and neither does it for a banner (SPEC 14)
000108r 2  20 rr rr       jsr AnimPrismTick             ; ...nor for the one tile that moves at rest
00010Br 2               
00010Br 2  AD rr rr       lda InputEdge
00010Er 2  29 20          and #INPUT_PAUSE
000110r 2  D0 52          bne @ToPause
000112r 2               
000112r 2  AD rr rr       lda PlayState
000115r 2  C9 00          cmp #PLAY_FALLING
000117r 2  F0 17          beq @Falling
000119r 2  C9 01          cmp #PLAY_LOCKING
00011Br 2  F0 19          beq @Locking
00011Dr 2  C9 02          cmp #PLAY_GLOW
00011Fr 2  F0 1B          beq @Glow
000121r 2  C9 03          cmp #PLAY_SHATTER
000123r 2  F0 1D          beq @Shatter
000125r 2  C9 04          cmp #PLAY_GRAVITY
000127r 2  F0 1F          beq @Gravity
000129r 2  C9 05          cmp #PLAY_ARE
00012Br 2  F0 21          beq @Are
00012Dr 2  4C rr rr       jmp @Draw                     ; Not a state anything sets
000130r 2               
000130r 2               @Falling:
000130r 2  20 rr rr       jsr PlayFalling
000133r 2  4C rr rr       jmp @Draw
000136r 2               @Locking:
000136r 2  20 rr rr       jsr PlayLocking
000139r 2  4C rr rr       jmp @Draw
00013Cr 2               @Glow:
00013Cr 2  20 rr rr       jsr PlayGlow
00013Fr 2  4C rr rr       jmp @Draw
000142r 2               @Shatter:
000142r 2  20 rr rr       jsr PlayShatter
000145r 2  4C rr rr       jmp @Draw
000148r 2               @Gravity:
000148r 2  20 rr rr       jsr PlayGravity
00014Br 2  4C rr rr       jmp @Draw
00014Er 2               @Are:
00014Er 2  20 rr rr       jsr PlayAre
000151r 2               
000151r 2                 ; --- draw the piece, once whatever else wanted the screen has finished ----
000151r 2                 ;   D14. RenderBoard is a cursor that feeds the ring over several frames
000151r 2                 ;   (D12), so marks made while one is outstanding are drawn BEFORE the
000151r 2                 ;   redraw reaches those cells and are then painted over. Holding the piece
000151r 2                 ;   back until the redraw has finished is one byte and always right; the
000151r 2                 ;   alternative is a piece that vanishes for four frames after every pause.
000151r 2               @Draw:
000151r 2  AD rr rr       lda PieceDirty
000154r 2  F0 0D          beq @Done
000156r 2  AD rr rr       lda RedrawIdx
000159r 2  10 08          bpl @Done                     ; A board redraw is still in flight
00015Br 2  A9 00          lda #0
00015Dr 2  8D rr rr       sta PieceDirty
000160r 2  20 rr rr       jsr RenderPiece
000163r 2               @Done:
000163r 2  60             rts
000164r 2               
000164r 2               @ToPause:
000164r 2  A9 02          lda #STATE_PAUSE
000166r 2  8D rr rr       sta GameState
000169r 2  A9 rr          lda #<MsgPaused               ; SPEC 12.2 — without this the screen does not
00016Br 2  85 rr          sta Ptr1                      ;   change at all on a pause, and a paused game
00016Dr 2  A9 rr          lda #>MsgPaused               ;   is indistinguishable from a hung one
00016Fr 2  85 rr          sta Ptr1+1
000171r 2  20 rr rr       jsr TextBanner
000174r 2  4C rr rr       jmp RenderWash                ; SPEC 13.3 — the well is covered, not blanked,
000177r 2                                               ;   so a pause cannot be used to study the
000177r 2                                               ;   board. Queued as a cursor because 96 cells
000177r 2                                               ;   do not fit the ring (render.asm, D12), and
000177r 2                                               ;   AFTER the banner, so the banner's marks are
000177r 2                                               ;   in the ring before the wash starts filling
000177r 2                                               ;   it
000177r 2               
000177r 2               ; -----------------------------------------------------------------------------
000177r 2               ;   PlayFalling — steer the piece, and drop it a row when the timer runs out
000177r 2               ;   SPEC 5.5, 5.6, 11.3
000177r 2               ; -----------------------------------------------------------------------------
000177r 2               PlayFalling:
000177r 2  20 rr rr       jsr PieceControl              ; Rotation and DAS; the result is ignored here
00017Ar 2                                               ;   because there is no lock delay to reset yet
00017Ar 2  20 rr rr       jsr PieceFallRate
00017Dr 2  85 rr          sta Tmp0
00017Fr 2  AD rr rr       lda GravityTimer              ; Pressing DOWN mid-wait must shorten the wait
000182r 2  C5 rr          cmp Tmp0                      ;   in progress, not just the next one
000184r 2  90 05          bcc @Tick
000186r 2  A5 rr          lda Tmp0
000188r 2  8D rr rr       sta GravityTimer
00018Br 2               @Tick:
00018Br 2  CE rr rr       dec GravityTimer
00018Er 2  D0 1E          bne @Done
000190r 2  20 rr rr       jsr PieceStep
000193r 2  B0 0B          bcs @Land
000195r 2  20 rr rr       jsr PieceFallRate             ; ...and C tells us whose rate the row that
000198r 2  8D rr rr       sta GravityTimer              ;   just fell used. STA leaves it alone.
00019Br 2  B0 11          bcs @Done
00019Dr 2  4C rr rr       jmp ScoreSoftDrop             ; SPEC 9.6 — one point, one row
0001A0r 2               
0001A0r 2               @Land:
0001A0r 2  AE rr rr       ldx Region
0001A3r 2  BD rr rr       lda LockDelay,x
0001A6r 2  8D rr rr       sta LockTimer
0001A9r 2  A9 01          lda #PLAY_LOCKING
0001ABr 2  8D rr rr       sta PlayState
0001AEr 2               @Done:
0001AEr 2  60             rts
0001AFr 2               
0001AFr 2               ; -----------------------------------------------------------------------------
0001AFr 2               ;   PlayLocking — the lock delay, and the moves that may reset it
0001AFr 2               ;   SPEC 5.6 — a horizontal move resets the delay LOCK_RESET_MAX times; after
0001AFr 2               ;   that it runs out regardless. Rotation never resets it. A move that opens a
0001AFr 2               ;   gap underneath resumes falling, and the reset count carries.
0001AFr 2               ; -----------------------------------------------------------------------------
0001AFr 2               PlayLocking:
0001AFr 2  20 rr rr       jsr PieceControl
0001B2r 2  90 13          bcc @Settled
0001B4r 2  AD rr rr       lda LockResets
0001B7r 2  C9 04          cmp #LOCK_RESET_MAX
0001B9r 2  B0 0C          bcs @Settled
0001BBr 2  EE rr rr       inc LockResets
0001BEr 2  AE rr rr       ldx Region
0001C1r 2  BD rr rr       lda LockDelay,x
0001C4r 2  8D rr rr       sta LockTimer
0001C7r 2               
0001C7r 2               @Settled:
0001C7r 2  20 rr rr       jsr PieceCanFall
0001CAr 2  90 0C          bcc @Tick
0001CCr 2  A9 00          lda #PLAY_FALLING             ; It moved over a hole — fall again. SPEC 5.6
0001CEr 2  8D rr rr       sta PlayState                 ;   says the lock counter clears here and the
0001D1r 2                                               ;   reset count does not; nothing reads
0001D1r 2                                               ;   LockTimer while falling and the next
0001D1r 2                                               ;   landing loads it fresh, so it is already
0001D1r 2                                               ;   clear in every sense that matters.
0001D1r 2  20 rr rr       jsr PieceFallRate
0001D4r 2  8D rr rr       sta GravityTimer
0001D7r 2  60             rts
0001D8r 2               
0001D8r 2               @Tick:
0001D8r 2  CE rr rr       dec LockTimer
0001DBr 2  D0 09          bne @Done
0001DDr 2  20 rr rr       jsr PieceLock
0001E0r 2  20 rr rr       jsr CascadeBegin              ; SPEC 8 — the cascade starts the moment the
0001E3r 2  4C rr rr       jmp CascadeEnter              ;   piece is board, and runs as sub-states
0001E6r 2               @Done:
0001E6r 2  60             rts
0001E7r 2               
0001E7r 2               ; -----------------------------------------------------------------------------
0001E7r 2               ;   CascadeEnter — run one cascade step and choose the sub-state after it
0001E7r 2               ;   In:  ChainStep set        Out: PlayState set.  Modifies: A, X, Y
0001E7r 2               ;   SPEC 8, D4. Called from the lock, and again from the bottom of every fall.
0001E7r 2               ;
0001E7r 2               ;   A step that marks something hands over to PLAY_GLOW, and the removal and
0001E7r 2               ;   the fall follow it twelve frames later; a step that finds nothing is where
0001E7r 2               ;   the cascade settles and the next piece is queued.
0001E7r 2               ;
0001E7r 2               ;   Nothing has come off the board when CascadeScan returns — that is the whole
0001E7r 2               ;   point of the split (cascade.asm). CascadeFinish does the taking, at the far
0001E7r 2               ;   end of PLAY_SHATTER.
0001E7r 2               ; -----------------------------------------------------------------------------
0001E7r 2               CascadeEnter:
0001E7r 2  20 rr rr       jsr CascadeScan
0001EAr 2  90 03          bcc @Settle
0001ECr 2  4C rr rr       jmp AnimGlowBegin             ; SPEC 8 step 5
0001EFr 2               
0001EFr 2               @Settle:
0001EFr 2  20 rr rr       jsr CascadeSettle             ; The star multiplier and the bank (SPEC 8
0001F2r 2                                               ;   SETTLE)
0001F2r 2  AD rr rr       lda ChainStep                 ; SPEC 8 SETTLE, SPEC 14 — a chain of two links
0001F5r 2  38             sec                           ;   or more is worth saying out loud. ChainStep
0001F6r 2  E9 01          sbc #1                        ;   counts the step that found nothing as well,
0001F8r 2  C9 02          cmp #2                        ;   so the links are one fewer
0001FAr 2  90 03          bcc @Are
0001FCr 2  20 rr rr       jsr AnimBannerChain
0001FFr 2               
0001FFr 2               @Are:
0001FFr 2  AE rr rr       ldx Region
000202r 2  BD rr rr       lda AreDelay,x
000205r 2  8D rr rr       sta AreTimer
000208r 2  A9 05          lda #PLAY_ARE
00020Ar 2  8D rr rr       sta PlayState
00020Dr 2  60             rts
00020Er 2               
00020Er 2               ; -----------------------------------------------------------------------------
00020Er 2               ;   PlayGlow — hold the glow, the beams and the fireball's flash (SPEC 14)
00020Er 2               ;   The window is one timer however many things are showing inside it: they all
00020Er 2               ;   start together and the longest decides how long it lasts (anim.asm).
00020Er 2               ; -----------------------------------------------------------------------------
00020Er 2               PlayGlow:
00020Er 2  CE rr rr       dec AnimTimer
000211r 2  D0 03          bne @Done
000213r 2  4C rr rr       jmp AnimGlowEnd               ; ...which starts the shatter
000216r 2               @Done:
000216r 2  60             rts
000217r 2               
000217r 2               ; -----------------------------------------------------------------------------
000217r 2               ;   PlayShatter — the removal ring, VFX_FRAMES a tile (SPEC 14)
000217r 2               ;   The board is finally emptied at the end of this, not at the start of it:
000217r 2               ;   every frame up to here has been drawing over cells that still hold their
000217r 2               ;   own tiles (cascade.asm).
000217r 2               ; -----------------------------------------------------------------------------
000217r 2               PlayShatter:
000217r 2  CE rr rr       dec AnimTimer
00021Ar 2  D0 20          bne @Done
00021Cr 2  EE rr rr       inc AnimStep
00021Fr 2  AD rr rr       lda AnimStep
000222r 2  CD rr rr       cmp AnimSteps
000225r 2  B0 0A          bcs @Over
000227r 2  A9 02          lda #VFX_FRAMES
000229r 2  8D rr rr       sta AnimTimer
00022Cr 2  A9 03          lda #ANIM_SHATTER
00022Er 2  4C rr rr       jmp AnimMarked
000231r 2               
000231r 2               @Over:
000231r 2  20 rr rr       jsr CascadeFinish             ; SPEC 8 steps 6 and 7
000234r 2  20 rr rr       jsr BoardGravityBegin         ; ...and let what was above it fall
000237r 2  A9 04          lda #PLAY_GRAVITY
000239r 2  8D rr rr       sta PlayState
00023Cr 2               @Done:
00023Cr 2  60             rts
00023Dr 2               
00023Dr 2               ; -----------------------------------------------------------------------------
00023Dr 2               ;   PlayGravity — the pile falls into the holes the clear left
00023Dr 2               ;   SPEC 8 step 8, SPEC 14 — a row every FALL_FRAMES, and when a row moves
00023Dr 2               ;   nothing the board has settled and the next step scans it.
00023Dr 2               ;
00023Dr 2               ;   The row itself may take more than one frame: BoardGravityStep is a cursor
00023Dr 2               ;   that stops when the dirty ring is full (board.asm). The beat only starts
00023Dr 2               ;   once the row has actually landed, so a heavy board falls a little slower
00023Dr 2               ;   rather than losing cells off the screen.
00023Dr 2               ; -----------------------------------------------------------------------------
00023Dr 2               PlayGravity:
00023Dr 2  A5 rr          lda GravIdx
00023Fr 2  10 0C          bpl @Working                  ; A row is still coming down
000241r 2               
000241r 2  CE rr rr       dec AnimTimer
000244r 2  D0 11          bne @Done
000246r 2  A5 rr          lda GravMoved
000248r 2  F0 0E          beq @Landed                   ; The last row moved nothing: everything is
00024Ar 2  20 rr rr       jsr BoardGravityBegin         ;   resting on something
00024Dr 2               
00024Dr 2               @Working:
00024Dr 2  20 rr rr       jsr BoardGravityStep
000250r 2  90 05          bcc @Done                     ; The ring filled — the rest waits for a flush
000252r 2  A9 02          lda #FALL_FRAMES              ; The row is down; hold it there for the beat
000254r 2  8D rr rr       sta AnimTimer
000257r 2               @Done:
000257r 2  60             rts
000258r 2               
000258r 2               @Landed:
000258r 2  EE rr rr       inc ChainStep                 ; SPEC 8 step 9
00025Br 2  4C rr rr       jmp CascadeEnter
00025Er 2               
00025Er 2               ; -----------------------------------------------------------------------------
00025Er 2               ;   PlayAre — the entry delay, then the next piece
00025Er 2               ;   SPEC 5.6, 13.4 — a blocked spawn is game over.
00025Er 2               ; -----------------------------------------------------------------------------
00025Er 2               PlayAre:
00025Er 2  CE rr rr       dec AreTimer
000261r 2  D0 10          bne @Done
000263r 2  20 rr rr       jsr PieceSpawn
000266r 2  B0 0C          bcs @Over
000268r 2  20 rr rr       jsr PieceGenerateNext
00026Br 2  20 rr rr       jsr RenderNext
00026Er 2  A9 00          lda #PLAY_FALLING
000270r 2  8D rr rr       sta PlayState
000273r 2               @Done:
000273r 2  60             rts
000274r 2               
000274r 2               @Over:
000274r 2  A9 0C          lda #SFX_GAMEOVER
000276r 2  8D rr rr       sta SfxRequest
000279r 2  20 rr rr       jsr AnimPetrifyBegin          ; The well turns to stone from the floor up
00027Cr 2  A9 00          lda #0                        ;   while StateGameOver holds the input off
00027Er 2  8D rr rr       sta OverSecs                  ; The screen proper has not started yet — the
000281r 2                                               ;   petrify runs first (SPEC 13.4 step 2)
000281r 2  A9 03          lda #STATE_GAMEOVER
000283r 2  8D rr rr       sta GameState
000286r 2  60             rts
000287r 2               
000287r 2               ; -----------------------------------------------------------------------------
000287r 2               ;   StatePause
000287r 2               ; -----------------------------------------------------------------------------
000287r 2               StatePause:
000287r 2  AD rr rr       lda InputEdge
00028Ar 2  29 30          and #(INPUT_PAUSE | INPUT_FIRE)
00028Cr 2  F0 17          beq @Done
00028Er 2  A9 01          lda #STATE_PLAY
000290r 2  8D rr rr       sta GameState
000293r 2  20 rr rr       jsr TextBannerClear           ; The banner comes down...
000296r 2  20 rr rr       jsr RenderBoard               ; ...the board goes back up...
000299r 2  AD rr rr       lda PlayState                 ;   ...and the piece on top of it, once the
00029Cr 2  C9 02          cmp #PLAY_GLOW                ;   redraw has gone by (D14) — but only while
00029Er 2  B0 05          bcs @Done                     ;   there IS one. From GLOW on up the piece is
0002A0r 2  A9 01          lda #1                        ;   in the board and PieceA-C are stale; the
0002A2r 2  8D rr rr       sta PieceDirty                ;   cascade may have taken those cells away
0002A5r 2               @Done:                          ;   entirely.
0002A5r 2  60             rts
0002A6r 2               
0002A6r 2               ; -----------------------------------------------------------------------------
0002A6r 2               ;   StateGameOver — petrify, banner, fanfare, back to the title
0002A6r 2               ;   SPEC 13.4, in its own order: the well sets to stone, THEN the band says so,
0002A6r 2               ;   and only then does the screen start counting itself out.
0002A6r 2               ;
0002A6r 2               ;   OverSecs is the phase as well as the count. It is zero for the length of
0002A6r 2               ;   the petrify and never zero afterwards, because the frame it would reach
0002A6r 2               ;   zero is the frame this state ends — so the one-shot in the middle needs no
0002A6r 2               ;   flag of its own.
0002A6r 2               ;
0002A6r 2               ;   Nothing here ticks the banner down (AnimBannerTick is StatePlay's), which
0002A6r 2               ;   is what leaves GAME OVER up for the whole ten seconds rather than the 45
0002A6r 2               ;   frames every other banner gets. GameStart clears the band on the way out.
0002A6r 2               ; -----------------------------------------------------------------------------
0002A6r 2               StateGameOver:
0002A6r 2  20 rr rr       jsr AnimPetrifyTick           ; SPEC 13.4 step 2, a row every PETRIFY_FRAMES
0002A9r 2  B0 56          bcs @Done                     ; Still setting. A press during the petrify is
0002ABr 2                                               ;   ignored rather than queued: the animation
0002ABr 2                                               ;   is the game telling the player it is over
0002ABr 2                                               ;   and skipping it reads as a dropped input.
0002ABr 2  AD rr rr       lda OverSecs
0002AEr 2  D0 2A          bne @Waiting
0002B0r 2               
0002B0r 2  20 rr rr       jsr AnimBannerOver            ; SPEC 13.4 step 3
0002B3r 2  AD rr rr       lda HighOwned                 ; Step 4 — the fanfare and the flash, but only
0002B6r 2  F0 13          beq @Start                    ;   if THIS game took the record. HighOwned is
0002B8r 2                                               ;   what says so, and ScoreReset clears it for
0002B8r 2                                               ;   the next one (score.asm, SPEC 9.8)
0002B8r 2  A9 0B          lda #SFX_HIGHSCORE
0002BAr 2  8D rr rr       sta SfxRequest
0002BDr 2  A9 06          lda #HIGH_FLASH_BLINKS
0002BFr 2  8D rr rr       sta HighFlash
0002C2r 2  AE rr rr       ldx Region
0002C5r 2  BD rr rr       lda BlinkHalf,x
0002C8r 2  8D rr rr       sta HighTimer
0002CBr 2               @Start:
0002CBr 2  A9 0A          lda #GAMEOVER_SECS
0002CDr 2  8D rr rr       sta OverSecs
0002D0r 2  AE rr rr       ldx Region
0002D3r 2  BD rr rr       lda SecondFrames,x
0002D6r 2  8D rr rr       sta OverTimer
0002D9r 2  60             rts
0002DAr 2               
0002DAr 2               @Waiting:
0002DAr 2  20 rr rr       jsr ScoreFlashTick            ; The HIGH field blinks here for the same
0002DDr 2                                               ;   reason it does in play — nothing else is
0002DDr 2                                               ;   calling it now that StatePlay has stopped
0002DDr 2  CE rr rr       dec OverTimer
0002E0r 2  D0 0E          bne @Input
0002E2r 2  AE rr rr       ldx Region
0002E5r 2  BD rr rr       lda SecondFrames,x
0002E8r 2  8D rr rr       sta OverTimer
0002EBr 2  CE rr rr       dec OverSecs
0002EEr 2  F0 07          beq @ToTitle                  ; SPEC 13.4 step 5 — ten seconds, unattended
0002F0r 2               @Input:
0002F0r 2  AD rr rr       lda InputEdge
0002F3r 2  29 11          and #(INPUT_FIRE | INPUT_UP)  ; Fire, or SPACE (D15)
0002F5r 2  F0 0A          beq @Done
0002F7r 2               @ToTitle:
0002F7r 2  A9 00          lda #STATE_TITLE
0002F9r 2  8D rr rr       sta GameState
0002FCr 2  A9 01          lda #1
0002FEr 2  8D rr rr       sta NeedsRedraw
000301r 2               @Done:
000301r 2  60             rts
000302r 2               
000302r 2               ; =============================================================================
000302r 2               ;   Static screen drawing
000302r 2               ; =============================================================================
000302r 2               ;   The whole static layout — panel frame, labels, and the margin artwork that
000302r 2               ;   fills the screen either side of it — comes out of the editors as one
000302r 2               ;   name-table image per platform. Code only ever draws over the top of it:
000302r 2               ;   the well, the score and level digits, the preview, and the message band.
000302r 2               ;
000302r 2               ;   All six images are real. They come out of artwork/WizardsLab.tms9918 —
000302r 2               ;   the master — by way of `make artwork`. See data/README.md.
000302r 2               ; =============================================================================
000302r 2               
000302r 2               DrawTitleScreen:
000302r 2  A9 rr          lda #<TitleScreen
000304r 2  85 rr          sta SrcPtr
000306r 2  A9 rr          lda #>TitleScreen
000308r 2  85 rr          sta SrcPtr+1
00030Ar 2  A9 rr          lda #<TitleColor
00030Cr 2  85 rr          sta Ptr1
00030Er 2  A9 rr          lda #>TitleColor
000310r 2  85 rr          sta Ptr1+1
000312r 2  4C rr rr       jmp HalBlitScreen
000315r 2               
000315r 2               DrawPlayScreen:
000315r 2  A9 rr          lda #<PlayScreen
000317r 2  85 rr          sta SrcPtr
000319r 2  A9 rr          lda #>PlayScreen
00031Br 2  85 rr          sta SrcPtr+1
00031Dr 2  A9 rr          lda #<PlayColor
00031Fr 2  85 rr          sta Ptr1
000321r 2  A9 rr          lda #>PlayColor
000323r 2  85 rr          sta Ptr1+1
000325r 2  4C rr rr       jmp HalBlitScreen
000328r 2               
000328r 1               .include "../src/rng.asm"
000328r 2               ; =============================================================================
000328r 2               ;   rng.asm — Wizards Lab, random numbers
000328r 2               ; =============================================================================
000328r 2               ;   A 16-bit Galois LFSR with the conventional $B400 taps, which is maximal
000328r 2               ;   length: it visits all 65535 non-zero states before repeating. Eight shifts
000328r 2               ;   per call, one whole byte out.
000328r 2               ;
000328r 2               ;   Seeding matters more than the generator does. A fixed seed would deal the
000328r 2               ;   same first three pieces every session and the game would feel dead, so the
000328r 2               ;   seed is taken from the free-running frame counter at the moment the player
000328r 2               ;   presses fire on the title screen — human reaction time is the entropy.
000328r 2               ;
000328r 2               ;   SPEC.md section 15.
000328r 2               ; =============================================================================
000328r 2               
000328r 2               ; -----------------------------------------------------------------------------
000328r 2               ;   RngSeed — seed from the frame counter
000328r 2               ;   In:  nothing (reads FrameCounter)
000328r 2               ;   Out: nothing.  Modifies: A
000328r 2               ; -----------------------------------------------------------------------------
000328r 2               RngSeed:
000328r 2  AD rr rr       lda FrameCounter
00032Br 2  09 01          ora #$01                      ; Never let the state reach zero — it sticks
00032Dr 2  85 rr          sta RngLo
00032Fr 2  49 5A          eor #$5A                      ; Spread one byte of entropy over both halves
000331r 2  85 rr          sta RngHi
000333r 2  60             rts
000334r 2               
000334r 2               ; -----------------------------------------------------------------------------
000334r 2               ;   RngNext — next pseudo-random byte
000334r 2               ;   In:  nothing
000334r 2               ;   Out: A = random 0-255.  Modifies: A, X, flags
000334r 2               ; -----------------------------------------------------------------------------
000334r 2               RngNext:
000334r 2  A2 08          ldx #8                        ; Eight shifts give one whole output byte
000336r 2               @Bit:
000336r 2  46 rr          lsr RngHi                     ; Shift the 16-bit state right one place,
000338r 2  66 rr          ror RngLo                     ;   the bit falling out of bit 0 lands in C
00033Ar 2  90 06          bcc @NoTap
00033Cr 2  A5 rr          lda RngHi
00033Er 2  49 B4          eor #$B4                      ; Galois feedback mask $B400
000340r 2  85 rr          sta RngHi
000342r 2               @NoTap:
000342r 2  CA             dex
000343r 2  D0 F1          bne @Bit
000345r 2  A5 rr          lda RngLo
000347r 2  60             rts
000348r 2               
000348r 2               ; -----------------------------------------------------------------------------
000348r 2               ;   RngRange — a random number below a small limit
000348r 2               ;   In:  A = limit, 1-128
000348r 2               ;   Out: A = 0 .. limit-1.  Modifies: A, X, Tmp0, Tmp1.  PRESERVES Y.
000348r 2               ;
000348r 2               ;   Not a modulo. `random % 6` throws four of the 256 outcomes into the low
000348r 2               ;   values and leaves colours 0-3 a shade likelier than 4-5; this takes the
000348r 2               ;   HIGH byte of (random * limit) instead, which spreads the remainder evenly
000348r 2               ;   across the range and costs a fixed eight shifts either way.
000348r 2               ;
000348r 2               ;   The eight-bit multiply keeps only the high byte: the low half falls out of
000348r 2               ;   the accumulator one bit at a time and is never wanted.
000348r 2               ;
000348r 2               ;   Y is preserved so a caller can loop over the three cells of a piece with
000348r 2               ;   it (piece.asm does).
000348r 2               ; -----------------------------------------------------------------------------
000348r 2               RngRange:
000348r 2  48             pha                           ; The limit — RngNext wants A
000349r 2  20 rr rr       jsr RngNext
00034Cr 2  85 rr          sta Tmp0                      ; The random byte
00034Er 2  68             pla
00034Fr 2  85 rr          sta Tmp1                      ; The limit, shifted out one bit at a time
000351r 2  A9 00          lda #0
000353r 2  A2 08          ldx #8
000355r 2               @Bit:
000355r 2  46 rr          lsr Tmp1                      ; Next multiplier bit into C
000357r 2  90 03          bcc @NoAdd
000359r 2  18             clc
00035Ar 2  65 rr          adc Tmp0                      ; Partial product, carry out into C
00035Cr 2               @NoAdd:
00035Cr 2  6A             ror a                         ; Shift the accumulator down, carry in at bit 7
00035Dr 2  CA             dex
00035Er 2  D0 F5          bne @Bit
000360r 2  60             rts
000361r 2               
000361r 1               .include "../src/input.asm"
000361r 2               ; =============================================================================
000361r 2               ;   input.asm — Wizards Lab, input conditioning
000361r 2               ; =============================================================================
000361r 2               ;   SPEC.md section 11. HalReadInput hands back one active-high mask however
000361r 2               ;   the platform likes; everything above this line works on that mask and
000361r 2               ;   never touches hardware.
000361r 2               ;
000361r 2               ;   Auto-repeat applies to LEFT and RIGHT only. Rotate does NOT repeat — up
000361r 2               ;   must be released and pressed again. That is not a preference: a repeating
000361r 2               ;   rotate makes a three-cell Columns piece impossible to aim.
000361r 2               ; =============================================================================
000361r 2               
000361r 2               ; -----------------------------------------------------------------------------
000361r 2               ;   InputPoll — read the hardware and work out what is newly pressed
000361r 2               ;   In:  nothing
000361r 2               ;   Out: InputNow, InputPrev, InputEdge updated.  Modifies: A
000361r 2               ; -----------------------------------------------------------------------------
000361r 2               InputPoll:
000361r 2  AD rr rr       lda InputNow
000364r 2  8D rr rr       sta InputPrev
000367r 2  20 rr rr       jsr HalReadInput
00036Ar 2  8D rr rr       sta InputNow
00036Dr 2  4D rr rr       eor InputPrev                 ; Bits that changed
000370r 2  2D rr rr       and InputNow                  ; ...and are now down = newly pressed
000373r 2  8D rr rr       sta InputEdge
000376r 2  60             rts
000377r 2               
000377r 2               ; -----------------------------------------------------------------------------
000377r 2               ;   InputShift — LEFT/RIGHT with delayed auto shift
000377r 2               ;   Out: A = INPUT_LEFT, INPUT_RIGHT, or 0 if no move should happen this frame.
000377r 2               ;        Modifies: A, X
000377r 2               ;   SPEC 11.3 — initial delay 12 frames NTSC / 10 PAL, then 4 / 3.
000377r 2               ;
000377r 2               ;   A fresh press fires on the same frame it arrives; the delay is what comes
000377r 2               ;   after it, not before it, so a tap is always exactly one column.
000377r 2               ;
000377r 2               ;   Holding both directions at once is not something a stick can do, but two
000377r 2               ;   keys can. LEFT wins, and it wins consistently, so the piece sits still
000377r 2               ;   rather than shivering between the two.
000377r 2               ; -----------------------------------------------------------------------------
000377r 2               InputShift:
000377r 2  AD rr rr       lda InputNow
00037Ar 2  29 04          and #INPUT_LEFT
00037Cr 2  D0 07          bne @Dir
00037Er 2  AD rr rr       lda InputNow
000381r 2  29 08          and #INPUT_RIGHT
000383r 2  F0 2A          beq @None
000385r 2               
000385r 2               @Dir:
000385r 2  CD rr rr       cmp DasDir
000388r 2  F0 10          beq @Held
00038Ar 2               
00038Ar 2  8D rr rr       sta DasDir                    ; A new direction: fire now, then wait
00038Dr 2  AE rr rr       ldx Region
000390r 2  BD rr rr       lda DasInitial,x
000393r 2  8D rr rr       sta DasTimer
000396r 2  AD rr rr       lda DasDir
000399r 2  60             rts
00039Ar 2               
00039Ar 2               @Held:
00039Ar 2  CE rr rr       dec DasTimer                  ; Always loaded non-zero, so this cannot wrap
00039Dr 2  D0 0D          bne @Wait
00039Fr 2  AE rr rr       ldx Region
0003A2r 2  BD rr rr       lda DasRepeat,x
0003A5r 2  8D rr rr       sta DasTimer
0003A8r 2  AD rr rr       lda DasDir
0003ABr 2  60             rts
0003ACr 2               
0003ACr 2               @Wait:
0003ACr 2  A9 00          lda #0
0003AEr 2  60             rts
0003AFr 2               
0003AFr 2               @None:
0003AFr 2  8D rr rr       sta DasDir                    ; A is already 0 — release, so the next press
0003B2r 2  60             rts                           ;   counts as fresh
0003B3r 2               
0003B3r 1               .include "../src/board.asm"
0003B3r 2               ; =============================================================================
0003B3r 2               ;   board.asm — Wizards Lab, the playfield
0003B3r 2               ; =============================================================================
0003B3r 2               ;   SPEC.md section 3. The board is 20 rows of 8 bytes, page-aligned, with
0003B3r 2               ;   columns 6-7 and rows 16-19 held permanently at $FF. Those sentinels are
0003B3r 2               ;   what let every scan in match.asm run without a bounds check.
0003B3r 2               ;
0003B3r 2               ;   address(row, col) = Board + (row << 3) + col
0003B3r 2               ; =============================================================================
0003B3r 2               
0003B3r 2               ; -----------------------------------------------------------------------------
0003B3r 2               ;   BoardClear — empty the playfield and lay the sentinels back down
0003B3r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X
0003B3r 2               ;
0003B3r 2               ;   Walls first over the whole 160 bytes, then the six playfield columns of
0003B3r 2               ;   the sixteen playfield rows punched back out to empty. Doing it in that
0003B3r 2               ;   order means the sentinels can never be forgotten: everything that is not
0003B3r 2               ;   explicitly playfield is a wall.
0003B3r 2               ;
0003B3r 2               ;   The wall loop counts UP and ends on a CPX. Counting down from 159 to a BPL
0003B3r 2               ;   looks tidier and is wrong: 159 is $9F, bit 7 already set, so the branch
0003B3r 2               ;   falls through after the first store and the other 159 bytes keep whatever
0003B3r 2               ;   the machine powered up with. That went unnoticed for a whole phase,
0003B3r 2               ;   because nothing read a sentinel until the falling piece needed a floor.
0003B3r 2               ; -----------------------------------------------------------------------------
0003B3r 2               BoardClear:
0003B3r 2  A9 FF          lda #TILE_WALL
0003B5r 2  A2 00          ldx #0
0003B7r 2               @Wall:
0003B7r 2  9D rr rr       sta Board,x
0003BAr 2  E8             inx
0003BBr 2  E0 A0          cpx #BOARD_BYTES
0003BDr 2  D0 F8          bne @Wall
0003BFr 2               
0003BFr 2  A2 00          ldx #0                        ; X walks the row bases, 0, 8, 16, ...
0003C1r 2               @Row:
0003C1r 2  A9 00          lda #TILE_EMPTY               ; Reloaded every row: the TXA below eats it
0003C3r 2  9D rr rr 9D    .repeat BOARD_W, COL
0003C7r 2  rr rr 9D rr  
0003CBr 2  rr 9D rr rr  
0003D5r 2                   sta Board + COL, x
0003D5r 2                 .endrepeat
0003D5r 2  8A             txa
0003D6r 2  18             clc
0003D7r 2  69 08          adc #BOARD_STRIDE
0003D9r 2  AA             tax
0003DAr 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
0003DCr 2  90 E3          bcc @Row
0003DEr 2  60             rts
0003DFr 2               
0003DFr 2               ; -----------------------------------------------------------------------------
0003DFr 2               ;   BoardRowPtr — point Ptr1 at the start of a board row
0003DFr 2               ;   In:  A = row        Out: Ptr1 = &Board[row][0].  Modifies: A, Ptr1
0003DFr 2               ;
0003DFr 2               ;   Board is page-aligned and 160 bytes, so row * 8 is at most 152 and the low
0003DFr 2               ;   byte can never carry into the high one.
0003DFr 2               ; -----------------------------------------------------------------------------
0003DFr 2               BoardRowPtr:
0003DFr 2  0A             asl a
0003E0r 2  0A             asl a
0003E1r 2  0A             asl a
0003E2r 2  18             clc
0003E3r 2  69 rr          adc #<Board
0003E5r 2  85 rr          sta Ptr1
0003E7r 2  A9 rr          lda #>Board
0003E9r 2  85 rr          sta Ptr1+1
0003EBr 2  60             rts
0003ECr 2               
0003ECr 2               ; -----------------------------------------------------------------------------
0003ECr 2               ;   BoardGravityBegin / BoardGravityStep — the pile falls, one row at a time
0003ECr 2               ;   SPEC 8 step 8, SPEC 14: tiles descend one row every FALL_FRAMES.
0003ECr 2               ;
0003ECr 2               ;   A row of falling is one pass over the board, bottom to top, moving every
0003ECr 2               ;   tile that has an empty cell under it down into it. Repeat until a pass
0003ECr 2               ;   moves nothing and the columns are compacted — but repeat it a row at a
0003ECr 2               ;   time, because the fall is animated and a column that dropped four rows in
0003ECr 2               ;   one frame would read as a teleport.
0003ECr 2               ;
0003ECr 2               ;   Walking BOTTOM TO TOP is what makes a whole column fall together rather
0003ECr 2               ;   than one tile a frame: by the time the pass reaches a tile, the tile below
0003ECr 2               ;   it has already moved and left the gap.
0003ECr 2               ;
0003ECr 2               ;   The pass is a CURSOR, not a loop that runs to completion (D12, SPEC 12.6).
0003ECr 2               ;   Sixty tiles falling is a hundred-odd changed cells and the dirty ring holds
0003ECr 2               ;   64, so the pass stops when the ring is full and picks up where it stopped
0003ECr 2               ;   next frame. Nothing is dropped and the board is a legal board at every
0003ECr 2               ;   point it stops — one frame's worth of columns has fallen a row and the
0003ECr 2               ;   rest has not, which is a stagger nobody can see.
0003ECr 2               ;
0003ECr 2               ;   The two sentinel columns need no special case: a wall's "cell below" is
0003ECr 2               ;   another wall, so columns 6 and 7 never move.
0003ECr 2               ; -----------------------------------------------------------------------------
0003ECr 2               GRAV_TOP = (BOARD_H - 1) * BOARD_STRIDE - 1     ; The last cell of row 14, the
0003ECr 2                                                               ;   lowest row that can fall at
0003ECr 2                                                               ;   all. Row 15 is on the floor
0003ECr 2               BoardGravityBegin:
0003ECr 2  A9 77          lda #GRAV_TOP
0003EEr 2  85 rr          sta GravIdx
0003F0r 2  A9 00          lda #0
0003F2r 2  85 rr          sta GravMoved
0003F4r 2  60             rts
0003F5r 2               
0003F5r 2               ; -----------------------------------------------------------------------------
0003F5r 2               ;   BoardGravityStep — carry on with the current row of falling
0003F5r 2               ;   In:  nothing
0003F5r 2               ;   Out: C set when the row is finished; GravMoved non-zero if it moved
0003F5r 2               ;        anything. Modifies: A, X, Y, GravIdx, GravMoved, RedrawCol
0003F5r 2               ; -----------------------------------------------------------------------------
0003F5r 2               BoardGravityStep:
0003F5r 2  A5 rr          lda GravIdx
0003F7r 2  30 3F          bmi @Finished                 ; $FF — the row is already done
0003F9r 2               
0003F9r 2               @Cell:
0003F9r 2  AD rr rr       lda DirtyCount                ; Room for both cells of a move, or wait for
0003FCr 2  C9 3E          cmp #(DIRTY_ENTRIES - 2)      ;   the flush. A mark dropped here would never
0003FEr 2  B0 3A          bcs @Later                    ;   be marked again (D6 is survivable only
000400r 2                                               ;   because nothing that MUST land uses it)
000400r 2               
000400r 2  A6 rr          ldx GravIdx
000402r 2  BD rr rr       lda Board,x
000405r 2  F0 2D          beq @Next                     ; Nothing here to fall
000407r 2  BD rr rr       lda Board + BOARD_STRIDE,x
00040Ar 2  D0 28          bne @Next                     ; Something under it — a tile, or the floor
00040Cr 2               
00040Cr 2  BD rr rr       lda Board,x                   ; Move it down one row
00040Fr 2  9D rr rr       sta Board + BOARD_STRIDE,x
000412r 2  A9 00          lda #TILE_EMPTY
000414r 2  9D rr rr       sta Board,x
000417r 2  E6 rr          inc GravMoved
000419r 2               
000419r 2  A5 rr          lda GravIdx                   ; The cell it LEFT only needs redrawing if it
00041Br 2  C9 08          cmp #BOARD_STRIDE             ;   is going to stay empty. If there is a tile
00041Dr 2  90 07          bcc @Vacated                  ;   above it, that tile lands here later in
00041Fr 2  A6 rr          ldx GravIdx                   ;   this same pass and its own arrival mark
000421r 2  BD rr rr       lda Board - BOARD_STRIDE,x    ;   covers the cell. Half the marks of a
000424r 2  D0 05          bne @Arrived                  ;   sliding column, which is what the ring
000426r 2               @Vacated:                       ;   pressure is made of.
000426r 2  A6 rr          ldx GravIdx
000428r 2  20 rr rr       jsr RenderCell
00042Br 2               @Arrived:
00042Br 2  A5 rr          lda GravIdx
00042Dr 2  18             clc
00042Er 2  69 08          adc #BOARD_STRIDE
000430r 2  AA             tax
000431r 2  20 rr rr       jsr RenderCell
000434r 2               
000434r 2               @Next:
000434r 2  C6 rr          dec GravIdx                   ; Down to 0, then $FF, which ends the pass —
000436r 2  10 C1          bpl @Cell                     ;   GRAV_TOP is 119, so bit 7 starts clear
000438r 2                                               ;   (see PLAN.md section 3)
000438r 2               @Finished:
000438r 2  38             sec
000439r 2  60             rts
00043Ar 2               
00043Ar 2               @Later:
00043Ar 2  18             clc                           ; Ring full: the rest of this row waits a frame
00043Br 2  60             rts
00043Cr 2               
00043Cr 1               .include "../src/piece.asm"
00043Cr 2               ; =============================================================================
00043Cr 2               ;   piece.asm — Wizards Lab, the falling piece
00043Cr 2               ; =============================================================================
00043Cr 2               ;   SPEC.md section 5. A piece is three independently generated cells stacked
00043Cr 2               ;   vertically, A on top. At most one of the three carries a reagent, which is
00043Cr 2               ;   enforced by rolling once for the piece rather than once per cell.
00043Cr 2               ;
00043Cr 2               ;   The piece is NOT in the board while it falls. Board cells under it stay
00043Cr 2               ;   empty until PieceLock writes them, which is what makes the movement tests
00043Cr 2               ;   below a plain read of the three target cells and what lets the erase be
00043Cr 2               ;   three blanks rather than three board reads.
00043Cr 2               ;
00043Cr 2               ;   Nothing here draws. Every routine that changes where the piece is or what
00043Cr 2               ;   it holds sets PieceDirty and lets StatePlay pick the moment (D14).
00043Cr 2               ; =============================================================================
00043Cr 2               
00043Cr 2               ; -----------------------------------------------------------------------------
00043Cr 2               ;   PieceIndex — board index of the piece's top cell
00043Cr 2               ;   In:  nothing
00043Cr 2               ;   Out: A = X = PieceRow * BOARD_STRIDE + PieceCol.  Modifies: A, X
00043Cr 2               ;
00043Cr 2               ;   Cells B and C are one and two strides on from it, and the cell below C is
00043Cr 2               ;   three — which is the only address arithmetic the rest of this file needs.
00043Cr 2               ;   Row 16 and beyond is a wall row, so "below C" is always a legal read.
00043Cr 2               ; -----------------------------------------------------------------------------
00043Cr 2               PieceIndex:
00043Cr 2  AD rr rr       lda PieceRow
00043Fr 2  0A             asl a
000440r 2  0A             asl a
000441r 2  0A             asl a                         ; row * 8
000442r 2  18             clc
000443r 2  6D rr rr       adc PieceCol
000446r 2  AA             tax
000447r 2  60             rts
000448r 2               
000448r 2               ; -----------------------------------------------------------------------------
000448r 2               ;   PieceGenerateNext — roll the preview piece into NextA/NextB/NextC
000448r 2               ;   In:  nothing (reads Level)
000448r 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0, Tmp1
000448r 2               ;   SPEC 5.2, 5.3 — colours uniform over 0-5, then one reagent roll.
000448r 2               ; -----------------------------------------------------------------------------
000448r 2               PieceGenerateNext:
000448r 2  A0 00          ldy #0                        ; RngRange preserves Y, so it can index the
00044Ar 2               @Color:                         ;   three cells across the call
00044Ar 2  A9 06          lda #NUM_COLORS
00044Cr 2  20 rr rr       jsr RngRange                  ; 0-5, uniform (SPEC 5.2)
00044Fr 2  0A             asl a
000450r 2  0A             asl a
000451r 2  0A             asl a                         ; colour << 3 ...
000452r 2  18             clc
000453r 2  69 40          adc #COLOR_BASE               ;   ... + base, glyph 0, so it is a potion
000455r 2  99 rr rr       sta NextA,y                   ; NextA/B/C are three consecutive bytes
000458r 2  C8             iny
000459r 2  C0 03          cpy #3
00045Br 2  90 ED          bcc @Color
00045Dr 2               
00045Dr 2                 ; --- does this piece carry a reagent at all? (SPEC 5.3) -------------------
00045Dr 2                 ;   One roll for the whole piece, which both caps it at one reagent and
00045Dr 2                 ;   costs three rolls fewer than asking each cell.
00045Dr 2  20 rr rr       jsr RngNext
000460r 2  85 rr          sta Tmp0                      ; The roll. Nothing below calls out until it
000462r 2                                               ;   has been compared, so Tmp0 is safe.
000462r 2  AE rr rr       ldx Level
000465r 2  CA             dex                           ; LevelBand is indexed by level - 1 ...
000466r 2  E0 10          cpx #16
000468r 2  90 02          bcc @Band
00046Ar 2  A2 0F          ldx #15                       ;   ... and clamped: band 4 is "13 and up"
00046Cr 2               @Band:
00046Cr 2  BD rr rr       lda LevelBand,x
00046Fr 2  AA             tax                           ; X = band 0-4
000470r 2  A5 rr          lda Tmp0
000472r 2  DD rr rr       cmp PSpecial,x                ; C clear = the roll came in under the chance
000475r 2  B0 2E          bcs @Done
000477r 2               
000477r 2                 ; --- which cell, and which reagent ----------------------------------------
000477r 2  8A             txa
000478r 2  48             pha                           ; The band, across the cell roll
000479r 2  A9 03          lda #3
00047Br 2  20 rr rr       jsr RngRange                  ; 0, 1 or 2 — uniform over A, B and C
00047Er 2  A8             tay                           ; Y survives the type roll below
00047Fr 2  68             pla
000480r 2  0A             asl a
000481r 2  0A             asl a                         ; band * 4 — ReagentThresholds is four
000482r 2  48             pha                           ;   thresholds per band
000483r 2  20 rr rr       jsr RngNext
000486r 2  85 rr          sta Tmp0                      ; The type roll
000488r 2  68             pla
000489r 2  AA             tax
00048Ar 2  A5 rr          lda Tmp0
00048Cr 2               
00048Cr 2  DD rr rr       cmp ReagentThresholds+0,x     ; The cumulative-weight compare chain SPEC 5.3
00048Fr 2  90 15          bcc @Fireball                 ;   recommends over a 1280-byte lookup
000491r 2  DD rr rr       cmp ReagentThresholds+1,x
000494r 2  90 14          bcc @Bolt
000496r 2  DD rr rr       cmp ReagentThresholds+2,x
000499r 2  90 13          bcc @Bomb
00049Br 2  DD rr rr       cmp ReagentThresholds+3,x
00049Er 2  90 12          bcc @Star
0004A0r 2               
0004A0r 2  A9 70          lda #WILD_BASE                ; A Prism discards the colour it rolled and
0004A2r 2  99 rr rr       sta NextA,y                   ;   joins group 14 (SPEC 5.2)
0004A5r 2               @Done:
0004A5r 2  60             rts
0004A6r 2               
0004A6r 2               @Fireball:
0004A6r 2  A9 01          lda #GLYPH_FIREBALL
0004A8r 2  D0 0A          bne @Apply                    ; Always — every glyph below is non-zero
0004AAr 2               @Bolt:
0004AAr 2  A9 02          lda #GLYPH_BOLT
0004ACr 2  D0 06          bne @Apply
0004AEr 2               @Bomb:
0004AEr 2  A9 03          lda #GLYPH_BOMB
0004B0r 2  D0 02          bne @Apply
0004B2r 2               @Star:
0004B2r 2  A9 04          lda #GLYPH_STAR
0004B4r 2               @Apply:
0004B4r 2  19 rr rr       ora NextA,y                   ; The cell's glyph nibble is 0, so an ORA sets
0004B7r 2  99 rr rr       sta NextA,y                   ;   the reagent and keeps the rolled colour
0004BAr 2  60             rts
0004BBr 2               
0004BBr 2               ; -----------------------------------------------------------------------------
0004BBr 2               ;   PieceSpawn — promote the preview to the falling piece
0004BBr 2               ;   In:  nothing
0004BBr 2               ;   Out: C set if the spawn cells were occupied (game over)
0004BBr 2               ;        Modifies: A, X
0004BBr 2               ;   SPEC 5.4 — spawn column SPAWN_COL, rows 0-2, visible immediately.
0004BBr 2               ;
0004BBr 2               ;   The preview is copied whether or not the spawn succeeds; on a blocked
0004BBr 2               ;   spawn nothing looks at the piece again.
0004BBr 2               ; -----------------------------------------------------------------------------
0004BBr 2               PieceSpawn:
0004BBr 2  AD rr rr       lda NextA
0004BEr 2  8D rr rr       sta PieceA
0004C1r 2  AD rr rr       lda NextB
0004C4r 2  8D rr rr       sta PieceB
0004C7r 2  AD rr rr       lda NextC
0004CAr 2  8D rr rr       sta PieceC
0004CDr 2               
0004CDr 2  A9 02          lda #SPAWN_COL
0004CFr 2  8D rr rr       sta PieceCol
0004D2r 2  A9 00          lda #0
0004D4r 2  8D rr rr       sta PieceRow
0004D7r 2  8D rr rr       sta LockTimer
0004DAr 2  8D rr rr       sta LockResets                ; The reset allowance is per piece (SPEC 5.6)
0004DDr 2               
0004DDr 2  AD rr rr       lda Board + 0 * BOARD_STRIDE + SPAWN_COL
0004E0r 2  0D rr rr       ora Board + 1 * BOARD_STRIDE + SPAWN_COL
0004E3r 2  0D rr rr       ora Board + 2 * BOARD_STRIDE + SPAWN_COL
0004E6r 2  D0 0D          bne @Blocked
0004E8r 2               
0004E8r 2  20 rr rr       jsr ScoreGravity
0004EBr 2  8D rr rr       sta GravityTimer
0004EEr 2  A9 01          lda #1
0004F0r 2  8D rr rr       sta PieceDirty                ; Drawn immediately — there is no off-screen
0004F3r 2  18             clc                           ;   entry (SPEC 5.4)
0004F4r 2  60             rts
0004F5r 2               
0004F5r 2               @Blocked:
0004F5r 2  38             sec
0004F6r 2  60             rts
0004F7r 2               
0004F7r 2               ; -----------------------------------------------------------------------------
0004F7r 2               ;   PieceMoveLeft / PieceMoveRight — one column, if all three cells are free
0004F7r 2               ;   Out: C set if the move happened (the caller resets the lock timer).
0004F7r 2               ;        Modifies: A, X
0004F7r 2               ;   SPEC 5.5 — no wall kicks; a 1-wide piece has nothing to kick off.
0004F7r 2               ;
0004F7r 2               ;   The right edge needs no bounds check: column 6 is a permanent $FF sentinel
0004F7r 2               ;   and fails the emptiness test on its own (SPEC 3.2). The LEFT edge does,
0004F7r 2               ;   because column -1 of row 0 is the byte before a page-aligned Board and
0004F7r 2               ;   belongs to nobody.
0004F7r 2               ; -----------------------------------------------------------------------------
0004F7r 2               PieceMoveLeft:
0004F7r 2  AD rr rr       lda PieceCol
0004FAr 2  F0 18          beq @No                       ; Column 0 — there is no sentinel to the left
0004FCr 2  20 rr rr       jsr PieceIndex
0004FFr 2  CA             dex
000500r 2  BD rr rr       lda Board + 0 * BOARD_STRIDE,x
000503r 2  1D rr rr       ora Board + 1 * BOARD_STRIDE,x
000506r 2  1D rr rr       ora Board + 2 * BOARD_STRIDE,x
000509r 2  D0 09          bne @No
00050Br 2  20 rr rr       jsr RenderPieceErase
00050Er 2  CE rr rr       dec PieceCol
000511r 2  4C rr rr       jmp PieceMoved
000514r 2               
000514r 2               @No:
000514r 2  18             clc
000515r 2  60             rts
000516r 2               
000516r 2               PieceMoveRight:
000516r 2  20 rr rr       jsr PieceIndex
000519r 2  E8             inx
00051Ar 2  BD rr rr       lda Board + 0 * BOARD_STRIDE,x
00051Dr 2  1D rr rr       ora Board + 1 * BOARD_STRIDE,x
000520r 2  1D rr rr       ora Board + 2 * BOARD_STRIDE,x
000523r 2  D0 09          bne @No
000525r 2  20 rr rr       jsr RenderPieceErase
000528r 2  EE rr rr       inc PieceCol
00052Br 2  4C rr rr       jmp PieceMoved
00052Er 2               @No:
00052Er 2  18             clc
00052Fr 2  60             rts
000530r 2               
000530r 2               ; -----------------------------------------------------------------------------
000530r 2               ;   PieceMoved — mark the piece for redraw and report success
000530r 2               ;   Out: C set.  Modifies: A
000530r 2               ; -----------------------------------------------------------------------------
000530r 2               PieceMoved:
000530r 2  A9 01          lda #1
000532r 2  8D rr rr       sta PieceDirty
000535r 2  38             sec
000536r 2  60             rts
000537r 2               
000537r 2               ; -----------------------------------------------------------------------------
000537r 2               ;   PieceRotate / PieceRotateBack — cycle the three cells
000537r 2               ;   Out: nothing.  Modifies: A, X
000537r 2               ;   SPEC 5.5 — (A,B,C) -> (B,C,A) forward, (C,A,B) back. Always succeeds: the
000537r 2               ;   footprint never changes, so there is nothing to test and nothing to erase.
000537r 2               ;   Rotation does not reset the lock delay (SPEC 5.6).
000537r 2               ; -----------------------------------------------------------------------------
000537r 2               PieceRotate:
000537r 2  AD rr rr       lda PieceA
00053Ar 2  AE rr rr       ldx PieceB
00053Dr 2  8E rr rr       stx PieceA
000540r 2  AE rr rr       ldx PieceC
000543r 2  8E rr rr       stx PieceB
000546r 2  8D rr rr       sta PieceC
000549r 2  A9 01          lda #1
00054Br 2  8D rr rr       sta PieceDirty
00054Er 2  60             rts
00054Fr 2               
00054Fr 2               PieceRotateBack:
00054Fr 2  AD rr rr       lda PieceC
000552r 2  AE rr rr       ldx PieceB
000555r 2  8E rr rr       stx PieceC
000558r 2  AE rr rr       ldx PieceA
00055Br 2  8E rr rr       stx PieceB
00055Er 2  8D rr rr       sta PieceA
000561r 2  A9 01          lda #1
000563r 2  8D rr rr       sta PieceDirty
000566r 2  60             rts
000567r 2               
000567r 2               ; -----------------------------------------------------------------------------
000567r 2               ;   PieceCanFall — is the cell below C free?
000567r 2               ;   Out: C set if the piece can descend one row.  Modifies: A, X
000567r 2               ;   Three strides past cell A. With C on row 15 that reads row 18, which is a
000567r 2               ;   permanent wall row, so the floor needs no special case (SPEC 3.2).
000567r 2               ; -----------------------------------------------------------------------------
000567r 2               PieceCanFall:
000567r 2  20 rr rr       jsr PieceIndex
00056Ar 2  BD rr rr       lda Board + 3 * BOARD_STRIDE,x
00056Dr 2  D0 02          bne @No
00056Fr 2  38             sec
000570r 2  60             rts
000571r 2               @No:
000571r 2  18             clc
000572r 2  60             rts
000573r 2               
000573r 2               ; -----------------------------------------------------------------------------
000573r 2               ;   PieceStep — one row of gravity
000573r 2               ;   Out: C set if the piece has landed and the lock delay should start.
000573r 2               ;        Modifies: A, X
000573r 2               ; -----------------------------------------------------------------------------
000573r 2               PieceStep:
000573r 2  20 rr rr       jsr PieceCanFall
000576r 2  90 0B          bcc @Landed
000578r 2  20 rr rr       jsr RenderPieceErase
00057Br 2  EE rr rr       inc PieceRow
00057Er 2  20 rr rr       jsr PieceMoved
000581r 2  18             clc                           ; Moved, so it has not landed
000582r 2  60             rts
000583r 2               @Landed:
000583r 2  38             sec
000584r 2  60             rts
000585r 2               
000585r 2               ; -----------------------------------------------------------------------------
000585r 2               ;   PieceLock — write the three cells into the board
000585r 2               ;   Out: nothing.  Modifies: A, X, Y
000585r 2               ;   SPEC 5.6 — after this the caller runs a cascade.
000585r 2               ;
000585r 2               ;   Once the board holds the piece, drawing the piece and drawing those three
000585r 2               ;   board cells are the same three writes, so RenderPiece does the queueing.
000585r 2               ; -----------------------------------------------------------------------------
000585r 2               PieceLock:
000585r 2  20 rr rr       jsr PieceIndex
000588r 2  AD rr rr       lda PieceA
00058Br 2  9D rr rr       sta Board + 0 * BOARD_STRIDE,x
00058Er 2  AD rr rr       lda PieceB
000591r 2  9D rr rr       sta Board + 1 * BOARD_STRIDE,x
000594r 2  AD rr rr       lda PieceC
000597r 2  9D rr rr       sta Board + 2 * BOARD_STRIDE,x
00059Ar 2               
00059Ar 2  20 rr rr       jsr RenderPiece
00059Dr 2  A9 00          lda #0
00059Fr 2  8D rr rr       sta PieceDirty                ; It is board now; nothing owes it a redraw
0005A2r 2  60             rts
0005A3r 2               
0005A3r 2               ; -----------------------------------------------------------------------------
0005A3r 2               ;   PieceFallRate — frames per row for this frame
0005A3r 2               ;   Out: A = frame count, C CLEAR if that rate is the soft drop's.
0005A3r 2               ;        Modifies: A, X, Tmp0
0005A3r 2               ;   SPEC 5.5, 11.3 — soft drop substitutes its own rate and is ignored when
0005A3r 2               ;   gravity is already the faster of the two (levels 14+ on NTSC).
0005A3r 2               ;
0005A3r 2               ;   The carry is what pays for the soft drop: SPEC 9.6 gives a point per row
0005A3r 2               ;   "descended under soft drop", and a row that fell at gravity's rate with
0005A3r 2               ;   DOWN held down was not one, so holding DOWN at level 16 earns nothing.
0005A3r 2               ;   Working it out here costs nothing — the comparison has already happened.
0005A3r 2               ; -----------------------------------------------------------------------------
0005A3r 2               PieceFallRate:
0005A3r 2  20 rr rr       jsr ScoreGravity              ; Speed[level] for this region
0005A6r 2  85 rr          sta Tmp0
0005A8r 2  AD rr rr       lda InputNow
0005ABr 2  29 02          and #INPUT_DOWN
0005ADr 2  F0 0A          beq @Gravity
0005AFr 2  AE rr rr       ldx Region
0005B2r 2  BD rr rr       lda SoftDropRate,x
0005B5r 2  C5 rr          cmp Tmp0                      ; C clear = soft drop is the faster
0005B7r 2  90 04          bcc @Soft
0005B9r 2               @Gravity:
0005B9r 2  A5 rr          lda Tmp0
0005BBr 2  38             sec
0005BCr 2  60             rts
0005BDr 2               @Soft:
0005BDr 2  18             clc
0005BEr 2  60             rts
0005BFr 2               
0005BFr 2               ; -----------------------------------------------------------------------------
0005BFr 2               ;   PieceControl — apply this frame's input to the piece
0005BFr 2               ;   Out: C set if a horizontal move succeeded (the caller may reset the lock
0005BFr 2               ;        delay).  Modifies: A, X, Y
0005BFr 2               ;
0005BFr 2               ;   Rotation is edge triggered and never repeats: UP has to be released and
0005BFr 2               ;   pressed again. SPEC 11.3 calls that non-negotiable and it is — a
0005BFr 2               ;   repeating rotate makes a three-cell piece impossible to aim. Left and
0005BFr 2               ;   right go through InputShift, which is where the repeat lives.
0005BFr 2               ; -----------------------------------------------------------------------------
0005BFr 2               PieceControl:
0005BFr 2  AD rr rr       lda InputEdge
0005C2r 2  29 01          and #INPUT_UP
0005C4r 2  F0 03          beq @NoRotate
0005C6r 2  20 rr rr       jsr PieceRotate
0005C9r 2               @NoRotate:
0005C9r 2  AD rr rr       lda InputEdge
0005CCr 2  29 10          and #INPUT_FIRE
0005CEr 2  F0 03          beq @NoBack
0005D0r 2  20 rr rr       jsr PieceRotateBack
0005D3r 2               @NoBack:
0005D3r 2  20 rr rr       jsr InputShift
0005D6r 2  C9 04          cmp #INPUT_LEFT
0005D8r 2  F0 06          beq @Left
0005DAr 2  C9 08          cmp #INPUT_RIGHT
0005DCr 2  F0 05          beq @Right
0005DEr 2  18             clc
0005DFr 2  60             rts
0005E0r 2               @Left:
0005E0r 2  4C rr rr       jmp PieceMoveLeft
0005E3r 2               @Right:
0005E3r 2  4C rr rr       jmp PieceMoveRight
0005E6r 2               
0005E6r 1               .include "../src/match.asm"
0005E6r 2               ; =============================================================================
0005E6r 2               ;   match.asm — Wizards Lab, the match scanner
0005E6r 2               ; =============================================================================
0005E6r 2               ;   SPEC.md section 6. Four passes — horizontal, vertical, and both diagonals —
0005E6r 2               ;   each walking its axis and tracking a run colour and length. A run of three
0005E6r 2               ;   or more sets the MARK bit for each of its cells.
0005E6r 2               ;
0005E6r 2               ;   Colour comparison is the whole trick:
0005E6r 2               ;
0005E6r 2               ;       lda cell
0005E6r 2               ;       and #COLOR_MASK         ; the low three bits are the glyph, ignore them
0005E6r 2               ;       cmp ScanColor
0005E6r 2               ;
0005E6r 2               ;   which is why a red potion, a red fireball and a red star all match. The
0005E6r 2               ;   glyph decides what happens on removal, never whether cells match.
0005E6r 2               ;
0005E6r 2               ;   Wildcards (SPEC 6.3): a WILD cell continues any run. If the run has no
0005E6r 2               ;   colour yet it stays unset and is adopted from the first non-wild cell, so
0005E6r 2               ;   one prism can close a red horizontal run and a blue vertical run at once.
0005E6r 2               ;
0005E6r 2               ;   THE FOUR PASSES ARE ONE LOOP. A line is a start cell and a step, and the
0005E6r 2               ;   step is the only thing that differs: +1 across, +8 down, +9 down-right,
0005E6r 2               ;   +7 down-left. Every one of them ends on a sentinel rather than on a bounds
0005E6r 2               ;   check, which is what the 8-byte stride was bought for (SPEC 3.2):
0005E6r 2               ;
0005E6r 2               ;     across   from column 5, +1 lands on column 6      — wall
0005E6r 2               ;     down     from row 15,   +8 lands on row 16        — wall row
0005E6r 2               ;     down-r   from column 5, +9 lands on row+1 col 6   — wall
0005E6r 2               ;     down-l   from column 0, +7 lands on THIS row's column 7 — wall
0005E6r 2               ;
0005E6r 2               ;   The last one is the reason the left edge needs no test either: the byte
0005E6r 2               ;   before column 0 belongs to the row above, and it is already a wall.
0005E6r 2               ; =============================================================================
0005E6r 2               
0005E6r 2               ; -----------------------------------------------------------------------------
0005E6r 2               ;   MatchScan — find every run on the board
0005E6r 2               ;   In:  nothing
0005E6r 2               ;   Out: Marks filled, RunCount set, Z set if nothing matched.
0005E6r 2               ;        Modifies: A, X, Y, Scan*
0005E6r 2               ; -----------------------------------------------------------------------------
0005E6r 2               MatchScan:
0005E6r 2  20 rr rr       jsr MarksClear
0005E9r 2  A9 00          lda #0
0005EBr 2  8D rr rr       sta RunCount
0005EEr 2               
0005EEr 2  20 rr rr       jsr ScanFindTop               ; Everything below skips the empty air above
0005F1r 2  A5 rr          lda ScanTop                   ;   the pile, which on most boards is most of
0005F3r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE) ;   the board
0005F5r 2  B0 0C          bcs @Done                     ; Nothing on the board at all
0005F7r 2               
0005F7r 2  20 rr rr       jsr MatchScanHorizontal
0005FAr 2  20 rr rr       jsr MatchScanVertical
0005FDr 2  20 rr rr       jsr MatchScanDiagonal
000600r 2  20 rr rr       jsr MatchScanAntiDiagonal
000603r 2               @Done:
000603r 2  AD rr rr       lda RunCount                  ; Z set when nothing matched
000606r 2  60             rts
000607r 2               
000607r 2               ; -----------------------------------------------------------------------------
000607r 2               ;   ScanFindTop — board index of the first row that holds anything
000607r 2               ;   Out: ScanTop = row base, or BOARD_H * BOARD_STRIDE if the board is empty.
000607r 2               ;        Modifies: A, X, ScanTop
000607r 2               ;
000607r 2               ;   Every pass below starts here instead of at row 0. A pile six rows deep is
000607r 2               ;   scanned as six rows: 178 cells against 448, and the four passes come in
000607r 2               ;   under a third of the frame instead of over two whole ones. Finding it costs
000607r 2               ;   about 45 cycles a row of empty air, which is the cheapest part of the scan.
000607r 2               ;
000607r 2               ;   Correct as well as quick, and for a reason worth writing down: a line that
000607r 2               ;   reaches the pile at all must CROSS the pile's top row, because every one of
000607r 2               ;   the four steps moves down at most one row at a time. Starting the diagonals
000607r 2               ;   on that row rather than on row 0 therefore misses nothing.
000607r 2               ; -----------------------------------------------------------------------------
000607r 2               ScanFindTop:
000607r 2  A2 00          ldx #0
000609r 2               @Row:
000609r 2  BD rr rr       lda Board + 0,x               ; The six playfield columns; the two sentinel
00060Cr 2  1D rr rr       ora Board + 1,x               ;   ones would make every row look occupied
00060Fr 2  1D rr rr       ora Board + 2,x
000612r 2  1D rr rr       ora Board + 3,x
000615r 2  1D rr rr       ora Board + 4,x
000618r 2  1D rr rr       ora Board + 5,x
00061Br 2  D0 09          bne @Found
00061Dr 2  8A             txa
00061Er 2  18             clc
00061Fr 2  69 08          adc #BOARD_STRIDE
000621r 2  AA             tax
000622r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
000624r 2  90 E3          bcc @Row
000626r 2               @Found:
000626r 2  86 rr          stx ScanTop
000628r 2  60             rts
000629r 2               
000629r 2               ; -----------------------------------------------------------------------------
000629r 2               ;   The four passes (SPEC 6.2). Each sets a step and hands ScanLine its start
000629r 2               ;   cells; the start cell rides the stack because ScanLine needs both index
000629r 2               ;   registers and the scratch bytes below it.
000629r 2               ; -----------------------------------------------------------------------------
000629r 2               MatchScanHorizontal:            ; Every row of the pile, column 0 rightward
000629r 2  A9 01          lda #1
00062Br 2  85 rr          sta ScanStep
00062Dr 2  A5 rr          lda ScanTop
00062Fr 2               @Line:
00062Fr 2  48             pha
000630r 2  20 rr rr       jsr ScanLine
000633r 2  68             pla
000634r 2  18             clc
000635r 2  69 08          adc #BOARD_STRIDE
000637r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000639r 2  90 F4          bcc @Line
00063Br 2  60             rts
00063Cr 2               
00063Cr 2               MatchScanVertical:              ; 6 columns, top of the pile downward
00063Cr 2  A9 08          lda #BOARD_STRIDE
00063Er 2  85 rr          sta ScanStep
000640r 2  4C rr rr       jmp ScanTopRow
000643r 2               
000643r 2               MatchScanDiagonal:              ; down-right: the top row, then the left edge
000643r 2  A9 09          lda #(BOARD_STRIDE + 1)
000645r 2  85 rr          sta ScanStep
000647r 2  20 rr rr       jsr ScanTopRow
00064Ar 2  A9 00          lda #0
00064Cr 2  4C rr rr       jmp ScanEdgeColumn
00064Fr 2               
00064Fr 2               MatchScanAntiDiagonal:          ; down-left: the top row, then the right edge
00064Fr 2  A9 07          lda #(BOARD_STRIDE - 1)
000651r 2  85 rr          sta ScanStep
000653r 2  20 rr rr       jsr ScanTopRow
000656r 2  A9 05          lda #(BOARD_W - 1)
000658r 2  4C rr rr       jmp ScanEdgeColumn
00065Br 2               
00065Br 2               ; -----------------------------------------------------------------------------
00065Br 2               ;   ScanTopRow — scan a line from each of the six cells of the pile's top row
00065Br 2               ;   ScanEdgeColumn — and from the rows below it, in the column in A
00065Br 2               ;   In:  ScanStep set, ScanTop set; A = column (ScanEdgeColumn only)
00065Br 2               ;
00065Br 2               ;   Between them those are every start cell a diagonal needs, and the top row
00065Br 2               ;   alone is every start cell the vertical pass needs. The top row is scanned
00065Br 2               ;   by the first, so the second skips it rather than scanning the longest
00065Br 2               ;   diagonal twice.
00065Br 2               ; -----------------------------------------------------------------------------
00065Br 2               ScanTopRow:
00065Br 2  A5 rr          lda ScanTop
00065Dr 2               @Line:
00065Dr 2  48             pha
00065Er 2  20 rr rr       jsr ScanLine
000661r 2  68             pla
000662r 2  18             clc
000663r 2  69 01          adc #1
000665r 2  48             pha                           ; Six columns of that row, whichever row it
000666r 2  29 07          and #(BOARD_STRIDE - 1)       ;   is, so it is the COLUMN that ends the loop
000668r 2  C9 06          cmp #BOARD_W                  ;   and not the index
00066Ar 2  68             pla                           ; PLA leaves C alone
00066Br 2  90 F0          bcc @Line
00066Dr 2  60             rts
00066Er 2               
00066Er 2               ScanEdgeColumn:
00066Er 2  18             clc
00066Fr 2  65 rr          adc ScanTop                   ; That column, on the pile's top row...
000671r 2  18             clc
000672r 2  69 08          adc #BOARD_STRIDE             ;   ...and then the row below it
000674r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000676r 2  B0 0C          bcs @Done                     ; The pile is one row deep — there is no below
000678r 2               @Line:
000678r 2  48             pha
000679r 2  20 rr rr       jsr ScanLine
00067Cr 2  68             pla
00067Dr 2  18             clc
00067Er 2  69 08          adc #BOARD_STRIDE
000680r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000682r 2  90 F4          bcc @Line
000684r 2               @Done:
000684r 2  60             rts
000685r 2               
000685r 2               ; -----------------------------------------------------------------------------
000685r 2               ;   ScanLine — walk one line, marking every run of MATCH_MIN or more
000685r 2               ;   In:  A = start board index, ScanStep = direction
000685r 2               ;   Out: nothing.  Modifies: A, X, Scan*, Marks, RunCount
000685r 2               ;
000685r 2               ;   ONLY A WALL ENDS THE LINE. A hole in the middle of a row breaks the run
000685r 2               ;   and the walk carries on past it, because the cells beyond it are a run of
000685r 2               ;   their own — a line that stopped at the first empty cell would never look
000685r 2               ;   below the top of the pile at all, which is very nearly the whole board.
000685r 2               ;
000685r 2               ;   A colour change ends the run and starts a new one at the cell that broke
000685r 2               ;   it — the cell that broke a red run is the first cell of the blue one, and
000685r 2               ;   any prisms that were riding the red run stay with the red run. SPEC 6.3
000685r 2               ;   gives a wildcard to the run it is already in, not to both.
000685r 2               ; -----------------------------------------------------------------------------
000685r 2               ScanLine:
000685r 2  AA             tax                           ; The cursor lives in X for the whole line:
000686r 2  A9 FF          lda #$FF                      ;   this loop runs about four hundred times a
000688r 2  85 rr          sta ScanColor                 ;   scan and every cycle in it is four hundred
00068Ar 2  A9 00          lda #0                        ;   cycles of the frame
00068Cr 2  85 rr          sta ScanLen
00068Er 2               
00068Er 2               @Cell:
00068Er 2  BD rr rr       lda Board,x
000691r 2  F0 41          beq @Gap                      ; A hole breaks the run, not the line
000693r 2  C9 FF          cmp #TILE_WALL
000695r 2  F0 52          beq @End                      ; A wall is where the line stops
000697r 2  29 F8          and #COLOR_MASK               ; The colour key, glyph discarded (SPEC 4.2)
000699r 2  C5 rr          cmp ScanColor
00069Br 2  F0 19          beq @Grow                     ; Same colour — the commonest case, first
00069Dr 2  C9 70          cmp #WILD_BASE
00069Fr 2  F0 15          beq @Grow                     ; A prism continues any run (SPEC 6.3)
0006A1r 2               
0006A1r 2  A8             tay                           ; A different colour. Park it: everything
0006A2r 2  A5 rr          lda ScanColor                 ;   below either adopts it or starts a run
0006A4r 2  30 0E          bmi @Adopt                    ;   with it. $FF is the only value here with
0006A6r 2                                               ;   bit 7 set — colours are $40 to $70
0006A6r 2  A5 rr          lda ScanLen
0006A8r 2  C9 03          cmp #MATCH_MIN
0006AAr 2  B0 14          bcs @Close                    ; The run it broke was long enough to mark
0006ACr 2               
0006ACr 2  84 rr          sty ScanColor                 ; It was not, so no call and no marking: this
0006AEr 2  A9 01          lda #1                        ;   cell is simply the start of the next run.
0006B0r 2  85 rr          sta ScanLen                   ;   Five adjacent cells in six differ in
0006B2r 2  D0 04          bne @Advance                  ;   colour, so this is the path that decides
0006B4r 2                                               ;   what a scan costs
0006B4r 2               @Adopt:
0006B4r 2  84 rr          sty ScanColor
0006B6r 2               @Grow:
0006B6r 2  E6 rr          inc ScanLen
0006B8r 2               @Advance:
0006B8r 2  8A             txa
0006B9r 2  18             clc
0006BAr 2  65 rr          adc ScanStep
0006BCr 2  AA             tax
0006BDr 2  4C rr rr       jmp @Cell
0006C0r 2               
0006C0r 2               @Close:
0006C0r 2  86 rr          stx ScanIdx
0006C2r 2  20 rr rr       jsr MatchEmit                 ; Mark it — and MatchEmit leaves ScanLen zero
0006C5r 2  A6 rr          ldx ScanIdx
0006C7r 2  BD rr rr       lda Board,x
0006CAr 2  29 F8          and #COLOR_MASK
0006CCr 2  85 rr          sta ScanColor
0006CEr 2  A9 01          lda #1
0006D0r 2  85 rr          sta ScanLen
0006D2r 2  D0 E4          bne @Advance                  ; Always
0006D4r 2               
0006D4r 2               @Gap:
0006D4r 2  A5 rr          lda ScanLen
0006D6r 2  F0 E0          beq @Advance                  ; Nothing running — step over the hole. This
0006D8r 2                                               ;   is the cell the scan meets most often, so
0006D8r 2                                               ;   it is the one that must not call anything
0006D8r 2  86 rr          stx ScanIdx
0006DAr 2  20 rr rr       jsr MatchEmit                 ; Close the run the hole broke...
0006DDr 2  A6 rr          ldx ScanIdx
0006DFr 2  A9 FF          lda #$FF
0006E1r 2  85 rr          sta ScanColor                 ;   ...and start again on the far side of it
0006E3r 2  A9 00          lda #0
0006E5r 2  85 rr          sta ScanLen
0006E7r 2  F0 CF          beq @Advance                  ; Always
0006E9r 2               
0006E9r 2               @End:
0006E9r 2  A5 rr          lda ScanLen
0006EBr 2  F0 05          beq @Nothing                  ; The line ran out with nothing in hand
0006EDr 2  86 rr          stx ScanIdx
0006EFr 2  4C rr rr       jmp MatchEmit                 ; Whatever was running ends with the line
0006F2r 2               @Nothing:
0006F2r 2  60             rts
0006F3r 2               
0006F3r 2               ; -----------------------------------------------------------------------------
0006F3r 2               ;   MatchEmit — a run has ended; mark it if it was long enough
0006F3r 2               ;   In:  ScanIdx = one cell PAST the run's last, ScanLen, ScanColor, ScanStep
0006F3r 2               ;   Out: nothing.  Modifies: A, X, Y, ScanEnd, ScanLen, RunCount, Marks
0006F3r 2               ;
0006F3r 2               ;   Runs are marked, not removed: a cell can be in a horizontal run and a
0006F3r 2               ;   vertical one at once, and it clears once while both runs score (SPEC 6.1).
0006F3r 2               ;   The union is what the MARKS bitmap is for.
0006F3r 2               ;
0006F3r 2               ;   SCORING HAPPENS HERE, before the mark loop and for the same reason the
0006F3r 2               ;   comment above used to promise it would: ScanLen still describes the run at
0006F3r 2               ;   this point and nowhere else, because the mark loop counts it down to zero
0006F3r 2               ;   on its way back along the line. MatchScoreRun leaves it alone.
0006F3r 2               ; -----------------------------------------------------------------------------
0006F3r 2               MatchEmit:
0006F3r 2  A5 rr          lda ScanLen
0006F5r 2  C9 03          cmp #MATCH_MIN
0006F7r 2  90 1D          bcc @Done                     ; Two in a row is not a run
0006F9r 2               
0006F9r 2  EE rr rr       inc RunCount
0006FCr 2  20 rr rr       jsr MatchScoreRun             ; SPEC 8 step 2, per run
0006FFr 2  A5 rr          lda ScanIdx
000701r 2  38             sec
000702r 2  E5 rr          sbc ScanStep                  ; Back onto the run's last cell
000704r 2  85 rr          sta ScanEnd
000706r 2               @Mark:
000706r 2  A5 rr          lda ScanEnd
000708r 2  20 rr rr       jsr MarkSet
00070Br 2  A5 rr          lda ScanEnd
00070Dr 2  38             sec
00070Er 2  E5 rr          sbc ScanStep
000710r 2  85 rr          sta ScanEnd
000712r 2  C6 rr          dec ScanLen
000714r 2  D0 F0          bne @Mark
000716r 2               @Done:
000716r 2  60             rts
000717r 2               
000717r 2               ; -----------------------------------------------------------------------------
000717r 2               ;   MatchScoreRun — the two per-run awards of SPEC 8 step 2
000717r 2               ;   In:  ScanLen = run length, ChainStep = the cascade step this is
000717r 2               ;   Out: nothing.  Modifies: A, X, Y.  Leaves ScanLen and ScanColor alone.
000717r 2               ;
000717r 2               ;       cascade_pts += length * TileValue[chain]
000717r 2               ;       cascade_pts += LengthBonus[length]
000717r 2               ;
000717r 2               ;   A cell in a horizontal run AND a vertical one is scored by both, and
000717r 2               ;   removed once (SPEC 6.1) — which is why this is per run and not per marked
000717r 2               ;   cell, and why it runs before the union in MARKS has anything to say.
000717r 2               ;
000717r 2               ;   MultiBonus is NOT here: it is per step, not per run, and CascadeScan adds
000717r 2               ;   it once the four passes have finished counting.
000717r 2               ; -----------------------------------------------------------------------------
000717r 2               MatchScoreRun:
000717r 2  AE rr rr       ldx ChainStep
00071Ar 2  CA             dex                           ; TileValue is indexed by chain - 1 ...
00071Br 2  E0 08          cpx #8
00071Dr 2  90 02          bcc @Chain
00071Fr 2  A2 07          ldx #7                        ;   ... and flattens out at 8 (SPEC 9.1)
000721r 2               @Chain:
000721r 2  A4 rr          ldy ScanLen                   ; The multiply is Y additions (score.asm)
000723r 2  BD rr rr       lda TileValueLo,x
000726r 2  48             pha
000727r 2  BD rr rr       lda TileValueHi,x
00072Ar 2  AA             tax
00072Br 2  68             pla
00072Cr 2  20 rr rr       jsr CascadeAddTimes
00072Fr 2               
00072Fr 2  A6 rr          ldx ScanLen
000731r 2  CA             dex
000732r 2  CA             dex
000733r 2  CA             dex                           ; LengthBonus is indexed by length - 3 ...
000734r 2  E0 05          cpx #5
000736r 2  90 02          bcc @Length
000738r 2  A2 04          ldx #4                        ;   ... and flattens out at 7 (SPEC 9.3). A
00073Ar 2               @Length:                        ;   vertical run can be all sixteen rows long
00073Ar 2  BD rr rr       lda LengthBonusLo,x
00073Dr 2  48             pha
00073Er 2  BD rr rr       lda LengthBonusHi,x
000741r 2  AA             tax
000742r 2  68             pla
000743r 2  4C rr rr       jmp CascadeAdd
000746r 2               
000746r 2               ; -----------------------------------------------------------------------------
000746r 2               ;   MarksClear / MarkSet / MarkTest — the 16-byte bitmap
000746r 2               ;   One byte per row, bits 0-5 = columns 0-5. Union of runs is a free ORA.
000746r 2               ;
000746r 2               ;   MarkBits has eight entries rather than six so that the two sentinel
000746r 2               ;   columns index it harmlessly: bits 6 and 7 of a Marks byte are never set,
000746r 2               ;   so a walk over the whole 8-byte stride can test every cell it meets
000746r 2               ;   without first asking whether the cell is a wall.
000746r 2               ; -----------------------------------------------------------------------------
000746r 2               MarkBits:
000746r 2  01 02 04 08    .byte $01, $02, $04, $08, $10, $20, $40, $80
00074Ar 2  10 20 40 80  
00074Er 2               
00074Er 2               MarksClear:
00074Er 2  A9 00          lda #0
000750r 2  A2 00          ldx #0
000752r 2               @Row:
000752r 2  9D rr rr       sta Marks,x
000755r 2  E8             inx
000756r 2  E0 10          cpx #MARKS_BYTES
000758r 2  D0 F8          bne @Row
00075Ar 2  60             rts
00075Br 2               
00075Br 2               MarkSet:                        ; In: A = board index.  Modifies: A, X, Y
00075Br 2  AA             tax
00075Cr 2  29 07          and #(BOARD_STRIDE - 1)
00075Er 2  A8             tay                           ; Y = column
00075Fr 2  8A             txa
000760r 2  4A             lsr a
000761r 2  4A             lsr a
000762r 2  4A             lsr a
000763r 2  AA             tax                           ; X = row
000764r 2  BD rr rr       lda Marks,x
000767r 2  19 rr rr       ora MarkBits,y
00076Ar 2  9D rr rr       sta Marks,x
00076Dr 2  60             rts
00076Er 2               
00076Er 2               MarkTest:                       ; In: A = board index.  Out: C set if marked
00076Er 2  AA             tax                           ;     Modifies: A, X, Y
00076Fr 2  29 07          and #(BOARD_STRIDE - 1)
000771r 2  A8             tay
000772r 2  8A             txa
000773r 2  4A             lsr a
000774r 2  4A             lsr a
000775r 2  4A             lsr a
000776r 2  AA             tax
000777r 2  BD rr rr       lda Marks,x
00077Ar 2  39 rr rr       and MarkBits,y
00077Dr 2  F0 02          beq @No
00077Fr 2  38             sec
000780r 2  60             rts
000781r 2               @No:
000781r 2  18             clc
000782r 2  60             rts
000783r 2               
000783r 1               .include "../src/cascade.asm"
000783r 2               ; =============================================================================
000783r 2               ;   cascade.asm — Wizards Lab, clear resolution
000783r 2               ; =============================================================================
000783r 2               ;   SPEC.md section 8. A cascade runs from the moment a piece locks until no
000783r 2               ;   further matches exist, one step per iteration, with ChainStep counting the
000783r 2               ;   steps. The step order is fixed:
000783r 2               ;
000783r 2               ;       scan -> score matches -> enqueue reagents -> resolve queue
000783r 2               ;            -> animate -> remove -> level check -> gravity -> repeat
000783r 2               ;
000783r 2               ;   The effect queue always drains. Effects only ever remove tiles, never add
000783r 2               ;   them, and each cell can be marked at most once, so the queue is bounded by
000783r 2               ;   the 96 cells of the playfield.
000783r 2               ; =============================================================================
000783r 2               
000783r 2               ; -----------------------------------------------------------------------------
000783r 2               ;   CascadeBegin — called immediately after PieceLock
000783r 2               ;   Out: nothing.  Modifies: A
000783r 2               ; -----------------------------------------------------------------------------
000783r 2               CascadeBegin:
000783r 2  A9 01          lda #1
000785r 2  8D rr rr       sta ChainStep                 ; The step about to run is step 1 (SPEC 8)
000788r 2  A9 00          lda #0
00078Ar 2  8D rr rr       sta CascadeLo
00078Dr 2  8D rr rr       sta CascadeMid
000790r 2  8D rr rr       sta CascadeHi
000793r 2  8D rr rr       sta StarCount
000796r 2  8D rr rr       sta RunCount
000799r 2  4C rr rr       jmp EffectQClear
00079Cr 2               
00079Cr 2               ; -----------------------------------------------------------------------------
00079Cr 2               ;   CascadeScan — steps 1 to 4: find the runs, score them, fire the reagents
00079Cr 2               ;   In:  nothing
00079Cr 2               ;   Out: C set if anything is marked and the step has something to animate.
00079Cr 2               ;        C clear when nothing matched and the cascade has settled.
00079Cr 2               ;        Modifies: A, X, Y, Scan*, Marks, RunCount, Cascade*, StarCount
00079Cr 2               ;
00079Cr 2               ;   Steps 3 and 4 are the reagents, and they run between the scan and the
00079Cr 2               ;   removal because everything they do is add cells to Marks: by the time
00079Cr 2               ;   CascadeRemove walks the bitmap it cannot tell a cell the scan found from
00079Cr 2               ;   a cell a fireball took, and does not need to.
00079Cr 2               ;
00079Cr 2               ;   NOTHING HAS LEFT THE BOARD WHEN THIS RETURNS. Step 5 — the glow and the
00079Cr 2               ;   shatter (anim.asm) — happens between here and CascadeFinish below, over
00079Cr 2               ;   several frames, and it can only draw a cell's own colour and its own
00079Cr 2               ;   reagent because the cell is still sitting there saying what it is. That
00079Cr 2               ;   split is what the whole of P6 rests on, and it is the same property that
00079Cr 2               ;   let P5 make an effect queue entry one byte.
00079Cr 2               ;
00079Cr 2               ;   Step 2's per-run half is in MatchEmit, which is the one moment a run's
00079Cr 2               ;   length and colour are both in hand; what is left of it here is the bonus
00079Cr 2               ;   for having found several at once, which nothing knows until all four
00079Cr 2               ;   passes have finished.
00079Cr 2               ; -----------------------------------------------------------------------------
00079Cr 2               CascadeScan:
00079Cr 2  20 rr rr       jsr MatchScan
00079Fr 2  F0 1E          beq @Settled                  ; RunCount is zero — nothing left to clear
0007A1r 2               
0007A1r 2  AE rr rr       ldx RunCount                  ; SPEC 8 step 2, last line, and SPEC 9.4
0007A4r 2  CA             dex                           ; MultiBonus is indexed by runs - 1 ...
0007A5r 2  E0 05          cpx #5
0007A7r 2  90 02          bcc @Multi
0007A9r 2  A2 04          ldx #4                        ;   ... and flattens out at 5
0007ABr 2               @Multi:
0007ABr 2  BD rr rr       lda MultiBonusLo,x
0007AEr 2  48             pha
0007AFr 2  BD rr rr       lda MultiBonusHi,x
0007B2r 2  AA             tax
0007B3r 2  68             pla
0007B4r 2  20 rr rr       jsr CascadeAdd
0007B7r 2               
0007B7r 2  20 rr rr       jsr EffectEnqueueMarked       ; SPEC 8 step 3
0007BAr 2  20 rr rr       jsr EffectResolve             ; SPEC 8 step 4
0007BDr 2  38             sec
0007BEr 2  60             rts
0007BFr 2               @Settled:
0007BFr 2  18             clc
0007C0r 2  60             rts
0007C1r 2               
0007C1r 2               ; -----------------------------------------------------------------------------
0007C1r 2               ;   CascadeFinish — steps 6 and 7, once the animation has finished with them
0007C1r 2               ;   In:  Marks, as CascadeScan left it
0007C1r 2               ;   Out: nothing.  Modifies: A, X, Y, CellCount, Board, Level
0007C1r 2               ; -----------------------------------------------------------------------------
0007C1r 2               CascadeFinish:
0007C1r 2  20 rr rr       jsr CascadeRemove             ; SPEC 8 step 6
0007C4r 2  A5 rr          lda CellCount
0007C6r 2  4C rr rr       jmp ScoreLevelCheck           ; SPEC 8 step 7 — match and effect removals
0007C9r 2                                               ;   both count, and by here they are the same
0007C9r 2                                               ;   cells
0007C9r 2               
0007C9r 2               ; -----------------------------------------------------------------------------
0007C9r 2               ;   CascadeRemove — empty every marked cell and queue it for redraw
0007C9r 2               ;   In:  Marks
0007C9r 2               ;   Out: CellCount = cells removed.  Modifies: A, X, Y, CellCount, RedrawCol
0007C9r 2               ;   SPEC 8 step 6.
0007C9r 2               ;
0007C9r 2               ;   Every marked cell is zeroed in one go, because the gravity that follows
0007C9r 2               ;   needs a board that is finished changing. Only the REDRAW is rationed: at
0007C9r 2               ;   most 96 cells can be marked and the dirty ring holds 64, and P5 made that
0007C9r 2               ;   reachable — a bolt is 21 cells on its own and a chain of them is most of
0007C9r 2               ;   the well. A mark dropped by a full ring is never made again (D6), so
0007C9r 2               ;   rather than drop one this falls back to RenderBoard, the whole-well cursor
0007C9r 2               ;   RenderFlush already feeds a frame at a time (D12). Four frames of redraw
0007C9r 2               ;   instead of a hole in the screen, and only on the rare huge step: a plain
0007C9r 2               ;   three-in-a-row never comes near the cap.
0007C9r 2               ;
0007C9r 2               ;   CellCount goes to ScoreLevelCheck — thirty cleared tiles is a level
0007C9r 2               ;   (SPEC 10.1). By the time this runs the cells have already glowed and
0007C9r 2               ;   shattered (anim.asm); what it draws over them is the empty well behind.
0007C9r 2               ; -----------------------------------------------------------------------------
0007C9r 2               CascadeRemove:
0007C9r 2  A9 00          lda #0
0007CBr 2  85 rr          sta CellCount
0007CDr 2  AA             tax                           ; X = board index, walked a row at a time
0007CEr 2               @Row:
0007CEr 2  8A             txa
0007CFr 2  4A             lsr a
0007D0r 2  4A             lsr a
0007D1r 2  4A             lsr a
0007D2r 2  A8             tay
0007D3r 2  B9 rr rr       lda Marks,y
0007D6r 2  F0 38          beq @NextRow                  ; Nothing marked in this row, and most rows
0007D8r 2                                               ;   hold nothing marked
0007D8r 2               @Cell:
0007D8r 2  8A             txa
0007D9r 2  48             pha
0007DAr 2  20 rr rr       jsr MarkTest
0007DDr 2  68             pla
0007DEr 2  AA             tax                           ; MarkTest needs X, so the cursor comes back
0007DFr 2  90 1F          bcc @NextCell                 ;   through A. Neither PLA nor TAX touches C.
0007E1r 2  A9 00          lda #TILE_EMPTY
0007E3r 2  9D rr rr       sta Board,x
0007E6r 2  E6 rr          inc CellCount
0007E8r 2               
0007E8r 2  AD rr rr       lda DirtyCount                ; Room to mark this one?
0007EBr 2  C9 40          cmp #DIRTY_ENTRIES
0007EDr 2  B0 0A          bcs @Bulk                     ; No — redraw the lot instead of losing it
0007EFr 2  8A             txa
0007F0r 2  48             pha
0007F1r 2  20 rr rr       jsr RenderCell
0007F4r 2  68             pla
0007F5r 2  AA             tax
0007F6r 2  4C rr rr       jmp @NextCell
0007F9r 2               @Bulk:
0007F9r 2  8A             txa
0007FAr 2  48             pha
0007FBr 2  20 rr rr       jsr RenderBoard               ; Sets the cursor and nothing else, so the
0007FEr 2  68             pla                           ;   cells already queued still land and the
0007FFr 2  AA             tax                           ;   redraw overwrites them with the same values
000800r 2               @NextCell:
000800r 2  E8             inx
000801r 2  8A             txa
000802r 2  29 07          and #(BOARD_STRIDE - 1)
000804r 2  C9 06          cmp #BOARD_W
000806r 2  90 D0          bcc @Cell
000808r 2               
000808r 2  8A             txa                           ; X is on the row's first sentinel column;
000809r 2  18             clc                           ;   step over both of them
00080Ar 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
00080Cr 2  AA             tax
00080Dr 2  4C rr rr       jmp @Test
000810r 2               
000810r 2               @NextRow:
000810r 2  8A             txa
000811r 2  18             clc
000812r 2  69 08          adc #BOARD_STRIDE
000814r 2  AA             tax
000815r 2               @Test:
000815r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
000817r 2  90 B5          bcc @Row
000819r 2  60             rts
00081Ar 2               
00081Ar 2               ; -----------------------------------------------------------------------------
00081Ar 2               ;   CascadeSettle — apply the star multiplier and bank the points
00081Ar 2               ;   SPEC 8 SETTLE, SPEC 9.6 — the doubling covers the WHOLE cascade, including
00081Ar 2               ;   points scored before the star cleared.
00081Ar 2               ; -----------------------------------------------------------------------------
00081Ar 2               CascadeSettle:
00081Ar 2  AD rr rr       lda StarCount
00081Dr 2  C9 03          cmp #STAR_SHIFT_CAP
00081Fr 2  90 02          bcc @Shift
000821r 2  A9 03          lda #STAR_SHIFT_CAP           ; x8 and no further, however many were caught
000823r 2               @Shift:
000823r 2  AA             tax
000824r 2  F0 06          beq @Bank
000826r 2               @Double:
000826r 2  20 rr rr       jsr CascadeDouble             ; A doubling in BCD is one self-addition
000829r 2  CA             dex
00082Ar 2  D0 FA          bne @Double
00082Cr 2               @Bank:
00082Cr 2  4C rr rr       jmp ScoreAdd                  ; Its carry is not read: ScoreHighCheck has
00082Fr 2                                               ;   already raised the fanfare and the flash
00082Fr 2                                               ;   itself, and does so exactly once
00082Fr 2               
00082Fr 2               
00082Fr 2               ; =============================================================================
00082Fr 2               ;   The reagents (SPEC 7)
00082Fr 2               ; =============================================================================
00082Fr 2               ;   Steps 3 and 4 of SPEC 8, and the five effects between them. The shape is:
00082Fr 2               ;
00082Fr 2               ;     EffectEnqueueMarked   walks MARKS once the scan has finished, and offers
00082Fr 2               ;                           every matched cell to EffectEnqueue
00082Fr 2               ;     EffectEnqueue         decides what a cell being removed is worth — a
00082Fr 2               ;                           prism pays, a star counts, a fireball/bolt/bomb
00082Fr 2               ;                           queues
00082Fr 2               ;     EffectResolve         drains the queue, detonating each in turn
00082Fr 2               ;     EffectFireball/Bolt/  list the cells a detonation reaches, and offer each
00082Fr 2               ;       Bomb                one to EffectHit
00082Fr 2               ;     EffectHit             marks it, scores it, and offers it to
00082Fr 2               ;                           EffectEnqueue in its turn — which is the whole of
00082Fr 2               ;                           SPEC 7.2's chain reaction, in one routine
00082Fr 2               ;
00082Fr 2               ;   TERMINATION IS STRUCTURAL, not a limit. An effect only ever MARKS cells and
00082Fr 2               ;   never adds one, and EffectHit refuses a cell that is already marked, so a
00082Fr 2               ;   cell can be pushed at most once and the loop is bounded by the 96 cells of
00082Fr 2               ;   the well.
00082Fr 2               ;
00082Fr 2               ;   Nothing here touches the board. Marked cells are still sitting there,
00082Fr 2               ;   readable, until CascadeRemove zeroes them in step 6 — which is what lets a
00082Fr 2               ;   queue entry be a board index and nothing else (constants.inc).
00082Fr 2               ; =============================================================================
00082Fr 2               
00082Fr 2               ; -----------------------------------------------------------------------------
00082Fr 2               ;   EffectEnqueueMarked — SPEC 8 step 3
00082Fr 2               ;   In:  Marks, as MatchScan left it
00082Fr 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectQ, StarCount, Cascade*
00082Fr 2               ;
00082Fr 2               ;   Nothing called from here marks anything, so the bitmap being walked cannot
00082Fr 2               ;   change underneath the walk. Step 4 is where marking starts, and the cells
00082Fr 2               ;   it marks enqueue themselves as they are marked (EffectHit) rather than
00082Fr 2               ;   waiting for a second pass over MARKS.
00082Fr 2               ;
00082Fr 2               ;   It has to be a pass over the union rather than part of MatchEmit's mark
00082Fr 2               ;   loop: a cell in a horizontal run AND a vertical one is marked twice and
00082Fr 2               ;   would then detonate twice (SPEC 6.1).
00082Fr 2               ; -----------------------------------------------------------------------------
00082Fr 2               EffectEnqueueMarked:
00082Fr 2  A9 00          lda #0
000831r 2  85 rr          sta EffectIdx
000833r 2               @Row:
000833r 2  A5 rr          lda EffectIdx
000835r 2  4A             lsr a
000836r 2  4A             lsr a
000837r 2  4A             lsr a
000838r 2  A8             tay
000839r 2  B9 rr rr       lda Marks,y
00083Cr 2  F0 20          beq @NextRow                  ; Nothing marked in this row, which is most
00083Er 2                                               ;   rows of most steps
00083Er 2               @Cell:
00083Er 2  A5 rr          lda EffectIdx
000840r 2  20 rr rr       jsr MarkTest
000843r 2  90 05          bcc @NextCell
000845r 2  A6 rr          ldx EffectIdx
000847r 2  20 rr rr       jsr EffectEnqueue
00084Ar 2               @NextCell:
00084Ar 2  E6 rr          inc EffectIdx
00084Cr 2  A5 rr          lda EffectIdx
00084Er 2  29 07          and #(BOARD_STRIDE - 1)
000850r 2  C9 06          cmp #BOARD_W
000852r 2  90 EA          bcc @Cell
000854r 2               
000854r 2  A5 rr          lda EffectIdx                 ; On the row's first sentinel column; step
000856r 2  18             clc                           ;   over both of them
000857r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000859r 2  85 rr          sta EffectIdx
00085Br 2  4C rr rr       jmp @Test
00085Er 2               
00085Er 2               @NextRow:
00085Er 2  A5 rr          lda EffectIdx
000860r 2  18             clc
000861r 2  69 08          adc #BOARD_STRIDE
000863r 2  85 rr          sta EffectIdx
000865r 2               @Test:
000865r 2  A5 rr          lda EffectIdx
000867r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000869r 2  90 C8          bcc @Row
00086Br 2  60             rts
00086Cr 2               
00086Cr 2               ; -----------------------------------------------------------------------------
00086Cr 2               ;   EffectEnqueue — a marked cell is going; make what it holds count
00086Cr 2               ;   In:  X = board index of a cell that is ALREADY marked
00086Cr 2               ;   Out: nothing.  Modifies: A, X, Y
00086Cr 2               ;
00086Cr 2               ;   Called exactly once per removed cell — from step 3 for the cells the scan
00086Cr 2               ;   found, and from EffectHit for every cell an effect takes. Three outcomes:
00086Cr 2               ;
00086Cr 2               ;     a prism   pays BONUS_PRISM here and now and is never queued: it has no
00086Cr 2               ;               effect to fire, only a bonus (SPEC 7.3)
00086Cr 2               ;     a star    counts into StarCount and is never queued either — SPEC 8
00086Cr 2               ;               step 3 is explicit that stars are counted, not queued
00086Cr 2               ;     the rest  go on the queue, and pay their trigger bonus when they pop
00086Cr 2               ;
00086Cr 2               ;   THE COLOUR IS TESTED BEFORE THE GLYPH, and that order is not cosmetic. A
00086Cr 2               ;   prism is glyph 0 of colour 6, indistinguishable from a plain potion by its
00086Cr 2               ;   glyph alone — and from P6 onward the board may hold any of the prism's four
00086Cr 2               ;   idle rotation frames, whose low three bits read as a bolt or a bomb and
00086Cr 2               ;   would detonate one. Colour 6 is the only test that stays true.
00086Cr 2               ; -----------------------------------------------------------------------------
00086Cr 2               EffectEnqueue:
00086Cr 2  BD rr rr       lda Board,x
00086Fr 2  29 F8          and #COLOR_MASK
000871r 2  C9 70          cmp #WILD_BASE
000873r 2  F0 12          beq @Prism
000875r 2  BD rr rr       lda Board,x
000878r 2  29 07          and #GLYPH_MASK
00087Ar 2  F0 0A          beq @Done                     ; A plain potion, which is most of the board
00087Cr 2  C9 04          cmp #GLYPH_STAR
00087Er 2  F0 0A          beq @Star
000880r 2  B0 04          bcs @Done                     ; Glyphs 5-7 are animation frames (SPEC 4.4),
000882r 2                                               ;   never reagents
000882r 2  8A             txa
000883r 2  4C rr rr       jmp EffectQPush               ; Fireball, bolt or bomb — glyphs 1 to 3
000886r 2               @Done:
000886r 2  60             rts
000887r 2               @Prism:
000887r 2  4C rr rr       jmp EffectPrism               ; Both of these are the far side of the three
00088Ar 2               @Star:                          ;   detonations below, well out of branch range
00088Ar 2  4C rr rr       jmp EffectStar
00088Dr 2               
00088Dr 2               ; -----------------------------------------------------------------------------
00088Dr 2               ;   EffectHit — one cell of one detonation
00088Dr 2               ;   In:  X = board index
00088Dr 2               ;   Out: nothing.  Modifies: A, X, Y
00088Dr 2               ;
00088Dr 2               ;   The whole of SPEC 8 step 4's inner loop, which is why every effect below
00088Dr 2               ;   is nothing but a list of cells to offer it.
00088Dr 2               ;
00088Dr 2               ;   A cell that is empty, a wall, or already marked is not a target. "Not
00088Dr 2               ;   already marked" is what makes the queue terminate and what stops a cell
00088Dr 2               ;   being paid for twice; testing the WALL here is what lets the walks above
00088Dr 2               ;   run over the two sentinel columns without bounds checks of their own. A
00088Dr 2               ;   marked sentinel would be zeroed by CascadeRemove and the well would grow
00088Dr 2               ;   a hole in its floor.
00088Dr 2               ; -----------------------------------------------------------------------------
00088Dr 2               EffectHit:
00088Dr 2  BD rr rr       lda Board,x
000890r 2  F0 1A          beq @Done                     ; Empty
000892r 2  C9 FF          cmp #TILE_WALL
000894r 2  F0 16          beq @Done                     ; A sentinel is never a target
000896r 2  8A             txa
000897r 2  48             pha
000898r 2  20 rr rr       jsr MarkTest
00089Br 2  68             pla
00089Cr 2  AA             tax                           ; Neither PLA nor TAX touches C
00089Dr 2  B0 0D          bcs @Done                     ; Already going
00089Fr 2               
00089Fr 2  8A             txa
0008A0r 2  48             pha                           ; MarkSet takes the index in A, which PHA left
0008A1r 2  20 rr rr       jsr MarkSet                   ;   alone
0008A4r 2  20 rr rr       jsr EffectScoreCell           ; SPEC 9.2, per cell an effect took
0008A7r 2  68             pla
0008A8r 2  AA             tax
0008A9r 2  4C rr rr       jmp EffectEnqueue             ; ...and if it was a reagent, it fires too
0008ACr 2               @Done:
0008ACr 2  60             rts
0008ADr 2               
0008ADr 2               ; -----------------------------------------------------------------------------
0008ADr 2               ;   EffectScoreCell — EffectValue[chain] for one cell taken by an effect
0008ADr 2               ;   Out: nothing.  Modifies: A, X, Y
0008ADr 2               ;   SPEC 9.2 — deliberately dearer than a matched tile at low chain depth, so
0008ADr 2               ;   that the first reagent a player ever sets off feels better than plain play.
0008ADr 2               ; -----------------------------------------------------------------------------
0008ADr 2               EffectScoreCell:
0008ADr 2  AE rr rr       ldx ChainStep
0008B0r 2  CA             dex                           ; Indexed by chain - 1 ...
0008B1r 2  E0 08          cpx #8
0008B3r 2  90 02          bcc @Chain
0008B5r 2  A2 07          ldx #7                        ;   ... and flattens out at 8
0008B7r 2               @Chain:
0008B7r 2  BD rr rr       lda EffectValueLo,x
0008BAr 2  48             pha
0008BBr 2  BD rr rr       lda EffectValueHi,x
0008BEr 2  AA             tax
0008BFr 2  68             pla
0008C0r 2  4C rr rr       jmp CascadeAdd
0008C3r 2               
0008C3r 2               ; -----------------------------------------------------------------------------
0008C3r 2               ;   EffectResolve — drain the queue (SPEC 8 step 4)
0008C3r 2               ;   Out: nothing.  Modifies: A, X, Y, Effect*, Marks, Cascade*, StarCount
0008C3r 2               ;
0008C3r 2               ;   The detonation runs first and the trigger bonus is paid on the way back,
0008C3r 2               ;   which is the order SPEC 8 step 4 sets out. It makes no difference to the
0008C3r 2               ;   total — everything lands in the same accumulator — but it does mean the
0008C3r 2               ;   glyph has to survive a routine that clobbers all three registers, and the
0008C3r 2               ;   stack is the cheapest place to put it.
0008C3r 2               ; -----------------------------------------------------------------------------
0008C3r 2               EffectResolve:
0008C3r 2               @Loop:
0008C3r 2  20 rr rr       jsr EffectQPop
0008C6r 2  90 45          bcc @Done                     ; Empty — the step is finished
0008C8r 2               
0008C8r 2  AA             tax                           ; X = the detonating cell
0008C9r 2  BD rr rr       lda Board,x                   ; Still on the board: step 6 has not run
0008CCr 2  29 07          and #GLYPH_MASK
0008CEr 2  48             pha
0008CFr 2  C9 01          cmp #GLYPH_FIREBALL
0008D1r 2  F0 0F          beq @Fireball
0008D3r 2  C9 02          cmp #GLYPH_BOLT
0008D5r 2  F0 20          beq @Bolt
0008D7r 2               
0008D7r 2  A9 07          lda #SFX_BOMB                 ; Glyph 3 — nothing else ever reaches here
0008D9r 2  8D rr rr       sta SfxRequest
0008DCr 2  20 rr rr       jsr EffectBomb
0008DFr 2  4C rr rr       jmp @Bonus
0008E2r 2               
0008E2r 2               @Fireball:
0008E2r 2  A9 05          lda #SFX_FIREBALL
0008E4r 2  8D rr rr       sta SfxRequest
0008E7r 2  BD rr rr       lda Board,x
0008EAr 2  29 F8          and #COLOR_MASK               ; Its own colour, which can never be wild
0008ECr 2  48             pha
0008EDr 2  20 rr rr       jsr HalColorFlash             ; SPEC 4.6, 14 — every tile of that colour goes
0008F0r 2  68             pla                           ;   white for the glow window, which is one VDP
0008F1r 2                                               ;   colour byte here and one compare a cell on
0008F1r 2                                               ;   the Commodores. AnimGlowBegin reads
0008F1r 2                                               ;   TintColor to find out that it happened
0008F1r 2  20 rr rr       jsr EffectFireball
0008F4r 2  4C rr rr       jmp @Bonus
0008F7r 2               
0008F7r 2               @Bolt:
0008F7r 2  A9 06          lda #SFX_BOLT
0008F9r 2  8D rr rr       sta SfxRequest
0008FCr 2  20 rr rr       jsr EffectBolt
0008FFr 2               
0008FFr 2               @Bonus:
0008FFr 2  68             pla
000900r 2  A8             tay                           ; TriggerBonus is indexed by glyph (SPEC 9.5),
000901r 2  B9 rr rr       lda TriggerBonusLo,y          ;   and is paid however the reagent was removed
000904r 2  BE rr rr       ldx TriggerBonusHi,y
000907r 2  20 rr rr       jsr CascadeAdd
00090Ar 2  4C rr rr       jmp @Loop
00090Dr 2               @Done:
00090Dr 2  60             rts
00090Er 2               
00090Er 2               ; -----------------------------------------------------------------------------
00090Er 2               ;   The five reagents (SPEC 7.3). Each lists the cells it reaches and leaves
00090Er 2               ;   the marking, the scoring and the chain reaction to EffectHit.
00090Er 2               ; -----------------------------------------------------------------------------
00090Er 2               
00090Er 2               ; -----------------------------------------------------------------------------
00090Er 2               ;   EffectFireball — every remaining tile of one colour, board wide
00090Er 2               ;   In:  A = the colour key ($40 to $68)
00090Er 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectArg, Marks, Cascade*
00090Er 2               ;   SPEC 7.3 — the signature reagent, and the reason a chain goes three deep.
00090Er 2               ;
00090Er 2               ;   PRISMS ARE IMMUNE AND IT COSTS NOTHING TO MAKE THEM SO (SPEC 7.4). A prism
00090Er 2               ;   is colour 6 and a fireball's colour never is, so the compare below is the
00090Er 2               ;   immunity — there is no special case to forget. An empty cell and a wall
00090Er 2               ;   fail it for the same reason, which is why this walks all eight columns of
00090Er 2               ;   every row rather than stepping over the sentinels.
00090Er 2               ;
00090Er 2               ;   The fireball's own cell is already marked, so it is not a target of itself,
00090Er 2               ;   and a second fireball of the same colour in the same step finds nothing
00090Er 2               ;   left to take — and still pays its trigger bonus (SPEC 7.3).
00090Er 2               ; -----------------------------------------------------------------------------
00090Er 2               EffectFireball:
00090Er 2  85 rr          sta EffectArg                 ; The colour it is hunting
000910r 2  A9 00          lda #0
000912r 2  85 rr          sta EffectIdx
000914r 2               @Cell:
000914r 2  A6 rr          ldx EffectIdx
000916r 2  BD rr rr       lda Board,x
000919r 2  29 F8          and #COLOR_MASK
00091Br 2  C5 rr          cmp EffectArg
00091Dr 2  D0 03          bne @Next
00091Fr 2  20 rr rr       jsr EffectHit
000922r 2               @Next:
000922r 2  E6 rr          inc EffectIdx
000924r 2  A5 rr          lda EffectIdx
000926r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000928r 2  90 EA          bcc @Cell
00092Ar 2  60             rts
00092Br 2               
00092Br 2               ; -----------------------------------------------------------------------------
00092Br 2               ;   EffectBolt — the whole row and the whole column through the bolt's cell
00092Br 2               ;   In:  X = board index
00092Br 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectEnd, EffectArg, Marks
00092Br 2               ;   SPEC 7.3 — up to 6 + 16 - 1 = 21 cells, and the only reagent that reaches
00092Br 2               ;   something buried at the bottom of a column.
00092Br 2               ;
00092Br 2               ;   Neither walk needs clipping: a row is six cells wherever it is, and a
00092Br 2               ;   column is sixteen. The bolt's own cell is offered twice, once by each, and
00092Br 2               ;   is refused both times because it was marked before this was called.
00092Br 2               ; -----------------------------------------------------------------------------
00092Br 2               EffectBolt:
00092Br 2  8A             txa
00092Cr 2  29 07          and #(BOARD_STRIDE - 1)
00092Er 2  85 rr          sta EffectArg                 ; Its column, for the second walk
000930r 2  8A             txa
000931r 2  29 F8          and #(256 - BOARD_STRIDE)     ; $F8 — its row base
000933r 2  85 rr          sta EffectIdx
000935r 2  18             clc
000936r 2  69 06          adc #BOARD_W
000938r 2  85 rr          sta EffectEnd                 ; One past the row's last playfield cell
00093Ar 2               @Row:
00093Ar 2  A6 rr          ldx EffectIdx
00093Cr 2  20 rr rr       jsr EffectHit
00093Fr 2  E6 rr          inc EffectIdx
000941r 2  A5 rr          lda EffectIdx
000943r 2  C5 rr          cmp EffectEnd
000945r 2  90 F3          bcc @Row
000947r 2               
000947r 2  A5 rr          lda EffectArg                 ; The column, row 0 downward
000949r 2  85 rr          sta EffectIdx
00094Br 2               @Col:
00094Br 2  A6 rr          ldx EffectIdx
00094Dr 2  20 rr rr       jsr EffectHit
000950r 2  A5 rr          lda EffectIdx
000952r 2  18             clc
000953r 2  69 08          adc #BOARD_STRIDE
000955r 2  85 rr          sta EffectIdx
000957r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000959r 2  90 F0          bcc @Col
00095Br 2  60             rts
00095Cr 2               
00095Cr 2               ; -----------------------------------------------------------------------------
00095Cr 2               ;   EffectBomb — the 3 x 3 block centred on the bomb, clipped at the edges
00095Cr 2               ;   In:  X = board index
00095Cr 2               ;   Out: nothing.  Modifies: A, X, Y, Effect*, Tmp0, Tmp1, Marks, Cascade*
00095Cr 2               ;   SPEC 7.3 — up to 9 cells, and the reagent most likely to catch another.
00095Cr 2               ;
00095Cr 2               ;   BOTH SPANS ARE CLIPPED, and the row span has to be: row 0 minus one row is
00095Cr 2               ;   index minus 8, which underflows a byte and reads the BSS in front of a
00095Cr 2               ;   page-aligned Board. The column span could lean on the sentinels the way
00095Cr 2               ;   every other walk in the game does — except at row 0, column 0, where
00095Cr 2               ;   "one to the left" is index $FF and off the end of the board. Clipping both
00095Cr 2               ;   is smaller than special-casing one corner.
00095Cr 2               ;
00095Cr 2               ;   Tmp0 and Tmp1 are finished with before the first JSR, which is what the
00095Cr 2               ;   rule about them says (zeropage.inc).
00095Cr 2               ; -----------------------------------------------------------------------------
00095Cr 2               EffectBomb:
00095Cr 2  8A             txa                           ; --- the column span ---
00095Dr 2  29 07          and #(BOARD_STRIDE - 1)
00095Fr 2  A8             tay
000960r 2  F0 01          beq @Left                     ; Column 0 — the block starts there
000962r 2  88             dey
000963r 2               @Left:
000963r 2  84 rr          sty Tmp0                      ; First column of the block
000965r 2  8A             txa
000966r 2  29 07          and #(BOARD_STRIDE - 1)
000968r 2  C9 05          cmp #(BOARD_W - 1)
00096Ar 2  B0 02          bcs @Right                    ; Already against the right wall
00096Cr 2  69 01          adc #1                        ; C is clear — the CMP above failed
00096Er 2               @Right:
00096Er 2  85 rr          sta EffectArg                 ; Last column of the block
000970r 2               
000970r 2  8A             txa                           ; --- the row span ---
000971r 2  29 F8          and #(256 - BOARD_STRIDE)
000973r 2  85 rr          sta Tmp1                      ; The bomb's own row base
000975r 2  F0 03          beq @Top                      ; Row 0 — the block starts there
000977r 2  38             sec
000978r 2  E9 08          sbc #BOARD_STRIDE
00097Ar 2               @Top:
00097Ar 2  18             clc
00097Br 2  65 rr          adc Tmp0
00097Dr 2  85 rr          sta EffectRow                 ; First cell of the block's first row
00097Fr 2               
00097Fr 2  A5 rr          lda Tmp1
000981r 2  C9 78          cmp #((BOARD_H - 1) * BOARD_STRIDE)
000983r 2  B0 03          bcs @Bottom                   ; Row 15 — the block ends there
000985r 2  18             clc
000986r 2  69 08          adc #BOARD_STRIDE
000988r 2               @Bottom:
000988r 2  18             clc
000989r 2  65 rr          adc Tmp0
00098Br 2  85 rr          sta EffectEnd                 ; First cell of the block's LAST row
00098Dr 2               
00098Dr 2               @Rows:
00098Dr 2  A5 rr          lda EffectRow
00098Fr 2  85 rr          sta EffectIdx
000991r 2               @Cell:
000991r 2  A6 rr          ldx EffectIdx
000993r 2  20 rr rr       jsr EffectHit
000996r 2  A5 rr          lda EffectIdx
000998r 2  29 07          and #(BOARD_STRIDE - 1)
00099Ar 2  C5 rr          cmp EffectArg
00099Cr 2  E6 rr          inc EffectIdx                 ; INC touches N and Z only, so the CMP's carry
00099Er 2  90 F1          bcc @Cell                     ;   is still the one being branched on
0009A0r 2               
0009A0r 2  A5 rr          lda EffectRow
0009A2r 2  C5 rr          cmp EffectEnd
0009A4r 2  B0 07          bcs @Done                     ; That was the last row of the block
0009A6r 2  18             clc
0009A7r 2  69 08          adc #BOARD_STRIDE
0009A9r 2  85 rr          sta EffectRow
0009ABr 2  D0 E0          bne @Rows                     ; Always — a row base past the first is >= 8
0009ADr 2               @Done:
0009ADr 2  60             rts
0009AEr 2               
0009AEr 2               ; -----------------------------------------------------------------------------
0009AEr 2               ;   EffectStar — removes nothing; it multiplies (SPEC 7.3)
0009AEr 2               ;   Out: nothing.  Modifies: A
0009AEr 2               ;
0009AEr 2               ;   The cap is not applied here. SPEC 9.6 doubles the WHOLE cascade up to three
0009AEr 2               ;   times at the end, so the count has to survive to CascadeSettle, which is
0009AEr 2               ;   where min(StarCount, STAR_SHIFT_CAP) is taken. A cascade cannot remove more
0009AEr 2               ;   than the 96 cells of the well, so the count cannot wrap on its way there.
0009AEr 2               ; -----------------------------------------------------------------------------
0009AEr 2               EffectStar:
0009AEr 2  EE rr rr       inc StarCount
0009B1r 2  A9 08          lda #SFX_STAR
0009B3r 2  8D rr rr       sta SfxRequest
0009B6r 2  60             rts
0009B7r 2               
0009B7r 2               ; -----------------------------------------------------------------------------
0009B7r 2               ;   EffectPrism — removes nothing; a flat bonus per prism cleared (SPEC 9.5)
0009B7r 2               ;   Out: nothing.  Modifies: A, X
0009B7r 2               ;
0009B7r 2               ;   It goes through CascadeAdd and not ScoreAward, so a star in the same
0009B7r 2               ;   cascade doubles it: SPEC 9.6 exempts only the soft drop and the level
0009B7r 2               ;   bonus from the multiplier (D5, D18).
0009B7r 2               ; -----------------------------------------------------------------------------
0009B7r 2               EffectPrism:
0009B7r 2  A9 09          lda #SFX_PRISM
0009B9r 2  8D rr rr       sta SfxRequest
0009BCr 2  A9 00          lda #<BONUS_PRISM
0009BEr 2  A2 04          ldx #>BONUS_PRISM
0009C0r 2  4C rr rr       jmp CascadeAdd
0009C3r 2               
0009C3r 2               ; -----------------------------------------------------------------------------
0009C3r 2               ;   The effect queue — a ring of board indices, one byte an entry.
0009C3r 2               ;
0009C3r 2               ;   The board still holds every pending reagent when its entry pops, because
0009C3r 2               ;   nothing is zeroed until step 6, so the glyph and the colour SPEC 8 packs
0009C3r 2               ;   into the entry are one `lda Board,x` away and storing them again would be
0009C3r 2               ;   storing a copy of the board (constants.inc).
0009C3r 2               ;
0009C3r 2               ;   Head and tail are entry numbers; the ring keeps one slot free, so it holds
0009C3r 2               ;   EFFECTQ_ENTRIES - 1. On overflow the effect is DROPPED and the cascade
0009C3r 2               ;   carries on (D6) — the cell is still marked, still scored and still removed,
0009C3r 2               ;   it simply does not detonate. With at most one reagent a piece, 47 pending
0009C3r 2               ;   detonations is not somewhere a real board goes.
0009C3r 2               ; -----------------------------------------------------------------------------
0009C3r 2               EffectQClear:
0009C3r 2  A9 00          lda #0
0009C5r 2  8D rr rr       sta EffectQHead
0009C8r 2  8D rr rr       sta EffectQTail
0009CBr 2  60             rts
0009CCr 2               
0009CCr 2               ; -----------------------------------------------------------------------------
0009CCr 2               ;   EffectQPush — In: A = board index.  Modifies: A, X, Y
0009CCr 2               ; -----------------------------------------------------------------------------
0009CCr 2               EffectQPush:
0009CCr 2  AE rr rr       ldx EffectQTail
0009CFr 2  AC rr rr       ldy EffectQTail
0009D2r 2  C8             iny
0009D3r 2  C0 30          cpy #EFFECTQ_ENTRIES
0009D5r 2  90 02          bcc @Store
0009D7r 2  A0 00          ldy #0                        ; Wrap
0009D9r 2               @Store:
0009D9r 2  CC rr rr       cpy EffectQHead
0009DCr 2  F0 06          beq @Full                     ; One slot free is the ring being full
0009DEr 2  9D rr rr       sta EffectQ,x
0009E1r 2  8C rr rr       sty EffectQTail
0009E4r 2               @Full:
0009E4r 2  60             rts
0009E5r 2               
0009E5r 2               ; -----------------------------------------------------------------------------
0009E5r 2               ;   EffectQPop — Out: C set and A = board index; C clear when empty
0009E5r 2               ;   Modifies: A, X
0009E5r 2               ; -----------------------------------------------------------------------------
0009E5r 2               EffectQPop:
0009E5r 2  AE rr rr       ldx EffectQHead
0009E8r 2  EC rr rr       cpx EffectQTail
0009EBr 2  F0 0F          beq @Empty
0009EDr 2  BD rr rr       lda EffectQ,x
0009F0r 2  E8             inx
0009F1r 2  E0 30          cpx #EFFECTQ_ENTRIES
0009F3r 2  90 02          bcc @Store
0009F5r 2  A2 00          ldx #0                        ; Wrap
0009F7r 2               @Store:
0009F7r 2  8E rr rr       stx EffectQHead
0009FAr 2  38             sec
0009FBr 2  60             rts
0009FCr 2               @Empty:
0009FCr 2  18             clc
0009FDr 2  60             rts
0009FEr 2               
0009FEr 1               .include "../src/anim.asm"
0009FEr 2               ; =============================================================================
0009FEr 2               ;   anim.asm — Wizards Lab, the animations a clear is made of
0009FEr 2               ; =============================================================================
0009FEr 2               ;   SPEC.md section 14, and step 5 of SPEC 8. Everything here is a frame's
0009FEr 2               ;   worth of work and then a return: nothing waits, nothing loops on a timer,
0009FEr 2               ;   and the main loop never stops for any of it (D4).
0009FEr 2               ;
0009FEr 2               ;   A CLEAR STEP ANIMATES IN TWO WINDOWS, and every event SPEC 14 lists lands
0009FEr 2               ;   inside one of them:
0009FEr 2               ;
0009FEr 2               ;     PLAY_GLOW      matched cells wear glyph +6 of their own colour, the
0009FEr 2               ;                    bolt's beams lie over its row and column, and the
0009FEr 2               ;                    fireball's colour is white board-wide. GlowFrames, or the
0009FEr 2               ;                    longer FlashFrames when a fireball fired
0009FEr 2               ;     PLAY_SHATTER   the removal ring opens outward over every marked cell,
0009FEr 2               ;                    two frames a tile, with a marked prism's blip-out closing
0009FEr 2               ;                    inward beside it. SHATTER_STEPS ring frames, or the
0009FEr 2               ;                    prism's BLIP_STEPS when there is one
0009FEr 2               ;
0009FEr 2               ;   A window is as long as the LONGEST thing in it, which is the one rule that
0009FEr 2               ;   makes the durations in SPEC 14 hold without a timer per effect.
0009FEr 2               ;
0009FEr 2               ;   THE BOARD IS UNTOUCHED THE WHOLE TIME. Marked cells are not zeroed until
0009FEr 2               ;   CascadeRemove runs at the end of the shatter (SPEC 8 step 6), so every
0009FEr 2               ;   routine below can read a cell to find out what it is while drawing
0009FEr 2               ;   something else entirely over it — which is also what let P5 make an effect
0009FEr 2               ;   queue entry one byte (cascade.asm). Nothing here writes Board except the
0009FEr 2               ;   prism's idle rotation and the game-over petrify, both of which change what
0009FEr 2               ;   a cell IS and not merely what it shows.
0009FEr 2               ;
0009FEr 2               ;   THE COLOUR IS TESTED BEFORE THE GLYPH, everywhere, for the reason P5 found
0009FEr 2               ;   the hard way: a prism is glyph 0 of colour 6 and, now that it rotates, its
0009FEr 2               ;   board byte is WILD_BASE + 0..3, whose low three bits read as a bolt or a
0009FEr 2               ;   bomb. Colour 6 is the only test that stays true.
0009FEr 2               ; =============================================================================
0009FEr 2               
0009FEr 2               ANIM_GLOW           = 0         ; The four passes AnimMarked can make over the
0009FEr 2               ANIM_BEAM           = 1         ;   marked cells. AnimMode picks one; the walk
0009FEr 2               ANIM_UNBEAM         = 2         ;   itself is the same 30 bytes for all four
0009FEr 2               ANIM_SHATTER        = 3         ;   and is written once.
0009FEr 2               
0009FEr 2               ; -----------------------------------------------------------------------------
0009FEr 2               ;   AnimMarked — run one pass over every marked cell
0009FEr 2               ;   In:  A = ANIM_*      Out: nothing.  Modifies: A, X, Y, Anim*, and whatever
0009FEr 2               ;        the pass itself touches
0009FEr 2               ;
0009FEr 2               ;   The same walk as EffectEnqueueMarked (cascade.asm) and for the same reason:
0009FEr 2               ;   MARKS is the union of everything the step is taking, and a cell in a
0009FEr 2               ;   horizontal run AND a vertical one appears in it once. Marks are read only
0009FEr 2               ;   here — no pass sets one — so the bitmap cannot change underneath the walk.
0009FEr 2               ;
0009FEr 2               ;   The cursor is in memory rather than in X because everything the passes call
0009FEr 2               ;   ends at RenderMark, which clobbers A and X (D13).
0009FEr 2               ; -----------------------------------------------------------------------------
0009FEr 2               AnimMarked:
0009FEr 2  85 rr          sta AnimMode
000A00r 2  A9 00          lda #0
000A02r 2  85 rr          sta AnimIdx
000A04r 2               @Row:
000A04r 2  A5 rr          lda AnimIdx
000A06r 2  4A             lsr a
000A07r 2  4A             lsr a
000A08r 2  4A             lsr a
000A09r 2  A8             tay
000A0Ar 2  B9 rr rr       lda Marks,y
000A0Dr 2  F0 20          beq @NextRow                  ; Nothing marked in this row, which is most
000A0Fr 2                                               ;   rows of most steps
000A0Fr 2               @Cell:
000A0Fr 2  A5 rr          lda AnimIdx
000A11r 2  20 rr rr       jsr MarkTest
000A14r 2  90 05          bcc @NextCell
000A16r 2  A6 rr          ldx AnimIdx
000A18r 2  20 rr rr       jsr AnimCell
000A1Br 2               @NextCell:
000A1Br 2  E6 rr          inc AnimIdx
000A1Dr 2  A5 rr          lda AnimIdx
000A1Fr 2  29 07          and #(BOARD_STRIDE - 1)
000A21r 2  C9 06          cmp #BOARD_W
000A23r 2  90 EA          bcc @Cell
000A25r 2               
000A25r 2  A5 rr          lda AnimIdx                   ; On the row's first sentinel column; step
000A27r 2  18             clc                           ;   over both of them
000A28r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000A2Ar 2  85 rr          sta AnimIdx
000A2Cr 2  4C rr rr       jmp @Test
000A2Fr 2               
000A2Fr 2               @NextRow:
000A2Fr 2  A5 rr          lda AnimIdx
000A31r 2  18             clc
000A32r 2  69 08          adc #BOARD_STRIDE
000A34r 2  85 rr          sta AnimIdx
000A36r 2               @Test:
000A36r 2  A5 rr          lda AnimIdx
000A38r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000A3Ar 2  90 C8          bcc @Row
000A3Cr 2  60             rts
000A3Dr 2               
000A3Dr 2               ; -----------------------------------------------------------------------------
000A3Dr 2               ;   AnimCell — one marked cell, in whichever pass is running
000A3Dr 2               ;   In:  X = board index, AnimMode      Out: nothing.  Modifies: A, X, Y
000A3Dr 2               ; -----------------------------------------------------------------------------
000A3Dr 2               AnimCell:
000A3Dr 2  A5 rr          lda AnimMode
000A3Fr 2  F0 1A          beq AnimCellGlow
000A41r 2  C9 03          cmp #ANIM_SHATTER
000A43r 2  F0 2A          beq AnimCellShatter
000A45r 2                 ; falls through into the two beam passes, which are the same test
000A45r 2               
000A45r 2               ; -----------------------------------------------------------------------------
000A45r 2               ;   AnimCellBolt — is this cell a bolt? If so, draw or undraw its cross
000A45r 2               ;   In:  X = board index      Out: nothing.  Modifies: A, X, Y, Anim*
000A45r 2               ;
000A45r 2               ;   The beams are their own pass and not a case inside the glow, because a
000A45r 2               ;   beam goes OVER a glow: a cell in a bolt's row is very often also a matched
000A45r 2               ;   cell, and both have to be drawn in that order.
000A45r 2               ; -----------------------------------------------------------------------------
000A45r 2               AnimCellBolt:
000A45r 2  BD rr rr       lda Board,x
000A48r 2  29 F8          and #COLOR_MASK
000A4Ar 2  C9 70          cmp #WILD_BASE
000A4Cr 2  F0 0C          beq @Done                     ; Colour before glyph: a rotating prism's low
000A4Er 2                                               ;   three bits say "bolt" and it is not one
000A4Er 2  BD rr rr       lda Board,x
000A51r 2  29 07          and #GLYPH_MASK
000A53r 2  C9 02          cmp #GLYPH_BOLT
000A55r 2  D0 03          bne @Done
000A57r 2  4C rr rr       jmp AnimBeam
000A5Ar 2               @Done:
000A5Ar 2  60             rts
000A5Br 2               
000A5Br 2               ; -----------------------------------------------------------------------------
000A5Br 2               ;   AnimCellGlow — glyph +6 of the cell's own colour (SPEC 14)
000A5Br 2               ;   In:  X = board index      Out: nothing.  Modifies: A, X, Y, AnimSteps
000A5Br 2               ;
000A5Br 2               ;   A MARKED PRISM SITS THE GLOW OUT. Group 14's slot +6 is an arrow, not a
000A5Br 2               ;   glow (SPEC A.3), so `WILD_BASE + GLYPH_GLOW` must never be constructed —
000A5Br 2               ;   the prism holds whatever rotation frame it was on and blips out later
000A5Br 2               ;   instead. Meeting one here is also how the shatter window learns it has to
000A5Br 2               ;   run BLIP_STEPS rather than SHATTER_STEPS, which saves a second walk.
000A5Br 2               ; -----------------------------------------------------------------------------
000A5Br 2               AnimCellGlow:
000A5Br 2  BD rr rr       lda Board,x
000A5Er 2  29 F8          and #COLOR_MASK
000A60r 2  C9 70          cmp #WILD_BASE
000A62r 2  F0 05          beq @Prism
000A64r 2  09 06          ora #GLYPH_GLOW               ; The colour key's low three bits are clear, so
000A66r 2  4C rr rr       jmp RenderCellAs              ;   an ORA is the whole conversion (SPEC 4.2)
000A69r 2               @Prism:
000A69r 2  A9 05          lda #BLIP_STEPS
000A6Br 2  8D rr rr       sta AnimSteps
000A6Er 2  60             rts
000A6Fr 2               
000A6Fr 2               ; -----------------------------------------------------------------------------
000A6Fr 2               ;   AnimCellShatter — the ring frame this cell is showing right now
000A6Fr 2               ;   In:  X = board index, AnimStep      Out: nothing.  Modifies: A, X, Y
000A6Fr 2               ;   SPEC 14, Appendix A.3 — one ring, opening outward for everything except a
000A6Fr 2               ;   prism, which runs it closed inward.
000A6Fr 2               ; -----------------------------------------------------------------------------
000A6Fr 2               AnimCellShatter:
000A6Fr 2  BD rr rr       lda Board,x
000A72r 2  29 F8          and #COLOR_MASK
000A74r 2  C9 70          cmp #WILD_BASE
000A76r 2  F0 0D          beq @Blip
000A78r 2  AC rr rr       ldy AnimStep
000A7Br 2  C0 04          cpy #(SHATTER_STEPS + 1)
000A7Dr 2  B0 0F          bcs @Done                     ; The ring is spent and the cell already blank.
000A7Fr 2  B9 rr rr       lda VfxShatter,y              ;   Only reachable while a prism holds the
000A82r 2  4C rr rr       jmp RenderCellAs              ;   window open for its last two frames
000A85r 2               @Blip:
000A85r 2  AC rr rr       ldy AnimStep
000A88r 2  B9 rr rr       lda VfxBlip,y
000A8Br 2  4C rr rr       jmp RenderCellAs
000A8Er 2               @Done:
000A8Er 2  60             rts
000A8Fr 2               
000A8Fr 2               ; -----------------------------------------------------------------------------
000A8Fr 2               ;   AnimBeam — the bolt's beams, along its whole row and its whole column
000A8Fr 2               ;   In:  X = board index of the bolt; AnimIdx holds the same index, because
000A8Fr 2               ;        this is only ever reached from AnimMarked's cursor
000A8Fr 2               ;   Out: nothing.  Modifies: A, X, Y, AnimCur, AnimEnd, AnimArg
000A8Fr 2               ;   SPEC 14, Appendix A.3.
000A8Fr 2               ;
000A8Fr 2               ;   The beams cover EVERY cell of the row and the column, empty ones included.
000A8Fr 2               ;   A beam has to butt against its neighbours to read as a beam, and the cells
000A8Fr 2               ;   the bolt found empty were never marked — so those are also the cells the
000A8Fr 2               ;   ANIM_UNBEAM pass exists to put back, since nothing else would ever draw
000A8Fr 2               ;   them again.
000A8Fr 2               ;
000A8Fr 2               ;   The cross goes down last, over both walks, because it is the one cell that
000A8Fr 2               ;   belongs to each.
000A8Fr 2               ; -----------------------------------------------------------------------------
000A8Fr 2               AnimBeam:
000A8Fr 2  8A             txa
000A90r 2  29 07          and #(BOARD_STRIDE - 1)
000A92r 2  85 rr          sta AnimArg                   ; Its column, for the second walk
000A94r 2  8A             txa
000A95r 2  29 F8          and #(256 - BOARD_STRIDE)     ; $F8 — its row base
000A97r 2  85 rr          sta AnimCur
000A99r 2  18             clc
000A9Ar 2  69 06          adc #BOARD_W
000A9Cr 2  85 rr          sta AnimEnd                   ; One past the row's last playfield cell
000A9Er 2               @Row:
000A9Er 2  A6 rr          ldx AnimCur
000AA0r 2  A9 3B          lda #VFX_BEAM_H
000AA2r 2  20 rr rr       jsr AnimBeamCell
000AA5r 2  E6 rr          inc AnimCur
000AA7r 2  A5 rr          lda AnimCur
000AA9r 2  C5 rr          cmp AnimEnd
000AABr 2  90 F1          bcc @Row
000AADr 2               
000AADr 2  A5 rr          lda AnimArg                   ; The column, row 0 downward
000AAFr 2  85 rr          sta AnimCur
000AB1r 2               @Col:
000AB1r 2  A6 rr          ldx AnimCur
000AB3r 2  A9 3C          lda #VFX_BEAM_V
000AB5r 2  20 rr rr       jsr AnimBeamCell
000AB8r 2  A5 rr          lda AnimCur
000ABAr 2  18             clc
000ABBr 2  69 08          adc #BOARD_STRIDE
000ABDr 2  85 rr          sta AnimCur
000ABFr 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000AC1r 2  90 EE          bcc @Col
000AC3r 2               
000AC3r 2  A6 rr          ldx AnimIdx                   ; The bolt's own cell. The outer walk is still
000AC5r 2  A9 3D          lda #VFX_BEAM_CROSS           ;   standing on it, which is cheaper than
000AC7r 2                 ; falls through                ;   keeping a copy across both walks
000AC7r 2               
000AC7r 2               ; -----------------------------------------------------------------------------
000AC7r 2               ;   AnimBeamCell — one cell of a beam, drawn or put back
000AC7r 2               ;   In:  X = board index, A = beam tile      Modifies: A, X, Y
000AC7r 2               ;
000AC7r 2               ;   On the way back only the cells that are NOT marked need anything: the
000AC7r 2               ;   marked ones are about to be drawn by the shatter, twice a frame apart, and
000AC7r 2               ;   drawing them here as well would only queue two marks for one cell.
000AC7r 2               ;
000AC7r 2               ;   THE RESTORE IS THE ONE MARK IN THE WHOLE ANIMATION THAT CANNOT BE DROPPED.
000AC7r 2               ;   Every other one is made again within a few frames — a lost glow is covered
000AC7r 2               ;   by the shatter six frames later, a lost ring frame by CascadeRemove at the
000AC7r 2               ;   end of it — but a beam laid over an EMPTY cell has nothing behind it that
000AC7r 2               ;   anything will ever draw again, and D6's drop-on-overflow would leave a
000AC7r 2               ;   white beam sitting in the well for the rest of the game. Five bolts in one
000AC7r 2               ;   run put 110 beam cells through here against a 64-entry ring, so this is
000AC7r 2               ;   reachable and not theoretical. It takes the same way out CascadeRemove
000AC7r 2               ;   does: the whole-well redraw cursor, which repaints every one of them from
000AC7r 2               ;   the board (D12).
000AC7r 2               ; -----------------------------------------------------------------------------
000AC7r 2               AnimBeamCell:
000AC7r 2  A4 rr          ldy AnimMode
000AC9r 2  C0 01          cpy #ANIM_BEAM
000ACBr 2  D0 03          bne @Restore
000ACDr 2  4C rr rr       jmp RenderCellAs
000AD0r 2               @Restore:
000AD0r 2  8A             txa
000AD1r 2  48             pha                           ; MarkTest takes the index in A and clobbers
000AD2r 2  20 rr rr       jsr MarkTest                  ;   X; neither PLA nor TAX touches C
000AD5r 2  68             pla
000AD6r 2  AA             tax
000AD7r 2  B0 0D          bcs @Done                     ; Marked — the shatter has it
000AD9r 2  AD rr rr       lda DirtyCount
000ADCr 2  C9 40          cmp #DIRTY_ENTRIES
000ADEr 2  B0 03          bcs @Bulk                     ; No room, and this cell must not be lost
000AE0r 2  4C rr rr       jmp RenderCell                ; Board,x — empty, in every case that gets here
000AE3r 2               @Bulk:
000AE3r 2  4C rr rr       jmp RenderBoard               ; Sets the cursor and nothing else; the cells
000AE6r 2                                               ;   already queued still land and the redraw
000AE6r 2                                               ;   goes over them with the same values
000AE6r 2               @Done:
000AE6r 2  60             rts
000AE7r 2               
000AE7r 2               ; =============================================================================
000AE7r 2               ;   The two windows
000AE7r 2               ; =============================================================================
000AE7r 2               
000AE7r 2               ; -----------------------------------------------------------------------------
000AE7r 2               ;   AnimGlowBegin — SPEC 8 step 5, first half. Called with MARKS filled and
000AE7r 2               ;   the effect queue drained, from CascadeEnter.
000AE7r 2               ;   Out: PlayState = PLAY_GLOW.  Modifies: A, X, Y, Anim*
000AE7r 2               ;
000AE7r 2               ;   The fireball's flash is already lit: EffectResolve calls HalColorFlash as
000AE7r 2               ;   it detonates, so TintColor arriving here as anything but TINT_NONE is how
000AE7r 2               ;   this knows a fireball fired and the window has to be the longer one
000AE7r 2               ;   (SPEC 14). Two fireballs of different colours in one step leave the LAST
000AE7r 2               ;   one's colour flashing — one byte can only name one group, and the other's
000AE7r 2               ;   cells still glow and still shatter.
000AE7r 2               ; -----------------------------------------------------------------------------
000AE7r 2               AnimGlowBegin:
000AE7r 2  A9 03          lda #SHATTER_STEPS            ; Raised to BLIP_STEPS by AnimCellGlow if it
000AE9r 2  8D rr rr       sta AnimSteps                 ;   meets a marked prism
000AECr 2  A9 00          lda #ANIM_GLOW
000AEEr 2  20 rr rr       jsr AnimMarked
000AF1r 2  A9 01          lda #ANIM_BEAM
000AF3r 2  20 rr rr       jsr AnimMarked
000AF6r 2               
000AF6r 2  AE rr rr       ldx Region
000AF9r 2  BD rr rr       lda GlowFrames,x
000AFCr 2  AC rr rr       ldy TintColor
000AFFr 2  C0 01          cpy #TINT_NONE
000B01r 2  F0 08          beq @Time
000B03r 2  BD rr rr       lda FlashFrames,x
000B06r 2  48             pha
000B07r 2  20 rr rr       jsr RenderNext                ; The preview is redrawn so that a piece of the
000B0Ar 2  68             pla                           ;   flashing colour goes white there too. On
000B0Br 2                                               ;   the AC6502 the whole group recolours and
000B0Br 2                                               ;   this changes nothing; on the Commodores the
000B0Br 2                                               ;   tint is per cell and this is the only way
000B0Br 2                                               ;   those three cells hear about it (SPEC 4.6)
000B0Br 2               @Time:
000B0Br 2  8D rr rr       sta AnimTimer
000B0Er 2  A9 02          lda #PLAY_GLOW
000B10r 2  8D rr rr       sta PlayState
000B13r 2  60             rts
000B14r 2               
000B14r 2               ; -----------------------------------------------------------------------------
000B14r 2               ;   AnimGlowEnd — take the beams and the flash down, and start the shatter
000B14r 2               ;   Out: PlayState = PLAY_SHATTER.  Modifies: A, X, Y, Anim*
000B14r 2               ; -----------------------------------------------------------------------------
000B14r 2               AnimGlowEnd:
000B14r 2  A9 02          lda #ANIM_UNBEAM
000B16r 2  20 rr rr       jsr AnimMarked
000B19r 2               
000B19r 2  AD rr rr       lda TintColor
000B1Cr 2  C9 01          cmp #TINT_NONE
000B1Er 2  F0 08          beq AnimShatterBegin
000B20r 2  A9 01          lda #TINT_NONE
000B22r 2  20 rr rr       jsr HalColorFlash             ; The flash ends with the window; every cell it
000B25r 2  20 rr rr       jsr RenderNext                ;   covered is marked and about to be redrawn
000B28r 2                                               ;   by the shatter, so only the preview needs
000B28r 2                                               ;   asking for again
000B28r 2                 ; falls through
000B28r 2               
000B28r 2               ; -----------------------------------------------------------------------------
000B28r 2               ;   AnimShatterBegin — SPEC 8 step 5, second half
000B28r 2               ;   Out: PlayState = PLAY_SHATTER.  Modifies: A, X, Y, Anim*
000B28r 2               ;   Frame 0 of the ring goes up now rather than next frame, so the window is
000B28r 2               ;   AnimSteps * VFX_FRAMES frames long and every tile of it holds for
000B28r 2               ;   VFX_FRAMES, the last one included.
000B28r 2               ; -----------------------------------------------------------------------------
000B28r 2               AnimShatterBegin:
000B28r 2  A9 00          lda #0
000B2Ar 2  8D rr rr       sta AnimStep
000B2Dr 2  A9 02          lda #VFX_FRAMES
000B2Fr 2  8D rr rr       sta AnimTimer
000B32r 2  A9 03          lda #PLAY_SHATTER
000B34r 2  8D rr rr       sta PlayState
000B37r 2  A9 03          lda #ANIM_SHATTER
000B39r 2  4C rr rr       jmp AnimMarked
000B3Cr 2               
000B3Cr 2               ; =============================================================================
000B3Cr 2               ;   The prism at rest (SPEC 7.3, 14)
000B3Cr 2               ; =============================================================================
000B3Cr 2               
000B3Cr 2               ; -----------------------------------------------------------------------------
000B3Cr 2               ;   AnimPrismTick — advance the idle rotation, one frame every PRISM_SPIN_RATE
000B3Cr 2               ;   Out: nothing.  Modifies: A, X, Y, AnimIdx, AnimArg, PrismFrame, PrismTimer
000B3Cr 2               ;
000B3Cr 2               ;   The only tile in the game that moves when nothing is happening, and the
000B3Cr 2               ;   only place other than the petrify that WRITES a tile to the board without
000B3Cr 2               ;   the board having changed: a prism's cell really does hold WILD_BASE + 0..3
000B3Cr 2               ;   from here on. Everything that reads a cell masks the colour first, so the
000B3Cr 2               ;   glyph bits carrying a frame number rather than a zero is invisible to the
000B3Cr 2               ;   scan, to gravity and to the effects — but it is exactly why P5 made
000B3Cr 2               ;   EffectEnqueue test the colour before the glyph, and why the petrify below
000B3Cr 2               ;   does too.
000B3Cr 2               ;
000B3Cr 2               ;   IT DOES NOT RUN DURING THE GLOW OR THE SHATTER. A marked prism has to hold
000B3Cr 2               ;   still for the glow window and then play its blip-out, and it is cheaper to
000B3Cr 2               ;   stand the whole walk down for those twelve frames than to test every cell
000B3Cr 2               ;   against MARKS.
000B3Cr 2               ;
000B3Cr 2               ;   The walk is the 96 cells of the well every eighth frame whether a prism is
000B3Cr 2               ;   on the board or not — about 150 cycles a frame amortised, against a board
000B3Cr 2               ;   scan's eleven thousand. Remembering where the prisms are would cost more
000B3Cr 2               ;   than it saves, and would have to be kept right through gravity.
000B3Cr 2               ; -----------------------------------------------------------------------------
000B3Cr 2               AnimPrismTick:
000B3Cr 2  AD rr rr       lda PlayState
000B3Fr 2  C9 02          cmp #PLAY_GLOW
000B41r 2  F0 4B          beq @Done
000B43r 2  C9 03          cmp #PLAY_SHATTER
000B45r 2  F0 47          beq @Done
000B47r 2  CE rr rr       dec PrismTimer
000B4Ar 2  D0 42          bne @Done
000B4Cr 2               
000B4Cr 2  A9 08          lda #PRISM_SPIN_RATE
000B4Er 2  8D rr rr       sta PrismTimer
000B51r 2  EE rr rr       inc PrismFrame
000B54r 2  AD rr rr       lda PrismFrame
000B57r 2  29 03          and #(PRISM_SPIN_FRAMES - 1)
000B59r 2  8D rr rr       sta PrismFrame
000B5Cr 2  09 70          ora #PRISM_SPIN               ; WILD_BASE + frame (SPEC A.3)
000B5Er 2  85 rr          sta AnimArg
000B60r 2               
000B60r 2  A9 00          lda #0
000B62r 2  85 rr          sta AnimIdx
000B64r 2               @Cell:
000B64r 2  A6 rr          ldx AnimIdx
000B66r 2  BD rr rr       lda Board,x
000B69r 2  29 F8          and #COLOR_MASK
000B6Br 2  C9 70          cmp #WILD_BASE
000B6Dr 2  D0 08          bne @Next
000B6Fr 2  A5 rr          lda AnimArg
000B71r 2  9D rr rr       sta Board,x
000B74r 2  20 rr rr       jsr RenderCell
000B77r 2               @Next:
000B77r 2  E6 rr          inc AnimIdx
000B79r 2  A5 rr          lda AnimIdx
000B7Br 2  29 07          and #(BOARD_STRIDE - 1)
000B7Dr 2  C9 06          cmp #BOARD_W
000B7Fr 2  90 07          bcc @Test
000B81r 2  A5 rr          lda AnimIdx                   ; Over the two sentinel columns
000B83r 2  18             clc
000B84r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000B86r 2  85 rr          sta AnimIdx
000B88r 2               @Test:
000B88r 2  A5 rr          lda AnimIdx
000B8Ar 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000B8Cr 2  90 D6          bcc @Cell
000B8Er 2               @Done:
000B8Er 2  60             rts
000B8Fr 2               
000B8Fr 2               ; =============================================================================
000B8Fr 2               ;   The message band (SPEC 12.2, 14)
000B8Fr 2               ; =============================================================================
000B8Fr 2               
000B8Fr 2               ; -----------------------------------------------------------------------------
000B8Fr 2               ;   AnimBannerShow — put a banner up for BannerFrames
000B8Fr 2               ;   In:  Ptr1 -> string      Out: nothing.  Modifies: A, X, Y and the text
000B8Fr 2               ;        cursor
000B8Fr 2               ; -----------------------------------------------------------------------------
000B8Fr 2               AnimBannerShow:
000B8Fr 2  20 rr rr       jsr TextBanner
000B92r 2  AE rr rr       ldx Region
000B95r 2  BD rr rr       lda BannerFrames,x
000B98r 2  8D rr rr       sta BannerTimer
000B9Br 2  60             rts
000B9Cr 2               
000B9Cr 2               ; -----------------------------------------------------------------------------
000B9Cr 2               ;   AnimBannerTick — one frame of whatever banner is up
000B9Cr 2               ;   Out: nothing.  Modifies: A, X, Y
000B9Cr 2               ;   Play never stops for a banner: it ticks alongside the sub-states, like the
000B9Cr 2               ;   high-score flash it shares its clock with (SPEC 9.8).
000B9Cr 2               ; -----------------------------------------------------------------------------
000B9Cr 2               AnimBannerTick:
000B9Cr 2  AD rr rr       lda BannerTimer
000B9Fr 2  F0 08          beq @Done
000BA1r 2  CE rr rr       dec BannerTimer
000BA4r 2  D0 03          bne @Done
000BA6r 2  4C rr rr       jmp TextBannerClear
000BA9r 2               @Done:
000BA9r 2  60             rts
000BAAr 2               
000BAAr 2               ; -----------------------------------------------------------------------------
000BAAr 2               ;   AnimBannerLevel — "~~ LEVEL UP ~~" (SPEC 10.1, 14)
000BAAr 2               ; -----------------------------------------------------------------------------
000BAAr 2               AnimBannerLevel:
000BAAr 2  A9 rr          lda #<MsgLevelUp
000BACr 2  85 rr          sta Ptr1
000BAEr 2  A9 rr          lda #>MsgLevelUp
000BB0r 2  85 rr          sta Ptr1+1
000BB2r 2  4C rr rr       jmp AnimBannerShow
000BB5r 2               
000BB5r 2               ; -----------------------------------------------------------------------------
000BB5r 2               ;   AnimBannerChain — "~~ CHAIN xN ~~" (SPEC 8 SETTLE, 14)
000BB5r 2               ;   In:  A = links in the cascade      Modifies: A, X, Y and the text cursor
000BB5r 2               ;
000BB5r 2               ;   The banner is a fixed-length string with a placeholder digit, overwritten
000BB5r 2               ;   afterwards at CHAIN_DIGIT_X — which is a constant only because the string
000BB5r 2               ;   is MSG_CHAIN_LEN cells long and TextBanner centres on PANEL_W
000BB5r 2               ;   (constants.inc). A chain past 9 says 9 rather than drawing whatever tile
000BB5r 2               ;   FONT_DIGIT_0 + 10 turns out to be.
000BB5r 2               ; -----------------------------------------------------------------------------
000BB5r 2               AnimBannerChain:
000BB5r 2  C9 0A          cmp #(CHAIN_MAX_SHOWN + 1)
000BB7r 2  90 02          bcc @Show
000BB9r 2  A9 09          lda #CHAIN_MAX_SHOWN
000BBBr 2               @Show:
000BBBr 2  48             pha
000BBCr 2  A9 rr          lda #<MsgChain
000BBEr 2  85 rr          sta Ptr1
000BC0r 2  A9 rr          lda #>MsgChain
000BC2r 2  85 rr          sta Ptr1+1
000BC4r 2  20 rr rr       jsr AnimBannerShow
000BC7r 2  68             pla
000BC8r 2  18             clc
000BC9r 2  69 10          adc #FONT_DIGIT_0
000BCBr 2  A2 0E          ldx #CHAIN_DIGIT_X
000BCDr 2  A0 16          ldy #MSG_Y
000BCFr 2  4C rr rr       jmp RenderMark
000BD2r 2               
000BD2r 2               ; -----------------------------------------------------------------------------
000BD2r 2               ;   AnimBannerOver — "~~ GAME OVER! ~~" (SPEC 13.4 step 3)
000BD2r 2               ;   Nothing takes it down again: StateGameOver does not call AnimBannerTick, so
000BD2r 2               ;   the band holds this until the screen itself ends and GameStart clears it.
000BD2r 2               ; -----------------------------------------------------------------------------
000BD2r 2               AnimBannerOver:
000BD2r 2  A9 rr          lda #<MsgGameOver
000BD4r 2  85 rr          sta Ptr1
000BD6r 2  A9 rr          lda #>MsgGameOver
000BD8r 2  85 rr          sta Ptr1+1
000BDAr 2  4C rr rr       jmp AnimBannerShow
000BDDr 2               
000BDDr 2               ; =============================================================================
000BDDr 2               ;   The title screen (SPEC 13.1)
000BDDr 2               ; =============================================================================
000BDDr 2               ;   Two moving things over one drawn image, and between them they are the whole
000BDDr 2               ;   of the title screen: there are no help pages, because the controls are part
000BDDr 2               ;   of the artwork and a page nobody is reading teaches nothing.
000BDDr 2               ; =============================================================================
000BDDr 2               
000BDDr 2               ; -----------------------------------------------------------------------------
000BDDr 2               ;   AnimTitleBegin — the blink starts lit, with the image the artist drew
000BDDr 2               ;   Out: nothing.  Modifies: A, X
000BDDr 2               ;   Called from the redraw, so entering the title twice in a session cannot
000BDDr 2               ;   leave the prompt dark for the first half period.
000BDDr 2               ; -----------------------------------------------------------------------------
000BDDr 2               AnimTitleBegin:
000BDDr 2  AE rr rr       ldx Region
000BE0r 2  BD rr rr       lda BlinkHalf,x
000BE3r 2  8D rr rr       sta TitleTimer
000BE6r 2  A9 00          lda #0
000BE8r 2  8D rr rr       sta TitlePhase                ; The drawn screen already says PRESS FIRE
000BEBr 2  60             rts
000BECr 2               
000BECr 2               ; -----------------------------------------------------------------------------
000BECr 2               ;   AnimTitleBlink — one frame of the prompt (SPEC 13.1, 14)
000BECr 2               ;   Out: nothing.  Modifies: A, X, Y, the text cursor, TitleTimer, TitlePhase
000BECr 2               ;
000BECr 2               ;   SPEC 14's blink period is 30 frames NTSC and 25 PAL, and BlinkHalf is half
000BECr 2               ;   of one — the same table and the same shape as the HIGH field's overtake
000BECr 2               ;   flash (score.asm), which is the other thing in the game that blinks. This
000BECr 2               ;   one free-runs instead of counting itself out.
000BECr 2               ; -----------------------------------------------------------------------------
000BECr 2               AnimTitleBlink:
000BECr 2  CE rr rr       dec TitleTimer
000BEFr 2  D0 2B          bne @Done
000BF1r 2  AE rr rr       ldx Region
000BF4r 2  BD rr rr       lda BlinkHalf,x
000BF7r 2  8D rr rr       sta TitleTimer
000BFAr 2  AD rr rr       lda TitlePhase
000BFDr 2  49 01          eor #$01
000BFFr 2  8D rr rr       sta TitlePhase
000C02r 2  F0 09          beq @Show
000C04r 2               
000C04r 2  A9 0A          lda #PROMPT_LEN               ; The dark half
000C06r 2  A2 06          ldx #PROMPT_X
000C08r 2  A0 0B          ldy #PROMPT_Y
000C0Ar 2  4C rr rr       jmp TextClearRun
000C0Dr 2               @Show:
000C0Dr 2  A9 rr          lda #<MsgPressFire            ; ...and back, byte for byte as the title image
000C0Fr 2  85 rr          sta Ptr1                      ;   has it (strings.inc)
000C11r 2  A9 rr          lda #>MsgPressFire
000C13r 2  85 rr          sta Ptr1+1
000C15r 2  A2 06          ldx #PROMPT_X
000C17r 2  A0 0B          ldy #PROMPT_Y
000C19r 2  4C rr rr       jmp TextDraw
000C1Cr 2               @Done:
000C1Cr 2  60             rts
000C1Dr 2               
000C1Dr 2               ; -----------------------------------------------------------------------------
000C1Dr 2               ;   AnimTitleField — one cell of the magic field, every frame (SPEC 13.1)
000C1Dr 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0, Tmp1
000C1Dr 2               ;
000C1Dr 2               ;   Tiles 128-255 are one diagonal hatch in sixteen colours (SPEC Appendix A),
000C1Dr 2               ;   so writing a random one of them into a random one of the block's 28 cells
000C1Dr 2               ;   makes the whole block crawl. Two random bytes and one RenderMark: the
000C1Dr 2               ;   cheapest animation in the game, and the reason the title screen needs no
000C1Dr 2               ;   art beyond the page it is drawn on.
000C1Dr 2               ;
000C1Dr 2               ;   The tile is rolled BEFORE the cell and parked on the stack, because
000C1Dr 2               ;   RngRange has to be the last call — nothing here may hold a value in
000C1Dr 2               ;   Tmp0-Tmp3 across it (zeropage.inc).
000C1Dr 2               ; -----------------------------------------------------------------------------
000C1Dr 2               AnimTitleField:
000C1Dr 2  20 rr rr       jsr RngNext
000C20r 2  29 7F          and #(ART_TILES - 1)          ; ART_BASE is 128 and so is ART_TILES, so the
000C22r 2  09 80          ora #ART_BASE                 ;   range is exactly the top bit set
000C24r 2  48             pha
000C25r 2               
000C25r 2  A9 1C          lda #FIELD_CELLS
000C27r 2  20 rr rr       jsr RngRange                  ; 0 .. 27, evenly — not a modulo (rng.asm)
000C2Ar 2  A0 08          ldy #FIELD_Y
000C2Cr 2  C9 0E          cmp #FIELD_W
000C2Er 2  90 03          bcc @Have
000C30r 2  E9 0E          sbc #FIELD_W                  ; C is set by the CMP that got us here
000C32r 2  C8             iny                           ; The second row of the block
000C33r 2               @Have:
000C33r 2  18             clc
000C34r 2  69 04          adc #FIELD_X
000C36r 2  AA             tax                           ; X = panel column, Y = panel row
000C37r 2  68             pla                           ; A = tile
000C38r 2  4C rr rr       jmp RenderMark
000C3Br 2               
000C3Br 2               ; =============================================================================
000C3Br 2               ;   Game over (SPEC 13.4)
000C3Br 2               ; =============================================================================
000C3Br 2               
000C3Br 2               ; -----------------------------------------------------------------------------
000C3Br 2               ;   AnimPetrifyBegin — start the well turning to stone from the floor up
000C3Br 2               ;   Out: nothing.  Modifies: A
000C3Br 2               ; -----------------------------------------------------------------------------
000C3Br 2               AnimPetrifyBegin:
000C3Br 2  A9 0F          lda #(BOARD_H - 1)
000C3Dr 2  8D rr rr       sta PetrifyRow
000C40r 2  A9 02          lda #PETRIFY_FRAMES
000C42r 2  8D rr rr       sta AnimTimer
000C45r 2  60             rts
000C46r 2               
000C46r 2               ; -----------------------------------------------------------------------------
000C46r 2               ;   AnimPetrifyTick — one frame of it
000C46r 2               ;   Out: C set while it is still running, clear once the well is stone.
000C46r 2               ;        Modifies: A, X, Y, AnimIdx, AnimEnd, AnimTimer, PetrifyRow, Board
000C46r 2               ;   SPEC 13.4 — a row every PETRIFY_FRAMES, bottom upward, 32 frames in all.
000C46r 2               ;
000C46r 2               ;   Each cell sets as ITS OWN SHAPE, because group 15 holds the petrified
000C46r 2               ;   glyphs at the same five offsets the potions use (SPEC A.3): one AND and
000C46r 2               ;   one ORA, and a bomb sets as a stone bomb at the exact moment the player is
000C46r 2               ;   looking hardest at the board. Empty cells stay empty — the pile petrifies,
000C46r 2               ;   not the well.
000C46r 2               ;
000C46r 2               ;   A prism has no stone twin, so it sets as the plain one. Testing the colour
000C46r 2               ;   first is what keeps it off `PETRIFY_BASE + 3`, a stone bomb, which is what
000C46r 2               ;   a rotating prism's glyph bits would otherwise buy (AnimPrismTick above).
000C46r 2               ; -----------------------------------------------------------------------------
000C46r 2               AnimPetrifyTick:
000C46r 2  AD rr rr       lda PetrifyRow
000C49r 2  30 42          bmi @Finished                 ; $FF — the whole well is stone
000C4Br 2  CE rr rr       dec AnimTimer
000C4Er 2  D0 3B          bne @Running
000C50r 2               
000C50r 2  A9 02          lda #PETRIFY_FRAMES
000C52r 2  8D rr rr       sta AnimTimer
000C55r 2  AD rr rr       lda PetrifyRow
000C58r 2  0A             asl a                         ; Row base — the board's stride is 8
000C59r 2  0A             asl a
000C5Ar 2  0A             asl a
000C5Br 2  85 rr          sta AnimIdx
000C5Dr 2  18             clc
000C5Er 2  69 06          adc #BOARD_W
000C60r 2  85 rr          sta AnimEnd
000C62r 2               @Cell:
000C62r 2  A6 rr          ldx AnimIdx
000C64r 2  BD rr rr       lda Board,x
000C67r 2  F0 17          beq @Next                     ; Empty stays empty (SPEC 13.4)
000C69r 2  29 F8          and #COLOR_MASK
000C6Br 2  C9 70          cmp #WILD_BASE
000C6Dr 2  F0 09          beq @Prism
000C6Fr 2  BD rr rr       lda Board,x
000C72r 2  29 07          and #GLYPH_MASK
000C74r 2  09 78          ora #PETRIFY_BASE
000C76r 2  D0 02          bne @Set                      ; Always — PETRIFY_BASE is 120
000C78r 2               @Prism:
000C78r 2  A9 78          lda #PETRIFY_BASE
000C7Ar 2               @Set:
000C7Ar 2  9D rr rr       sta Board,x
000C7Dr 2  20 rr rr       jsr RenderCell
000C80r 2               @Next:
000C80r 2  E6 rr          inc AnimIdx
000C82r 2  A5 rr          lda AnimIdx
000C84r 2  C5 rr          cmp AnimEnd
000C86r 2  90 DA          bcc @Cell
000C88r 2  CE rr rr       dec PetrifyRow
000C8Br 2               @Running:
000C8Br 2  38             sec
000C8Cr 2  60             rts
000C8Dr 2               @Finished:
000C8Dr 2  18             clc
000C8Er 2  60             rts
000C8Fr 2               
000C8Fr 1               .include "../src/score.asm"
000C8Fr 2               ; =============================================================================
000C8Fr 2               ;   score.asm — Wizards Lab, scoring
000C8Fr 2               ; =============================================================================
000C8Fr 2               ;   SPEC.md section 9. Seven digits of packed BCD in four bytes, low byte
000C8Fr 2               ;   first; the top nibble of ScoreTop is held at zero. Every value in
000C8Fr 2               ;   tables.inc is a multiple of ten, so scoring is a SED / ADC chain and never
000C8Fr 2               ;   a multiply — the one place a tile count has to be multiplied by a table
000C8Fr 2               ;   value, it is done as a loop of BCD additions, and the count is at most 21.
000C8Fr 2               ;
000C8Fr 2               ;   The score clamps at 9999999. It never wraps.
000C8Fr 2               ;
000C8Fr 2               ;   Display is always all seven digits, zero padded — see TextBcd. Nothing
000C8Fr 2               ;   here strips a leading zero, and nothing downstream may either.
000C8Fr 2               ;
000C8Fr 2               ;   TWO WAYS IN, AND THEY ARE NOT INTERCHANGEABLE (D5):
000C8Fr 2               ;
000C8Fr 2               ;     CascadeAdd / CascadeAddTimes    points scored INSIDE a cascade. They go
000C8Fr 2               ;                                     into Cascade{Lo,Mid,Hi} and stay there
000C8Fr 2               ;                                     until CascadeSettle, because a star
000C8Fr 2               ;                                     caught anywhere in the cascade doubles
000C8Fr 2               ;                                     everything it scored, retroactively
000C8Fr 2               ;                                     (SPEC 9.6).
000C8Fr 2               ;     ScoreAward                      the awards SPEC 9.6 gives outside a
000C8Fr 2               ;                                     cascade — the soft drop and the level-up
000C8Fr 2               ;                                     bonus. These reach Score at once and a
000C8Fr 2               ;                                     star never touches them.
000C8Fr 2               ;
000C8Fr 2               ;   Both funnel through ScoreBank, which is the only routine that writes
000C8Fr 2               ;   Score, the only one that clamps, and the only one that can hand the high
000C8Fr 2               ;   score over to the player.
000C8Fr 2               ; =============================================================================
000C8Fr 2               
000C8Fr 2               ; -----------------------------------------------------------------------------
000C8Fr 2               ;   ScoreHighInit — seed the session high score, once, at power-on
000C8Fr 2               ;   SPEC 9.8 — the high score is not persisted; it starts at 0010000 on every
000C8Fr 2               ;   power-on, which is the target the first game is played against. It then
000C8Fr 2               ;   survives every game in the session, so this is deliberately NOT part of
000C8Fr 2               ;   ScoreReset. Nothing may infer "cold boot" from the value being zero: BSS
000C8Fr 2               ;   is not cleared on all three machines.
000C8Fr 2               ;   Out: nothing.  Modifies: A
000C8Fr 2               ; -----------------------------------------------------------------------------
000C8Fr 2               ScoreHighInit:
000C8Fr 2  A9 00          lda #HIGH_INIT_LO
000C91r 2  8D rr rr       sta HighLo
000C94r 2  A9 00          lda #HIGH_INIT_MID
000C96r 2  8D rr rr       sta HighMid
000C99r 2  A9 01          lda #HIGH_INIT_HI
000C9Br 2  8D rr rr       sta HighHi
000C9Er 2  A9 00          lda #HIGH_INIT_TOP
000CA0r 2  8D rr rr       sta HighTop
000CA3r 2  A9 01          lda #$01                      ; BCD — the level the target was "set" on
000CA5r 2  8D rr rr       sta HighLevel
000CA8r 2  60             rts
000CA9r 2               
000CA9r 2               ; -----------------------------------------------------------------------------
000CA9r 2               ;   ScoreReset — zero the score for a new game
000CA9r 2               ;   Out: nothing.  Modifies: A
000CA9r 2               ;
000CA9r 2               ;   The high score itself is NOT reset (SPEC 9.8) — but the two flags that say
000CA9r 2               ;   what this game has done about it are, or the second game of a session
000CA9r 2               ;   would never flash.
000CA9r 2               ; -----------------------------------------------------------------------------
000CA9r 2               ScoreReset:
000CA9r 2  A9 00          lda #0
000CABr 2  8D rr rr       sta ScoreLo
000CAEr 2  8D rr rr       sta ScoreMid
000CB1r 2  8D rr rr       sta ScoreHi
000CB4r 2  8D rr rr       sta ScoreTop
000CB7r 2  8D rr rr       sta CascadeLo
000CBAr 2  8D rr rr       sta CascadeMid
000CBDr 2  8D rr rr       sta CascadeHi
000CC0r 2  8D rr rr       sta StarCount
000CC3r 2  8D rr rr       sta HighOwned
000CC6r 2  8D rr rr       sta HighFlash
000CC9r 2  8D rr rr       sta HighTimer
000CCCr 2  60             rts
000CCDr 2               
000CCDr 2               ; -----------------------------------------------------------------------------
000CCDr 2               ;   CascadeAdd — add a 16-bit BCD value to the cascade accumulator
000CCDr 2               ;   In:  A = low BCD byte, X = high BCD byte
000CCDr 2               ;   Out: nothing.  Modifies: A, flags.  PRESERVES X and Y.
000CCDr 2               ;
000CCDr 2               ;   Preserving X and Y is what lets CascadeAddTimes loop over this without
000CCDr 2               ;   spilling anything, and Tmp0-Tmp3 may not be held across a JSR anyway
000CCDr 2               ;   (zeropage.inc).
000CCDr 2               ; -----------------------------------------------------------------------------
000CCDr 2               CascadeAdd:
000CCDr 2  F8             sed
000CCEr 2  18             clc
000CCFr 2  6D rr rr       adc CascadeLo
000CD2r 2  8D rr rr       sta CascadeLo
000CD5r 2  8A             txa
000CD6r 2  6D rr rr       adc CascadeMid
000CD9r 2  8D rr rr       sta CascadeMid
000CDCr 2  AD rr rr       lda CascadeHi
000CDFr 2  69 00          adc #0
000CE1r 2  8D rr rr       sta CascadeHi
000CE4r 2  D8             cld                           ; CLD leaves the carry alone
000CE5r 2  B0 01          bcs CascadeClamp
000CE7r 2  60             rts
000CE8r 2               
000CE8r 2               ; -----------------------------------------------------------------------------
000CE8r 2               ;   CascadeClamp — six nines, when an accumulate would have wrapped
000CE8r 2               ;   Out: nothing.  Modifies: A.  PRESERVES X and Y.
000CE8r 2               ;
000CE8r 2               ;   Not reachable by playing: nothing is ever ADDED to the board during a
000CE8r 2               ;   cascade, so one cascade can never remove more than the 96 cells the well
000CE8r 2               ;   holds, and 96 cells at the dearest tile value there is (650, SPEC 9.2)
000CE8r 2               ;   plus every bonus in section 9 comes to a little over 200,000 — a fifth of
000CE8r 2               ;   what three bytes hold, and an eighth of what it would take to wrap after
000CE8r 2               ;   the star cap has doubled it three times. It is here because "never wraps"
000CE8r 2               ;   in SPEC 9 has to be true of every accumulator on the path, not just of the
000CE8r 2               ;   one the player can see.
000CE8r 2               ; -----------------------------------------------------------------------------
000CE8r 2               CascadeClamp:
000CE8r 2  A9 99          lda #$99
000CEAr 2  8D rr rr       sta CascadeLo
000CEDr 2  8D rr rr       sta CascadeMid
000CF0r 2  8D rr rr       sta CascadeHi
000CF3r 2  60             rts
000CF4r 2               
000CF4r 2               ; -----------------------------------------------------------------------------
000CF4r 2               ;   CascadeAddTimes — add a value N times (the tiles-cleared multiply)
000CF4r 2               ;   In:  A = low BCD, X = high BCD, Y = count
000CF4r 2               ;   Out: nothing.  Modifies: A, Y, flags.  PRESERVES X.
000CF4r 2               ;
000CF4r 2               ;   SPEC 9 chose values that are all multiples of ten so that scoring is an
000CF4r 2               ;   ADC chain, but `length * TileValue[chain]` is still a multiply. The count
000CF4r 2               ;   is a run length — three to sixteen — so a loop of BCD additions is both
000CF4r 2               ;   smaller and, at these counts, faster than any multiply routine worth
000CF4r 2               ;   writing.
000CF4r 2               ; -----------------------------------------------------------------------------
000CF4r 2               CascadeAddTimes:
000CF4r 2  48             pha                           ; The low byte rides the stack, because
000CF5r 2               @Loop:                          ;   CascadeAdd returns in A
000CF5r 2  C0 00          cpy #0
000CF7r 2  F0 08          beq @Done
000CF9r 2  68             pla
000CFAr 2  48             pha
000CFBr 2  20 rr rr       jsr CascadeAdd
000CFEr 2  88             dey
000CFFr 2  D0 F4          bne @Loop
000D01r 2               @Done:
000D01r 2  68             pla
000D02r 2  60             rts
000D03r 2               
000D03r 2               ; -----------------------------------------------------------------------------
000D03r 2               ;   CascadeDouble — one BCD doubling of the cascade accumulator
000D03r 2               ;   Out: nothing.  Modifies: A, flags.  PRESERVES X and Y.
000D03r 2               ;   A doubling in BCD is a self-addition; three of them is the star cap.
000D03r 2               ; -----------------------------------------------------------------------------
000D03r 2               CascadeDouble:
000D03r 2  F8             sed
000D04r 2  18             clc
000D05r 2  AD rr rr       lda CascadeLo
000D08r 2  6D rr rr       adc CascadeLo
000D0Br 2  8D rr rr       sta CascadeLo
000D0Er 2  AD rr rr       lda CascadeMid
000D11r 2  6D rr rr       adc CascadeMid
000D14r 2  8D rr rr       sta CascadeMid
000D17r 2  AD rr rr       lda CascadeHi
000D1Ar 2  6D rr rr       adc CascadeHi
000D1Dr 2  8D rr rr       sta CascadeHi
000D20r 2  D8             cld
000D21r 2  B0 C5          bcs CascadeClamp
000D23r 2  60             rts
000D24r 2               
000D24r 2               ; -----------------------------------------------------------------------------
000D24r 2               ;   ScoreAdd — bank the cascade accumulator into Score, clamped
000D24r 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
000D24r 2               ;   SPEC 9.8 — the high score updates live, so the player watches the overtake.
000D24r 2               ; -----------------------------------------------------------------------------
000D24r 2               ScoreAdd:
000D24r 2  AD rr rr       lda CascadeLo
000D27r 2  85 rr          sta Tmp0
000D29r 2  AD rr rr       lda CascadeMid
000D2Cr 2  85 rr          sta Tmp1
000D2Er 2  AD rr rr       lda CascadeHi
000D31r 2  85 rr          sta Tmp2
000D33r 2  4C rr rr       jmp ScoreBank
000D36r 2               
000D36r 2               ; -----------------------------------------------------------------------------
000D36r 2               ;   ScoreAward — add a 16-bit BCD value straight to Score
000D36r 2               ;   In:  A = low BCD byte, X = high BCD byte
000D36r 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
000D36r 2               ;
000D36r 2               ;   The two awards SPEC 9.6 gives outside a cascade: one point a row for a
000D36r 2               ;   soft drop, and BONUS_LEVELUP when the level advances. Neither is a cascade
000D36r 2               ;   point and neither is doubled by a star, which is the whole reason they do
000D36r 2               ;   not go through CascadeAdd.
000D36r 2               ; -----------------------------------------------------------------------------
000D36r 2               ScoreAward:
000D36r 2  85 rr          sta Tmp0
000D38r 2  86 rr          stx Tmp1
000D3Ar 2  A9 00          lda #0
000D3Cr 2  85 rr          sta Tmp2
000D3Er 2                 ; falls through into ScoreBank
000D3Er 2               
000D3Er 2               ; -----------------------------------------------------------------------------
000D3Er 2               ;   ScoreBank — Score += the three BCD bytes in Tmp0-Tmp2, clamped at 9999999
000D3Er 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
000D3Er 2               ;
000D3Er 2               ;   The only writer of Score. It redraws the field itself, because there is no
000D3Er 2               ;   other moment at which the score is known to have changed (SPEC 12.6 —
000D3Er 2               ;   nothing polls).
000D3Er 2               ; -----------------------------------------------------------------------------
000D3Er 2               ScoreBank:
000D3Er 2  F8             sed
000D3Fr 2  18             clc
000D40r 2  AD rr rr       lda ScoreLo
000D43r 2  65 rr          adc Tmp0
000D45r 2  8D rr rr       sta ScoreLo
000D48r 2  AD rr rr       lda ScoreMid
000D4Br 2  65 rr          adc Tmp1
000D4Dr 2  8D rr rr       sta ScoreMid
000D50r 2  AD rr rr       lda ScoreHi
000D53r 2  65 rr          adc Tmp2
000D55r 2  8D rr rr       sta ScoreHi
000D58r 2  AD rr rr       lda ScoreTop
000D5Br 2  69 00          adc #0
000D5Dr 2  8D rr rr       sta ScoreTop
000D60r 2  D8             cld                           ; CLD leaves the carry alone
000D61r 2  B0 07          bcs @Clamp
000D63r 2  AD rr rr       lda ScoreTop                  ; The eighth digit is held at zero (SPEC 9),
000D66r 2  C9 10          cmp #$10                      ;   so anything that reached it has overflowed
000D68r 2  90 10          bcc @Drawn                    ;   the seven the panel shows
000D6Ar 2               @Clamp:
000D6Ar 2  A9 99          lda #$99
000D6Cr 2  8D rr rr       sta ScoreLo
000D6Fr 2  8D rr rr       sta ScoreMid
000D72r 2  8D rr rr       sta ScoreHi
000D75r 2  A9 09          lda #$09
000D77r 2  8D rr rr       sta ScoreTop
000D7Ar 2               @Drawn:
000D7Ar 2  20 rr rr       jsr RenderScore
000D7Dr 2                 ; falls through into ScoreHighCheck
000D7Dr 2               
000D7Dr 2               ; -----------------------------------------------------------------------------
000D7Dr 2               ;   ScoreHighCheck — hand the high score over the moment the score reaches it
000D7Dr 2               ;   Out: C set if the score is level with or past the high score — which, once
000D7Dr 2               ;        it has been taken, is EVERY call. The one-shot is HighOwned below, not
000D7Dr 2               ;        this flag; nothing currently reads it.  Modifies: A, X, Y, Tmp0
000D7Dr 2               ;
000D7Dr 2               ;   SPEC 9.8. The copy happens on every call once the score is level with the
000D7Dr 2               ;   high score, not just on the first — that is what keeps HighLevel tracking
000D7Dr 2               ;   the live level while a run is holding its own record, which is the point of
000D7Dr 2               ;   the number: it says how deep you have to get to beat it.
000D7Dr 2               ;
000D7Dr 2               ;   The fanfare and the flash are the one-shot half, and HighOwned is what
000D7Dr 2               ;   makes them one: without it every subsequent bank would fire them again,
000D7Dr 2               ;   because from the overtake onward the score and the high score are equal.
000D7Dr 2               ; -----------------------------------------------------------------------------
000D7Dr 2               ScoreHighCheck:
000D7Dr 2  AD rr rr       lda HighTop                   ; Four-byte compare, most significant first
000D80r 2  CD rr rr       cmp ScoreTop
000D83r 2  D0 16          bne @Test
000D85r 2  AD rr rr       lda HighHi
000D88r 2  CD rr rr       cmp ScoreHi
000D8Br 2  D0 0E          bne @Test
000D8Dr 2  AD rr rr       lda HighMid
000D90r 2  CD rr rr       cmp ScoreMid
000D93r 2  D0 06          bne @Test
000D95r 2  AD rr rr       lda HighLo
000D98r 2  CD rr rr       cmp ScoreLo
000D9Br 2               @Test:
000D9Br 2  90 02          bcc @Take                     ; high < score
000D9Dr 2  D0 3E          bne @Behind                   ; high > score — nothing to do
000D9Fr 2                                               ; equal: still copy, so HighLevel tracks
000D9Fr 2               @Take:
000D9Fr 2  AD rr rr       lda ScoreLo
000DA2r 2  8D rr rr       sta HighLo
000DA5r 2  AD rr rr       lda ScoreMid
000DA8r 2  8D rr rr       sta HighMid
000DABr 2  AD rr rr       lda ScoreHi
000DAEr 2  8D rr rr       sta HighHi
000DB1r 2  AD rr rr       lda ScoreTop
000DB4r 2  8D rr rr       sta HighTop
000DB7r 2  20 rr rr       jsr ScoreLevelBcd             ; The level box under the digits is BCD; Level
000DBAr 2  8D rr rr       sta HighLevel                 ;   itself is binary (SPEC 12.2)
000DBDr 2  20 rr rr       jsr RenderHigh
000DC0r 2               
000DC0r 2  AD rr rr       lda HighOwned
000DC3r 2  D0 16          bne @Owned
000DC5r 2  EE rr rr       inc HighOwned
000DC8r 2  A9 0B          lda #SFX_HIGHSCORE            ; SPEC 9.8 — a longer fanfare, once
000DCAr 2  8D rr rr       sta SfxRequest
000DCDr 2  A9 06          lda #HIGH_FLASH_BLINKS
000DCFr 2  8D rr rr       sta HighFlash
000DD2r 2  AE rr rr       ldx Region
000DD5r 2  BD rr rr       lda BlinkHalf,x
000DD8r 2  8D rr rr       sta HighTimer
000DDBr 2               @Owned:
000DDBr 2  38             sec
000DDCr 2  60             rts
000DDDr 2               
000DDDr 2               @Behind:
000DDDr 2  18             clc
000DDEr 2  60             rts
000DDFr 2               
000DDFr 2               ; -----------------------------------------------------------------------------
000DDFr 2               ;   ScoreLevelBcd — Level (binary 1-99) as one packed BCD byte
000DDFr 2               ;   Out: A = the level in BCD.  Modifies: A, X, Tmp0
000DDFr 2               ; -----------------------------------------------------------------------------
000DDFr 2               ScoreLevelBcd:
000DDFr 2  AD rr rr       lda Level
000DE2r 2  A2 00          ldx #0
000DE4r 2               @Tens:
000DE4r 2  C9 0A          cmp #10
000DE6r 2  90 05          bcc @Split
000DE8r 2  E9 0A          sbc #10                       ; Carry is set by the CMP that got us here
000DEAr 2  E8             inx
000DEBr 2  D0 F7          bne @Tens                     ; Always — X tops out at 9
000DEDr 2               @Split:
000DEDr 2  85 rr          sta Tmp0                      ; Units
000DEFr 2  8A             txa
000DF0r 2  0A             asl a
000DF1r 2  0A             asl a
000DF2r 2  0A             asl a
000DF3r 2  0A             asl a
000DF4r 2  05 rr          ora Tmp0
000DF6r 2  60             rts
000DF7r 2               
000DF7r 2               ; -----------------------------------------------------------------------------
000DF7r 2               ;   ScoreSoftDrop — one point for one row descended under soft drop (SPEC 9.6)
000DF7r 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0-Tmp2
000DF7r 2               ;
000DF7r 2               ;   The one award in the game that is not a multiple of ten. BCD does not care.
000DF7r 2               ; -----------------------------------------------------------------------------
000DF7r 2               ScoreSoftDrop:
000DF7r 2  A9 01          lda #$01
000DF9r 2  A2 00          ldx #$00
000DFBr 2  4C rr rr       jmp ScoreAward
000DFEr 2               
000DFEr 2               ; -----------------------------------------------------------------------------
000DFEr 2               ;   ScoreLevelCheck — advance the level when 30 tiles have gone
000DFEr 2               ;   In:  A = tiles removed this step
000DFEr 2               ;   Out: C set if the level advanced.  Modifies: A, X, Y, Tmp0-Tmp2
000DFEr 2               ;   SPEC 10.1 — at most one advance per step, surplus carries over, so a big
000DFEr 2               ;   fireball chain can never skip a level. Match and effect removals both
000DFEr 2               ;   count, which is why the count comes from CascadeRemove and not from the
000DFEr 2               ;   scan: by then the two are the same cells.
000DFEr 2               ; -----------------------------------------------------------------------------
000DFEr 2               ScoreLevelCheck:
000DFEr 2  18             clc
000DFFr 2  6D rr rr       adc TilesCleared
000E02r 2  8D rr rr       sta TilesCleared              ; A whole step can clear far more than thirty;
000E05r 2  C9 1E          cmp #LEVEL_TILES              ;   the surplus stays here and buys the next
000E07r 2  90 23          bcc @No                       ;   level on the next step
000E09r 2  E9 1E          sbc #LEVEL_TILES              ; Carry is set by the CMP that got us here
000E0Br 2  8D rr rr       sta TilesCleared
000E0Er 2               
000E0Er 2  AD rr rr       lda Level
000E11r 2  C9 63          cmp #LEVEL_MAX_SHOWN
000E13r 2  B0 17          bcs @No                       ; The box is two digits wide (SPEC 10.1), and
000E15r 2  EE rr rr       inc Level                     ;   nothing about level 100 is reachable in a
000E18r 2  20 rr rr       jsr RenderLevel               ;   session anyway
000E1Br 2  20 rr rr       jsr AnimBannerLevel           ; SPEC 14 — and play carries straight on; the
000E1Er 2                                               ;   band clears itself BannerFrames later
000E1Er 2  A9 0A          lda #SFX_LEVELUP
000E20r 2  8D rr rr       sta SfxRequest
000E23r 2  A9 00          lda #<BONUS_LEVELUP           ; SPEC 9.6 — an award, not a cascade point, so
000E25r 2  A2 10          ldx #>BONUS_LEVELUP           ;   a star in the same cascade does not double
000E27r 2  20 rr rr       jsr ScoreAward                ;   it (D5)
000E2Ar 2  38             sec
000E2Br 2  60             rts
000E2Cr 2               @No:
000E2Cr 2  18             clc
000E2Dr 2  60             rts
000E2Er 2               
000E2Er 2               ; -----------------------------------------------------------------------------
000E2Er 2               ;   ScoreFlashTick — one frame of the HIGH field's overtake flash
000E2Er 2               ;   Out: nothing.  Modifies: A, X, Y
000E2Er 2               ;   SPEC 9.8, SPEC 14 — the blink period is 30 frames NTSC / 25 PAL, shared
000E2Er 2               ;   with the title screen's prompt, so HighFlash counts HALF blinks and
000E2Er 2               ;   HighTimer counts the frames of one.
000E2Er 2               ;
000E2Er 2               ;   HighFlash is odd on the dark half and even on the lit one, and it ends at
000E2Er 2               ;   zero, so the field is always left readable however the count is set.
000E2Er 2               ; -----------------------------------------------------------------------------
000E2Er 2               ScoreFlashTick:
000E2Er 2  AD rr rr       lda HighFlash
000E31r 2  F0 1F          beq @Done
000E33r 2  CE rr rr       dec HighTimer
000E36r 2  D0 1A          bne @Done
000E38r 2  CE rr rr       dec HighFlash
000E3Br 2  F0 12          beq @Show                     ; Out of blinks — end lit
000E3Dr 2  AE rr rr       ldx Region
000E40r 2  BD rr rr       lda BlinkHalf,x
000E43r 2  8D rr rr       sta HighTimer
000E46r 2  AD rr rr       lda HighFlash
000E49r 2  4A             lsr a
000E4Ar 2  90 03          bcc @Show
000E4Cr 2  4C rr rr       jmp RenderHighBlank
000E4Fr 2               @Show:
000E4Fr 2  4C rr rr       jmp RenderHigh
000E52r 2               @Done:
000E52r 2  60             rts
000E53r 2               
000E53r 2               ; -----------------------------------------------------------------------------
000E53r 2               ;   ScoreGravity — frames per row for the current level
000E53r 2               ;   Out: A = frame count, from SpeedNTSC or SpeedPAL per Region.
000E53r 2               ;        Modifies: A, X
000E53r 2               ;   SPEC 10.2. Strictly this module is P4's, but the falling piece cannot fall
000E53r 2               ;   without it, so it is real ahead of the rest of the file — the same reason
000E53r 2               ;   ScoreHighInit landed here in P1.
000E53r 2               ; -----------------------------------------------------------------------------
000E53r 2               ScoreGravity:
000E53r 2  AE rr rr       ldx Level
000E56r 2  CA             dex                           ; The table is indexed by level - 1 ...
000E57r 2  E0 10          cpx #LEVEL_SPEED_CAP
000E59r 2  90 02          bcc @Level
000E5Br 2  A2 0F          ldx #LEVEL_SPEED_CAP - 1      ;   ... and stops improving at the cap
000E5Dr 2               @Level:
000E5Dr 2  AD rr rr       lda Region
000E60r 2  D0 04          bne @Pal
000E62r 2  BD rr rr       lda SpeedNTSC,x
000E65r 2  60             rts
000E66r 2               @Pal:
000E66r 2  BD rr rr       lda SpeedPAL,x
000E69r 2  60             rts
000E6Ar 2               
000E6Ar 1               .include "../src/render.asm"
000E6Ar 2               ; =============================================================================
000E6Ar 2               ;   render.asm — Wizards Lab, the dirty-cell renderer
000E6Ar 2               ; =============================================================================
000E6Ar 2               ;   SPEC.md section 12.6. The screen is never fully redrawn during play.
000E6Ar 2               ;   Changed cells are appended to a ring and flushed once a frame, at most
000E6Ar 2               ;   DIRTY_FLUSH_MAX per frame with the remainder carried over.
000E6Ar 2               ;
000E6Ar 2               ;   The cap is NOT a hardware write-spacing limit. S1 measured this loop at
000E6Ar 2               ;   165 cycles a cell on the AC6502, which puts two VRAM data writes 165 us
000E6Ar 2               ;   apart at 1 MHz and the closest two VDP PORT accesses 8 cycles apart —
000E6Ar 2               ;   inside even a real TMS9918A's 8 us and 2 us windows with two orders of
000E6Ar 2               ;   magnitude to spare, and further inside a pico9918's, which emulates VRAM
000E6Ar 2               ;   in RP2040 memory and has no display contention at all. A 6502 at this
000E6Ar 2               ;   clock cannot write a TMS9918 too fast however hard it tries.
000E6Ar 2               ;
000E6Ar 2               ;   The cap is a TIME BUDGET: DIRTY_FLUSH_MAX cells is what fits in vertical
000E6Ar 2               ;   blank on the tightest of the three. See constants.inc and PLAN.md S1.
000E6Ar 2               ;
000E6Ar 2               ;   All screen access goes through HalPlotCell (see hal.inc). Nothing in this
000E6Ar 2               ;   file knows where screen memory is.
000E6Ar 2               ; =============================================================================
000E6Ar 2               
000E6Ar 2               ; -----------------------------------------------------------------------------
000E6Ar 2               ;   RenderDirtyReset — empty the ring and cancel any outstanding board redraw
000E6Ar 2               ;   Call this after anything that draws the whole screen behind the renderer's
000E6Ar 2               ;   back (HalBlitScreen), because every queued cell then describes a screen
000E6Ar 2               ;   that no longer exists.
000E6Ar 2               ;   In:  nothing        Out: nothing.  Modifies: A
000E6Ar 2               ; -----------------------------------------------------------------------------
000E6Ar 2               RenderDirtyReset:
000E6Ar 2  A9 00          lda #0
000E6Cr 2  8D rr rr       sta DirtyCount
000E6Fr 2  8D rr rr       sta DirtyHead
000E72r 2  8D rr rr       sta DirtyTail
000E75r 2  8D rr rr       sta RedrawWash
000E78r 2  A9 FF          lda #$FF
000E7Ar 2  8D rr rr       sta RedrawIdx
000E7Dr 2  60             rts
000E7Er 2               
000E7Er 2               ; -----------------------------------------------------------------------------
000E7Er 2               ;   RenderMark — queue one panel cell
000E7Er 2               ;   In:  A = tile, X = panel column, Y = panel row
000E7Er 2               ;   Out: nothing.  Modifies: A, X.  PRESERVES Y and every byte of zero page.
000E7Er 2               ;
000E7Er 2               ;   The PANEL_X / PANEL_Y offset is applied here, once, so nothing upstream
000E7Er 2               ;   has to know which machine it is running on.
000E7Er 2               ;
000E7Er 2               ;   Preserving Y and zero page is a contract, not an accident: text.asm holds
000E7Er 2               ;   its string cursor across this call (see zeropage.inc). The three values
000E7Er 2               ;   ride the stack rather than scratch bytes because A, X and Y are all live
000E7Er 2               ;   at once and there is no fourth register to index the ring with.
000E7Er 2               ;
000E7Er 2               ;   A mark that arrives with the ring full is DROPPED, silently (D6).
000E7Er 2               ; -----------------------------------------------------------------------------
000E7Er 2               RenderMark:
000E7Er 2  48             pha                           ; Tile
000E7Fr 2  98             tya
000E80r 2  18             clc
000E81r 2  69 00          adc #PANEL_Y                  ; Panel row -> screen row
000E83r 2  48             pha
000E84r 2  8A             txa
000E85r 2  18             clc
000E86r 2  69 05          adc #PANEL_X                  ; Panel column -> screen column
000E88r 2  48             pha
000E89r 2               
000E89r 2  AD rr rr       lda DirtyCount
000E8Cr 2  C9 40          cmp #DIRTY_ENTRIES
000E8Er 2  B0 1F          bcs @Full
000E90r 2  EE rr rr       inc DirtyCount
000E93r 2               
000E93r 2  AE rr rr       ldx DirtyTail
000E96r 2  68             pla
000E97r 2  9D rr rr       sta Dirty+0,x                 ; Screen column
000E9Ar 2  68             pla
000E9Br 2  9D rr rr       sta Dirty+1,x                 ; Screen row
000E9Er 2  68             pla
000E9Fr 2  9D rr rr       sta Dirty+2,x                 ; Tile
000EA2r 2               
000EA2r 2  E8             inx                           ; Step one entry, wrapping the ring
000EA3r 2  E8             inx
000EA4r 2  E8             inx
000EA5r 2  E0 C0          cpx #DIRTY_BYTES
000EA7r 2  90 02          bcc @Store
000EA9r 2  A2 00          ldx #0
000EABr 2               @Store:
000EABr 2  8E rr rr       stx DirtyTail
000EAEr 2  60             rts
000EAFr 2               
000EAFr 2               @Full:
000EAFr 2  68             pla                           ; Unwind and drop it. The cell is wrong until
000EB0r 2  68             pla                           ;   something marks it again.
000EB1r 2  68             pla
000EB2r 2  60             rts
000EB3r 2               
000EB3r 2               ; -----------------------------------------------------------------------------
000EB3r 2               ;   RenderFlush — push up to DIRTY_FLUSH_MAX queued cells to the screen
000EB3r 2               ;   Called once per frame, from the top of the main loop.
000EB3r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
000EB3r 2               ; -----------------------------------------------------------------------------
000EB3r 2               RenderFlush:
000EB3r 2  20 rr rr       jsr RenderBoardStep           ; Top the ring up from a board redraw, if one
000EB6r 2                                               ;   is outstanding, so it always makes progress
000EB6r 2  AD rr rr       lda DirtyCount
000EB9r 2  F0 31          beq @Done
000EBBr 2  C9 18          cmp #DIRTY_FLUSH_MAX
000EBDr 2  90 02          bcc @Budget
000EBFr 2  A9 18          lda #DIRTY_FLUSH_MAX
000EC1r 2               @Budget:
000EC1r 2  85 rr          sta FlushLeft
000EC3r 2               
000EC3r 2               @Cell:
000EC3r 2  AE rr rr       ldx DirtyHead
000EC6r 2  BD rr rr       lda Dirty+1,x
000EC9r 2  A8             tay                           ; Y = screen row
000ECAr 2  BD rr rr       lda Dirty+2,x
000ECDr 2  48             pha                           ; Tile
000ECEr 2  BD rr rr       lda Dirty+0,x
000ED1r 2  AA             tax                           ; X = screen column
000ED2r 2  68             pla                           ; A = tile
000ED3r 2  20 rr rr       jsr HalPlotCell
000ED6r 2               
000ED6r 2  AD rr rr       lda DirtyHead                 ; Step one entry, wrapping the ring
000ED9r 2  18             clc
000EDAr 2  69 03          adc #3
000EDCr 2  C9 C0          cmp #DIRTY_BYTES
000EDEr 2  90 02          bcc @Store
000EE0r 2  A9 00          lda #0
000EE2r 2               @Store:
000EE2r 2  8D rr rr       sta DirtyHead
000EE5r 2  CE rr rr       dec DirtyCount
000EE8r 2  C6 rr          dec FlushLeft
000EEAr 2  D0 D7          bne @Cell
000EECr 2               @Done:
000EECr 2  60             rts
000EEDr 2               
000EEDr 2               ; -----------------------------------------------------------------------------
000EEDr 2               ;   RenderBoard — ask for the whole 6 x 16 well to be redrawn
000EEDr 2               ;   Used on state entry and after a pause, not per frame.
000EEDr 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000EEDr 2               ;
000EEDr 2               ;   The well is 96 cells and the ring holds DIRTY_ENTRIES; a redraw therefore
000EEDr 2               ;   cannot be queued in one go. This only sets the cursor. RenderBoardStep,
000EEDr 2               ;   which RenderFlush calls every frame, feeds the ring as fast as it drains,
000EEDr 2               ;   so the redraw spreads over as many frames as it needs and never drops a
000EEDr 2               ;   cell.
000EEDr 2               ; -----------------------------------------------------------------------------
000EEDr 2               RenderBoard:
000EEDr 2  A9 00          lda #0
000EEFr 2  8D rr rr       sta RedrawWash                ; From the board, not the PAUSE wash
000EF2r 2  8D rr rr       sta RedrawIdx                 ; Board index 0 = row 0, column 0
000EF5r 2  60             rts                           ; And nothing else. Falling through into the
000EF6r 2                                               ;   step below would fill the ring here and
000EF6r 2                                               ;   drop whatever the caller marks next.
000EF6r 2               
000EF6r 2               ; -----------------------------------------------------------------------------
000EF6r 2               ;   RenderWash — ask for the well to be covered rather than shown
000EF6r 2               ;   In:  nothing        Out: nothing.  Modifies: A
000EF6r 2               ;   SPEC 13.3 — pausing washes all 96 cells with TILE_WASH so the board cannot
000EF6r 2               ;   be studied while the clock is stopped. A wash and not a blank: a blanked
000EF6r 2               ;   well reads as a crash, a stippled one reads as covered.
000EF6r 2               ;
000EF6r 2               ;   The same cursor as RenderBoard, because it is the same 96 cells against
000EF6r 2               ;   the same 64-entry ring, and it is undone the same way — the resume calls
000EF6r 2               ;   RenderBoard, which turns the flag off and repaints every cell from the
000EF6r 2               ;   board it never stopped being (D12).
000EF6r 2               ; -----------------------------------------------------------------------------
000EF6r 2               RenderWash:
000EF6r 2  A9 07          lda #TILE_WASH
000EF8r 2  8D rr rr       sta RedrawWash
000EFBr 2  A9 00          lda #0
000EFDr 2  8D rr rr       sta RedrawIdx
000F00r 2  60             rts
000F01r 2               
000F01r 2               ; -----------------------------------------------------------------------------
000F01r 2               ;   RenderBoardStep — queue as much of an outstanding board redraw as fits
000F01r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000F01r 2               ;   Does nothing when RedrawIdx is $FF.
000F01r 2               ; -----------------------------------------------------------------------------
000F01r 2               RenderBoardStep:
000F01r 2  AD rr rr       lda RedrawIdx
000F04r 2  30 46          bmi @Done                     ; $FF — nothing outstanding
000F06r 2               
000F06r 2               @Cell:
000F06r 2  AD rr rr       lda DirtyCount
000F09r 2  C9 40          cmp #DIRTY_ENTRIES
000F0Br 2  B0 3F          bcs @Done                     ; Ring full — pick this cell up next frame
000F0Dr 2               
000F0Dr 2  AE rr rr       ldx RedrawIdx
000F10r 2  8A             txa
000F11r 2  29 07          and #(BOARD_STRIDE - 1)
000F13r 2  18             clc
000F14r 2  69 01          adc #WELL_ORIGIN_X
000F16r 2  85 rr          sta RedrawCol
000F18r 2  8A             txa
000F19r 2  4A             lsr a                         ; Board index >> 3 is the row (stride 8)
000F1Ar 2  4A             lsr a
000F1Br 2  4A             lsr a
000F1Cr 2  18             clc
000F1Dr 2  69 04          adc #WELL_ORIGIN_Y
000F1Fr 2  A8             tay                           ; Y = panel row
000F20r 2  AD rr rr       lda RedrawWash                ; The PAUSE wash is the same walk drawing one
000F23r 2  D0 03          bne @Tile                     ;   tile over every cell instead (SPEC 13.3)
000F25r 2  BD rr rr       lda Board,x                   ; The board byte IS the tile — empty is $00,
000F28r 2               @Tile:                          ;   which is TILE_BLANK (SPEC 3.3, 4.2)
000F28r 2  A6 rr          ldx RedrawCol
000F2Ar 2  20 rr rr       jsr RenderMark
000F2Dr 2               
000F2Dr 2  AE rr rr       ldx RedrawIdx                 ; Advance, stepping over the two sentinel
000F30r 2  E8             inx                           ;   columns at the end of each row
000F31r 2  8A             txa
000F32r 2  29 07          and #(BOARD_STRIDE - 1)
000F34r 2  C9 06          cmp #BOARD_W
000F36r 2  90 05          bcc @Save
000F38r 2  8A             txa
000F39r 2  18             clc
000F3Ar 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000F3Cr 2  AA             tax
000F3Dr 2               @Save:
000F3Dr 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
000F3Fr 2  B0 06          bcs @Finish
000F41r 2  8E rr rr       stx RedrawIdx
000F44r 2  4C rr rr       jmp @Cell
000F47r 2               
000F47r 2               @Finish:
000F47r 2  A9 FF          lda #$FF
000F49r 2  8D rr rr       sta RedrawIdx
000F4Cr 2               @Done:
000F4Cr 2  60             rts
000F4Dr 2               
000F4Dr 2               ; -----------------------------------------------------------------------------
000F4Dr 2               ;   RenderCell — queue one board cell by board index
000F4Dr 2               ;   In:  X = board index (row * BOARD_STRIDE + column)
000F4Dr 2               ;   Out: nothing.  Modifies: A, X, Y
000F4Dr 2               ;   The single-cell form of RenderBoardStep, for the phases that move one tile
000F4Dr 2               ;   at a time.
000F4Dr 2               ; -----------------------------------------------------------------------------
000F4Dr 2               RenderCell:
000F4Dr 2  BD rr rr       lda Board,x                   ; The board byte IS the tile (SPEC 3.3)
000F50r 2                 ; falls through
000F50r 2               
000F50r 2               ; -----------------------------------------------------------------------------
000F50r 2               ;   RenderCellAs — queue one board cell showing something else entirely
000F50r 2               ;   In:  X = board index, A = tile
000F50r 2               ;   Out: nothing.  Modifies: A, X, Y
000F50r 2               ;
000F50r 2               ;   The animation frames are the only tiles in the game that are NOT what the
000F50r 2               ;   board holds: a glow glyph, a beam, a ring frame and a blip frame are all
000F50r 2               ;   drawn over a cell whose board byte still says what it really is, right up
000F50r 2               ;   until CascadeRemove zeroes it (anim.asm, SPEC 8 step 5). Everything else
000F50r 2               ;   goes through RenderCell above and never has to think about it.
000F50r 2               ; -----------------------------------------------------------------------------
000F50r 2               RenderCellAs:
000F50r 2  48             pha
000F51r 2  8A             txa
000F52r 2  29 07          and #(BOARD_STRIDE - 1)
000F54r 2  18             clc
000F55r 2  69 01          adc #WELL_ORIGIN_X
000F57r 2  85 rr          sta RedrawCol
000F59r 2  8A             txa
000F5Ar 2  4A             lsr a
000F5Br 2  4A             lsr a
000F5Cr 2  4A             lsr a
000F5Dr 2  18             clc
000F5Er 2  69 04          adc #WELL_ORIGIN_Y
000F60r 2  A8             tay
000F61r 2  68             pla
000F62r 2  A6 rr          ldx RedrawCol
000F64r 2  4C rr rr       jmp RenderMark
000F67r 2               
000F67r 2               ; -----------------------------------------------------------------------------
000F67r 2               ;   RenderPiece — queue the three falling cells at where the piece is now
000F67r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000F67r 2               ;
000F67r 2               ;   RenderMark clobbers X and keeps Y, so the panel column is parked in
000F67r 2               ;   RedrawCol and the panel row rides Y down the three cells. Cell C can never
000F67r 2               ;   be lower than board row 15, so all three are always inside the well and
000F67r 2               ;   there is nothing to clip.
000F67r 2               ; -----------------------------------------------------------------------------
000F67r 2               RenderPiece:
000F67r 2  AD rr rr       lda PieceCol
000F6Ar 2  18             clc
000F6Br 2  69 01          adc #WELL_ORIGIN_X
000F6Dr 2  85 rr          sta RedrawCol
000F6Fr 2  AD rr rr       lda PieceRow
000F72r 2  18             clc
000F73r 2  69 04          adc #WELL_ORIGIN_Y
000F75r 2  A8             tay
000F76r 2  AD rr rr       lda PieceA
000F79r 2  A6 rr          ldx RedrawCol
000F7Br 2  20 rr rr       jsr RenderMark
000F7Er 2  C8             iny
000F7Fr 2  AD rr rr       lda PieceB
000F82r 2  A6 rr          ldx RedrawCol
000F84r 2  20 rr rr       jsr RenderMark
000F87r 2  C8             iny
000F88r 2  AD rr rr       lda PieceC
000F8Br 2  A6 rr          ldx RedrawCol
000F8Dr 2  4C rr rr       jmp RenderMark
000F90r 2               
000F90r 2               ; -----------------------------------------------------------------------------
000F90r 2               ;   RenderPieceErase — blank the three cells the piece is leaving
000F90r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000F90r 2               ;
000F90r 2               ;   Three blanks rather than three board reads, because the cells under a
000F90r 2               ;   falling piece are always empty: every move and every gravity step tests
000F90r 2               ;   the target cells before it happens, and the one thing that writes them is
000F90r 2               ;   PieceLock, after which nothing erases the piece again (piece.asm).
000F90r 2               ; -----------------------------------------------------------------------------
000F90r 2               RenderPieceErase:
000F90r 2  AD rr rr       lda PieceCol
000F93r 2  18             clc
000F94r 2  69 01          adc #WELL_ORIGIN_X
000F96r 2  85 rr          sta RedrawCol
000F98r 2  AD rr rr       lda PieceRow
000F9Br 2  18             clc
000F9Cr 2  69 04          adc #WELL_ORIGIN_Y
000F9Er 2  A8             tay
000F9Fr 2  A9 00          lda #TILE_EMPTY
000FA1r 2  A6 rr          ldx RedrawCol
000FA3r 2  20 rr rr       jsr RenderMark
000FA6r 2  C8             iny
000FA7r 2  A9 00          lda #TILE_EMPTY
000FA9r 2  A6 rr          ldx RedrawCol
000FABr 2  20 rr rr       jsr RenderMark
000FAEr 2  C8             iny
000FAFr 2  A9 00          lda #TILE_EMPTY
000FB1r 2  A6 rr          ldx RedrawCol
000FB3r 2  4C rr rr       jmp RenderMark
000FB6r 2               
000FB6r 2               ; -----------------------------------------------------------------------------
000FB6r 2               ;   RenderNext — the preview, panel column NEXT_X, rows NEXT_Y..NEXT_Y+2
000FB6r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000FB6r 2               ;
000FB6r 2               ;   All three cells every time. The play screen image ships with a piece
000FB6r 2               ;   already drawn in the NEXT box (SPEC 12.1), so this has to overwrite rather
000FB6r 2               ;   than assume it is drawing onto backdrop.
000FB6r 2               ; -----------------------------------------------------------------------------
000FB6r 2               RenderNext:
000FB6r 2  A0 10          ldy #NEXT_Y
000FB8r 2  AD rr rr       lda NextA
000FBBr 2  A2 0B          ldx #NEXT_X
000FBDr 2  20 rr rr       jsr RenderMark
000FC0r 2  C8             iny
000FC1r 2  AD rr rr       lda NextB
000FC4r 2  A2 0B          ldx #NEXT_X
000FC6r 2  20 rr rr       jsr RenderMark
000FC9r 2  C8             iny
000FCAr 2  AD rr rr       lda NextC
000FCDr 2  A2 0B          ldx #NEXT_X
000FCFr 2  4C rr rr       jmp RenderMark
000FD2r 2               
000FD2r 2               ; -----------------------------------------------------------------------------
000FD2r 2               ;   RenderScore / RenderHigh / RenderLevel — only called when a value changes
000FD2r 2               ;   Nothing here compares anything: the caller knows when it changed a value
000FD2r 2               ;   and these are not cheap enough to run every frame. SCORE_DIGITS cells is
000FD2r 2               ;   most of a frame's flush budget on its own.
000FD2r 2               ; -----------------------------------------------------------------------------
000FD2r 2               RenderScore:
000FD2r 2  A9 rr          lda #<ScoreLo
000FD4r 2  85 rr          sta Ptr1
000FD6r 2  A9 rr          lda #>ScoreLo
000FD8r 2  85 rr          sta Ptr1+1
000FDAr 2  A2 0C          ldx #SCORE_X
000FDCr 2  A0 05          ldy #SCORE_Y
000FDEr 2  A9 07          lda #SCORE_DIGITS
000FE0r 2  4C rr rr       jmp TextBcd
000FE3r 2               
000FE3r 2               RenderHigh:
000FE3r 2  A9 rr          lda #<HighLo
000FE5r 2  85 rr          sta Ptr1
000FE7r 2  A9 rr          lda #>HighLo
000FE9r 2  85 rr          sta Ptr1+1
000FEBr 2  A2 0C          ldx #HIGH_X
000FEDr 2  A0 0A          ldy #HIGH_Y
000FEFr 2  A9 07          lda #SCORE_DIGITS
000FF1r 2  20 rr rr       jsr TextBcd
000FF4r 2               
000FF4r 2  A9 rr          lda #<HighLevel               ; The level it was set on, under the digits
000FF6r 2  85 rr          sta Ptr1
000FF8r 2  A9 rr          lda #>HighLevel
000FFAr 2  85 rr          sta Ptr1+1
000FFCr 2  A2 0F          ldx #HIGHLVL_X
000FFEr 2  A0 0B          ldy #HIGHLVL_Y
001000r 2  A9 02          lda #LEVEL_DIGITS
001002r 2  4C rr rr       jmp TextBcd
001005r 2               
001005r 2               ; -----------------------------------------------------------------------------
001005r 2               ;   RenderHighBlank — the dark half of the HIGH field's overtake flash
001005r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y, TextCol
001005r 2               ;   SPEC 9.8. The seven digits only; the level under them stays put, so the
001005r 2               ;   box never looks empty and the flash costs seven cells of the budget.
001005r 2               ; -----------------------------------------------------------------------------
001005r 2               RenderHighBlank:
001005r 2  A9 07          lda #SCORE_DIGITS
001007r 2  A2 0C          ldx #HIGH_X
001009r 2  A0 0A          ldy #HIGH_Y
00100Br 2  4C rr rr       jmp TextClearRun
00100Er 2               
00100Er 2               RenderLevel:
00100Er 2  AD rr rr       lda Level
001011r 2  4C rr rr       jmp TextLevel
001014r 2               
001014r 1               .include "../src/text.asm"
001014r 2               ; =============================================================================
001014r 2               ;   text.asm — Wizards Lab, text and numbers on the panel
001014r 2               ; =============================================================================
001014r 2               ;   The font lives in tile groups 2-6, forty glyphs in the order
001014r 2               ;
001014r 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
001014r 2               ;
001014r 2               ;   starting at FONT_BASE, so a digit is FONT_DIGIT_0 + value and a letter is
001014r 2               ;   FONT_LETTER_A + (letter - 'A'). Strings are stored pre-converted to tile
001014r 2               ;   numbers, terminated by TEXT_END, so drawing one is a copy with no
001014r 2               ;   translation. src/strings.inc holds them and the macro that encodes them.
001014r 2               ;
001014r 2               ;   Everything here draws through RenderMark, never to the screen: text is
001014r 2               ;   panel cells like any other and goes through the same one flush a frame.
001014r 2               ;   That is also why the cursor state lives in the zero-page block RenderMark
001014r 2               ;   promises not to touch (zeropage.inc) rather than in Tmp0-Tmp3.
001014r 2               ; =============================================================================
001014r 2               
001014r 2               ; -----------------------------------------------------------------------------
001014r 2               ;   TextDraw — draw a tile-encoded string
001014r 2               ;   In:  Ptr1 -> string (TEXT_END terminated), X = panel column, Y = panel row
001014r 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx
001014r 2               ; -----------------------------------------------------------------------------
001014r 2               TextDraw:
001014r 2  86 rr          stx TextCol
001016r 2  84 rr          sty TextRow
001018r 2  A9 00          lda #0
00101Ar 2  85 rr          sta TextIdx
00101Cr 2               @Char:
00101Cr 2  A4 rr          ldy TextIdx
00101Er 2  B1 rr          lda (Ptr1),y
001020r 2  C9 FF          cmp #TEXT_END
001022r 2  F0 0D          beq @Done
001024r 2  A6 rr          ldx TextCol
001026r 2  A4 rr          ldy TextRow
001028r 2  20 rr rr       jsr RenderMark
00102Br 2  E6 rr          inc TextCol
00102Dr 2  E6 rr          inc TextIdx
00102Fr 2  D0 EB          bne @Char                     ; Always — a string is never 256 tiles long
001031r 2               @Done:
001031r 2  60             rts
001032r 2               
001032r 2               ; -----------------------------------------------------------------------------
001032r 2               ;   TextBcd — draw a packed-BCD number, zero padded
001032r 2               ;   In:  Ptr1 -> BCD bytes (low first), A = digit count,
001032r 2               ;        X = panel column, Y = panel row
001032r 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx, TextByte,
001032r 2               ;        TextSkip
001032r 2               ;
001032r 2               ;   SCORE_DIGITS (7) for the score and the high score, 2 for the high score's
001032r 2               ;   level. The LEVEL box is not drawn with this — see TextLevel.
001032r 2               ;
001032r 2               ;   The count is in DIGITS, not bytes, because the score is seven digits in
001032r 2               ;   four bytes: the top nibble of the most significant byte is held at zero
001032r 2               ;   (SPEC 9) and must not be drawn, or the field would be eight cells wide and
001032r 2               ;   no longer centred. An odd count starts at the LOW nibble of the top byte.
001032r 2               ;
001032r 2               ;   **Every digit is drawn, every time.** A leading zero is a zero glyph, not
001032r 2               ;   a blank: 1250 draws as 0001250. There is no suppression pass and no
001032r 2               ;   right-alignment — the field is fixed width so a digit never changes
001032r 2               ;   column while the player is watching it (SPEC 9). This also makes the
001032r 2               ;   routine branchless, and lets RenderScore mark a fixed run of cells dirty.
001032r 2               ; -----------------------------------------------------------------------------
001032r 2               TextBcd:
001032r 2  86 rr          stx TextCol
001034r 2  84 rr          sty TextRow
001036r 2  48             pha                           ; Digit count
001037r 2  29 01          and #$01
001039r 2  85 rr          sta TextSkip                  ; Odd count: the top high nibble is not drawn
00103Br 2  68             pla
00103Cr 2  18             clc
00103Dr 2  69 01          adc #1                        ; Bytes = (digits + 1) / 2
00103Fr 2  4A             lsr a
001040r 2  AA             tax
001041r 2  CA             dex
001042r 2  86 rr          stx TextIdx                   ; Start at the most significant byte
001044r 2               
001044r 2               @Byte:
001044r 2  A4 rr          ldy TextIdx
001046r 2  B1 rr          lda (Ptr1),y
001048r 2  85 rr          sta TextByte
00104Ar 2               
00104Ar 2  A5 rr          lda TextSkip
00104Cr 2  D0 09          bne @Low
00104Er 2  A5 rr          lda TextByte
001050r 2  4A             lsr a
001051r 2  4A             lsr a
001052r 2  4A             lsr a
001053r 2  4A             lsr a
001054r 2  20 rr rr       jsr TextDigit
001057r 2               @Low:
001057r 2  A9 00          lda #0
001059r 2  85 rr          sta TextSkip
00105Br 2  A5 rr          lda TextByte
00105Dr 2  29 0F          and #$0F
00105Fr 2  20 rr rr       jsr TextDigit
001062r 2               
001062r 2  C6 rr          dec TextIdx
001064r 2  10 DE          bpl @Byte
001066r 2  60             rts
001067r 2               
001067r 2               ; -----------------------------------------------------------------------------
001067r 2               ;   TextDigit — draw one digit at the cursor and step it right
001067r 2               ;   In:  A = value 0-9      Modifies: A, X, Y, TextCol
001067r 2               ; -----------------------------------------------------------------------------
001067r 2               TextDigit:
001067r 2  18             clc
001068r 2  69 10          adc #FONT_DIGIT_0
00106Ar 2  A6 rr          ldx TextCol
00106Cr 2  A4 rr          ldy TextRow
00106Er 2  20 rr rr       jsr RenderMark
001071r 2  E6 rr          inc TextCol
001073r 2  60             rts
001074r 2               
001074r 2               ; -----------------------------------------------------------------------------
001074r 2               ;   TextBanner — centre a string in the one-row message band
001074r 2               ;   In:  Ptr1 -> string
001074r 2               ;   Out: nothing.  Modifies: A, X, Y and the text cursor
001074r 2               ;
001074r 2               ;   SPEC 12.2 — the band is panel row MSG_Y, full width, one row only. The
001074r 2               ;   string arrives already wrapped as `~~ TEXT ~~` — two FONT_TILDE, a blank,
001074r 2               ;   the text, a blank, two FONT_TILDE. Centring is (PANEL_W - length) / 2,
001074r 2               ;   which is why banner strings are drawn even-length.
001074r 2               ;
001074r 2               ;   THE BAND EITHER SIDE OF THE STRING IS BLANKED, and only that. Banners are
001074r 2               ;   not all the same width — `~~ PAUSED ~~` is two cells narrower than
001074r 2               ;   `~~ LEVEL UP ~~`, which is exactly what pausing during a level-up meets —
001074r 2               ;   so a shorter one drawn straight over a longer one would leave the tail of
001074r 2               ;   the old ornament sitting either side of it. Blanking the WHOLE band first
001074r 2               ;   would fix that too, and cost 18 marks on top of the string's: past
001074r 2               ;   DIRTY_FLUSH_MAX, so every banner in the game would take an extra frame to
001074r 2               ;   arrive. Blanking the margins costs only the cells the string is not
001074r 2               ;   covering — six for the narrowest banner in the game, two for the widest.
001074r 2               ; -----------------------------------------------------------------------------
001074r 2               TextBanner:
001074r 2  A0 00          ldy #0
001076r 2               @Len:
001076r 2  B1 rr          lda (Ptr1),y
001078r 2  C9 FF          cmp #TEXT_END
00107Ar 2  F0 03          beq @Got
00107Cr 2  C8             iny
00107Dr 2  D0 F7          bne @Len
00107Fr 2               @Got:
00107Fr 2  98             tya
001080r 2  85 rr          sta TextIdx
001082r 2  A9 16          lda #PANEL_W
001084r 2  38             sec
001085r 2  E5 rr          sbc TextIdx
001087r 2  4A             lsr a                         ; (PANEL_W - length) / 2
001088r 2  85 rr          sta TextByte                  ; Where the string starts...
00108Ar 2  18             clc
00108Br 2  65 rr          adc TextIdx
00108Dr 2  85 rr          sta TextSkip                  ; ...and one cell past where it ends. Neither
00108Fr 2                                               ;   is TextCol / TextRow / TextIdx, because
00108Fr 2                                               ;   TextClearRun below takes those
00108Fr 2               
00108Fr 2  A5 rr          lda TextByte                  ; The band to the left of it
001091r 2  38             sec
001092r 2  E9 02          sbc #MSG_X
001094r 2  F0 07          beq @Right
001096r 2  A2 02          ldx #MSG_X
001098r 2  A0 16          ldy #MSG_Y
00109Ar 2  20 rr rr       jsr TextClearRun
00109Dr 2               @Right:
00109Dr 2  A9 14          lda #(MSG_X + MSG_W)          ; ...and to the right
00109Fr 2  38             sec
0010A0r 2  E5 rr          sbc TextSkip
0010A2r 2  F0 07          beq @Draw
0010A4r 2  A6 rr          ldx TextSkip
0010A6r 2  A0 16          ldy #MSG_Y
0010A8r 2  20 rr rr       jsr TextClearRun
0010ABr 2               @Draw:
0010ABr 2  A6 rr          ldx TextByte
0010ADr 2  A0 16          ldy #MSG_Y
0010AFr 2  4C rr rr       jmp TextDraw
0010B2r 2               
0010B2r 2               ; -----------------------------------------------------------------------------
0010B2r 2               ;   TextBannerClear — blank the message band back to backdrop
0010B2r 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx
0010B2r 2               ;
0010B2r 2               ;   Columns MSG_X .. MSG_X + MSG_W - 1 only. The shelf tiles at either end of
0010B2r 2               ;   the band belong to the static screen image and are never redrawn.
0010B2r 2               ; -----------------------------------------------------------------------------
0010B2r 2               TextBannerClear:
0010B2r 2  A9 12          lda #MSG_W
0010B4r 2  A2 02          ldx #MSG_X
0010B6r 2  A0 16          ldy #MSG_Y
0010B8r 2                 ; falls through
0010B8r 2               
0010B8r 2               ; -----------------------------------------------------------------------------
0010B8r 2               ;   TextClearRun — blank a horizontal run of panel cells
0010B8r 2               ;   In:  A = width (never 0), X = panel column, Y = panel row
0010B8r 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx
0010B8r 2               ;
0010B8r 2               ;   Three callers wanted this loop with different numbers in it: the message
0010B8r 2               ;   band above, the HIGH field's dark half (SPEC 9.8) and the title screen's
0010B8r 2               ;   blinking prompt (SPEC 13.1). The cursor is in memory for the usual reason —
0010B8r 2               ;   RenderMark clobbers A and X and keeps only Y (D13).
0010B8r 2               ; -----------------------------------------------------------------------------
0010B8r 2               TextClearRun:
0010B8r 2  85 rr          sta TextIdx                   ; Cells left
0010BAr 2  86 rr          stx TextCol
0010BCr 2  84 rr          sty TextRow
0010BEr 2               @Cell:
0010BEr 2  A9 00          lda #TILE_BLANK
0010C0r 2  A6 rr          ldx TextCol
0010C2r 2  A4 rr          ldy TextRow
0010C4r 2  20 rr rr       jsr RenderMark
0010C7r 2  E6 rr          inc TextCol
0010C9r 2  C6 rr          dec TextIdx
0010CBr 2  D0 F1          bne @Cell
0010CDr 2  60             rts
0010CEr 2               
0010CEr 2               ; -----------------------------------------------------------------------------
0010CEr 2               ;   TextLevel — the LEVEL box, tens above units in one column
0010CEr 2               ;   In:  A = level (binary, 1-99)
0010CEr 2               ;   Out: nothing.  Modifies: A, X, Y, TextByte
0010CEr 2               ;   SPEC 12.2 — LEVEL_X, tens at LEVEL_Y and units at LEVEL_Y + 1. Always two
0010CEr 2               ;   digits: level 5 draws "0" over "5".
0010CEr 2               ; -----------------------------------------------------------------------------
0010CEr 2               TextLevel:
0010CEr 2  A2 00          ldx #0
0010D0r 2               @Tens:
0010D0r 2  C9 0A          cmp #10
0010D2r 2  90 05          bcc @Split
0010D4r 2  E9 0A          sbc #10                       ; Carry is set by the CMP that got us here
0010D6r 2  E8             inx
0010D7r 2  D0 F7          bne @Tens                     ; Always — X tops out at 9
0010D9r 2               @Split:
0010D9r 2  85 rr          sta TextByte                  ; Units
0010DBr 2  8A             txa
0010DCr 2  18             clc
0010DDr 2  69 10          adc #FONT_DIGIT_0
0010DFr 2  A2 12          ldx #LEVEL_X
0010E1r 2  A0 11          ldy #LEVEL_Y
0010E3r 2  20 rr rr       jsr RenderMark
0010E6r 2  A5 rr          lda TextByte
0010E8r 2  18             clc
0010E9r 2  69 10          adc #FONT_DIGIT_0
0010EBr 2  A2 12          ldx #LEVEL_X
0010EDr 2  A0 12          ldy #LEVEL_Y + 1
0010EFr 2  4C rr rr       jmp RenderMark
0010F2r 2               
0010F2r 1               .include "../src/audio.asm"
0010F2r 2               ; =============================================================================
0010F2r 2               ;   audio.asm — Wizards Lab, sound
0010F2r 2               ; =============================================================================
0010F2r 2               ;   SPEC.md section 16. Out of scope for the first playable build, but the
0010F2r 2               ;   hook is here from the start so game logic never has to be revisited to add
0010F2r 2               ;   it: logic writes an effect id to SfxRequest and forgets about it.
0010F2r 2               ;
0010F2r 2               ;   The AC6502 and the C64 both have a SID and can share a driver — only the
0010F2r 2               ;   register base differs ($9800 against $D400). The VIC-20 needs its own,
0010F2r 2               ;   against $900A-$900E.
0010F2r 2               ; =============================================================================
0010F2r 2               
0010F2r 2               SFX_MOVE        = 1
0010F2r 2               SFX_ROTATE      = 2
0010F2r 2               SFX_LOCK        = 3
0010F2r 2               SFX_MATCH       = 4
0010F2r 2               SFX_FIREBALL    = 5
0010F2r 2               SFX_BOLT        = 6
0010F2r 2               SFX_BOMB        = 7
0010F2r 2               SFX_STAR        = 8
0010F2r 2               SFX_PRISM       = 9
0010F2r 2               SFX_LEVELUP     = 10
0010F2r 2               SFX_HIGHSCORE   = 11
0010F2r 2               SFX_GAMEOVER    = 12
0010F2r 2               
0010F2r 2               ; -----------------------------------------------------------------------------
0010F2r 2               ;   AudioInit — silence everything
0010F2r 2               ; -----------------------------------------------------------------------------
0010F2r 2               AudioInit:
0010F2r 2  A9 00          lda #0
0010F4r 2  8D rr rr       sta SfxRequest
0010F7r 2  8D rr rr       sta SfxTimer
0010FAr 2  60             rts
0010FBr 2               
0010FBr 2               ; -----------------------------------------------------------------------------
0010FBr 2               ;   AudioTick — called once per frame, consumes SfxRequest
0010FBr 2               ; -----------------------------------------------------------------------------
0010FBr 2               AudioTick:
0010FBr 2                 ; TODO: start a new effect when SfxRequest is non-zero, then advance the
0010FBr 2                 ; envelope of whatever is playing. Calls HalSfx for the register writes.
0010FBr 2  A9 00          lda #0
0010FDr 2  8D rr rr       sta SfxRequest
001100r 2  60             rts
001101r 2               
001101r 1               
001101r 1               ; =============================================================================
001101r 1               ;   HAL — TMS9918 Graphics Mode I
001101r 1               ; =============================================================================
001101r 1               
001101r 1               ; -----------------------------------------------------------------------------
001101r 1               ;   VdpSetWrite — point the VDP at a VRAM address for writing
001101r 1               ;   In:  A = address low, X = address high
001101r 1               ; -----------------------------------------------------------------------------
001101r 1               VdpSetWrite:
001101r 1  8D 01 9C       sta VC_REG
001104r 1  8A             txa
001105r 1  09 40          ora #$40                      ; Bit 6 selects write
001107r 1  8D 01 9C       sta VC_REG
00110Ar 1  60             rts
00110Br 1               
00110Br 1               ; -----------------------------------------------------------------------------
00110Br 1               ;   VdpSetReg — write a VDP control register
00110Br 1               ;   In:  A = value, X = register number
00110Br 1               ; -----------------------------------------------------------------------------
00110Br 1               VdpSetReg:
00110Br 1  8D 01 9C       sta VC_REG
00110Er 1  8A             txa
00110Fr 1  09 80          ora #$80
001111r 1  8D 01 9C       sta VC_REG
001114r 1  60             rts
001115r 1               
001115r 1               ; -----------------------------------------------------------------------------
001115r 1               ;   HalInitVideo — Graphics I, tiles loaded, screen cleared, everything black
001115r 1               ; -----------------------------------------------------------------------------
001115r 1               HalInitVideo:
001115r 1  A2 00          ldx #0                        ; R0: external VDP disabled, Graphics I
001117r 1  A9 00          lda #$00
001119r 1  20 rr rr       jsr VdpSetReg
00111Cr 1  A2 01          ldx #1                        ; R1: 16 K, display on, IRQ enabled, 8x8 sprites
00111Er 1  A9 E0          lda #$E0                      ; The IE bit stays SET even though this game
001120r 1  20 rr rr       jsr VdpSetReg                 ;   polls: HalWaitFrame reads the status
001123r 1                                               ;   register for the vblank flag, and the flag
001123r 1                                               ;   only raises when IE is on. The CPU's own I
001123r 1                                               ;   flag is never cleared, so the interrupt is
001123r 1                                               ;   asserted and simply ignored — reading the
001123r 1                                               ;   status register acknowledges it.
001123r 1  A2 02          ldx #2                        ; R2: name table    $1400 / $400
001125r 1  A9 05          lda #$05
001127r 1  20 rr rr       jsr VdpSetReg
00112Ar 1  A2 03          ldx #3                        ; R3: colour table  $2000 / $40
00112Cr 1  A9 80          lda #$80
00112Er 1  20 rr rr       jsr VdpSetReg
001131r 1  A2 04          ldx #4                        ; R4: pattern table $0000 / $800
001133r 1  A9 00          lda #$00
001135r 1  20 rr rr       jsr VdpSetReg
001138r 1  A2 05          ldx #5                        ; R5: sprite attrs  $1B00 / $80
00113Ar 1  A9 36          lda #$36
00113Cr 1  20 rr rr       jsr VdpSetReg
00113Fr 1  A2 06          ldx #6                        ; R6: sprite patterns $0000
001141r 1  A9 00          lda #$00
001143r 1  20 rr rr       jsr VdpSetReg
001146r 1  A2 07          ldx #7                        ; R7: backdrop black
001148r 1  A9 01          lda #$01
00114Ar 1  20 rr rr       jsr VdpSetReg
00114Dr 1               
00114Dr 1  20 rr rr       jsr LoadTileset
001150r 1  20 rr rr       jsr LoadColorTable
001153r 1  20 rr rr       jsr DisableSprites
001156r 1                 ; falls through
001156r 1               
001156r 1               ; -----------------------------------------------------------------------------
001156r 1               ;   HalClearScreen — fill the name table with the blank tile
001156r 1               ; -----------------------------------------------------------------------------
001156r 1               HalClearScreen:
001156r 1  A9 00          lda #<VRAM_NAMES
001158r 1  A2 14          ldx #>VRAM_NAMES
00115Ar 1  20 rr rr       jsr VdpSetWrite
00115Dr 1  A2 03          ldx #3                        ; 3 x 256 = 768 cells
00115Fr 1  A0 00          ldy #0
001161r 1               @Cell:
001161r 1  A9 00          lda #TILE_BLANK
001163r 1  8D 00 9C       sta VC_DATA
001166r 1  C8             iny
001167r 1  D0 F8          bne @Cell
001169r 1  CA             dex
00116Ar 1  D0 F5          bne @Cell
00116Cr 1  60             rts
00116Dr 1               
00116Dr 1               ; -----------------------------------------------------------------------------
00116Dr 1               ;   LoadTileset — 2 K of patterns into VRAM
00116Dr 1               ;   PLACEHOLDER ART: Tileset is data/tileset.bin. See data/README.md.
00116Dr 1               ; -----------------------------------------------------------------------------
00116Dr 1               LoadTileset:
00116Dr 1  A9 00          lda #<VRAM_PATTERNS
00116Fr 1  A2 00          ldx #>VRAM_PATTERNS
001171r 1  20 rr rr       jsr VdpSetWrite
001174r 1               
001174r 1  A9 rr          lda #<Tileset
001176r 1  85 rr          sta SrcPtr
001178r 1  A9 rr          lda #>Tileset
00117Ar 1  85 rr          sta SrcPtr+1
00117Cr 1               
00117Cr 1  A2 08          ldx #8                        ; 8 x 256 = 2048 bytes
00117Er 1  A0 00          ldy #0
001180r 1               @Byte:
001180r 1  B1 rr          lda (SrcPtr),y
001182r 1  8D 00 9C       sta VC_DATA
001185r 1  C8             iny
001186r 1  D0 F8          bne @Byte
001188r 1  E6 rr          inc SrcPtr+1
00118Ar 1  CA             dex
00118Br 1  D0 F3          bne @Byte
00118Dr 1  60             rts
00118Er 1               
00118Er 1               ; -----------------------------------------------------------------------------
00118Er 1               ;   LoadColorTable — 32 bytes, one per 8-pattern group
00118Er 1               ;   This is what makes a tile red: its pattern number selects the group, and
00118Er 1               ;   the group's byte here selects the colour. Nothing is per cell.
00118Er 1               ; -----------------------------------------------------------------------------
00118Er 1               LoadColorTable:
00118Er 1  A9 00          lda #<VRAM_COLORS
001190r 1  A2 20          ldx #>VRAM_COLORS
001192r 1  20 rr rr       jsr VdpSetWrite
001195r 1  A0 00          ldy #0
001197r 1               @Byte:
001197r 1  B9 rr rr       lda TileColorTMS,y
00119Ar 1  8D 00 9C       sta VC_DATA
00119Dr 1  C8             iny
00119Er 1  C0 20          cpy #32
0011A0r 1  D0 F5          bne @Byte
0011A2r 1  60             rts
0011A3r 1               
0011A3r 1               ; -----------------------------------------------------------------------------
0011A3r 1               ;   DisableSprites — park every sprite off screen
0011A3r 1               ;   The game uses none; $D0 in the first Y byte terminates the sprite list.
0011A3r 1               ; -----------------------------------------------------------------------------
0011A3r 1               DisableSprites:
0011A3r 1  A9 00          lda #<VRAM_SPRITES
0011A5r 1  A2 1B          ldx #>VRAM_SPRITES
0011A7r 1  20 rr rr       jsr VdpSetWrite
0011AAr 1  A9 D0          lda #$D0
0011ACr 1  8D 00 9C       sta VC_DATA
0011AFr 1  60             rts
0011B0r 1               
0011B0r 1               ; -----------------------------------------------------------------------------
0011B0r 1               ;   HalWaitFrame — poll the VDP status register for vertical blank
0011B0r 1               ;   No raster interrupt here, and the status poll is self-syncing.
0011B0r 1               ; -----------------------------------------------------------------------------
0011B0r 1               HalWaitFrame:
0011B0r 1               @Wait:
0011B0r 1  AD 01 9C       lda VC_STATUS
0011B3r 1  29 80          and #$80                      ; Bit 7 sets at the end of each frame
0011B5r 1  F0 F9          beq @Wait
0011B7r 1  60             rts
0011B8r 1               
0011B8r 1               ; -----------------------------------------------------------------------------
0011B8r 1               ;   HalPlotCell — In: A = tile, X = screen column, Y = screen row
0011B8r 1               ; -----------------------------------------------------------------------------
0011B8r 1               HalPlotCell:
0011B8r 1  48             pha
0011B9r 1  20 rr rr       jsr NameAddr                  ; Ptr1 = VRAM_NAMES + row * 32 + col
0011BCr 1  A5 rr          lda Ptr1
0011BEr 1  A6 rr          ldx Ptr1+1
0011C0r 1  20 rr rr       jsr VdpSetWrite
0011C3r 1  68             pla
0011C4r 1  8D 00 9C       sta VC_DATA
0011C7r 1  60             rts
0011C8r 1               
0011C8r 1               ; -----------------------------------------------------------------------------
0011C8r 1               ;   NameAddr — In: X = column, Y = row.  Out: Ptr1 = name table address
0011C8r 1               ; -----------------------------------------------------------------------------
0011C8r 1               NameAddr:
0011C8r 1  98             tya
0011C9r 1  29 07          and #$07
0011CBr 1  0A             asl a                         ; (row & 7) * 32 lands in bits 5-7...
0011CCr 1  0A             asl a
0011CDr 1  0A             asl a
0011CEr 1  0A             asl a
0011CFr 1  0A             asl a
0011D0r 1  85 rr          sta Ptr1
0011D2r 1  8A             txa
0011D3r 1  05 rr          ora Ptr1                      ; ...leaving bits 0-4 free for the column
0011D5r 1  85 rr          sta Ptr1
0011D7r 1  98             tya
0011D8r 1  4A             lsr a                         ; row >> 3 is the page within the name table
0011D9r 1  4A             lsr a
0011DAr 1  4A             lsr a
0011DBr 1  18             clc
0011DCr 1  69 14          adc #>VRAM_NAMES
0011DEr 1  85 rr          sta Ptr1+1
0011E0r 1  60             rts
0011E1r 1               
0011E1r 1               ; -----------------------------------------------------------------------------
0011E1r 1               ;   HalBlitScreen — draw a full 768-byte name table image
0011E1r 1               ;   In: SrcPtr -> image. Ptr1 (colour) is ignored: this machine has no colour
0011E1r 1               ;   RAM, so the same image drives every platform's layout and only the palette
0011E1r 1               ;   mechanism differs.
0011E1r 1               ; -----------------------------------------------------------------------------
0011E1r 1               HalBlitScreen:
0011E1r 1  A9 00          lda #<VRAM_NAMES
0011E3r 1  A2 14          ldx #>VRAM_NAMES
0011E5r 1  20 rr rr       jsr VdpSetWrite
0011E8r 1               
0011E8r 1  A2 03          ldx #3                        ; 3 full pages
0011EAr 1  A0 00          ldy #0
0011ECr 1               @Byte:
0011ECr 1  B1 rr          lda (SrcPtr),y
0011EEr 1  8D 00 9C       sta VC_DATA
0011F1r 1  C8             iny
0011F2r 1  D0 F8          bne @Byte
0011F4r 1  E6 rr          inc SrcPtr+1
0011F6r 1  CA             dex
0011F7r 1  D0 F3          bne @Byte
0011F9r 1  60             rts
0011FAr 1               
0011FAr 1               ; -----------------------------------------------------------------------------
0011FAr 1               ;   HalReadInput — joystick 1 and the keyboard, in one active-high mask
0011FAr 1               ;   The port is active low, %RLDUYXBA (ac6502.inc).
0011FAr 1               ;
0011FAr 1               ;   This machine has no key matrix to scan. Two encoders sit on the VIA ports
0011FAr 1               ;   the joysticks share and hand over one ASCII byte per keystroke, strobing
0011FAr 1               ;   CB1 (matrix keyboard) or CA1 (PS/2) when it is ready. There is no key-up
0011FAr 1               ;   event and no way to ask whether a key is still down, so a key here is a
0011FAr 1               ;   ONE-FRAME PULSE rather than a held bit: the edge-triggered controls
0011FAr 1               ;   (rotate, pause, fire) work exactly as they do on a stick, and the held
0011FAr 1               ;   ones (left, right, soft drop) advance once per keystroke and once per
0011FAr 1               ;   encoder auto-repeat. DAS never engages from the keyboard, because the bit
0011FAr 1               ;   is never down two frames running.
0011FAr 1               ;
0011FAr 1               ;   Polled, not interrupt driven: the IFR flag raises on the strobe whether or
0011FAr 1               ;   not the VIA is allowed to assert IRQ, and this cartridge never clears the
0011FAr 1               ;   CPU's I flag (D7). Reading the port takes the byte and clears the flag.
0011FAr 1               ; -----------------------------------------------------------------------------
0011FAr 1               HalReadInput:
0011FAr 1  AD 0D 03       lda HW_PRESENT
0011FDr 1  29 20          and #HW_GPIO                  ; No GPIO card means a floating bus, not input
0011FFr 1  F0 51          beq @None
001201r 1               
001201r 1  20 rr rr       jsr ScanKeys                  ; BEFORE the joystick: ReadJoystick1 releases
001204r 1  85 rr          sta Tmp2                      ;   both encoders, and a key pending at that
001206r 1                                               ;   moment would go with them
001206r 1               
001206r 1  20 48 A0       jsr ReadJoystick1
001209r 1  49 FF          eor #$FF                      ; Active low in, active high out
00120Br 1  85 rr          sta Tmp0
00120Dr 1               
00120Dr 1  A9 00          lda #0
00120Fr 1  85 rr          sta Tmp1
001211r 1               
001211r 1  A5 rr          lda Tmp0
001213r 1  29 10          and #%00010000                  ; U
001215r 1  F0 06          beq @NoUp
001217r 1  A5 rr          lda Tmp1
001219r 1  09 01          ora #INPUT_UP
00121Br 1  85 rr          sta Tmp1
00121Dr 1               @NoUp:
00121Dr 1  A5 rr          lda Tmp0
00121Fr 1  29 20          and #%00100000                  ; D
001221r 1  F0 06          beq @NoDown
001223r 1  A5 rr          lda Tmp1
001225r 1  09 02          ora #INPUT_DOWN
001227r 1  85 rr          sta Tmp1
001229r 1               @NoDown:
001229r 1  A5 rr          lda Tmp0
00122Br 1  29 40          and #%01000000                  ; L
00122Dr 1  F0 06          beq @NoLeft
00122Fr 1  A5 rr          lda Tmp1
001231r 1  09 04          ora #INPUT_LEFT
001233r 1  85 rr          sta Tmp1
001235r 1               @NoLeft:
001235r 1  A5 rr          lda Tmp0
001237r 1  29 80          and #%10000000                  ; R
001239r 1  F0 06          beq @NoRight
00123Br 1  A5 rr          lda Tmp1
00123Dr 1  09 08          ora #INPUT_RIGHT
00123Fr 1  85 rr          sta Tmp1
001241r 1               @NoRight:
001241r 1  A5 rr          lda Tmp0
001243r 1  29 01          and #%00000001                  ; A
001245r 1  F0 06          beq @NoFire
001247r 1  A5 rr          lda Tmp1
001249r 1  09 10          ora #INPUT_FIRE
00124Br 1  85 rr          sta Tmp1
00124Dr 1               @NoFire:
00124Dr 1               
00124Dr 1  A5 rr          lda Tmp1
00124Fr 1  05 rr          ora Tmp2
001251r 1  60             rts
001252r 1               
001252r 1               @None:
001252r 1  A9 00          lda #0
001254r 1  60             rts
001255r 1               
001255r 1               ; -----------------------------------------------------------------------------
001255r 1               ;   ScanKeys — whatever the two encoders have strobed since the last frame
001255r 1               ;   Out: A = INPUT_* bits.  Modifies: A, X, Tmp2
001255r 1               ;   Both are checked, so either keyboard drives the game.
001255r 1               ; -----------------------------------------------------------------------------
001255r 1               ScanKeys:
001255r 1  A9 00          lda #0
001257r 1  85 rr          sta Tmp2
001259r 1               
001259r 1  AD 0D 94       lda GPIO_IFR
00125Cr 1  29 10          and #GPIO_INT_CB1             ; Matrix keyboard encoder, on port B
00125Er 1  F0 0A          beq @Ps2
001260r 1  AD 00 94       lda GPIO_PORTB                ; Reading it takes the byte and clears CB1
001263r 1  20 rr rr       jsr KeyBit
001266r 1  05 rr          ora Tmp2
001268r 1  85 rr          sta Tmp2
00126Ar 1               
00126Ar 1               @Ps2:
00126Ar 1  AD 0D 94       lda GPIO_IFR
00126Dr 1  29 02          and #GPIO_INT_CA1             ; PS/2 encoder, on port A
00126Fr 1  F0 0A          beq @Done
001271r 1  AD 01 94       lda GPIO_PORTA
001274r 1  20 rr rr       jsr KeyBit
001277r 1  05 rr          ora Tmp2
001279r 1  85 rr          sta Tmp2
00127Br 1               
00127Br 1               @Done:
00127Br 1  A5 rr          lda Tmp2
00127Dr 1  60             rts
00127Er 1               
00127Er 1               ; -----------------------------------------------------------------------------
00127Er 1               ;   KeyBit — one ASCII byte to one input bit
00127Er 1               ;   In:  A = character      Out: A = INPUT_* bit, or 0 for anything else
00127Er 1               ;   SPEC 11.2. The arrow keys are not here: the encoders define no code for
00127Er 1               ;   them, so WASD is the whole of the keyboard control scheme on this machine.
00127Er 1               ; -----------------------------------------------------------------------------
00127Er 1               KeyBit:
00127Er 1  C9 0D          cmp #$0D                      ; RETURN — confirm
001280r 1  F0 2D          beq @Fire
001282r 1  C9 20          cmp #' '                      ; SPACE — rotate, and start (D15)
001284r 1  F0 1D          beq @Up
001286r 1  09 20          ora #$20                      ; Fold to lower case. Anything that is not a
001288r 1  C9 77          cmp #'w'                      ;   letter simply matches nothing below.
00128Ar 1  F0 17          beq @Up
00128Cr 1  C9 73          cmp #'s'
00128Er 1  F0 16          beq @Down
001290r 1  C9 61          cmp #'a'
001292r 1  F0 15          beq @Left
001294r 1  C9 64          cmp #'d'
001296r 1  F0 14          beq @Right
001298r 1  C9 71          cmp #'q'
00129Ar 1  F0 13          beq @Fire
00129Cr 1  C9 70          cmp #'p'
00129Er 1  F0 12          beq @Pause
0012A0r 1  A9 00          lda #0
0012A2r 1  60             rts
0012A3r 1               
0012A3r 1               @Up:
0012A3r 1  A9 01          lda #INPUT_UP
0012A5r 1  60             rts
0012A6r 1               @Down:
0012A6r 1  A9 02          lda #INPUT_DOWN
0012A8r 1  60             rts
0012A9r 1               @Left:
0012A9r 1  A9 04          lda #INPUT_LEFT
0012ABr 1  60             rts
0012ACr 1               @Right:
0012ACr 1  A9 08          lda #INPUT_RIGHT
0012AEr 1  60             rts
0012AFr 1               @Fire:
0012AFr 1  A9 10          lda #INPUT_FIRE
0012B1r 1  60             rts
0012B2r 1               @Pause:
0012B2r 1  A9 20          lda #INPUT_PAUSE
0012B4r 1  60             rts
0012B5r 1               
0012B5r 1               ; -----------------------------------------------------------------------------
0012B5r 1               ;   HalDetectRegion — the TMS9918 here is 60 Hz
0012B5r 1               ; -----------------------------------------------------------------------------
0012B5r 1               HalDetectRegion:
0012B5r 1  A9 00          lda #0                        ; NTSC
0012B7r 1  60             rts
0012B8r 1               
0012B8r 1               ; -----------------------------------------------------------------------------
0012B8r 1               ;   HalColorFlash — the fireball's detonation (SPEC 4.6, 14)
0012B8r 1               ;   In:  A = colour key ($40..$68), or TINT_NONE.  Modifies: A, X, Y, TintColor
0012B8r 1               ;
0012B8r 1               ;   ONE BYTE. A tile's colour on this machine belongs to its 8-pattern group
0012B8r 1               ;   and not to the cell, so turning every red tile on the board white is a
0012B8r 1               ;   single write to the VDP colour table — and its undo is another. SPEC 4.6
0012B8r 1               ;   calls this the fireball's free trick and it is not an exaggeration: the
0012B8r 1               ;   Commodores' equivalent costs a compare on every cell they draw for as long
0012B8r 1               ;   as the flash lasts, and this costs nothing at all once it is lit.
0012B8r 1               ;
0012B8r 1               ;   The group index is the colour key >> 3, because both the tile map and the
0012B8r 1               ;   colour table are eight patterns to a group (SPEC Appendix A).
0012B8r 1               ;
0012B8r 1               ;   The old colour goes back BEFORE the new one is lit, so two fireballs of
0012B8r 1               ;   different colours in one step leave exactly one group flashing rather than
0012B8r 1               ;   one group flashing and another stuck white for the rest of the game.
0012B8r 1               ; -----------------------------------------------------------------------------
0012B8r 1               HalColorFlash:
0012B8r 1  48             pha
0012B9r 1  AC rr rr       ldy TintColor
0012BCr 1  C0 01          cpy #TINT_NONE
0012BEr 1  F0 0B          beq @Light                    ; Nothing lit — nothing to put back
0012C0r 1  98             tya
0012C1r 1  4A             lsr a
0012C2r 1  4A             lsr a
0012C3r 1  4A             lsr a
0012C4r 1  A8             tay
0012C5r 1  B9 rr rr       lda TileColorTMS,y            ; Its own colour, straight out of the table the
0012C8r 1  20 rr rr       jsr VdpPutColor               ;   init loaded from
0012CBr 1               
0012CBr 1               @Light:
0012CBr 1  68             pla
0012CCr 1  8D rr rr       sta TintColor
0012CFr 1  C9 01          cmp #TINT_NONE
0012D1r 1  F0 0E          beq @Done
0012D3r 1  4A             lsr a
0012D4r 1  4A             lsr a
0012D5r 1  4A             lsr a
0012D6r 1  A8             tay
0012D7r 1  B9 rr rr       lda TileColorTMS,y
0012DAr 1  29 0F          and #$0F                      ; Keep the background nibble — black (SPEC 4.3)
0012DCr 1  09 F0          ora #$F0                      ; ...and make the foreground white
0012DEr 1  20 rr rr       jsr VdpPutColor
0012E1r 1               @Done:
0012E1r 1  60             rts
0012E2r 1               
0012E2r 1               ; -----------------------------------------------------------------------------
0012E2r 1               ;   VdpPutColor — In: A = colour byte, Y = group 0-31.  Modifies: A, X, Y
0012E2r 1               ; -----------------------------------------------------------------------------
0012E2r 1               VdpPutColor:
0012E2r 1  48             pha
0012E3r 1  98             tya
0012E4r 1  18             clc
0012E5r 1  69 00          adc #<VRAM_COLORS             ; 32 bytes, one per group; the low byte of the
0012E7r 1  A2 20          ldx #>VRAM_COLORS             ;   table's address is zero so this cannot carry
0012E9r 1  20 rr rr       jsr VdpSetWrite
0012ECr 1  68             pla
0012EDr 1  8D 00 9C       sta VC_DATA
0012F0r 1  60             rts
0012F1r 1               
0012F1r 1               ; -----------------------------------------------------------------------------
0012F1r 1               ;   HalSfx — TODO: SID at $9800. Shares a driver with the C64's $D400.
0012F1r 1               ; -----------------------------------------------------------------------------
0012F1r 1               HalSfx:
0012F1r 1  60             rts
0012F2r 1               
0012F2r 1               ; =============================================================================
0012F2r 1               ;   Data
0012F2r 1               ; =============================================================================
0012F2r 1               
0012F2r 1               .segment "RODATA"
000000r 1               
000000r 1               .include "../data/tilecolor-tms9918.inc"
000000r 2               ; =============================================================================
000000r 2               ;   tilecolor-tms9918.inc — TMS9918 Graphics I colour table
000000r 2               ; =============================================================================
000000r 2               ;   Generated from SPEC.md section 4.3 and Appendix A. Spec-derived data, not
000000r 2               ;   artwork: edit this file by hand, it is never overwritten by an editor
000000r 2               ;   export. Tile groups 16-31 (tiles 128-255) are the margin artwork and their
000000r 2               ;   colours are the artist's to choose.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               
000000r 2               ;   32 bytes -> VDP colour table. Each byte is (foreground << 4) | background;
000000r 2               ;   background is 1 (black) throughout, matching the backdrop register.
000000r 2               
000000r 2               TileColorTMS:
000000r 2  F1             .byte $F1                        ; group 0  tiles   0-7    UI / well frame        white
000001r 2  E1             .byte $E1                        ; group 1  tiles   8-15   UI accents             gray
000002r 2  F1             .byte $F1                        ; group 2  tiles  16-23   Font  0 1 2 3 4 5 6 7  white
000003r 2  F1             .byte $F1                        ; group 3  tiles  24-31   Font  8 9 A B C D E F  white
000004r 2  F1             .byte $F1                        ; group 4  tiles  32-39   Font  G H I J K L M N  white
