000000r 1               .setcpu "65C02"
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Wizards Lab — AC6502
000000r 1               ; =============================================================================
000000r 1               ;   A 16 K cartridge for the A.C. Wright 6502, running the TMS9918 in
000000r 1               ;   Graphics Mode I: 32 x 24 cells of 8 x 8 pixels, 256 patterns, and colour
000000r 1               ;   assigned one foreground/background pair per group of eight patterns.
000000r 1               ;
000000r 1               ;   That colour model is the strictest of the three targets, so it is the one
000000r 1               ;   the whole tileset is laid out against — each potion colour owns one group,
000000r 1               ;   and every glyph of that colour lives inside it. See SPEC.md section 4.
000000r 1               ;
000000r 1               ;   This file is the platform half of the contract in src/hal.inc. Everything
000000r 1               ;   it includes from src/ is shared, byte for byte, with the VIC-20 and C64.
000000r 1               ;
000000r 1               ;   Built with AC6502-16K.cfg.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               .include "../include/ac6502.inc"
000000r 2               ; =============================================================================
000000r 2               ;   6502.inc — External include file for the 6502 system
000000r 2               ; =============================================================================
000000r 2               ;
000000r 2               ;   CPU:       WDC 65C02S
000000r 2               ;   BIOS:      v1.5
000000r 2               ;   Assembler: ca65 (cc65 toolchain) — uses := for absolute symbols
000000r 2               ;
000000r 2               ;   Include this file in external projects to access Kernal routines,
000000r 2               ;   IO hardware registers, system variables, and useful constants.
000000r 2               ;
000000r 2               ;   MEMORY MAP
000000r 2               ;   ----------
000000r 2               ;   $0000-$0003   Zero Page: System pointers (see below)
000000r 2               ;   $0004-$0023   Zero Page: Reserved by BASIC interpreter
000000r 2               ;   $0024-$0039   Zero Page: System scratch (CF, serial, delay, monitor, XModem)
000000r 2               ;   $003A-$00FF   Zero Page: Free for user programs
000000r 2               ;   $0100-$01FF   CPU Stack
000000r 2               ;   $0200-$02FF   Input Buffer (ring buffer, managed by Kernal)
000000r 2               ;   $0300-$03FF   Kernal Variables (vectors, cursor, HW flags, etc.)
000000r 2               ;   $0400-$05FF   User Variables / BASIC workspace
000000r 2               ;   $0600-$07FF   FS sector buffer (clobbered by any FS/St routine call)
000000r 2               ;   $0800-$7FFF   Program RAM (30 KB — load address for user code)
000000r 2               ;   $8000-$83FF   IO 1: Banked RAM Low  (256 × ~1 KB banks)
000000r 2               ;   $8400-$87FF   IO 2: Banked RAM High (256 × ~1 KB banks)
000000r 2               ;   $8800-$881F   IO 3: RTC (DS1511Y)
000000r 2               ;   $8C00-$8C07   IO 4: Storage (CompactFlash, 8-bit IDE)
000000r 2               ;   $9000-$9003   IO 5: Serial (R65C51 ACIA)
000000r 2               ;   $9400-$940F   IO 6: GPIO (65C22 VIA — keyboard & joysticks)
000000r 2               ;   $9800-$981C   IO 7: Sound (SID / ARMSID)
000000r 2               ;   $9C00-$9C01   IO 8: Video (TMS9918 / pico9918)
000000r 2               ;   $A000-$A0FF   Kernal Jump Table (stable entry points)
000000r 2               ;   $A100-$B7FF   Kernal Implementation
000000r 2               ;   $B800-$BFFF   Character Set ROM (2 KB, 256 × 8-byte patterns)
000000r 2               ;   $C000-$EDFF   BASIC Interpreter
000000r 2               ;   $EE00-$FEFF   Machine Code Monitor
000000r 2               ;   $FF00-$FFF9   Wozmon (mini monitor)
000000r 2               ;   $FFFA-$FFFF   CPU Vectors (NMI, RESET, IRQ)
000000r 2               ;
000000r 2               ;   BOOT SEQUENCE
000000r 2               ;   -------------
000000r 2               ;   On RESET the BIOS probes all eight IO slots, initializes detected
000000r 2               ;   hardware, and auto-selects video or serial console.  If neither is
000000r 2               ;   found, IO_MODE is left unchanged (no halt — cartridges with their
000000r 2               ;   own display hardware can still boot).  A startup beep plays (if SID
000000r 2               ;   is present) for audible feedback, then BOOT_VECTOR ($035B) is
000000r 2               ;   checked — if non-zero, execution jumps there (cartridge takeover).
000000r 2               ;   Otherwise a console check halts if no video/serial is found, then
000000r 2               ;   the splash screen and boot menu are displayed.  ENTER launches
000000r 2               ;   BASIC; ESC enters the Monitor.  A 5-second timeout auto-boots BASIC.
000000r 2               ;   The splash is drawn on whichever console is active — centred on the
000000r 2               ;   40-column screen, or left-aligned as plain text over serial.
000000r 2               ;
000000r 2               ;   GRACEFUL DEGRADATION
000000r 2               ;   --------------------
000000r 2               ;   Every Kernal routine that drives a card checks HW_PRESENT first, so
000000r 2               ;   a call on a machine without that card is safe rather than a crash.
000000r 2               ;   Routines with nothing to report back return silently (video and SID);
000000r 2               ;   routines that move data report failure in the carry (CompactFlash).
000000r 2               ;   The per-routine notes below say which behaviour each one has.
000000r 2               ;
000000r 2               ;   CARTRIDGE SUPPORT
000000r 2               ;   -----------------
000000r 2               ;   Cartridges overlay $C000-$FFFF (BASIC, Monitor, Wozmon, vectors).
000000r 2               ;   The Kernal ($A000-$B7FF) and character set ($B800-$BFFF) remain
000000r 2               ;   accessible.  Use KernalInit ($A078) to initialize all hardware and
000000r 2               ;   return via RTS — interrupts are left disabled so the cart can set
000000r 2               ;   up its own handlers first.  See usage patterns in the BIOS README.
000000r 2               ;
000000r 2               ;   IO_MODE
000000r 2               ;   -------
000000r 2               ;   Bit 0 of IO_MODE selects the console output device:
000000r 2               ;     0 = Video (TMS9918)    1 = Serial (R65C51)
000000r 2               ;   Chrout ($A000) dispatches automatically based on IO_MODE.
000000r 2               ;   Use SetIOMode / GetIOMode to change or query the active console.
000000r 2               ;
000000r 2               ;   CALLING CONVENTION
000000r 2               ;   ------------------
000000r 2               ;   Kernal routines are called via JSR to the jump table addresses below.
000000r 2               ;   Parameters are passed in A, X, Y, and/or zero-page pointers as
000000r 2               ;   documented per routine.  Carry flag is used for success/error returns
000000r 2               ;   (C=0 success, C=1 error) where noted.
000000r 2               ;
000000r 2               ;   HW_PRESENT BITMASK
000000r 2               ;   -------------------
000000r 2               ;   After boot, HW_PRESENT ($030D) contains a bitmask of detected hardware.
000000r 2               ;   Test individual bits before calling hardware-specific routines.
000000r 2               ;   Example:
000000r 2               ;     lda HW_PRESENT
000000r 2               ;     and #HW_VID          ; Is video card present?
000000r 2               ;     beq @NoVideo         ; Skip if not
000000r 2               ;
000000r 2               ; =============================================================================
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 1: ZERO PAGE POINTERS
000000r 2               ; =============================================================================
000000r 2               ; These zero page locations are used by the Kernal.  External programs may
000000r 2               ; use STR_PTR and CF_BUF_PTR/CF_LBA as parameters to Kernal calls.
000000r 2               ; Locations $3A-$FF are free for user programs.
000000r 2               
000000r 2               STR_PTR             := $02               ; 2 bytes — String pointer (used by FsLoadFile, FsSaveFile, FsDeleteFile, etc.)
000000r 2               CF_BUF_PTR          := $24               ; 2 bytes — CF sector data buffer pointer
000000r 2               CF_LBA              := $26               ; 4 bytes — CF 28-bit LBA address (little-endian)
000000r 2               XFER_PTR            := $2A               ; 2 bytes — XModem transfer data pointer (source for XModemSave, dest for XModemLoad)
000000r 2               
000000r 2               ; Safe zero page range for user programs:
000000r 2               ; $3A-$FF (198 bytes free)
000000r 2               ; Note: $2E-$35 belong to the Monitor and $36-$39 to XModemLoad/XModemSave;
000000r 2               ;       neither range survives a call into those routines
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 2: SYSTEM VARIABLES ($0300-$03FF)
000000r 2               ; =============================================================================
000000r 2               
000000r 2               IRQ_PTR             := $0300             ; 2 bytes — IRQ handler vector (writable; default: internal Irq handler)
000000r 2               BRK_PTR             := $0302             ; 2 bytes — BRK handler vector (writable; default: enters Monitor)
000000r 2               NMI_PTR             := $0304             ; 2 bytes — NMI handler vector (writable; default: RTI)
000000r 2               
000000r 2               IO_MODE             := $0306             ; 1 byte  — Console output mode (bit 0: 0=video, 1=serial)
000000r 2               VID_CURSOR_X        := $0307             ; 1 byte  — Video cursor column (0-39)
000000r 2               VID_CURSOR_Y        := $0308             ; 1 byte  — Video cursor row (0-23)
000000r 2               
000000r 2               HW_PRESENT          := $030D             ; 1 byte  — Hardware present bitmask (set during boot probe)
000000r 2               CF_DISK             := $030F             ; 1 byte  — Current CF disk bank (0–255); base LBA = CF_DISK × FS_DISK_SECTORS; reset to 0 on boot
000000r 2               
000000r 2               ; HW_PRESENT bit definitions (bit order matches IO slot numbers):
000000r 2               HW_RAM_L            = %00000001          ; Bit 0: RAM card low  (IO 1, $8000-$83FF)
000000r 2               HW_RAM_H            = %00000010          ; Bit 1: RAM card high (IO 2, $8400-$87FF)
000000r 2               HW_RTC              = %00000100          ; Bit 2: RTC card      (IO 3, DS1511Y)
000000r 2               HW_CF               = %00001000          ; Bit 3: Storage card   (IO 4, CompactFlash)
000000r 2               HW_SC               = %00010000          ; Bit 4: Serial card    (IO 5, R65C51)
000000r 2               HW_GPIO             = %00100000          ; Bit 5: GPIO card      (IO 6, 65C22 VIA — keyboard/joysticks)
000000r 2               HW_SID              = %01000000          ; Bit 6: Sound card     (IO 7, SID/ARMSID)
000000r 2               HW_VID              = %10000000          ; Bit 7: Video card     (IO 8, TMS9918/pico9918)
000000r 2               
000000r 2               ; BRK register save area (populated by the BRK handler before entering Monitor):
000000r 2               BRK_P               := $0310             ; Saved processor status (P)
000000r 2               BRK_PCL             := $0311             ; Saved PC low byte (points to BRK instruction + 2)
000000r 2               BRK_PCH             := $0312             ; Saved PC high byte
000000r 2               BRK_A               := $0313             ; Saved accumulator
000000r 2               BRK_X               := $0314             ; Saved X register
000000r 2               BRK_Y               := $0315             ; Saved Y register
000000r 2               BRK_SP              := $0316             ; Saved stack pointer
000000r 2               
000000r 2               XFER_REMAIN         := $0317             ; 2 bytes — XModem byte count (output from XModemLoad; input to XModemSave)
000000r 2               XFER_IO_SAVE        := $0319             ; 1 byte  — Saved IO_MODE during XModem transfer (internal use)
000000r 2               
000000r 2               ; RTC scratch (used by RtcWriteDate to pass century):
000000r 2               RTC_BUF_CENT        := $030B             ; Century value for RtcReadDate / RtcWriteDate
000000r 2               
000000r 2               ; Cartridge / boot redirect vector:
000000r 2               BOOT_VECTOR         := $035B             ; 2 bytes — Boot redirect address (0=normal boot)
000000r 2                                                        ;   Set after KernalInit to redirect Reset flow
000000r 2                                                        ;   KernalInit zeroes this; write after init returns
000000r 2               FS_IO_ADDR          := $037F             ; 2 bytes — Load/save target address for FsLoadFileAddr / FsSaveFileAddr
000000r 2               FS_FILE_SIZE        := $034A             ; 2 bytes — File size in bytes (set by caller for FsSaveFileAddr; populated by FsLoadFileAddr)
000000r 2               
000000r 2               ; Program image handoff (v1.3):
000000r 2               PRG_IMAGE_END       := $038E             ; 2 bytes — End address of a program image placed at
000000r 2                                                        ;   PROGRAM_START by a loader running outside BASIC
000000r 2                                                        ;   (e.g. the Monitor's L command); 0 = none.
000000r 2                                                        ;   KernalInit zeroes it; BASIC consumes and re-zeroes it
000000r 2                                                        ;   on entry, so a stale value is never acted on twice.
000000r 2                                                        ;   A loader that drops a .prg at $0800 and then hands
000000r 2                                                        ;   off to BASIC should write the end address here so
000000r 2                                                        ;   the attached machine code survives LOAD/SAVE.
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 3: KEY MEMORY LOCATIONS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               INPUT_BUFFER        := $0200             ; $0200-$02FF — 256-byte ring buffer (keyboard/serial input)
000000r 2               PROGRAM_START       := $0800             ; User programs and BASIC programs load here
000000r 2               ;                                        ; Program space extends to $7FFF (30 KB)
000000r 2               MEMORY_TOP          := $8000             ; First address past usable RAM (IO space starts here)
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 4: KERNAL JUMP TABLE ($A000-$A0FF)
000000r 2               ; =============================================================================
000000r 2               ; All entry points are stable 3-byte JMP instructions.  Call via JSR.
000000r 2               ; Unimplemented slots return immediately (RTS).
000000r 2               
000000r 2               ; --- Character I/O ---
000000r 2               Chrout              := $A000             ; Output character (dispatched by IO_MODE)
000000r 2                                                        ;   In: A = character
000000r 2                                                        ;   Preserves: A, X, Y
000000r 2                                                        ;   Handles CR ($0D), LF ($0A), BS ($08), BEL ($07) in video mode
000000r 2               
000000r 2               Chrin               := $A003             ; Input character from buffer (non-blocking poll)
000000r 2                                                        ;   Out: A = character, C=1 if char available, C=0 if not
000000r 2                                                        ;   Caller must loop until C=1 for blocking behavior
000000r 2                                                        ;   Echoes character via Chrout
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               WriteBuffer         := $A006             ; Write byte to input ring buffer
000000r 2                                                        ;   In: A = byte to write
000000r 2                                                        ;   Modifies: X
000000r 2               
000000r 2               ReadBuffer          := $A009             ; Read byte from input ring buffer
000000r 2                                                        ;   Out: A = byte read
000000r 2                                                        ;   Modifies: X, A
000000r 2               
000000r 2               BufferSize          := $A00C             ; Get number of unread bytes in input buffer
000000r 2                                                        ;   Out: A = count
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- IO Mode ---
000000r 2               SetIOMode           := $A00F             ; Set IO_MODE
000000r 2                                                        ;   In: A = mode (bit 0: 0=video, 1=serial)
000000r 2               
000000r 2               GetIOMode           := $A012             ; Get IO_MODE
000000r 2                                                        ;   Out: A = current IO_MODE
000000r 2               
000000r 2               ; --- Video (TMS9918 / pico9918) ---
000000r 2               InitVideo           := $A015             ; Initialize TMS9918 (text mode, 40×24)
000000r 2                                                        ;   Writes the 8 mode registers, then reloads the
000000r 2                                                        ;   character set into the pattern table (VRAM $0800)
000000r 2                                                        ;   A program that switched the VDP to a graphics mode
000000r 2                                                        ;   can fully restore text mode with this one call
000000r 2                                                        ;   STR_PTR is used internally but saved and restored
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoClear          := $A018             ; Clear screen (fill with spaces), reset cursor to (0,0)
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoPutChar        := $A01B             ; Write character at cursor position (no cursor advance)
000000r 2                                                        ;   In: A = character
000000r 2               
000000r 2               VideoSetCursor      := $A01E             ; Set cursor position
000000r 2                                                        ;   In: X = column (0-39), Y = row (0-23)
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               VideoGetCursor      := $A021             ; Get cursor position
000000r 2                                                        ;   Out: X = column (0-39), Y = row (0-23)
000000r 2               
000000r 2               VideoScroll         := $A024             ; Scroll screen up one line, clear bottom row
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoSetColor       := $A027             ; Set TMS9918 text color
000000r 2                                                        ;   In: A = color byte (high nibble = foreground, low nibble = background)
000000r 2                                                        ;   See TMS9918 Color Constants below
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               VideoChroutRaw      := $A02A             ; Output char to video with no control-code handling
000000r 2                                                        ;   In: A = character code (0-255)
000000r 2                                                        ;   Preserves: A, X, Y
000000r 2                                                        ;   Always renders glyph, never interprets CR/LF/BS/BEL
000000r 2               
000000r 2               ; --- Sound (SID / ARMSID) ---
000000r 2               InitSID             := $A02D             ; Initialize SID (clear all registers, volume=15)
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               Beep                := $A030             ; Play short beep tone (~475 Hz)
000000r 2                                                        ;   Skips silently if no SID detected
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               SidPlayNote         := $A033             ; Play note on a SID voice
000000r 2                                                        ;   In: A = voice (0-2), X = freq low, Y = freq high
000000r 2                                                        ;   Uses triangle waveform, ADSR: A=0 D=9 S=F R=8
000000r 2                                                        ;   Full sustain holds the note flat until gated off
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SidSilence          := $A036             ; Silence all 3 SID voices (gate off only)
000000r 2                                                        ;   Frequencies are left intact — the envelope release
000000r 2                                                        ;   rings the tone out.  Zeroing freq would freeze the
000000r 2                                                        ;   waveform and decay a DC offset (audible thump)
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SidSetVolume        := $A039             ; Set SID master volume
000000r 2                                                        ;   In: A = volume (0-15); only the low nibble is used
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- Filesystem (disk-banked, 16-file directory per disk) ---
000000r 2               ;   The CF card is divided into 256 disk banks of 1 MB each (FS_DISK_SECTORS
000000r 2               ;   sectors × 512 bytes).  CF_DISK ($030F) selects the active bank (reset to
000000r 2               ;   0 on boot).  Use FsSetDisk / FsGetDisk to change it at runtime.  Each
000000r 2               ;   bank has its own directory at the first sector, holding up to 16 entries
000000r 2               ;   (8.3 filenames, space-padded, case-insensitive).  All FS routines and
000000r 2               ;   StReadSector / StWriteSector operate on the selected bank automatically.
000000r 2               ;   Pass null-terminated "NAME.EXT" string via STR_PTR ($02-$03).
000000r 2               ;   Use FsLoadFileAddr / FsSaveFileAddr for load-to-address transfers.
000000r 2               ;   The extension is inert — nothing in the BIOS branches on it, so .PRG, .BAS
000000r 2               ;   and .FOO behave identically.  What a file means is decided by the routine
000000r 2               ;   that loads it, never by its name.
000000r 2               ;   All FS routines use $0600-$07FF as a 512-byte sector buffer.
000000r 2               
000000r 2               FsLoadFile          := $A03C             ; Load file from CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 not found or error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSaveFile          := $A03F             ; Save file to CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsDeleteFile        := $A042             ; Delete file from CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 not found or error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- Keyboard / GPIO ---
000000r 2               InitKB              := $A045             ; Initialize VIA for keyboard input
000000r 2                                                        ;   Configures Port A/B as inputs, enables CB1/CA1 IRQs
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- Joysticks ---
000000r 2               ;   Both ports are ACTIVE LOW — each line is pulled up through 1K and grounded
000000r 2               ;   by its switch — and both routines return the port read raw.  So a held
000000r 2               ;   button is a 0 bit and an untouched stick reads $FF:
000000r 2               ;
000000r 2               ;     Bit:  7   6   5   4   3   2   1   0
000000r 2               ;           R   L   D   U   Y   X   B   A
000000r 2               ;
000000r 2               ;   Test a direction with:  lda ... / and #%00010000 / beq @UpHeld
000000r 2               ;
000000r 2               ;   Neither routine checks HW_PRESENT — with no GPIO card fitted they read a
000000r 2               ;   floating bus and the value is meaningless.  Test HW_GPIO first if the card
000000r 2               ;   may be absent.  (BASIC's JOY() does this and reports $FF.)
000000r 2               ;
000000r 2               ;   Both routines release both encoders (KBDisable), read the port, then
000000r 2               ;   re-enable them (KBEnable).  The interrupt state is left alone.
000000r 2               
000000r 2               ReadJoystick1       := $A048             ; Read joystick 1 (VIA Port B)
000000r 2                                                        ;   Out: A = bitmask (active low, see above)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               ReadJoystick2       := $A04B             ; Read joystick 2 (VIA Port A)
000000r 2                                                        ;   Out: A = bitmask (active low, see above)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               ; --- Serial (R65C51) ---
000000r 2               InitSC              := $A04E             ; Initialize serial card (8-N-1, 19200 baud)
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SerialChrout        := $A051             ; Direct serial output (bypasses IO_MODE)
000000r 2                                                        ;   In: A = character
000000r 2                                                        ;   Blocks until TX register is empty
000000r 2               
000000r 2               ; --- Serial Transfer ---
000000r 2               XModemLoad          := $A054             ; Receive data via XModem into memory
000000r 2                                                        ;   Protocol: standard XModem (128-byte blocks, checksum)
000000r 2                                                        ;   In: XFER_PTR = destination address
000000r 2                                                        ;   Out: C=0 success, XFER_PTR advanced past last byte written
000000r 2                                                        ;        XFER_REMAIN = total bytes received
000000r 2                                                        ;        C=1 transfer failed (timeout or CAN received)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               XModemSave          := $A057             ; Send data via XModem from memory
000000r 2                                                        ;   Protocol: standard XModem (128-byte blocks, checksum)
000000r 2                                                        ;   In: XFER_PTR = source address, XFER_REMAIN = byte count
000000r 2                                                        ;   Out: C=0 success, C=1 transfer failed (timeout or CAN received)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- RTC (DS1511Y) ---
000000r 2               RtcReadTime         := $A05A             ; Read current time
000000r 2                                                        ;   Out: A = hours, X = minutes, Y = seconds (all binary)
000000r 2               
000000r 2               RtcReadDate         := $A05D             ; Read current date
000000r 2                                                        ;   Out: A = day, X = month, Y = year (all binary)
000000r 2                                                        ;   RTC_BUF_CENT ($030B) = century
000000r 2               
000000r 2               RtcWriteTime        := $A060             ; Set RTC time
000000r 2                                                        ;   In: A = hours, X = minutes, Y = seconds (all binary)
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               RtcWriteDate        := $A063             ; Set RTC date
000000r 2                                                        ;   In: A = day, X = month, Y = year (all binary)
000000r 2                                                        ;   RTC_BUF_CENT ($030B) must hold century
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               RtcReadNVRAM        := $A066             ; Read byte from DS1511Y NVRAM (256 bytes)
000000r 2                                                        ;   In: X = address ($00-$FF)
000000r 2                                                        ;   Out: A = data byte
000000r 2               
000000r 2               RtcWriteNVRAM       := $A069             ; Write byte to DS1511Y NVRAM
000000r 2                                                        ;   In: X = address ($00-$FF), A = data byte
000000r 2               
000000r 2               ; --- CompactFlash Storage ---
000000r 2               StReadSector        := $A06C             ; Read one 512-byte sector
000000r 2                                                        ;   In: CF_LBA ($26-$29) = LBA, CF_BUF_PTR ($24-$25) = dest
000000r 2                                                        ;   Out: C=0 success, C=1 error; CF_BUF_PTR advanced by 512
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               StWriteSector       := $A06F             ; Write one 512-byte sector
000000r 2                                                        ;   In: CF_LBA ($26-$29) = LBA, CF_BUF_PTR ($24-$25) = source
000000r 2                                                        ;   Out: C=0 success, C=1 error; CF_BUF_PTR advanced by 512
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               StWaitReady         := $A072             ; Wait for CF to become ready (BSY=0, RDY=1)
000000r 2                                                        ;   Out: C=0 ready, C=1 timeout/error
000000r 2                                                        ;   Returns C=1 at once if the boot probe found no CF
000000r 2                                                        ;   card, rather than spinning out the full timeout.
000000r 2                                                        ;   Every FS and sector routine passes through here, so
000000r 2                                                        ;   an empty slot fails fast throughout the stack
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- Timing ---
000000r 2               SysDelay            := $A075             ; Delay for specified centiseconds (10 ms units)
000000r 2                                                        ;   In: A = low byte, X = high byte (16-bit count)
000000r 2                                                        ;   Uses VIA T1 if available, else software loop
000000r 2                                                        ;   Modifies: A, X, Y (X/Y clobbered only in software-fallback path)
000000r 2               
000000r 2               ; --- System / Cartridge Support ---
000000r 2               KernalInit          := $A078             ; Initialize all hardware (vectors, probe & init all I/O)
000000r 2                                                        ;   Caller MUST reset the stack pointer before JSR:
000000r 2                                                        ;     ldx #$ff / txs / jsr KernalInit
000000r 2                                                        ;   Zeroes BOOT_VECTOR, PRG_IMAGE_END and CF_DISK;
000000r 2                                                        ;   sets HW_PRESENT, IO_MODE, IRQ/BRK/NMI ptrs
000000r 2                                                        ;   Does NOT reset the stack pointer
000000r 2                                                        ;   Does NOT enable interrupts (caller must CLI)
000000r 2                                                        ;   Does NOT play beep, display splash, or enter boot menu
000000r 2                                                        ;   Does NOT halt if no console is detected
000000r 2                                                        ;   Modifies: All registers, flags
000000r 2               
000000r 2               KernalVersion       := $A07B             ; Get BIOS version
000000r 2                                                        ;   Out: A = major version, X = minor version
000000r 2               
000000r 2               ; --- Disk-banking & addressed storage (v1.1) ---
000000r 2               ;   CF_DISK ($030F) selects the current disk bank (0–255).
000000r 2               ;   All FS routines, StReadSector, and StWriteSector address the selected
000000r 2               ;   bank automatically.  Bank changes survive until the next reset.
000000r 2               
000000r 2               FsLoadFileAddr      := $A07E             ; Load named file from current disk to FS_IO_ADDR
000000r 2                                                        ;   In: STR_PTR = null-terminated filename
000000r 2                                                        ;       FS_IO_ADDR ($037F) = destination address
000000r 2                                                        ;   Out: C=0 success, FS_FILE_SIZE = bytes loaded; C=1 error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSaveFileAddr      := $A081             ; Save FS_FILE_SIZE bytes from FS_IO_ADDR to a named file
000000r 2                                                        ;   In: STR_PTR = filename
000000r 2                                                        ;       FS_IO_ADDR ($037F) = source address
000000r 2                                                        ;       FS_FILE_SIZE ($034A) = byte count
000000r 2                                                        ;   Out: C=0 success, C=1 error (disk full or write error)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsFormatDisk        := $A084             ; Zero the current disk's directory (erases all 16 entries)
000000r 2                                                        ;   Out: C=0 success, C=1 write error
000000r 2                                                        ;   No confirmation prompt — caller is responsible
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSetDisk           := $A087             ; Select the current CF disk bank
000000r 2                                                        ;   In: A = disk number (0–255) → stored in CF_DISK ($030F)
000000r 2                                                        ;   Modifies: Flags
000000r 2               
000000r 2               FsGetDisk           := $A08A             ; Get the current CF disk bank
000000r 2                                                        ;   Out: A = CF_DISK value (0–255)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               FsPrintDisk         := $A08D             ; Print "DISK n" + CRLF via Chrout (decimal, no leading zeros)
000000r 2                                                        ;   Uses current CF_DISK
000000r 2                                                        ;   Modifies: Flags, A, X, Y
000000r 2               
000000r 2               ; --- General Output Utilities (console routed by IO_MODE via Chrout) ---
000000r 2               PrintStr            := $A090             ; Print a NUL-terminated string
000000r 2                                                        ;   In : A = string addr low, Y = string addr high
000000r 2                                                        ;   Modifies: Flags, A, Y, STR_PTR (X preserved)
000000r 2               PrintCRLF           := $A093             ; Print CR ($0D) then LF ($0A)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               PrintDecU16         := $A096             ; Print an unsigned 16-bit value as decimal
000000r 2                                                        ;   In : A = value low, X = value high (no leading zeros)
000000r 2                                                        ;   Modifies: Flags, A, X, Y, FS_FILE_SIZE, FS_DIR_IDX
000000r 2               
000000r 2               ; --- Keyboard Encoder Control (raw GPIO port access) ---
000000r 2               ;   Both keyboard encoders drive the VIA ports the joysticks share.  Disable
000000r 2               ;   them to read GPIO_PORTA/GPIO_PORTB directly, then re-enable them.  The
000000r 2               ;   ReadJoystick routines do this for you; call these only for custom reads.
000000r 2               KBDisable           := $A099             ; Release both encoders and wait for them to let go
000000r 2                                                        ;   Busy-waits ~200 us so the ports settle before reading
000000r 2                                                        ;   Safe to call while the caller owns the VIA timers
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               KBEnable            := $A09C             ; Re-enable both keyboard encoders
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 5: IO HARDWARE REGISTERS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Banked RAM Low (IO 1: $8000-$83FF) ---
000000r 2               ;   256 banks × ~1 KB each.  Write bank number to latch, then access data window.
000000r 2               RAM_DATA_L          := $8000             ; R/W data window ($8000-$83FE)
000000r 2               RAM_BANK_L          := $83FF             ; Write-only bank latch ($00-$FF)
000000r 2               
000000r 2               ; --- Banked RAM High (IO 2: $8400-$87FF) ---
000000r 2               RAM_DATA_H          := $8400             ; R/W data window ($8400-$87FE)
000000r 2               RAM_BANK_H          := $87FF             ; Write-only bank latch ($00-$FF)
000000r 2               
000000r 2               ; --- RTC (DS1511Y) (IO 3: $8800-$881F) ---
000000r 2               RTC_SEC             := $8800             ; Seconds      (BCD, 00-59)
000000r 2               RTC_MIN             := $8801             ; Minutes      (BCD, 00-59)
000000r 2               RTC_HR              := $8802             ; Hours        (BCD, 00-23, 24h mode)
000000r 2               RTC_DAY             := $8803             ; Day of week  (1-7)
000000r 2               RTC_DATE            := $8804             ; Day of month (BCD, 01-31)
000000r 2               RTC_MON             := $8805             ; Month        (BCD, 01-12)
000000r 2               RTC_YR              := $8806             ; Year         (BCD, 00-99)
000000r 2               RTC_CENT            := $8807             ; Century      (BCD, 00-39)
000000r 2               RTC_ALARM_SEC       := $8808             ; Alarm seconds
000000r 2               RTC_ALARM_MIN       := $8809             ; Alarm minutes
000000r 2               RTC_ALARM_HR        := $880A             ; Alarm hours
000000r 2               RTC_ALARM_DATE      := $880B             ; Alarm day of month
000000r 2               RTC_WD_L            := $880C             ; Watchdog low
000000r 2               RTC_WD_H            := $880D             ; Watchdog high
000000r 2               RTC_CTRL_A          := $880E             ; Control Register A
000000r 2               RTC_CTRL_B          := $880F             ; Control Register B
000000r 2               RTC_RAM_ADDR        := $8810             ; NVRAM address register
000000r 2               RTC_RAM_DATA        := $8813             ; NVRAM data register
000000r 2               ; Control Register B bits:
000000r 2               RTC_CTRL_B_TE       := %10000000         ; Transfer Enable — set to inhibit clock updates during write
000000r 2               ; Month register ($8805) — the upper 3 bits are oscillator/SQW control, not month data.
000000r 2               ; Always mask with RTC_MON_MASK when reading the month, and preserve these bits on write.
000000r 2               RTC_MON_MASK        := %00011111         ; Month value occupies the low 5 bits
000000r 2               RTC_MON_EOSC        := %10000000         ; Oscillator Start/Stop (0 = oscillator running)
000000r 2               RTC_MON_E32K        := %01000000         ; 32 kHz square-wave enable (1 = SQW output disabled)
000000r 2               RTC_MON_BB32        := %00100000         ; Battery-backup 32 kHz SQW enable (1 = enabled in backup)
000000r 2               
000000r 2               ; --- CompactFlash / Storage (IO 4: $8C00-$8C07) ---
000000r 2               ;   8-bit IDE (True IDE) mode.  The BIOS issues Set Features $01 at boot
000000r 2               ;   to enable 8-bit data transfers.
000000r 2               ST_DATA             := $8C00             ; R/W — Data register
000000r 2               ST_ERROR            := $8C01             ; Read — Error register
000000r 2               ST_FEATURE          := $8C01             ; Write — Feature register
000000r 2               ST_SECT_CNT         := $8C02             ; R/W — Sector count
000000r 2               ST_LBA_0            := $8C03             ; R/W — LBA bits 0-7
000000r 2               ST_LBA_1            := $8C04             ; R/W — LBA bits 8-15
000000r 2               ST_LBA_2            := $8C05             ; R/W — LBA bits 16-23
000000r 2               ST_LBA_3            := $8C06             ; R/W — LBA bits 24-27 + drive/mode
000000r 2               ST_STATUS           := $8C07             ; Read — Status register
000000r 2               ST_CMD              := $8C07             ; Write — Command register
000000r 2               
000000r 2               ; CF Status Register bits:
000000r 2               ST_STATUS_ERR       := %00000001         ; Error occurred
000000r 2               ST_STATUS_IDX       := %00000010         ; Index mark
000000r 2               ST_STATUS_CORR      := %00000100         ; Corrected data
000000r 2               ST_STATUS_DRQ       := %00001000         ; Data request — ready for data transfer
000000r 2               ST_STATUS_DSC       := %00010000         ; Drive seek complete
000000r 2               ST_STATUS_DWF       := %00100000         ; Drive write fault
000000r 2               ST_STATUS_RDY       := %01000000         ; Drive ready
000000r 2               ST_STATUS_BSY       := %10000000         ; Drive busy — all other bits invalid while set
000000r 2               
000000r 2               ; CF Error Register bits:
000000r 2               ST_ERR_AMNF         := %00000001         ; Address mark not found
000000r 2               ST_ERR_ABRT         := %00000100         ; Command aborted
000000r 2               ST_ERR_IDNF         := %00010000         ; ID not found
000000r 2               ST_ERR_UNC          := %01000000         ; Uncorrectable data error
000000r 2               ST_ERR_BBK          := %10000000         ; Bad block detected
000000r 2               
000000r 2               ; ATA Command bytes:
000000r 2               ST_CMD_READ         := $20               ; Read Sectors
000000r 2               ST_CMD_WRITE        := $30               ; Write Sectors
000000r 2               ST_CMD_SET_FEAT     := $EF               ; Set Features
000000r 2               ST_FEAT_8BIT        := $01               ; Feature: Enable 8-bit data I/O
000000r 2               ST_LBA3_MASTER      := $E0               ; LBA mode, master drive (bits 7-5=111, bit 4=0)
000000r 2               
000000r 2               ; Filesystem constants:
000000r 2               FS_DIR_LBA          = 0                  ; Directory sector at LBA 0
000000r 2               FS_DATA_START       = 1                  ; Data sectors start at LBA 1
000000r 2               FS_MAX_FILES        = 16                 ; Maximum directory entries
000000r 2               FS_ENTRY_SIZE       = 32                 ; Bytes per directory entry
000000r 2               FS_ENTRY_FLAGS      = 11                 ; Offset: flags byte within entry
000000r 2               FS_ENTRY_START      = 12                 ; Offset: start sector (2 bytes, little-endian)
000000r 2               FS_ENTRY_FSIZE      = 14                 ; Offset: file size (2 bytes, little-endian)
000000r 2               FS_FLAG_USED        = %00000001          ; Flags bit 0: entry in use
000000r 2               FS_DISK_SECTORS     = 2048               ; Sectors per disk bank (2048 × 512 bytes = 1 MB); 256 banks = 256 MB total
000000r 2               
000000r 2               ; XModem protocol constants (used with XModemLoad / XModemSave):
000000r 2               XMODEM_SOH          = $01                ; Start of Header
000000r 2               XMODEM_EOT          = $04                ; End of Transmission
000000r 2               XMODEM_ACK          = $06                ; Acknowledge
000000r 2               XMODEM_NAK          = $15                ; Negative Acknowledge (receiver sends to initiate transfer)
000000r 2               XMODEM_CAN          = $18                ; Cancel
000000r 2               XMODEM_SUB          = $1A                ; Padding byte (fills unused bytes in last block)
000000r 2               XMODEM_BLKSZ        = 128                ; Data bytes per block
000000r 2               XMODEM_MAXRETRY     = 10                 ; Max retries per block during transfer
000000r 2               XMODEM_STARTRETRY   = 60                 ; Retries waiting for initial connect (~60s)
000000r 2               
000000r 2               ; --- Serial Card (R65C51 ACIA) (IO 5: $9000-$9003) ---
000000r 2               ;   Default config after InitSC: 8-N-1, 19200 baud, RX IRQ enabled
000000r 2               SC_DATA             := $9000             ; R/W — Data register
000000r 2               SC_RESET            := $9001             ; Write — Programmatic reset (write any value)
000000r 2               SC_STATUS           := $9001             ; Read — Status register
000000r 2               SC_CMD              := $9002             ; R/W — Command register
000000r 2               SC_CTRL             := $9003             ; R/W — Control register
000000r 2               
000000r 2               ; Serial Status Register bits:
000000r 2               SC_STATUS_IRQ       := %10000000         ; Interrupt occurred
000000r 2               SC_STATUS_DSR       := %01000000         ; Data Set Ready
000000r 2               SC_STATUS_DCD       := %00100000         ; Data Carrier Detect
000000r 2               SC_STATUS_TDRE      := %00010000         ; TX Data Register Empty (ready to send)
000000r 2               SC_STATUS_RDRF      := %00001000         ; RX Data Register Full (byte available)
000000r 2               SC_STATUS_OVR       := %00000100         ; Overrun error
000000r 2               SC_STATUS_FRME      := %00000010         ; Framing error
000000r 2               SC_STATUS_PARE      := %00000001         ; Parity error
000000r 2               
000000r 2               ; --- GPIO / Input Board (65C22 VIA) (IO 6: $9400-$940F) ---
000000r 2               ;   Port B = matrix keyboard / joystick 1
000000r 2               ;   Port A = PS/2 keyboard / joystick 2
000000r 2               ;   CB1/CA1 IRQs fire when a key scancode is ready
000000r 2               GPIO_PORTB          := $9400             ; Port B data (active keyboard/joystick 1 data)
000000r 2               GPIO_PORTA          := $9401             ; Port A data (active keyboard/joystick 2 data)
000000r 2               GPIO_DDRB           := $9402             ; Port B data direction (0=input, 1=output per bit)
000000r 2               GPIO_DDRA           := $9403             ; Port A data direction
000000r 2               GPIO_T1CL           := $9404             ; Timer 1 counter low (read=counter, write=latch)
000000r 2               GPIO_T1CH           := $9405             ; Timer 1 counter high (write starts timer)
000000r 2               GPIO_T1LL           := $9406             ; Timer 1 latch low
000000r 2               GPIO_T1LH           := $9407             ; Timer 1 latch high
000000r 2               GPIO_T2CL           := $9408             ; Timer 2 counter low
000000r 2               GPIO_T2CH           := $9409             ; Timer 2 counter high
000000r 2               GPIO_SR             := $940A             ; Shift register
000000r 2               GPIO_ACR            := $940B             ; Auxiliary control register
000000r 2               GPIO_PCR            := $940C             ; Peripheral control register
000000r 2               GPIO_IFR            := $940D             ; Interrupt flag register
000000r 2               GPIO_IER            := $940E             ; Interrupt enable register
000000r 2               GPIO_ORA            := $940F             ; Port A (no handshake)
000000r 2               
000000r 2               ; VIA Peripheral Control Register (PCR) mode bits:
000000r 2               GPIO_PCR_CB2_LO     := %11000000         ; CB2 = manual output low  (enable matrix keyboard encoder)
000000r 2               GPIO_PCR_CB2_HI     := %11100000         ; CB2 = manual output high (disable matrix keyboard encoder)
000000r 2               GPIO_PCR_CB1_NEG    := %00000000         ; CB1 = active on falling edge
000000r 2               GPIO_PCR_CA2_LO     := %00001100         ; CA2 = manual output low  (enable PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA2_HI     := %00001110         ; CA2 = manual output high (disable PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA1_NEG    := %00000000         ; CA1 = active on falling edge
000000r 2               
000000r 2               ; VIA Interrupt flag/enable bits:
000000r 2               GPIO_INT_CB1        := %00010000         ; Bit 4: CB1 interrupt (matrix keyboard data ready)
000000r 2               GPIO_INT_CA1        := %00000010         ; Bit 1: CA1 interrupt (PS/2 keyboard data ready)
000000r 2               GPIO_IER_SET        := %10000000         ; IER bit 7: 1=set named bits, 0=clear named bits
000000r 2               
000000r 2               ; --- Sound Card (SID / ARMSID) (IO 7: $9800-$981C) ---
000000r 2               ;   MOS 6581/8580 compatible.  3 voices, each with independent frequency,
000000r 2               ;   pulse width, waveform, and ADSR envelope.  Global filter and volume.
000000r 2               
000000r 2               ; Voice 1:
000000r 2               SID_V1_FREQ_LO      := $9800             ; Frequency low byte
000000r 2               SID_V1_FREQ_HI      := $9801             ; Frequency high byte
000000r 2               SID_V1_PW_LO        := $9802             ; Pulse width low byte (bits 0-7)
000000r 2               SID_V1_PW_HI        := $9803             ; Pulse width high nibble (bits 0-3)
000000r 2               SID_V1_CTRL         := $9804             ; Control register (waveform + gate)
000000r 2               SID_V1_AD           := $9805             ; Attack (high nibble) / Decay (low nibble)
000000r 2               SID_V1_SR           := $9806             ; Sustain (high nibble) / Release (low nibble)
000000r 2               
000000r 2               ; Voice 2:
000000r 2               SID_V2_FREQ_LO      := $9807
000000r 2               SID_V2_FREQ_HI      := $9808
000000r 2               SID_V2_PW_LO        := $9809
000000r 2               SID_V2_PW_HI        := $980A
000000r 2               SID_V2_CTRL         := $980B
000000r 2               SID_V2_AD           := $980C
000000r 2               SID_V2_SR           := $980D
000000r 2               
000000r 2               ; Voice 3:
000000r 2               SID_V3_FREQ_LO      := $980E
000000r 2               SID_V3_FREQ_HI      := $980F
000000r 2               SID_V3_PW_LO        := $9810
000000r 2               SID_V3_PW_HI        := $9811
000000r 2               SID_V3_CTRL         := $9812
000000r 2               SID_V3_AD           := $9813
000000r 2               SID_V3_SR           := $9814
000000r 2               
000000r 2               ; Global SID registers:
000000r 2               SID_FC_LO           := $9815             ; Filter cutoff low (bits 0-2)
000000r 2               SID_FC_HI           := $9816             ; Filter cutoff high (bits 0-7)
000000r 2               SID_RES_FILT        := $9817             ; Resonance (high nibble) / Filter enable per voice (bits 0-2)
000000r 2               SID_MODE_VOL        := $9818             ; Filter mode (high nibble) / Master volume (low nibble, 0-15)
000000r 2               SID_PADDLE_X        := $9819             ; Paddle X (read-only)
000000r 2               SID_PADDLE_Y        := $981A             ; Paddle Y (read-only)
000000r 2               SID_OSC3            := $981B             ; Oscillator 3 output (read-only)
000000r 2               SID_ENV3            := $981C             ; Envelope 3 output (read-only)
000000r 2               
000000r 2               ; SID Voice Control Register bits (apply to SID_Vn_CTRL):
000000r 2               SID_CTRL_GATE       := %00000001         ; Gate: 1=start attack, 0=start release
000000r 2               SID_CTRL_SYNC       := %00000010         ; Hard sync with preceding voice
000000r 2               SID_CTRL_RING       := %00000100         ; Ring modulation with preceding voice
000000r 2               SID_CTRL_TEST       := %00001000         ; Test bit (resets oscillator)
000000r 2               SID_CTRL_TRIANGLE   := %00010000         ; Triangle waveform
000000r 2               SID_CTRL_SAWTOOTH   := %00100000         ; Sawtooth waveform
000000r 2               SID_CTRL_PULSE      := %01000000         ; Pulse waveform
000000r 2               SID_CTRL_NOISE      := %10000000         ; Noise waveform
000000r 2               
000000r 2               ; SID Filter Mode bits (high nibble of SID_MODE_VOL):
000000r 2               SID_FILT_LP         := %00010000         ; Low-pass filter
000000r 2               SID_FILT_BP         := %00100000         ; Band-pass filter
000000r 2               SID_FILT_HP         := %01000000         ; High-pass filter
000000r 2               SID_FILT_3OFF       := %10000000         ; Disconnect voice 3 from output
000000r 2               
000000r 2               ; --- SID Frequency Table (1 MHz clock, equal temperament) ---
000000r 2               ;   Freq register = round(Hz × 16777216 / 1000000)
000000r 2               ;   Covers octaves 2-7 (C2=65 Hz to B7=3951 Hz), all 12 chromatic notes.
000000r 2               ;   Sharps and flats are provided as aliases (e.g. SID_NOTE_CS4 = SID_NOTE_Db4).
000000r 2               ;   Use SidPlayNote: A=voice (0-2), X=freq low byte, Y=freq high byte.
000000r 2               ;   Example: ldx #<SID_NOTE_A4 / ldy #>SID_NOTE_A4
000000r 2               
000000r 2               ; Octave 2 (C2=65.41 Hz .. B2=123.47 Hz)
000000r 2               SID_NOTE_C2         = $0449              ; ~65 Hz
000000r 2               SID_NOTE_CS2        = $048B              ; ~69 Hz
000000r 2               SID_NOTE_Db2        = SID_NOTE_CS2
000000r 2               SID_NOTE_D2         = $04D0              ; ~73 Hz
000000r 2               SID_NOTE_DS2        = $0519              ; ~78 Hz
000000r 2               SID_NOTE_Eb2        = SID_NOTE_DS2
000000r 2               SID_NOTE_E2         = $0567              ; ~82 Hz
000000r 2               SID_NOTE_F2         = $05B9              ; ~87 Hz
000000r 2               SID_NOTE_FS2        = $0610              ; ~93 Hz
000000r 2               SID_NOTE_Gb2        = SID_NOTE_FS2
000000r 2               SID_NOTE_G2         = $066C              ; ~98 Hz
000000r 2               SID_NOTE_GS2        = $06CE              ; ~104 Hz
000000r 2               SID_NOTE_Ab2        = SID_NOTE_GS2
000000r 2               SID_NOTE_A2         = $0735              ; ~110 Hz
000000r 2               SID_NOTE_AS2        = $07A3              ; ~117 Hz
000000r 2               SID_NOTE_Bb2        = SID_NOTE_AS2
000000r 2               SID_NOTE_B2         = $0817              ; ~123 Hz
000000r 2               
000000r 2               ; Octave 3 (C3=130.81 Hz .. B3=246.94 Hz)
000000r 2               SID_NOTE_C3         = $0893              ; ~131 Hz
000000r 2               SID_NOTE_CS3        = $0915              ; ~139 Hz
000000r 2               SID_NOTE_Db3        = SID_NOTE_CS3
000000r 2               SID_NOTE_D3         = $099F              ; ~147 Hz
000000r 2               SID_NOTE_DS3        = $0A32              ; ~156 Hz
000000r 2               SID_NOTE_Eb3        = SID_NOTE_DS3
000000r 2               SID_NOTE_E3         = $0ACD              ; ~165 Hz
000000r 2               SID_NOTE_F3         = $0B72              ; ~175 Hz
000000r 2               SID_NOTE_FS3        = $0C20              ; ~185 Hz
000000r 2               SID_NOTE_Gb3        = SID_NOTE_FS3
000000r 2               SID_NOTE_G3         = $0CD8              ; ~196 Hz
000000r 2               SID_NOTE_GS3        = $0D9C              ; ~208 Hz
000000r 2               SID_NOTE_Ab3        = SID_NOTE_GS3
000000r 2               SID_NOTE_A3         = $0E6B              ; ~220 Hz
000000r 2               SID_NOTE_AS3        = $0F46              ; ~233 Hz
000000r 2               SID_NOTE_Bb3        = SID_NOTE_AS3
000000r 2               SID_NOTE_B3         = $102F              ; ~247 Hz
000000r 2               
000000r 2               ; Octave 4 (C4=261.63 Hz .. B4=493.88 Hz) — middle octave
000000r 2               SID_NOTE_C4         = $1125              ; ~262 Hz (Middle C)
000000r 2               SID_NOTE_CS4        = $122A              ; ~277 Hz
000000r 2               SID_NOTE_Db4        = SID_NOTE_CS4
000000r 2               SID_NOTE_D4         = $133F              ; ~294 Hz
000000r 2               SID_NOTE_DS4        = $1464              ; ~311 Hz
000000r 2               SID_NOTE_Eb4        = SID_NOTE_DS4
000000r 2               SID_NOTE_E4         = $159A              ; ~330 Hz
000000r 2               SID_NOTE_F4         = $16E3              ; ~349 Hz
000000r 2               SID_NOTE_FS4        = $183F              ; ~370 Hz
000000r 2               SID_NOTE_Gb4        = SID_NOTE_FS4
000000r 2               SID_NOTE_G4         = $19B1              ; ~392 Hz
000000r 2               SID_NOTE_GS4        = $1B38              ; ~415 Hz
000000r 2               SID_NOTE_Ab4        = SID_NOTE_GS4
000000r 2               SID_NOTE_A4         = $1CD6              ; ~440 Hz (Concert A)
000000r 2               SID_NOTE_AS4        = $1E8D              ; ~466 Hz
000000r 2               SID_NOTE_Bb4        = SID_NOTE_AS4
000000r 2               SID_NOTE_B4         = $205E              ; ~494 Hz
000000r 2               
000000r 2               ; Octave 5 (C5=523.25 Hz .. B5=987.77 Hz)
000000r 2               SID_NOTE_C5         = $224B              ; ~523 Hz
000000r 2               SID_NOTE_CS5        = $2455              ; ~554 Hz
000000r 2               SID_NOTE_Db5        = SID_NOTE_CS5
000000r 2               SID_NOTE_D5         = $267E              ; ~587 Hz
000000r 2               SID_NOTE_DS5        = $28C8              ; ~622 Hz
000000r 2               SID_NOTE_Eb5        = SID_NOTE_DS5
000000r 2               SID_NOTE_E5         = $2B34              ; ~659 Hz
000000r 2               SID_NOTE_F5         = $2DC6              ; ~698 Hz
000000r 2               SID_NOTE_FS5        = $307F              ; ~740 Hz
000000r 2               SID_NOTE_Gb5        = SID_NOTE_FS5
000000r 2               SID_NOTE_G5         = $3361              ; ~784 Hz
000000r 2               SID_NOTE_GS5        = $366F              ; ~831 Hz
000000r 2               SID_NOTE_Ab5        = SID_NOTE_GS5
000000r 2               SID_NOTE_A5         = $39AC              ; ~880 Hz
000000r 2               SID_NOTE_AS5        = $3D1A              ; ~932 Hz
000000r 2               SID_NOTE_Bb5        = SID_NOTE_AS5
000000r 2               SID_NOTE_B5         = $40BC              ; ~988 Hz
000000r 2               
000000r 2               ; Octave 6 (C6=1046.50 Hz .. B6=1975.53 Hz)
000000r 2               SID_NOTE_C6         = $4495              ; ~1047 Hz
000000r 2               SID_NOTE_CS6        = $48A9              ; ~1109 Hz
000000r 2               SID_NOTE_Db6        = SID_NOTE_CS6
000000r 2               SID_NOTE_D6         = $4CFC              ; ~1175 Hz
000000r 2               SID_NOTE_DS6        = $518F              ; ~1245 Hz
000000r 2               SID_NOTE_Eb6        = SID_NOTE_DS6
000000r 2               SID_NOTE_E6         = $5669              ; ~1319 Hz
000000r 2               SID_NOTE_F6         = $5B8C              ; ~1397 Hz
000000r 2               SID_NOTE_FS6        = $60FE              ; ~1480 Hz
000000r 2               SID_NOTE_Gb6        = SID_NOTE_FS6
000000r 2               SID_NOTE_G6         = $66C2              ; ~1568 Hz
000000r 2               SID_NOTE_GS6        = $6CDF              ; ~1661 Hz
000000r 2               SID_NOTE_Ab6        = SID_NOTE_GS6
000000r 2               SID_NOTE_A6         = $7358              ; ~1760 Hz
000000r 2               SID_NOTE_AS6        = $7A34              ; ~1865 Hz
000000r 2               SID_NOTE_Bb6        = SID_NOTE_AS6
000000r 2               SID_NOTE_B6         = $8178              ; ~1976 Hz
000000r 2               
000000r 2               ; Octave 7 (C7=2093.00 Hz .. A7=3520.00 Hz; B7 overflows 16-bit register)
000000r 2               SID_NOTE_C7         = $892B              ; ~2093 Hz
000000r 2               SID_NOTE_CS7        = $9153              ; ~2217 Hz
000000r 2               SID_NOTE_Db7        = SID_NOTE_CS7
000000r 2               SID_NOTE_D7         = $99F7              ; ~2349 Hz
000000r 2               SID_NOTE_DS7        = $A31F              ; ~2489 Hz
000000r 2               SID_NOTE_Eb7        = SID_NOTE_DS7
000000r 2               SID_NOTE_E7         = $ACD2              ; ~2637 Hz
000000r 2               SID_NOTE_F7         = $B719              ; ~2794 Hz
000000r 2               SID_NOTE_FS7        = $C1FC              ; ~2960 Hz
000000r 2               SID_NOTE_Gb7        = SID_NOTE_FS7
000000r 2               SID_NOTE_G7         = $CD85              ; ~3136 Hz
000000r 2               SID_NOTE_GS7        = $D9BD              ; ~3322 Hz
000000r 2               SID_NOTE_Ab7        = SID_NOTE_GS7
000000r 2               SID_NOTE_A7         = $E6B0              ; ~3520 Hz
000000r 2               SID_NOTE_AS7        = $F467              ; ~3729 Hz
000000r 2               SID_NOTE_Bb7        = SID_NOTE_AS7
000000r 2               ; Note: B7 (~3951 Hz = $102F0) exceeds the 16-bit SID register — not defined
000000r 2               
000000r 2               ; --- Video Card (TMS9918 / pico9918) (IO 8: $9C00-$9C01) ---
000000r 2               ;   Text mode: 40 columns × 24 rows.  Name table at VRAM $0000 (960 bytes).
000000r 2               ;   Pattern table at VRAM $0800 (2 KB, 256 × 8-byte character patterns).
000000r 2               ;   To write to a VRAM address: write low byte to VC_REG, then (high | $40) to VC_REG.
000000r 2               ;   To read from a VRAM address: write low byte to VC_REG, then high byte to VC_REG.
000000r 2               ;   Register writes: write data byte to VC_REG, then (reg# | $80) to VC_REG.
000000r 2               VC_DATA             := $9C00             ; R/W — VRAM data (auto-increments address)
000000r 2               VC_REG              := $9C01             ; Write — Address/register port
000000r 2               VC_STATUS           := $9C01             ; Read — Status register
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 6: USEFUL CONSTANTS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- BIOS Version ---
000000r 2               BIOS_VERSION_MAJOR  = 1
000000r 2               BIOS_VERSION_MINOR  = 5
000000r 2               
000000r 2               ; --- ASCII Control Characters ---
000000r 2               CHAR_BEL            = $07                ; Bell (Beep via SID)
000000r 2               CHAR_BS             = $08                ; Backspace (cursor left + erase in video mode)
000000r 2               CHAR_LF             = $0A                ; Line Feed (cursor down, scroll if at bottom)
000000r 2               CHAR_CR             = $0D                ; Carriage Return (cursor to column 0)
000000r 2               CHAR_ESC            = $1B                ; Escape
000000r 2               CHAR_SPACE          = $20                ; Space
000000r 2               
000000r 2               ; --- Video Dimensions ---
000000r 2               VID_COLS            = 40                 ; Screen width in columns
000000r 2               VID_ROWS            = 24                 ; Screen height in rows
000000r 2               VID_NAME_TABLE      = $0000              ; VRAM address of name table (40×24 = 960 bytes)
000000r 2               VID_PATTERN_TABLE   = $0800              ; VRAM address of pattern/character table (2048 bytes)
000000r 2               
000000r 2               ; --- TMS9918 Color Constants (for VideoSetColor) ---
000000r 2               ;   Pass as: (foreground << 4) | background
000000r 2               ;   Example: white on black = $F0, green on black = $20
000000r 2               TMS_TRANSPARENT     = $0
000000r 2               TMS_BLACK           = $1
000000r 2               TMS_MED_GREEN       = $2
000000r 2               TMS_LT_GREEN        = $3
000000r 2               TMS_DK_BLUE         = $4
000000r 2               TMS_LT_BLUE         = $5
000000r 2               TMS_DK_RED          = $6
000000r 2               TMS_CYAN            = $7
000000r 2               TMS_MED_RED         = $8
000000r 2               TMS_LT_RED          = $9
000000r 2               TMS_DK_YELLOW       = $A
000000r 2               TMS_LT_YELLOW       = $B
000000r 2               TMS_DK_GREEN        = $C
000000r 2               TMS_MAGENTA         = $D
000000r 2               TMS_GRAY            = $E
000000r 2               TMS_WHITE           = $F
000000r 2               
000000r 2               ; --- Monitor Entry Points ---
000000r 2               ;   The machine code monitor lives at $EE00 and is entered normally via BRK.
000000r 2               ;   These are useful if you want to jump there directly.
000000r 2               MONITOR_ENTRY       := $EE00             ; Cold entry (from boot menu or user code)
000000r 2               MONITOR_BRK_ENTRY   := $EE03             ; BRK entry (displays saved registers)
000000r 2               
000000r 1               
000000r 1               ; --- Platform constants (hal.inc) --------------------------------------------
000000r 1               SCR_COLS         = 32
000000r 1               SCR_ROWS         = 24
000000r 1               SCR_CELLS        = SCR_COLS * SCR_ROWS     ; 768
000000r 1               PANEL_X             = 5             ; (32 - 22) / 2 — exact centring
000000r 1               PANEL_Y             = 0
000000r 1               HAS_COLOR_RAM       = 0             ; Colour lives in the VDP colour table
000000r 1               
000000r 1               ; --- VRAM map (SPEC Appendix C.1) --------------------------------------------
000000r 1               VRAM_PATTERNS       = $0000         ; 2 K, 256 patterns x 8 bytes
000000r 1               VRAM_NAMES          = $1400         ; 768, the 32 x 24 name table
000000r 1               VRAM_SPRITES        = $1B00         ; Sprite attributes — disabled below
000000r 1               VRAM_COLORS         = $2000         ; 32, one byte per 8-pattern group
000000r 1               
000000r 1               .include "../src/constants.inc"
000000r 2               ; =============================================================================
000000r 2               ;   constants.inc — Wizards Lab, shared game constants
000000r 2               ; =============================================================================
000000r 2               ;   Everything here comes straight out of SPEC.md. If a number changes there,
000000r 2               ;   it changes here, and nowhere else. Nothing in this file is platform
000000r 2               ;   specific — see the per-platform WizardsLab.asm for PANEL_X / PANEL_Y and
000000r 2               ;   the hardware addresses.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Board (SPEC 3) ----------------------------------------------------------
000000r 2               BOARD_W             = 6         ; Playfield columns
000000r 2               BOARD_H             = 16        ; Playfield rows
000000r 2               BOARD_STRIDE        = 8         ; Bytes per row — two wasted, on purpose
000000r 2               BOARD_ROWS_ALLOC    = 20        ; 16 playfield + 2 floor sentinels + 2 reserved
000000r 2               BOARD_BYTES         = BOARD_ROWS_ALLOC * BOARD_STRIDE    ; 160
000000r 2               SPAWN_COL           = 2         ; 0-indexed, left of centre
000000r 2               MATCH_MIN           = 3         ; Run length that clears
000000r 2               
000000r 2               ; --- Tile encoding (SPEC 4) --------------------------------------------------
000000r 2               ;   tile = COLOR_BASE + (color << 3) + glyph
000000r 2               ;   The board byte IS the tile index. No translation on the way to the screen.
000000r 2               TILE_EMPTY          = $00
000000r 2               TILE_WALL           = $FF
000000r 2               COLOR_BASE          = $40
000000r 2               COLOR_MASK          = $F8       ; AND this and you have the colour key
000000r 2               GLYPH_MASK          = $07
000000r 2               WILD_BASE           = $70       ; Colour 6 — the prism
000000r 2               NUM_COLORS          = 6
000000r 2               
000000r 2               COLOR_RED           = 0
000000r 2               COLOR_YELLOW        = 1
000000r 2               COLOR_GREEN         = 2
000000r 2               COLOR_CYAN          = 3
000000r 2               COLOR_BLUE          = 4
000000r 2               COLOR_PURPLE        = 5
000000r 2               COLOR_WILD          = 6
000000r 2               
000000r 2               GLYPH_POTION        = 0
000000r 2               GLYPH_FIREBALL      = 1
000000r 2               GLYPH_BOLT          = 2
000000r 2               GLYPH_BOMB          = 3
000000r 2               GLYPH_STAR          = 4
000000r 2               GLYPH_GLOW          = 6         ; Match-flash frame. Potion colours only —
000000r 2                                               ;   WILD_BASE + GLYPH_GLOW is an arrow, not a
000000r 2                                               ;   glow, so the prism never takes this path.
000000r 2                                               ;   See PRISM_BLIP below and SPEC 4.4.
000000r 2               
000000r 2               ; --- Named tiles -------------------------------------------------------------
000000r 2               TILE_BLANK          = 0
000000r 2               TILE_BAR_H          = 1
000000r 2               TILE_BAR_V          = 2
000000r 2               TILE_COR_TL         = 3
000000r 2               TILE_COR_TR         = 4
000000r 2               TILE_COR_BL         = 5
000000r 2               TILE_COR_BR         = 6
000000r 2               TILE_WASH           = 7         ; PAUSE / dim wash, white
000000r 2               FONT_BASE           = 16        ; '0'..'9' then 'A'..'Z' then . x ! ~
000000r 2               FONT_DIGIT_0        = 16
000000r 2               FONT_LETTER_A       = 26
000000r 2               FONT_DOT            = 52        ; A CENTRED dot, not a baseline period — it is
000000r 2                                               ;   also frame 0 of the removal ring below
000000r 2               FONT_TIMES          = 53
000000r 2               FONT_BANG           = 54
000000r 2               FONT_TILDE          = 55        ; The banner ornament, ~~~LIKE THIS~~~
000000r 2               TEXT_END            = $FF       ; String terminator. Shares its value with
000000r 2                                               ;   TILE_WALL, which costs nothing: no string
000000r 2                                               ;   ever contains tile 255.
000000r 2               
000000r 2               ; The removal ring (SPEC 14). One animation, used for every removal there is:
000000r 2               ; the match shatter, the bomb blast, the star. It opens outward
000000r 2               ;
000000r 2               ;       FONT_DOT -> VFX_REMOVE1 -> VFX_REMOVE2 -> VFX_REMOVE3 -> empty
000000r 2               ;
000000r 2               ; and the prism's blip-out runs the same tiles closed inward (PRISM_BLIP).
000000r 2               VFX_REMOVE1         = 56
000000r 2               VFX_REMOVE2         = 57
000000r 2               VFX_REMOVE3         = 58
000000r 2               VFX_BEAM_H          = 59        ; The bolt's row
000000r 2               VFX_BEAM_V          = 60        ; The bolt's column
000000r 2               VFX_BEAM_CROSS      = 61        ; Drawn once, at the bolt's own cell
000000r 2               ARROW_UP            = 62        ; The title screen's controls (SPEC 13.1).
000000r 2               ARROW_DOWN          = 63        ;   Up and down live in group 7, left and
000000r 2               ARROW_LEFT          = 118       ;   right in group 14 — whichever white group
000000r 2               ARROW_RIGHT         = 119       ;   had a slot spare. Nothing indexes them.
000000r 2               
000000r 2               ; Group 14 is the prism's. Slots +0..+3 are its idle rotation and +4..+5 its
000000r 2               ; blip-out; there is no glow slot (SPEC A.3).
000000r 2               PRISM_SPIN          = WILD_BASE ; Four frames, WILD_BASE + 0..3
000000r 2               PRISM_SPIN_FRAMES   = 4
000000r 2               PRISM_BLIP          = WILD_BASE + 4     ; Two frames, then VFX_REMOVE2,
000000r 2                                                       ;   VFX_REMOVE1, FONT_DOT, empty
000000r 2               
000000r 2               ; Group 15 is the stone group: the petrified glyph set at the same offsets the
000000r 2               ; potions use, so a cell petrifies into its own shape —
000000r 2               ;
000000r 2               ;       petrified = PETRIFY_BASE + (tile & GLYPH_MASK)     for glyphs 0-4
000000r 2               ;
000000r 2               ; — and then the two tiles the margins are built from.
000000r 2               PETRIFY_BASE        = 120       ; +0 potion, +1 fireball, +2 bolt,
000000r 2                                               ;   +3 bomb, +4 star
000000r 2               TILE_RESERVED       = 125       ; Held for a sixth glyph, if one is ever added
000000r 2               TILE_SHELF          = 126       ; The shelf the panel stands on
000000r 2               TILE_BRICK          = 127       ; Brick — the margin fill
000000r 2               FRAME_DIM           = 8         ; Group 1 is group 0 byte for byte, one colour
000000r 2                                               ;   quieter, so frame_tile + FRAME_DIM is any
000000r 2                                               ;   frame piece's dim twin (SPEC A.3)
000000r 2               ART_BASE            = 128       ; Groups 16-31 — one hatch in sixteen colours,
000000r 2                                               ;   the title screen's magic field (SPEC 13.1)
000000r 2               ART_TILES           = 128
000000r 2               
000000r 2               ; --- Panel geometry (SPEC 12) ------------------------------------------------
000000r 2               ;   One 22 x 24 panel, rendered identically on all three machines. PANEL_Y is
000000r 2               ;   0 everywhere; only PANEL_X differs. The panel is vertically symmetric —
000000r 2               ;   backdrop row, band row, backdrop row, eighteen rows of frame, backdrop row,
000000r 2               ;   band row, backdrop row — which is why 24 is the height. The AC6502 is the
000000r 2               ;   exact fit; the VIC-20 clips panel row 23 off the bottom and the C64 has one
000000r 2               ;   spare screen row (24) below the panel. See SPEC 12.4.
000000r 2               PANEL_W             = 22
000000r 2               PANEL_H             = 24
000000r 2               
000000r 2               WELL_ORIGIN_X       = 1         ; Panel-relative: board (0,0) lives here
000000r 2               WELL_ORIGIN_Y       = 4
000000r 2               
000000r 2               SCORE_X             = 12        ; 7 digits, cols 12-18
000000r 2               SCORE_Y             = 5
000000r 2               HIGH_X              = 12        ; 7 digits, cols 12-18
000000r 2               HIGH_Y              = 10
000000r 2               HIGHLVL_X           = 15        ; Level the high score was set on, 2 digits;
000000r 2                                               ;   the 'L' at col 14 is in the static image
000000r 2               HIGHLVL_Y           = 11
000000r 2               LEVEL_X             = 18        ; Single column: tens above units
000000r 2               LEVEL_Y             = 17        ; Tens at LEVEL_Y, units at LEVEL_Y + 1
000000r 2               NEXT_X              = 11        ; Single tile column
000000r 2               NEXT_Y              = 16        ; Cells A, B, C at NEXT_Y, +1, +2
000000r 2               MSG_X               = 2         ; The band's OWNED cells. Panel columns 0-1 and
000000r 2               MSG_W               = 18        ;   20-21 of row 22 are shelf in the static
000000r 2               MSG_Y               = 22        ;   image and code never touches them; the
000000r 2                                               ;   banner still centres on the full PANEL_W,
000000r 2                                               ;   which lands in the same place for an
000000r 2                                               ;   even-length string (SPEC 12.2).
000000r 2               
000000r 2               SCORE_DIGITS        = 7         ; Always all 7 drawn, zero padded
000000r 2               LEVEL_DIGITS        = 2         ; Always zero padded — level 5 draws "0" / "5"
000000r 2               
000000r 2               ; --- Levels (SPEC 10) --------------------------------------------------------
000000r 2               LEVEL_TILES         = 30        ; Tiles cleared per level
000000r 2               LEVEL_SPEED_CAP     = 16        ; Speed stops improving here
000000r 2               LEVEL_MAX_SHOWN     = 99
000000r 2               
000000r 2               ; --- Scoring (SPEC 9) --------------------------------------------------------
000000r 2               BONUS_FIREBALL      = $0500     ; BCD
000000r 2               BONUS_BOLT          = $0300
000000r 2               BONUS_BOMB          = $0300
000000r 2               BONUS_PRISM         = $0400
000000r 2               BONUS_LEVELUP       = $1000
000000r 2               STAR_SHIFT_CAP      = 3         ; Three doublings — x8
000000r 2               SCORE_BYTES         = 4         ; 8 nibbles packed BCD; the top one stays 0,
000000r 2                                               ;   so 7 digits show and the score wraps at
000000r 2                                               ;   10,000,000.
000000r 2               HIGH_INIT_LO        = $00       ; 0010000
000000r 2               HIGH_INIT_MID       = $00
000000r 2               HIGH_INIT_HI        = $01
000000r 2               HIGH_INIT_TOP       = $00
000000r 2               
000000r 2               ; --- Reagent probability, out of 256 (SPEC 5.3) ------------------------------
000000r 2               PSPECIAL_BANDS      = 5
000000r 2               
000000r 2               ; --- Input bitmask (SPEC 11.1) -----------------------------------------------
000000r 2               ;   Active HIGH. Each platform inverts and remaps its own hardware into this.
000000r 2               INPUT_UP            = %00000001 ; Rotate forward
000000r 2               INPUT_DOWN          = %00000010 ; Soft drop
000000r 2               INPUT_LEFT          = %00000100
000000r 2               INPUT_RIGHT         = %00001000
000000r 2               INPUT_FIRE          = %00010000 ; Rotate reverse / confirm
000000r 2               INPUT_PAUSE         = %00100000
000000r 2               
000000r 2               ; --- Game states (SPEC 13) ---------------------------------------------------
000000r 2               STATE_TITLE         = 0
000000r 2               STATE_PLAY          = 1
000000r 2               STATE_PAUSE         = 2
000000r 2               STATE_GAMEOVER      = 3
000000r 2               
000000r 2               ; --- Play sub-states (SPEC 8) ------------------------------------------------
000000r 2               PLAY_FALLING        = 0
000000r 2               PLAY_LOCKING        = 1
000000r 2               PLAY_GLOW           = 2
000000r 2               PLAY_SHATTER        = 3
000000r 2               PLAY_GRAVITY        = 4
000000r 2               PLAY_ARE            = 5
000000r 2               
000000r 2               ; --- Buffer sizes (SPEC 17.1) ------------------------------------------------
000000r 2               MARKS_BYTES         = 16        ; One byte per row, bits 0-5
000000r 2               EFFECTQ_ENTRIES     = 48        ; 2 bytes each; drop on overflow
000000r 2               EFFECTQ_BYTES       = EFFECTQ_ENTRIES * 2
000000r 2               DIRTY_ENTRIES       = 64        ; 3 bytes each: offset lo, offset hi, tile
000000r 2               DIRTY_BYTES         = DIRTY_ENTRIES * 3
000000r 2               DIRTY_FLUSH_MAX     = 24        ; Cells pushed to the screen per frame.
000000r 2                                               ;   MEASURED, not estimated (PLAN.md S1). A
000000r 2                                               ;   flush costs 165 cycles a cell on the
000000r 2                                               ;   AC6502 and about 132 on the Commodores, so
000000r 2                                               ;   24 cells is 3965 cycles — inside vertical
000000r 2                                               ;   blank on all three, and tightest on the
000000r 2                                               ;   AC6502 at 1 MHz, whose 70 blank lines are
000000r 2                                               ;   roughly 4450. It is also a quarter of the
000000r 2                                               ;   96-cell well, so a full redraw is exactly
000000r 2                                               ;   four frames.
000000r 2                                               ;   Overrunning vblank is not dangerous on any
000000r 2                                               ;   of the three — no VRAM write spacing is
000000r 2                                               ;   anywhere near violated (S1) — it only
000000r 2                                               ;   risks a cell landing a frame late. This is
000000r 2                                               ;   a budget, not a hardware limit.
000000r 2               
000000r 1               .include "../src/zeropage.inc"
000000r 2               ; =============================================================================
000000r 2               ;   zeropage.inc — Wizards Lab, zero page allocation
000000r 2               ; =============================================================================
000000r 2               ;   The ZEROPAGE segment is placed at $40 on every platform. That window is
000000r 2               ;   free on all three:
000000r 2               ;
000000r 2               ;     AC6502   $003A-$00FF free for user programs (6502.inc memory map)
000000r 2               ;     VIC-20   all of page zero, once the cartridge stops calling the KERNAL
000000r 2               ;     C64      all of page zero EXCEPT $00/$01, which are the processor port
000000r 2               ;
000000r 2               ;   Starting at $40 clears the C64's port bytes and the AC6502's system
000000r 2               ;   scratch with room to spare, and keeps one number in three linker configs.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               .segment "ZEROPAGE"
000000r 2               
000000r 2  xx xx        Ptr1:           .res 2      ; General pointer — free across any call boundary
000002r 2  xx xx        Ptr2:           .res 2      ; General pointer
000004r 2  xx xx        SrcPtr:         .res 2      ; Block copy source
000006r 2  xx xx        DstPtr:         .res 2      ; Block copy destination
000008r 2  xx xx        ScreenPtr:      .res 2      ; Current screen row base
00000Ar 2  xx xx        ColorPtr:       .res 2      ; Current colour RAM row base (Commodore only)
00000Cr 2               
00000Cr 2  xx           RngLo:          .res 1      ; 16-bit LFSR state — never both zero
00000Dr 2  xx           RngHi:          .res 1
00000Er 2               
00000Er 2  xx           Tmp0:           .res 1      ; Scratch. Never live across a JSR.
00000Fr 2  xx           Tmp1:           .res 1
000010r 2  xx           Tmp2:           .res 1
000011r 2  xx           Tmp3:           .res 1
000012r 2               
000012r 2  xx           ScanRow:        .res 1      ; Match scanner cursor
000013r 2  xx           ScanCol:        .res 1
000014r 2  xx           ScanColor:      .res 1      ; Colour key of the run in progress ($FF = unset)
000015r 2  xx           ScanLen:        .res 1
000016r 2               
000016r 2               ; --- Render and text scratch -------------------------------------------------
000016r 2               ;   These ARE live across a JSR, unlike Tmp0-Tmp3, because text.asm calls
000016r 2               ;   RenderMark once per cell and has to remember where it is. That is safe
000016r 2               ;   only because RenderMark touches nothing here: it clobbers A, X and the
000016r 2               ;   stack and nothing else (see render.asm). Do not call anything else from a
000016r 2               ;   loop that holds one of these.
000016r 2  xx           TextCol:        .res 1      ; Panel column the next glyph goes in
000017r 2  xx           TextRow:        .res 1      ; Panel row the string is drawn on
000018r 2  xx           TextIdx:        .res 1      ; Cursor within the string, or the BCD byte index
000019r 2  xx           TextByte:       .res 1      ; The BCD byte being split into two digits
00001Ar 2  xx           TextSkip:       .res 1      ; Non-zero while the first high nibble is skipped
00001Br 2  xx           FlushLeft:      .res 1      ; Cells left in this frame's flush budget
00001Cr 2  xx           RedrawCol:      .res 1      ; Panel column of the cell RenderBoardStep is on
00001Dr 2               
00001Dr 1               .include "../src/ram.inc"
00001Dr 2               ; =============================================================================
00001Dr 2               ;   ram.inc — Wizards Lab, work RAM
00001Dr 2               ; =============================================================================
00001Dr 2               ;   SPEC.md section 17.1. Around 530 bytes, which is what lets the whole game
00001Dr 2               ;   fit the VIC-20's 1 KB of usable work RAM — the tightest of the three
00001Dr 2               ;   targets, and therefore the one the layout is designed against.
00001Dr 2               ;
00001Dr 2               ;   Every platform places the BSS segment somewhere different (see each
00001Dr 2               ;   linker config); nothing in this file cares where.
00001Dr 2               ; =============================================================================
00001Dr 2               
00001Dr 2               .segment "BSS"
000000r 2               
000000r 2               ; --- The board (SPEC 3.2) ----------------------------------------------------
000000r 2               ;   20 rows x 8 stride. Columns 6-7 of every row and rows 16-19 entirely are
000000r 2               ;   permanent $FF sentinels, so scans walk off the edge and stop by themselves.
000000r 2               ;   Page-align it: address(row,col) = Board + (row << 3) + col.
000000r 2               .align 256
000000r 2  xx xx xx xx  Board:          .res BOARD_BYTES
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
0000A0r 2               
0000A0r 2               ; --- Match / cascade state (SPEC 6.2, 8) -------------------------------------
0000A0r 2  xx xx xx xx  Marks:          .res MARKS_BYTES        ; One byte per row, bits 0-5 = columns
0000A4r 2  xx xx xx xx  
0000A8r 2  xx xx xx xx  
0000B0r 2  xx xx xx xx  EffectQ:        .res EFFECTQ_BYTES      ; Ring of pending reagent detonations
0000B4r 2  xx xx xx xx  
0000B8r 2  xx xx xx xx  
000110r 2  xx           EffectQHead:    .res 1
000111r 2  xx           EffectQTail:    .res 1
000112r 2  xx           RunCount:       .res 1                  ; Runs resolved in the current step
000113r 2  xx           ChainStep:      .res 1                  ; 1 on the first step of a cascade
000114r 2  xx           StarCount:      .res 1                  ; Doublings pending, capped at 3
000115r 2  xx           CascadeLo:      .res 1                  ; Cascade point accumulator, packed BCD
000116r 2  xx           CascadeMid:     .res 1
000117r 2  xx           CascadeHi:      .res 1
000118r 2               
000118r 2               ; --- Render (SPEC 12.6) ------------------------------------------------------
000118r 2               ;   A ring of DIRTY_ENTRIES cells waiting to be pushed to the screen, three
000118r 2               ;   bytes each: SCREEN column, SCREEN row, tile. Not a 16-bit screen offset —
000118r 2               ;   HalPlotCell takes a column and a row (hal.inc), and every platform reaches
000118r 2               ;   a cell through a per-row pointer table (SPEC 12.3), so an offset would only
000118r 2               ;   have to be taken apart again at the far end.
000118r 2               ;
000118r 2               ;   A ring rather than a list with a resume index, because a frame that flushes
000118r 2               ;   its cap leaves a remainder and the next frame's marks have to go somewhere.
000118r 2               ;   Head and tail are BYTE offsets into Dirty, not entry numbers, so stepping
000118r 2               ;   one entry is an add of 3 and never a multiply.
000118r 2  xx xx xx xx  Dirty:          .res DIRTY_BYTES        ; screen col, screen row, tile
00011Cr 2  xx xx xx xx  
000120r 2  xx xx xx xx  
0001D8r 2  xx           DirtyCount:     .res 1                  ; Entries pending, 0..DIRTY_ENTRIES
0001D9r 2  xx           DirtyHead:      .res 1                  ; Byte offset of the oldest pending
0001DAr 2  xx           DirtyTail:      .res 1                  ; Byte offset the next mark goes to
0001DBr 2  xx           RedrawIdx:      .res 1                  ; Board index RenderBoardStep resumes
0001DCr 2                                                       ;   at, or $FF when no redraw is
0001DCr 2                                                       ;   outstanding
0001DCr 2               
0001DCr 2               ; --- The falling piece (SPEC 5) ----------------------------------------------
0001DCr 2  xx           PieceCol:       .res 1
0001DDr 2  xx           PieceRow:       .res 1                  ; Row of cell A (the top cell)
0001DEr 2  xx           PieceA:         .res 1                  ; Tile bytes, top to bottom
0001DFr 2  xx           PieceB:         .res 1
0001E0r 2  xx           PieceC:         .res 1
0001E1r 2  xx           NextA:          .res 1                  ; The preview piece
0001E2r 2  xx           NextB:          .res 1
0001E3r 2  xx           NextC:          .res 1
0001E4r 2               
0001E4r 2               ; --- Progress (SPEC 9, 10) ---------------------------------------------------
0001E4r 2  xx           ScoreLo:        .res 1                  ; 7 digits packed BCD, low byte first;
0001E5r 2  xx           ScoreMid:       .res 1                  ;   the top nibble of ScoreTop stays 0
0001E6r 2  xx           ScoreHi:        .res 1
0001E7r 2  xx           ScoreTop:       .res 1
0001E8r 2  xx           HighLo:         .res 1
0001E9r 2  xx           HighMid:        .res 1
0001EAr 2  xx           HighHi:         .res 1
0001EBr 2  xx           HighTop:        .res 1
0001ECr 2  xx           HighLevel:      .res 1                  ; Level the high score was set on, BCD
0001EDr 2  xx           Level:          .res 1                  ; Binary, 1-99
0001EEr 2  xx           TilesCleared:   .res 1                  ; Toward the next level, wraps at 30
0001EFr 2               
0001EFr 2               ; --- Timers, all in frames (SPEC 14) -----------------------------------------
0001EFr 2  xx           GravityTimer:   .res 1
0001F0r 2  xx           LockTimer:      .res 1
0001F1r 2  xx           LockResets:     .res 1
0001F2r 2  xx           DasTimer:       .res 1
0001F3r 2  xx           DasDir:         .res 1
0001F4r 2  xx           AreTimer:       .res 1
0001F5r 2  xx           AnimTimer:      .res 1
0001F6r 2  xx           BannerTimer:    .res 1
0001F7r 2  xx           FrameCounter:   .res 1                  ; Free-running from power-on; seeds RNG
0001F8r 2               
0001F8r 2               ; --- Input (SPEC 11.1) -------------------------------------------------------
0001F8r 2  xx           InputNow:       .res 1
0001F9r 2  xx           InputPrev:      .res 1
0001FAr 2  xx           InputEdge:      .res 1                  ; Newly pressed this frame
0001FBr 2               
0001FBr 2               ; --- State machine (SPEC 13) -------------------------------------------------
0001FBr 2  xx           GameState:      .res 1                  ; STATE_*
0001FCr 2  xx           PlayState:      .res 1                  ; PLAY_*
0001FDr 2  xx           TitlePage:      .res 1
0001FEr 2  xx           Region:         .res 1                  ; 0 = NTSC, 1 = PAL
0001FFr 2  xx           NeedsRedraw:    .res 1
000200r 2               
000200r 2               ; --- Audio (SPEC 16) ---------------------------------------------------------
000200r 2  xx           SfxRequest:     .res 1                  ; Written by logic, consumed by AudioTick
000201r 2  xx           SfxTimer:       .res 1
000202r 2  xx xx xx xx  SfxState:       .res 14
000206r 2  xx xx xx xx  
00020Ar 2  xx xx xx xx  
000210r 2               
000210r 1               .include "../src/hal.inc"
000210r 2               ; =============================================================================
000210r 2               ;   hal.inc — Wizards Lab, the platform contract
000210r 2               ; =============================================================================
000210r 2               ;   Everything in src/ is shared, unmodified, by all three machines. The only
000210r 2               ;   things that differ are collected here: each platform's WizardsLab.asm must
000210r 2               ;   define these constants and implement these seven routines, and nothing
000210r 2               ;   else in src/ may touch hardware directly.
000210r 2               ;
000210r 2               ;   This file declares nothing. It is the documentation for the boundary, kept
000210r 2               ;   next to the code it constrains so it cannot drift out of date unnoticed.
000210r 2               ;
000210r 2               ;   CONSTANTS the platform must define BEFORE including the shared sources
000210r 2               ;   ---------------------------------------------------------------------
000210r 2               ;     PANEL_X, PANEL_Y      Where the 22 x 24 panel sits on this screen.
000210r 2               ;                             AC6502  5, 0      VIC-20  0, 0      C64  9, 0
000210r 2               ;                           PANEL_Y is 0 everywhere; the VIC-20 clips panel
000210r 2               ;                           row 23 and the C64 has one spare row below it.
000210r 2               ;     SCR_COLS           32 / 22 / 40
000210r 2               ;     SCR_ROWS           24 / 23 / 25
000210r 2               ;     HAS_COLOR_RAM         1 on the Commodores, 0 on the AC6502, whose colour
000210r 2               ;                           lives in the VDP colour table instead.
000210r 2               ;
000210r 2               ;   ROUTINES the platform must implement
000210r 2               ;   ------------------------------------
000210r 2               ;     HalInitVideo      Bring up the video hardware: black background and
000210r 2               ;                       border, the correct text/tile mode, tileset in place,
000210r 2               ;                       colours configured, screen cleared. Called once.
000210r 2               ;                       In:  nothing        Out: nothing
000210r 2               ;
000210r 2               ;     HalWaitFrame      Block until the start of the next vertical blank.
000210r 2               ;                       Everything below is called only between frames.
000210r 2               ;                       In:  nothing        Out: nothing
000210r 2               ;
000210r 2               ;     HalPlotCell       Write one cell, colour included where the platform has
000210r 2               ;                       per-cell colour.
000210r 2               ;                       In:  A = tile, X = screen column, Y = screen row
000210r 2               ;                       Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
000210r 2               ;
000210r 2               ;     HalBlitScreen     Draw a whole static screen from a name-table image in
000210r 2               ;                       ROM: SCR_COLS * SCR_ROWS bytes, row-major, plus
000210r 2               ;                       the matching colour image where the platform needs one.
000210r 2               ;                       In:  SrcPtr -> name table, Ptr1 -> colour table
000210r 2               ;                       Out: nothing
000210r 2               ;
000210r 2               ;     HalReadInput      Read stick and keyboard, fold both into one mask.
000210r 2               ;                       In:  nothing
000210r 2               ;                       Out: A = INPUT_* bits, ACTIVE HIGH
000210r 2               ;
000210r 2               ;     HalDetectRegion   Decide NTSC or PAL so the timing tables can be picked.
000210r 2               ;                       In:  nothing        Out: A = 0 NTSC, 1 PAL
000210r 2               ;
000210r 2               ;     HalSfx            Start a sound effect. May be a bare RTS until audio
000210r 2               ;                       exists.
000210r 2               ;                       In:  A = effect id (SPEC 16)
000210r 2               ;                       Out: nothing
000210r 2               ;
000210r 2               ;   The shared code assumes nothing about interrupts. Each platform may drive
000210r 2               ;   HalWaitFrame from a raster IRQ, a timer, or a status-register poll.
000210r 2               ; =============================================================================
000210r 2               
000210r 1               
000210r 1               ; =============================================================================
000210r 1               ;   Cartridge entry
000210r 1               ; =============================================================================
000210r 1               
000210r 1               .segment "CODE"
000000r 1               
000000r 1               CartReset:
000000r 1  78             sei
000001r 1  D8             cld
000002r 1  A2 FF          ldx #$FF
000004r 1  9A             txs                           ; Nothing did this for us
000005r 1  20 78 A0       jsr KernalInit                ; Probe and initialise every card, IRQs left off
000008r 1               
000008r 1  20 rr rr       jsr GameInit                  ; Never returns
00000Br 1               
00000Br 1               ; --- Shared game code --------------------------------------------------------
00000Br 1               .include "../src/main.asm"
00000Br 2               ; =============================================================================
00000Br 2               ;   main.asm — Wizards Lab, shared entry point and main loop
00000Br 2               ; =============================================================================
00000Br 2               ;   Included by every platform's WizardsLab.asm after that file has defined
00000Br 2               ;   PANEL_X / PANEL_Y and its half of the HAL (see hal.inc). Nothing below
00000Br 2               ;   touches hardware.
00000Br 2               ;
00000Br 2               ;   BOOTSTRAP STATUS
00000Br 2               ;   ----------------
00000Br 2               ;   What runs today is SPEC.md Appendix D step 1-2: the machine boots, the
00000Br 2               ;   tileset loads, and the static screens blit at the right offset with fire
00000Br 2               ;   moving between them. That is deliberately the whole of it — it exercises
00000Br 2               ;   every platform-specific thing (cartridge header, video mode, tile format,
00000Br 2               ;   colour model, frame sync, input) with none of the game, so when the game
00000Br 2               ;   goes in, anything that breaks is the game.
00000Br 2               ;
00000Br 2               ;   Everything the state machine calls below is a stub in its own module.
00000Br 2               ; =============================================================================
00000Br 2               
00000Br 2               ; -----------------------------------------------------------------------------
00000Br 2               ;   GameInit — one-time setup, called from the cartridge entry point
00000Br 2               ; -----------------------------------------------------------------------------
00000Br 2               GameInit:
00000Br 2  20 rr rr       jsr HalDetectRegion
00000Er 2  8D rr rr       sta Region
000011r 2               
000011r 2  20 rr rr       jsr HalInitVideo              ; Tiles in place, screen black and cleared
000014r 2  20 rr rr       jsr AudioInit
000017r 2  20 rr rr       jsr RenderDirtyReset
00001Ar 2               
00001Ar 2  A9 00          lda #0
00001Cr 2  8D rr rr       sta FrameCounter
00001Fr 2  8D rr rr       sta InputNow
000022r 2  8D rr rr       sta InputPrev
000025r 2  8D rr rr       sta InputEdge
000028r 2  8D rr rr       sta TitlePage
00002Br 2               
00002Br 2  20 rr rr       jsr ScoreHighInit             ; Once a session, before the first ScoreReset
00002Er 2  20 rr rr       jsr ScoreReset
000031r 2  20 rr rr       jsr BoardClear
000034r 2               
000034r 2               .ifdef WL_DEBUG
000034r 2                 jsr GameStart                 ; TEMPORARY (PLAN.md P1): skip the title and
000034r 2                                               ;   go straight to a well full of known tiles,
000034r 2                                               ;   so the render path has something to draw
000034r 2                                               ;   on a machine with no input attached.
000034r 2               .else
000034r 2  A9 00          lda #STATE_TITLE
000036r 2  8D rr rr       sta GameState
000039r 2  A9 01          lda #1
00003Br 2  8D rr rr       sta NeedsRedraw
00003Er 2               .endif
00003Er 2                 ; falls through into GameLoop
00003Er 2               
00003Er 2               ; -----------------------------------------------------------------------------
00003Er 2               ;   GameLoop — never returns
00003Er 2               ; -----------------------------------------------------------------------------
00003Er 2               GameLoop:
00003Er 2  20 rr rr       jsr HalWaitFrame
000041r 2  EE rr rr       inc FrameCounter              ; Free-running from power-on; seeds the RNG
000044r 2               
000044r 2  20 rr rr       jsr RenderFlush               ; Screen writes happen in vertical blank only
000047r 2  20 rr rr       jsr InputPoll
00004Ar 2               
00004Ar 2  AD rr rr       lda GameState                 ; Dispatch on the current screen state
00004Dr 2  C9 00          cmp #STATE_TITLE
00004Fr 2  F0 0B          beq @Title
000051r 2  C9 01          cmp #STATE_PLAY
000053r 2  F0 0D          beq @Play
000055r 2  C9 02          cmp #STATE_PAUSE
000057r 2  F0 0F          beq @Pause
000059r 2  4C rr rr       jmp StateGameOver
00005Cr 2               
00005Cr 2               @Title:
00005Cr 2  20 rr rr       jsr StateTitle
00005Fr 2  4C rr rr       jmp @Audio
000062r 2               @Play:
000062r 2  20 rr rr       jsr StatePlay
000065r 2  4C rr rr       jmp @Audio
000068r 2               @Pause:
000068r 2  20 rr rr       jsr StatePause
00006Br 2               
00006Br 2               @Audio:
00006Br 2  20 rr rr       jsr AudioTick
00006Er 2  4C rr rr       jmp GameLoop
000071r 2               
000071r 2               ; =============================================================================
000071r 2               ;   States (SPEC 13)
000071r 2               ; =============================================================================
000071r 2               
000071r 2               ; -----------------------------------------------------------------------------
000071r 2               ;   StateTitle — blinking prompt over the drawn screen, and the magic field
000071r 2               ;   SPEC 13.1. There are no help pages: the controls are part of the screen
000071r 2               ;   image, so the only things moving here are the prompt and the field.
000071r 2               ; -----------------------------------------------------------------------------
000071r 2               StateTitle:
000071r 2  AD rr rr       lda NeedsRedraw
000074r 2  F0 0B          beq @Live
000076r 2  A9 00          lda #0
000078r 2  8D rr rr       sta NeedsRedraw
00007Br 2  20 rr rr       jsr DrawTitleScreen
00007Er 2  20 rr rr       jsr RenderDirtyReset          ; A full blit went behind the renderer's back
000081r 2               
000081r 2               @Live:
000081r 2                 ; TODO: blink the prompt every 30 frames, and shimmer the magic field —
000081r 2                 ; one NextRandom for a cell in the 14 x 2 block, one for a tile in
000081r 2                 ; ART_BASE..ART_BASE+ART_TILES-1, one RenderMark.
000081r 2  AD rr rr       lda InputEdge
000084r 2  29 10          and #INPUT_FIRE
000086r 2  F0 06          beq @Done
000088r 2               
000088r 2  20 rr rr       jsr RngSeed                   ; SPEC 15 — seed from reaction time, not a constant
00008Br 2  20 rr rr       jsr GameStart
00008Er 2               @Done:
00008Er 2  60             rts
00008Fr 2               
00008Fr 2               ; -----------------------------------------------------------------------------
00008Fr 2               ;   GameStart — enter play from the title screen
00008Fr 2               ; -----------------------------------------------------------------------------
00008Fr 2               GameStart:
00008Fr 2  20 rr rr       jsr ScoreReset
000092r 2  20 rr rr       jsr BoardClear
000095r 2               .ifdef WL_DEBUG
000095r 2                 jsr BoardDebugFill            ; TEMPORARY (PLAN.md P1)
000095r 2               .endif
000095r 2               
000095r 2  A9 01          lda #1
000097r 2  8D rr rr       sta Level
00009Ar 2  A9 00          lda #0
00009Cr 2  8D rr rr       sta TilesCleared
00009Fr 2               
00009Fr 2  20 rr rr       jsr DrawPlayScreen            ; The whole screen at once, behind the
0000A2r 2  20 rr rr       jsr RenderDirtyReset          ;   renderer's back — so drop anything queued
0000A5r 2                                               ;   against the screen that just went away
0000A5r 2               
0000A5r 2  20 rr rr       jsr TextBannerClear           ; The play image ships with the band reading
0000A8r 2                                               ;   `~~ PAUSED ~~` (SPEC 12.1); play owns it
0000A8r 2  20 rr rr       jsr RenderScore               ; The panel fields are code's, not the image's
0000ABr 2  20 rr rr       jsr RenderHigh
0000AEr 2  20 rr rr       jsr RenderLevel
0000B1r 2               .ifdef WL_DEBUG
0000B1r 2                 lda #<MsgLevelUp              ; TEMPORARY (PLAN.md P1): something in the band
0000B1r 2                 sta Ptr1
0000B1r 2                 lda #>MsgLevelUp
0000B1r 2                 sta Ptr1+1
0000B1r 2                 jsr TextBanner
0000B1r 2               .endif
0000B1r 2  20 rr rr       jsr RenderBoard               ; Queued across as many frames as it takes
0000B4r 2               
0000B4r 2  20 rr rr       jsr PieceGenerateNext         ; Fill the preview...
0000B7r 2  20 rr rr       jsr PieceSpawn                ; ...then promote it and refill
0000BAr 2  20 rr rr       jsr PieceGenerateNext
0000BDr 2               
0000BDr 2  A9 00          lda #PLAY_FALLING
0000BFr 2  8D rr rr       sta PlayState
0000C2r 2  A9 01          lda #STATE_PLAY
0000C4r 2  8D rr rr       sta GameState
0000C7r 2  60             rts
0000C8r 2               
0000C8r 2               ; -----------------------------------------------------------------------------
0000C8r 2               ;   StatePlay — the game
0000C8r 2               ;   SPEC 13.2. One frame is: advance whatever the play sub-state is doing,
0000C8r 2               ;   then queue whatever changed. Cascades run as sub-states rather than in a
0000C8r 2               ;   blocking loop so animation stays on the frame clock.
0000C8r 2               ; -----------------------------------------------------------------------------
0000C8r 2               StatePlay:
0000C8r 2  AD rr rr       lda InputEdge
0000CBr 2  29 20          and #INPUT_PAUSE
0000CDr 2  D0 01          bne @ToPause
0000CFr 2               
0000CFr 2                 ; TODO: dispatch on PlayState —
0000CFr 2                 ;   PLAY_FALLING   input, DAS, gravity, land detection
0000CFr 2                 ;   PLAY_LOCKING   lock delay with up to LOCK_RESET_MAX moves
0000CFr 2                 ;   PLAY_GLOW      matched cells showing glyph +6, prisms excepted
0000CFr 2                 ;   PLAY_SHATTER   the white removal ring; prisms blip out instead
0000CFr 2                 ;   PLAY_GRAVITY   one row every FALL_FRAMES until settled
0000CFr 2                 ;   PLAY_ARE       entry delay, then spawn or game over
0000CFr 2  60             rts
0000D0r 2               
0000D0r 2               @ToPause:
0000D0r 2  A9 02          lda #STATE_PAUSE
0000D2r 2  8D rr rr       sta GameState
0000D5r 2                 ; TODO: wash the well with TILE_WASH so a pause cannot be used to study the
0000D5r 2                 ; board (13.3). A wash, not a blank — a blanked well reads as crashed.
0000D5r 2  60             rts
0000D6r 2               
0000D6r 2               ; -----------------------------------------------------------------------------
0000D6r 2               ;   StatePause
0000D6r 2               ; -----------------------------------------------------------------------------
0000D6r 2               StatePause:
0000D6r 2  AD rr rr       lda InputEdge
0000D9r 2  29 30          and #(INPUT_PAUSE | INPUT_FIRE)
0000DBr 2  F0 08          beq @Done
0000DDr 2  A9 01          lda #STATE_PLAY
0000DFr 2  8D rr rr       sta GameState
0000E2r 2  20 rr rr       jsr RenderBoard               ; Put the board back
0000E5r 2               @Done:
0000E5r 2  60             rts
0000E6r 2               
0000E6r 2               ; -----------------------------------------------------------------------------
0000E6r 2               ;   StateGameOver — petrify, banner, back to the title
0000E6r 2               ;   SPEC 13.4
0000E6r 2               ; -----------------------------------------------------------------------------
0000E6r 2               StateGameOver:
0000E6r 2                 ; TODO: petrify the well from the bottom up, 2 frames a row, then the banner
0000E6r 2                 ; and a 10 second timeout. Each cell keeps its own shape —
0000E6r 2                 ;   PETRIFY_BASE + (tile & GLYPH_MASK)
0000E6r 2                 ; — and empty cells stay empty (13.4).
0000E6r 2  AD rr rr       lda InputEdge
0000E9r 2  29 10          and #INPUT_FIRE
0000EBr 2  F0 0A          beq @Done
0000EDr 2  A9 00          lda #STATE_TITLE
0000EFr 2  8D rr rr       sta GameState
0000F2r 2  A9 01          lda #1
0000F4r 2  8D rr rr       sta NeedsRedraw
0000F7r 2               @Done:
0000F7r 2  60             rts
0000F8r 2               
0000F8r 2               ; =============================================================================
0000F8r 2               ;   Static screen drawing
0000F8r 2               ; =============================================================================
0000F8r 2               ;   The whole static layout — panel frame, labels, and the margin artwork that
0000F8r 2               ;   fills the screen either side of it — comes out of the editors as one
0000F8r 2               ;   name-table image per platform. Code only ever draws over the top of it:
0000F8r 2               ;   the well, the score and level digits, the preview, and the message band.
0000F8r 2               ;
0000F8r 2               ;   All six images are real. They come out of artwork/WizardsLab.tms9918 —
0000F8r 2               ;   the master — by way of `make artwork`. See data/README.md.
0000F8r 2               ; =============================================================================
0000F8r 2               
0000F8r 2               DrawTitleScreen:
0000F8r 2  A9 rr          lda #<TitleScreen
0000FAr 2  85 rr          sta SrcPtr
0000FCr 2  A9 rr          lda #>TitleScreen
0000FEr 2  85 rr          sta SrcPtr+1
000100r 2  A9 rr          lda #<TitleColor
000102r 2  85 rr          sta Ptr1
000104r 2  A9 rr          lda #>TitleColor
000106r 2  85 rr          sta Ptr1+1
000108r 2  4C rr rr       jmp HalBlitScreen
00010Br 2               
00010Br 2               DrawPlayScreen:
00010Br 2  A9 rr          lda #<PlayScreen
00010Dr 2  85 rr          sta SrcPtr
00010Fr 2  A9 rr          lda #>PlayScreen
000111r 2  85 rr          sta SrcPtr+1
000113r 2  A9 rr          lda #<PlayColor
000115r 2  85 rr          sta Ptr1
000117r 2  A9 rr          lda #>PlayColor
000119r 2  85 rr          sta Ptr1+1
00011Br 2  4C rr rr       jmp HalBlitScreen
00011Er 2               
00011Er 1               .include "../src/rng.asm"
00011Er 2               ; =============================================================================
00011Er 2               ;   rng.asm — Wizards Lab, random numbers
00011Er 2               ; =============================================================================
00011Er 2               ;   A 16-bit Galois LFSR with the conventional $B400 taps, which is maximal
00011Er 2               ;   length: it visits all 65535 non-zero states before repeating. Eight shifts
00011Er 2               ;   per call, one whole byte out.
00011Er 2               ;
00011Er 2               ;   Seeding matters more than the generator does. A fixed seed would deal the
00011Er 2               ;   same first three pieces every session and the game would feel dead, so the
00011Er 2               ;   seed is taken from the free-running frame counter at the moment the player
00011Er 2               ;   presses fire on the title screen — human reaction time is the entropy.
00011Er 2               ;
00011Er 2               ;   SPEC.md section 15.
00011Er 2               ; =============================================================================
00011Er 2               
00011Er 2               ; -----------------------------------------------------------------------------
00011Er 2               ;   RngSeed — seed from the frame counter
00011Er 2               ;   In:  nothing (reads FrameCounter)
00011Er 2               ;   Out: nothing.  Modifies: A
00011Er 2               ; -----------------------------------------------------------------------------
00011Er 2               RngSeed:
00011Er 2  AD rr rr       lda FrameCounter
000121r 2  09 01          ora #$01                      ; Never let the state reach zero — it sticks
000123r 2  85 rr          sta RngLo
000125r 2  49 5A          eor #$5A                      ; Spread one byte of entropy over both halves
000127r 2  85 rr          sta RngHi
000129r 2  60             rts
00012Ar 2               
00012Ar 2               ; -----------------------------------------------------------------------------
00012Ar 2               ;   RngNext — next pseudo-random byte
00012Ar 2               ;   In:  nothing
00012Ar 2               ;   Out: A = random 0-255.  Modifies: A, X, flags
00012Ar 2               ; -----------------------------------------------------------------------------
00012Ar 2               RngNext:
00012Ar 2  A2 08          ldx #8                        ; Eight shifts give one whole output byte
00012Cr 2               @Bit:
00012Cr 2  46 rr          lsr RngHi                     ; Shift the 16-bit state right one place,
00012Er 2  66 rr          ror RngLo                     ;   the bit falling out of bit 0 lands in C
000130r 2  90 06          bcc @NoTap
000132r 2  A5 rr          lda RngHi
000134r 2  49 B4          eor #$B4                      ; Galois feedback mask $B400
000136r 2  85 rr          sta RngHi
000138r 2               @NoTap:
000138r 2  CA             dex
000139r 2  D0 F1          bne @Bit
00013Br 2  A5 rr          lda RngLo
00013Dr 2  60             rts
00013Er 2               
00013Er 1               .include "../src/input.asm"
00013Er 2               ; =============================================================================
00013Er 2               ;   input.asm — Wizards Lab, input conditioning
00013Er 2               ; =============================================================================
00013Er 2               ;   SPEC.md section 11. HalReadInput hands back one active-high mask however
00013Er 2               ;   the platform likes; everything above this line works on that mask and
00013Er 2               ;   never touches hardware.
00013Er 2               ;
00013Er 2               ;   Auto-repeat applies to LEFT and RIGHT only. Rotate does NOT repeat — up
00013Er 2               ;   must be released and pressed again. That is not a preference: a repeating
00013Er 2               ;   rotate makes a three-cell Columns piece impossible to aim.
00013Er 2               ; =============================================================================
00013Er 2               
00013Er 2               ; -----------------------------------------------------------------------------
00013Er 2               ;   InputPoll — read the hardware and work out what is newly pressed
00013Er 2               ;   In:  nothing
00013Er 2               ;   Out: InputNow, InputPrev, InputEdge updated.  Modifies: A
00013Er 2               ; -----------------------------------------------------------------------------
00013Er 2               InputPoll:
00013Er 2  AD rr rr       lda InputNow
000141r 2  8D rr rr       sta InputPrev
000144r 2  20 rr rr       jsr HalReadInput
000147r 2  8D rr rr       sta InputNow
00014Ar 2  4D rr rr       eor InputPrev                 ; Bits that changed
00014Dr 2  2D rr rr       and InputNow                  ; ...and are now down = newly pressed
000150r 2  8D rr rr       sta InputEdge
000153r 2  60             rts
000154r 2               
000154r 2               ; -----------------------------------------------------------------------------
000154r 2               ;   InputShift — LEFT/RIGHT with delayed auto shift
000154r 2               ;   Out: A = INPUT_LEFT, INPUT_RIGHT, or 0 if no move should happen this frame.
000154r 2               ;   SPEC 11.3 — initial delay 12 frames NTSC / 10 PAL, then 4 / 3.
000154r 2               ; -----------------------------------------------------------------------------
000154r 2               InputShift:
000154r 2                 ; TODO: on a fresh press, fire immediately and load DasTimer with the
000154r 2                 ; initial delay; while held, fire again each time DasTimer runs out and
000154r 2                 ; reload it with the repeat rate; on release, clear DasDir.
000154r 2  A9 00          lda #0
000156r 2  60             rts
000157r 2               
000157r 1               .include "../src/board.asm"
000157r 2               ; =============================================================================
000157r 2               ;   board.asm — Wizards Lab, the playfield
000157r 2               ; =============================================================================
000157r 2               ;   SPEC.md section 3. The board is 20 rows of 8 bytes, page-aligned, with
000157r 2               ;   columns 6-7 and rows 16-19 held permanently at $FF. Those sentinels are
000157r 2               ;   what let every scan in match.asm run without a bounds check.
000157r 2               ;
000157r 2               ;   address(row, col) = Board + (row << 3) + col
000157r 2               ; =============================================================================
000157r 2               
000157r 2               ; -----------------------------------------------------------------------------
000157r 2               ;   BoardClear — empty the playfield and lay the sentinels back down
000157r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X
000157r 2               ;
000157r 2               ;   Walls first over the whole 160 bytes, then the six playfield columns of
000157r 2               ;   the sixteen playfield rows punched back out to empty. Doing it in that
000157r 2               ;   order means the sentinels can never be forgotten: everything that is not
000157r 2               ;   explicitly playfield is a wall.
000157r 2               ; -----------------------------------------------------------------------------
000157r 2               BoardClear:
000157r 2  A9 FF          lda #TILE_WALL
000159r 2  A2 9F          ldx #BOARD_BYTES - 1
00015Br 2               @Wall:
00015Br 2  9D rr rr       sta Board,x
00015Er 2  CA             dex
00015Fr 2  10 FA          bpl @Wall
000161r 2               
000161r 2  A2 00          ldx #0                        ; X walks the row bases, 0, 8, 16, ...
000163r 2               @Row:
000163r 2  A9 00          lda #TILE_EMPTY               ; Reloaded every row: the TXA below eats it
000165r 2  9D rr rr 9D    .repeat BOARD_W, COL
000169r 2  rr rr 9D rr  
00016Dr 2  rr 9D rr rr  
000177r 2                   sta Board + COL, x
000177r 2                 .endrepeat
000177r 2  8A             txa
000178r 2  18             clc
000179r 2  69 08          adc #BOARD_STRIDE
00017Br 2  AA             tax
00017Cr 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
00017Er 2  90 E3          bcc @Row
000180r 2  60             rts
000181r 2               
000181r 2               ; -----------------------------------------------------------------------------
000181r 2               ;   BoardRowPtr — point Ptr1 at the start of a board row
000181r 2               ;   In:  A = row        Out: Ptr1 = &Board[row][0].  Modifies: A, Ptr1
000181r 2               ;
000181r 2               ;   Board is page-aligned and 160 bytes, so row * 8 is at most 152 and the low
000181r 2               ;   byte can never carry into the high one.
000181r 2               ; -----------------------------------------------------------------------------
000181r 2               BoardRowPtr:
000181r 2  0A             asl a
000182r 2  0A             asl a
000183r 2  0A             asl a
000184r 2  18             clc
000185r 2  69 rr          adc #<Board
000187r 2  85 rr          sta Ptr1
000189r 2  A9 rr          lda #>Board
00018Br 2  85 rr          sta Ptr1+1
00018Dr 2  60             rts
00018Er 2               
00018Er 2               ; -----------------------------------------------------------------------------
00018Er 2               ;   BoardGravity — compact every column downward
00018Er 2               ;   In:  nothing
00018Er 2               ;   Out: C set if anything moved.  Modifies: A, X, Y, Ptr1, Tmp0-Tmp2
00018Er 2               ;   SPEC 8 step 8.  P3.
00018Er 2               ; -----------------------------------------------------------------------------
00018Er 2               BoardGravity:
00018Er 2                 ; TODO: per column, walk bottom to top with a write cursor; mark moved cells
00018Er 2                 ; dirty as they go.
00018Er 2  18             clc
00018Fr 2  60             rts
000190r 2               
000190r 2               .ifdef WL_DEBUG
000190r 2               ; -----------------------------------------------------------------------------
000190r 2               ;   BoardDebugFill — a known pattern, for looking at the render path
000190r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000190r 2               ;
000190r 2               ;   TEMPORARY (PLAN.md P1). Nothing in the game calls this; it exists so a
000190r 2               ;   -DWL_DEBUG build has something in the well to draw, and it is deliberately
000190r 2               ;   asymmetric so a transposed row and column, an off-by-one origin or a wrong
000190r 2               ;   stride all show up as a picture rather than as a plausible board:
000190r 2               ;
000190r 2               ;     rows 0-3    empty — the well is not full, and the top edge is visible
000190r 2               ;     rows 4-14   a diagonal colour ramp, (row + col) mod 6
000190r 2               ;     row 14      column 0 left empty — breaks the diagonal's symmetry
000190r 2               ;     row 15      one of every glyph the tileset draws, left to right:
000190r 2               ;                 potion, fireball, bolt, bomb, star, then a prism
000190r 2               ; -----------------------------------------------------------------------------
000190r 2               BoardDebugFill:
000190r 2                 ldy #4                        ; Y = row
000190r 2               @Row:
000190r 2                 ldx #0                        ; X = column
000190r 2               @Col:
000190r 2                 tya
000190r 2                 stx Tmp0
000190r 2                 clc
000190r 2                 adc Tmp0                      ; row + col
000190r 2               @Mod6:
000190r 2                 cmp #NUM_COLORS
000190r 2                 bcc @Got
000190r 2                 sbc #NUM_COLORS
000190r 2                 bcs @Mod6                     ; Always — sbc left carry set
000190r 2               @Got:
000190r 2                 asl a                         ; colour << 3 + COLOR_BASE
000190r 2                 asl a
000190r 2                 asl a
000190r 2                 clc
000190r 2                 adc #COLOR_BASE
000190r 2                 sta Tmp1
000190r 2               
000190r 2                 cpy #BOARD_H - 1              ; Bottom row carries the glyph sampler
000190r 2                 bne @Plain
000190r 2                 txa
000190r 2                 cmp #NUM_COLORS - 1           ; Column 5 is the prism
000190r 2                 bcc @Glyph
000190r 2                 lda #WILD_BASE
000190r 2                 sta Tmp1
000190r 2                 bne @Store                    ; Always — WILD_BASE is non-zero
000190r 2               @Glyph:
000190r 2                 ora Tmp1                      ; Glyphs 0-4 of that cell's own colour
000190r 2                 sta Tmp1
000190r 2                 bne @Store                    ; Always
000190r 2               @Plain:
000190r 2                 cpy #BOARD_H - 2              ; One hole, so the diagonal is not symmetric
000190r 2                 bne @Store
000190r 2                 cpx #0
000190r 2                 bne @Store
000190r 2                 lda #TILE_EMPTY
000190r 2                 sta Tmp1
000190r 2               
000190r 2               @Store:
000190r 2                 tya                           ; Board index = row * 8 + column
000190r 2                 asl a
000190r 2                 asl a
000190r 2                 asl a
000190r 2                 stx Tmp0
000190r 2                 clc
000190r 2                 adc Tmp0
000190r 2                 tax
000190r 2                 lda Tmp1
000190r 2                 sta Board,x
000190r 2                 ldx Tmp0
000190r 2               
000190r 2                 inx
000190r 2                 cpx #BOARD_W
000190r 2                 bcc @Col
000190r 2                 iny
000190r 2                 cpy #BOARD_H
000190r 2                 bcc @Row
000190r 2                 rts
000190r 2               .endif
000190r 2               
000190r 1               .include "../src/piece.asm"
000190r 2               ; =============================================================================
000190r 2               ;   piece.asm — Wizards Lab, the falling piece
000190r 2               ; =============================================================================
000190r 2               ;   SPEC.md section 5. A piece is three independently generated cells stacked
000190r 2               ;   vertically, A on top. At most one of the three carries a reagent, which is
000190r 2               ;   enforced by rolling once for the piece rather than once per cell.
000190r 2               ; =============================================================================
000190r 2               
000190r 2               ; -----------------------------------------------------------------------------
000190r 2               ;   PieceGenerateNext — roll the preview piece into NextA/NextB/NextC
000190r 2               ;   In:  nothing (reads Level)
000190r 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0-Tmp2
000190r 2               ;   SPEC 5.2, 5.3 — colours uniform over 0-5, then one reagent roll.
000190r 2               ; -----------------------------------------------------------------------------
000190r 2               PieceGenerateNext:
000190r 2                 ; TODO: three RngNext calls for colours; one against PSpecial[LevelBand];
000190r 2                 ; on a hit pick a cell and a type from ReagentThresholds. A Prism overwrites
000190r 2                 ; the cell's colour with COLOR_WILD.
000190r 2  60             rts
000191r 2               
000191r 2               ; -----------------------------------------------------------------------------
000191r 2               ;   PieceSpawn — promote the preview to the falling piece
000191r 2               ;   In:  nothing
000191r 2               ;   Out: C set if the spawn cells were occupied (game over)
000191r 2               ;   SPEC 5.4 — spawn column SPAWN_COL, rows 0-2, visible immediately.
000191r 2               ; -----------------------------------------------------------------------------
000191r 2               PieceSpawn:
000191r 2                 ; TODO
000191r 2  18             clc
000192r 2  60             rts
000193r 2               
000193r 2               ; -----------------------------------------------------------------------------
000193r 2               ;   PieceMoveLeft / PieceMoveRight
000193r 2               ;   Out: C set if the move happened (the caller resets the lock timer).
000193r 2               ;   SPEC 5.5 — no wall kicks; a 1-wide piece has nothing to kick off.
000193r 2               ; -----------------------------------------------------------------------------
000193r 2               PieceMoveLeft:
000193r 2  18             clc
000194r 2  60             rts
000195r 2               
000195r 2               PieceMoveRight:
000195r 2  18             clc
000196r 2  60             rts
000197r 2               
000197r 2               ; -----------------------------------------------------------------------------
000197r 2               ;   PieceRotate / PieceRotateBack — cycle the three cells
000197r 2               ;   SPEC 5.5 — (A,B,C) -> (B,C,A) forward, (C,A,B) back. Always succeeds.
000197r 2               ; -----------------------------------------------------------------------------
000197r 2               PieceRotate:
000197r 2  60             rts
000198r 2               
000198r 2               PieceRotateBack:
000198r 2  60             rts
000199r 2               
000199r 2               ; -----------------------------------------------------------------------------
000199r 2               ;   PieceStep — one row of gravity
000199r 2               ;   Out: C set if the piece has landed and the lock delay should start.
000199r 2               ; -----------------------------------------------------------------------------
000199r 2               PieceStep:
000199r 2  18             clc
00019Ar 2  60             rts
00019Br 2               
00019Br 2               ; -----------------------------------------------------------------------------
00019Br 2               ;   PieceLock — write the three cells into the board
00019Br 2               ;   SPEC 5.6 — after this the caller runs a cascade.
00019Br 2               ; -----------------------------------------------------------------------------
00019Br 2               PieceLock:
00019Br 2  60             rts
00019Cr 2               
00019Cr 1               .include "../src/match.asm"
00019Cr 2               ; =============================================================================
00019Cr 2               ;   match.asm — Wizards Lab, the match scanner
00019Cr 2               ; =============================================================================
00019Cr 2               ;   SPEC.md section 6. Four passes — horizontal, vertical, and both diagonals —
00019Cr 2               ;   each walking its axis and tracking a run colour and length. A run of three
00019Cr 2               ;   or more sets the MARK bit for each of its cells.
00019Cr 2               ;
00019Cr 2               ;   Colour comparison is the whole trick:
00019Cr 2               ;
00019Cr 2               ;       lda cell
00019Cr 2               ;       and #COLOR_MASK         ; the low three bits are the glyph, ignore them
00019Cr 2               ;       cmp ScanColor
00019Cr 2               ;
00019Cr 2               ;   which is why a red potion, a red fireball and a red star all match. The
00019Cr 2               ;   glyph decides what happens on removal, never whether cells match.
00019Cr 2               ;
00019Cr 2               ;   Wildcards (SPEC 6.3): a WILD cell continues any run. If the run has no
00019Cr 2               ;   colour yet it stays unset and is adopted from the first non-wild cell, so
00019Cr 2               ;   one prism can close a red horizontal run and a blue vertical run at once.
00019Cr 2               ; =============================================================================
00019Cr 2               
00019Cr 2               ; -----------------------------------------------------------------------------
00019Cr 2               ;   MatchScan — find every run on the board
00019Cr 2               ;   In:  nothing
00019Cr 2               ;   Out: Marks filled, RunCount set, Z set if nothing matched.
00019Cr 2               ;        Modifies: A, X, Y, Ptr1, Ptr2, Scan*
00019Cr 2               ; -----------------------------------------------------------------------------
00019Cr 2               MatchScan:
00019Cr 2                 ; TODO: MarksClear, then the four passes below, accumulating RunCount and
00019Cr 2                 ; the per-run (length, colour) pairs the scorer needs.
00019Cr 2  A9 00          lda #0
00019Er 2  8D rr rr       sta RunCount
0001A1r 2  60             rts
0001A2r 2               
0001A2r 2               MatchScanHorizontal:
0001A2r 2  60             rts
0001A3r 2               
0001A3r 2               MatchScanVertical:
0001A3r 2  60             rts
0001A4r 2               
0001A4r 2               MatchScanDiagonal:                ; down-right
0001A4r 2  60             rts
0001A5r 2               
0001A5r 2               MatchScanAntiDiagonal:            ; down-left
0001A5r 2  60             rts
0001A6r 2               
0001A6r 2               ; -----------------------------------------------------------------------------
0001A6r 2               ;   MarksClear / MarkSet / MarkTest — the 16-byte bitmap
0001A6r 2               ;   One byte per row, bits 0-5 = columns 0-5. Union of runs is a free ORA.
0001A6r 2               ; -----------------------------------------------------------------------------
0001A6r 2               MarksClear:
0001A6r 2  60             rts
0001A7r 2               
0001A7r 2               MarkSet:                          ; In: X = row, Y = column
0001A7r 2  60             rts
0001A8r 2               
0001A8r 2               MarkTest:                         ; In: X = row, Y = column.  Out: C = marked
0001A8r 2  18             clc
0001A9r 2  60             rts
0001AAr 2               
0001AAr 1               .include "../src/cascade.asm"
0001AAr 2               ; =============================================================================
0001AAr 2               ;   cascade.asm — Wizards Lab, clear resolution
0001AAr 2               ; =============================================================================
0001AAr 2               ;   SPEC.md section 8. A cascade runs from the moment a piece locks until no
0001AAr 2               ;   further matches exist, one step per iteration, with ChainStep counting the
0001AAr 2               ;   steps. The step order is fixed:
0001AAr 2               ;
0001AAr 2               ;       scan -> score matches -> enqueue reagents -> resolve queue
0001AAr 2               ;            -> animate -> remove -> level check -> gravity -> repeat
0001AAr 2               ;
0001AAr 2               ;   The effect queue always drains. Effects only ever remove tiles, never add
0001AAr 2               ;   them, and each cell can be marked at most once, so the queue is bounded by
0001AAr 2               ;   the 96 cells of the playfield.
0001AAr 2               ; =============================================================================
0001AAr 2               
0001AAr 2               ; -----------------------------------------------------------------------------
0001AAr 2               ;   CascadeBegin — called immediately after PieceLock
0001AAr 2               ; -----------------------------------------------------------------------------
0001AAr 2               CascadeBegin:
0001AAr 2                 ; TODO: ChainStep = 1, Cascade* = 0, StarCount = 0.
0001AAr 2  60             rts
0001ABr 2               
0001ABr 2               ; -----------------------------------------------------------------------------
0001ABr 2               ;   CascadeStep — advance one step
0001ABr 2               ;   Out: C clear when the cascade has settled and CascadeSettle should run.
0001ABr 2               ; -----------------------------------------------------------------------------
0001ABr 2               CascadeStep:
0001ABr 2  18             clc
0001ACr 2  60             rts
0001ADr 2               
0001ADr 2               ; -----------------------------------------------------------------------------
0001ADr 2               ;   CascadeSettle — apply the star multiplier and bank the points
0001ADr 2               ;   SPEC 8 SETTLE, SPEC 9.6 — the doubling covers the WHOLE cascade, including
0001ADr 2               ;   points scored before the star cleared.
0001ADr 2               ; -----------------------------------------------------------------------------
0001ADr 2               CascadeSettle:
0001ADr 2                 ; TODO: shift CascadeLo/Mid/Hi left by min(StarCount, STAR_SHIFT_CAP) in BCD
0001ADr 2                 ; (a BCD doubling is one self-addition), then ScoreAdd.
0001ADr 2  60             rts
0001AEr 2               
0001AEr 2               ; -----------------------------------------------------------------------------
0001AEr 2               ;   The five reagents (SPEC 7.3). Each marks its targets, scores them at
0001AEr 2               ;   EffectValue[chain], and pushes any reagent it uncovers back onto the queue.
0001AEr 2               ; -----------------------------------------------------------------------------
0001AEr 2               EffectFireball:                   ; In: A = colour key. Every tile of it, board wide.
0001AEr 2  60             rts                             ;     Prisms are immune — they have no colour.
0001AFr 2               
0001AFr 2               EffectBolt:                       ; In: X = row, Y = column. Row + column, <= 21 cells.
0001AFr 2  60             rts
0001B0r 2               
0001B0r 2               EffectBomb:                       ; In: X = row, Y = column. 3x3, clipped at the edges.
0001B0r 2  60             rts
0001B1r 2               
0001B1r 2               EffectStar:                       ; Removes nothing; StarCount += 1, capped later.
0001B1r 2  60             rts
0001B2r 2               
0001B2r 2               EffectPrism:                      ; Removes nothing; awards BONUS_PRISM.
0001B2r 2  60             rts
0001B3r 2               
0001B3r 2               ; -----------------------------------------------------------------------------
0001B3r 2               ;   The effect queue — a ring of (glyph, row, col) packed into two bytes.
0001B3r 2               ;   On overflow an effect is dropped rather than growing the buffer; with at
0001B3r 2               ;   most one reagent per piece, EFFECTQ_ENTRIES is not reachable in practice.
0001B3r 2               ; -----------------------------------------------------------------------------
0001B3r 2               EffectQClear:
0001B3r 2  60             rts
0001B4r 2               
0001B4r 2               EffectQPush:                      ; In: A = glyph, X = row, Y = column
0001B4r 2  60             rts
0001B5r 2               
0001B5r 2               EffectQPop:                       ; Out: C clear if empty
0001B5r 2  18             clc
0001B6r 2  60             rts
0001B7r 2               
0001B7r 1               .include "../src/score.asm"
0001B7r 2               ; =============================================================================
0001B7r 2               ;   score.asm — Wizards Lab, scoring
0001B7r 2               ; =============================================================================
0001B7r 2               ;   SPEC.md section 9. Seven digits of packed BCD in four bytes, low byte
0001B7r 2               ;   first; the top nibble of ScoreTop is held at zero. Every value in
0001B7r 2               ;   tables.inc is a multiple of ten, so scoring is a SED / ADC chain and never
0001B7r 2               ;   a multiply — the one place a tile count has to be multiplied by a table
0001B7r 2               ;   value, it is done as a loop of BCD additions, and the count is at most 21.
0001B7r 2               ;
0001B7r 2               ;   The score clamps at 9999999. It never wraps.
0001B7r 2               ;
0001B7r 2               ;   Display is always all seven digits, zero padded — see TextBcd. Nothing
0001B7r 2               ;   here strips a leading zero, and nothing downstream may either.
0001B7r 2               ; =============================================================================
0001B7r 2               
0001B7r 2               ; -----------------------------------------------------------------------------
0001B7r 2               ;   ScoreHighInit — seed the session high score, once, at power-on
0001B7r 2               ;   SPEC 9.8 — the high score is not persisted; it starts at 0010000 on every
0001B7r 2               ;   power-on, which is the target the first game is played against. It then
0001B7r 2               ;   survives every game in the session, so this is deliberately NOT part of
0001B7r 2               ;   ScoreReset. Nothing may infer "cold boot" from the value being zero: BSS
0001B7r 2               ;   is not cleared on all three machines.
0001B7r 2               ;   Out: nothing.  Modifies: A
0001B7r 2               ; -----------------------------------------------------------------------------
0001B7r 2               ScoreHighInit:
0001B7r 2  A9 00          lda #HIGH_INIT_LO
0001B9r 2  8D rr rr       sta HighLo
0001BCr 2  A9 00          lda #HIGH_INIT_MID
0001BEr 2  8D rr rr       sta HighMid
0001C1r 2  A9 01          lda #HIGH_INIT_HI
0001C3r 2  8D rr rr       sta HighHi
0001C6r 2  A9 00          lda #HIGH_INIT_TOP
0001C8r 2  8D rr rr       sta HighTop
0001CBr 2  A9 01          lda #$01                      ; BCD — the level the target was "set" on
0001CDr 2  8D rr rr       sta HighLevel
0001D0r 2  60             rts
0001D1r 2               
0001D1r 2               ; -----------------------------------------------------------------------------
0001D1r 2               ;   ScoreReset — zero the score for a new game
0001D1r 2               ;   Out: nothing.  Modifies: A
0001D1r 2               ; -----------------------------------------------------------------------------
0001D1r 2               ScoreReset:
0001D1r 2  A9 00          lda #0
0001D3r 2  8D rr rr       sta ScoreLo
0001D6r 2  8D rr rr       sta ScoreMid
0001D9r 2  8D rr rr       sta ScoreHi
0001DCr 2  8D rr rr       sta ScoreTop
0001DFr 2  8D rr rr       sta CascadeLo
0001E2r 2  8D rr rr       sta CascadeMid
0001E5r 2  8D rr rr       sta CascadeHi
0001E8r 2  8D rr rr       sta StarCount
0001EBr 2  60             rts
0001ECr 2               
0001ECr 2               ; -----------------------------------------------------------------------------
0001ECr 2               ;   CascadeAdd — add a 16-bit BCD value to the cascade accumulator
0001ECr 2               ;   In:  A = low BCD byte, X = high BCD byte
0001ECr 2               ;   Out: nothing.  Modifies: A, flags
0001ECr 2               ; -----------------------------------------------------------------------------
0001ECr 2               CascadeAdd:
0001ECr 2                 ; TODO: SED, three-byte add into CascadeLo/Mid/Hi, CLD.
0001ECr 2  60             rts
0001EDr 2               
0001EDr 2               ; -----------------------------------------------------------------------------
0001EDr 2               ;   CascadeAddTimes — add a value N times (the tiles-cleared multiply)
0001EDr 2               ;   In:  A = low BCD, X = high BCD, Y = count
0001EDr 2               ; -----------------------------------------------------------------------------
0001EDr 2               CascadeAddTimes:
0001EDr 2  60             rts
0001EEr 2               
0001EEr 2               ; -----------------------------------------------------------------------------
0001EEr 2               ;   ScoreAdd — bank the cascade accumulator into Score, clamped
0001EEr 2               ;   Out: C set if a new high score was reached this call.
0001EEr 2               ;   SPEC 9.8 — the high score updates live, so the player watches the overtake.
0001EEr 2               ; -----------------------------------------------------------------------------
0001EEr 2               ScoreAdd:
0001EEr 2  18             clc
0001EFr 2  60             rts
0001F0r 2               
0001F0r 2               ; -----------------------------------------------------------------------------
0001F0r 2               ;   ScoreLevelCheck — advance the level when 30 tiles have gone
0001F0r 2               ;   In:  A = tiles removed this step
0001F0r 2               ;   Out: C set if the level advanced.
0001F0r 2               ;   SPEC 10.1 — at most one advance per step, surplus carries over, so a big
0001F0r 2               ;   fireball chain can never skip a level.
0001F0r 2               ; -----------------------------------------------------------------------------
0001F0r 2               ScoreLevelCheck:
0001F0r 2  18             clc
0001F1r 2  60             rts
0001F2r 2               
0001F2r 2               ; -----------------------------------------------------------------------------
0001F2r 2               ;   ScoreGravity — frames per row for the current level
0001F2r 2               ;   Out: A = frame count, from SpeedNTSC or SpeedPAL per Region.
0001F2r 2               ; -----------------------------------------------------------------------------
0001F2r 2               ScoreGravity:
0001F2r 2  A9 30          lda #48                       ; TODO: index SpeedNTSC/SpeedPAL by Level-1,
0001F4r 2  60             rts                           ;       clamped to LEVEL_SPEED_CAP - 1
0001F5r 2               
0001F5r 1               .include "../src/render.asm"
0001F5r 2               ; =============================================================================
0001F5r 2               ;   render.asm — Wizards Lab, the dirty-cell renderer
0001F5r 2               ; =============================================================================
0001F5r 2               ;   SPEC.md section 12.6. The screen is never fully redrawn during play.
0001F5r 2               ;   Changed cells are appended to a ring and flushed once a frame, at most
0001F5r 2               ;   DIRTY_FLUSH_MAX per frame with the remainder carried over.
0001F5r 2               ;
0001F5r 2               ;   The cap is NOT a hardware write-spacing limit. S1 measured this loop at
0001F5r 2               ;   165 cycles a cell on the AC6502, which puts two VRAM data writes 165 us
0001F5r 2               ;   apart at 1 MHz and the closest two VDP PORT accesses 8 cycles apart —
0001F5r 2               ;   inside even a real TMS9918A's 8 us and 2 us windows with two orders of
0001F5r 2               ;   magnitude to spare, and further inside a pico9918's, which emulates VRAM
0001F5r 2               ;   in RP2040 memory and has no display contention at all. A 6502 at this
0001F5r 2               ;   clock cannot write a TMS9918 too fast however hard it tries.
0001F5r 2               ;
0001F5r 2               ;   The cap is a TIME BUDGET: DIRTY_FLUSH_MAX cells is what fits in vertical
0001F5r 2               ;   blank on the tightest of the three. See constants.inc and PLAN.md S1.
0001F5r 2               ;
0001F5r 2               ;   All screen access goes through HalPlotCell (see hal.inc). Nothing in this
0001F5r 2               ;   file knows where screen memory is.
0001F5r 2               ; =============================================================================
0001F5r 2               
0001F5r 2               ; -----------------------------------------------------------------------------
0001F5r 2               ;   RenderDirtyReset — empty the ring and cancel any outstanding board redraw
0001F5r 2               ;   Call this after anything that draws the whole screen behind the renderer's
0001F5r 2               ;   back (HalBlitScreen), because every queued cell then describes a screen
0001F5r 2               ;   that no longer exists.
0001F5r 2               ;   In:  nothing        Out: nothing.  Modifies: A
0001F5r 2               ; -----------------------------------------------------------------------------
0001F5r 2               RenderDirtyReset:
0001F5r 2  A9 00          lda #0
0001F7r 2  8D rr rr       sta DirtyCount
0001FAr 2  8D rr rr       sta DirtyHead
0001FDr 2  8D rr rr       sta DirtyTail
000200r 2  A9 FF          lda #$FF
000202r 2  8D rr rr       sta RedrawIdx
000205r 2  60             rts
000206r 2               
000206r 2               ; -----------------------------------------------------------------------------
000206r 2               ;   RenderMark — queue one panel cell
000206r 2               ;   In:  A = tile, X = panel column, Y = panel row
000206r 2               ;   Out: nothing.  Modifies: A, X.  PRESERVES Y and every byte of zero page.
000206r 2               ;
000206r 2               ;   The PANEL_X / PANEL_Y offset is applied here, once, so nothing upstream
000206r 2               ;   has to know which machine it is running on.
000206r 2               ;
000206r 2               ;   Preserving Y and zero page is a contract, not an accident: text.asm holds
000206r 2               ;   its string cursor across this call (see zeropage.inc). The three values
000206r 2               ;   ride the stack rather than scratch bytes because A, X and Y are all live
000206r 2               ;   at once and there is no fourth register to index the ring with.
000206r 2               ;
000206r 2               ;   A mark that arrives with the ring full is DROPPED, silently (D6).
000206r 2               ; -----------------------------------------------------------------------------
000206r 2               RenderMark:
000206r 2  48             pha                           ; Tile
000207r 2  98             tya
000208r 2  18             clc
000209r 2  69 00          adc #PANEL_Y                  ; Panel row -> screen row
00020Br 2  48             pha
00020Cr 2  8A             txa
00020Dr 2  18             clc
00020Er 2  69 05          adc #PANEL_X                  ; Panel column -> screen column
000210r 2  48             pha
000211r 2               
000211r 2  AD rr rr       lda DirtyCount
000214r 2  C9 40          cmp #DIRTY_ENTRIES
000216r 2  B0 1F          bcs @Full
000218r 2  EE rr rr       inc DirtyCount
00021Br 2               
00021Br 2  AE rr rr       ldx DirtyTail
00021Er 2  68             pla
00021Fr 2  9D rr rr       sta Dirty+0,x                 ; Screen column
000222r 2  68             pla
000223r 2  9D rr rr       sta Dirty+1,x                 ; Screen row
000226r 2  68             pla
000227r 2  9D rr rr       sta Dirty+2,x                 ; Tile
00022Ar 2               
00022Ar 2  E8             inx                           ; Step one entry, wrapping the ring
00022Br 2  E8             inx
00022Cr 2  E8             inx
00022Dr 2  E0 C0          cpx #DIRTY_BYTES
00022Fr 2  90 02          bcc @Store
000231r 2  A2 00          ldx #0
000233r 2               @Store:
000233r 2  8E rr rr       stx DirtyTail
000236r 2  60             rts
000237r 2               
000237r 2               @Full:
000237r 2  68             pla                           ; Unwind and drop it. The cell is wrong until
000238r 2  68             pla                           ;   something marks it again.
000239r 2  68             pla
00023Ar 2  60             rts
00023Br 2               
00023Br 2               ; -----------------------------------------------------------------------------
00023Br 2               ;   RenderFlush — push up to DIRTY_FLUSH_MAX queued cells to the screen
00023Br 2               ;   Called once per frame, from the top of the main loop.
00023Br 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
00023Br 2               ; -----------------------------------------------------------------------------
00023Br 2               RenderFlush:
00023Br 2  20 rr rr       jsr RenderBoardStep           ; Top the ring up from a board redraw, if one
00023Er 2                                               ;   is outstanding, so it always makes progress
00023Er 2  AD rr rr       lda DirtyCount
000241r 2  F0 31          beq @Done
000243r 2  C9 18          cmp #DIRTY_FLUSH_MAX
000245r 2  90 02          bcc @Budget
000247r 2  A9 18          lda #DIRTY_FLUSH_MAX
000249r 2               @Budget:
000249r 2  85 rr          sta FlushLeft
00024Br 2               
00024Br 2               @Cell:
00024Br 2  AE rr rr       ldx DirtyHead
00024Er 2  BD rr rr       lda Dirty+1,x
000251r 2  A8             tay                           ; Y = screen row
000252r 2  BD rr rr       lda Dirty+2,x
000255r 2  48             pha                           ; Tile
000256r 2  BD rr rr       lda Dirty+0,x
000259r 2  AA             tax                           ; X = screen column
00025Ar 2  68             pla                           ; A = tile
00025Br 2  20 rr rr       jsr HalPlotCell
00025Er 2               
00025Er 2  AD rr rr       lda DirtyHead                 ; Step one entry, wrapping the ring
000261r 2  18             clc
000262r 2  69 03          adc #3
000264r 2  C9 C0          cmp #DIRTY_BYTES
000266r 2  90 02          bcc @Store
000268r 2  A9 00          lda #0
00026Ar 2               @Store:
00026Ar 2  8D rr rr       sta DirtyHead
00026Dr 2  CE rr rr       dec DirtyCount
000270r 2  C6 rr          dec FlushLeft
000272r 2  D0 D7          bne @Cell
000274r 2               @Done:
000274r 2  60             rts
000275r 2               
000275r 2               ; -----------------------------------------------------------------------------
000275r 2               ;   RenderBoard — ask for the whole 6 x 16 well to be redrawn
000275r 2               ;   Used on state entry and after a pause, not per frame.
000275r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000275r 2               ;
000275r 2               ;   The well is 96 cells and the ring holds DIRTY_ENTRIES; a redraw therefore
000275r 2               ;   cannot be queued in one go. This only sets the cursor. RenderBoardStep,
000275r 2               ;   which RenderFlush calls every frame, feeds the ring as fast as it drains,
000275r 2               ;   so the redraw spreads over as many frames as it needs and never drops a
000275r 2               ;   cell.
000275r 2               ; -----------------------------------------------------------------------------
000275r 2               RenderBoard:
000275r 2  A9 00          lda #0
000277r 2  8D rr rr       sta RedrawIdx                 ; Board index 0 = row 0, column 0
00027Ar 2  60             rts                           ; And nothing else. Falling through into the
00027Br 2                                               ;   step below would fill the ring here and
00027Br 2                                               ;   drop whatever the caller marks next.
00027Br 2               
00027Br 2               ; -----------------------------------------------------------------------------
00027Br 2               ;   RenderBoardStep — queue as much of an outstanding board redraw as fits
00027Br 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
00027Br 2               ;   Does nothing when RedrawIdx is $FF.
00027Br 2               ; -----------------------------------------------------------------------------
00027Br 2               RenderBoardStep:
00027Br 2  AD rr rr       lda RedrawIdx
00027Er 2  30 41          bmi @Done                     ; $FF — nothing outstanding
000280r 2               
000280r 2               @Cell:
000280r 2  AD rr rr       lda DirtyCount
000283r 2  C9 40          cmp #DIRTY_ENTRIES
000285r 2  B0 3A          bcs @Done                     ; Ring full — pick this cell up next frame
000287r 2               
000287r 2  AE rr rr       ldx RedrawIdx
00028Ar 2  8A             txa
00028Br 2  29 07          and #(BOARD_STRIDE - 1)
00028Dr 2  18             clc
00028Er 2  69 01          adc #WELL_ORIGIN_X
000290r 2  85 rr          sta RedrawCol
000292r 2  8A             txa
000293r 2  4A             lsr a                         ; Board index >> 3 is the row (stride 8)
000294r 2  4A             lsr a
000295r 2  4A             lsr a
000296r 2  18             clc
000297r 2  69 04          adc #WELL_ORIGIN_Y
000299r 2  A8             tay                           ; Y = panel row
00029Ar 2  BD rr rr       lda Board,x                   ; The board byte IS the tile — empty is $00,
00029Dr 2  A6 rr          ldx RedrawCol                 ;   which is TILE_BLANK (SPEC 3.3, 4.2)
00029Fr 2  20 rr rr       jsr RenderMark
0002A2r 2               
0002A2r 2  AE rr rr       ldx RedrawIdx                 ; Advance, stepping over the two sentinel
0002A5r 2  E8             inx                           ;   columns at the end of each row
0002A6r 2  8A             txa
0002A7r 2  29 07          and #(BOARD_STRIDE - 1)
0002A9r 2  C9 06          cmp #BOARD_W
0002ABr 2  90 05          bcc @Save
0002ADr 2  8A             txa
0002AEr 2  18             clc
0002AFr 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
0002B1r 2  AA             tax
0002B2r 2               @Save:
0002B2r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
0002B4r 2  B0 06          bcs @Finish
0002B6r 2  8E rr rr       stx RedrawIdx
0002B9r 2  4C rr rr       jmp @Cell
0002BCr 2               
0002BCr 2               @Finish:
0002BCr 2  A9 FF          lda #$FF
0002BEr 2  8D rr rr       sta RedrawIdx
0002C1r 2               @Done:
0002C1r 2  60             rts
0002C2r 2               
0002C2r 2               ; -----------------------------------------------------------------------------
0002C2r 2               ;   RenderCell — queue one board cell by board index
0002C2r 2               ;   In:  X = board index (row * BOARD_STRIDE + column)
0002C2r 2               ;   Out: nothing.  Modifies: A, X, Y
0002C2r 2               ;   The single-cell form of RenderBoardStep, for the phases that move one tile
0002C2r 2               ;   at a time.
0002C2r 2               ; -----------------------------------------------------------------------------
0002C2r 2               RenderCell:
0002C2r 2  8A             txa
0002C3r 2  29 07          and #(BOARD_STRIDE - 1)
0002C5r 2  18             clc
0002C6r 2  69 01          adc #WELL_ORIGIN_X
0002C8r 2  85 rr          sta RedrawCol
0002CAr 2  8A             txa
0002CBr 2  4A             lsr a
0002CCr 2  4A             lsr a
0002CDr 2  4A             lsr a
0002CEr 2  18             clc
0002CFr 2  69 04          adc #WELL_ORIGIN_Y
0002D1r 2  A8             tay
0002D2r 2  BD rr rr       lda Board,x
0002D5r 2  A6 rr          ldx RedrawCol
0002D7r 2  4C rr rr       jmp RenderMark
0002DAr 2               
0002DAr 2               ; -----------------------------------------------------------------------------
0002DAr 2               ;   RenderPiece / RenderPieceErase — the three falling cells
0002DAr 2               ;   P2.
0002DAr 2               ; -----------------------------------------------------------------------------
0002DAr 2               RenderPiece:
0002DAr 2  60             rts
0002DBr 2               
0002DBr 2               RenderPieceErase:
0002DBr 2  60             rts
0002DCr 2               
0002DCr 2               ; -----------------------------------------------------------------------------
0002DCr 2               ;   RenderNext — the preview, panel column NEXT_X, rows NEXT_Y..NEXT_Y+2
0002DCr 2               ;   P2.
0002DCr 2               ; -----------------------------------------------------------------------------
0002DCr 2               RenderNext:
0002DCr 2  60             rts
0002DDr 2               
0002DDr 2               ; -----------------------------------------------------------------------------
0002DDr 2               ;   RenderScore / RenderHigh / RenderLevel — only called when a value changes
0002DDr 2               ;   Nothing here compares anything: the caller knows when it changed a value
0002DDr 2               ;   and these are not cheap enough to run every frame. SCORE_DIGITS cells is
0002DDr 2               ;   most of a frame's flush budget on its own.
0002DDr 2               ; -----------------------------------------------------------------------------
0002DDr 2               RenderScore:
0002DDr 2  A9 rr          lda #<ScoreLo
0002DFr 2  85 rr          sta Ptr1
0002E1r 2  A9 rr          lda #>ScoreLo
0002E3r 2  85 rr          sta Ptr1+1
0002E5r 2  A2 0C          ldx #SCORE_X
0002E7r 2  A0 05          ldy #SCORE_Y
0002E9r 2  A9 07          lda #SCORE_DIGITS
0002EBr 2  4C rr rr       jmp TextBcd
0002EEr 2               
0002EEr 2               RenderHigh:
0002EEr 2  A9 rr          lda #<HighLo
0002F0r 2  85 rr          sta Ptr1
0002F2r 2  A9 rr          lda #>HighLo
0002F4r 2  85 rr          sta Ptr1+1
0002F6r 2  A2 0C          ldx #HIGH_X
0002F8r 2  A0 0A          ldy #HIGH_Y
0002FAr 2  A9 07          lda #SCORE_DIGITS
0002FCr 2  20 rr rr       jsr TextBcd
0002FFr 2               
0002FFr 2  A9 rr          lda #<HighLevel               ; The level it was set on, under the digits
000301r 2  85 rr          sta Ptr1
000303r 2  A9 rr          lda #>HighLevel
000305r 2  85 rr          sta Ptr1+1
000307r 2  A2 0F          ldx #HIGHLVL_X
000309r 2  A0 0B          ldy #HIGHLVL_Y
00030Br 2  A9 02          lda #LEVEL_DIGITS
00030Dr 2  4C rr rr       jmp TextBcd
000310r 2               
000310r 2               RenderLevel:
000310r 2  AD rr rr       lda Level
000313r 2  4C rr rr       jmp TextLevel
000316r 2               
000316r 1               .include "../src/text.asm"
000316r 2               ; =============================================================================
000316r 2               ;   text.asm — Wizards Lab, text and numbers on the panel
000316r 2               ; =============================================================================
000316r 2               ;   The font lives in tile groups 2-6, forty glyphs in the order
000316r 2               ;
000316r 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
000316r 2               ;
000316r 2               ;   starting at FONT_BASE, so a digit is FONT_DIGIT_0 + value and a letter is
000316r 2               ;   FONT_LETTER_A + (letter - 'A'). Strings are stored pre-converted to tile
000316r 2               ;   numbers, terminated by TEXT_END, so drawing one is a copy with no
000316r 2               ;   translation. src/strings.inc holds them and the macro that encodes them.
000316r 2               ;
000316r 2               ;   Everything here draws through RenderMark, never to the screen: text is
000316r 2               ;   panel cells like any other and goes through the same one flush a frame.
000316r 2               ;   That is also why the cursor state lives in the zero-page block RenderMark
000316r 2               ;   promises not to touch (zeropage.inc) rather than in Tmp0-Tmp3.
000316r 2               ; =============================================================================
000316r 2               
000316r 2               ; -----------------------------------------------------------------------------
000316r 2               ;   TextDraw — draw a tile-encoded string
000316r 2               ;   In:  Ptr1 -> string (TEXT_END terminated), X = panel column, Y = panel row
000316r 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx
000316r 2               ; -----------------------------------------------------------------------------
000316r 2               TextDraw:
000316r 2  86 rr          stx TextCol
000318r 2  84 rr          sty TextRow
00031Ar 2  A9 00          lda #0
00031Cr 2  85 rr          sta TextIdx
00031Er 2               @Char:
00031Er 2  A4 rr          ldy TextIdx
000320r 2  B1 rr          lda (Ptr1),y
000322r 2  C9 FF          cmp #TEXT_END
000324r 2  F0 0D          beq @Done
000326r 2  A6 rr          ldx TextCol
000328r 2  A4 rr          ldy TextRow
00032Ar 2  20 rr rr       jsr RenderMark
00032Dr 2  E6 rr          inc TextCol
00032Fr 2  E6 rr          inc TextIdx
000331r 2  D0 EB          bne @Char                     ; Always — a string is never 256 tiles long
000333r 2               @Done:
000333r 2  60             rts
000334r 2               
000334r 2               ; -----------------------------------------------------------------------------
000334r 2               ;   TextBcd — draw a packed-BCD number, zero padded
000334r 2               ;   In:  Ptr1 -> BCD bytes (low first), A = digit count,
000334r 2               ;        X = panel column, Y = panel row
000334r 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx, TextByte,
000334r 2               ;        TextSkip
000334r 2               ;
000334r 2               ;   SCORE_DIGITS (7) for the score and the high score, 2 for the high score's
000334r 2               ;   level. The LEVEL box is not drawn with this — see TextLevel.
000334r 2               ;
000334r 2               ;   The count is in DIGITS, not bytes, because the score is seven digits in
000334r 2               ;   four bytes: the top nibble of the most significant byte is held at zero
000334r 2               ;   (SPEC 9) and must not be drawn, or the field would be eight cells wide and
000334r 2               ;   no longer centred. An odd count starts at the LOW nibble of the top byte.
000334r 2               ;
000334r 2               ;   **Every digit is drawn, every time.** A leading zero is a zero glyph, not
000334r 2               ;   a blank: 1250 draws as 0001250. There is no suppression pass and no
000334r 2               ;   right-alignment — the field is fixed width so a digit never changes
000334r 2               ;   column while the player is watching it (SPEC 9). This also makes the
000334r 2               ;   routine branchless, and lets RenderScore mark a fixed run of cells dirty.
000334r 2               ; -----------------------------------------------------------------------------
000334r 2               TextBcd:
000334r 2  86 rr          stx TextCol
000336r 2  84 rr          sty TextRow
000338r 2  48             pha                           ; Digit count
000339r 2  29 01          and #$01
00033Br 2  85 rr          sta TextSkip                  ; Odd count: the top high nibble is not drawn
00033Dr 2  68             pla
00033Er 2  18             clc
00033Fr 2  69 01          adc #1                        ; Bytes = (digits + 1) / 2
000341r 2  4A             lsr a
000342r 2  AA             tax
000343r 2  CA             dex
000344r 2  86 rr          stx TextIdx                   ; Start at the most significant byte
000346r 2               
000346r 2               @Byte:
000346r 2  A4 rr          ldy TextIdx
000348r 2  B1 rr          lda (Ptr1),y
00034Ar 2  85 rr          sta TextByte
00034Cr 2               
00034Cr 2  A5 rr          lda TextSkip
00034Er 2  D0 09          bne @Low
000350r 2  A5 rr          lda TextByte
000352r 2  4A             lsr a
000353r 2  4A             lsr a
000354r 2  4A             lsr a
000355r 2  4A             lsr a
000356r 2  20 rr rr       jsr TextDigit
000359r 2               @Low:
000359r 2  A9 00          lda #0
00035Br 2  85 rr          sta TextSkip
00035Dr 2  A5 rr          lda TextByte
00035Fr 2  29 0F          and #$0F
000361r 2  20 rr rr       jsr TextDigit
000364r 2               
000364r 2  C6 rr          dec TextIdx
000366r 2  10 DE          bpl @Byte
000368r 2  60             rts
000369r 2               
000369r 2               ; -----------------------------------------------------------------------------
000369r 2               ;   TextDigit — draw one digit at the cursor and step it right
000369r 2               ;   In:  A = value 0-9      Modifies: A, X, Y, TextCol
000369r 2               ; -----------------------------------------------------------------------------
000369r 2               TextDigit:
000369r 2  18             clc
00036Ar 2  69 10          adc #FONT_DIGIT_0
00036Cr 2  A6 rr          ldx TextCol
00036Er 2  A4 rr          ldy TextRow
000370r 2  20 rr rr       jsr RenderMark
000373r 2  E6 rr          inc TextCol
000375r 2  60             rts
000376r 2               
000376r 2               ; -----------------------------------------------------------------------------
000376r 2               ;   TextBanner — centre a string in the one-row message band
000376r 2               ;   In:  Ptr1 -> string
000376r 2               ;   Out: nothing.  Modifies: A, X, Y and the text cursor
000376r 2               ;
000376r 2               ;   SPEC 12.2 — the band is panel row MSG_Y, full width, one row only. The
000376r 2               ;   string arrives already wrapped as `~~ TEXT ~~` — two FONT_TILDE, a blank,
000376r 2               ;   the text, a blank, two FONT_TILDE. Centring is (PANEL_W - length) / 2,
000376r 2               ;   which is why banner strings are drawn even-length.
000376r 2               ; -----------------------------------------------------------------------------
000376r 2               TextBanner:
000376r 2  A0 00          ldy #0
000378r 2               @Len:
000378r 2  B1 rr          lda (Ptr1),y
00037Ar 2  C9 FF          cmp #TEXT_END
00037Cr 2  F0 03          beq @Got
00037Er 2  C8             iny
00037Fr 2  D0 F7          bne @Len
000381r 2               @Got:
000381r 2  98             tya
000382r 2  85 rr          sta TextIdx
000384r 2  A9 16          lda #PANEL_W
000386r 2  38             sec
000387r 2  E5 rr          sbc TextIdx
000389r 2  4A             lsr a                         ; (PANEL_W - length) / 2
00038Ar 2  AA             tax
00038Br 2  A0 16          ldy #MSG_Y
00038Dr 2  4C rr rr       jmp TextDraw
000390r 2               
000390r 2               ; -----------------------------------------------------------------------------
000390r 2               ;   TextBannerClear — blank the message band back to backdrop
000390r 2               ;   Out: nothing.  Modifies: A, X, Y
000390r 2               ;
000390r 2               ;   Columns MSG_X .. MSG_X + MSG_W - 1 only. The shelf tiles at either end of
000390r 2               ;   the band belong to the static screen image and are never redrawn.
000390r 2               ; -----------------------------------------------------------------------------
000390r 2               TextBannerClear:
000390r 2  A9 02          lda #MSG_X
000392r 2  85 rr          sta TextCol                   ; Not X: RenderMark clobbers it
000394r 2               @Cell:
000394r 2  A9 00          lda #TILE_BLANK
000396r 2  A6 rr          ldx TextCol
000398r 2  A0 16          ldy #MSG_Y
00039Ar 2  20 rr rr       jsr RenderMark
00039Dr 2  E6 rr          inc TextCol
00039Fr 2  A5 rr          lda TextCol
0003A1r 2  C9 14          cmp #(MSG_X + MSG_W)
0003A3r 2  90 EF          bcc @Cell
0003A5r 2  60             rts
0003A6r 2               
0003A6r 2               ; -----------------------------------------------------------------------------
0003A6r 2               ;   TextLevel — the LEVEL box, tens above units in one column
0003A6r 2               ;   In:  A = level (binary, 1-99)
0003A6r 2               ;   Out: nothing.  Modifies: A, X, Y, TextByte
0003A6r 2               ;   SPEC 12.2 — LEVEL_X, tens at LEVEL_Y and units at LEVEL_Y + 1. Always two
0003A6r 2               ;   digits: level 5 draws "0" over "5".
0003A6r 2               ; -----------------------------------------------------------------------------
0003A6r 2               TextLevel:
0003A6r 2  A2 00          ldx #0
0003A8r 2               @Tens:
0003A8r 2  C9 0A          cmp #10
0003AAr 2  90 05          bcc @Split
0003ACr 2  E9 0A          sbc #10                       ; Carry is set by the CMP that got us here
0003AEr 2  E8             inx
0003AFr 2  D0 F7          bne @Tens                     ; Always — X tops out at 9
0003B1r 2               @Split:
0003B1r 2  85 rr          sta TextByte                  ; Units
0003B3r 2  8A             txa
0003B4r 2  18             clc
0003B5r 2  69 10          adc #FONT_DIGIT_0
0003B7r 2  A2 12          ldx #LEVEL_X
0003B9r 2  A0 11          ldy #LEVEL_Y
0003BBr 2  20 rr rr       jsr RenderMark
0003BEr 2  A5 rr          lda TextByte
0003C0r 2  18             clc
0003C1r 2  69 10          adc #FONT_DIGIT_0
0003C3r 2  A2 12          ldx #LEVEL_X
0003C5r 2  A0 12          ldy #LEVEL_Y + 1
0003C7r 2  4C rr rr       jmp RenderMark
0003CAr 2               
0003CAr 1               .include "../src/audio.asm"
0003CAr 2               ; =============================================================================
0003CAr 2               ;   audio.asm — Wizards Lab, sound
0003CAr 2               ; =============================================================================
0003CAr 2               ;   SPEC.md section 16. Out of scope for the first playable build, but the
0003CAr 2               ;   hook is here from the start so game logic never has to be revisited to add
0003CAr 2               ;   it: logic writes an effect id to SfxRequest and forgets about it.
0003CAr 2               ;
0003CAr 2               ;   The AC6502 and the C64 both have a SID and can share a driver — only the
0003CAr 2               ;   register base differs ($9800 against $D400). The VIC-20 needs its own,
0003CAr 2               ;   against $900A-$900E.
0003CAr 2               ; =============================================================================
0003CAr 2               
0003CAr 2               SFX_MOVE        = 1
0003CAr 2               SFX_ROTATE      = 2
0003CAr 2               SFX_LOCK        = 3
0003CAr 2               SFX_MATCH       = 4
0003CAr 2               SFX_FIREBALL    = 5
0003CAr 2               SFX_BOLT        = 6
0003CAr 2               SFX_BOMB        = 7
0003CAr 2               SFX_STAR        = 8
0003CAr 2               SFX_PRISM       = 9
0003CAr 2               SFX_LEVELUP     = 10
0003CAr 2               SFX_HIGHSCORE   = 11
0003CAr 2               SFX_GAMEOVER    = 12
0003CAr 2               
0003CAr 2               ; -----------------------------------------------------------------------------
0003CAr 2               ;   AudioInit — silence everything
0003CAr 2               ; -----------------------------------------------------------------------------
0003CAr 2               AudioInit:
0003CAr 2  A9 00          lda #0
0003CCr 2  8D rr rr       sta SfxRequest
0003CFr 2  8D rr rr       sta SfxTimer
0003D2r 2  60             rts
0003D3r 2               
0003D3r 2               ; -----------------------------------------------------------------------------
0003D3r 2               ;   AudioTick — called once per frame, consumes SfxRequest
0003D3r 2               ; -----------------------------------------------------------------------------
0003D3r 2               AudioTick:
0003D3r 2                 ; TODO: start a new effect when SfxRequest is non-zero, then advance the
0003D3r 2                 ; envelope of whatever is playing. Calls HalSfx for the register writes.
0003D3r 2  A9 00          lda #0
0003D5r 2  8D rr rr       sta SfxRequest
0003D8r 2  60             rts
0003D9r 2               
0003D9r 1               
0003D9r 1               ; =============================================================================
0003D9r 1               ;   HAL — TMS9918 Graphics Mode I
0003D9r 1               ; =============================================================================
0003D9r 1               
0003D9r 1               ; -----------------------------------------------------------------------------
0003D9r 1               ;   VdpSetWrite — point the VDP at a VRAM address for writing
0003D9r 1               ;   In:  A = address low, X = address high
0003D9r 1               ; -----------------------------------------------------------------------------
0003D9r 1               VdpSetWrite:
0003D9r 1  8D 01 9C       sta VC_REG
0003DCr 1  8A             txa
0003DDr 1  09 40          ora #$40                      ; Bit 6 selects write
0003DFr 1  8D 01 9C       sta VC_REG
0003E2r 1  60             rts
0003E3r 1               
0003E3r 1               ; -----------------------------------------------------------------------------
0003E3r 1               ;   VdpSetReg — write a VDP control register
0003E3r 1               ;   In:  A = value, X = register number
0003E3r 1               ; -----------------------------------------------------------------------------
0003E3r 1               VdpSetReg:
0003E3r 1  8D 01 9C       sta VC_REG
0003E6r 1  8A             txa
0003E7r 1  09 80          ora #$80
0003E9r 1  8D 01 9C       sta VC_REG
0003ECr 1  60             rts
0003EDr 1               
0003EDr 1               ; -----------------------------------------------------------------------------
0003EDr 1               ;   HalInitVideo — Graphics I, tiles loaded, screen cleared, everything black
0003EDr 1               ; -----------------------------------------------------------------------------
0003EDr 1               HalInitVideo:
0003EDr 1  A2 00          ldx #0                        ; R0: external VDP disabled, Graphics I
0003EFr 1  A9 00          lda #$00
0003F1r 1  20 rr rr       jsr VdpSetReg
0003F4r 1  A2 01          ldx #1                        ; R1: 16 K, display on, IRQ enabled, 8x8 sprites
0003F6r 1  A9 E0          lda #$E0                      ; The IE bit stays SET even though this game
0003F8r 1  20 rr rr       jsr VdpSetReg                 ;   polls: HalWaitFrame reads the status
0003FBr 1                                               ;   register for the vblank flag, and the flag
0003FBr 1                                               ;   only raises when IE is on. The CPU's own I
0003FBr 1                                               ;   flag is never cleared, so the interrupt is
0003FBr 1                                               ;   asserted and simply ignored — reading the
0003FBr 1                                               ;   status register acknowledges it.
0003FBr 1  A2 02          ldx #2                        ; R2: name table    $1400 / $400
0003FDr 1  A9 05          lda #$05
0003FFr 1  20 rr rr       jsr VdpSetReg
000402r 1  A2 03          ldx #3                        ; R3: colour table  $2000 / $40
000404r 1  A9 80          lda #$80
000406r 1  20 rr rr       jsr VdpSetReg
000409r 1  A2 04          ldx #4                        ; R4: pattern table $0000 / $800
00040Br 1  A9 00          lda #$00
00040Dr 1  20 rr rr       jsr VdpSetReg
000410r 1  A2 05          ldx #5                        ; R5: sprite attrs  $1B00 / $80
000412r 1  A9 36          lda #$36
000414r 1  20 rr rr       jsr VdpSetReg
000417r 1  A2 06          ldx #6                        ; R6: sprite patterns $0000
000419r 1  A9 00          lda #$00
00041Br 1  20 rr rr       jsr VdpSetReg
00041Er 1  A2 07          ldx #7                        ; R7: backdrop black
000420r 1  A9 01          lda #$01
000422r 1  20 rr rr       jsr VdpSetReg
000425r 1               
000425r 1  20 rr rr       jsr LoadTileset
000428r 1  20 rr rr       jsr LoadColorTable
00042Br 1  20 rr rr       jsr DisableSprites
00042Er 1                 ; falls through
00042Er 1               
00042Er 1               ; -----------------------------------------------------------------------------
00042Er 1               ;   HalClearScreen — fill the name table with the blank tile
00042Er 1               ; -----------------------------------------------------------------------------
00042Er 1               HalClearScreen:
00042Er 1  A9 00          lda #<VRAM_NAMES
000430r 1  A2 14          ldx #>VRAM_NAMES
000432r 1  20 rr rr       jsr VdpSetWrite
000435r 1  A2 03          ldx #3                        ; 3 x 256 = 768 cells
000437r 1  A0 00          ldy #0
000439r 1               @Cell:
000439r 1  A9 00          lda #TILE_BLANK
00043Br 1  8D 00 9C       sta VC_DATA
00043Er 1  C8             iny
00043Fr 1  D0 F8          bne @Cell
000441r 1  CA             dex
000442r 1  D0 F5          bne @Cell
000444r 1  60             rts
000445r 1               
000445r 1               ; -----------------------------------------------------------------------------
000445r 1               ;   LoadTileset — 2 K of patterns into VRAM
000445r 1               ;   PLACEHOLDER ART: Tileset is data/tileset.bin. See data/README.md.
000445r 1               ; -----------------------------------------------------------------------------
000445r 1               LoadTileset:
000445r 1  A9 00          lda #<VRAM_PATTERNS
000447r 1  A2 00          ldx #>VRAM_PATTERNS
000449r 1  20 rr rr       jsr VdpSetWrite
00044Cr 1               
00044Cr 1  A9 rr          lda #<Tileset
00044Er 1  85 rr          sta SrcPtr
000450r 1  A9 rr          lda #>Tileset
000452r 1  85 rr          sta SrcPtr+1
000454r 1               
000454r 1  A2 08          ldx #8                        ; 8 x 256 = 2048 bytes
000456r 1  A0 00          ldy #0
000458r 1               @Byte:
000458r 1  B1 rr          lda (SrcPtr),y
00045Ar 1  8D 00 9C       sta VC_DATA
00045Dr 1  C8             iny
00045Er 1  D0 F8          bne @Byte
000460r 1  E6 rr          inc SrcPtr+1
000462r 1  CA             dex
000463r 1  D0 F3          bne @Byte
000465r 1  60             rts
000466r 1               
000466r 1               ; -----------------------------------------------------------------------------
000466r 1               ;   LoadColorTable — 32 bytes, one per 8-pattern group
000466r 1               ;   This is what makes a tile red: its pattern number selects the group, and
000466r 1               ;   the group's byte here selects the colour. Nothing is per cell.
000466r 1               ; -----------------------------------------------------------------------------
000466r 1               LoadColorTable:
000466r 1  A9 00          lda #<VRAM_COLORS
000468r 1  A2 20          ldx #>VRAM_COLORS
00046Ar 1  20 rr rr       jsr VdpSetWrite
00046Dr 1  A0 00          ldy #0
00046Fr 1               @Byte:
00046Fr 1  B9 rr rr       lda TileColorTMS,y
000472r 1  8D 00 9C       sta VC_DATA
000475r 1  C8             iny
000476r 1  C0 20          cpy #32
000478r 1  D0 F5          bne @Byte
00047Ar 1  60             rts
00047Br 1               
00047Br 1               ; -----------------------------------------------------------------------------
00047Br 1               ;   DisableSprites — park every sprite off screen
00047Br 1               ;   The game uses none; $D0 in the first Y byte terminates the sprite list.
00047Br 1               ; -----------------------------------------------------------------------------
00047Br 1               DisableSprites:
00047Br 1  A9 00          lda #<VRAM_SPRITES
00047Dr 1  A2 1B          ldx #>VRAM_SPRITES
00047Fr 1  20 rr rr       jsr VdpSetWrite
000482r 1  A9 D0          lda #$D0
000484r 1  8D 00 9C       sta VC_DATA
000487r 1  60             rts
000488r 1               
000488r 1               ; -----------------------------------------------------------------------------
000488r 1               ;   HalWaitFrame — poll the VDP status register for vertical blank
000488r 1               ;   No raster interrupt here, and the status poll is self-syncing.
000488r 1               ; -----------------------------------------------------------------------------
000488r 1               HalWaitFrame:
000488r 1               @Wait:
000488r 1  AD 01 9C       lda VC_STATUS
00048Br 1  29 80          and #$80                      ; Bit 7 sets at the end of each frame
00048Dr 1  F0 F9          beq @Wait
00048Fr 1  60             rts
000490r 1               
000490r 1               ; -----------------------------------------------------------------------------
000490r 1               ;   HalPlotCell — In: A = tile, X = screen column, Y = screen row
000490r 1               ; -----------------------------------------------------------------------------
000490r 1               HalPlotCell:
000490r 1  48             pha
000491r 1  20 rr rr       jsr NameAddr                  ; Ptr1 = VRAM_NAMES + row * 32 + col
000494r 1  A5 rr          lda Ptr1
000496r 1  A6 rr          ldx Ptr1+1
000498r 1  20 rr rr       jsr VdpSetWrite
00049Br 1  68             pla
00049Cr 1  8D 00 9C       sta VC_DATA
00049Fr 1  60             rts
0004A0r 1               
0004A0r 1               ; -----------------------------------------------------------------------------
0004A0r 1               ;   NameAddr — In: X = column, Y = row.  Out: Ptr1 = name table address
0004A0r 1               ; -----------------------------------------------------------------------------
0004A0r 1               NameAddr:
0004A0r 1  98             tya
0004A1r 1  29 07          and #$07
0004A3r 1  0A             asl a                         ; (row & 7) * 32 lands in bits 5-7...
0004A4r 1  0A             asl a
0004A5r 1  0A             asl a
0004A6r 1  0A             asl a
0004A7r 1  0A             asl a
0004A8r 1  85 rr          sta Ptr1
0004AAr 1  8A             txa
0004ABr 1  05 rr          ora Ptr1                      ; ...leaving bits 0-4 free for the column
0004ADr 1  85 rr          sta Ptr1
0004AFr 1  98             tya
0004B0r 1  4A             lsr a                         ; row >> 3 is the page within the name table
0004B1r 1  4A             lsr a
0004B2r 1  4A             lsr a
0004B3r 1  18             clc
0004B4r 1  69 14          adc #>VRAM_NAMES
0004B6r 1  85 rr          sta Ptr1+1
0004B8r 1  60             rts
0004B9r 1               
0004B9r 1               ; -----------------------------------------------------------------------------
0004B9r 1               ;   HalBlitScreen — draw a full 768-byte name table image
0004B9r 1               ;   In: SrcPtr -> image. Ptr1 (colour) is ignored: this machine has no colour
0004B9r 1               ;   RAM, so the same image drives every platform's layout and only the palette
0004B9r 1               ;   mechanism differs.
0004B9r 1               ; -----------------------------------------------------------------------------
0004B9r 1               HalBlitScreen:
0004B9r 1  A9 00          lda #<VRAM_NAMES
0004BBr 1  A2 14          ldx #>VRAM_NAMES
0004BDr 1  20 rr rr       jsr VdpSetWrite
0004C0r 1               
0004C0r 1  A2 03          ldx #3                        ; 3 full pages
0004C2r 1  A0 00          ldy #0
0004C4r 1               @Byte:
0004C4r 1  B1 rr          lda (SrcPtr),y
0004C6r 1  8D 00 9C       sta VC_DATA
0004C9r 1  C8             iny
0004CAr 1  D0 F8          bne @Byte
0004CCr 1  E6 rr          inc SrcPtr+1
0004CEr 1  CA             dex
0004CFr 1  D0 F3          bne @Byte
0004D1r 1  60             rts
0004D2r 1               
0004D2r 1               ; -----------------------------------------------------------------------------
0004D2r 1               ;   HalReadInput — joystick 1, folded into the abstract active-high mask
0004D2r 1               ;   The port is active low, %RLDUYXBA (6502.inc). Keyboard is TODO: it arrives
0004D2r 1               ;   through the same VIA, so it reads from GPIO_PORTB alongside the stick.
0004D2r 1               ; -----------------------------------------------------------------------------
0004D2r 1               HalReadInput:
0004D2r 1  AD 0D 03       lda HW_PRESENT
0004D5r 1  29 20          and #HW_GPIO                  ; No GPIO card means a floating bus, not input
0004D7r 1  F0 4A          beq @None
0004D9r 1               
0004D9r 1  20 48 A0       jsr ReadJoystick1
0004DCr 1  49 FF          eor #$FF                      ; Active low in, active high out
0004DEr 1  85 rr          sta Tmp0
0004E0r 1               
0004E0r 1  A9 00          lda #0
0004E2r 1  85 rr          sta Tmp1
0004E4r 1               
0004E4r 1  A5 rr          lda Tmp0
0004E6r 1  29 10          and #%00010000                  ; U
0004E8r 1  F0 06          beq @NoUp
0004EAr 1  A5 rr          lda Tmp1
0004ECr 1  09 01          ora #INPUT_UP
0004EEr 1  85 rr          sta Tmp1
0004F0r 1               @NoUp:
0004F0r 1  A5 rr          lda Tmp0
0004F2r 1  29 20          and #%00100000                  ; D
0004F4r 1  F0 06          beq @NoDown
0004F6r 1  A5 rr          lda Tmp1
0004F8r 1  09 02          ora #INPUT_DOWN
0004FAr 1  85 rr          sta Tmp1
0004FCr 1               @NoDown:
0004FCr 1  A5 rr          lda Tmp0
0004FEr 1  29 40          and #%01000000                  ; L
000500r 1  F0 06          beq @NoLeft
000502r 1  A5 rr          lda Tmp1
000504r 1  09 04          ora #INPUT_LEFT
000506r 1  85 rr          sta Tmp1
000508r 1               @NoLeft:
000508r 1  A5 rr          lda Tmp0
00050Ar 1  29 80          and #%10000000                  ; R
00050Cr 1  F0 06          beq @NoRight
00050Er 1  A5 rr          lda Tmp1
000510r 1  09 08          ora #INPUT_RIGHT
000512r 1  85 rr          sta Tmp1
000514r 1               @NoRight:
000514r 1  A5 rr          lda Tmp0
000516r 1  29 01          and #%00000001                  ; A
000518r 1  F0 06          beq @NoFire
00051Ar 1  A5 rr          lda Tmp1
00051Cr 1  09 10          ora #INPUT_FIRE
00051Er 1  85 rr          sta Tmp1
000520r 1               @NoFire:
000520r 1               
000520r 1  A5 rr          lda Tmp1
000522r 1  60             rts
000523r 1               
000523r 1               @None:
000523r 1  A9 00          lda #0
000525r 1  60             rts
000526r 1               
000526r 1               ; -----------------------------------------------------------------------------
000526r 1               ;   HalDetectRegion — the TMS9918 here is 60 Hz
000526r 1               ; -----------------------------------------------------------------------------
000526r 1               HalDetectRegion:
000526r 1  A9 00          lda #0                        ; NTSC
000528r 1  60             rts
000529r 1               
000529r 1               ; -----------------------------------------------------------------------------
000529r 1               ;   HalSfx — TODO: SID at $9800. Shares a driver with the C64's $D400.
000529r 1               ; -----------------------------------------------------------------------------
000529r 1               HalSfx:
000529r 1  60             rts
00052Ar 1               
00052Ar 1               ; =============================================================================
00052Ar 1               ;   Data
00052Ar 1               ; =============================================================================
00052Ar 1               
00052Ar 1               .segment "RODATA"
000000r 1               
000000r 1               .include "../data/tilecolor-tms9918.inc"
000000r 2               ; =============================================================================
000000r 2               ;   tilecolor-tms9918.inc — TMS9918 Graphics I colour table
000000r 2               ; =============================================================================
000000r 2               ;   Generated from SPEC.md section 4.3 and Appendix A. Spec-derived data, not
000000r 2               ;   artwork: edit this file by hand, it is never overwritten by an editor
000000r 2               ;   export. Tile groups 16-31 (tiles 128-255) are the margin artwork and their
000000r 2               ;   colours are the artist's to choose.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               
000000r 2               ;   32 bytes -> VDP colour table. Each byte is (foreground << 4) | background;
000000r 2               ;   background is 1 (black) throughout, matching the backdrop register.
000000r 2               
000000r 2               TileColorTMS:
000000r 2  F1             .byte $F1                        ; group 0  tiles   0-7    UI / well frame        white
000001r 2  E1             .byte $E1                        ; group 1  tiles   8-15   UI accents             gray
000002r 2  F1             .byte $F1                        ; group 2  tiles  16-23   Font  0 1 2 3 4 5 6 7  white
000003r 2  F1             .byte $F1                        ; group 3  tiles  24-31   Font  8 9 A B C D E F  white
000004r 2  F1             .byte $F1                        ; group 4  tiles  32-39   Font  G H I J K L M N  white
000005r 2  F1             .byte $F1                        ; group 5  tiles  40-47   Font  O P Q R S T U V  white
000006r 2  F1             .byte $F1                        ; group 6  tiles  48-55   Font  W X Y Z . x ! -  white
000007r 2  F1             .byte $F1                        ; group 7  tiles  56-63   VFX                    white
000008r 2  81             .byte $81                        ; group 8  tiles  64-71   POTION 0  RED
000009r 2  B1             .byte $B1                        ; group 9  tiles  72-79   POTION 1  YELLOW
00000Ar 2  31             .byte $31                        ; group 10 tiles  80-87   POTION 2  GREEN
00000Br 2  71             .byte $71                        ; group 11 tiles  88-95   POTION 3  CYAN
00000Cr 2  51             .byte $51                        ; group 12 tiles  96-103  POTION 4  BLUE
00000Dr 2  D1             .byte $D1                        ; group 13 tiles 104-111  POTION 5  PURPLE
00000Er 2  F1             .byte $F1                        ; group 14 tiles 112-119  POTION 6  WILD / prism white
00000Fr 2  61             .byte $61                        ; group 15 tiles 120-127  Wall / stone           dark red
000010r 2  E1             .byte $E1                        ; group 16 tiles 128-135  artwork
000011r 2  61             .byte $61                        ; group 17 tiles 136-143  artwork
000012r 2  C1             .byte $C1                        ; group 18 tiles 144-151  artwork
000013r 2  A1             .byte $A1                        ; group 19 tiles 152-159  artwork
000014r 2  41             .byte $41                        ; group 20 tiles 160-167  artwork
000015r 2  21             .byte $21                        ; group 21 tiles 168-175  artwork
000016r 2  91             .byte $91                        ; group 22 tiles 176-183  artwork
000017r 2  71             .byte $71                        ; group 23 tiles 184-191  artwork
000018r 2  B1             .byte $B1                        ; group 24 tiles 192-199  artwork
000019r 2  51             .byte $51                        ; group 25 tiles 200-207  artwork
00001Ar 2  D1             .byte $D1                        ; group 26 tiles 208-215  artwork
00001Br 2  31             .byte $31                        ; group 27 tiles 216-223  artwork
00001Cr 2  81             .byte $81                        ; group 28 tiles 224-231  artwork
00001Dr 2  F1             .byte $F1                        ; group 29 tiles 232-239  artwork
00001Er 2  E1             .byte $E1                        ; group 30 tiles 240-247  artwork
00001Fr 2  F1             .byte $F1                        ; group 31 tiles 248-255  artwork
000020r 2               
000020r 1               .include "../src/strings.inc"
000020r 2               ; =============================================================================
000020r 2               ;   strings.inc — Wizards Lab, tile-encoded text
000020r 2               ; =============================================================================
000020r 2               ;   Strings are stored as TILE numbers, not ASCII, terminated by TEXT_END, so
000020r 2               ;   TextDraw is a copy with no translation at run time (see text.asm). The
000020r 2               ;   translation happens here instead, at assembly time, in TileStr.
000020r 2               ;
000020r 2               ;   Hand-authored, never overwritten by an editor export (D3). Included once,
000020r 2               ;   from each platform's RODATA segment.
000020r 2               ; =============================================================================
000020r 2               
000020r 2               ; -----------------------------------------------------------------------------
000020r 2               ;   TileChar / TileStr — ASCII source, tile bytes out
000020r 2               ;   The font is forty glyphs in one run from FONT_BASE:
000020r 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
000020r 2               ;   and a space is TILE_BLANK. Anything else is not in the tileset and is an
000020r 2               ;   assembly error rather than a wrong glyph on the screen.
000020r 2               ; -----------------------------------------------------------------------------
000020r 2               .macro TileChar c
000020r 2                 .if c = ' '
000020r 2                   .byte TILE_BLANK
000020r 2                 .elseif (c >= '0') .and (c <= '9')
000020r 2                   .byte FONT_DIGIT_0 + (c - '0')
000020r 2                 .elseif (c >= 'A') .and (c <= 'Z')
000020r 2                   .byte FONT_LETTER_A + (c - 'A')
000020r 2                 .elseif c = '.'
000020r 2                   .byte FONT_DOT
000020r 2                 .elseif c = 'x'
000020r 2                   .byte FONT_TIMES
000020r 2                 .elseif c = '!'
000020r 2                   .byte FONT_BANG
000020r 2                 .elseif c = '~'
000020r 2                   .byte FONT_TILDE
000020r 2                 .else
000020r 2                   .error "strings.inc: no tile for this character"
000020r 2                 .endif
000020r 2               .endmacro
000020r 2               
000020r 2               .macro TileStr s
000020r 2                 .repeat .strlen(s), I
000020r 2                   TileChar {.strat(s, I)}
000020r 2                 .endrepeat
000020r 2                 .byte TEXT_END
000020r 2               .endmacro
000020r 2               
000020r 2               ; -----------------------------------------------------------------------------
000020r 2               ;   Banners — SPEC 12.2, 13.3
000020r 2               ;   Even length, so (PANEL_W - length) / 2 centres exactly. The band is 18
000020r 2               ;   cells of backdrop between two shelf tiles either side, so a banner has 18
000020r 2               ;   to play with before it starts overwriting the artwork.
000020r 2               ;
000020r 2               ;   MsgPaused matches the play screen image byte for byte on purpose: the
000020r 2               ;   artwork ships with the band already reading `~~ PAUSED ~~` (see SPEC 12.1),
000020r 2               ;   so entering play clears the band and pausing draws this straight back.
000020r 2               ; -----------------------------------------------------------------------------
000020r 2               MsgPaused:
000020r 2  37 37 00 29    TileStr "~~ PAUSED ~~"                 ; 12 cells, centres at panel column 5
000024r 2  1A 2E 2C 1E  
000028r 2  1D 00 37 37  
00002Dr 2               
00002Dr 2               MsgLevelUp:
00002Dr 2  37 37 00 25    TileStr "~~ LEVEL UP ~~"               ; 14 cells, centres at panel column 4
000031r 2  1E 2F 1E 25  
000035r 2  00 2E 29 00  
00003Cr 2               
00003Cr 1               
00003Cr 1               ; --- PLACEHOLDER ART — replace via TMS9918-EDITOR, see data/README.md --------
00003Cr 1  00 00 00 00  TitleScreen:  .incbin "../data/screen-title-ac6502.bin"
000040r 1  00 00 00 00  
000044r 1  00 00 00 00  
00033Cr 1  7F 7F 7F 7F  PlayScreen:   .incbin "../data/screen-play-ac6502.bin"
000340r 1  7F 7E 7E 7E  
000344r 1  7E 7E 7E 7E  
00063Cr 1               TitleColor    = TitleScreen      ; No colour RAM on this machine
00063Cr 1               PlayColor     = PlayScreen
00063Cr 1               
00063Cr 1               .segment "TILES"
000000r 1               
000000r 1  00 00 00 00  Tileset:      .incbin "../data/tileset.bin"
000004r 1  00 00 00 00  
000008r 1  00 00 7E AB  
000800r 1               
000800r 1               ; =============================================================================
000800r 1               ;   Interrupt trampolines and CPU vectors
000800r 1               ; =============================================================================
000800r 1               ;   KernalInit has already pointed the RAM vectors at the default handlers, so
000800r 1               ;   bouncing through them keeps keyboard and serial input alive without this
000800r 1               ;   cartridge writing a handler of its own.
000800r 1               
000800r 1               .segment "CODE"
00052Ar 1               
00052Ar 1               IrqTrampoline:
00052Ar 1  6C 00 03       jmp (IRQ_PTR)
00052Dr 1               
00052Dr 1               NmiTrampoline:
00052Dr 1  6C 04 03       jmp (NMI_PTR)
000530r 1               
000530r 1               .segment "VECTORS"
000000r 1               
000000r 1  rr rr        .word   NmiTrampoline           ; NMI
000002r 1  rr rr        .word   CartReset               ; RESET — the cartridge entry point
000004r 1  rr rr        .word   IrqTrampoline           ; IRQ
000004r 1               
