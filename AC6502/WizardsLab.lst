000020r 1               .include "../src/tables.inc"
000020r 2               ; =============================================================================
000020r 2               ;   tables.inc — Wizards Lab, spec-derived lookup tables
000020r 2               ; =============================================================================
000020r 2               ;   Straight out of SPEC.md sections 5.3, 9 and 10. Hand-authored, never
000020r 2               ;   overwritten by an editor export. Included once, from the RODATA segment.
000020r 2               ;
000020r 2               ;   Score values above 99 do not fit in a byte, so every scoring table is a
000020r 2               ;   pair of parallel arrays — low BCD byte and high BCD byte — indexed by the
000020r 2               ;   same value.
000020r 2               ; =============================================================================
000020r 2               
000020r 2               ; --- Gravity, frames per row (SPEC 10.2) -------------------------------------
000020r 2               ;   Indexed by (level - 1), clamped to LEVEL_SPEED_CAP - 1.
000020r 2               ;   PAL is round(NTSC * 50/60), so wall-clock speed matches across regions.
000020r 2               
000020r 2               SpeedNTSC:
000020r 2  30 2B 26 22    .byte  48, 43, 38, 34, 30, 26, 23, 20   ; levels  1- 8   0.800s .. 0.333s
000024r 2  1E 1A 17 14  
000028r 2  11 0F 0D 0B    .byte  17, 15, 13, 11,  9,  8,  7,  6   ; levels  9-16   0.283s .. 0.100s
00002Cr 2  09 08 07 06  
000030r 2               
000030r 2               SpeedPAL:
000030r 2  28 24 20 1C    .byte  40, 36, 32, 28, 25, 22, 19, 17   ; levels  1- 8   0.800s .. 0.340s
000034r 2  19 16 13 11  
000038r 2  0E 0D 0B 09    .byte  14, 13, 11,  9,  8,  7,  6,  5   ; levels  9-16   0.280s .. 0.100s
00003Cr 2  08 07 06 05  
000040r 2               
000040r 2               ; --- Frame counts that differ by region (SPEC 5.6, 11.3, 14) -----------------
000040r 2               ;   Indexed by Region: 0 = NTSC, 1 = PAL. PAL is round(NTSC * 50/60) wherever
000040r 2               ;   the difference is worth a frame, so a piece takes the same number of
000040r 2               ;   SECONDS to lock on both machines rather than the same number of frames.
000040r 2               ;
000040r 2               ;   Two bytes each rather than one table of pairs, because every read is
000040r 2               ;   `ldx Region / lda Name,x` and a pair table would need the index doubled.
000040r 2               
000040r 2               LockDelay:                              ; SPEC 5.6
000040r 2  10 0E          .byte 16, 14
000042r 2               AreDelay:                               ; Entry delay after a cascade settles
000042r 2  0C 0A          .byte 12, 10
000044r 2               DasInitial:                             ; SPEC 11.3 — first repeat
000044r 2  0C 0A          .byte 12, 10
000046r 2               DasRepeat:                              ; ...and every one after it
000046r 2  04 03          .byte  4,  3
000048r 2               SoftDropRate:                           ; Frames per row while DOWN is held.
000048r 2  03 02          .byte  3,  2                          ;   Never used when gravity is faster.
00004Ar 2               BlinkHalf:                              ; SPEC 14 — half of the 30 / 25 frame
00004Ar 2  0F 0D          .byte 15, 13                          ;   blink period, which is what a
00004Cr 2                                                       ;   blinking field actually counts
00004Cr 2               GlowFrames:                             ; SPEC 14 — the GLOW window: the match
00004Cr 2  06 05          .byte  6,  5                          ;   glow and the bolt's beams
00004Er 2               FlashFrames:                            ; ...and what the window grows to when
00004Er 2  08 07          .byte  8,  7                          ;   a fireball fired, because its flash
000050r 2                                                       ;   is the longer of the two and both
000050r 2                                                       ;   are showing at once (constants.inc)
000050r 2               BannerFrames:                           ; SPEC 14 — how long LEVEL UP and
000050r 2  2D 26          .byte 45, 38                          ;   CHAIN xN stay in the message band
000052r 2               SecondFrames:                           ; One second, which is the unit the
000052r 2  3C 32          .byte 60, 50                          ;   game-over timeout is counted in
000054r 2                                                       ;   (SPEC 13.4). The only entry here
000054r 2                                                       ;   that is not a duration out of
000054r 2                                                       ;   SPEC 14 but the frame rate itself
000054r 2               
000054r 2               ; --- The two removal animations (SPEC 14, Appendix A.3) ----------------------
000054r 2               ;   One ring, run in both directions. Indexed by AnimStep, which advances every
000054r 2               ;   VFX_FRAMES frames.
000054r 2               ;
000054r 2               ;   Potions, reagents, the bomb blast and the star all open OUTWARD and are
000054r 2               ;   gone in SHATTER_STEPS frames; the fourth entry only ever comes up when a
000054r 2               ;   marked prism is blipping out beside them and holding the window open, and
000054r 2               ;   it blanks the cell rather than leaving the last ring frame sitting there
000054r 2               ;   for four more frames.
000054r 2               
000054r 2               VfxShatter:
000054r 2  38 39 3A 00    .byte VFX_REMOVE1, VFX_REMOVE2, VFX_REMOVE3, TILE_EMPTY
000058r 2               
000058r 2               ;   The prism closes INWARD, and does not pass through the glow (SPEC A.3 —
000058r 2               ;   group 14 has no glyph +6). Five frames, so a step that clears one runs
000058r 2               ;   BLIP_STEPS rather than SHATTER_STEPS.
000058r 2               
000058r 2               VfxBlip:
000058r 2  74 75 39 38    .byte PRISM_BLIP, PRISM_BLIP + 1, VFX_REMOVE2, VFX_REMOVE1, FONT_DOT
00005Cr 2  34           
00005Dr 2               
00005Dr 2               ; --- Per-tile value for MATCH removals (SPEC 9.1) ----------------------------
00005Dr 2               ;   Indexed by (chain - 1), clamped to 7.   20 50 100 200 300 400 500 600
00005Dr 2               TileValueLo:
00005Dr 2  20 50 00 00    .byte $20, $50, $00, $00, $00, $00, $00, $00
000061r 2  00 00 00 00  
000065r 2               TileValueHi:
000065r 2  00 00 01 02    .byte $00, $00, $01, $02, $03, $04, $05, $06
000069r 2  03 04 05 06  
00006Dr 2               
00006Dr 2               ; --- Per-tile value for EFFECT removals (SPEC 9.2) ---------------------------
00006Dr 2               ;   Indexed by (chain - 1), clamped to 7.   30 60 120 240 350 450 550 650
00006Dr 2               EffectValueLo:
00006Dr 2  30 60 20 40    .byte $30, $60, $20, $40, $50, $50, $50, $50
000071r 2  50 50 50 50  
000075r 2               EffectValueHi:
000075r 2  00 00 01 02    .byte $00, $00, $01, $02, $03, $04, $05, $06
000079r 2  03 04 05 06  
00007Dr 2               
00007Dr 2               ; --- Run length bonus (SPEC 9.3) ---------------------------------------------
00007Dr 2               ;   Indexed by (length - 3), clamped to 4.  0 100 300 600 1000
00007Dr 2               LengthBonusLo:
00007Dr 2  00 00 00 00    .byte $00, $00, $00, $00, $00
000081r 2  00           
000082r 2               LengthBonusHi:
000082r 2  00 01 03 06    .byte $00, $01, $03, $06, $10
000086r 2  10           
000087r 2               
000087r 2               ; --- Simultaneous run bonus (SPEC 9.4) ---------------------------------------
000087r 2               ;   Indexed by (runs - 1), clamped to 4.    0 200 500 1000 2000
000087r 2               MultiBonusLo:
000087r 2  00 00 00 00    .byte $00, $00, $00, $00, $00
00008Br 2  00           
00008Cr 2               MultiBonusHi:
00008Cr 2  00 02 05 10    .byte $00, $02, $05, $10, $20
000090r 2  20           
000091r 2               
000091r 2               ; --- Level -> reagent probability band (SPEC 5.3) ----------------------------
000091r 2               ;   Indexed by (level - 1), clamped to 15. Bands are 1-3, 4-6, 7-9, 10-12, 13+.
000091r 2               LevelBand:
000091r 2  00 00 00 01    .byte 0, 0, 0, 1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 4
000095r 2  01 01 02 02  
000099r 2  02 03 03 03  
0000A1r 2               
0000A1r 2               ; --- Chance a piece carries a reagent, out of 256 (SPEC 5.3) -----------------
0000A1r 2               ;   Indexed by band.                        15%  22%  27%  32%  36%
0000A1r 2               PSpecial:
0000A1r 2  26 38 45 52    .byte  38,  56,  69,  82,  92
0000A5r 2  5C           
0000A6r 2               
0000A6r 2               ; --- Reagent type, cumulative thresholds out of 256 (SPEC 5.3) ---------------
0000A6r 2               ;   Four thresholds per band; a roll at or above the last one is a Prism.
0000A6r 2               ;       roll <  [0] -> Fireball
0000A6r 2               ;       roll <  [1] -> Bolt
0000A6r 2               ;       roll <  [2] -> Bomb
0000A6r 2               ;       roll <  [3] -> Star
0000A6r 2               ;       else        -> Prism
0000A6r 2               ReagentThresholds:
0000A6r 2  4D 8A C3 EC    .byte  77, 138, 195, 236             ; band 0   levels  1-3
0000AAr 2  4D 8D C0 EE    .byte  77, 141, 192, 238             ; band 1   levels  4-6
0000AEr 2  52 92 C5 EE    .byte  82, 146, 197, 238             ; band 2   levels  7-9
0000B2r 2  4F 8D C3 EE    .byte  79, 141, 195, 238             ; band 3   levels 10-12
0000B6r 2  4F 8F C7 F0    .byte  79, 143, 199, 240             ; band 4   levels 13+
0000BAr 2               
0000BAr 2               ; --- Reagent trigger bonuses, indexed by glyph (SPEC 9.5) --------------------
0000BAr 2               ;   Glyph 0 potion and 4 star award nothing here (the star multiplies instead).
0000BAr 2               TriggerBonusLo:
0000BAr 2  00 00 00 00    .byte $00, $00, $00, $00, $00, $00, $00, $00
0000BEr 2  00 00 00 00  
0000C2r 2               TriggerBonusHi:
0000C2r 2  00 05 03 03    .byte $00, $05, $03, $03, $00, $00, $00, $00
0000C6r 2  00 00 00 00  
0000CAr 2               
0000CAr 1               .include "../src/strings.inc"
0000CAr 2               ; =============================================================================
0000CAr 2               ;   strings.inc — Wizards Lab, tile-encoded text
0000CAr 2               ; =============================================================================
0000CAr 2               ;   Strings are stored as TILE numbers, not ASCII, terminated by TEXT_END, so
0000CAr 2               ;   TextDraw is a copy with no translation at run time (see text.asm). The
0000CAr 2               ;   translation happens here instead, at assembly time, in TileStr.
0000CAr 2               ;
0000CAr 2               ;   Hand-authored, never overwritten by an editor export (D3). Included once,
0000CAr 2               ;   from each platform's RODATA segment.
0000CAr 2               ; =============================================================================
0000CAr 2               
0000CAr 2               ; -----------------------------------------------------------------------------
0000CAr 2               ;   TileChar / TileStr — ASCII source, tile bytes out
0000CAr 2               ;   The font is forty glyphs in one run from FONT_BASE:
0000CAr 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
0000CAr 2               ;   and a space is TILE_BLANK. Anything else is not in the tileset and is an
0000CAr 2               ;   assembly error rather than a wrong glyph on the screen.
0000CAr 2               ; -----------------------------------------------------------------------------
0000CAr 2               .macro TileChar c
0000CAr 2                 .if c = ' '
0000CAr 2                   .byte TILE_BLANK
0000CAr 2                 .elseif (c >= '0') .and (c <= '9')
0000CAr 2                   .byte FONT_DIGIT_0 + (c - '0')
0000CAr 2                 .elseif (c >= 'A') .and (c <= 'Z')
0000CAr 2                   .byte FONT_LETTER_A + (c - 'A')
0000CAr 2                 .elseif c = '.'
0000CAr 2                   .byte FONT_DOT
0000CAr 2                 .elseif c = 'x'
0000CAr 2                   .byte FONT_TIMES
0000CAr 2                 .elseif c = '!'
0000CAr 2                   .byte FONT_BANG
0000CAr 2                 .elseif c = '~'
0000CAr 2                   .byte FONT_TILDE
0000CAr 2                 .else
0000CAr 2                   .error "strings.inc: no tile for this character"
0000CAr 2                 .endif
0000CAr 2               .endmacro
0000CAr 2               
0000CAr 2               .macro TileStr s
0000CAr 2                 .repeat .strlen(s), I
0000CAr 2                   TileChar {.strat(s, I)}
0000CAr 2                 .endrepeat
0000CAr 2                 .byte TEXT_END
0000CAr 2               .endmacro
0000CAr 2               
0000CAr 2               ; -----------------------------------------------------------------------------
0000CAr 2               ;   Banners — SPEC 12.2, 13.3
0000CAr 2               ;   Even length, so (PANEL_W - length) / 2 centres exactly. The band is 18
0000CAr 2               ;   cells of backdrop between two shelf tiles either side, so a banner has 18
0000CAr 2               ;   to play with before it starts overwriting the artwork.
0000CAr 2               ;
0000CAr 2               ;   MsgPaused matches the play screen image byte for byte on purpose: the
0000CAr 2               ;   artwork ships with the band already reading `~~ PAUSED ~~` (see SPEC 12.1),
0000CAr 2               ;   so entering play clears the band and pausing draws this straight back.
0000CAr 2               ; -----------------------------------------------------------------------------
0000CAr 2               MsgPaused:
0000CAr 2  37 37 00 29    TileStr "~~ PAUSED ~~"                 ; 12 cells, centres at panel column 5
0000CEr 2  1A 2E 2C 1E  
0000D2r 2  1D 00 37 37  
0000D7r 2               
0000D7r 2               MsgLevelUp:
0000D7r 2  37 37 00 25    TileStr "~~ LEVEL UP ~~"               ; 14 cells, centres at panel column 4
0000DBr 2  1E 2F 1E 25  
0000DFr 2  00 2E 29 00  
0000E6r 2               
0000E6r 2               ; `GAME OVER` is nine characters, so a symmetric ornament around it is always
0000E6r 2               ; an ODD length and would sit half a cell left of centre. The bang makes it
0000E6r 2               ; even and is the reason it is there; SPEC 13.4 records the wording.
0000E6r 2               MsgGameOver:
0000E6r 2  37 37 00 20    TileStr "~~ GAME OVER! ~~"             ; 16 cells, centres at panel column 3
0000EAr 2  1A 26 1E 00  
0000EEr 2  28 2F 1E 2B  
0000F7r 2               
0000F7r 2               ; The chain banner carries a number, and TextDraw copies bytes rather than
0000F7r 2               ; formatting them, so the digit is a placeholder that CascadeSettle overwrites
0000F7r 2               ; with one RenderMark at CHAIN_DIGIT_X (constants.inc). Keeping the length at
0000F7r 2               ; MSG_CHAIN_LEN is what makes that column a constant instead of a measurement.
0000F7r 2               MsgChain:
0000F7r 2  37 37 00 1C    TileStr "~~ CHAIN x0 ~~"               ; 14 cells; the `0` is panel column 14
0000FBr 2  21 1A 22 27  
0000FFr 2  00 35 10 00  
000106r 2               
000106r 2               ; -----------------------------------------------------------------------------
000106r 2               ;   The title screen's prompt (SPEC 13.1)
000106r 2               ;   Not a banner: it is ten cells of the DRAWN title image, and the only reason
000106r 2               ;   the string exists at all is that blinking it means putting it back. It must
000106r 2               ;   match data/screen-title-*.bin at PROMPT_X, PROMPT_Y byte for byte, or the
000106r 2               ;   first blink would redraw the screen slightly differently from the way the
000106r 2               ;   artist drew it.
000106r 2               ; -----------------------------------------------------------------------------
000106r 2               MsgPressFire:
000106r 2  29 2B 1E 2C    TileStr "PRESS FIRE"                   ; PROMPT_LEN cells (constants.inc)
00010Ar 2  2C 00 1F 22  
00010Er 2  2B 1E FF     
000111r 2               
000111r 1               
000111r 1               ; --- PLACEHOLDER ART — replace via TMS9918-EDITOR, see data/README.md --------
000111r 1  00 00 00 00  TitleScreen:  .incbin "../data/screen-title-ac6502.bin"
000115r 1  00 00 00 00  
000119r 1  00 00 00 00  
000411r 1  7F 7F 7F 7F  PlayScreen:   .incbin "../data/screen-play-ac6502.bin"
000415r 1  7F 7E 7E 7E  
000419r 1  7E 7E 7E 7E  
000711r 1               TitleColor    = TitleScreen      ; No colour RAM on this machine
000711r 1               PlayColor     = PlayScreen
000711r 1               
000711r 1               .segment "TILES"
000000r 1               
000000r 1  00 00 00 00  Tileset:      .incbin "../data/tileset.bin"
000004r 1  00 00 00 00  
000008r 1  00 00 7E AB  
000800r 1               
000800r 1               ; =============================================================================
000800r 1               ;   Interrupt trampolines and CPU vectors
000800r 1               ; =============================================================================
000800r 1               ;   KernalInit has already pointed the RAM vectors at the default handlers, so
000800r 1               ;   bouncing through them keeps keyboard and serial input alive without this
000800r 1               ;   cartridge writing a handler of its own.
000800r 1               
000800r 1               .segment "CODE"
0012F2r 1               
0012F2r 1               IrqTrampoline:
0012F2r 1  6C 00 03       jmp (IRQ_PTR)
0012F5r 1               
0012F5r 1               NmiTrampoline:
0012F5r 1  6C 04 03       jmp (NMI_PTR)
0012F8r 1               
0012F8r 1               .segment "VECTORS"
000000r 1               
000000r 1  rr rr        .word   NmiTrampoline           ; NMI
000002r 1  rr rr        .word   CartReset               ; RESET — the cartridge entry point
000004r 1  rr rr        .word   IrqTrampoline           ; IRQ
000004r 1               
