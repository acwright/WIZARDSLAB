000000r 1               .setcpu "65C02"
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Wizards Lab — AC6502
000000r 1               ; =============================================================================
000000r 1               ;   A 16 K cartridge for the A.C. Wright 6502, running the TMS9918 in
000000r 1               ;   Graphics Mode I: 32 x 24 cells of 8 x 8 pixels, 256 patterns, and colour
000000r 1               ;   assigned one foreground/background pair per group of eight patterns.
000000r 1               ;
000000r 1               ;   That colour model is the strictest of the three targets, so it is the one
000000r 1               ;   the whole tileset is laid out against — each potion colour owns one group,
000000r 1               ;   and every glyph of that colour lives inside it. See SPEC.md section 4.
000000r 1               ;
000000r 1               ;   This file is the platform half of the contract in src/hal.inc. Everything
000000r 1               ;   it includes from src/ is shared, byte for byte, with the VIC-20 and C64.
000000r 1               ;
000000r 1               ;   Built with AC6502-16K.cfg.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               .include "../include/ac6502.inc"
000000r 2               ; =============================================================================
000000r 2               ;   6502.inc — External include file for the 6502 system
000000r 2               ; =============================================================================
000000r 2               ;
000000r 2               ;   CPU:       WDC 65C02S
000000r 2               ;   BIOS:      v1.5
000000r 2               ;   Assembler: ca65 (cc65 toolchain) — uses := for absolute symbols
000000r 2               ;
000000r 2               ;   Include this file in external projects to access Kernal routines,
000000r 2               ;   IO hardware registers, system variables, and useful constants.
000000r 2               ;
000000r 2               ;   MEMORY MAP
000000r 2               ;   ----------
000000r 2               ;   $0000-$0003   Zero Page: System pointers (see below)
000000r 2               ;   $0004-$0023   Zero Page: Reserved by BASIC interpreter
000000r 2               ;   $0024-$0039   Zero Page: System scratch (CF, serial, delay, monitor, XModem)
000000r 2               ;   $003A-$00FF   Zero Page: Free for user programs
000000r 2               ;   $0100-$01FF   CPU Stack
000000r 2               ;   $0200-$02FF   Input Buffer (ring buffer, managed by Kernal)
000000r 2               ;   $0300-$03FF   Kernal Variables (vectors, cursor, HW flags, etc.)
000000r 2               ;   $0400-$05FF   User Variables / BASIC workspace
000000r 2               ;   $0600-$07FF   FS sector buffer (clobbered by any FS/St routine call)
000000r 2               ;   $0800-$7FFF   Program RAM (30 KB — load address for user code)
000000r 2               ;   $8000-$83FF   IO 1: Banked RAM Low  (256 × ~1 KB banks)
000000r 2               ;   $8400-$87FF   IO 2: Banked RAM High (256 × ~1 KB banks)
000000r 2               ;   $8800-$881F   IO 3: RTC (DS1511Y)
000000r 2               ;   $8C00-$8C07   IO 4: Storage (CompactFlash, 8-bit IDE)
000000r 2               ;   $9000-$9003   IO 5: Serial (R65C51 ACIA)
000000r 2               ;   $9400-$940F   IO 6: GPIO (65C22 VIA — keyboard & joysticks)
000000r 2               ;   $9800-$981C   IO 7: Sound (SID / ARMSID)
000000r 2               ;   $9C00-$9C01   IO 8: Video (TMS9918 / pico9918)
000000r 2               ;   $A000-$A0FF   Kernal Jump Table (stable entry points)
000000r 2               ;   $A100-$B7FF   Kernal Implementation
000000r 2               ;   $B800-$BFFF   Character Set ROM (2 KB, 256 × 8-byte patterns)
000000r 2               ;   $C000-$EDFF   BASIC Interpreter
000000r 2               ;   $EE00-$FEFF   Machine Code Monitor
000000r 2               ;   $FF00-$FFF9   Wozmon (mini monitor)
000000r 2               ;   $FFFA-$FFFF   CPU Vectors (NMI, RESET, IRQ)
000000r 2               ;
000000r 2               ;   BOOT SEQUENCE
000000r 2               ;   -------------
000000r 2               ;   On RESET the BIOS probes all eight IO slots, initializes detected
000000r 2               ;   hardware, and auto-selects video or serial console.  If neither is
000000r 2               ;   found, IO_MODE is left unchanged (no halt — cartridges with their
000000r 2               ;   own display hardware can still boot).  A startup beep plays (if SID
000000r 2               ;   is present) for audible feedback, then BOOT_VECTOR ($035B) is
000000r 2               ;   checked — if non-zero, execution jumps there (cartridge takeover).
000000r 2               ;   Otherwise a console check halts if no video/serial is found, then
000000r 2               ;   the splash screen and boot menu are displayed.  ENTER launches
000000r 2               ;   BASIC; ESC enters the Monitor.  A 5-second timeout auto-boots BASIC.
000000r 2               ;   The splash is drawn on whichever console is active — centred on the
000000r 2               ;   40-column screen, or left-aligned as plain text over serial.
000000r 2               ;
000000r 2               ;   GRACEFUL DEGRADATION
000000r 2               ;   --------------------
000000r 2               ;   Every Kernal routine that drives a card checks HW_PRESENT first, so
000000r 2               ;   a call on a machine without that card is safe rather than a crash.
000000r 2               ;   Routines with nothing to report back return silently (video and SID);
000000r 2               ;   routines that move data report failure in the carry (CompactFlash).
000000r 2               ;   The per-routine notes below say which behaviour each one has.
000000r 2               ;
000000r 2               ;   CARTRIDGE SUPPORT
000000r 2               ;   -----------------
000000r 2               ;   Cartridges overlay $C000-$FFFF (BASIC, Monitor, Wozmon, vectors).
000000r 2               ;   The Kernal ($A000-$B7FF) and character set ($B800-$BFFF) remain
000000r 2               ;   accessible.  Use KernalInit ($A078) to initialize all hardware and
000000r 2               ;   return via RTS — interrupts are left disabled so the cart can set
000000r 2               ;   up its own handlers first.  See usage patterns in the BIOS README.
000000r 2               ;
000000r 2               ;   IO_MODE
000000r 2               ;   -------
000000r 2               ;   Bit 0 of IO_MODE selects the console output device:
000000r 2               ;     0 = Video (TMS9918)    1 = Serial (R65C51)
000000r 2               ;   Chrout ($A000) dispatches automatically based on IO_MODE.
000000r 2               ;   Use SetIOMode / GetIOMode to change or query the active console.
000000r 2               ;
000000r 2               ;   CALLING CONVENTION
000000r 2               ;   ------------------
000000r 2               ;   Kernal routines are called via JSR to the jump table addresses below.
000000r 2               ;   Parameters are passed in A, X, Y, and/or zero-page pointers as
000000r 2               ;   documented per routine.  Carry flag is used for success/error returns
000000r 2               ;   (C=0 success, C=1 error) where noted.
000000r 2               ;
000000r 2               ;   HW_PRESENT BITMASK
000000r 2               ;   -------------------
000000r 2               ;   After boot, HW_PRESENT ($030D) contains a bitmask of detected hardware.
000000r 2               ;   Test individual bits before calling hardware-specific routines.
000000r 2               ;   Example:
000000r 2               ;     lda HW_PRESENT
000000r 2               ;     and #HW_VID          ; Is video card present?
000000r 2               ;     beq @NoVideo         ; Skip if not
000000r 2               ;
000000r 2               ; =============================================================================
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 1: ZERO PAGE POINTERS
000000r 2               ; =============================================================================
000000r 2               ; These zero page locations are used by the Kernal.  External programs may
000000r 2               ; use STR_PTR and CF_BUF_PTR/CF_LBA as parameters to Kernal calls.
000000r 2               ; Locations $3A-$FF are free for user programs.
000000r 2               
000000r 2               STR_PTR             := $02               ; 2 bytes — String pointer (used by FsLoadFile, FsSaveFile, FsDeleteFile, etc.)
000000r 2               CF_BUF_PTR          := $24               ; 2 bytes — CF sector data buffer pointer
000000r 2               CF_LBA              := $26               ; 4 bytes — CF 28-bit LBA address (little-endian)
000000r 2               XFER_PTR            := $2A               ; 2 bytes — XModem transfer data pointer (source for XModemSave, dest for XModemLoad)
000000r 2               
000000r 2               ; Safe zero page range for user programs:
000000r 2               ; $3A-$FF (198 bytes free)
000000r 2               ; Note: $2E-$35 belong to the Monitor and $36-$39 to XModemLoad/XModemSave;
000000r 2               ;       neither range survives a call into those routines
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 2: SYSTEM VARIABLES ($0300-$03FF)
000000r 2               ; =============================================================================
000000r 2               
000000r 2               IRQ_PTR             := $0300             ; 2 bytes — IRQ handler vector (writable; default: internal Irq handler)
000000r 2               BRK_PTR             := $0302             ; 2 bytes — BRK handler vector (writable; default: enters Monitor)
000000r 2               NMI_PTR             := $0304             ; 2 bytes — NMI handler vector (writable; default: RTI)
000000r 2               
000000r 2               IO_MODE             := $0306             ; 1 byte  — Console output mode (bit 0: 0=video, 1=serial)
000000r 2               VID_CURSOR_X        := $0307             ; 1 byte  — Video cursor column (0-39)
000000r 2               VID_CURSOR_Y        := $0308             ; 1 byte  — Video cursor row (0-23)
000000r 2               
000000r 2               HW_PRESENT          := $030D             ; 1 byte  — Hardware present bitmask (set during boot probe)
000000r 2               CF_DISK             := $030F             ; 1 byte  — Current CF disk bank (0–255); base LBA = CF_DISK × FS_DISK_SECTORS; reset to 0 on boot
000000r 2               
000000r 2               ; HW_PRESENT bit definitions (bit order matches IO slot numbers):
000000r 2               HW_RAM_L            = %00000001          ; Bit 0: RAM card low  (IO 1, $8000-$83FF)
000000r 2               HW_RAM_H            = %00000010          ; Bit 1: RAM card high (IO 2, $8400-$87FF)
000000r 2               HW_RTC              = %00000100          ; Bit 2: RTC card      (IO 3, DS1511Y)
000000r 2               HW_CF               = %00001000          ; Bit 3: Storage card   (IO 4, CompactFlash)
000000r 2               HW_SC               = %00010000          ; Bit 4: Serial card    (IO 5, R65C51)
000000r 2               HW_GPIO             = %00100000          ; Bit 5: GPIO card      (IO 6, 65C22 VIA — keyboard/joysticks)
000000r 2               HW_SID              = %01000000          ; Bit 6: Sound card     (IO 7, SID/ARMSID)
000000r 2               HW_VID              = %10000000          ; Bit 7: Video card     (IO 8, TMS9918/pico9918)
000000r 2               
000000r 2               ; BRK register save area (populated by the BRK handler before entering Monitor):
000000r 2               BRK_P               := $0310             ; Saved processor status (P)
000000r 2               BRK_PCL             := $0311             ; Saved PC low byte (points to BRK instruction + 2)
000000r 2               BRK_PCH             := $0312             ; Saved PC high byte
000000r 2               BRK_A               := $0313             ; Saved accumulator
000000r 2               BRK_X               := $0314             ; Saved X register
000000r 2               BRK_Y               := $0315             ; Saved Y register
000000r 2               BRK_SP              := $0316             ; Saved stack pointer
000000r 2               
000000r 2               XFER_REMAIN         := $0317             ; 2 bytes — XModem byte count (output from XModemLoad; input to XModemSave)
000000r 2               XFER_IO_SAVE        := $0319             ; 1 byte  — Saved IO_MODE during XModem transfer (internal use)
000000r 2               
000000r 2               ; RTC scratch (used by RtcWriteDate to pass century):
000000r 2               RTC_BUF_CENT        := $030B             ; Century value for RtcReadDate / RtcWriteDate
000000r 2               
000000r 2               ; Cartridge / boot redirect vector:
000000r 2               BOOT_VECTOR         := $035B             ; 2 bytes — Boot redirect address (0=normal boot)
000000r 2                                                        ;   Set after KernalInit to redirect Reset flow
000000r 2                                                        ;   KernalInit zeroes this; write after init returns
000000r 2               FS_IO_ADDR          := $037F             ; 2 bytes — Load/save target address for FsLoadFileAddr / FsSaveFileAddr
000000r 2               FS_FILE_SIZE        := $034A             ; 2 bytes — File size in bytes (set by caller for FsSaveFileAddr; populated by FsLoadFileAddr)
000000r 2               
000000r 2               ; Program image handoff (v1.3):
000000r 2               PRG_IMAGE_END       := $038E             ; 2 bytes — End address of a program image placed at
000000r 2                                                        ;   PROGRAM_START by a loader running outside BASIC
000000r 2                                                        ;   (e.g. the Monitor's L command); 0 = none.
000000r 2                                                        ;   KernalInit zeroes it; BASIC consumes and re-zeroes it
000000r 2                                                        ;   on entry, so a stale value is never acted on twice.
000000r 2                                                        ;   A loader that drops a .prg at $0800 and then hands
000000r 2                                                        ;   off to BASIC should write the end address here so
000000r 2                                                        ;   the attached machine code survives LOAD/SAVE.
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 3: KEY MEMORY LOCATIONS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               INPUT_BUFFER        := $0200             ; $0200-$02FF — 256-byte ring buffer (keyboard/serial input)
000000r 2               PROGRAM_START       := $0800             ; User programs and BASIC programs load here
000000r 2               ;                                        ; Program space extends to $7FFF (30 KB)
000000r 2               MEMORY_TOP          := $8000             ; First address past usable RAM (IO space starts here)
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 4: KERNAL JUMP TABLE ($A000-$A0FF)
000000r 2               ; =============================================================================
000000r 2               ; All entry points are stable 3-byte JMP instructions.  Call via JSR.
000000r 2               ; Unimplemented slots return immediately (RTS).
000000r 2               
000000r 2               ; --- Character I/O ---
000000r 2               Chrout              := $A000             ; Output character (dispatched by IO_MODE)
000000r 2                                                        ;   In: A = character
000000r 2                                                        ;   Preserves: A, X, Y
000000r 2                                                        ;   Handles CR ($0D), LF ($0A), BS ($08), BEL ($07) in video mode
000000r 2               
000000r 2               Chrin               := $A003             ; Input character from buffer (non-blocking poll)
000000r 2                                                        ;   Out: A = character, C=1 if char available, C=0 if not
000000r 2                                                        ;   Caller must loop until C=1 for blocking behavior
000000r 2                                                        ;   Echoes character via Chrout
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               WriteBuffer         := $A006             ; Write byte to input ring buffer
000000r 2                                                        ;   In: A = byte to write
000000r 2                                                        ;   Modifies: X
000000r 2               
000000r 2               ReadBuffer          := $A009             ; Read byte from input ring buffer
000000r 2                                                        ;   Out: A = byte read
000000r 2                                                        ;   Modifies: X, A
000000r 2               
000000r 2               BufferSize          := $A00C             ; Get number of unread bytes in input buffer
000000r 2                                                        ;   Out: A = count
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- IO Mode ---
000000r 2               SetIOMode           := $A00F             ; Set IO_MODE
000000r 2                                                        ;   In: A = mode (bit 0: 0=video, 1=serial)
000000r 2               
000000r 2               GetIOMode           := $A012             ; Get IO_MODE
000000r 2                                                        ;   Out: A = current IO_MODE
000000r 2               
000000r 2               ; --- Video (TMS9918 / pico9918) ---
000000r 2               InitVideo           := $A015             ; Initialize TMS9918 (text mode, 40×24)
000000r 2                                                        ;   Writes the 8 mode registers, then reloads the
000000r 2                                                        ;   character set into the pattern table (VRAM $0800)
000000r 2                                                        ;   A program that switched the VDP to a graphics mode
000000r 2                                                        ;   can fully restore text mode with this one call
000000r 2                                                        ;   STR_PTR is used internally but saved and restored
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoClear          := $A018             ; Clear screen (fill with spaces), reset cursor to (0,0)
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoPutChar        := $A01B             ; Write character at cursor position (no cursor advance)
000000r 2                                                        ;   In: A = character
000000r 2               
000000r 2               VideoSetCursor      := $A01E             ; Set cursor position
000000r 2                                                        ;   In: X = column (0-39), Y = row (0-23)
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               VideoGetCursor      := $A021             ; Get cursor position
000000r 2                                                        ;   Out: X = column (0-39), Y = row (0-23)
000000r 2               
000000r 2               VideoScroll         := $A024             ; Scroll screen up one line, clear bottom row
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoSetColor       := $A027             ; Set TMS9918 text color
000000r 2                                                        ;   In: A = color byte (high nibble = foreground, low nibble = background)
000000r 2                                                        ;   See TMS9918 Color Constants below
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               VideoChroutRaw      := $A02A             ; Output char to video with no control-code handling
000000r 2                                                        ;   In: A = character code (0-255)
000000r 2                                                        ;   Preserves: A, X, Y
000000r 2                                                        ;   Always renders glyph, never interprets CR/LF/BS/BEL
000000r 2               
000000r 2               ; --- Sound (SID / ARMSID) ---
000000r 2               InitSID             := $A02D             ; Initialize SID (clear all registers, volume=15)
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               Beep                := $A030             ; Play short beep tone (~475 Hz)
000000r 2                                                        ;   Skips silently if no SID detected
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               SidPlayNote         := $A033             ; Play note on a SID voice
000000r 2                                                        ;   In: A = voice (0-2), X = freq low, Y = freq high
000000r 2                                                        ;   Uses triangle waveform, ADSR: A=0 D=9 S=F R=8
000000r 2                                                        ;   Full sustain holds the note flat until gated off
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SidSilence          := $A036             ; Silence all 3 SID voices (gate off only)
000000r 2                                                        ;   Frequencies are left intact — the envelope release
000000r 2                                                        ;   rings the tone out.  Zeroing freq would freeze the
000000r 2                                                        ;   waveform and decay a DC offset (audible thump)
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SidSetVolume        := $A039             ; Set SID master volume
000000r 2                                                        ;   In: A = volume (0-15); only the low nibble is used
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- Filesystem (disk-banked, 16-file directory per disk) ---
000000r 2               ;   The CF card is divided into 256 disk banks of 1 MB each (FS_DISK_SECTORS
000000r 2               ;   sectors × 512 bytes).  CF_DISK ($030F) selects the active bank (reset to
000000r 2               ;   0 on boot).  Use FsSetDisk / FsGetDisk to change it at runtime.  Each
000000r 2               ;   bank has its own directory at the first sector, holding up to 16 entries
000000r 2               ;   (8.3 filenames, space-padded, case-insensitive).  All FS routines and
000000r 2               ;   StReadSector / StWriteSector operate on the selected bank automatically.
000000r 2               ;   Pass null-terminated "NAME.EXT" string via STR_PTR ($02-$03).
000000r 2               ;   Use FsLoadFileAddr / FsSaveFileAddr for load-to-address transfers.
000000r 2               ;   The extension is inert — nothing in the BIOS branches on it, so .PRG, .BAS
000000r 2               ;   and .FOO behave identically.  What a file means is decided by the routine
000000r 2               ;   that loads it, never by its name.
000000r 2               ;   All FS routines use $0600-$07FF as a 512-byte sector buffer.
000000r 2               
000000r 2               FsLoadFile          := $A03C             ; Load file from CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 not found or error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSaveFile          := $A03F             ; Save file to CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsDeleteFile        := $A042             ; Delete file from CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 not found or error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- Keyboard / GPIO ---
000000r 2               InitKB              := $A045             ; Initialize VIA for keyboard input
000000r 2                                                        ;   Configures Port A/B as inputs, enables CB1/CA1 IRQs
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- Joysticks ---
000000r 2               ;   Both ports are ACTIVE LOW — each line is pulled up through 1K and grounded
000000r 2               ;   by its switch — and both routines return the port read raw.  So a held
000000r 2               ;   button is a 0 bit and an untouched stick reads $FF:
000000r 2               ;
000000r 2               ;     Bit:  7   6   5   4   3   2   1   0
000000r 2               ;           R   L   D   U   Y   X   B   A
000000r 2               ;
000000r 2               ;   Test a direction with:  lda ... / and #%00010000 / beq @UpHeld
000000r 2               ;
000000r 2               ;   Neither routine checks HW_PRESENT — with no GPIO card fitted they read a
000000r 2               ;   floating bus and the value is meaningless.  Test HW_GPIO first if the card
000000r 2               ;   may be absent.  (BASIC's JOY() does this and reports $FF.)
000000r 2               ;
000000r 2               ;   Both routines release both encoders (KBDisable), read the port, then
000000r 2               ;   re-enable them (KBEnable).  The interrupt state is left alone.
000000r 2               
000000r 2               ReadJoystick1       := $A048             ; Read joystick 1 (VIA Port B)
000000r 2                                                        ;   Out: A = bitmask (active low, see above)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               ReadJoystick2       := $A04B             ; Read joystick 2 (VIA Port A)
000000r 2                                                        ;   Out: A = bitmask (active low, see above)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               ; --- Serial (R65C51) ---
000000r 2               InitSC              := $A04E             ; Initialize serial card (8-N-1, 19200 baud)
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SerialChrout        := $A051             ; Direct serial output (bypasses IO_MODE)
000000r 2                                                        ;   In: A = character
000000r 2                                                        ;   Blocks until TX register is empty
000000r 2               
000000r 2               ; --- Serial Transfer ---
000000r 2               XModemLoad          := $A054             ; Receive data via XModem into memory
000000r 2                                                        ;   Protocol: standard XModem (128-byte blocks, checksum)
000000r 2                                                        ;   In: XFER_PTR = destination address
000000r 2                                                        ;   Out: C=0 success, XFER_PTR advanced past last byte written
000000r 2                                                        ;        XFER_REMAIN = total bytes received
000000r 2                                                        ;        C=1 transfer failed (timeout or CAN received)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               XModemSave          := $A057             ; Send data via XModem from memory
000000r 2                                                        ;   Protocol: standard XModem (128-byte blocks, checksum)
000000r 2                                                        ;   In: XFER_PTR = source address, XFER_REMAIN = byte count
000000r 2                                                        ;   Out: C=0 success, C=1 transfer failed (timeout or CAN received)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- RTC (DS1511Y) ---
000000r 2               RtcReadTime         := $A05A             ; Read current time
000000r 2                                                        ;   Out: A = hours, X = minutes, Y = seconds (all binary)
000000r 2               
000000r 2               RtcReadDate         := $A05D             ; Read current date
000000r 2                                                        ;   Out: A = day, X = month, Y = year (all binary)
000000r 2                                                        ;   RTC_BUF_CENT ($030B) = century
000000r 2               
000000r 2               RtcWriteTime        := $A060             ; Set RTC time
000000r 2                                                        ;   In: A = hours, X = minutes, Y = seconds (all binary)
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               RtcWriteDate        := $A063             ; Set RTC date
000000r 2                                                        ;   In: A = day, X = month, Y = year (all binary)
000000r 2                                                        ;   RTC_BUF_CENT ($030B) must hold century
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               RtcReadNVRAM        := $A066             ; Read byte from DS1511Y NVRAM (256 bytes)
000000r 2                                                        ;   In: X = address ($00-$FF)
000000r 2                                                        ;   Out: A = data byte
000000r 2               
000000r 2               RtcWriteNVRAM       := $A069             ; Write byte to DS1511Y NVRAM
000000r 2                                                        ;   In: X = address ($00-$FF), A = data byte
000000r 2               
000000r 2               ; --- CompactFlash Storage ---
000000r 2               StReadSector        := $A06C             ; Read one 512-byte sector
000000r 2                                                        ;   In: CF_LBA ($26-$29) = LBA, CF_BUF_PTR ($24-$25) = dest
000000r 2                                                        ;   Out: C=0 success, C=1 error; CF_BUF_PTR advanced by 512
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               StWriteSector       := $A06F             ; Write one 512-byte sector
000000r 2                                                        ;   In: CF_LBA ($26-$29) = LBA, CF_BUF_PTR ($24-$25) = source
000000r 2                                                        ;   Out: C=0 success, C=1 error; CF_BUF_PTR advanced by 512
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               StWaitReady         := $A072             ; Wait for CF to become ready (BSY=0, RDY=1)
000000r 2                                                        ;   Out: C=0 ready, C=1 timeout/error
000000r 2                                                        ;   Returns C=1 at once if the boot probe found no CF
000000r 2                                                        ;   card, rather than spinning out the full timeout.
000000r 2                                                        ;   Every FS and sector routine passes through here, so
000000r 2                                                        ;   an empty slot fails fast throughout the stack
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- Timing ---
000000r 2               SysDelay            := $A075             ; Delay for specified centiseconds (10 ms units)
000000r 2                                                        ;   In: A = low byte, X = high byte (16-bit count)
000000r 2                                                        ;   Uses VIA T1 if available, else software loop
000000r 2                                                        ;   Modifies: A, X, Y (X/Y clobbered only in software-fallback path)
000000r 2               
000000r 2               ; --- System / Cartridge Support ---
000000r 2               KernalInit          := $A078             ; Initialize all hardware (vectors, probe & init all I/O)
000000r 2                                                        ;   Caller MUST reset the stack pointer before JSR:
000000r 2                                                        ;     ldx #$ff / txs / jsr KernalInit
000000r 2                                                        ;   Zeroes BOOT_VECTOR, PRG_IMAGE_END and CF_DISK;
000000r 2                                                        ;   sets HW_PRESENT, IO_MODE, IRQ/BRK/NMI ptrs
000000r 2                                                        ;   Does NOT reset the stack pointer
000000r 2                                                        ;   Does NOT enable interrupts (caller must CLI)
000000r 2                                                        ;   Does NOT play beep, display splash, or enter boot menu
000000r 2                                                        ;   Does NOT halt if no console is detected
000000r 2                                                        ;   Modifies: All registers, flags
000000r 2               
000000r 2               KernalVersion       := $A07B             ; Get BIOS version
000000r 2                                                        ;   Out: A = major version, X = minor version
000000r 2               
000000r 2               ; --- Disk-banking & addressed storage (v1.1) ---
000000r 2               ;   CF_DISK ($030F) selects the current disk bank (0–255).
000000r 2               ;   All FS routines, StReadSector, and StWriteSector address the selected
000000r 2               ;   bank automatically.  Bank changes survive until the next reset.
000000r 2               
000000r 2               FsLoadFileAddr      := $A07E             ; Load named file from current disk to FS_IO_ADDR
000000r 2                                                        ;   In: STR_PTR = null-terminated filename
000000r 2                                                        ;       FS_IO_ADDR ($037F) = destination address
000000r 2                                                        ;   Out: C=0 success, FS_FILE_SIZE = bytes loaded; C=1 error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSaveFileAddr      := $A081             ; Save FS_FILE_SIZE bytes from FS_IO_ADDR to a named file
000000r 2                                                        ;   In: STR_PTR = filename
000000r 2                                                        ;       FS_IO_ADDR ($037F) = source address
000000r 2                                                        ;       FS_FILE_SIZE ($034A) = byte count
000000r 2                                                        ;   Out: C=0 success, C=1 error (disk full or write error)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsFormatDisk        := $A084             ; Zero the current disk's directory (erases all 16 entries)
000000r 2                                                        ;   Out: C=0 success, C=1 write error
000000r 2                                                        ;   No confirmation prompt — caller is responsible
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSetDisk           := $A087             ; Select the current CF disk bank
000000r 2                                                        ;   In: A = disk number (0–255) → stored in CF_DISK ($030F)
000000r 2                                                        ;   Modifies: Flags
000000r 2               
000000r 2               FsGetDisk           := $A08A             ; Get the current CF disk bank
000000r 2                                                        ;   Out: A = CF_DISK value (0–255)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               FsPrintDisk         := $A08D             ; Print "DISK n" + CRLF via Chrout (decimal, no leading zeros)
000000r 2                                                        ;   Uses current CF_DISK
000000r 2                                                        ;   Modifies: Flags, A, X, Y
000000r 2               
000000r 2               ; --- General Output Utilities (console routed by IO_MODE via Chrout) ---
000000r 2               PrintStr            := $A090             ; Print a NUL-terminated string
000000r 2                                                        ;   In : A = string addr low, Y = string addr high
000000r 2                                                        ;   Modifies: Flags, A, Y, STR_PTR (X preserved)
000000r 2               PrintCRLF           := $A093             ; Print CR ($0D) then LF ($0A)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               PrintDecU16         := $A096             ; Print an unsigned 16-bit value as decimal
000000r 2                                                        ;   In : A = value low, X = value high (no leading zeros)
000000r 2                                                        ;   Modifies: Flags, A, X, Y, FS_FILE_SIZE, FS_DIR_IDX
000000r 2               
000000r 2               ; --- Keyboard Encoder Control (raw GPIO port access) ---
000000r 2               ;   Both keyboard encoders drive the VIA ports the joysticks share.  Disable
000000r 2               ;   them to read GPIO_PORTA/GPIO_PORTB directly, then re-enable them.  The
000000r 2               ;   ReadJoystick routines do this for you; call these only for custom reads.
000000r 2               KBDisable           := $A099             ; Release both encoders and wait for them to let go
000000r 2                                                        ;   Busy-waits ~200 us so the ports settle before reading
000000r 2                                                        ;   Safe to call while the caller owns the VIA timers
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               KBEnable            := $A09C             ; Re-enable both keyboard encoders
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 5: IO HARDWARE REGISTERS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Banked RAM Low (IO 1: $8000-$83FF) ---
000000r 2               ;   256 banks × ~1 KB each.  Write bank number to latch, then access data window.
000000r 2               RAM_DATA_L          := $8000             ; R/W data window ($8000-$83FE)
000000r 2               RAM_BANK_L          := $83FF             ; Write-only bank latch ($00-$FF)
000000r 2               
000000r 2               ; --- Banked RAM High (IO 2: $8400-$87FF) ---
000000r 2               RAM_DATA_H          := $8400             ; R/W data window ($8400-$87FE)
000000r 2               RAM_BANK_H          := $87FF             ; Write-only bank latch ($00-$FF)
000000r 2               
000000r 2               ; --- RTC (DS1511Y) (IO 3: $8800-$881F) ---
000000r 2               RTC_SEC             := $8800             ; Seconds      (BCD, 00-59)
000000r 2               RTC_MIN             := $8801             ; Minutes      (BCD, 00-59)
000000r 2               RTC_HR              := $8802             ; Hours        (BCD, 00-23, 24h mode)
000000r 2               RTC_DAY             := $8803             ; Day of week  (1-7)
000000r 2               RTC_DATE            := $8804             ; Day of month (BCD, 01-31)
000000r 2               RTC_MON             := $8805             ; Month        (BCD, 01-12)
000000r 2               RTC_YR              := $8806             ; Year         (BCD, 00-99)
000000r 2               RTC_CENT            := $8807             ; Century      (BCD, 00-39)
000000r 2               RTC_ALARM_SEC       := $8808             ; Alarm seconds
000000r 2               RTC_ALARM_MIN       := $8809             ; Alarm minutes
000000r 2               RTC_ALARM_HR        := $880A             ; Alarm hours
000000r 2               RTC_ALARM_DATE      := $880B             ; Alarm day of month
000000r 2               RTC_WD_L            := $880C             ; Watchdog low
000000r 2               RTC_WD_H            := $880D             ; Watchdog high
000000r 2               RTC_CTRL_A          := $880E             ; Control Register A
000000r 2               RTC_CTRL_B          := $880F             ; Control Register B
000000r 2               RTC_RAM_ADDR        := $8810             ; NVRAM address register
000000r 2               RTC_RAM_DATA        := $8813             ; NVRAM data register
000000r 2               ; Control Register B bits:
000000r 2               RTC_CTRL_B_TE       := %10000000         ; Transfer Enable — set to inhibit clock updates during write
000000r 2               ; Month register ($8805) — the upper 3 bits are oscillator/SQW control, not month data.
000000r 2               ; Always mask with RTC_MON_MASK when reading the month, and preserve these bits on write.
000000r 2               RTC_MON_MASK        := %00011111         ; Month value occupies the low 5 bits
000000r 2               RTC_MON_EOSC        := %10000000         ; Oscillator Start/Stop (0 = oscillator running)
000000r 2               RTC_MON_E32K        := %01000000         ; 32 kHz square-wave enable (1 = SQW output disabled)
000000r 2               RTC_MON_BB32        := %00100000         ; Battery-backup 32 kHz SQW enable (1 = enabled in backup)
000000r 2               
000000r 2               ; --- CompactFlash / Storage (IO 4: $8C00-$8C07) ---
000000r 2               ;   8-bit IDE (True IDE) mode.  The BIOS issues Set Features $01 at boot
000000r 2               ;   to enable 8-bit data transfers.
000000r 2               ST_DATA             := $8C00             ; R/W — Data register
000000r 2               ST_ERROR            := $8C01             ; Read — Error register
000000r 2               ST_FEATURE          := $8C01             ; Write — Feature register
000000r 2               ST_SECT_CNT         := $8C02             ; R/W — Sector count
000000r 2               ST_LBA_0            := $8C03             ; R/W — LBA bits 0-7
000000r 2               ST_LBA_1            := $8C04             ; R/W — LBA bits 8-15
000000r 2               ST_LBA_2            := $8C05             ; R/W — LBA bits 16-23
000000r 2               ST_LBA_3            := $8C06             ; R/W — LBA bits 24-27 + drive/mode
000000r 2               ST_STATUS           := $8C07             ; Read — Status register
000000r 2               ST_CMD              := $8C07             ; Write — Command register
000000r 2               
000000r 2               ; CF Status Register bits:
000000r 2               ST_STATUS_ERR       := %00000001         ; Error occurred
000000r 2               ST_STATUS_IDX       := %00000010         ; Index mark
000000r 2               ST_STATUS_CORR      := %00000100         ; Corrected data
000000r 2               ST_STATUS_DRQ       := %00001000         ; Data request — ready for data transfer
000000r 2               ST_STATUS_DSC       := %00010000         ; Drive seek complete
000000r 2               ST_STATUS_DWF       := %00100000         ; Drive write fault
000000r 2               ST_STATUS_RDY       := %01000000         ; Drive ready
000000r 2               ST_STATUS_BSY       := %10000000         ; Drive busy — all other bits invalid while set
000000r 2               
000000r 2               ; CF Error Register bits:
000000r 2               ST_ERR_AMNF         := %00000001         ; Address mark not found
000000r 2               ST_ERR_ABRT         := %00000100         ; Command aborted
000000r 2               ST_ERR_IDNF         := %00010000         ; ID not found
000000r 2               ST_ERR_UNC          := %01000000         ; Uncorrectable data error
000000r 2               ST_ERR_BBK          := %10000000         ; Bad block detected
000000r 2               
000000r 2               ; ATA Command bytes:
000000r 2               ST_CMD_READ         := $20               ; Read Sectors
000000r 2               ST_CMD_WRITE        := $30               ; Write Sectors
000000r 2               ST_CMD_SET_FEAT     := $EF               ; Set Features
000000r 2               ST_FEAT_8BIT        := $01               ; Feature: Enable 8-bit data I/O
000000r 2               ST_LBA3_MASTER      := $E0               ; LBA mode, master drive (bits 7-5=111, bit 4=0)
000000r 2               
000000r 2               ; Filesystem constants:
000000r 2               FS_DIR_LBA          = 0                  ; Directory sector at LBA 0
000000r 2               FS_DATA_START       = 1                  ; Data sectors start at LBA 1
000000r 2               FS_MAX_FILES        = 16                 ; Maximum directory entries
000000r 2               FS_ENTRY_SIZE       = 32                 ; Bytes per directory entry
000000r 2               FS_ENTRY_FLAGS      = 11                 ; Offset: flags byte within entry
000000r 2               FS_ENTRY_START      = 12                 ; Offset: start sector (2 bytes, little-endian)
000000r 2               FS_ENTRY_FSIZE      = 14                 ; Offset: file size (2 bytes, little-endian)
000000r 2               FS_FLAG_USED        = %00000001          ; Flags bit 0: entry in use
000000r 2               FS_DISK_SECTORS     = 2048               ; Sectors per disk bank (2048 × 512 bytes = 1 MB); 256 banks = 256 MB total
000000r 2               
000000r 2               ; XModem protocol constants (used with XModemLoad / XModemSave):
000000r 2               XMODEM_SOH          = $01                ; Start of Header
000000r 2               XMODEM_EOT          = $04                ; End of Transmission
000000r 2               XMODEM_ACK          = $06                ; Acknowledge
000000r 2               XMODEM_NAK          = $15                ; Negative Acknowledge (receiver sends to initiate transfer)
000000r 2               XMODEM_CAN          = $18                ; Cancel
000000r 2               XMODEM_SUB          = $1A                ; Padding byte (fills unused bytes in last block)
000000r 2               XMODEM_BLKSZ        = 128                ; Data bytes per block
000000r 2               XMODEM_MAXRETRY     = 10                 ; Max retries per block during transfer
000000r 2               XMODEM_STARTRETRY   = 60                 ; Retries waiting for initial connect (~60s)
000000r 2               
000000r 2               ; --- Serial Card (R65C51 ACIA) (IO 5: $9000-$9003) ---
000000r 2               ;   Default config after InitSC: 8-N-1, 19200 baud, RX IRQ enabled
000000r 2               SC_DATA             := $9000             ; R/W — Data register
000000r 2               SC_RESET            := $9001             ; Write — Programmatic reset (write any value)
000000r 2               SC_STATUS           := $9001             ; Read — Status register
000000r 2               SC_CMD              := $9002             ; R/W — Command register
000000r 2               SC_CTRL             := $9003             ; R/W — Control register
000000r 2               
000000r 2               ; Serial Status Register bits:
000000r 2               SC_STATUS_IRQ       := %10000000         ; Interrupt occurred
000000r 2               SC_STATUS_DSR       := %01000000         ; Data Set Ready
000000r 2               SC_STATUS_DCD       := %00100000         ; Data Carrier Detect
000000r 2               SC_STATUS_TDRE      := %00010000         ; TX Data Register Empty (ready to send)
000000r 2               SC_STATUS_RDRF      := %00001000         ; RX Data Register Full (byte available)
000000r 2               SC_STATUS_OVR       := %00000100         ; Overrun error
000000r 2               SC_STATUS_FRME      := %00000010         ; Framing error
000000r 2               SC_STATUS_PARE      := %00000001         ; Parity error
000000r 2               
000000r 2               ; --- GPIO / Input Board (65C22 VIA) (IO 6: $9400-$940F) ---
000000r 2               ;   Port B = matrix keyboard / joystick 1
000000r 2               ;   Port A = PS/2 keyboard / joystick 2
000000r 2               ;   CB1/CA1 IRQs fire when a key scancode is ready
000000r 2               GPIO_PORTB          := $9400             ; Port B data (active keyboard/joystick 1 data)
000000r 2               GPIO_PORTA          := $9401             ; Port A data (active keyboard/joystick 2 data)
000000r 2               GPIO_DDRB           := $9402             ; Port B data direction (0=input, 1=output per bit)
000000r 2               GPIO_DDRA           := $9403             ; Port A data direction
000000r 2               GPIO_T1CL           := $9404             ; Timer 1 counter low (read=counter, write=latch)
000000r 2               GPIO_T1CH           := $9405             ; Timer 1 counter high (write starts timer)
000000r 2               GPIO_T1LL           := $9406             ; Timer 1 latch low
000000r 2               GPIO_T1LH           := $9407             ; Timer 1 latch high
000000r 2               GPIO_T2CL           := $9408             ; Timer 2 counter low
000000r 2               GPIO_T2CH           := $9409             ; Timer 2 counter high
000000r 2               GPIO_SR             := $940A             ; Shift register
000000r 2               GPIO_ACR            := $940B             ; Auxiliary control register
000000r 2               GPIO_PCR            := $940C             ; Peripheral control register
000000r 2               GPIO_IFR            := $940D             ; Interrupt flag register
000000r 2               GPIO_IER            := $940E             ; Interrupt enable register
000000r 2               GPIO_ORA            := $940F             ; Port A (no handshake)
000000r 2               
000000r 2               ; VIA Peripheral Control Register (PCR) mode bits:
000000r 2               GPIO_PCR_CB2_LO     := %11000000         ; CB2 = manual output low  (enable matrix keyboard encoder)
000000r 2               GPIO_PCR_CB2_HI     := %11100000         ; CB2 = manual output high (disable matrix keyboard encoder)
000000r 2               GPIO_PCR_CB1_NEG    := %00000000         ; CB1 = active on falling edge
000000r 2               GPIO_PCR_CA2_LO     := %00001100         ; CA2 = manual output low  (enable PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA2_HI     := %00001110         ; CA2 = manual output high (disable PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA1_NEG    := %00000000         ; CA1 = active on falling edge
000000r 2               
000000r 2               ; VIA Interrupt flag/enable bits:
000000r 2               GPIO_INT_CB1        := %00010000         ; Bit 4: CB1 interrupt (matrix keyboard data ready)
000000r 2               GPIO_INT_CA1        := %00000010         ; Bit 1: CA1 interrupt (PS/2 keyboard data ready)
000000r 2               GPIO_IER_SET        := %10000000         ; IER bit 7: 1=set named bits, 0=clear named bits
000000r 2               
000000r 2               ; --- Sound Card (SID / ARMSID) (IO 7: $9800-$981C) ---
000000r 2               ;   MOS 6581/8580 compatible.  3 voices, each with independent frequency,
000000r 2               ;   pulse width, waveform, and ADSR envelope.  Global filter and volume.
000000r 2               
000000r 2               ; Voice 1:
000000r 2               SID_V1_FREQ_LO      := $9800             ; Frequency low byte
000000r 2               SID_V1_FREQ_HI      := $9801             ; Frequency high byte
000000r 2               SID_V1_PW_LO        := $9802             ; Pulse width low byte (bits 0-7)
000000r 2               SID_V1_PW_HI        := $9803             ; Pulse width high nibble (bits 0-3)
000000r 2               SID_V1_CTRL         := $9804             ; Control register (waveform + gate)
000000r 2               SID_V1_AD           := $9805             ; Attack (high nibble) / Decay (low nibble)
000000r 2               SID_V1_SR           := $9806             ; Sustain (high nibble) / Release (low nibble)
000000r 2               
000000r 2               ; Voice 2:
000000r 2               SID_V2_FREQ_LO      := $9807
000000r 2               SID_V2_FREQ_HI      := $9808
000000r 2               SID_V2_PW_LO        := $9809
000000r 2               SID_V2_PW_HI        := $980A
000000r 2               SID_V2_CTRL         := $980B
000000r 2               SID_V2_AD           := $980C
000000r 2               SID_V2_SR           := $980D
000000r 2               
000000r 2               ; Voice 3:
000000r 2               SID_V3_FREQ_LO      := $980E
000000r 2               SID_V3_FREQ_HI      := $980F
000000r 2               SID_V3_PW_LO        := $9810
000000r 2               SID_V3_PW_HI        := $9811
000000r 2               SID_V3_CTRL         := $9812
000000r 2               SID_V3_AD           := $9813
000000r 2               SID_V3_SR           := $9814
000000r 2               
000000r 2               ; Global SID registers:
000000r 2               SID_FC_LO           := $9815             ; Filter cutoff low (bits 0-2)
000000r 2               SID_FC_HI           := $9816             ; Filter cutoff high (bits 0-7)
000000r 2               SID_RES_FILT        := $9817             ; Resonance (high nibble) / Filter enable per voice (bits 0-2)
000000r 2               SID_MODE_VOL        := $9818             ; Filter mode (high nibble) / Master volume (low nibble, 0-15)
000000r 2               SID_PADDLE_X        := $9819             ; Paddle X (read-only)
000000r 2               SID_PADDLE_Y        := $981A             ; Paddle Y (read-only)
000000r 2               SID_OSC3            := $981B             ; Oscillator 3 output (read-only)
000000r 2               SID_ENV3            := $981C             ; Envelope 3 output (read-only)
000000r 2               
000000r 2               ; SID Voice Control Register bits (apply to SID_Vn_CTRL):
000000r 2               SID_CTRL_GATE       := %00000001         ; Gate: 1=start attack, 0=start release
000000r 2               SID_CTRL_SYNC       := %00000010         ; Hard sync with preceding voice
000000r 2               SID_CTRL_RING       := %00000100         ; Ring modulation with preceding voice
000000r 2               SID_CTRL_TEST       := %00001000         ; Test bit (resets oscillator)
000000r 2               SID_CTRL_TRIANGLE   := %00010000         ; Triangle waveform
000000r 2               SID_CTRL_SAWTOOTH   := %00100000         ; Sawtooth waveform
000000r 2               SID_CTRL_PULSE      := %01000000         ; Pulse waveform
000000r 2               SID_CTRL_NOISE      := %10000000         ; Noise waveform
000000r 2               
000000r 2               ; SID Filter Mode bits (high nibble of SID_MODE_VOL):
000000r 2               SID_FILT_LP         := %00010000         ; Low-pass filter
000000r 2               SID_FILT_BP         := %00100000         ; Band-pass filter
000000r 2               SID_FILT_HP         := %01000000         ; High-pass filter
000000r 2               SID_FILT_3OFF       := %10000000         ; Disconnect voice 3 from output
000000r 2               
000000r 2               ; --- SID Frequency Table (1 MHz clock, equal temperament) ---
000000r 2               ;   Freq register = round(Hz × 16777216 / 1000000)
000000r 2               ;   Covers octaves 2-7 (C2=65 Hz to B7=3951 Hz), all 12 chromatic notes.
000000r 2               ;   Sharps and flats are provided as aliases (e.g. SID_NOTE_CS4 = SID_NOTE_Db4).
000000r 2               ;   Use SidPlayNote: A=voice (0-2), X=freq low byte, Y=freq high byte.
000000r 2               ;   Example: ldx #<SID_NOTE_A4 / ldy #>SID_NOTE_A4
000000r 2               
000000r 2               ; Octave 2 (C2=65.41 Hz .. B2=123.47 Hz)
000000r 2               SID_NOTE_C2         = $0449              ; ~65 Hz
000000r 2               SID_NOTE_CS2        = $048B              ; ~69 Hz
000000r 2               SID_NOTE_Db2        = SID_NOTE_CS2
000000r 2               SID_NOTE_D2         = $04D0              ; ~73 Hz
000000r 2               SID_NOTE_DS2        = $0519              ; ~78 Hz
000000r 2               SID_NOTE_Eb2        = SID_NOTE_DS2
000000r 2               SID_NOTE_E2         = $0567              ; ~82 Hz
000000r 2               SID_NOTE_F2         = $05B9              ; ~87 Hz
000000r 2               SID_NOTE_FS2        = $0610              ; ~93 Hz
000000r 2               SID_NOTE_Gb2        = SID_NOTE_FS2
000000r 2               SID_NOTE_G2         = $066C              ; ~98 Hz
000000r 2               SID_NOTE_GS2        = $06CE              ; ~104 Hz
000000r 2               SID_NOTE_Ab2        = SID_NOTE_GS2
000000r 2               SID_NOTE_A2         = $0735              ; ~110 Hz
000000r 2               SID_NOTE_AS2        = $07A3              ; ~117 Hz
000000r 2               SID_NOTE_Bb2        = SID_NOTE_AS2
000000r 2               SID_NOTE_B2         = $0817              ; ~123 Hz
000000r 2               
000000r 2               ; Octave 3 (C3=130.81 Hz .. B3=246.94 Hz)
000000r 2               SID_NOTE_C3         = $0893              ; ~131 Hz
000000r 2               SID_NOTE_CS3        = $0915              ; ~139 Hz
000000r 2               SID_NOTE_Db3        = SID_NOTE_CS3
000000r 2               SID_NOTE_D3         = $099F              ; ~147 Hz
000000r 2               SID_NOTE_DS3        = $0A32              ; ~156 Hz
000000r 2               SID_NOTE_Eb3        = SID_NOTE_DS3
000000r 2               SID_NOTE_E3         = $0ACD              ; ~165 Hz
000000r 2               SID_NOTE_F3         = $0B72              ; ~175 Hz
000000r 2               SID_NOTE_FS3        = $0C20              ; ~185 Hz
000000r 2               SID_NOTE_Gb3        = SID_NOTE_FS3
000000r 2               SID_NOTE_G3         = $0CD8              ; ~196 Hz
000000r 2               SID_NOTE_GS3        = $0D9C              ; ~208 Hz
000000r 2               SID_NOTE_Ab3        = SID_NOTE_GS3
000000r 2               SID_NOTE_A3         = $0E6B              ; ~220 Hz
000000r 2               SID_NOTE_AS3        = $0F46              ; ~233 Hz
000000r 2               SID_NOTE_Bb3        = SID_NOTE_AS3
000000r 2               SID_NOTE_B3         = $102F              ; ~247 Hz
000000r 2               
000000r 2               ; Octave 4 (C4=261.63 Hz .. B4=493.88 Hz) — middle octave
000000r 2               SID_NOTE_C4         = $1125              ; ~262 Hz (Middle C)
000000r 2               SID_NOTE_CS4        = $122A              ; ~277 Hz
000000r 2               SID_NOTE_Db4        = SID_NOTE_CS4
000000r 2               SID_NOTE_D4         = $133F              ; ~294 Hz
000000r 2               SID_NOTE_DS4        = $1464              ; ~311 Hz
000000r 2               SID_NOTE_Eb4        = SID_NOTE_DS4
000000r 2               SID_NOTE_E4         = $159A              ; ~330 Hz
000000r 2               SID_NOTE_F4         = $16E3              ; ~349 Hz
000000r 2               SID_NOTE_FS4        = $183F              ; ~370 Hz
000000r 2               SID_NOTE_Gb4        = SID_NOTE_FS4
000000r 2               SID_NOTE_G4         = $19B1              ; ~392 Hz
000000r 2               SID_NOTE_GS4        = $1B38              ; ~415 Hz
000000r 2               SID_NOTE_Ab4        = SID_NOTE_GS4
000000r 2               SID_NOTE_A4         = $1CD6              ; ~440 Hz (Concert A)
000000r 2               SID_NOTE_AS4        = $1E8D              ; ~466 Hz
000000r 2               SID_NOTE_Bb4        = SID_NOTE_AS4
000000r 2               SID_NOTE_B4         = $205E              ; ~494 Hz
000000r 2               
000000r 2               ; Octave 5 (C5=523.25 Hz .. B5=987.77 Hz)
000000r 2               SID_NOTE_C5         = $224B              ; ~523 Hz
000000r 2               SID_NOTE_CS5        = $2455              ; ~554 Hz
000000r 2               SID_NOTE_Db5        = SID_NOTE_CS5
000000r 2               SID_NOTE_D5         = $267E              ; ~587 Hz
000000r 2               SID_NOTE_DS5        = $28C8              ; ~622 Hz
000000r 2               SID_NOTE_Eb5        = SID_NOTE_DS5
000000r 2               SID_NOTE_E5         = $2B34              ; ~659 Hz
000000r 2               SID_NOTE_F5         = $2DC6              ; ~698 Hz
000000r 2               SID_NOTE_FS5        = $307F              ; ~740 Hz
000000r 2               SID_NOTE_Gb5        = SID_NOTE_FS5
000000r 2               SID_NOTE_G5         = $3361              ; ~784 Hz
000000r 2               SID_NOTE_GS5        = $366F              ; ~831 Hz
000000r 2               SID_NOTE_Ab5        = SID_NOTE_GS5
000000r 2               SID_NOTE_A5         = $39AC              ; ~880 Hz
000000r 2               SID_NOTE_AS5        = $3D1A              ; ~932 Hz
000000r 2               SID_NOTE_Bb5        = SID_NOTE_AS5
000000r 2               SID_NOTE_B5         = $40BC              ; ~988 Hz
000000r 2               
000000r 2               ; Octave 6 (C6=1046.50 Hz .. B6=1975.53 Hz)
000000r 2               SID_NOTE_C6         = $4495              ; ~1047 Hz
000000r 2               SID_NOTE_CS6        = $48A9              ; ~1109 Hz
000000r 2               SID_NOTE_Db6        = SID_NOTE_CS6
000000r 2               SID_NOTE_D6         = $4CFC              ; ~1175 Hz
000000r 2               SID_NOTE_DS6        = $518F              ; ~1245 Hz
000000r 2               SID_NOTE_Eb6        = SID_NOTE_DS6
000000r 2               SID_NOTE_E6         = $5669              ; ~1319 Hz
000000r 2               SID_NOTE_F6         = $5B8C              ; ~1397 Hz
000000r 2               SID_NOTE_FS6        = $60FE              ; ~1480 Hz
000000r 2               SID_NOTE_Gb6        = SID_NOTE_FS6
000000r 2               SID_NOTE_G6         = $66C2              ; ~1568 Hz
000000r 2               SID_NOTE_GS6        = $6CDF              ; ~1661 Hz
000000r 2               SID_NOTE_Ab6        = SID_NOTE_GS6
000000r 2               SID_NOTE_A6         = $7358              ; ~1760 Hz
000000r 2               SID_NOTE_AS6        = $7A34              ; ~1865 Hz
000000r 2               SID_NOTE_Bb6        = SID_NOTE_AS6
000000r 2               SID_NOTE_B6         = $8178              ; ~1976 Hz
000000r 2               
000000r 2               ; Octave 7 (C7=2093.00 Hz .. A7=3520.00 Hz; B7 overflows 16-bit register)
000000r 2               SID_NOTE_C7         = $892B              ; ~2093 Hz
000000r 2               SID_NOTE_CS7        = $9153              ; ~2217 Hz
000000r 2               SID_NOTE_Db7        = SID_NOTE_CS7
000000r 2               SID_NOTE_D7         = $99F7              ; ~2349 Hz
000000r 2               SID_NOTE_DS7        = $A31F              ; ~2489 Hz
000000r 2               SID_NOTE_Eb7        = SID_NOTE_DS7
000000r 2               SID_NOTE_E7         = $ACD2              ; ~2637 Hz
000000r 2               SID_NOTE_F7         = $B719              ; ~2794 Hz
000000r 2               SID_NOTE_FS7        = $C1FC              ; ~2960 Hz
000000r 2               SID_NOTE_Gb7        = SID_NOTE_FS7
000000r 2               SID_NOTE_G7         = $CD85              ; ~3136 Hz
000000r 2               SID_NOTE_GS7        = $D9BD              ; ~3322 Hz
000000r 2               SID_NOTE_Ab7        = SID_NOTE_GS7
000000r 2               SID_NOTE_A7         = $E6B0              ; ~3520 Hz
000000r 2               SID_NOTE_AS7        = $F467              ; ~3729 Hz
000000r 2               SID_NOTE_Bb7        = SID_NOTE_AS7
000000r 2               ; Note: B7 (~3951 Hz = $102F0) exceeds the 16-bit SID register — not defined
000000r 2               
000000r 2               ; --- Video Card (TMS9918 / pico9918) (IO 8: $9C00-$9C01) ---
000000r 2               ;   Text mode: 40 columns × 24 rows.  Name table at VRAM $0000 (960 bytes).
000000r 2               ;   Pattern table at VRAM $0800 (2 KB, 256 × 8-byte character patterns).
000000r 2               ;   To write to a VRAM address: write low byte to VC_REG, then (high | $40) to VC_REG.
000000r 2               ;   To read from a VRAM address: write low byte to VC_REG, then high byte to VC_REG.
000000r 2               ;   Register writes: write data byte to VC_REG, then (reg# | $80) to VC_REG.
000000r 2               VC_DATA             := $9C00             ; R/W — VRAM data (auto-increments address)
000000r 2               VC_REG              := $9C01             ; Write — Address/register port
000000r 2               VC_STATUS           := $9C01             ; Read — Status register
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 6: USEFUL CONSTANTS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- BIOS Version ---
000000r 2               BIOS_VERSION_MAJOR  = 1
000000r 2               BIOS_VERSION_MINOR  = 5
000000r 2               
000000r 2               ; --- ASCII Control Characters ---
000000r 2               CHAR_BEL            = $07                ; Bell (Beep via SID)
000000r 2               CHAR_BS             = $08                ; Backspace (cursor left + erase in video mode)
000000r 2               CHAR_LF             = $0A                ; Line Feed (cursor down, scroll if at bottom)
000000r 2               CHAR_CR             = $0D                ; Carriage Return (cursor to column 0)
000000r 2               CHAR_ESC            = $1B                ; Escape
000000r 2               CHAR_SPACE          = $20                ; Space
000000r 2               
000000r 2               ; --- Video Dimensions ---
000000r 2               VID_COLS            = 40                 ; Screen width in columns
000000r 2               VID_ROWS            = 24                 ; Screen height in rows
000000r 2               VID_NAME_TABLE      = $0000              ; VRAM address of name table (40×24 = 960 bytes)
000000r 2               VID_PATTERN_TABLE   = $0800              ; VRAM address of pattern/character table (2048 bytes)
000000r 2               
000000r 2               ; --- TMS9918 Color Constants (for VideoSetColor) ---
000000r 2               ;   Pass as: (foreground << 4) | background
000000r 2               ;   Example: white on black = $F0, green on black = $20
000000r 2               TMS_TRANSPARENT     = $0
000000r 2               TMS_BLACK           = $1
000000r 2               TMS_MED_GREEN       = $2
000000r 2               TMS_LT_GREEN        = $3
000000r 2               TMS_DK_BLUE         = $4
000000r 2               TMS_LT_BLUE         = $5
000000r 2               TMS_DK_RED          = $6
000000r 2               TMS_CYAN            = $7
000000r 2               TMS_MED_RED         = $8
000000r 2               TMS_LT_RED          = $9
000000r 2               TMS_DK_YELLOW       = $A
000000r 2               TMS_LT_YELLOW       = $B
000000r 2               TMS_DK_GREEN        = $C
000000r 2               TMS_MAGENTA         = $D
000000r 2               TMS_GRAY            = $E
000000r 2               TMS_WHITE           = $F
000000r 2               
000000r 2               ; --- Monitor Entry Points ---
000000r 2               ;   The machine code monitor lives at $EE00 and is entered normally via BRK.
000000r 2               ;   These are useful if you want to jump there directly.
000000r 2               MONITOR_ENTRY       := $EE00             ; Cold entry (from boot menu or user code)
000000r 2               MONITOR_BRK_ENTRY   := $EE03             ; BRK entry (displays saved registers)
000000r 2               
000000r 1               
000000r 1               ; --- Platform constants (hal.inc) --------------------------------------------
000000r 1               SCR_COLS         = 32
000000r 1               SCR_ROWS         = 24
000000r 1               SCR_CELLS        = SCR_COLS * SCR_ROWS     ; 768
000000r 1               PANEL_X             = 5             ; (32 - 22) / 2 — exact centring
000000r 1               PANEL_Y             = 0
000000r 1               HAS_COLOR_RAM       = 0             ; Colour lives in the VDP colour table
000000r 1               
000000r 1               ; --- VRAM map (SPEC Appendix C.1) --------------------------------------------
000000r 1               VRAM_PATTERNS       = $0000         ; 2 K, 256 patterns x 8 bytes
000000r 1               VRAM_NAMES          = $1400         ; 768, the 32 x 24 name table
000000r 1               VRAM_SPRITES        = $1B00         ; Sprite attributes — disabled below
000000r 1               VRAM_COLORS         = $2000         ; 32, one byte per 8-pattern group
000000r 1               
000000r 1               .include "../src/constants.inc"
000000r 2               ; =============================================================================
000000r 2               ;   constants.inc — Wizards Lab, shared game constants
000000r 2               ; =============================================================================
000000r 2               ;   Everything here comes straight out of SPEC.md. If a number changes there,
000000r 2               ;   it changes here, and nowhere else. Nothing in this file is platform
000000r 2               ;   specific — see the per-platform WizardsLab.asm for PANEL_X / PANEL_Y and
000000r 2               ;   the hardware addresses.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Board (SPEC 3) ----------------------------------------------------------
000000r 2               BOARD_W             = 6         ; Playfield columns
000000r 2               BOARD_H             = 16        ; Playfield rows
000000r 2               BOARD_STRIDE        = 8         ; Bytes per row — two wasted, on purpose
000000r 2               BOARD_ROWS_ALLOC    = 20        ; 16 playfield + 2 floor sentinels + 2 reserved
000000r 2               BOARD_BYTES         = BOARD_ROWS_ALLOC * BOARD_STRIDE    ; 160
000000r 2               SPAWN_COL           = 2         ; 0-indexed, left of centre
000000r 2               MATCH_MIN           = 3         ; Run length that clears
000000r 2               
000000r 2               ; --- Tile encoding (SPEC 4) --------------------------------------------------
000000r 2               ;   tile = COLOR_BASE + (color << 3) + glyph
000000r 2               ;   The board byte IS the tile index. No translation on the way to the screen.
000000r 2               TILE_EMPTY          = $00
000000r 2               TILE_WALL           = $FF
000000r 2               COLOR_BASE          = $40
000000r 2               COLOR_MASK          = $F8       ; AND this and you have the colour key
000000r 2               GLYPH_MASK          = $07
000000r 2               WILD_BASE           = $70       ; Colour 6 — the prism
000000r 2               NUM_COLORS          = 6
000000r 2               
000000r 2               COLOR_RED           = 0
000000r 2               COLOR_YELLOW        = 1
000000r 2               COLOR_GREEN         = 2
000000r 2               COLOR_CYAN          = 3
000000r 2               COLOR_BLUE          = 4
000000r 2               COLOR_PURPLE        = 5
000000r 2               COLOR_WILD          = 6
000000r 2               
000000r 2               GLYPH_POTION        = 0
000000r 2               GLYPH_FIREBALL      = 1
000000r 2               GLYPH_BOLT          = 2
000000r 2               GLYPH_BOMB          = 3
000000r 2               GLYPH_STAR          = 4
000000r 2               GLYPH_GLOW          = 6         ; Match-flash frame. Potion colours only —
000000r 2                                               ;   WILD_BASE + GLYPH_GLOW is an arrow, not a
000000r 2                                               ;   glow, so the prism never takes this path.
000000r 2                                               ;   See PRISM_BLIP below and SPEC 4.4.
000000r 2               
000000r 2               ; --- Named tiles -------------------------------------------------------------
000000r 2               TILE_BLANK          = 0
000000r 2               TILE_BAR_H          = 1
000000r 2               TILE_BAR_V          = 2
000000r 2               TILE_COR_TL         = 3
000000r 2               TILE_COR_TR         = 4
000000r 2               TILE_COR_BL         = 5
000000r 2               TILE_COR_BR         = 6
000000r 2               TILE_WASH           = 7         ; PAUSE / dim wash, white
000000r 2               FONT_BASE           = 16        ; '0'..'9' then 'A'..'Z' then . x ! ~
000000r 2               FONT_DIGIT_0        = 16
000000r 2               FONT_LETTER_A       = 26
000000r 2               FONT_DOT            = 52        ; A CENTRED dot, not a baseline period — it is
000000r 2                                               ;   also frame 0 of the removal ring below
000000r 2               FONT_TIMES          = 53
000000r 2               FONT_BANG           = 54
000000r 2               FONT_TILDE          = 55        ; The banner ornament, ~~~LIKE THIS~~~
000000r 2               TEXT_END            = $FF       ; String terminator. Shares its value with
000000r 2                                               ;   TILE_WALL, which costs nothing: no string
000000r 2                                               ;   ever contains tile 255.
000000r 2               
000000r 2               ; The removal ring (SPEC 14). One animation, used for every removal there is:
000000r 2               ; the match shatter, the bomb blast, the star. It opens outward
000000r 2               ;
000000r 2               ;       FONT_DOT -> VFX_REMOVE1 -> VFX_REMOVE2 -> VFX_REMOVE3 -> empty
000000r 2               ;
000000r 2               ; and the prism's blip-out runs the same tiles closed inward (PRISM_BLIP).
000000r 2               VFX_REMOVE1         = 56
000000r 2               VFX_REMOVE2         = 57
000000r 2               VFX_REMOVE3         = 58
000000r 2               VFX_BEAM_H          = 59        ; The bolt's row
000000r 2               VFX_BEAM_V          = 60        ; The bolt's column
000000r 2               VFX_BEAM_CROSS      = 61        ; Drawn once, at the bolt's own cell
000000r 2               ARROW_UP            = 62        ; The title screen's controls (SPEC 13.1).
000000r 2               ARROW_DOWN          = 63        ;   Up and down live in group 7, left and
000000r 2               ARROW_LEFT          = 118       ;   right in group 14 — whichever white group
000000r 2               ARROW_RIGHT         = 119       ;   had a slot spare. Nothing indexes them.
000000r 2               
000000r 2               ; Group 14 is the prism's. Slots +0..+3 are its idle rotation and +4..+5 its
000000r 2               ; blip-out; there is no glow slot (SPEC A.3).
000000r 2               PRISM_SPIN          = WILD_BASE ; Four frames, WILD_BASE + 0..3
000000r 2               PRISM_SPIN_FRAMES   = 4
000000r 2               PRISM_BLIP          = WILD_BASE + 4     ; Two frames, then VFX_REMOVE2,
000000r 2                                                       ;   VFX_REMOVE1, FONT_DOT, empty
000000r 2               
000000r 2               ; Group 15 is the stone group: the petrified glyph set at the same offsets the
000000r 2               ; potions use, so a cell petrifies into its own shape —
000000r 2               ;
000000r 2               ;       petrified = PETRIFY_BASE + (tile & GLYPH_MASK)     for glyphs 0-4
000000r 2               ;
000000r 2               ; — and then the two tiles the margins are built from.
000000r 2               PETRIFY_BASE        = 120       ; +0 potion, +1 fireball, +2 bolt,
000000r 2                                               ;   +3 bomb, +4 star
000000r 2               TILE_RESERVED       = 125       ; Held for a sixth glyph, if one is ever added
000000r 2               TILE_SHELF          = 126       ; The shelf the panel stands on
000000r 2               TILE_BRICK          = 127       ; Brick — the margin fill
000000r 2               FRAME_DIM           = 8         ; Group 1 is group 0 byte for byte, one colour
000000r 2                                               ;   quieter, so frame_tile + FRAME_DIM is any
000000r 2                                               ;   frame piece's dim twin (SPEC A.3)
000000r 2               ART_BASE            = 128       ; Groups 16-31 — one hatch in sixteen colours,
000000r 2                                               ;   the title screen's magic field (SPEC 13.1)
000000r 2               ART_TILES           = 128
000000r 2               
000000r 2               ; --- Panel geometry (SPEC 12) ------------------------------------------------
000000r 2               ;   One 22 x 24 panel, rendered identically on all three machines. PANEL_Y is
000000r 2               ;   0 everywhere; only PANEL_X differs. The panel is vertically symmetric —
000000r 2               ;   backdrop row, band row, backdrop row, eighteen rows of frame, backdrop row,
000000r 2               ;   band row, backdrop row — which is why 24 is the height. The AC6502 is the
000000r 2               ;   exact fit; the VIC-20 clips panel row 23 off the bottom and the C64 has one
000000r 2               ;   spare screen row (24) below the panel. See SPEC 12.4.
000000r 2               PANEL_W             = 22
000000r 2               PANEL_H             = 24
000000r 2               
000000r 2               WELL_ORIGIN_X       = 1         ; Panel-relative: board (0,0) lives here
000000r 2               WELL_ORIGIN_Y       = 4
000000r 2               
000000r 2               SCORE_X             = 12        ; 7 digits, cols 12-18
000000r 2               SCORE_Y             = 5
000000r 2               HIGH_X              = 12        ; 7 digits, cols 12-18
000000r 2               HIGH_Y              = 10
000000r 2               HIGHLVL_X           = 15        ; Level the high score was set on, 2 digits;
000000r 2                                               ;   the 'L' at col 14 is in the static image
000000r 2               HIGHLVL_Y           = 11
000000r 2               LEVEL_X             = 18        ; Single column: tens above units
000000r 2               LEVEL_Y             = 17        ; Tens at LEVEL_Y, units at LEVEL_Y + 1
000000r 2               NEXT_X              = 11        ; Single tile column
000000r 2               NEXT_Y              = 16        ; Cells A, B, C at NEXT_Y, +1, +2
000000r 2               MSG_X               = 2         ; The band's OWNED cells. Panel columns 0-1 and
000000r 2               MSG_W               = 18        ;   20-21 of row 22 are shelf in the static
000000r 2               MSG_Y               = 22        ;   image and code never touches them; the
000000r 2                                               ;   banner still centres on the full PANEL_W,
000000r 2                                               ;   which lands in the same place for an
000000r 2                                               ;   even-length string (SPEC 12.2).
000000r 2               
000000r 2               MSG_CHAIN_LEN       = 14        ; `~~ CHAIN x0 ~~` (strings.inc)
000000r 2               MSG_CHAIN_DIGIT     = 10        ; Where the digit sits inside it
000000r 2               CHAIN_DIGIT_X       = (PANEL_W - MSG_CHAIN_LEN) / 2 + MSG_CHAIN_DIGIT
000000r 2                                               ; TextBanner centres on PANEL_W, so the one
000000r 2                                               ;   cell the chain banner overwrites afterwards
000000r 2                                               ;   is worked out here rather than counted off
000000r 2                                               ;   the screen
000000r 2               CHAIN_MAX_SHOWN     = 9         ; One digit. A chain past 9 says 9 rather than
000000r 2                                               ;   drawing a glyph that is not a numeral
000000r 2               
000000r 2               SCORE_DIGITS        = 7         ; Always all 7 drawn, zero padded
000000r 2               LEVEL_DIGITS        = 2         ; Always zero padded — level 5 draws "0" / "5"
000000r 2               
000000r 2               ; --- Piece and timing (SPEC 5.6, 11.3, 14) -----------------------------------
000000r 2               ;   Every duration in the game is a frame count, and most of them differ
000000r 2               ;   between NTSC and PAL so that wall-clock speed matches. Those live in
000000r 2               ;   tables.inc as two-entry tables indexed by Region, not here — a constant
000000r 2               ;   that is not one number is not a constant. The ones below are the same on
000000r 2               ;   both machines.
000000r 2               LOCK_RESET_MAX      = 4         ; Horizontal moves that may reset the lock
000000r 2                                               ;   delay, per piece. Rotation never resets it.
000000r 2               FALL_FRAMES         = 2         ; Frames a row while the pile falls into the
000000r 2                                               ;   holes a clear left (SPEC 14). The one
000000r 2                                               ;   duration in the game that is the same on
000000r 2                                               ;   both regions, because SPEC 14 says so: at
000000r 2                                               ;   two frames there is nothing to round.
000000r 2               
000000r 2               ; --- Animation (SPEC 14) -----------------------------------------------------
000000r 2               ;   A clear step animates in two windows, and everything SPEC 14 lists happens
000000r 2               ;   inside one of them. A window lasts as long as the LONGEST thing in it:
000000r 2               ;
000000r 2               ;     GLOW      the matched cells' glow glyph, the bolt's beams and the
000000r 2               ;               fireball's white flash. GlowFrames, or the longer FlashFrames
000000r 2               ;               when a fireball fired (tables.inc)
000000r 2               ;     SHATTER   the removal ring, and the prism's blip-out running alongside
000000r 2               ;               it. SHATTER_STEPS ring frames, or BLIP_STEPS when a marked
000000r 2               ;               prism is winking out with them
000000r 2               ;
000000r 2               ;   The two counts below are the SAME on both regions, for the reason
000000r 2               ;   FALL_FRAMES is: they are a tile count times VFX_FRAMES, and two frames a
000000r 2               ;   tile does not round to 1.67. SPEC 14 says so.
000000r 2               VFX_FRAMES          = 2         ; Frames each tile of a removal ring holds
000000r 2               SHATTER_STEPS       = 3         ; VFX_REMOVE1..3           — 6 frames
000000r 2               BLIP_STEPS          = 5         ; PRISM_BLIP, +1, VFX_REMOVE2, VFX_REMOVE1,
000000r 2                                               ;   FONT_DOT               — 10 frames
000000r 2               PRISM_SPIN_RATE     = 8         ; Frames per idle rotation frame (SPEC 14).
000000r 2                                               ;   The only tile on the board that moves when
000000r 2                                               ;   nothing is happening
000000r 2               PETRIFY_FRAMES      = 2         ; Frames per row of the game-over petrify
000000r 2                                               ;   (SPEC 13.4). Same number as FALL_FRAMES
000000r 2                                               ;   and not the same thing, so it is its own
000000r 2                                               ;   constant
000000r 2               TINT_NONE           = $01       ; TintColor when nothing is flashing white.
000000r 2                                               ;   Every real colour key has its low three
000000r 2                                               ;   bits clear, so $01 is a value no masked
000000r 2                                               ;   tile can equal — which is what lets the
000000r 2                                               ;   Commodores' HalPlotCell test the tint with
000000r 2                                               ;   one CMP and no separate "is anything
000000r 2                                               ;   flashing at all" branch (SPEC 4.6)
000000r 2               
000000r 2               ; --- Levels (SPEC 10) --------------------------------------------------------
000000r 2               LEVEL_TILES         = 30        ; Tiles cleared per level
000000r 2               LEVEL_SPEED_CAP     = 16        ; Speed stops improving here
000000r 2               LEVEL_MAX_SHOWN     = 99
000000r 2               
000000r 2               ; --- Scoring (SPEC 9) --------------------------------------------------------
000000r 2               BONUS_FIREBALL      = $0500     ; BCD
000000r 2               BONUS_BOLT          = $0300
000000r 2               BONUS_BOMB          = $0300
000000r 2               BONUS_PRISM         = $0400
000000r 2               BONUS_LEVELUP       = $1000
000000r 2               STAR_SHIFT_CAP      = 3         ; Three doublings — x8
000000r 2               HIGH_FLASH_BLINKS   = 6         ; Half-blinks of the HIGH field when the score
000000r 2                                               ;   overtakes it (SPEC 9.8) — three dark, three
000000r 2                                               ;   lit, ending lit. At SPEC 14's 30-frame
000000r 2                                               ;   blink period that is about a second and a
000000r 2                                               ;   half, and play never stops for it.
000000r 2               SCORE_BYTES         = 4         ; 8 nibbles packed BCD; the top one stays 0,
000000r 2                                               ;   so 7 digits show and the score wraps at
000000r 2                                               ;   10,000,000.
000000r 2               HIGH_INIT_LO        = $00       ; 0010000
000000r 2               HIGH_INIT_MID       = $00
000000r 2               HIGH_INIT_HI        = $01
000000r 2               HIGH_INIT_TOP       = $00
000000r 2               
000000r 2               ; --- Reagent probability, out of 256 (SPEC 5.3) ------------------------------
000000r 2               PSPECIAL_BANDS      = 5
000000r 2               
000000r 2               ; --- Input bitmask (SPEC 11.1) -----------------------------------------------
000000r 2               ;   Active HIGH. Each platform inverts and remaps its own hardware into this.
000000r 2               INPUT_UP            = %00000001 ; Rotate forward
000000r 2               INPUT_DOWN          = %00000010 ; Soft drop
000000r 2               INPUT_LEFT          = %00000100
000000r 2               INPUT_RIGHT         = %00001000
000000r 2               INPUT_FIRE          = %00010000 ; Rotate reverse / confirm
000000r 2               INPUT_PAUSE         = %00100000
000000r 2               INPUT_MASK          = %00111111 ; Everything the game reads. Bits 6-7 are free
000000r 2                                               ;   for a platform to use as scratch inside
000000r 2                                               ;   HalReadInput, as long as it strips them.
000000r 2               
000000r 2               ; --- Game states (SPEC 13) ---------------------------------------------------
000000r 2               STATE_TITLE         = 0
000000r 2               STATE_PLAY          = 1
000000r 2               STATE_PAUSE         = 2
000000r 2               STATE_GAMEOVER      = 3
000000r 2               
000000r 2               ; --- Play sub-states (SPEC 8) ------------------------------------------------
000000r 2               PLAY_FALLING        = 0
000000r 2               PLAY_LOCKING        = 1
000000r 2               PLAY_GLOW           = 2
000000r 2               PLAY_SHATTER        = 3
000000r 2               PLAY_GRAVITY        = 4
000000r 2               PLAY_ARE            = 5
000000r 2               
000000r 2               ; --- Buffer sizes (SPEC 17.1) ------------------------------------------------
000000r 2               MARKS_BYTES         = 16        ; One byte per row, bits 0-5
000000r 2               EFFECTQ_ENTRIES     = 48        ; ONE byte each — the board index of a pending
000000r 2               EFFECTQ_BYTES       = EFFECTQ_ENTRIES   ;   detonation, and nothing else.
000000r 2                                               ;   SPEC 8 budgeted two bytes for a packed
000000r 2                                               ;   glyph/row/column, which is a copy of what
000000r 2                                               ;   the board already holds: cells are not
000000r 2                                               ;   zeroed until step 6 and the queue is drained
000000r 2                                               ;   in step 4, so the tile is still there when
000000r 2                                               ;   the effect pops and its glyph and colour are
000000r 2                                               ;   one `lda Board,x` away. Half the RAM for
000000r 2                                               ;   nothing (SPEC 17.1).
000000r 2                                               ;   A ring keeps one slot free, so 47 pending
000000r 2                                               ;   detonations. On overflow an effect is
000000r 2                                               ;   dropped rather than growing the buffer (D6);
000000r 2                                               ;   at one reagent a piece it is not reachable.
000000r 2               DIRTY_ENTRIES       = 64        ; 3 bytes each: offset lo, offset hi, tile
000000r 2               DIRTY_BYTES         = DIRTY_ENTRIES * 3
000000r 2               DIRTY_FLUSH_MAX     = 24        ; Cells pushed to the screen per frame.
000000r 2                                               ;   MEASURED, not estimated (PLAN.md S1). A
000000r 2                                               ;   flush costs 165 cycles a cell on the
000000r 2                                               ;   AC6502 and about 132 on the Commodores, so
000000r 2                                               ;   24 cells is 3965 cycles — inside vertical
000000r 2                                               ;   blank on all three, and tightest on the
000000r 2                                               ;   AC6502 at 1 MHz, whose 70 blank lines are
000000r 2                                               ;   roughly 4450. It is also a quarter of the
000000r 2                                               ;   96-cell well, so a full redraw is exactly
000000r 2                                               ;   four frames.
000000r 2                                               ;   Overrunning vblank is not dangerous on any
000000r 2                                               ;   of the three — no VRAM write spacing is
000000r 2                                               ;   anywhere near violated (S1) — it only
000000r 2                                               ;   risks a cell landing a frame late. This is
000000r 2                                               ;   a budget, not a hardware limit.
000000r 2               
000000r 1               .include "../src/zeropage.inc"
000000r 2               ; =============================================================================
000000r 2               ;   zeropage.inc — Wizards Lab, zero page allocation
000000r 2               ; =============================================================================
000000r 2               ;   The ZEROPAGE segment is placed at $40 on every platform. That window is
000000r 2               ;   free on all three:
000000r 2               ;
000000r 2               ;     AC6502   $003A-$00FF free for user programs (6502.inc memory map)
000000r 2               ;     VIC-20   all of page zero, once the cartridge stops calling the KERNAL
000000r 2               ;     C64      all of page zero EXCEPT $00/$01, which are the processor port
000000r 2               ;
000000r 2               ;   Starting at $40 clears the C64's port bytes and the AC6502's system
000000r 2               ;   scratch with room to spare, and keeps one number in three linker configs.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               .segment "ZEROPAGE"
000000r 2               
000000r 2  xx xx        Ptr1:           .res 2      ; General pointer — free across any call boundary
000002r 2  xx xx        Ptr2:           .res 2      ; General pointer
000004r 2  xx xx        SrcPtr:         .res 2      ; Block copy source
000006r 2  xx xx        DstPtr:         .res 2      ; Block copy destination
000008r 2  xx xx        ScreenPtr:      .res 2      ; Current screen row base
00000Ar 2  xx xx        ColorPtr:       .res 2      ; Current colour RAM row base (Commodore only)
00000Cr 2               
00000Cr 2  xx           RngLo:          .res 1      ; 16-bit LFSR state — never both zero
00000Dr 2  xx           RngHi:          .res 1
00000Er 2               
00000Er 2  xx           Tmp0:           .res 1      ; Scratch. Never live across a JSR.
00000Fr 2  xx           Tmp1:           .res 1
000010r 2  xx           Tmp2:           .res 1
000011r 2  xx           Tmp3:           .res 1
000012r 2               
000012r 2               ; --- The match scanner (SPEC 6.2) --------------------------------------------
000012r 2               ;   One line of one pass at a time. The cursor is a BOARD INDEX rather than a
000012r 2               ;   row and a column, because all four passes are the same walk with a
000012r 2               ;   different step: +1 horizontal, +8 vertical, +9 diagonal, +7 anti-diagonal.
000012r 2  xx           ScanIdx:        .res 1      ; Where the cursor was when a run ended: ScanLine
000013r 2                                           ;   keeps it in X and spills it only here
000013r 2  xx           ScanStep:       .res 1      ; What to add to reach the next cell of this line
000014r 2  xx           ScanColor:      .res 1      ; Colour key of the run in progress ($FF = unset)
000015r 2  xx           ScanLen:        .res 1      ; Cells in it so far, wildcards included
000016r 2  xx           ScanEnd:        .res 1      ; Walk-back cursor while a finished run is marked
000017r 2  xx           ScanTop:        .res 1      ; Row base of the top of the pile. Every pass
000018r 2                                           ;   starts there rather than at row 0, which is
000018r 2                                           ;   most of the cost of a scan (match.asm)
000018r 2               
000018r 2               ; --- Board walks that call the renderer (SPEC 8 steps 6 and 8) ---------------
000018r 2               ;   RenderCell clobbers A, X and Y, so a walk that marks what it changes
000018r 2               ;   cannot keep its cursor in a register. GravIdx also has to survive from one
000018r 2               ;   frame to the next: a row of falling is a cursor and not a bulk enqueue,
000018r 2               ;   because a full well is more cells than the dirty ring holds (D12,
000018r 2               ;   SPEC 12.6).
000018r 2  xx           GravIdx:        .res 1      ; Cell the fall is walking up from, $FF when the
000019r 2                                           ;   row is finished
000019r 2  xx           GravMoved:      .res 1      ; Non-zero if this row of falling moved anything
00001Ar 2  xx           CellCount:      .res 1      ; Cells CascadeRemove has taken off the board
00001Br 2               
00001Br 2               ; --- Reagent effects (SPEC 7.3, SPEC 8 step 4) -------------------------------
00001Br 2               ;   EffectHit marks a cell, scores it and enqueues whatever it holds, so it
00001Br 2               ;   clobbers A, X and Y — which means a walk that offers it cells cannot keep
00001Br 2               ;   its cursor in a register either. Same reason GravIdx exists, and the same
00001Br 2               ;   reason these are not Tmp0-Tmp3: those are dead across a JSR.
00001Br 2  xx           EffectIdx:      .res 1      ; The cell the walk in progress is on
00001Cr 2  xx           EffectEnd:      .res 1      ; Where it stops. The bolt's row end, or the bomb's
00001Dr 2                                           ;   last row
00001Dr 2  xx           EffectRow:      .res 1      ; First cell of the bomb's current row
00001Er 2  xx           EffectArg:      .res 1      ; What the walk is looking for: the fireball's
00001Fr 2                                           ;   colour key, or the bomb's last column
00001Fr 2               
00001Fr 2               ; --- Animation walks (SPEC 14) -----------------------------------------------
00001Fr 2               ;   The glow, the beams and the shatter all walk MARKS and mark what they find,
00001Fr 2               ;   so their cursors cannot live in registers either — RenderMark clobbers A
00001Fr 2               ;   and X. There are two of them because the beam pass NESTS: the outer walk is
00001Fr 2               ;   over the marked cells, looking for bolts, and the inner one is over the
00001Fr 2               ;   cross each bolt draws.
00001Fr 2  xx           AnimMode:       .res 1      ; Which of the four the walk is doing
000020r 2  xx           AnimIdx:        .res 1      ; Outer cursor — the marked cell being animated
000021r 2  xx           AnimCur:        .res 1      ; Inner cursor — the beam cell being drawn
000022r 2  xx           AnimEnd:        .res 1      ; Where the inner walk stops
000023r 2  xx           AnimArg:        .res 1      ; What it is drawing, or the bolt's own column
000024r 2               
000024r 2               ; --- Render and text scratch -------------------------------------------------
000024r 2               ;   These ARE live across a JSR, unlike Tmp0-Tmp3, because text.asm calls
000024r 2               ;   RenderMark once per cell and has to remember where it is. That is safe
000024r 2               ;   only because RenderMark touches nothing here: it clobbers A, X and the
000024r 2               ;   stack and nothing else (see render.asm). Do not call anything else from a
000024r 2               ;   loop that holds one of these.
000024r 2  xx           TextCol:        .res 1      ; Panel column the next glyph goes in
000025r 2  xx           TextRow:        .res 1      ; Panel row the string is drawn on
000026r 2  xx           TextIdx:        .res 1      ; Cursor within the string, or the BCD byte index
000027r 2  xx           TextByte:       .res 1      ; The BCD byte being split into two digits
000028r 2  xx           TextSkip:       .res 1      ; Non-zero while the first high nibble is skipped
000029r 2  xx           FlushLeft:      .res 1      ; Cells left in this frame's flush budget
00002Ar 2  xx           RedrawCol:      .res 1      ; Panel column of the cell being marked. Shared by
00002Br 2                                           ;   every routine that marks a run of cells in one
00002Br 2                                           ;   column, because RenderMark clobbers X.
00002Br 2               
00002Br 1               .include "../src/ram.inc"
00002Br 2               ; =============================================================================
00002Br 2               ;   ram.inc — Wizards Lab, work RAM
00002Br 2               ; =============================================================================
00002Br 2               ;   SPEC.md section 17.1. Around 530 bytes, which is what lets the whole game
00002Br 2               ;   fit the VIC-20's 1 KB of usable work RAM — the tightest of the three
00002Br 2               ;   targets, and therefore the one the layout is designed against.
00002Br 2               ;
00002Br 2               ;   Every platform places the BSS segment somewhere different (see each
00002Br 2               ;   linker config); nothing in this file cares where.
00002Br 2               ; =============================================================================
00002Br 2               
00002Br 2               .segment "BSS"
000000r 2               
000000r 2               ; --- The board (SPEC 3.2) ----------------------------------------------------
000000r 2               ;   20 rows x 8 stride. Columns 6-7 of every row and rows 16-19 entirely are
000000r 2               ;   permanent $FF sentinels, so scans walk off the edge and stop by themselves.
000000r 2               ;   Page-align it: address(row,col) = Board + (row << 3) + col.
000000r 2               .align 256
000000r 2  xx xx xx xx  Board:          .res BOARD_BYTES
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
0000A0r 2               
0000A0r 2               ; --- Match / cascade state (SPEC 6.2, 8) -------------------------------------
0000A0r 2  xx xx xx xx  Marks:          .res MARKS_BYTES        ; One byte per row, bits 0-5 = columns
0000A4r 2  xx xx xx xx  
0000A8r 2  xx xx xx xx  
0000B0r 2  xx xx xx xx  EffectQ:        .res EFFECTQ_BYTES      ; Ring of pending reagent detonations —
0000B4r 2  xx xx xx xx  
0000B8r 2  xx xx xx xx  
0000E0r 2                                                       ;   the board INDEX of each, one byte,
0000E0r 2                                                       ;   because the tile is still on the
0000E0r 2                                                       ;   board when the entry pops
0000E0r 2                                                       ;   (constants.inc, SPEC 8)
0000E0r 2  xx           EffectQHead:    .res 1
0000E1r 2  xx           EffectQTail:    .res 1
0000E2r 2  xx           RunCount:       .res 1                  ; Runs resolved in the current step
0000E3r 2  xx           ChainStep:      .res 1                  ; 1 on the first step of a cascade
0000E4r 2  xx           StarCount:      .res 1                  ; Doublings pending, capped at 3
0000E5r 2  xx           CascadeLo:      .res 1                  ; Cascade point accumulator, packed BCD
0000E6r 2  xx           CascadeMid:     .res 1
0000E7r 2  xx           CascadeHi:      .res 1
0000E8r 2               
0000E8r 2               ; --- Animation (SPEC 14) -----------------------------------------------------
0000E8r 2  xx           AnimStep:       .res 1                  ; Ring frame the shatter is showing,
0000E9r 2                                                       ;   0 .. AnimSteps - 1
0000E9r 2  xx           AnimSteps:      .res 1                  ; SHATTER_STEPS, or BLIP_STEPS when a
0000EAr 2                                                       ;   marked prism is blipping out along
0000EAr 2                                                       ;   with the rest (constants.inc)
0000EAr 2  xx           TintColor:      .res 1                  ; Colour key currently drawn WHITE — the
0000EBr 2                                                       ;   fireball flash (SPEC 4.6) — or
0000EBr 2                                                       ;   TINT_NONE. Read by HalPlotCell on
0000EBr 2                                                       ;   the Commodores and written to the
0000EBr 2                                                       ;   VDP colour table on the AC6502;
0000EBr 2                                                       ;   HalColorFlash is the only thing that
0000EBr 2                                                       ;   sets it (hal.inc)
0000EBr 2  xx           PrismFrame:     .res 1                  ; Idle rotation frame, 0-3
0000ECr 2  xx           PrismTimer:     .res 1                  ; Frames until the next one
0000EDr 2  xx           PetrifyRow:     .res 1                  ; Board row the game-over petrify is
0000EEr 2                                                       ;   working up from, $FF when it is done
0000EEr 2               
0000EEr 2               ; --- Render (SPEC 12.6) ------------------------------------------------------
0000EEr 2               ;   A ring of DIRTY_ENTRIES cells waiting to be pushed to the screen, three
0000EEr 2               ;   bytes each: SCREEN column, SCREEN row, tile. Not a 16-bit screen offset —
0000EEr 2               ;   HalPlotCell takes a column and a row (hal.inc), and every platform reaches
0000EEr 2               ;   a cell through a per-row pointer table (SPEC 12.3), so an offset would only
0000EEr 2               ;   have to be taken apart again at the far end.
0000EEr 2               ;
0000EEr 2               ;   A ring rather than a list with a resume index, because a frame that flushes
0000EEr 2               ;   its cap leaves a remainder and the next frame's marks have to go somewhere.
0000EEr 2               ;   Head and tail are BYTE offsets into Dirty, not entry numbers, so stepping
0000EEr 2               ;   one entry is an add of 3 and never a multiply.
0000EEr 2  xx xx xx xx  Dirty:          .res DIRTY_BYTES        ; screen col, screen row, tile
0000F2r 2  xx xx xx xx  
0000F6r 2  xx xx xx xx  
0001AEr 2  xx           DirtyCount:     .res 1                  ; Entries pending, 0..DIRTY_ENTRIES
0001AFr 2  xx           DirtyHead:      .res 1                  ; Byte offset of the oldest pending
0001B0r 2  xx           DirtyTail:      .res 1                  ; Byte offset the next mark goes to
0001B1r 2  xx           RedrawIdx:      .res 1                  ; Board index RenderBoardStep resumes
0001B2r 2                                                       ;   at, or $FF when no redraw is
0001B2r 2                                                       ;   outstanding
0001B2r 2               
0001B2r 2               ; --- The falling piece (SPEC 5) ----------------------------------------------
0001B2r 2  xx           PieceCol:       .res 1
0001B3r 2  xx           PieceRow:       .res 1                  ; Row of cell A (the top cell)
0001B4r 2  xx           PieceA:         .res 1                  ; Tile bytes, top to bottom
0001B5r 2  xx           PieceB:         .res 1
0001B6r 2  xx           PieceC:         .res 1
0001B7r 2  xx           NextA:          .res 1                  ; The preview piece
0001B8r 2  xx           NextB:          .res 1
0001B9r 2  xx           NextC:          .res 1
0001BAr 2  xx           PieceDirty:     .res 1                  ; Non-zero when the three cells need
0001BBr 2                                                       ;   drawing. Not drawn on the spot,
0001BBr 2                                                       ;   because a full-board redraw may be
0001BBr 2                                                       ;   in flight and would paint over
0001BBr 2                                                       ;   them — see StatePlay (D14).
0001BBr 2               
0001BBr 2               ; --- Progress (SPEC 9, 10) ---------------------------------------------------
0001BBr 2  xx           ScoreLo:        .res 1                  ; 7 digits packed BCD, low byte first;
0001BCr 2  xx           ScoreMid:       .res 1                  ;   the top nibble of ScoreTop stays 0
0001BDr 2  xx           ScoreHi:        .res 1
0001BEr 2  xx           ScoreTop:       .res 1
0001BFr 2  xx           HighLo:         .res 1
0001C0r 2  xx           HighMid:        .res 1
0001C1r 2  xx           HighHi:         .res 1
0001C2r 2  xx           HighTop:        .res 1
0001C3r 2  xx           HighLevel:      .res 1                  ; Level the high score was set on, BCD
0001C4r 2  xx           HighOwned:      .res 1                  ; Non-zero once THIS game has taken the
0001C5r 2                                                       ;   high score. From the overtake on,
0001C5r 2                                                       ;   score and high score are equal and
0001C5r 2                                                       ;   every bank copies again, so without
0001C5r 2                                                       ;   this the one-shot fanfare and flash
0001C5r 2                                                       ;   would fire on every one (SPEC 9.8)
0001C5r 2  xx           HighFlash:      .res 1                  ; Half-blinks of the HIGH field left to
0001C6r 2                                                       ;   run. Odd = dark, even = lit, and it
0001C6r 2                                                       ;   ends at zero, so the field is always
0001C6r 2                                                       ;   left readable
0001C6r 2  xx           HighTimer:      .res 1                  ; Frames until the next half-blink
0001C7r 2  xx           Level:          .res 1                  ; Binary, 1-99
0001C8r 2  xx           TilesCleared:   .res 1                  ; Toward the next level, carries past 30
0001C9r 2               
0001C9r 2               ; --- Timers, all in frames (SPEC 14) -----------------------------------------
0001C9r 2  xx           GravityTimer:   .res 1
0001CAr 2  xx           LockTimer:      .res 1
0001CBr 2  xx           LockResets:     .res 1
0001CCr 2  xx           DasTimer:       .res 1
0001CDr 2  xx           DasDir:         .res 1
0001CEr 2  xx           AreTimer:       .res 1
0001CFr 2  xx           AnimTimer:      .res 1
0001D0r 2  xx           BannerTimer:    .res 1
0001D1r 2  xx           FrameCounter:   .res 1                  ; Free-running from power-on; seeds RNG
0001D2r 2               
0001D2r 2               ; --- Input (SPEC 11.1) -------------------------------------------------------
0001D2r 2  xx           InputNow:       .res 1
0001D3r 2  xx           InputPrev:      .res 1
0001D4r 2  xx           InputEdge:      .res 1                  ; Newly pressed this frame
0001D5r 2               
0001D5r 2               ; --- State machine (SPEC 13) -------------------------------------------------
0001D5r 2  xx           GameState:      .res 1                  ; STATE_*
0001D6r 2  xx           PlayState:      .res 1                  ; PLAY_*
0001D7r 2  xx           TitlePage:      .res 1
0001D8r 2  xx           Region:         .res 1                  ; 0 = NTSC, 1 = PAL
0001D9r 2  xx           NeedsRedraw:    .res 1
0001DAr 2               
0001DAr 2               ; --- Audio (SPEC 16) ---------------------------------------------------------
0001DAr 2  xx           SfxRequest:     .res 1                  ; Written by logic, consumed by AudioTick
0001DBr 2  xx           SfxTimer:       .res 1
0001DCr 2  xx xx xx xx  SfxState:       .res 14
0001E0r 2  xx xx xx xx  
0001E4r 2  xx xx xx xx  
0001EAr 2               
0001EAr 1               .include "../src/hal.inc"
0001EAr 2               ; =============================================================================
0001EAr 2               ;   hal.inc — Wizards Lab, the platform contract
0001EAr 2               ; =============================================================================
0001EAr 2               ;   Everything in src/ is shared, unmodified, by all three machines. The only
0001EAr 2               ;   things that differ are collected here: each platform's WizardsLab.asm must
0001EAr 2               ;   define these constants and implement these eight routines, and nothing
0001EAr 2               ;   else in src/ may touch hardware directly.
0001EAr 2               ;
0001EAr 2               ;   This file declares nothing. It is the documentation for the boundary, kept
0001EAr 2               ;   next to the code it constrains so it cannot drift out of date unnoticed.
0001EAr 2               ;
0001EAr 2               ;   CONSTANTS the platform must define BEFORE including the shared sources
0001EAr 2               ;   ---------------------------------------------------------------------
0001EAr 2               ;     PANEL_X, PANEL_Y      Where the 22 x 24 panel sits on this screen.
0001EAr 2               ;                             AC6502  5, 0      VIC-20  0, 0      C64  9, 0
0001EAr 2               ;                           PANEL_Y is 0 everywhere; the VIC-20 clips panel
0001EAr 2               ;                           row 23 and the C64 has one spare row below it.
0001EAr 2               ;     SCR_COLS           32 / 22 / 40
0001EAr 2               ;     SCR_ROWS           24 / 23 / 25
0001EAr 2               ;     HAS_COLOR_RAM         1 on the Commodores, 0 on the AC6502, whose colour
0001EAr 2               ;                           lives in the VDP colour table instead.
0001EAr 2               ;
0001EAr 2               ;   ROUTINES the platform must implement
0001EAr 2               ;   ------------------------------------
0001EAr 2               ;     HalInitVideo      Bring up the video hardware: black background and
0001EAr 2               ;                       border, the correct text/tile mode, tileset in place,
0001EAr 2               ;                       colours configured, screen cleared. Called once.
0001EAr 2               ;                       In:  nothing        Out: nothing
0001EAr 2               ;
0001EAr 2               ;     HalWaitFrame      Block until the start of the next vertical blank.
0001EAr 2               ;                       Everything below is called only between frames.
0001EAr 2               ;                       In:  nothing        Out: nothing
0001EAr 2               ;
0001EAr 2               ;     HalPlotCell       Write one cell, colour included where the platform has
0001EAr 2               ;                       per-cell colour — white instead, for any tile whose
0001EAr 2               ;                       colour key is TintColor (see HalColorFlash).
0001EAr 2               ;                       In:  A = tile, X = screen column, Y = screen row
0001EAr 2               ;                       Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
0001EAr 2               ;
0001EAr 2               ;     HalBlitScreen     Draw a whole static screen from a name-table image in
0001EAr 2               ;                       ROM: SCR_COLS * SCR_ROWS bytes, row-major, plus
0001EAr 2               ;                       the matching colour image where the platform needs one.
0001EAr 2               ;                       In:  SrcPtr -> name table, Ptr1 -> colour table
0001EAr 2               ;                       Out: nothing
0001EAr 2               ;
0001EAr 2               ;     HalReadInput      Read stick and keyboard, fold both into one mask.
0001EAr 2               ;                       In:  nothing
0001EAr 2               ;                       Out: A = INPUT_* bits, ACTIVE HIGH
0001EAr 2               ;
0001EAr 2               ;     HalDetectRegion   Decide NTSC or PAL so the timing tables can be picked.
0001EAr 2               ;                       In:  nothing        Out: A = 0 NTSC, 1 PAL
0001EAr 2               ;
0001EAr 2               ;     HalColorFlash     Draw every tile of one colour white, or stop doing so.
0001EAr 2               ;                       The fireball's detonation (SPEC 4.6, 14).
0001EAr 2               ;                       In:  A = colour key ($40..$68), or TINT_NONE for none
0001EAr 2               ;                       Out: nothing.  Modifies: A, X, Y, and TintColor, which
0001EAr 2               ;                            it OWNS: nothing else may write that byte.
0001EAr 2               ;                       The platform must handle the transition, not just the
0001EAr 2               ;                       new value — a second call with a different colour puts
0001EAr 2               ;                       the first one back before lighting the second.
0001EAr 2               ;                       On the AC6502 this is ONE byte in the VDP colour table,
0001EAr 2               ;                       because a tile's colour there belongs to its 8-pattern
0001EAr 2               ;                       group and not to the cell. On the Commodores colour is
0001EAr 2               ;                       per cell, so HalPlotCell reads TintColor instead and
0001EAr 2               ;                       substitutes white for any tile of that colour as it
0001EAr 2               ;                       draws it — which also means every tinted cell has to be
0001EAr 2               ;                       re-marked, and the animation is already marking all of
0001EAr 2               ;                       them (anim.asm).
0001EAr 2               ;
0001EAr 2               ;     HalSfx            Start a sound effect. May be a bare RTS until audio
0001EAr 2               ;                       exists.
0001EAr 2               ;                       In:  A = effect id (SPEC 16)
0001EAr 2               ;                       Out: nothing
0001EAr 2               ;
0001EAr 2               ;   The shared code assumes nothing about interrupts. Each platform may drive
0001EAr 2               ;   HalWaitFrame from a raster IRQ, a timer, or a status-register poll.
0001EAr 2               ; =============================================================================
0001EAr 2               
0001EAr 1               
0001EAr 1               ; =============================================================================
0001EAr 1               ;   Cartridge entry
0001EAr 1               ; =============================================================================
0001EAr 1               
0001EAr 1               .segment "CODE"
000000r 1               
000000r 1               CartReset:
000000r 1  78             sei
000001r 1  D8             cld
000002r 1  A2 FF          ldx #$FF
000004r 1  9A             txs                           ; Nothing did this for us
000005r 1  20 78 A0       jsr KernalInit                ; Probe and initialise every card, IRQs left off
000008r 1               
000008r 1  20 rr rr       jsr GameInit                  ; Never returns
00000Br 1               
00000Br 1               ; --- Shared game code --------------------------------------------------------
00000Br 1               .include "../src/main.asm"
00000Br 2               ; =============================================================================
00000Br 2               ;   main.asm — Wizards Lab, shared entry point and main loop
00000Br 2               ; =============================================================================
00000Br 2               ;   Included by every platform's WizardsLab.asm after that file has defined
00000Br 2               ;   PANEL_X / PANEL_Y and its half of the HAL (see hal.inc). Nothing below
00000Br 2               ;   touches hardware.
00000Br 2               ;
00000Br 2               ;   BUILD STATUS
00000Br 2               ;   ------------
00000Br 2               ;   Pieces spawn, steer, rotate, fall and lock, runs of three or more clear,
00000Br 2               ;   the pile falls into the holes, chains keep going until nothing matches, all
00000Br 2               ;   of it scores and ramps the level, the five reagents fire and set each other
00000Br 2               ;   off, and a clear now glows and shatters on the frame clock instead of
00000Br 2               ;   happening between two frames (PLAN.md P2 to P6). What is left is the
00000Br 2               ;   screens either side of play (P7) and the sound (P8).
00000Br 2               ; =============================================================================
00000Br 2               
00000Br 2               ; -----------------------------------------------------------------------------
00000Br 2               ;   GameInit — one-time setup, called from the cartridge entry point
00000Br 2               ; -----------------------------------------------------------------------------
00000Br 2               GameInit:
00000Br 2  20 rr rr       jsr HalDetectRegion
00000Er 2  8D rr rr       sta Region
000011r 2               
000011r 2  20 rr rr       jsr HalInitVideo              ; Tiles in place, screen black and cleared
000014r 2  20 rr rr       jsr AudioInit
000017r 2  20 rr rr       jsr RenderDirtyReset
00001Ar 2               
00001Ar 2  A9 00          lda #0
00001Cr 2  8D rr rr       sta FrameCounter
00001Fr 2  20 rr rr       jsr RngSeed                   ; A zero LFSR state sticks at zero forever, and
000022r 2                                               ;   BSS is not cleared on all three machines, so
000022r 2                                               ;   seed it once here just to get it out of that
000022r 2                                               ;   hole. This is NOT the game's seed — SPEC 15
000022r 2                                               ;   forbids a constant one, and StateTitle
000022r 2                                               ;   reseeds from the player's reaction time
000022r 2                                               ;   before the first piece is ever rolled.
000022r 2  A9 00          lda #0
000024r 2  8D rr rr       sta InputNow
000027r 2  8D rr rr       sta InputPrev
00002Ar 2  8D rr rr       sta InputEdge
00002Dr 2  8D rr rr       sta TitlePage
000030r 2  A9 01          lda #1
000032r 2  8D rr rr       sta PrismTimer                ; A zero here would DEC to 255 and stall the
000035r 2                                               ;   prism's rotation for four seconds
000035r 2  A9 01          lda #TINT_NONE                ; BSS is not cleared on all three machines, and
000037r 2  8D rr rr       sta TintColor                 ;   a garbage colour key here would draw the
00003Ar 2                                               ;   title screen's tiles of that colour white
00003Ar 2                                               ;   on the Commodores. Set before anything
00003Ar 2                                               ;   plots a cell, not in HalColorFlash, which
00003Ar 2                                               ;   reads it to undo the last flash (hal.inc).
00003Ar 2               
00003Ar 2  20 rr rr       jsr ScoreHighInit             ; Once a session, before the first ScoreReset
00003Dr 2  20 rr rr       jsr ScoreReset
000040r 2  20 rr rr       jsr BoardClear
000043r 2               
000043r 2               .ifdef WL_DEBUG
000043r 2  20 rr rr       jsr GameStart                 ; TEMPORARY: skip the title and start playing,
000046r 2                                               ;   because a headless machine has no input
000046r 2                                               ;   attached and would sit on the title screen
000046r 2                                               ;   forever. Nothing else about the build
000046r 2                                               ;   differs any more (PLAN.md section 3).
000046r 2               .else
000046r 2                 lda #STATE_TITLE
000046r 2                 sta GameState
000046r 2                 lda #1
000046r 2                 sta NeedsRedraw
000046r 2               .endif
000046r 2                 ; falls through into GameLoop
000046r 2               
000046r 2               ; -----------------------------------------------------------------------------
000046r 2               ;   GameLoop — never returns
000046r 2               ; -----------------------------------------------------------------------------
000046r 2               GameLoop:
000046r 2  20 rr rr       jsr HalWaitFrame
000049r 2  EE rr rr       inc FrameCounter              ; Free-running from power-on; seeds the RNG
00004Cr 2               
00004Cr 2  20 rr rr       jsr RenderFlush               ; Screen writes happen in vertical blank only
00004Fr 2  20 rr rr       jsr InputPoll
000052r 2               
000052r 2  AD rr rr       lda GameState                 ; Dispatch on the current screen state
000055r 2  C9 00          cmp #STATE_TITLE
000057r 2  F0 0E          beq @Title
000059r 2  C9 01          cmp #STATE_PLAY
00005Br 2  F0 10          beq @Play
00005Dr 2  C9 02          cmp #STATE_PAUSE
00005Fr 2  F0 12          beq @Pause
000061r 2  20 rr rr       jsr StateGameOver             ; JSR, not JMP — every state handler ends in an
000064r 2  4C rr rr       jmp @Audio                    ;   RTS, and a JMP here would hand that RTS the
000067r 2                                               ;   return address of the JSR GameInit that the
000067r 2                                               ;   cart entry point never expects back. The
000067r 2                                               ;   first loss unwound the loop into GameInit;
000067r 2                                               ;   the second pulled from an empty stack.
000067r 2               
000067r 2               @Title:
000067r 2  20 rr rr       jsr StateTitle
00006Ar 2  4C rr rr       jmp @Audio
00006Dr 2               @Play:
00006Dr 2  20 rr rr       jsr StatePlay
000070r 2  4C rr rr       jmp @Audio
000073r 2               @Pause:
000073r 2  20 rr rr       jsr StatePause
000076r 2               
000076r 2               @Audio:
000076r 2  20 rr rr       jsr AudioTick
000079r 2  4C rr rr       jmp GameLoop
00007Cr 2               
00007Cr 2               ; =============================================================================
00007Cr 2               ;   States (SPEC 13)
00007Cr 2               ; =============================================================================
00007Cr 2               
00007Cr 2               ; -----------------------------------------------------------------------------
00007Cr 2               ;   StateTitle — blinking prompt over the drawn screen, and the magic field
00007Cr 2               ;   SPEC 13.1. There are no help pages: the controls are part of the screen
00007Cr 2               ;   image, so the only things moving here are the prompt and the field.
00007Cr 2               ; -----------------------------------------------------------------------------
00007Cr 2               StateTitle:
00007Cr 2  AD rr rr       lda NeedsRedraw
00007Fr 2  F0 0B          beq @Live
000081r 2  A9 00          lda #0
000083r 2  8D rr rr       sta NeedsRedraw
000086r 2  20 rr rr       jsr DrawTitleScreen
000089r 2  20 rr rr       jsr RenderDirtyReset          ; A full blit went behind the renderer's back
00008Cr 2               
00008Cr 2               @Live:
00008Cr 2                 ; TODO: blink the prompt every 30 frames, and shimmer the magic field —
00008Cr 2                 ; one NextRandom for a cell in the 14 x 2 block, one for a tile in
00008Cr 2                 ; ART_BASE..ART_BASE+ART_TILES-1, one RenderMark.
00008Cr 2  AD rr rr       lda InputEdge
00008Fr 2  29 11          and #(INPUT_FIRE | INPUT_UP)  ; Fire, or SPACE, which the keyboards fold
000091r 2  F0 06          beq @Done                     ;   into UP so it can rotate in play (D15)
000093r 2               
000093r 2  20 rr rr       jsr RngSeed                   ; SPEC 15 — seed from reaction time, not a constant
000096r 2  20 rr rr       jsr GameStart
000099r 2               @Done:
000099r 2  60             rts
00009Ar 2               
00009Ar 2               ; -----------------------------------------------------------------------------
00009Ar 2               ;   GameStart — enter play from the title screen
00009Ar 2               ; -----------------------------------------------------------------------------
00009Ar 2               GameStart:
00009Ar 2  20 rr rr       jsr ScoreReset
00009Dr 2  20 rr rr       jsr BoardClear
0000A0r 2               
0000A0r 2  A9 01          lda #1
0000A2r 2  8D rr rr       sta Level
0000A5r 2  A9 00          lda #0
0000A7r 2  8D rr rr       sta TilesCleared
0000AAr 2  8D rr rr       sta DasDir                    ; No direction is held into a new game
0000ADr 2  8D rr rr       sta DasTimer
0000B0r 2  8D rr rr       sta PieceDirty
0000B3r 2  8D rr rr       sta BannerTimer               ; Nothing from the last game is still up
0000B6r 2  8D rr rr       sta PrismFrame
0000B9r 2  A9 01          lda #1
0000BBr 2  8D rr rr       sta PrismTimer
0000BEr 2  A9 01          lda #TINT_NONE                ; ...and no colour is still flashing white, on
0000C0r 2  20 rr rr       jsr HalColorFlash             ;   a machine where that is a VDP register and
0000C3r 2                                               ;   not a byte of RAM (SPEC 4.6)
0000C3r 2               
0000C3r 2  20 rr rr       jsr DrawPlayScreen            ; The whole screen at once, behind the
0000C6r 2  20 rr rr       jsr RenderDirtyReset          ;   renderer's back — so drop anything queued
0000C9r 2                                               ;   against the screen that just went away
0000C9r 2               
0000C9r 2  20 rr rr       jsr TextBannerClear           ; The play image ships with the band reading
0000CCr 2                                               ;   `~~ PAUSED ~~` (SPEC 12.1); play owns it
0000CCr 2  20 rr rr       jsr RenderScore               ; The panel fields are code's, not the image's
0000CFr 2  20 rr rr       jsr RenderHigh
0000D2r 2  20 rr rr       jsr RenderLevel
0000D5r 2  20 rr rr       jsr RenderBoard               ; Queued across as many frames as it takes
0000D8r 2               
0000D8r 2  20 rr rr       jsr PieceGenerateNext         ; Fill the preview...
0000DBr 2  20 rr rr       jsr PieceSpawn                ; ...then promote it and refill. The board is
0000DEr 2  20 rr rr       jsr PieceGenerateNext         ;   empty, so the spawn cannot be blocked.
0000E1r 2  20 rr rr       jsr RenderNext
0000E4r 2               
0000E4r 2  A9 00          lda #PLAY_FALLING
0000E6r 2  8D rr rr       sta PlayState
0000E9r 2  A9 01          lda #STATE_PLAY
0000EBr 2  8D rr rr       sta GameState
0000EEr 2  60             rts
0000EFr 2               
0000EFr 2               ; -----------------------------------------------------------------------------
0000EFr 2               ;   StatePlay — the game
0000EFr 2               ;   SPEC 13.2. One frame is: advance whatever the play sub-state is doing,
0000EFr 2               ;   then queue whatever changed. Cascades run as sub-states rather than in a
0000EFr 2               ;   blocking loop so animation stays on the frame clock.
0000EFr 2               ; -----------------------------------------------------------------------------
0000EFr 2               StatePlay:
0000EFr 2  20 rr rr       jsr ScoreFlashTick            ; SPEC 9.8 — the HIGH field blinking after an
0000F2r 2                                               ;   overtake. Play never stops for it, so it
0000F2r 2                                               ;   ticks alongside whatever the sub-state is
0000F2r 2                                               ;   doing rather than inside one.
0000F2r 2  20 rr rr       jsr AnimBannerTick            ; ...and neither does it for a banner (SPEC 14)
0000F5r 2  20 rr rr       jsr AnimPrismTick             ; ...nor for the one tile that moves at rest
0000F8r 2               
0000F8r 2  AD rr rr       lda InputEdge
0000FBr 2  29 20          and #INPUT_PAUSE
0000FDr 2  D0 52          bne @ToPause
0000FFr 2               
0000FFr 2  AD rr rr       lda PlayState
000102r 2  C9 00          cmp #PLAY_FALLING
000104r 2  F0 17          beq @Falling
000106r 2  C9 01          cmp #PLAY_LOCKING
000108r 2  F0 19          beq @Locking
00010Ar 2  C9 02          cmp #PLAY_GLOW
00010Cr 2  F0 1B          beq @Glow
00010Er 2  C9 03          cmp #PLAY_SHATTER
000110r 2  F0 1D          beq @Shatter
000112r 2  C9 04          cmp #PLAY_GRAVITY
000114r 2  F0 1F          beq @Gravity
000116r 2  C9 05          cmp #PLAY_ARE
000118r 2  F0 21          beq @Are
00011Ar 2  4C rr rr       jmp @Draw                     ; Not a state anything sets
00011Dr 2               
00011Dr 2               @Falling:
00011Dr 2  20 rr rr       jsr PlayFalling
000120r 2  4C rr rr       jmp @Draw
000123r 2               @Locking:
000123r 2  20 rr rr       jsr PlayLocking
000126r 2  4C rr rr       jmp @Draw
000129r 2               @Glow:
000129r 2  20 rr rr       jsr PlayGlow
00012Cr 2  4C rr rr       jmp @Draw
00012Fr 2               @Shatter:
00012Fr 2  20 rr rr       jsr PlayShatter
000132r 2  4C rr rr       jmp @Draw
000135r 2               @Gravity:
000135r 2  20 rr rr       jsr PlayGravity
000138r 2  4C rr rr       jmp @Draw
00013Br 2               @Are:
00013Br 2  20 rr rr       jsr PlayAre
00013Er 2               
00013Er 2                 ; --- draw the piece, once whatever else wanted the screen has finished ----
00013Er 2                 ;   D14. RenderBoard is a cursor that feeds the ring over several frames
00013Er 2                 ;   (D12), so marks made while one is outstanding are drawn BEFORE the
00013Er 2                 ;   redraw reaches those cells and are then painted over. Holding the piece
00013Er 2                 ;   back until the redraw has finished is one byte and always right; the
00013Er 2                 ;   alternative is a piece that vanishes for four frames after every pause.
00013Er 2               @Draw:
00013Er 2  AD rr rr       lda PieceDirty
000141r 2  F0 0D          beq @Done
000143r 2  AD rr rr       lda RedrawIdx
000146r 2  10 08          bpl @Done                     ; A board redraw is still in flight
000148r 2  A9 00          lda #0
00014Ar 2  8D rr rr       sta PieceDirty
00014Dr 2  20 rr rr       jsr RenderPiece
000150r 2               @Done:
000150r 2  60             rts
000151r 2               
000151r 2               @ToPause:
000151r 2  A9 02          lda #STATE_PAUSE
000153r 2  8D rr rr       sta GameState
000156r 2  A9 rr          lda #<MsgPaused               ; SPEC 12.2 — without this the screen does not
000158r 2  85 rr          sta Ptr1                      ;   change at all on a pause, and a paused game
00015Ar 2  A9 rr          lda #>MsgPaused               ;   is indistinguishable from a hung one
00015Cr 2  85 rr          sta Ptr1+1
00015Er 2  20 rr rr       jsr TextBanner
000161r 2                 ; TODO (P7): wash the well with TILE_WASH so a pause cannot be used to study
000161r 2                 ; the board (13.3). A wash, not a blank — a blanked well reads as crashed.
000161r 2  60             rts
000162r 2               
000162r 2               ; -----------------------------------------------------------------------------
000162r 2               ;   PlayFalling — steer the piece, and drop it a row when the timer runs out
000162r 2               ;   SPEC 5.5, 5.6, 11.3
000162r 2               ; -----------------------------------------------------------------------------
000162r 2               PlayFalling:
000162r 2  20 rr rr       jsr PieceControl              ; Rotation and DAS; the result is ignored here
000165r 2                                               ;   because there is no lock delay to reset yet
000165r 2  20 rr rr       jsr PieceFallRate
000168r 2  85 rr          sta Tmp0
00016Ar 2  AD rr rr       lda GravityTimer              ; Pressing DOWN mid-wait must shorten the wait
00016Dr 2  C5 rr          cmp Tmp0                      ;   in progress, not just the next one
00016Fr 2  90 05          bcc @Tick
000171r 2  A5 rr          lda Tmp0
000173r 2  8D rr rr       sta GravityTimer
000176r 2               @Tick:
000176r 2  CE rr rr       dec GravityTimer
000179r 2  D0 1E          bne @Done
00017Br 2  20 rr rr       jsr PieceStep
00017Er 2  B0 0B          bcs @Land
000180r 2  20 rr rr       jsr PieceFallRate             ; ...and C tells us whose rate the row that
000183r 2  8D rr rr       sta GravityTimer              ;   just fell used. STA leaves it alone.
000186r 2  B0 11          bcs @Done
000188r 2  4C rr rr       jmp ScoreSoftDrop             ; SPEC 9.6 — one point, one row
00018Br 2               
00018Br 2               @Land:
00018Br 2  AE rr rr       ldx Region
00018Er 2  BD rr rr       lda LockDelay,x
000191r 2  8D rr rr       sta LockTimer
000194r 2  A9 01          lda #PLAY_LOCKING
000196r 2  8D rr rr       sta PlayState
000199r 2               @Done:
000199r 2  60             rts
00019Ar 2               
00019Ar 2               ; -----------------------------------------------------------------------------
00019Ar 2               ;   PlayLocking — the lock delay, and the moves that may reset it
00019Ar 2               ;   SPEC 5.6 — a horizontal move resets the delay LOCK_RESET_MAX times; after
00019Ar 2               ;   that it runs out regardless. Rotation never resets it. A move that opens a
00019Ar 2               ;   gap underneath resumes falling, and the reset count carries.
00019Ar 2               ; -----------------------------------------------------------------------------
00019Ar 2               PlayLocking:
00019Ar 2  20 rr rr       jsr PieceControl
00019Dr 2  90 13          bcc @Settled
00019Fr 2  AD rr rr       lda LockResets
0001A2r 2  C9 04          cmp #LOCK_RESET_MAX
0001A4r 2  B0 0C          bcs @Settled
0001A6r 2  EE rr rr       inc LockResets
0001A9r 2  AE rr rr       ldx Region
0001ACr 2  BD rr rr       lda LockDelay,x
0001AFr 2  8D rr rr       sta LockTimer
0001B2r 2               
0001B2r 2               @Settled:
0001B2r 2  20 rr rr       jsr PieceCanFall
0001B5r 2  90 0C          bcc @Tick
0001B7r 2  A9 00          lda #PLAY_FALLING             ; It moved over a hole — fall again. SPEC 5.6
0001B9r 2  8D rr rr       sta PlayState                 ;   says the lock counter clears here and the
0001BCr 2                                               ;   reset count does not; nothing reads
0001BCr 2                                               ;   LockTimer while falling and the next
0001BCr 2                                               ;   landing loads it fresh, so it is already
0001BCr 2                                               ;   clear in every sense that matters.
0001BCr 2  20 rr rr       jsr PieceFallRate
0001BFr 2  8D rr rr       sta GravityTimer
0001C2r 2  60             rts
0001C3r 2               
0001C3r 2               @Tick:
0001C3r 2  CE rr rr       dec LockTimer
0001C6r 2  D0 09          bne @Done
0001C8r 2  20 rr rr       jsr PieceLock
0001CBr 2  20 rr rr       jsr CascadeBegin              ; SPEC 8 — the cascade starts the moment the
0001CEr 2  4C rr rr       jmp CascadeEnter              ;   piece is board, and runs as sub-states
0001D1r 2               @Done:
0001D1r 2  60             rts
0001D2r 2               
0001D2r 2               ; -----------------------------------------------------------------------------
0001D2r 2               ;   CascadeEnter — run one cascade step and choose the sub-state after it
0001D2r 2               ;   In:  ChainStep set        Out: PlayState set.  Modifies: A, X, Y
0001D2r 2               ;   SPEC 8, D4. Called from the lock, and again from the bottom of every fall.
0001D2r 2               ;
0001D2r 2               ;   A step that marks something hands over to PLAY_GLOW, and the removal and
0001D2r 2               ;   the fall follow it twelve frames later; a step that finds nothing is where
0001D2r 2               ;   the cascade settles and the next piece is queued.
0001D2r 2               ;
0001D2r 2               ;   Nothing has come off the board when CascadeScan returns — that is the whole
0001D2r 2               ;   point of the split (cascade.asm). CascadeFinish does the taking, at the far
0001D2r 2               ;   end of PLAY_SHATTER.
0001D2r 2               ; -----------------------------------------------------------------------------
0001D2r 2               CascadeEnter:
0001D2r 2  20 rr rr       jsr CascadeScan
0001D5r 2  90 03          bcc @Settle
0001D7r 2  4C rr rr       jmp AnimGlowBegin             ; SPEC 8 step 5
0001DAr 2               
0001DAr 2               @Settle:
0001DAr 2  20 rr rr       jsr CascadeSettle             ; The star multiplier and the bank (SPEC 8
0001DDr 2                                               ;   SETTLE)
0001DDr 2  AD rr rr       lda ChainStep                 ; SPEC 8 SETTLE, SPEC 14 — a chain of two links
0001E0r 2  38             sec                           ;   or more is worth saying out loud. ChainStep
0001E1r 2  E9 01          sbc #1                        ;   counts the step that found nothing as well,
0001E3r 2  C9 02          cmp #2                        ;   so the links are one fewer
0001E5r 2  90 03          bcc @Are
0001E7r 2  20 rr rr       jsr AnimBannerChain
0001EAr 2               
0001EAr 2               @Are:
0001EAr 2  AE rr rr       ldx Region
0001EDr 2  BD rr rr       lda AreDelay,x
0001F0r 2  8D rr rr       sta AreTimer
0001F3r 2  A9 05          lda #PLAY_ARE
0001F5r 2  8D rr rr       sta PlayState
0001F8r 2  60             rts
0001F9r 2               
0001F9r 2               ; -----------------------------------------------------------------------------
0001F9r 2               ;   PlayGlow — hold the glow, the beams and the fireball's flash (SPEC 14)
0001F9r 2               ;   The window is one timer however many things are showing inside it: they all
0001F9r 2               ;   start together and the longest decides how long it lasts (anim.asm).
0001F9r 2               ; -----------------------------------------------------------------------------
0001F9r 2               PlayGlow:
0001F9r 2  CE rr rr       dec AnimTimer
0001FCr 2  D0 03          bne @Done
0001FEr 2  4C rr rr       jmp AnimGlowEnd               ; ...which starts the shatter
000201r 2               @Done:
000201r 2  60             rts
000202r 2               
000202r 2               ; -----------------------------------------------------------------------------
000202r 2               ;   PlayShatter — the removal ring, VFX_FRAMES a tile (SPEC 14)
000202r 2               ;   The board is finally emptied at the end of this, not at the start of it:
000202r 2               ;   every frame up to here has been drawing over cells that still hold their
000202r 2               ;   own tiles (cascade.asm).
000202r 2               ; -----------------------------------------------------------------------------
000202r 2               PlayShatter:
000202r 2  CE rr rr       dec AnimTimer
000205r 2  D0 20          bne @Done
000207r 2  EE rr rr       inc AnimStep
00020Ar 2  AD rr rr       lda AnimStep
00020Dr 2  CD rr rr       cmp AnimSteps
000210r 2  B0 0A          bcs @Over
000212r 2  A9 02          lda #VFX_FRAMES
000214r 2  8D rr rr       sta AnimTimer
000217r 2  A9 03          lda #ANIM_SHATTER
000219r 2  4C rr rr       jmp AnimMarked
00021Cr 2               
00021Cr 2               @Over:
00021Cr 2  20 rr rr       jsr CascadeFinish             ; SPEC 8 steps 6 and 7
00021Fr 2  20 rr rr       jsr BoardGravityBegin         ; ...and let what was above it fall
000222r 2  A9 04          lda #PLAY_GRAVITY
000224r 2  8D rr rr       sta PlayState
000227r 2               @Done:
000227r 2  60             rts
000228r 2               
000228r 2               ; -----------------------------------------------------------------------------
000228r 2               ;   PlayGravity — the pile falls into the holes the clear left
000228r 2               ;   SPEC 8 step 8, SPEC 14 — a row every FALL_FRAMES, and when a row moves
000228r 2               ;   nothing the board has settled and the next step scans it.
000228r 2               ;
000228r 2               ;   The row itself may take more than one frame: BoardGravityStep is a cursor
000228r 2               ;   that stops when the dirty ring is full (board.asm). The beat only starts
000228r 2               ;   once the row has actually landed, so a heavy board falls a little slower
000228r 2               ;   rather than losing cells off the screen.
000228r 2               ; -----------------------------------------------------------------------------
000228r 2               PlayGravity:
000228r 2  A5 rr          lda GravIdx
00022Ar 2  10 0C          bpl @Working                  ; A row is still coming down
00022Cr 2               
00022Cr 2  CE rr rr       dec AnimTimer
00022Fr 2  D0 11          bne @Done
000231r 2  A5 rr          lda GravMoved
000233r 2  F0 0E          beq @Landed                   ; The last row moved nothing: everything is
000235r 2  20 rr rr       jsr BoardGravityBegin         ;   resting on something
000238r 2               
000238r 2               @Working:
000238r 2  20 rr rr       jsr BoardGravityStep
00023Br 2  90 05          bcc @Done                     ; The ring filled — the rest waits for a flush
00023Dr 2  A9 02          lda #FALL_FRAMES              ; The row is down; hold it there for the beat
00023Fr 2  8D rr rr       sta AnimTimer
000242r 2               @Done:
000242r 2  60             rts
000243r 2               
000243r 2               @Landed:
000243r 2  EE rr rr       inc ChainStep                 ; SPEC 8 step 9
000246r 2  4C rr rr       jmp CascadeEnter
000249r 2               
000249r 2               ; -----------------------------------------------------------------------------
000249r 2               ;   PlayAre — the entry delay, then the next piece
000249r 2               ;   SPEC 5.6, 13.4 — a blocked spawn is game over.
000249r 2               ; -----------------------------------------------------------------------------
000249r 2               PlayAre:
000249r 2  CE rr rr       dec AreTimer
00024Cr 2  D0 10          bne @Done
00024Er 2  20 rr rr       jsr PieceSpawn
000251r 2  B0 0C          bcs @Over
000253r 2  20 rr rr       jsr PieceGenerateNext
000256r 2  20 rr rr       jsr RenderNext
000259r 2  A9 00          lda #PLAY_FALLING
00025Br 2  8D rr rr       sta PlayState
00025Er 2               @Done:
00025Er 2  60             rts
00025Fr 2               
00025Fr 2               @Over:
00025Fr 2  A9 0C          lda #SFX_GAMEOVER
000261r 2  8D rr rr       sta SfxRequest
000264r 2  20 rr rr       jsr AnimPetrifyBegin          ; The well turns to stone from the floor up
000267r 2  A9 03          lda #STATE_GAMEOVER           ;   while StateGameOver holds the input off
000269r 2  8D rr rr       sta GameState
00026Cr 2  60             rts
00026Dr 2               
00026Dr 2               ; -----------------------------------------------------------------------------
00026Dr 2               ;   StatePause
00026Dr 2               ; -----------------------------------------------------------------------------
00026Dr 2               StatePause:
00026Dr 2  AD rr rr       lda InputEdge
000270r 2  29 30          and #(INPUT_PAUSE | INPUT_FIRE)
000272r 2  F0 17          beq @Done
000274r 2  A9 01          lda #STATE_PLAY
000276r 2  8D rr rr       sta GameState
000279r 2  20 rr rr       jsr TextBannerClear           ; The banner comes down...
00027Cr 2  20 rr rr       jsr RenderBoard               ; ...the board goes back up...
00027Fr 2  AD rr rr       lda PlayState                 ;   ...and the piece on top of it, once the
000282r 2  C9 02          cmp #PLAY_GLOW                ;   redraw has gone by (D14) — but only while
000284r 2  B0 05          bcs @Done                     ;   there IS one. From GLOW on up the piece is
000286r 2  A9 01          lda #1                        ;   in the board and PieceA-C are stale; the
000288r 2  8D rr rr       sta PieceDirty                ;   cascade may have taken those cells away
00028Br 2               @Done:                          ;   entirely.
00028Br 2  60             rts
00028Cr 2               
00028Cr 2               ; -----------------------------------------------------------------------------
00028Cr 2               ;   StateGameOver — petrify, banner, back to the title
00028Cr 2               ;   SPEC 13.4
00028Cr 2               ; -----------------------------------------------------------------------------
00028Cr 2               StateGameOver:
00028Cr 2  20 rr rr       jsr AnimPetrifyTick           ; SPEC 13.4 step 2, a row every PETRIFY_FRAMES
00028Fr 2  B0 11          bcs @Done                     ; Still setting. A press during the petrify is
000291r 2                                               ;   ignored rather than queued: the animation
000291r 2                                               ;   is the game telling the player it is over
000291r 2                                               ;   and skipping it reads as a dropped input.
000291r 2                 ; TODO (P7): the GAME OVER banner, the high-score fanfare, and the ten
000291r 2                 ; second timeout back to the title (13.4 steps 3 to 5).
000291r 2  AD rr rr       lda InputEdge
000294r 2  29 11          and #(INPUT_FIRE | INPUT_UP)  ; Fire, or SPACE (D15)
000296r 2  F0 0A          beq @Done
000298r 2  A9 00          lda #STATE_TITLE
00029Ar 2  8D rr rr       sta GameState
00029Dr 2  A9 01          lda #1
00029Fr 2  8D rr rr       sta NeedsRedraw
0002A2r 2               @Done:
0002A2r 2  60             rts
0002A3r 2               
0002A3r 2               ; =============================================================================
0002A3r 2               ;   Static screen drawing
0002A3r 2               ; =============================================================================
0002A3r 2               ;   The whole static layout — panel frame, labels, and the margin artwork that
0002A3r 2               ;   fills the screen either side of it — comes out of the editors as one
0002A3r 2               ;   name-table image per platform. Code only ever draws over the top of it:
0002A3r 2               ;   the well, the score and level digits, the preview, and the message band.
0002A3r 2               ;
0002A3r 2               ;   All six images are real. They come out of artwork/WizardsLab.tms9918 —
0002A3r 2               ;   the master — by way of `make artwork`. See data/README.md.
0002A3r 2               ; =============================================================================
0002A3r 2               
0002A3r 2               DrawTitleScreen:
0002A3r 2  A9 rr          lda #<TitleScreen
0002A5r 2  85 rr          sta SrcPtr
0002A7r 2  A9 rr          lda #>TitleScreen
0002A9r 2  85 rr          sta SrcPtr+1
0002ABr 2  A9 rr          lda #<TitleColor
0002ADr 2  85 rr          sta Ptr1
0002AFr 2  A9 rr          lda #>TitleColor
0002B1r 2  85 rr          sta Ptr1+1
0002B3r 2  4C rr rr       jmp HalBlitScreen
0002B6r 2               
0002B6r 2               DrawPlayScreen:
0002B6r 2  A9 rr          lda #<PlayScreen
0002B8r 2  85 rr          sta SrcPtr
0002BAr 2  A9 rr          lda #>PlayScreen
0002BCr 2  85 rr          sta SrcPtr+1
0002BEr 2  A9 rr          lda #<PlayColor
0002C0r 2  85 rr          sta Ptr1
0002C2r 2  A9 rr          lda #>PlayColor
0002C4r 2  85 rr          sta Ptr1+1
0002C6r 2  4C rr rr       jmp HalBlitScreen
0002C9r 2               
0002C9r 1               .include "../src/rng.asm"
0002C9r 2               ; =============================================================================
0002C9r 2               ;   rng.asm — Wizards Lab, random numbers
0002C9r 2               ; =============================================================================
0002C9r 2               ;   A 16-bit Galois LFSR with the conventional $B400 taps, which is maximal
0002C9r 2               ;   length: it visits all 65535 non-zero states before repeating. Eight shifts
0002C9r 2               ;   per call, one whole byte out.
0002C9r 2               ;
0002C9r 2               ;   Seeding matters more than the generator does. A fixed seed would deal the
0002C9r 2               ;   same first three pieces every session and the game would feel dead, so the
0002C9r 2               ;   seed is taken from the free-running frame counter at the moment the player
0002C9r 2               ;   presses fire on the title screen — human reaction time is the entropy.
0002C9r 2               ;
0002C9r 2               ;   SPEC.md section 15.
0002C9r 2               ; =============================================================================
0002C9r 2               
0002C9r 2               ; -----------------------------------------------------------------------------
0002C9r 2               ;   RngSeed — seed from the frame counter
0002C9r 2               ;   In:  nothing (reads FrameCounter)
0002C9r 2               ;   Out: nothing.  Modifies: A
0002C9r 2               ; -----------------------------------------------------------------------------
0002C9r 2               RngSeed:
0002C9r 2  AD rr rr       lda FrameCounter
0002CCr 2  09 01          ora #$01                      ; Never let the state reach zero — it sticks
0002CEr 2  85 rr          sta RngLo
0002D0r 2  49 5A          eor #$5A                      ; Spread one byte of entropy over both halves
0002D2r 2  85 rr          sta RngHi
0002D4r 2  60             rts
0002D5r 2               
0002D5r 2               ; -----------------------------------------------------------------------------
0002D5r 2               ;   RngNext — next pseudo-random byte
0002D5r 2               ;   In:  nothing
0002D5r 2               ;   Out: A = random 0-255.  Modifies: A, X, flags
0002D5r 2               ; -----------------------------------------------------------------------------
0002D5r 2               RngNext:
0002D5r 2  A2 08          ldx #8                        ; Eight shifts give one whole output byte
0002D7r 2               @Bit:
0002D7r 2  46 rr          lsr RngHi                     ; Shift the 16-bit state right one place,
0002D9r 2  66 rr          ror RngLo                     ;   the bit falling out of bit 0 lands in C
0002DBr 2  90 06          bcc @NoTap
0002DDr 2  A5 rr          lda RngHi
0002DFr 2  49 B4          eor #$B4                      ; Galois feedback mask $B400
0002E1r 2  85 rr          sta RngHi
0002E3r 2               @NoTap:
0002E3r 2  CA             dex
0002E4r 2  D0 F1          bne @Bit
0002E6r 2  A5 rr          lda RngLo
0002E8r 2  60             rts
0002E9r 2               
0002E9r 2               ; -----------------------------------------------------------------------------
0002E9r 2               ;   RngRange — a random number below a small limit
0002E9r 2               ;   In:  A = limit, 1-128
0002E9r 2               ;   Out: A = 0 .. limit-1.  Modifies: A, X, Tmp0, Tmp1.  PRESERVES Y.
0002E9r 2               ;
0002E9r 2               ;   Not a modulo. `random % 6` throws four of the 256 outcomes into the low
0002E9r 2               ;   values and leaves colours 0-3 a shade likelier than 4-5; this takes the
0002E9r 2               ;   HIGH byte of (random * limit) instead, which spreads the remainder evenly
0002E9r 2               ;   across the range and costs a fixed eight shifts either way.
0002E9r 2               ;
0002E9r 2               ;   The eight-bit multiply keeps only the high byte: the low half falls out of
0002E9r 2               ;   the accumulator one bit at a time and is never wanted.
0002E9r 2               ;
0002E9r 2               ;   Y is preserved so a caller can loop over the three cells of a piece with
0002E9r 2               ;   it (piece.asm does).
0002E9r 2               ; -----------------------------------------------------------------------------
0002E9r 2               RngRange:
0002E9r 2  48             pha                           ; The limit — RngNext wants A
0002EAr 2  20 rr rr       jsr RngNext
0002EDr 2  85 rr          sta Tmp0                      ; The random byte
0002EFr 2  68             pla
0002F0r 2  85 rr          sta Tmp1                      ; The limit, shifted out one bit at a time
0002F2r 2  A9 00          lda #0
0002F4r 2  A2 08          ldx #8
0002F6r 2               @Bit:
0002F6r 2  46 rr          lsr Tmp1                      ; Next multiplier bit into C
0002F8r 2  90 03          bcc @NoAdd
0002FAr 2  18             clc
0002FBr 2  65 rr          adc Tmp0                      ; Partial product, carry out into C
0002FDr 2               @NoAdd:
0002FDr 2  6A             ror a                         ; Shift the accumulator down, carry in at bit 7
0002FEr 2  CA             dex
0002FFr 2  D0 F5          bne @Bit
000301r 2  60             rts
000302r 2               
000302r 1               .include "../src/input.asm"
000302r 2               ; =============================================================================
000302r 2               ;   input.asm — Wizards Lab, input conditioning
000302r 2               ; =============================================================================
000302r 2               ;   SPEC.md section 11. HalReadInput hands back one active-high mask however
000302r 2               ;   the platform likes; everything above this line works on that mask and
000302r 2               ;   never touches hardware.
000302r 2               ;
000302r 2               ;   Auto-repeat applies to LEFT and RIGHT only. Rotate does NOT repeat — up
000302r 2               ;   must be released and pressed again. That is not a preference: a repeating
000302r 2               ;   rotate makes a three-cell Columns piece impossible to aim.
000302r 2               ; =============================================================================
000302r 2               
000302r 2               ; -----------------------------------------------------------------------------
000302r 2               ;   InputPoll — read the hardware and work out what is newly pressed
000302r 2               ;   In:  nothing
000302r 2               ;   Out: InputNow, InputPrev, InputEdge updated.  Modifies: A
000302r 2               ; -----------------------------------------------------------------------------
000302r 2               InputPoll:
000302r 2  AD rr rr       lda InputNow
000305r 2  8D rr rr       sta InputPrev
000308r 2  20 rr rr       jsr HalReadInput
00030Br 2  8D rr rr       sta InputNow
00030Er 2  4D rr rr       eor InputPrev                 ; Bits that changed
000311r 2  2D rr rr       and InputNow                  ; ...and are now down = newly pressed
000314r 2  8D rr rr       sta InputEdge
000317r 2  60             rts
000318r 2               
000318r 2               ; -----------------------------------------------------------------------------
000318r 2               ;   InputShift — LEFT/RIGHT with delayed auto shift
000318r 2               ;   Out: A = INPUT_LEFT, INPUT_RIGHT, or 0 if no move should happen this frame.
000318r 2               ;        Modifies: A, X
000318r 2               ;   SPEC 11.3 — initial delay 12 frames NTSC / 10 PAL, then 4 / 3.
000318r 2               ;
000318r 2               ;   A fresh press fires on the same frame it arrives; the delay is what comes
000318r 2               ;   after it, not before it, so a tap is always exactly one column.
000318r 2               ;
000318r 2               ;   Holding both directions at once is not something a stick can do, but two
000318r 2               ;   keys can. LEFT wins, and it wins consistently, so the piece sits still
000318r 2               ;   rather than shivering between the two.
000318r 2               ; -----------------------------------------------------------------------------
000318r 2               InputShift:
000318r 2  AD rr rr       lda InputNow
00031Br 2  29 04          and #INPUT_LEFT
00031Dr 2  D0 07          bne @Dir
00031Fr 2  AD rr rr       lda InputNow
000322r 2  29 08          and #INPUT_RIGHT
000324r 2  F0 2A          beq @None
000326r 2               
000326r 2               @Dir:
000326r 2  CD rr rr       cmp DasDir
000329r 2  F0 10          beq @Held
00032Br 2               
00032Br 2  8D rr rr       sta DasDir                    ; A new direction: fire now, then wait
00032Er 2  AE rr rr       ldx Region
000331r 2  BD rr rr       lda DasInitial,x
000334r 2  8D rr rr       sta DasTimer
000337r 2  AD rr rr       lda DasDir
00033Ar 2  60             rts
00033Br 2               
00033Br 2               @Held:
00033Br 2  CE rr rr       dec DasTimer                  ; Always loaded non-zero, so this cannot wrap
00033Er 2  D0 0D          bne @Wait
000340r 2  AE rr rr       ldx Region
000343r 2  BD rr rr       lda DasRepeat,x
000346r 2  8D rr rr       sta DasTimer
000349r 2  AD rr rr       lda DasDir
00034Cr 2  60             rts
00034Dr 2               
00034Dr 2               @Wait:
00034Dr 2  A9 00          lda #0
00034Fr 2  60             rts
000350r 2               
000350r 2               @None:
000350r 2  8D rr rr       sta DasDir                    ; A is already 0 — release, so the next press
000353r 2  60             rts                           ;   counts as fresh
000354r 2               
000354r 1               .include "../src/board.asm"
000354r 2               ; =============================================================================
000354r 2               ;   board.asm — Wizards Lab, the playfield
000354r 2               ; =============================================================================
000354r 2               ;   SPEC.md section 3. The board is 20 rows of 8 bytes, page-aligned, with
000354r 2               ;   columns 6-7 and rows 16-19 held permanently at $FF. Those sentinels are
000354r 2               ;   what let every scan in match.asm run without a bounds check.
000354r 2               ;
000354r 2               ;   address(row, col) = Board + (row << 3) + col
000354r 2               ; =============================================================================
000354r 2               
000354r 2               ; -----------------------------------------------------------------------------
000354r 2               ;   BoardClear — empty the playfield and lay the sentinels back down
000354r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X
000354r 2               ;
000354r 2               ;   Walls first over the whole 160 bytes, then the six playfield columns of
000354r 2               ;   the sixteen playfield rows punched back out to empty. Doing it in that
000354r 2               ;   order means the sentinels can never be forgotten: everything that is not
000354r 2               ;   explicitly playfield is a wall.
000354r 2               ;
000354r 2               ;   The wall loop counts UP and ends on a CPX. Counting down from 159 to a BPL
000354r 2               ;   looks tidier and is wrong: 159 is $9F, bit 7 already set, so the branch
000354r 2               ;   falls through after the first store and the other 159 bytes keep whatever
000354r 2               ;   the machine powered up with. That went unnoticed for a whole phase,
000354r 2               ;   because nothing read a sentinel until the falling piece needed a floor.
000354r 2               ; -----------------------------------------------------------------------------
000354r 2               BoardClear:
000354r 2  A9 FF          lda #TILE_WALL
000356r 2  A2 00          ldx #0
000358r 2               @Wall:
000358r 2  9D rr rr       sta Board,x
00035Br 2  E8             inx
00035Cr 2  E0 A0          cpx #BOARD_BYTES
00035Er 2  D0 F8          bne @Wall
000360r 2               
000360r 2  A2 00          ldx #0                        ; X walks the row bases, 0, 8, 16, ...
000362r 2               @Row:
000362r 2  A9 00          lda #TILE_EMPTY               ; Reloaded every row: the TXA below eats it
000364r 2  9D rr rr 9D    .repeat BOARD_W, COL
000368r 2  rr rr 9D rr  
00036Cr 2  rr 9D rr rr  
000376r 2                   sta Board + COL, x
000376r 2                 .endrepeat
000376r 2  8A             txa
000377r 2  18             clc
000378r 2  69 08          adc #BOARD_STRIDE
00037Ar 2  AA             tax
00037Br 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
00037Dr 2  90 E3          bcc @Row
00037Fr 2  60             rts
000380r 2               
000380r 2               ; -----------------------------------------------------------------------------
000380r 2               ;   BoardRowPtr — point Ptr1 at the start of a board row
000380r 2               ;   In:  A = row        Out: Ptr1 = &Board[row][0].  Modifies: A, Ptr1
000380r 2               ;
000380r 2               ;   Board is page-aligned and 160 bytes, so row * 8 is at most 152 and the low
000380r 2               ;   byte can never carry into the high one.
000380r 2               ; -----------------------------------------------------------------------------
000380r 2               BoardRowPtr:
000380r 2  0A             asl a
000381r 2  0A             asl a
000382r 2  0A             asl a
000383r 2  18             clc
000384r 2  69 rr          adc #<Board
000386r 2  85 rr          sta Ptr1
000388r 2  A9 rr          lda #>Board
00038Ar 2  85 rr          sta Ptr1+1
00038Cr 2  60             rts
00038Dr 2               
00038Dr 2               ; -----------------------------------------------------------------------------
00038Dr 2               ;   BoardGravityBegin / BoardGravityStep — the pile falls, one row at a time
00038Dr 2               ;   SPEC 8 step 8, SPEC 14: tiles descend one row every FALL_FRAMES.
00038Dr 2               ;
00038Dr 2               ;   A row of falling is one pass over the board, bottom to top, moving every
00038Dr 2               ;   tile that has an empty cell under it down into it. Repeat until a pass
00038Dr 2               ;   moves nothing and the columns are compacted — but repeat it a row at a
00038Dr 2               ;   time, because the fall is animated and a column that dropped four rows in
00038Dr 2               ;   one frame would read as a teleport.
00038Dr 2               ;
00038Dr 2               ;   Walking BOTTOM TO TOP is what makes a whole column fall together rather
00038Dr 2               ;   than one tile a frame: by the time the pass reaches a tile, the tile below
00038Dr 2               ;   it has already moved and left the gap.
00038Dr 2               ;
00038Dr 2               ;   The pass is a CURSOR, not a loop that runs to completion (D12, SPEC 12.6).
00038Dr 2               ;   Sixty tiles falling is a hundred-odd changed cells and the dirty ring holds
00038Dr 2               ;   64, so the pass stops when the ring is full and picks up where it stopped
00038Dr 2               ;   next frame. Nothing is dropped and the board is a legal board at every
00038Dr 2               ;   point it stops — one frame's worth of columns has fallen a row and the
00038Dr 2               ;   rest has not, which is a stagger nobody can see.
00038Dr 2               ;
00038Dr 2               ;   The two sentinel columns need no special case: a wall's "cell below" is
00038Dr 2               ;   another wall, so columns 6 and 7 never move.
00038Dr 2               ; -----------------------------------------------------------------------------
00038Dr 2               GRAV_TOP = (BOARD_H - 1) * BOARD_STRIDE - 1     ; The last cell of row 14, the
00038Dr 2                                                               ;   lowest row that can fall at
00038Dr 2                                                               ;   all. Row 15 is on the floor
00038Dr 2               BoardGravityBegin:
00038Dr 2  A9 77          lda #GRAV_TOP
00038Fr 2  85 rr          sta GravIdx
000391r 2  A9 00          lda #0
000393r 2  85 rr          sta GravMoved
000395r 2  60             rts
000396r 2               
000396r 2               ; -----------------------------------------------------------------------------
000396r 2               ;   BoardGravityStep — carry on with the current row of falling
000396r 2               ;   In:  nothing
000396r 2               ;   Out: C set when the row is finished; GravMoved non-zero if it moved
000396r 2               ;        anything. Modifies: A, X, Y, GravIdx, GravMoved, RedrawCol
000396r 2               ; -----------------------------------------------------------------------------
000396r 2               BoardGravityStep:
000396r 2  A5 rr          lda GravIdx
000398r 2  30 3F          bmi @Finished                 ; $FF — the row is already done
00039Ar 2               
00039Ar 2               @Cell:
00039Ar 2  AD rr rr       lda DirtyCount                ; Room for both cells of a move, or wait for
00039Dr 2  C9 3E          cmp #(DIRTY_ENTRIES - 2)      ;   the flush. A mark dropped here would never
00039Fr 2  B0 3A          bcs @Later                    ;   be marked again (D6 is survivable only
0003A1r 2                                               ;   because nothing that MUST land uses it)
0003A1r 2               
0003A1r 2  A6 rr          ldx GravIdx
0003A3r 2  BD rr rr       lda Board,x
0003A6r 2  F0 2D          beq @Next                     ; Nothing here to fall
0003A8r 2  BD rr rr       lda Board + BOARD_STRIDE,x
0003ABr 2  D0 28          bne @Next                     ; Something under it — a tile, or the floor
0003ADr 2               
0003ADr 2  BD rr rr       lda Board,x                   ; Move it down one row
0003B0r 2  9D rr rr       sta Board + BOARD_STRIDE,x
0003B3r 2  A9 00          lda #TILE_EMPTY
0003B5r 2  9D rr rr       sta Board,x
0003B8r 2  E6 rr          inc GravMoved
0003BAr 2               
0003BAr 2  A5 rr          lda GravIdx                   ; The cell it LEFT only needs redrawing if it
0003BCr 2  C9 08          cmp #BOARD_STRIDE             ;   is going to stay empty. If there is a tile
0003BEr 2  90 07          bcc @Vacated                  ;   above it, that tile lands here later in
0003C0r 2  A6 rr          ldx GravIdx                   ;   this same pass and its own arrival mark
0003C2r 2  BD rr rr       lda Board - BOARD_STRIDE,x    ;   covers the cell. Half the marks of a
0003C5r 2  D0 05          bne @Arrived                  ;   sliding column, which is what the ring
0003C7r 2               @Vacated:                       ;   pressure is made of.
0003C7r 2  A6 rr          ldx GravIdx
0003C9r 2  20 rr rr       jsr RenderCell
0003CCr 2               @Arrived:
0003CCr 2  A5 rr          lda GravIdx
0003CEr 2  18             clc
0003CFr 2  69 08          adc #BOARD_STRIDE
0003D1r 2  AA             tax
0003D2r 2  20 rr rr       jsr RenderCell
0003D5r 2               
0003D5r 2               @Next:
0003D5r 2  C6 rr          dec GravIdx                   ; Down to 0, then $FF, which ends the pass —
0003D7r 2  10 C1          bpl @Cell                     ;   GRAV_TOP is 119, so bit 7 starts clear
0003D9r 2                                               ;   (see PLAN.md section 3)
0003D9r 2               @Finished:
0003D9r 2  38             sec
0003DAr 2  60             rts
0003DBr 2               
0003DBr 2               @Later:
0003DBr 2  18             clc                           ; Ring full: the rest of this row waits a frame
0003DCr 2  60             rts
0003DDr 2               
0003DDr 1               .include "../src/piece.asm"
0003DDr 2               ; =============================================================================
0003DDr 2               ;   piece.asm — Wizards Lab, the falling piece
0003DDr 2               ; =============================================================================
0003DDr 2               ;   SPEC.md section 5. A piece is three independently generated cells stacked
0003DDr 2               ;   vertically, A on top. At most one of the three carries a reagent, which is
0003DDr 2               ;   enforced by rolling once for the piece rather than once per cell.
0003DDr 2               ;
0003DDr 2               ;   The piece is NOT in the board while it falls. Board cells under it stay
0003DDr 2               ;   empty until PieceLock writes them, which is what makes the movement tests
0003DDr 2               ;   below a plain read of the three target cells and what lets the erase be
0003DDr 2               ;   three blanks rather than three board reads.
0003DDr 2               ;
0003DDr 2               ;   Nothing here draws. Every routine that changes where the piece is or what
0003DDr 2               ;   it holds sets PieceDirty and lets StatePlay pick the moment (D14).
0003DDr 2               ; =============================================================================
0003DDr 2               
0003DDr 2               ; -----------------------------------------------------------------------------
0003DDr 2               ;   PieceIndex — board index of the piece's top cell
0003DDr 2               ;   In:  nothing
0003DDr 2               ;   Out: A = X = PieceRow * BOARD_STRIDE + PieceCol.  Modifies: A, X
0003DDr 2               ;
0003DDr 2               ;   Cells B and C are one and two strides on from it, and the cell below C is
0003DDr 2               ;   three — which is the only address arithmetic the rest of this file needs.
0003DDr 2               ;   Row 16 and beyond is a wall row, so "below C" is always a legal read.
0003DDr 2               ; -----------------------------------------------------------------------------
0003DDr 2               PieceIndex:
0003DDr 2  AD rr rr       lda PieceRow
0003E0r 2  0A             asl a
0003E1r 2  0A             asl a
0003E2r 2  0A             asl a                         ; row * 8
0003E3r 2  18             clc
0003E4r 2  6D rr rr       adc PieceCol
0003E7r 2  AA             tax
0003E8r 2  60             rts
0003E9r 2               
0003E9r 2               ; -----------------------------------------------------------------------------
0003E9r 2               ;   PieceGenerateNext — roll the preview piece into NextA/NextB/NextC
0003E9r 2               ;   In:  nothing (reads Level)
0003E9r 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0, Tmp1
0003E9r 2               ;   SPEC 5.2, 5.3 — colours uniform over 0-5, then one reagent roll.
0003E9r 2               ; -----------------------------------------------------------------------------
0003E9r 2               PieceGenerateNext:
0003E9r 2  A0 00          ldy #0                        ; RngRange preserves Y, so it can index the
0003EBr 2               @Color:                         ;   three cells across the call
0003EBr 2  A9 06          lda #NUM_COLORS
0003EDr 2  20 rr rr       jsr RngRange                  ; 0-5, uniform (SPEC 5.2)
0003F0r 2  0A             asl a
0003F1r 2  0A             asl a
0003F2r 2  0A             asl a                         ; colour << 3 ...
0003F3r 2  18             clc
0003F4r 2  69 40          adc #COLOR_BASE               ;   ... + base, glyph 0, so it is a potion
0003F6r 2  99 rr rr       sta NextA,y                   ; NextA/B/C are three consecutive bytes
0003F9r 2  C8             iny
0003FAr 2  C0 03          cpy #3
0003FCr 2  90 ED          bcc @Color
0003FEr 2               
0003FEr 2                 ; --- does this piece carry a reagent at all? (SPEC 5.3) -------------------
0003FEr 2                 ;   One roll for the whole piece, which both caps it at one reagent and
0003FEr 2                 ;   costs three rolls fewer than asking each cell.
0003FEr 2  20 rr rr       jsr RngNext
000401r 2  85 rr          sta Tmp0                      ; The roll. Nothing below calls out until it
000403r 2                                               ;   has been compared, so Tmp0 is safe.
000403r 2  AE rr rr       ldx Level
000406r 2  CA             dex                           ; LevelBand is indexed by level - 1 ...
000407r 2  E0 10          cpx #16
000409r 2  90 02          bcc @Band
00040Br 2  A2 0F          ldx #15                       ;   ... and clamped: band 4 is "13 and up"
00040Dr 2               @Band:
00040Dr 2  BD rr rr       lda LevelBand,x
000410r 2  AA             tax                           ; X = band 0-4
000411r 2  A5 rr          lda Tmp0
000413r 2  DD rr rr       cmp PSpecial,x                ; C clear = the roll came in under the chance
000416r 2  B0 2E          bcs @Done
000418r 2               
000418r 2                 ; --- which cell, and which reagent ----------------------------------------
000418r 2  8A             txa
000419r 2  48             pha                           ; The band, across the cell roll
00041Ar 2  A9 03          lda #3
00041Cr 2  20 rr rr       jsr RngRange                  ; 0, 1 or 2 — uniform over A, B and C
00041Fr 2  A8             tay                           ; Y survives the type roll below
000420r 2  68             pla
000421r 2  0A             asl a
000422r 2  0A             asl a                         ; band * 4 — ReagentThresholds is four
000423r 2  48             pha                           ;   thresholds per band
000424r 2  20 rr rr       jsr RngNext
000427r 2  85 rr          sta Tmp0                      ; The type roll
000429r 2  68             pla
00042Ar 2  AA             tax
00042Br 2  A5 rr          lda Tmp0
00042Dr 2               
00042Dr 2  DD rr rr       cmp ReagentThresholds+0,x     ; The cumulative-weight compare chain SPEC 5.3
000430r 2  90 15          bcc @Fireball                 ;   recommends over a 1280-byte lookup
000432r 2  DD rr rr       cmp ReagentThresholds+1,x
000435r 2  90 14          bcc @Bolt
000437r 2  DD rr rr       cmp ReagentThresholds+2,x
00043Ar 2  90 13          bcc @Bomb
00043Cr 2  DD rr rr       cmp ReagentThresholds+3,x
00043Fr 2  90 12          bcc @Star
000441r 2               
000441r 2  A9 70          lda #WILD_BASE                ; A Prism discards the colour it rolled and
000443r 2  99 rr rr       sta NextA,y                   ;   joins group 14 (SPEC 5.2)
000446r 2               @Done:
000446r 2  60             rts
000447r 2               
000447r 2               @Fireball:
000447r 2  A9 01          lda #GLYPH_FIREBALL
000449r 2  D0 0A          bne @Apply                    ; Always — every glyph below is non-zero
00044Br 2               @Bolt:
00044Br 2  A9 02          lda #GLYPH_BOLT
00044Dr 2  D0 06          bne @Apply
00044Fr 2               @Bomb:
00044Fr 2  A9 03          lda #GLYPH_BOMB
000451r 2  D0 02          bne @Apply
000453r 2               @Star:
000453r 2  A9 04          lda #GLYPH_STAR
000455r 2               @Apply:
000455r 2  19 rr rr       ora NextA,y                   ; The cell's glyph nibble is 0, so an ORA sets
000458r 2  99 rr rr       sta NextA,y                   ;   the reagent and keeps the rolled colour
00045Br 2  60             rts
00045Cr 2               
00045Cr 2               ; -----------------------------------------------------------------------------
00045Cr 2               ;   PieceSpawn — promote the preview to the falling piece
00045Cr 2               ;   In:  nothing
00045Cr 2               ;   Out: C set if the spawn cells were occupied (game over)
00045Cr 2               ;        Modifies: A, X
00045Cr 2               ;   SPEC 5.4 — spawn column SPAWN_COL, rows 0-2, visible immediately.
00045Cr 2               ;
00045Cr 2               ;   The preview is copied whether or not the spawn succeeds; on a blocked
00045Cr 2               ;   spawn nothing looks at the piece again.
00045Cr 2               ; -----------------------------------------------------------------------------
00045Cr 2               PieceSpawn:
00045Cr 2  AD rr rr       lda NextA
00045Fr 2  8D rr rr       sta PieceA
000462r 2  AD rr rr       lda NextB
000465r 2  8D rr rr       sta PieceB
000468r 2  AD rr rr       lda NextC
00046Br 2  8D rr rr       sta PieceC
00046Er 2               
00046Er 2  A9 02          lda #SPAWN_COL
000470r 2  8D rr rr       sta PieceCol
000473r 2  A9 00          lda #0
000475r 2  8D rr rr       sta PieceRow
000478r 2  8D rr rr       sta LockTimer
00047Br 2  8D rr rr       sta LockResets                ; The reset allowance is per piece (SPEC 5.6)
00047Er 2               
00047Er 2  AD rr rr       lda Board + 0 * BOARD_STRIDE + SPAWN_COL
000481r 2  0D rr rr       ora Board + 1 * BOARD_STRIDE + SPAWN_COL
000484r 2  0D rr rr       ora Board + 2 * BOARD_STRIDE + SPAWN_COL
000487r 2  D0 0D          bne @Blocked
000489r 2               
000489r 2  20 rr rr       jsr ScoreGravity
00048Cr 2  8D rr rr       sta GravityTimer
00048Fr 2  A9 01          lda #1
000491r 2  8D rr rr       sta PieceDirty                ; Drawn immediately — there is no off-screen
000494r 2  18             clc                           ;   entry (SPEC 5.4)
000495r 2  60             rts
000496r 2               
000496r 2               @Blocked:
000496r 2  38             sec
000497r 2  60             rts
000498r 2               
000498r 2               ; -----------------------------------------------------------------------------
000498r 2               ;   PieceMoveLeft / PieceMoveRight — one column, if all three cells are free
000498r 2               ;   Out: C set if the move happened (the caller resets the lock timer).
000498r 2               ;        Modifies: A, X
000498r 2               ;   SPEC 5.5 — no wall kicks; a 1-wide piece has nothing to kick off.
000498r 2               ;
000498r 2               ;   The right edge needs no bounds check: column 6 is a permanent $FF sentinel
000498r 2               ;   and fails the emptiness test on its own (SPEC 3.2). The LEFT edge does,
000498r 2               ;   because column -1 of row 0 is the byte before a page-aligned Board and
000498r 2               ;   belongs to nobody.
000498r 2               ; -----------------------------------------------------------------------------
000498r 2               PieceMoveLeft:
000498r 2  AD rr rr       lda PieceCol
00049Br 2  F0 18          beq @No                       ; Column 0 — there is no sentinel to the left
00049Dr 2  20 rr rr       jsr PieceIndex
0004A0r 2  CA             dex
0004A1r 2  BD rr rr       lda Board + 0 * BOARD_STRIDE,x
0004A4r 2  1D rr rr       ora Board + 1 * BOARD_STRIDE,x
0004A7r 2  1D rr rr       ora Board + 2 * BOARD_STRIDE,x
0004AAr 2  D0 09          bne @No
0004ACr 2  20 rr rr       jsr RenderPieceErase
0004AFr 2  CE rr rr       dec PieceCol
0004B2r 2  4C rr rr       jmp PieceMoved
0004B5r 2               
0004B5r 2               @No:
0004B5r 2  18             clc
0004B6r 2  60             rts
0004B7r 2               
0004B7r 2               PieceMoveRight:
0004B7r 2  20 rr rr       jsr PieceIndex
0004BAr 2  E8             inx
0004BBr 2  BD rr rr       lda Board + 0 * BOARD_STRIDE,x
0004BEr 2  1D rr rr       ora Board + 1 * BOARD_STRIDE,x
0004C1r 2  1D rr rr       ora Board + 2 * BOARD_STRIDE,x
0004C4r 2  D0 09          bne @No
0004C6r 2  20 rr rr       jsr RenderPieceErase
0004C9r 2  EE rr rr       inc PieceCol
0004CCr 2  4C rr rr       jmp PieceMoved
0004CFr 2               @No:
0004CFr 2  18             clc
0004D0r 2  60             rts
0004D1r 2               
0004D1r 2               ; -----------------------------------------------------------------------------
0004D1r 2               ;   PieceMoved — mark the piece for redraw and report success
0004D1r 2               ;   Out: C set.  Modifies: A
0004D1r 2               ; -----------------------------------------------------------------------------
0004D1r 2               PieceMoved:
0004D1r 2  A9 01          lda #1
0004D3r 2  8D rr rr       sta PieceDirty
0004D6r 2  38             sec
0004D7r 2  60             rts
0004D8r 2               
0004D8r 2               ; -----------------------------------------------------------------------------
0004D8r 2               ;   PieceRotate / PieceRotateBack — cycle the three cells
0004D8r 2               ;   Out: nothing.  Modifies: A, X
0004D8r 2               ;   SPEC 5.5 — (A,B,C) -> (B,C,A) forward, (C,A,B) back. Always succeeds: the
0004D8r 2               ;   footprint never changes, so there is nothing to test and nothing to erase.
0004D8r 2               ;   Rotation does not reset the lock delay (SPEC 5.6).
0004D8r 2               ; -----------------------------------------------------------------------------
0004D8r 2               PieceRotate:
0004D8r 2  AD rr rr       lda PieceA
0004DBr 2  AE rr rr       ldx PieceB
0004DEr 2  8E rr rr       stx PieceA
0004E1r 2  AE rr rr       ldx PieceC
0004E4r 2  8E rr rr       stx PieceB
0004E7r 2  8D rr rr       sta PieceC
0004EAr 2  A9 01          lda #1
0004ECr 2  8D rr rr       sta PieceDirty
0004EFr 2  60             rts
0004F0r 2               
0004F0r 2               PieceRotateBack:
0004F0r 2  AD rr rr       lda PieceC
0004F3r 2  AE rr rr       ldx PieceB
0004F6r 2  8E rr rr       stx PieceC
0004F9r 2  AE rr rr       ldx PieceA
0004FCr 2  8E rr rr       stx PieceB
0004FFr 2  8D rr rr       sta PieceA
000502r 2  A9 01          lda #1
000504r 2  8D rr rr       sta PieceDirty
000507r 2  60             rts
000508r 2               
000508r 2               ; -----------------------------------------------------------------------------
000508r 2               ;   PieceCanFall — is the cell below C free?
000508r 2               ;   Out: C set if the piece can descend one row.  Modifies: A, X
000508r 2               ;   Three strides past cell A. With C on row 15 that reads row 18, which is a
000508r 2               ;   permanent wall row, so the floor needs no special case (SPEC 3.2).
000508r 2               ; -----------------------------------------------------------------------------
000508r 2               PieceCanFall:
000508r 2  20 rr rr       jsr PieceIndex
00050Br 2  BD rr rr       lda Board + 3 * BOARD_STRIDE,x
00050Er 2  D0 02          bne @No
000510r 2  38             sec
000511r 2  60             rts
000512r 2               @No:
000512r 2  18             clc
000513r 2  60             rts
000514r 2               
000514r 2               ; -----------------------------------------------------------------------------
000514r 2               ;   PieceStep — one row of gravity
000514r 2               ;   Out: C set if the piece has landed and the lock delay should start.
000514r 2               ;        Modifies: A, X
000514r 2               ; -----------------------------------------------------------------------------
000514r 2               PieceStep:
000514r 2  20 rr rr       jsr PieceCanFall
000517r 2  90 0B          bcc @Landed
000519r 2  20 rr rr       jsr RenderPieceErase
00051Cr 2  EE rr rr       inc PieceRow
00051Fr 2  20 rr rr       jsr PieceMoved
000522r 2  18             clc                           ; Moved, so it has not landed
000523r 2  60             rts
000524r 2               @Landed:
000524r 2  38             sec
000525r 2  60             rts
000526r 2               
000526r 2               ; -----------------------------------------------------------------------------
000526r 2               ;   PieceLock — write the three cells into the board
000526r 2               ;   Out: nothing.  Modifies: A, X, Y
000526r 2               ;   SPEC 5.6 — after this the caller runs a cascade.
000526r 2               ;
000526r 2               ;   Once the board holds the piece, drawing the piece and drawing those three
000526r 2               ;   board cells are the same three writes, so RenderPiece does the queueing.
000526r 2               ; -----------------------------------------------------------------------------
000526r 2               PieceLock:
000526r 2  20 rr rr       jsr PieceIndex
000529r 2  AD rr rr       lda PieceA
00052Cr 2  9D rr rr       sta Board + 0 * BOARD_STRIDE,x
00052Fr 2  AD rr rr       lda PieceB
000532r 2  9D rr rr       sta Board + 1 * BOARD_STRIDE,x
000535r 2  AD rr rr       lda PieceC
000538r 2  9D rr rr       sta Board + 2 * BOARD_STRIDE,x
00053Br 2               
00053Br 2  20 rr rr       jsr RenderPiece
00053Er 2  A9 00          lda #0
000540r 2  8D rr rr       sta PieceDirty                ; It is board now; nothing owes it a redraw
000543r 2  60             rts
000544r 2               
000544r 2               ; -----------------------------------------------------------------------------
000544r 2               ;   PieceFallRate — frames per row for this frame
000544r 2               ;   Out: A = frame count, C CLEAR if that rate is the soft drop's.
000544r 2               ;        Modifies: A, X, Tmp0
000544r 2               ;   SPEC 5.5, 11.3 — soft drop substitutes its own rate and is ignored when
000544r 2               ;   gravity is already the faster of the two (levels 14+ on NTSC).
000544r 2               ;
000544r 2               ;   The carry is what pays for the soft drop: SPEC 9.6 gives a point per row
000544r 2               ;   "descended under soft drop", and a row that fell at gravity's rate with
000544r 2               ;   DOWN held down was not one, so holding DOWN at level 16 earns nothing.
000544r 2               ;   Working it out here costs nothing — the comparison has already happened.
000544r 2               ; -----------------------------------------------------------------------------
000544r 2               PieceFallRate:
000544r 2  20 rr rr       jsr ScoreGravity              ; Speed[level] for this region
000547r 2  85 rr          sta Tmp0
000549r 2  AD rr rr       lda InputNow
00054Cr 2  29 02          and #INPUT_DOWN
00054Er 2  F0 0A          beq @Gravity
000550r 2  AE rr rr       ldx Region
000553r 2  BD rr rr       lda SoftDropRate,x
000556r 2  C5 rr          cmp Tmp0                      ; C clear = soft drop is the faster
000558r 2  90 04          bcc @Soft
00055Ar 2               @Gravity:
00055Ar 2  A5 rr          lda Tmp0
00055Cr 2  38             sec
00055Dr 2  60             rts
00055Er 2               @Soft:
00055Er 2  18             clc
00055Fr 2  60             rts
000560r 2               
000560r 2               ; -----------------------------------------------------------------------------
000560r 2               ;   PieceControl — apply this frame's input to the piece
000560r 2               ;   Out: C set if a horizontal move succeeded (the caller may reset the lock
000560r 2               ;        delay).  Modifies: A, X, Y
000560r 2               ;
000560r 2               ;   Rotation is edge triggered and never repeats: UP has to be released and
000560r 2               ;   pressed again. SPEC 11.3 calls that non-negotiable and it is — a
000560r 2               ;   repeating rotate makes a three-cell piece impossible to aim. Left and
000560r 2               ;   right go through InputShift, which is where the repeat lives.
000560r 2               ; -----------------------------------------------------------------------------
000560r 2               PieceControl:
000560r 2  AD rr rr       lda InputEdge
000563r 2  29 01          and #INPUT_UP
000565r 2  F0 03          beq @NoRotate
000567r 2  20 rr rr       jsr PieceRotate
00056Ar 2               @NoRotate:
00056Ar 2  AD rr rr       lda InputEdge
00056Dr 2  29 10          and #INPUT_FIRE
00056Fr 2  F0 03          beq @NoBack
000571r 2  20 rr rr       jsr PieceRotateBack
000574r 2               @NoBack:
000574r 2  20 rr rr       jsr InputShift
000577r 2  C9 04          cmp #INPUT_LEFT
000579r 2  F0 06          beq @Left
00057Br 2  C9 08          cmp #INPUT_RIGHT
00057Dr 2  F0 05          beq @Right
00057Fr 2  18             clc
000580r 2  60             rts
000581r 2               @Left:
000581r 2  4C rr rr       jmp PieceMoveLeft
000584r 2               @Right:
000584r 2  4C rr rr       jmp PieceMoveRight
000587r 2               
000587r 1               .include "../src/match.asm"
000587r 2               ; =============================================================================
000587r 2               ;   match.asm — Wizards Lab, the match scanner
000587r 2               ; =============================================================================
000587r 2               ;   SPEC.md section 6. Four passes — horizontal, vertical, and both diagonals —
000587r 2               ;   each walking its axis and tracking a run colour and length. A run of three
000587r 2               ;   or more sets the MARK bit for each of its cells.
000587r 2               ;
000587r 2               ;   Colour comparison is the whole trick:
000587r 2               ;
000587r 2               ;       lda cell
000587r 2               ;       and #COLOR_MASK         ; the low three bits are the glyph, ignore them
000587r 2               ;       cmp ScanColor
000587r 2               ;
000587r 2               ;   which is why a red potion, a red fireball and a red star all match. The
000587r 2               ;   glyph decides what happens on removal, never whether cells match.
000587r 2               ;
000587r 2               ;   Wildcards (SPEC 6.3): a WILD cell continues any run. If the run has no
000587r 2               ;   colour yet it stays unset and is adopted from the first non-wild cell, so
000587r 2               ;   one prism can close a red horizontal run and a blue vertical run at once.
000587r 2               ;
000587r 2               ;   THE FOUR PASSES ARE ONE LOOP. A line is a start cell and a step, and the
000587r 2               ;   step is the only thing that differs: +1 across, +8 down, +9 down-right,
000587r 2               ;   +7 down-left. Every one of them ends on a sentinel rather than on a bounds
000587r 2               ;   check, which is what the 8-byte stride was bought for (SPEC 3.2):
000587r 2               ;
000587r 2               ;     across   from column 5, +1 lands on column 6      — wall
000587r 2               ;     down     from row 15,   +8 lands on row 16        — wall row
000587r 2               ;     down-r   from column 5, +9 lands on row+1 col 6   — wall
000587r 2               ;     down-l   from column 0, +7 lands on THIS row's column 7 — wall
000587r 2               ;
000587r 2               ;   The last one is the reason the left edge needs no test either: the byte
000587r 2               ;   before column 0 belongs to the row above, and it is already a wall.
000587r 2               ; =============================================================================
000587r 2               
000587r 2               ; -----------------------------------------------------------------------------
000587r 2               ;   MatchScan — find every run on the board
000587r 2               ;   In:  nothing
000587r 2               ;   Out: Marks filled, RunCount set, Z set if nothing matched.
000587r 2               ;        Modifies: A, X, Y, Scan*
000587r 2               ; -----------------------------------------------------------------------------
000587r 2               MatchScan:
000587r 2  20 rr rr       jsr MarksClear
00058Ar 2  A9 00          lda #0
00058Cr 2  8D rr rr       sta RunCount
00058Fr 2               
00058Fr 2  20 rr rr       jsr ScanFindTop               ; Everything below skips the empty air above
000592r 2  A5 rr          lda ScanTop                   ;   the pile, which on most boards is most of
000594r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE) ;   the board
000596r 2  B0 0C          bcs @Done                     ; Nothing on the board at all
000598r 2               
000598r 2  20 rr rr       jsr MatchScanHorizontal
00059Br 2  20 rr rr       jsr MatchScanVertical
00059Er 2  20 rr rr       jsr MatchScanDiagonal
0005A1r 2  20 rr rr       jsr MatchScanAntiDiagonal
0005A4r 2               @Done:
0005A4r 2  AD rr rr       lda RunCount                  ; Z set when nothing matched
0005A7r 2  60             rts
0005A8r 2               
0005A8r 2               ; -----------------------------------------------------------------------------
0005A8r 2               ;   ScanFindTop — board index of the first row that holds anything
0005A8r 2               ;   Out: ScanTop = row base, or BOARD_H * BOARD_STRIDE if the board is empty.
0005A8r 2               ;        Modifies: A, X, ScanTop
0005A8r 2               ;
0005A8r 2               ;   Every pass below starts here instead of at row 0. A pile six rows deep is
0005A8r 2               ;   scanned as six rows: 178 cells against 448, and the four passes come in
0005A8r 2               ;   under a third of the frame instead of over two whole ones. Finding it costs
0005A8r 2               ;   about 45 cycles a row of empty air, which is the cheapest part of the scan.
0005A8r 2               ;
0005A8r 2               ;   Correct as well as quick, and for a reason worth writing down: a line that
0005A8r 2               ;   reaches the pile at all must CROSS the pile's top row, because every one of
0005A8r 2               ;   the four steps moves down at most one row at a time. Starting the diagonals
0005A8r 2               ;   on that row rather than on row 0 therefore misses nothing.
0005A8r 2               ; -----------------------------------------------------------------------------
0005A8r 2               ScanFindTop:
0005A8r 2  A2 00          ldx #0
0005AAr 2               @Row:
0005AAr 2  BD rr rr       lda Board + 0,x               ; The six playfield columns; the two sentinel
0005ADr 2  1D rr rr       ora Board + 1,x               ;   ones would make every row look occupied
0005B0r 2  1D rr rr       ora Board + 2,x
0005B3r 2  1D rr rr       ora Board + 3,x
0005B6r 2  1D rr rr       ora Board + 4,x
0005B9r 2  1D rr rr       ora Board + 5,x
0005BCr 2  D0 09          bne @Found
0005BEr 2  8A             txa
0005BFr 2  18             clc
0005C0r 2  69 08          adc #BOARD_STRIDE
0005C2r 2  AA             tax
0005C3r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
0005C5r 2  90 E3          bcc @Row
0005C7r 2               @Found:
0005C7r 2  86 rr          stx ScanTop
0005C9r 2  60             rts
0005CAr 2               
0005CAr 2               ; -----------------------------------------------------------------------------
0005CAr 2               ;   The four passes (SPEC 6.2). Each sets a step and hands ScanLine its start
0005CAr 2               ;   cells; the start cell rides the stack because ScanLine needs both index
0005CAr 2               ;   registers and the scratch bytes below it.
0005CAr 2               ; -----------------------------------------------------------------------------
0005CAr 2               MatchScanHorizontal:            ; Every row of the pile, column 0 rightward
0005CAr 2  A9 01          lda #1
0005CCr 2  85 rr          sta ScanStep
0005CEr 2  A5 rr          lda ScanTop
0005D0r 2               @Line:
0005D0r 2  48             pha
0005D1r 2  20 rr rr       jsr ScanLine
0005D4r 2  68             pla
0005D5r 2  18             clc
0005D6r 2  69 08          adc #BOARD_STRIDE
0005D8r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
0005DAr 2  90 F4          bcc @Line
0005DCr 2  60             rts
0005DDr 2               
0005DDr 2               MatchScanVertical:              ; 6 columns, top of the pile downward
0005DDr 2  A9 08          lda #BOARD_STRIDE
0005DFr 2  85 rr          sta ScanStep
0005E1r 2  4C rr rr       jmp ScanTopRow
0005E4r 2               
0005E4r 2               MatchScanDiagonal:              ; down-right: the top row, then the left edge
0005E4r 2  A9 09          lda #(BOARD_STRIDE + 1)
0005E6r 2  85 rr          sta ScanStep
0005E8r 2  20 rr rr       jsr ScanTopRow
0005EBr 2  A9 00          lda #0
0005EDr 2  4C rr rr       jmp ScanEdgeColumn
0005F0r 2               
0005F0r 2               MatchScanAntiDiagonal:          ; down-left: the top row, then the right edge
0005F0r 2  A9 07          lda #(BOARD_STRIDE - 1)
0005F2r 2  85 rr          sta ScanStep
0005F4r 2  20 rr rr       jsr ScanTopRow
0005F7r 2  A9 05          lda #(BOARD_W - 1)
0005F9r 2  4C rr rr       jmp ScanEdgeColumn
0005FCr 2               
0005FCr 2               ; -----------------------------------------------------------------------------
0005FCr 2               ;   ScanTopRow — scan a line from each of the six cells of the pile's top row
0005FCr 2               ;   ScanEdgeColumn — and from the rows below it, in the column in A
0005FCr 2               ;   In:  ScanStep set, ScanTop set; A = column (ScanEdgeColumn only)
0005FCr 2               ;
0005FCr 2               ;   Between them those are every start cell a diagonal needs, and the top row
0005FCr 2               ;   alone is every start cell the vertical pass needs. The top row is scanned
0005FCr 2               ;   by the first, so the second skips it rather than scanning the longest
0005FCr 2               ;   diagonal twice.
0005FCr 2               ; -----------------------------------------------------------------------------
0005FCr 2               ScanTopRow:
0005FCr 2  A5 rr          lda ScanTop
0005FEr 2               @Line:
0005FEr 2  48             pha
0005FFr 2  20 rr rr       jsr ScanLine
000602r 2  68             pla
000603r 2  18             clc
000604r 2  69 01          adc #1
000606r 2  48             pha                           ; Six columns of that row, whichever row it
000607r 2  29 07          and #(BOARD_STRIDE - 1)       ;   is, so it is the COLUMN that ends the loop
000609r 2  C9 06          cmp #BOARD_W                  ;   and not the index
00060Br 2  68             pla                           ; PLA leaves C alone
00060Cr 2  90 F0          bcc @Line
00060Er 2  60             rts
00060Fr 2               
00060Fr 2               ScanEdgeColumn:
00060Fr 2  18             clc
000610r 2  65 rr          adc ScanTop                   ; That column, on the pile's top row...
000612r 2  18             clc
000613r 2  69 08          adc #BOARD_STRIDE             ;   ...and then the row below it
000615r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000617r 2  B0 0C          bcs @Done                     ; The pile is one row deep — there is no below
000619r 2               @Line:
000619r 2  48             pha
00061Ar 2  20 rr rr       jsr ScanLine
00061Dr 2  68             pla
00061Er 2  18             clc
00061Fr 2  69 08          adc #BOARD_STRIDE
000621r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000623r 2  90 F4          bcc @Line
000625r 2               @Done:
000625r 2  60             rts
000626r 2               
000626r 2               ; -----------------------------------------------------------------------------
000626r 2               ;   ScanLine — walk one line, marking every run of MATCH_MIN or more
000626r 2               ;   In:  A = start board index, ScanStep = direction
000626r 2               ;   Out: nothing.  Modifies: A, X, Scan*, Marks, RunCount
000626r 2               ;
000626r 2               ;   ONLY A WALL ENDS THE LINE. A hole in the middle of a row breaks the run
000626r 2               ;   and the walk carries on past it, because the cells beyond it are a run of
000626r 2               ;   their own — a line that stopped at the first empty cell would never look
000626r 2               ;   below the top of the pile at all, which is very nearly the whole board.
000626r 2               ;
000626r 2               ;   A colour change ends the run and starts a new one at the cell that broke
000626r 2               ;   it — the cell that broke a red run is the first cell of the blue one, and
000626r 2               ;   any prisms that were riding the red run stay with the red run. SPEC 6.3
000626r 2               ;   gives a wildcard to the run it is already in, not to both.
000626r 2               ; -----------------------------------------------------------------------------
000626r 2               ScanLine:
000626r 2  AA             tax                           ; The cursor lives in X for the whole line:
000627r 2  A9 FF          lda #$FF                      ;   this loop runs about four hundred times a
000629r 2  85 rr          sta ScanColor                 ;   scan and every cycle in it is four hundred
00062Br 2  A9 00          lda #0                        ;   cycles of the frame
00062Dr 2  85 rr          sta ScanLen
00062Fr 2               
00062Fr 2               @Cell:
00062Fr 2  BD rr rr       lda Board,x
000632r 2  F0 41          beq @Gap                      ; A hole breaks the run, not the line
000634r 2  C9 FF          cmp #TILE_WALL
000636r 2  F0 52          beq @End                      ; A wall is where the line stops
000638r 2  29 F8          and #COLOR_MASK               ; The colour key, glyph discarded (SPEC 4.2)
00063Ar 2  C5 rr          cmp ScanColor
00063Cr 2  F0 19          beq @Grow                     ; Same colour — the commonest case, first
00063Er 2  C9 70          cmp #WILD_BASE
000640r 2  F0 15          beq @Grow                     ; A prism continues any run (SPEC 6.3)
000642r 2               
000642r 2  A8             tay                           ; A different colour. Park it: everything
000643r 2  A5 rr          lda ScanColor                 ;   below either adopts it or starts a run
000645r 2  30 0E          bmi @Adopt                    ;   with it. $FF is the only value here with
000647r 2                                               ;   bit 7 set — colours are $40 to $70
000647r 2  A5 rr          lda ScanLen
000649r 2  C9 03          cmp #MATCH_MIN
00064Br 2  B0 14          bcs @Close                    ; The run it broke was long enough to mark
00064Dr 2               
00064Dr 2  84 rr          sty ScanColor                 ; It was not, so no call and no marking: this
00064Fr 2  A9 01          lda #1                        ;   cell is simply the start of the next run.
000651r 2  85 rr          sta ScanLen                   ;   Five adjacent cells in six differ in
000653r 2  D0 04          bne @Advance                  ;   colour, so this is the path that decides
000655r 2                                               ;   what a scan costs
000655r 2               @Adopt:
000655r 2  84 rr          sty ScanColor
000657r 2               @Grow:
000657r 2  E6 rr          inc ScanLen
000659r 2               @Advance:
000659r 2  8A             txa
00065Ar 2  18             clc
00065Br 2  65 rr          adc ScanStep
00065Dr 2  AA             tax
00065Er 2  4C rr rr       jmp @Cell
000661r 2               
000661r 2               @Close:
000661r 2  86 rr          stx ScanIdx
000663r 2  20 rr rr       jsr MatchEmit                 ; Mark it — and MatchEmit leaves ScanLen zero
000666r 2  A6 rr          ldx ScanIdx
000668r 2  BD rr rr       lda Board,x
00066Br 2  29 F8          and #COLOR_MASK
00066Dr 2  85 rr          sta ScanColor
00066Fr 2  A9 01          lda #1
000671r 2  85 rr          sta ScanLen
000673r 2  D0 E4          bne @Advance                  ; Always
000675r 2               
000675r 2               @Gap:
000675r 2  A5 rr          lda ScanLen
000677r 2  F0 E0          beq @Advance                  ; Nothing running — step over the hole. This
000679r 2                                               ;   is the cell the scan meets most often, so
000679r 2                                               ;   it is the one that must not call anything
000679r 2  86 rr          stx ScanIdx
00067Br 2  20 rr rr       jsr MatchEmit                 ; Close the run the hole broke...
00067Er 2  A6 rr          ldx ScanIdx
000680r 2  A9 FF          lda #$FF
000682r 2  85 rr          sta ScanColor                 ;   ...and start again on the far side of it
000684r 2  A9 00          lda #0
000686r 2  85 rr          sta ScanLen
000688r 2  F0 CF          beq @Advance                  ; Always
00068Ar 2               
00068Ar 2               @End:
00068Ar 2  A5 rr          lda ScanLen
00068Cr 2  F0 05          beq @Nothing                  ; The line ran out with nothing in hand
00068Er 2  86 rr          stx ScanIdx
000690r 2  4C rr rr       jmp MatchEmit                 ; Whatever was running ends with the line
000693r 2               @Nothing:
000693r 2  60             rts
000694r 2               
000694r 2               ; -----------------------------------------------------------------------------
000694r 2               ;   MatchEmit — a run has ended; mark it if it was long enough
000694r 2               ;   In:  ScanIdx = one cell PAST the run's last, ScanLen, ScanColor, ScanStep
000694r 2               ;   Out: nothing.  Modifies: A, X, Y, ScanEnd, ScanLen, RunCount, Marks
000694r 2               ;
000694r 2               ;   Runs are marked, not removed: a cell can be in a horizontal run and a
000694r 2               ;   vertical one at once, and it clears once while both runs score (SPEC 6.1).
000694r 2               ;   The union is what the MARKS bitmap is for.
000694r 2               ;
000694r 2               ;   SCORING HAPPENS HERE, before the mark loop and for the same reason the
000694r 2               ;   comment above used to promise it would: ScanLen still describes the run at
000694r 2               ;   this point and nowhere else, because the mark loop counts it down to zero
000694r 2               ;   on its way back along the line. MatchScoreRun leaves it alone.
000694r 2               ; -----------------------------------------------------------------------------
000694r 2               MatchEmit:
000694r 2  A5 rr          lda ScanLen
000696r 2  C9 03          cmp #MATCH_MIN
000698r 2  90 1D          bcc @Done                     ; Two in a row is not a run
00069Ar 2               
00069Ar 2  EE rr rr       inc RunCount
00069Dr 2  20 rr rr       jsr MatchScoreRun             ; SPEC 8 step 2, per run
0006A0r 2  A5 rr          lda ScanIdx
0006A2r 2  38             sec
0006A3r 2  E5 rr          sbc ScanStep                  ; Back onto the run's last cell
0006A5r 2  85 rr          sta ScanEnd
0006A7r 2               @Mark:
0006A7r 2  A5 rr          lda ScanEnd
0006A9r 2  20 rr rr       jsr MarkSet
0006ACr 2  A5 rr          lda ScanEnd
0006AEr 2  38             sec
0006AFr 2  E5 rr          sbc ScanStep
0006B1r 2  85 rr          sta ScanEnd
0006B3r 2  C6 rr          dec ScanLen
0006B5r 2  D0 F0          bne @Mark
0006B7r 2               @Done:
0006B7r 2  60             rts
0006B8r 2               
0006B8r 2               ; -----------------------------------------------------------------------------
0006B8r 2               ;   MatchScoreRun — the two per-run awards of SPEC 8 step 2
0006B8r 2               ;   In:  ScanLen = run length, ChainStep = the cascade step this is
0006B8r 2               ;   Out: nothing.  Modifies: A, X, Y.  Leaves ScanLen and ScanColor alone.
0006B8r 2               ;
0006B8r 2               ;       cascade_pts += length * TileValue[chain]
0006B8r 2               ;       cascade_pts += LengthBonus[length]
0006B8r 2               ;
0006B8r 2               ;   A cell in a horizontal run AND a vertical one is scored by both, and
0006B8r 2               ;   removed once (SPEC 6.1) — which is why this is per run and not per marked
0006B8r 2               ;   cell, and why it runs before the union in MARKS has anything to say.
0006B8r 2               ;
0006B8r 2               ;   MultiBonus is NOT here: it is per step, not per run, and CascadeScan adds
0006B8r 2               ;   it once the four passes have finished counting.
0006B8r 2               ; -----------------------------------------------------------------------------
0006B8r 2               MatchScoreRun:
0006B8r 2  AE rr rr       ldx ChainStep
0006BBr 2  CA             dex                           ; TileValue is indexed by chain - 1 ...
0006BCr 2  E0 08          cpx #8
0006BEr 2  90 02          bcc @Chain
0006C0r 2  A2 07          ldx #7                        ;   ... and flattens out at 8 (SPEC 9.1)
0006C2r 2               @Chain:
0006C2r 2  A4 rr          ldy ScanLen                   ; The multiply is Y additions (score.asm)
0006C4r 2  BD rr rr       lda TileValueLo,x
0006C7r 2  48             pha
0006C8r 2  BD rr rr       lda TileValueHi,x
0006CBr 2  AA             tax
0006CCr 2  68             pla
0006CDr 2  20 rr rr       jsr CascadeAddTimes
0006D0r 2               
0006D0r 2  A6 rr          ldx ScanLen
0006D2r 2  CA             dex
0006D3r 2  CA             dex
0006D4r 2  CA             dex                           ; LengthBonus is indexed by length - 3 ...
0006D5r 2  E0 05          cpx #5
0006D7r 2  90 02          bcc @Length
0006D9r 2  A2 04          ldx #4                        ;   ... and flattens out at 7 (SPEC 9.3). A
0006DBr 2               @Length:                        ;   vertical run can be all sixteen rows long
0006DBr 2  BD rr rr       lda LengthBonusLo,x
0006DEr 2  48             pha
0006DFr 2  BD rr rr       lda LengthBonusHi,x
0006E2r 2  AA             tax
0006E3r 2  68             pla
0006E4r 2  4C rr rr       jmp CascadeAdd
0006E7r 2               
0006E7r 2               ; -----------------------------------------------------------------------------
0006E7r 2               ;   MarksClear / MarkSet / MarkTest — the 16-byte bitmap
0006E7r 2               ;   One byte per row, bits 0-5 = columns 0-5. Union of runs is a free ORA.
0006E7r 2               ;
0006E7r 2               ;   MarkBits has eight entries rather than six so that the two sentinel
0006E7r 2               ;   columns index it harmlessly: bits 6 and 7 of a Marks byte are never set,
0006E7r 2               ;   so a walk over the whole 8-byte stride can test every cell it meets
0006E7r 2               ;   without first asking whether the cell is a wall.
0006E7r 2               ; -----------------------------------------------------------------------------
0006E7r 2               MarkBits:
0006E7r 2  01 02 04 08    .byte $01, $02, $04, $08, $10, $20, $40, $80
0006EBr 2  10 20 40 80  
0006EFr 2               
0006EFr 2               MarksClear:
0006EFr 2  A9 00          lda #0
0006F1r 2  A2 00          ldx #0
0006F3r 2               @Row:
0006F3r 2  9D rr rr       sta Marks,x
0006F6r 2  E8             inx
0006F7r 2  E0 10          cpx #MARKS_BYTES
0006F9r 2  D0 F8          bne @Row
0006FBr 2  60             rts
0006FCr 2               
0006FCr 2               MarkSet:                        ; In: A = board index.  Modifies: A, X, Y
0006FCr 2  AA             tax
0006FDr 2  29 07          and #(BOARD_STRIDE - 1)
0006FFr 2  A8             tay                           ; Y = column
000700r 2  8A             txa
000701r 2  4A             lsr a
000702r 2  4A             lsr a
000703r 2  4A             lsr a
000704r 2  AA             tax                           ; X = row
000705r 2  BD rr rr       lda Marks,x
000708r 2  19 rr rr       ora MarkBits,y
00070Br 2  9D rr rr       sta Marks,x
00070Er 2  60             rts
00070Fr 2               
00070Fr 2               MarkTest:                       ; In: A = board index.  Out: C set if marked
00070Fr 2  AA             tax                           ;     Modifies: A, X, Y
000710r 2  29 07          and #(BOARD_STRIDE - 1)
000712r 2  A8             tay
000713r 2  8A             txa
000714r 2  4A             lsr a
000715r 2  4A             lsr a
000716r 2  4A             lsr a
000717r 2  AA             tax
000718r 2  BD rr rr       lda Marks,x
00071Br 2  39 rr rr       and MarkBits,y
00071Er 2  F0 02          beq @No
000720r 2  38             sec
000721r 2  60             rts
000722r 2               @No:
000722r 2  18             clc
000723r 2  60             rts
000724r 2               
000724r 1               .include "../src/cascade.asm"
000724r 2               ; =============================================================================
000724r 2               ;   cascade.asm — Wizards Lab, clear resolution
000724r 2               ; =============================================================================
000724r 2               ;   SPEC.md section 8. A cascade runs from the moment a piece locks until no
000724r 2               ;   further matches exist, one step per iteration, with ChainStep counting the
000724r 2               ;   steps. The step order is fixed:
000724r 2               ;
000724r 2               ;       scan -> score matches -> enqueue reagents -> resolve queue
000724r 2               ;            -> animate -> remove -> level check -> gravity -> repeat
000724r 2               ;
000724r 2               ;   The effect queue always drains. Effects only ever remove tiles, never add
000724r 2               ;   them, and each cell can be marked at most once, so the queue is bounded by
000724r 2               ;   the 96 cells of the playfield.
000724r 2               ; =============================================================================
000724r 2               
000724r 2               ; -----------------------------------------------------------------------------
000724r 2               ;   CascadeBegin — called immediately after PieceLock
000724r 2               ;   Out: nothing.  Modifies: A
000724r 2               ; -----------------------------------------------------------------------------
000724r 2               CascadeBegin:
000724r 2  A9 01          lda #1
000726r 2  8D rr rr       sta ChainStep                 ; The step about to run is step 1 (SPEC 8)
000729r 2  A9 00          lda #0
00072Br 2  8D rr rr       sta CascadeLo
00072Er 2  8D rr rr       sta CascadeMid
000731r 2  8D rr rr       sta CascadeHi
000734r 2  8D rr rr       sta StarCount
000737r 2  8D rr rr       sta RunCount
00073Ar 2  4C rr rr       jmp EffectQClear
00073Dr 2               
00073Dr 2               ; -----------------------------------------------------------------------------
00073Dr 2               ;   CascadeScan — steps 1 to 4: find the runs, score them, fire the reagents
00073Dr 2               ;   In:  nothing
00073Dr 2               ;   Out: C set if anything is marked and the step has something to animate.
00073Dr 2               ;        C clear when nothing matched and the cascade has settled.
00073Dr 2               ;        Modifies: A, X, Y, Scan*, Marks, RunCount, Cascade*, StarCount
00073Dr 2               ;
00073Dr 2               ;   Steps 3 and 4 are the reagents, and they run between the scan and the
00073Dr 2               ;   removal because everything they do is add cells to Marks: by the time
00073Dr 2               ;   CascadeRemove walks the bitmap it cannot tell a cell the scan found from
00073Dr 2               ;   a cell a fireball took, and does not need to.
00073Dr 2               ;
00073Dr 2               ;   NOTHING HAS LEFT THE BOARD WHEN THIS RETURNS. Step 5 — the glow and the
00073Dr 2               ;   shatter (anim.asm) — happens between here and CascadeFinish below, over
00073Dr 2               ;   several frames, and it can only draw a cell's own colour and its own
00073Dr 2               ;   reagent because the cell is still sitting there saying what it is. That
00073Dr 2               ;   split is what the whole of P6 rests on, and it is the same property that
00073Dr 2               ;   let P5 make an effect queue entry one byte.
00073Dr 2               ;
00073Dr 2               ;   Step 2's per-run half is in MatchEmit, which is the one moment a run's
00073Dr 2               ;   length and colour are both in hand; what is left of it here is the bonus
00073Dr 2               ;   for having found several at once, which nothing knows until all four
00073Dr 2               ;   passes have finished.
00073Dr 2               ; -----------------------------------------------------------------------------
00073Dr 2               CascadeScan:
00073Dr 2  20 rr rr       jsr MatchScan
000740r 2  F0 1E          beq @Settled                  ; RunCount is zero — nothing left to clear
000742r 2               
000742r 2  AE rr rr       ldx RunCount                  ; SPEC 8 step 2, last line, and SPEC 9.4
000745r 2  CA             dex                           ; MultiBonus is indexed by runs - 1 ...
000746r 2  E0 05          cpx #5
000748r 2  90 02          bcc @Multi
00074Ar 2  A2 04          ldx #4                        ;   ... and flattens out at 5
00074Cr 2               @Multi:
00074Cr 2  BD rr rr       lda MultiBonusLo,x
00074Fr 2  48             pha
000750r 2  BD rr rr       lda MultiBonusHi,x
000753r 2  AA             tax
000754r 2  68             pla
000755r 2  20 rr rr       jsr CascadeAdd
000758r 2               
000758r 2  20 rr rr       jsr EffectEnqueueMarked       ; SPEC 8 step 3
00075Br 2  20 rr rr       jsr EffectResolve             ; SPEC 8 step 4
00075Er 2  38             sec
00075Fr 2  60             rts
000760r 2               @Settled:
000760r 2  18             clc
000761r 2  60             rts
000762r 2               
000762r 2               ; -----------------------------------------------------------------------------
000762r 2               ;   CascadeFinish — steps 6 and 7, once the animation has finished with them
000762r 2               ;   In:  Marks, as CascadeScan left it
000762r 2               ;   Out: nothing.  Modifies: A, X, Y, CellCount, Board, Level
000762r 2               ; -----------------------------------------------------------------------------
000762r 2               CascadeFinish:
000762r 2  20 rr rr       jsr CascadeRemove             ; SPEC 8 step 6
000765r 2  A5 rr          lda CellCount
000767r 2  4C rr rr       jmp ScoreLevelCheck           ; SPEC 8 step 7 — match and effect removals
00076Ar 2                                               ;   both count, and by here they are the same
00076Ar 2                                               ;   cells
00076Ar 2               
00076Ar 2               ; -----------------------------------------------------------------------------
00076Ar 2               ;   CascadeRemove — empty every marked cell and queue it for redraw
00076Ar 2               ;   In:  Marks
00076Ar 2               ;   Out: CellCount = cells removed.  Modifies: A, X, Y, CellCount, RedrawCol
00076Ar 2               ;   SPEC 8 step 6.
00076Ar 2               ;
00076Ar 2               ;   Every marked cell is zeroed in one go, because the gravity that follows
00076Ar 2               ;   needs a board that is finished changing. Only the REDRAW is rationed: at
00076Ar 2               ;   most 96 cells can be marked and the dirty ring holds 64, and P5 made that
00076Ar 2               ;   reachable — a bolt is 21 cells on its own and a chain of them is most of
00076Ar 2               ;   the well. A mark dropped by a full ring is never made again (D6), so
00076Ar 2               ;   rather than drop one this falls back to RenderBoard, the whole-well cursor
00076Ar 2               ;   RenderFlush already feeds a frame at a time (D12). Four frames of redraw
00076Ar 2               ;   instead of a hole in the screen, and only on the rare huge step: a plain
00076Ar 2               ;   three-in-a-row never comes near the cap.
00076Ar 2               ;
00076Ar 2               ;   CellCount goes to ScoreLevelCheck — thirty cleared tiles is a level
00076Ar 2               ;   (SPEC 10.1). By the time this runs the cells have already glowed and
00076Ar 2               ;   shattered (anim.asm); what it draws over them is the empty well behind.
00076Ar 2               ; -----------------------------------------------------------------------------
00076Ar 2               CascadeRemove:
00076Ar 2  A9 00          lda #0
00076Cr 2  85 rr          sta CellCount
00076Er 2  AA             tax                           ; X = board index, walked a row at a time
00076Fr 2               @Row:
00076Fr 2  8A             txa
000770r 2  4A             lsr a
000771r 2  4A             lsr a
000772r 2  4A             lsr a
000773r 2  A8             tay
000774r 2  B9 rr rr       lda Marks,y
000777r 2  F0 38          beq @NextRow                  ; Nothing marked in this row, and most rows
000779r 2                                               ;   hold nothing marked
000779r 2               @Cell:
000779r 2  8A             txa
00077Ar 2  48             pha
00077Br 2  20 rr rr       jsr MarkTest
00077Er 2  68             pla
00077Fr 2  AA             tax                           ; MarkTest needs X, so the cursor comes back
000780r 2  90 1F          bcc @NextCell                 ;   through A. Neither PLA nor TAX touches C.
000782r 2  A9 00          lda #TILE_EMPTY
000784r 2  9D rr rr       sta Board,x
000787r 2  E6 rr          inc CellCount
000789r 2               
000789r 2  AD rr rr       lda DirtyCount                ; Room to mark this one?
00078Cr 2  C9 40          cmp #DIRTY_ENTRIES
00078Er 2  B0 0A          bcs @Bulk                     ; No — redraw the lot instead of losing it
000790r 2  8A             txa
000791r 2  48             pha
000792r 2  20 rr rr       jsr RenderCell
000795r 2  68             pla
000796r 2  AA             tax
000797r 2  4C rr rr       jmp @NextCell
00079Ar 2               @Bulk:
00079Ar 2  8A             txa
00079Br 2  48             pha
00079Cr 2  20 rr rr       jsr RenderBoard               ; Sets the cursor and nothing else, so the
00079Fr 2  68             pla                           ;   cells already queued still land and the
0007A0r 2  AA             tax                           ;   redraw overwrites them with the same values
0007A1r 2               @NextCell:
0007A1r 2  E8             inx
0007A2r 2  8A             txa
0007A3r 2  29 07          and #(BOARD_STRIDE - 1)
0007A5r 2  C9 06          cmp #BOARD_W
0007A7r 2  90 D0          bcc @Cell
0007A9r 2               
0007A9r 2  8A             txa                           ; X is on the row's first sentinel column;
0007AAr 2  18             clc                           ;   step over both of them
0007ABr 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
0007ADr 2  AA             tax
0007AEr 2  4C rr rr       jmp @Test
0007B1r 2               
0007B1r 2               @NextRow:
0007B1r 2  8A             txa
0007B2r 2  18             clc
0007B3r 2  69 08          adc #BOARD_STRIDE
0007B5r 2  AA             tax
0007B6r 2               @Test:
0007B6r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
0007B8r 2  90 B5          bcc @Row
0007BAr 2  60             rts
0007BBr 2               
0007BBr 2               ; -----------------------------------------------------------------------------
0007BBr 2               ;   CascadeSettle — apply the star multiplier and bank the points
0007BBr 2               ;   SPEC 8 SETTLE, SPEC 9.6 — the doubling covers the WHOLE cascade, including
0007BBr 2               ;   points scored before the star cleared.
0007BBr 2               ; -----------------------------------------------------------------------------
0007BBr 2               CascadeSettle:
0007BBr 2  AD rr rr       lda StarCount
0007BEr 2  C9 03          cmp #STAR_SHIFT_CAP
0007C0r 2  90 02          bcc @Shift
0007C2r 2  A9 03          lda #STAR_SHIFT_CAP           ; x8 and no further, however many were caught
0007C4r 2               @Shift:
0007C4r 2  AA             tax
0007C5r 2  F0 06          beq @Bank
0007C7r 2               @Double:
0007C7r 2  20 rr rr       jsr CascadeDouble             ; A doubling in BCD is one self-addition
0007CAr 2  CA             dex
0007CBr 2  D0 FA          bne @Double
0007CDr 2               @Bank:
0007CDr 2  4C rr rr       jmp ScoreAdd                  ; Its carry is not read: ScoreHighCheck has
0007D0r 2                                               ;   already raised the fanfare and the flash
0007D0r 2                                               ;   itself, and does so exactly once
0007D0r 2               
0007D0r 2               
0007D0r 2               ; =============================================================================
0007D0r 2               ;   The reagents (SPEC 7)
0007D0r 2               ; =============================================================================
0007D0r 2               ;   Steps 3 and 4 of SPEC 8, and the five effects between them. The shape is:
0007D0r 2               ;
0007D0r 2               ;     EffectEnqueueMarked   walks MARKS once the scan has finished, and offers
0007D0r 2               ;                           every matched cell to EffectEnqueue
0007D0r 2               ;     EffectEnqueue         decides what a cell being removed is worth — a
0007D0r 2               ;                           prism pays, a star counts, a fireball/bolt/bomb
0007D0r 2               ;                           queues
0007D0r 2               ;     EffectResolve         drains the queue, detonating each in turn
0007D0r 2               ;     EffectFireball/Bolt/  list the cells a detonation reaches, and offer each
0007D0r 2               ;       Bomb                one to EffectHit
0007D0r 2               ;     EffectHit             marks it, scores it, and offers it to
0007D0r 2               ;                           EffectEnqueue in its turn — which is the whole of
0007D0r 2               ;                           SPEC 7.2's chain reaction, in one routine
0007D0r 2               ;
0007D0r 2               ;   TERMINATION IS STRUCTURAL, not a limit. An effect only ever MARKS cells and
0007D0r 2               ;   never adds one, and EffectHit refuses a cell that is already marked, so a
0007D0r 2               ;   cell can be pushed at most once and the loop is bounded by the 96 cells of
0007D0r 2               ;   the well.
0007D0r 2               ;
0007D0r 2               ;   Nothing here touches the board. Marked cells are still sitting there,
0007D0r 2               ;   readable, until CascadeRemove zeroes them in step 6 — which is what lets a
0007D0r 2               ;   queue entry be a board index and nothing else (constants.inc).
0007D0r 2               ; =============================================================================
0007D0r 2               
0007D0r 2               ; -----------------------------------------------------------------------------
0007D0r 2               ;   EffectEnqueueMarked — SPEC 8 step 3
0007D0r 2               ;   In:  Marks, as MatchScan left it
0007D0r 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectQ, StarCount, Cascade*
0007D0r 2               ;
0007D0r 2               ;   Nothing called from here marks anything, so the bitmap being walked cannot
0007D0r 2               ;   change underneath the walk. Step 4 is where marking starts, and the cells
0007D0r 2               ;   it marks enqueue themselves as they are marked (EffectHit) rather than
0007D0r 2               ;   waiting for a second pass over MARKS.
0007D0r 2               ;
0007D0r 2               ;   It has to be a pass over the union rather than part of MatchEmit's mark
0007D0r 2               ;   loop: a cell in a horizontal run AND a vertical one is marked twice and
0007D0r 2               ;   would then detonate twice (SPEC 6.1).
0007D0r 2               ; -----------------------------------------------------------------------------
0007D0r 2               EffectEnqueueMarked:
0007D0r 2  A9 00          lda #0
0007D2r 2  85 rr          sta EffectIdx
0007D4r 2               @Row:
0007D4r 2  A5 rr          lda EffectIdx
0007D6r 2  4A             lsr a
0007D7r 2  4A             lsr a
0007D8r 2  4A             lsr a
0007D9r 2  A8             tay
0007DAr 2  B9 rr rr       lda Marks,y
0007DDr 2  F0 20          beq @NextRow                  ; Nothing marked in this row, which is most
0007DFr 2                                               ;   rows of most steps
0007DFr 2               @Cell:
0007DFr 2  A5 rr          lda EffectIdx
0007E1r 2  20 rr rr       jsr MarkTest
0007E4r 2  90 05          bcc @NextCell
0007E6r 2  A6 rr          ldx EffectIdx
0007E8r 2  20 rr rr       jsr EffectEnqueue
0007EBr 2               @NextCell:
0007EBr 2  E6 rr          inc EffectIdx
0007EDr 2  A5 rr          lda EffectIdx
0007EFr 2  29 07          and #(BOARD_STRIDE - 1)
0007F1r 2  C9 06          cmp #BOARD_W
0007F3r 2  90 EA          bcc @Cell
0007F5r 2               
0007F5r 2  A5 rr          lda EffectIdx                 ; On the row's first sentinel column; step
0007F7r 2  18             clc                           ;   over both of them
0007F8r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
0007FAr 2  85 rr          sta EffectIdx
0007FCr 2  4C rr rr       jmp @Test
0007FFr 2               
0007FFr 2               @NextRow:
0007FFr 2  A5 rr          lda EffectIdx
000801r 2  18             clc
000802r 2  69 08          adc #BOARD_STRIDE
000804r 2  85 rr          sta EffectIdx
000806r 2               @Test:
000806r 2  A5 rr          lda EffectIdx
000808r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
00080Ar 2  90 C8          bcc @Row
00080Cr 2  60             rts
00080Dr 2               
00080Dr 2               ; -----------------------------------------------------------------------------
00080Dr 2               ;   EffectEnqueue — a marked cell is going; make what it holds count
00080Dr 2               ;   In:  X = board index of a cell that is ALREADY marked
00080Dr 2               ;   Out: nothing.  Modifies: A, X, Y
00080Dr 2               ;
00080Dr 2               ;   Called exactly once per removed cell — from step 3 for the cells the scan
00080Dr 2               ;   found, and from EffectHit for every cell an effect takes. Three outcomes:
00080Dr 2               ;
00080Dr 2               ;     a prism   pays BONUS_PRISM here and now and is never queued: it has no
00080Dr 2               ;               effect to fire, only a bonus (SPEC 7.3)
00080Dr 2               ;     a star    counts into StarCount and is never queued either — SPEC 8
00080Dr 2               ;               step 3 is explicit that stars are counted, not queued
00080Dr 2               ;     the rest  go on the queue, and pay their trigger bonus when they pop
00080Dr 2               ;
00080Dr 2               ;   THE COLOUR IS TESTED BEFORE THE GLYPH, and that order is not cosmetic. A
00080Dr 2               ;   prism is glyph 0 of colour 6, indistinguishable from a plain potion by its
00080Dr 2               ;   glyph alone — and from P6 onward the board may hold any of the prism's four
00080Dr 2               ;   idle rotation frames, whose low three bits read as a bolt or a bomb and
00080Dr 2               ;   would detonate one. Colour 6 is the only test that stays true.
00080Dr 2               ; -----------------------------------------------------------------------------
00080Dr 2               EffectEnqueue:
00080Dr 2  BD rr rr       lda Board,x
000810r 2  29 F8          and #COLOR_MASK
000812r 2  C9 70          cmp #WILD_BASE
000814r 2  F0 12          beq @Prism
000816r 2  BD rr rr       lda Board,x
000819r 2  29 07          and #GLYPH_MASK
00081Br 2  F0 0A          beq @Done                     ; A plain potion, which is most of the board
00081Dr 2  C9 04          cmp #GLYPH_STAR
00081Fr 2  F0 0A          beq @Star
000821r 2  B0 04          bcs @Done                     ; Glyphs 5-7 are animation frames (SPEC 4.4),
000823r 2                                               ;   never reagents
000823r 2  8A             txa
000824r 2  4C rr rr       jmp EffectQPush               ; Fireball, bolt or bomb — glyphs 1 to 3
000827r 2               @Done:
000827r 2  60             rts
000828r 2               @Prism:
000828r 2  4C rr rr       jmp EffectPrism               ; Both of these are the far side of the three
00082Br 2               @Star:                          ;   detonations below, well out of branch range
00082Br 2  4C rr rr       jmp EffectStar
00082Er 2               
00082Er 2               ; -----------------------------------------------------------------------------
00082Er 2               ;   EffectHit — one cell of one detonation
00082Er 2               ;   In:  X = board index
00082Er 2               ;   Out: nothing.  Modifies: A, X, Y
00082Er 2               ;
00082Er 2               ;   The whole of SPEC 8 step 4's inner loop, which is why every effect below
00082Er 2               ;   is nothing but a list of cells to offer it.
00082Er 2               ;
00082Er 2               ;   A cell that is empty, a wall, or already marked is not a target. "Not
00082Er 2               ;   already marked" is what makes the queue terminate and what stops a cell
00082Er 2               ;   being paid for twice; testing the WALL here is what lets the walks above
00082Er 2               ;   run over the two sentinel columns without bounds checks of their own. A
00082Er 2               ;   marked sentinel would be zeroed by CascadeRemove and the well would grow
00082Er 2               ;   a hole in its floor.
00082Er 2               ; -----------------------------------------------------------------------------
00082Er 2               EffectHit:
00082Er 2  BD rr rr       lda Board,x
000831r 2  F0 1A          beq @Done                     ; Empty
000833r 2  C9 FF          cmp #TILE_WALL
000835r 2  F0 16          beq @Done                     ; A sentinel is never a target
000837r 2  8A             txa
000838r 2  48             pha
000839r 2  20 rr rr       jsr MarkTest
00083Cr 2  68             pla
00083Dr 2  AA             tax                           ; Neither PLA nor TAX touches C
00083Er 2  B0 0D          bcs @Done                     ; Already going
000840r 2               
000840r 2  8A             txa
000841r 2  48             pha                           ; MarkSet takes the index in A, which PHA left
000842r 2  20 rr rr       jsr MarkSet                   ;   alone
000845r 2  20 rr rr       jsr EffectScoreCell           ; SPEC 9.2, per cell an effect took
000848r 2  68             pla
000849r 2  AA             tax
00084Ar 2  4C rr rr       jmp EffectEnqueue             ; ...and if it was a reagent, it fires too
00084Dr 2               @Done:
00084Dr 2  60             rts
00084Er 2               
00084Er 2               ; -----------------------------------------------------------------------------
00084Er 2               ;   EffectScoreCell — EffectValue[chain] for one cell taken by an effect
00084Er 2               ;   Out: nothing.  Modifies: A, X, Y
00084Er 2               ;   SPEC 9.2 — deliberately dearer than a matched tile at low chain depth, so
00084Er 2               ;   that the first reagent a player ever sets off feels better than plain play.
00084Er 2               ; -----------------------------------------------------------------------------
00084Er 2               EffectScoreCell:
00084Er 2  AE rr rr       ldx ChainStep
000851r 2  CA             dex                           ; Indexed by chain - 1 ...
000852r 2  E0 08          cpx #8
000854r 2  90 02          bcc @Chain
000856r 2  A2 07          ldx #7                        ;   ... and flattens out at 8
000858r 2               @Chain:
000858r 2  BD rr rr       lda EffectValueLo,x
00085Br 2  48             pha
00085Cr 2  BD rr rr       lda EffectValueHi,x
00085Fr 2  AA             tax
000860r 2  68             pla
000861r 2  4C rr rr       jmp CascadeAdd
000864r 2               
000864r 2               ; -----------------------------------------------------------------------------
000864r 2               ;   EffectResolve — drain the queue (SPEC 8 step 4)
000864r 2               ;   Out: nothing.  Modifies: A, X, Y, Effect*, Marks, Cascade*, StarCount
000864r 2               ;
000864r 2               ;   The detonation runs first and the trigger bonus is paid on the way back,
000864r 2               ;   which is the order SPEC 8 step 4 sets out. It makes no difference to the
000864r 2               ;   total — everything lands in the same accumulator — but it does mean the
000864r 2               ;   glyph has to survive a routine that clobbers all three registers, and the
000864r 2               ;   stack is the cheapest place to put it.
000864r 2               ; -----------------------------------------------------------------------------
000864r 2               EffectResolve:
000864r 2               @Loop:
000864r 2  20 rr rr       jsr EffectQPop
000867r 2  90 45          bcc @Done                     ; Empty — the step is finished
000869r 2               
000869r 2  AA             tax                           ; X = the detonating cell
00086Ar 2  BD rr rr       lda Board,x                   ; Still on the board: step 6 has not run
00086Dr 2  29 07          and #GLYPH_MASK
00086Fr 2  48             pha
000870r 2  C9 01          cmp #GLYPH_FIREBALL
000872r 2  F0 0F          beq @Fireball
000874r 2  C9 02          cmp #GLYPH_BOLT
000876r 2  F0 20          beq @Bolt
000878r 2               
000878r 2  A9 07          lda #SFX_BOMB                 ; Glyph 3 — nothing else ever reaches here
00087Ar 2  8D rr rr       sta SfxRequest
00087Dr 2  20 rr rr       jsr EffectBomb
000880r 2  4C rr rr       jmp @Bonus
000883r 2               
000883r 2               @Fireball:
000883r 2  A9 05          lda #SFX_FIREBALL
000885r 2  8D rr rr       sta SfxRequest
000888r 2  BD rr rr       lda Board,x
00088Br 2  29 F8          and #COLOR_MASK               ; Its own colour, which can never be wild
00088Dr 2  48             pha
00088Er 2  20 rr rr       jsr HalColorFlash             ; SPEC 4.6, 14 — every tile of that colour goes
000891r 2  68             pla                           ;   white for the glow window, which is one VDP
000892r 2                                               ;   colour byte here and one compare a cell on
000892r 2                                               ;   the Commodores. AnimGlowBegin reads
000892r 2                                               ;   TintColor to find out that it happened
000892r 2  20 rr rr       jsr EffectFireball
000895r 2  4C rr rr       jmp @Bonus
000898r 2               
000898r 2               @Bolt:
000898r 2  A9 06          lda #SFX_BOLT
00089Ar 2  8D rr rr       sta SfxRequest
00089Dr 2  20 rr rr       jsr EffectBolt
0008A0r 2               
0008A0r 2               @Bonus:
0008A0r 2  68             pla
0008A1r 2  A8             tay                           ; TriggerBonus is indexed by glyph (SPEC 9.5),
0008A2r 2  B9 rr rr       lda TriggerBonusLo,y          ;   and is paid however the reagent was removed
0008A5r 2  BE rr rr       ldx TriggerBonusHi,y
0008A8r 2  20 rr rr       jsr CascadeAdd
0008ABr 2  4C rr rr       jmp @Loop
0008AEr 2               @Done:
0008AEr 2  60             rts
0008AFr 2               
0008AFr 2               ; -----------------------------------------------------------------------------
0008AFr 2               ;   The five reagents (SPEC 7.3). Each lists the cells it reaches and leaves
0008AFr 2               ;   the marking, the scoring and the chain reaction to EffectHit.
0008AFr 2               ; -----------------------------------------------------------------------------
0008AFr 2               
0008AFr 2               ; -----------------------------------------------------------------------------
0008AFr 2               ;   EffectFireball — every remaining tile of one colour, board wide
0008AFr 2               ;   In:  A = the colour key ($40 to $68)
0008AFr 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectArg, Marks, Cascade*
0008AFr 2               ;   SPEC 7.3 — the signature reagent, and the reason a chain goes three deep.
0008AFr 2               ;
0008AFr 2               ;   PRISMS ARE IMMUNE AND IT COSTS NOTHING TO MAKE THEM SO (SPEC 7.4). A prism
0008AFr 2               ;   is colour 6 and a fireball's colour never is, so the compare below is the
0008AFr 2               ;   immunity — there is no special case to forget. An empty cell and a wall
0008AFr 2               ;   fail it for the same reason, which is why this walks all eight columns of
0008AFr 2               ;   every row rather than stepping over the sentinels.
0008AFr 2               ;
0008AFr 2               ;   The fireball's own cell is already marked, so it is not a target of itself,
0008AFr 2               ;   and a second fireball of the same colour in the same step finds nothing
0008AFr 2               ;   left to take — and still pays its trigger bonus (SPEC 7.3).
0008AFr 2               ; -----------------------------------------------------------------------------
0008AFr 2               EffectFireball:
0008AFr 2  85 rr          sta EffectArg                 ; The colour it is hunting
0008B1r 2  A9 00          lda #0
0008B3r 2  85 rr          sta EffectIdx
0008B5r 2               @Cell:
0008B5r 2  A6 rr          ldx EffectIdx
0008B7r 2  BD rr rr       lda Board,x
0008BAr 2  29 F8          and #COLOR_MASK
0008BCr 2  C5 rr          cmp EffectArg
0008BEr 2  D0 03          bne @Next
0008C0r 2  20 rr rr       jsr EffectHit
0008C3r 2               @Next:
0008C3r 2  E6 rr          inc EffectIdx
0008C5r 2  A5 rr          lda EffectIdx
0008C7r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
0008C9r 2  90 EA          bcc @Cell
0008CBr 2  60             rts
0008CCr 2               
0008CCr 2               ; -----------------------------------------------------------------------------
0008CCr 2               ;   EffectBolt — the whole row and the whole column through the bolt's cell
0008CCr 2               ;   In:  X = board index
0008CCr 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectEnd, EffectArg, Marks
0008CCr 2               ;   SPEC 7.3 — up to 6 + 16 - 1 = 21 cells, and the only reagent that reaches
0008CCr 2               ;   something buried at the bottom of a column.
0008CCr 2               ;
0008CCr 2               ;   Neither walk needs clipping: a row is six cells wherever it is, and a
0008CCr 2               ;   column is sixteen. The bolt's own cell is offered twice, once by each, and
0008CCr 2               ;   is refused both times because it was marked before this was called.
0008CCr 2               ; -----------------------------------------------------------------------------
0008CCr 2               EffectBolt:
0008CCr 2  8A             txa
0008CDr 2  29 07          and #(BOARD_STRIDE - 1)
0008CFr 2  85 rr          sta EffectArg                 ; Its column, for the second walk
0008D1r 2  8A             txa
0008D2r 2  29 F8          and #(256 - BOARD_STRIDE)     ; $F8 — its row base
0008D4r 2  85 rr          sta EffectIdx
0008D6r 2  18             clc
0008D7r 2  69 06          adc #BOARD_W
0008D9r 2  85 rr          sta EffectEnd                 ; One past the row's last playfield cell
0008DBr 2               @Row:
0008DBr 2  A6 rr          ldx EffectIdx
0008DDr 2  20 rr rr       jsr EffectHit
0008E0r 2  E6 rr          inc EffectIdx
0008E2r 2  A5 rr          lda EffectIdx
0008E4r 2  C5 rr          cmp EffectEnd
0008E6r 2  90 F3          bcc @Row
0008E8r 2               
0008E8r 2  A5 rr          lda EffectArg                 ; The column, row 0 downward
0008EAr 2  85 rr          sta EffectIdx
0008ECr 2               @Col:
0008ECr 2  A6 rr          ldx EffectIdx
0008EEr 2  20 rr rr       jsr EffectHit
0008F1r 2  A5 rr          lda EffectIdx
0008F3r 2  18             clc
0008F4r 2  69 08          adc #BOARD_STRIDE
0008F6r 2  85 rr          sta EffectIdx
0008F8r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
0008FAr 2  90 F0          bcc @Col
0008FCr 2  60             rts
0008FDr 2               
0008FDr 2               ; -----------------------------------------------------------------------------
0008FDr 2               ;   EffectBomb — the 3 x 3 block centred on the bomb, clipped at the edges
0008FDr 2               ;   In:  X = board index
0008FDr 2               ;   Out: nothing.  Modifies: A, X, Y, Effect*, Tmp0, Tmp1, Marks, Cascade*
0008FDr 2               ;   SPEC 7.3 — up to 9 cells, and the reagent most likely to catch another.
0008FDr 2               ;
0008FDr 2               ;   BOTH SPANS ARE CLIPPED, and the row span has to be: row 0 minus one row is
0008FDr 2               ;   index minus 8, which underflows a byte and reads the BSS in front of a
0008FDr 2               ;   page-aligned Board. The column span could lean on the sentinels the way
0008FDr 2               ;   every other walk in the game does — except at row 0, column 0, where
0008FDr 2               ;   "one to the left" is index $FF and off the end of the board. Clipping both
0008FDr 2               ;   is smaller than special-casing one corner.
0008FDr 2               ;
0008FDr 2               ;   Tmp0 and Tmp1 are finished with before the first JSR, which is what the
0008FDr 2               ;   rule about them says (zeropage.inc).
0008FDr 2               ; -----------------------------------------------------------------------------
0008FDr 2               EffectBomb:
0008FDr 2  8A             txa                           ; --- the column span ---
0008FEr 2  29 07          and #(BOARD_STRIDE - 1)
000900r 2  A8             tay
000901r 2  F0 01          beq @Left                     ; Column 0 — the block starts there
000903r 2  88             dey
000904r 2               @Left:
000904r 2  84 rr          sty Tmp0                      ; First column of the block
000906r 2  8A             txa
000907r 2  29 07          and #(BOARD_STRIDE - 1)
000909r 2  C9 05          cmp #(BOARD_W - 1)
00090Br 2  B0 02          bcs @Right                    ; Already against the right wall
00090Dr 2  69 01          adc #1                        ; C is clear — the CMP above failed
00090Fr 2               @Right:
00090Fr 2  85 rr          sta EffectArg                 ; Last column of the block
000911r 2               
000911r 2  8A             txa                           ; --- the row span ---
000912r 2  29 F8          and #(256 - BOARD_STRIDE)
000914r 2  85 rr          sta Tmp1                      ; The bomb's own row base
000916r 2  F0 03          beq @Top                      ; Row 0 — the block starts there
000918r 2  38             sec
000919r 2  E9 08          sbc #BOARD_STRIDE
00091Br 2               @Top:
00091Br 2  18             clc
00091Cr 2  65 rr          adc Tmp0
00091Er 2  85 rr          sta EffectRow                 ; First cell of the block's first row
000920r 2               
000920r 2  A5 rr          lda Tmp1
000922r 2  C9 78          cmp #((BOARD_H - 1) * BOARD_STRIDE)
000924r 2  B0 03          bcs @Bottom                   ; Row 15 — the block ends there
000926r 2  18             clc
000927r 2  69 08          adc #BOARD_STRIDE
000929r 2               @Bottom:
000929r 2  18             clc
00092Ar 2  65 rr          adc Tmp0
00092Cr 2  85 rr          sta EffectEnd                 ; First cell of the block's LAST row
00092Er 2               
00092Er 2               @Rows:
00092Er 2  A5 rr          lda EffectRow
000930r 2  85 rr          sta EffectIdx
000932r 2               @Cell:
000932r 2  A6 rr          ldx EffectIdx
000934r 2  20 rr rr       jsr EffectHit
000937r 2  A5 rr          lda EffectIdx
000939r 2  29 07          and #(BOARD_STRIDE - 1)
00093Br 2  C5 rr          cmp EffectArg
00093Dr 2  E6 rr          inc EffectIdx                 ; INC touches N and Z only, so the CMP's carry
00093Fr 2  90 F1          bcc @Cell                     ;   is still the one being branched on
000941r 2               
000941r 2  A5 rr          lda EffectRow
000943r 2  C5 rr          cmp EffectEnd
000945r 2  B0 07          bcs @Done                     ; That was the last row of the block
000947r 2  18             clc
000948r 2  69 08          adc #BOARD_STRIDE
00094Ar 2  85 rr          sta EffectRow
00094Cr 2  D0 E0          bne @Rows                     ; Always — a row base past the first is >= 8
00094Er 2               @Done:
00094Er 2  60             rts
00094Fr 2               
00094Fr 2               ; -----------------------------------------------------------------------------
00094Fr 2               ;   EffectStar — removes nothing; it multiplies (SPEC 7.3)
00094Fr 2               ;   Out: nothing.  Modifies: A
00094Fr 2               ;
00094Fr 2               ;   The cap is not applied here. SPEC 9.6 doubles the WHOLE cascade up to three
00094Fr 2               ;   times at the end, so the count has to survive to CascadeSettle, which is
00094Fr 2               ;   where min(StarCount, STAR_SHIFT_CAP) is taken. A cascade cannot remove more
00094Fr 2               ;   than the 96 cells of the well, so the count cannot wrap on its way there.
00094Fr 2               ; -----------------------------------------------------------------------------
00094Fr 2               EffectStar:
00094Fr 2  EE rr rr       inc StarCount
000952r 2  A9 08          lda #SFX_STAR
000954r 2  8D rr rr       sta SfxRequest
000957r 2  60             rts
000958r 2               
000958r 2               ; -----------------------------------------------------------------------------
000958r 2               ;   EffectPrism — removes nothing; a flat bonus per prism cleared (SPEC 9.5)
000958r 2               ;   Out: nothing.  Modifies: A, X
000958r 2               ;
000958r 2               ;   It goes through CascadeAdd and not ScoreAward, so a star in the same
000958r 2               ;   cascade doubles it: SPEC 9.6 exempts only the soft drop and the level
000958r 2               ;   bonus from the multiplier (D5, D18).
000958r 2               ; -----------------------------------------------------------------------------
000958r 2               EffectPrism:
000958r 2  A9 09          lda #SFX_PRISM
00095Ar 2  8D rr rr       sta SfxRequest
00095Dr 2  A9 00          lda #<BONUS_PRISM
00095Fr 2  A2 04          ldx #>BONUS_PRISM
000961r 2  4C rr rr       jmp CascadeAdd
000964r 2               
000964r 2               ; -----------------------------------------------------------------------------
000964r 2               ;   The effect queue — a ring of board indices, one byte an entry.
000964r 2               ;
000964r 2               ;   The board still holds every pending reagent when its entry pops, because
000964r 2               ;   nothing is zeroed until step 6, so the glyph and the colour SPEC 8 packs
000964r 2               ;   into the entry are one `lda Board,x` away and storing them again would be
000964r 2               ;   storing a copy of the board (constants.inc).
000964r 2               ;
000964r 2               ;   Head and tail are entry numbers; the ring keeps one slot free, so it holds
000964r 2               ;   EFFECTQ_ENTRIES - 1. On overflow the effect is DROPPED and the cascade
000964r 2               ;   carries on (D6) — the cell is still marked, still scored and still removed,
000964r 2               ;   it simply does not detonate. With at most one reagent a piece, 47 pending
000964r 2               ;   detonations is not somewhere a real board goes.
000964r 2               ; -----------------------------------------------------------------------------
000964r 2               EffectQClear:
000964r 2  A9 00          lda #0
000966r 2  8D rr rr       sta EffectQHead
000969r 2  8D rr rr       sta EffectQTail
00096Cr 2  60             rts
00096Dr 2               
00096Dr 2               ; -----------------------------------------------------------------------------
00096Dr 2               ;   EffectQPush — In: A = board index.  Modifies: A, X, Y
00096Dr 2               ; -----------------------------------------------------------------------------
00096Dr 2               EffectQPush:
00096Dr 2  AE rr rr       ldx EffectQTail
000970r 2  AC rr rr       ldy EffectQTail
000973r 2  C8             iny
000974r 2  C0 30          cpy #EFFECTQ_ENTRIES
000976r 2  90 02          bcc @Store
000978r 2  A0 00          ldy #0                        ; Wrap
00097Ar 2               @Store:
00097Ar 2  CC rr rr       cpy EffectQHead
00097Dr 2  F0 06          beq @Full                     ; One slot free is the ring being full
00097Fr 2  9D rr rr       sta EffectQ,x
000982r 2  8C rr rr       sty EffectQTail
000985r 2               @Full:
000985r 2  60             rts
000986r 2               
000986r 2               ; -----------------------------------------------------------------------------
000986r 2               ;   EffectQPop — Out: C set and A = board index; C clear when empty
000986r 2               ;   Modifies: A, X
000986r 2               ; -----------------------------------------------------------------------------
000986r 2               EffectQPop:
000986r 2  AE rr rr       ldx EffectQHead
000989r 2  EC rr rr       cpx EffectQTail
00098Cr 2  F0 0F          beq @Empty
00098Er 2  BD rr rr       lda EffectQ,x
000991r 2  E8             inx
000992r 2  E0 30          cpx #EFFECTQ_ENTRIES
000994r 2  90 02          bcc @Store
000996r 2  A2 00          ldx #0                        ; Wrap
000998r 2               @Store:
000998r 2  8E rr rr       stx EffectQHead
00099Br 2  38             sec
00099Cr 2  60             rts
00099Dr 2               @Empty:
00099Dr 2  18             clc
00099Er 2  60             rts
00099Fr 2               
00099Fr 1               .include "../src/anim.asm"
00099Fr 2               ; =============================================================================
00099Fr 2               ;   anim.asm — Wizards Lab, the animations a clear is made of
00099Fr 2               ; =============================================================================
00099Fr 2               ;   SPEC.md section 14, and step 5 of SPEC 8. Everything here is a frame's
00099Fr 2               ;   worth of work and then a return: nothing waits, nothing loops on a timer,
00099Fr 2               ;   and the main loop never stops for any of it (D4).
00099Fr 2               ;
00099Fr 2               ;   A CLEAR STEP ANIMATES IN TWO WINDOWS, and every event SPEC 14 lists lands
00099Fr 2               ;   inside one of them:
00099Fr 2               ;
00099Fr 2               ;     PLAY_GLOW      matched cells wear glyph +6 of their own colour, the
00099Fr 2               ;                    bolt's beams lie over its row and column, and the
00099Fr 2               ;                    fireball's colour is white board-wide. GlowFrames, or the
00099Fr 2               ;                    longer FlashFrames when a fireball fired
00099Fr 2               ;     PLAY_SHATTER   the removal ring opens outward over every marked cell,
00099Fr 2               ;                    two frames a tile, with a marked prism's blip-out closing
00099Fr 2               ;                    inward beside it. SHATTER_STEPS ring frames, or the
00099Fr 2               ;                    prism's BLIP_STEPS when there is one
00099Fr 2               ;
00099Fr 2               ;   A window is as long as the LONGEST thing in it, which is the one rule that
00099Fr 2               ;   makes the durations in SPEC 14 hold without a timer per effect.
00099Fr 2               ;
00099Fr 2               ;   THE BOARD IS UNTOUCHED THE WHOLE TIME. Marked cells are not zeroed until
00099Fr 2               ;   CascadeRemove runs at the end of the shatter (SPEC 8 step 6), so every
00099Fr 2               ;   routine below can read a cell to find out what it is while drawing
00099Fr 2               ;   something else entirely over it — which is also what let P5 make an effect
00099Fr 2               ;   queue entry one byte (cascade.asm). Nothing here writes Board except the
00099Fr 2               ;   prism's idle rotation and the game-over petrify, both of which change what
00099Fr 2               ;   a cell IS and not merely what it shows.
00099Fr 2               ;
00099Fr 2               ;   THE COLOUR IS TESTED BEFORE THE GLYPH, everywhere, for the reason P5 found
00099Fr 2               ;   the hard way: a prism is glyph 0 of colour 6 and, now that it rotates, its
00099Fr 2               ;   board byte is WILD_BASE + 0..3, whose low three bits read as a bolt or a
00099Fr 2               ;   bomb. Colour 6 is the only test that stays true.
00099Fr 2               ; =============================================================================
00099Fr 2               
00099Fr 2               ANIM_GLOW           = 0         ; The four passes AnimMarked can make over the
00099Fr 2               ANIM_BEAM           = 1         ;   marked cells. AnimMode picks one; the walk
00099Fr 2               ANIM_UNBEAM         = 2         ;   itself is the same 30 bytes for all four
00099Fr 2               ANIM_SHATTER        = 3         ;   and is written once.
00099Fr 2               
00099Fr 2               ; -----------------------------------------------------------------------------
00099Fr 2               ;   AnimMarked — run one pass over every marked cell
00099Fr 2               ;   In:  A = ANIM_*      Out: nothing.  Modifies: A, X, Y, Anim*, and whatever
00099Fr 2               ;        the pass itself touches
00099Fr 2               ;
00099Fr 2               ;   The same walk as EffectEnqueueMarked (cascade.asm) and for the same reason:
00099Fr 2               ;   MARKS is the union of everything the step is taking, and a cell in a
00099Fr 2               ;   horizontal run AND a vertical one appears in it once. Marks are read only
00099Fr 2               ;   here — no pass sets one — so the bitmap cannot change underneath the walk.
00099Fr 2               ;
00099Fr 2               ;   The cursor is in memory rather than in X because everything the passes call
00099Fr 2               ;   ends at RenderMark, which clobbers A and X (D13).
00099Fr 2               ; -----------------------------------------------------------------------------
00099Fr 2               AnimMarked:
00099Fr 2  85 rr          sta AnimMode
0009A1r 2  A9 00          lda #0
0009A3r 2  85 rr          sta AnimIdx
0009A5r 2               @Row:
0009A5r 2  A5 rr          lda AnimIdx
0009A7r 2  4A             lsr a
0009A8r 2  4A             lsr a
0009A9r 2  4A             lsr a
0009AAr 2  A8             tay
0009ABr 2  B9 rr rr       lda Marks,y
0009AEr 2  F0 20          beq @NextRow                  ; Nothing marked in this row, which is most
0009B0r 2                                               ;   rows of most steps
0009B0r 2               @Cell:
0009B0r 2  A5 rr          lda AnimIdx
0009B2r 2  20 rr rr       jsr MarkTest
0009B5r 2  90 05          bcc @NextCell
0009B7r 2  A6 rr          ldx AnimIdx
0009B9r 2  20 rr rr       jsr AnimCell
0009BCr 2               @NextCell:
0009BCr 2  E6 rr          inc AnimIdx
0009BEr 2  A5 rr          lda AnimIdx
0009C0r 2  29 07          and #(BOARD_STRIDE - 1)
0009C2r 2  C9 06          cmp #BOARD_W
0009C4r 2  90 EA          bcc @Cell
0009C6r 2               
0009C6r 2  A5 rr          lda AnimIdx                   ; On the row's first sentinel column; step
0009C8r 2  18             clc                           ;   over both of them
0009C9r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
0009CBr 2  85 rr          sta AnimIdx
0009CDr 2  4C rr rr       jmp @Test
0009D0r 2               
0009D0r 2               @NextRow:
0009D0r 2  A5 rr          lda AnimIdx
0009D2r 2  18             clc
0009D3r 2  69 08          adc #BOARD_STRIDE
0009D5r 2  85 rr          sta AnimIdx
0009D7r 2               @Test:
0009D7r 2  A5 rr          lda AnimIdx
0009D9r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
0009DBr 2  90 C8          bcc @Row
0009DDr 2  60             rts
0009DEr 2               
0009DEr 2               ; -----------------------------------------------------------------------------
0009DEr 2               ;   AnimCell — one marked cell, in whichever pass is running
0009DEr 2               ;   In:  X = board index, AnimMode      Out: nothing.  Modifies: A, X, Y
0009DEr 2               ; -----------------------------------------------------------------------------
0009DEr 2               AnimCell:
0009DEr 2  A5 rr          lda AnimMode
0009E0r 2  F0 1A          beq AnimCellGlow
0009E2r 2  C9 03          cmp #ANIM_SHATTER
0009E4r 2  F0 2A          beq AnimCellShatter
0009E6r 2                 ; falls through into the two beam passes, which are the same test
0009E6r 2               
0009E6r 2               ; -----------------------------------------------------------------------------
0009E6r 2               ;   AnimCellBolt — is this cell a bolt? If so, draw or undraw its cross
0009E6r 2               ;   In:  X = board index      Out: nothing.  Modifies: A, X, Y, Anim*
0009E6r 2               ;
0009E6r 2               ;   The beams are their own pass and not a case inside the glow, because a
0009E6r 2               ;   beam goes OVER a glow: a cell in a bolt's row is very often also a matched
0009E6r 2               ;   cell, and both have to be drawn in that order.
0009E6r 2               ; -----------------------------------------------------------------------------
0009E6r 2               AnimCellBolt:
0009E6r 2  BD rr rr       lda Board,x
0009E9r 2  29 F8          and #COLOR_MASK
0009EBr 2  C9 70          cmp #WILD_BASE
0009EDr 2  F0 0C          beq @Done                     ; Colour before glyph: a rotating prism's low
0009EFr 2                                               ;   three bits say "bolt" and it is not one
0009EFr 2  BD rr rr       lda Board,x
0009F2r 2  29 07          and #GLYPH_MASK
0009F4r 2  C9 02          cmp #GLYPH_BOLT
0009F6r 2  D0 03          bne @Done
0009F8r 2  4C rr rr       jmp AnimBeam
0009FBr 2               @Done:
0009FBr 2  60             rts
0009FCr 2               
0009FCr 2               ; -----------------------------------------------------------------------------
0009FCr 2               ;   AnimCellGlow — glyph +6 of the cell's own colour (SPEC 14)
0009FCr 2               ;   In:  X = board index      Out: nothing.  Modifies: A, X, Y, AnimSteps
0009FCr 2               ;
0009FCr 2               ;   A MARKED PRISM SITS THE GLOW OUT. Group 14's slot +6 is an arrow, not a
0009FCr 2               ;   glow (SPEC A.3), so `WILD_BASE + GLYPH_GLOW` must never be constructed —
0009FCr 2               ;   the prism holds whatever rotation frame it was on and blips out later
0009FCr 2               ;   instead. Meeting one here is also how the shatter window learns it has to
0009FCr 2               ;   run BLIP_STEPS rather than SHATTER_STEPS, which saves a second walk.
0009FCr 2               ; -----------------------------------------------------------------------------
0009FCr 2               AnimCellGlow:
0009FCr 2  BD rr rr       lda Board,x
0009FFr 2  29 F8          and #COLOR_MASK
000A01r 2  C9 70          cmp #WILD_BASE
000A03r 2  F0 05          beq @Prism
000A05r 2  09 06          ora #GLYPH_GLOW               ; The colour key's low three bits are clear, so
000A07r 2  4C rr rr       jmp RenderCellAs              ;   an ORA is the whole conversion (SPEC 4.2)
000A0Ar 2               @Prism:
000A0Ar 2  A9 05          lda #BLIP_STEPS
000A0Cr 2  8D rr rr       sta AnimSteps
000A0Fr 2  60             rts
000A10r 2               
000A10r 2               ; -----------------------------------------------------------------------------
000A10r 2               ;   AnimCellShatter — the ring frame this cell is showing right now
000A10r 2               ;   In:  X = board index, AnimStep      Out: nothing.  Modifies: A, X, Y
000A10r 2               ;   SPEC 14, Appendix A.3 — one ring, opening outward for everything except a
000A10r 2               ;   prism, which runs it closed inward.
000A10r 2               ; -----------------------------------------------------------------------------
000A10r 2               AnimCellShatter:
000A10r 2  BD rr rr       lda Board,x
000A13r 2  29 F8          and #COLOR_MASK
000A15r 2  C9 70          cmp #WILD_BASE
000A17r 2  F0 0D          beq @Blip
000A19r 2  AC rr rr       ldy AnimStep
000A1Cr 2  C0 04          cpy #(SHATTER_STEPS + 1)
000A1Er 2  B0 0F          bcs @Done                     ; The ring is spent and the cell already blank.
000A20r 2  B9 rr rr       lda VfxShatter,y              ;   Only reachable while a prism holds the
000A23r 2  4C rr rr       jmp RenderCellAs              ;   window open for its last two frames
000A26r 2               @Blip:
000A26r 2  AC rr rr       ldy AnimStep
000A29r 2  B9 rr rr       lda VfxBlip,y
000A2Cr 2  4C rr rr       jmp RenderCellAs
000A2Fr 2               @Done:
000A2Fr 2  60             rts
000A30r 2               
000A30r 2               ; -----------------------------------------------------------------------------
000A30r 2               ;   AnimBeam — the bolt's beams, along its whole row and its whole column
000A30r 2               ;   In:  X = board index of the bolt; AnimIdx holds the same index, because
000A30r 2               ;        this is only ever reached from AnimMarked's cursor
000A30r 2               ;   Out: nothing.  Modifies: A, X, Y, AnimCur, AnimEnd, AnimArg
000A30r 2               ;   SPEC 14, Appendix A.3.
000A30r 2               ;
000A30r 2               ;   The beams cover EVERY cell of the row and the column, empty ones included.
000A30r 2               ;   A beam has to butt against its neighbours to read as a beam, and the cells
000A30r 2               ;   the bolt found empty were never marked — so those are also the cells the
000A30r 2               ;   ANIM_UNBEAM pass exists to put back, since nothing else would ever draw
000A30r 2               ;   them again.
000A30r 2               ;
000A30r 2               ;   The cross goes down last, over both walks, because it is the one cell that
000A30r 2               ;   belongs to each.
000A30r 2               ; -----------------------------------------------------------------------------
000A30r 2               AnimBeam:
000A30r 2  8A             txa
000A31r 2  29 07          and #(BOARD_STRIDE - 1)
000A33r 2  85 rr          sta AnimArg                   ; Its column, for the second walk
000A35r 2  8A             txa
000A36r 2  29 F8          and #(256 - BOARD_STRIDE)     ; $F8 — its row base
000A38r 2  85 rr          sta AnimCur
000A3Ar 2  18             clc
000A3Br 2  69 06          adc #BOARD_W
000A3Dr 2  85 rr          sta AnimEnd                   ; One past the row's last playfield cell
000A3Fr 2               @Row:
000A3Fr 2  A6 rr          ldx AnimCur
000A41r 2  A9 3B          lda #VFX_BEAM_H
000A43r 2  20 rr rr       jsr AnimBeamCell
000A46r 2  E6 rr          inc AnimCur
000A48r 2  A5 rr          lda AnimCur
000A4Ar 2  C5 rr          cmp AnimEnd
000A4Cr 2  90 F1          bcc @Row
000A4Er 2               
000A4Er 2  A5 rr          lda AnimArg                   ; The column, row 0 downward
000A50r 2  85 rr          sta AnimCur
000A52r 2               @Col:
000A52r 2  A6 rr          ldx AnimCur
000A54r 2  A9 3C          lda #VFX_BEAM_V
000A56r 2  20 rr rr       jsr AnimBeamCell
000A59r 2  A5 rr          lda AnimCur
000A5Br 2  18             clc
000A5Cr 2  69 08          adc #BOARD_STRIDE
000A5Er 2  85 rr          sta AnimCur
000A60r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000A62r 2  90 EE          bcc @Col
000A64r 2               
000A64r 2  A6 rr          ldx AnimIdx                   ; The bolt's own cell. The outer walk is still
000A66r 2  A9 3D          lda #VFX_BEAM_CROSS           ;   standing on it, which is cheaper than
000A68r 2                 ; falls through                ;   keeping a copy across both walks
000A68r 2               
000A68r 2               ; -----------------------------------------------------------------------------
000A68r 2               ;   AnimBeamCell — one cell of a beam, drawn or put back
000A68r 2               ;   In:  X = board index, A = beam tile      Modifies: A, X, Y
000A68r 2               ;
000A68r 2               ;   On the way back only the cells that are NOT marked need anything: the
000A68r 2               ;   marked ones are about to be drawn by the shatter, twice a frame apart, and
000A68r 2               ;   drawing them here as well would only queue two marks for one cell.
000A68r 2               ;
000A68r 2               ;   THE RESTORE IS THE ONE MARK IN THE WHOLE ANIMATION THAT CANNOT BE DROPPED.
000A68r 2               ;   Every other one is made again within a few frames — a lost glow is covered
000A68r 2               ;   by the shatter six frames later, a lost ring frame by CascadeRemove at the
000A68r 2               ;   end of it — but a beam laid over an EMPTY cell has nothing behind it that
000A68r 2               ;   anything will ever draw again, and D6's drop-on-overflow would leave a
000A68r 2               ;   white beam sitting in the well for the rest of the game. Five bolts in one
000A68r 2               ;   run put 110 beam cells through here against a 64-entry ring, so this is
000A68r 2               ;   reachable and not theoretical. It takes the same way out CascadeRemove
000A68r 2               ;   does: the whole-well redraw cursor, which repaints every one of them from
000A68r 2               ;   the board (D12).
000A68r 2               ; -----------------------------------------------------------------------------
000A68r 2               AnimBeamCell:
000A68r 2  A4 rr          ldy AnimMode
000A6Ar 2  C0 01          cpy #ANIM_BEAM
000A6Cr 2  D0 03          bne @Restore
000A6Er 2  4C rr rr       jmp RenderCellAs
000A71r 2               @Restore:
000A71r 2  8A             txa
000A72r 2  48             pha                           ; MarkTest takes the index in A and clobbers
000A73r 2  20 rr rr       jsr MarkTest                  ;   X; neither PLA nor TAX touches C
000A76r 2  68             pla
000A77r 2  AA             tax
000A78r 2  B0 0D          bcs @Done                     ; Marked — the shatter has it
000A7Ar 2  AD rr rr       lda DirtyCount
000A7Dr 2  C9 40          cmp #DIRTY_ENTRIES
000A7Fr 2  B0 03          bcs @Bulk                     ; No room, and this cell must not be lost
000A81r 2  4C rr rr       jmp RenderCell                ; Board,x — empty, in every case that gets here
000A84r 2               @Bulk:
000A84r 2  4C rr rr       jmp RenderBoard               ; Sets the cursor and nothing else; the cells
000A87r 2                                               ;   already queued still land and the redraw
000A87r 2                                               ;   goes over them with the same values
000A87r 2               @Done:
000A87r 2  60             rts
000A88r 2               
000A88r 2               ; =============================================================================
000A88r 2               ;   The two windows
000A88r 2               ; =============================================================================
000A88r 2               
000A88r 2               ; -----------------------------------------------------------------------------
000A88r 2               ;   AnimGlowBegin — SPEC 8 step 5, first half. Called with MARKS filled and
000A88r 2               ;   the effect queue drained, from CascadeEnter.
000A88r 2               ;   Out: PlayState = PLAY_GLOW.  Modifies: A, X, Y, Anim*
000A88r 2               ;
000A88r 2               ;   The fireball's flash is already lit: EffectResolve calls HalColorFlash as
000A88r 2               ;   it detonates, so TintColor arriving here as anything but TINT_NONE is how
000A88r 2               ;   this knows a fireball fired and the window has to be the longer one
000A88r 2               ;   (SPEC 14). Two fireballs of different colours in one step leave the LAST
000A88r 2               ;   one's colour flashing — one byte can only name one group, and the other's
000A88r 2               ;   cells still glow and still shatter.
000A88r 2               ; -----------------------------------------------------------------------------
000A88r 2               AnimGlowBegin:
000A88r 2  A9 03          lda #SHATTER_STEPS            ; Raised to BLIP_STEPS by AnimCellGlow if it
000A8Ar 2  8D rr rr       sta AnimSteps                 ;   meets a marked prism
000A8Dr 2  A9 00          lda #ANIM_GLOW
000A8Fr 2  20 rr rr       jsr AnimMarked
000A92r 2  A9 01          lda #ANIM_BEAM
000A94r 2  20 rr rr       jsr AnimMarked
000A97r 2               
000A97r 2  AE rr rr       ldx Region
000A9Ar 2  BD rr rr       lda GlowFrames,x
000A9Dr 2  AC rr rr       ldy TintColor
000AA0r 2  C0 01          cpy #TINT_NONE
000AA2r 2  F0 08          beq @Time
000AA4r 2  BD rr rr       lda FlashFrames,x
000AA7r 2  48             pha
000AA8r 2  20 rr rr       jsr RenderNext                ; The preview is redrawn so that a piece of the
000AABr 2  68             pla                           ;   flashing colour goes white there too. On
000AACr 2                                               ;   the AC6502 the whole group recolours and
000AACr 2                                               ;   this changes nothing; on the Commodores the
000AACr 2                                               ;   tint is per cell and this is the only way
000AACr 2                                               ;   those three cells hear about it (SPEC 4.6)
000AACr 2               @Time:
000AACr 2  8D rr rr       sta AnimTimer
000AAFr 2  A9 02          lda #PLAY_GLOW
000AB1r 2  8D rr rr       sta PlayState
000AB4r 2  60             rts
000AB5r 2               
000AB5r 2               ; -----------------------------------------------------------------------------
000AB5r 2               ;   AnimGlowEnd — take the beams and the flash down, and start the shatter
000AB5r 2               ;   Out: PlayState = PLAY_SHATTER.  Modifies: A, X, Y, Anim*
000AB5r 2               ; -----------------------------------------------------------------------------
000AB5r 2               AnimGlowEnd:
000AB5r 2  A9 02          lda #ANIM_UNBEAM
000AB7r 2  20 rr rr       jsr AnimMarked
000ABAr 2               
000ABAr 2  AD rr rr       lda TintColor
000ABDr 2  C9 01          cmp #TINT_NONE
000ABFr 2  F0 08          beq AnimShatterBegin
000AC1r 2  A9 01          lda #TINT_NONE
000AC3r 2  20 rr rr       jsr HalColorFlash             ; The flash ends with the window; every cell it
000AC6r 2  20 rr rr       jsr RenderNext                ;   covered is marked and about to be redrawn
000AC9r 2                                               ;   by the shatter, so only the preview needs
000AC9r 2                                               ;   asking for again
000AC9r 2                 ; falls through
000AC9r 2               
000AC9r 2               ; -----------------------------------------------------------------------------
000AC9r 2               ;   AnimShatterBegin — SPEC 8 step 5, second half
000AC9r 2               ;   Out: PlayState = PLAY_SHATTER.  Modifies: A, X, Y, Anim*
000AC9r 2               ;   Frame 0 of the ring goes up now rather than next frame, so the window is
000AC9r 2               ;   AnimSteps * VFX_FRAMES frames long and every tile of it holds for
000AC9r 2               ;   VFX_FRAMES, the last one included.
000AC9r 2               ; -----------------------------------------------------------------------------
000AC9r 2               AnimShatterBegin:
000AC9r 2  A9 00          lda #0
000ACBr 2  8D rr rr       sta AnimStep
000ACEr 2  A9 02          lda #VFX_FRAMES
000AD0r 2  8D rr rr       sta AnimTimer
000AD3r 2  A9 03          lda #PLAY_SHATTER
000AD5r 2  8D rr rr       sta PlayState
000AD8r 2  A9 03          lda #ANIM_SHATTER
000ADAr 2  4C rr rr       jmp AnimMarked
000ADDr 2               
000ADDr 2               ; =============================================================================
000ADDr 2               ;   The prism at rest (SPEC 7.3, 14)
000ADDr 2               ; =============================================================================
000ADDr 2               
000ADDr 2               ; -----------------------------------------------------------------------------
000ADDr 2               ;   AnimPrismTick — advance the idle rotation, one frame every PRISM_SPIN_RATE
000ADDr 2               ;   Out: nothing.  Modifies: A, X, Y, AnimIdx, AnimArg, PrismFrame, PrismTimer
000ADDr 2               ;
000ADDr 2               ;   The only tile in the game that moves when nothing is happening, and the
000ADDr 2               ;   only place other than the petrify that WRITES a tile to the board without
000ADDr 2               ;   the board having changed: a prism's cell really does hold WILD_BASE + 0..3
000ADDr 2               ;   from here on. Everything that reads a cell masks the colour first, so the
000ADDr 2               ;   glyph bits carrying a frame number rather than a zero is invisible to the
000ADDr 2               ;   scan, to gravity and to the effects — but it is exactly why P5 made
000ADDr 2               ;   EffectEnqueue test the colour before the glyph, and why the petrify below
000ADDr 2               ;   does too.
000ADDr 2               ;
000ADDr 2               ;   IT DOES NOT RUN DURING THE GLOW OR THE SHATTER. A marked prism has to hold
000ADDr 2               ;   still for the glow window and then play its blip-out, and it is cheaper to
000ADDr 2               ;   stand the whole walk down for those twelve frames than to test every cell
000ADDr 2               ;   against MARKS.
000ADDr 2               ;
000ADDr 2               ;   The walk is the 96 cells of the well every eighth frame whether a prism is
000ADDr 2               ;   on the board or not — about 150 cycles a frame amortised, against a board
000ADDr 2               ;   scan's eleven thousand. Remembering where the prisms are would cost more
000ADDr 2               ;   than it saves, and would have to be kept right through gravity.
000ADDr 2               ; -----------------------------------------------------------------------------
000ADDr 2               AnimPrismTick:
000ADDr 2  AD rr rr       lda PlayState
000AE0r 2  C9 02          cmp #PLAY_GLOW
000AE2r 2  F0 4B          beq @Done
000AE4r 2  C9 03          cmp #PLAY_SHATTER
000AE6r 2  F0 47          beq @Done
000AE8r 2  CE rr rr       dec PrismTimer
000AEBr 2  D0 42          bne @Done
000AEDr 2               
000AEDr 2  A9 08          lda #PRISM_SPIN_RATE
000AEFr 2  8D rr rr       sta PrismTimer
000AF2r 2  EE rr rr       inc PrismFrame
000AF5r 2  AD rr rr       lda PrismFrame
000AF8r 2  29 03          and #(PRISM_SPIN_FRAMES - 1)
000AFAr 2  8D rr rr       sta PrismFrame
000AFDr 2  09 70          ora #PRISM_SPIN               ; WILD_BASE + frame (SPEC A.3)
000AFFr 2  85 rr          sta AnimArg
000B01r 2               
000B01r 2  A9 00          lda #0
000B03r 2  85 rr          sta AnimIdx
000B05r 2               @Cell:
000B05r 2  A6 rr          ldx AnimIdx
000B07r 2  BD rr rr       lda Board,x
000B0Ar 2  29 F8          and #COLOR_MASK
000B0Cr 2  C9 70          cmp #WILD_BASE
000B0Er 2  D0 08          bne @Next
000B10r 2  A5 rr          lda AnimArg
000B12r 2  9D rr rr       sta Board,x
000B15r 2  20 rr rr       jsr RenderCell
000B18r 2               @Next:
000B18r 2  E6 rr          inc AnimIdx
000B1Ar 2  A5 rr          lda AnimIdx
000B1Cr 2  29 07          and #(BOARD_STRIDE - 1)
000B1Er 2  C9 06          cmp #BOARD_W
000B20r 2  90 07          bcc @Test
000B22r 2  A5 rr          lda AnimIdx                   ; Over the two sentinel columns
000B24r 2  18             clc
000B25r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000B27r 2  85 rr          sta AnimIdx
000B29r 2               @Test:
000B29r 2  A5 rr          lda AnimIdx
000B2Br 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000B2Dr 2  90 D6          bcc @Cell
000B2Fr 2               @Done:
000B2Fr 2  60             rts
000B30r 2               
000B30r 2               ; =============================================================================
000B30r 2               ;   The message band (SPEC 12.2, 14)
000B30r 2               ; =============================================================================
000B30r 2               
000B30r 2               ; -----------------------------------------------------------------------------
000B30r 2               ;   AnimBannerShow — put a banner up for BannerFrames
000B30r 2               ;   In:  Ptr1 -> string      Out: nothing.  Modifies: A, X, Y and the text
000B30r 2               ;        cursor
000B30r 2               ; -----------------------------------------------------------------------------
000B30r 2               AnimBannerShow:
000B30r 2  20 rr rr       jsr TextBanner
000B33r 2  AE rr rr       ldx Region
000B36r 2  BD rr rr       lda BannerFrames,x
000B39r 2  8D rr rr       sta BannerTimer
000B3Cr 2  60             rts
000B3Dr 2               
000B3Dr 2               ; -----------------------------------------------------------------------------
000B3Dr 2               ;   AnimBannerTick — one frame of whatever banner is up
000B3Dr 2               ;   Out: nothing.  Modifies: A, X, Y
000B3Dr 2               ;   Play never stops for a banner: it ticks alongside the sub-states, like the
000B3Dr 2               ;   high-score flash it shares its clock with (SPEC 9.8).
000B3Dr 2               ; -----------------------------------------------------------------------------
000B3Dr 2               AnimBannerTick:
000B3Dr 2  AD rr rr       lda BannerTimer
000B40r 2  F0 08          beq @Done
000B42r 2  CE rr rr       dec BannerTimer
000B45r 2  D0 03          bne @Done
000B47r 2  4C rr rr       jmp TextBannerClear
000B4Ar 2               @Done:
000B4Ar 2  60             rts
000B4Br 2               
000B4Br 2               ; -----------------------------------------------------------------------------
000B4Br 2               ;   AnimBannerLevel — "~~ LEVEL UP ~~" (SPEC 10.1, 14)
000B4Br 2               ; -----------------------------------------------------------------------------
000B4Br 2               AnimBannerLevel:
000B4Br 2  A9 rr          lda #<MsgLevelUp
000B4Dr 2  85 rr          sta Ptr1
000B4Fr 2  A9 rr          lda #>MsgLevelUp
000B51r 2  85 rr          sta Ptr1+1
000B53r 2  4C rr rr       jmp AnimBannerShow
000B56r 2               
000B56r 2               ; -----------------------------------------------------------------------------
000B56r 2               ;   AnimBannerChain — "~~ CHAIN xN ~~" (SPEC 8 SETTLE, 14)
000B56r 2               ;   In:  A = links in the cascade      Modifies: A, X, Y and the text cursor
000B56r 2               ;
000B56r 2               ;   The banner is a fixed-length string with a placeholder digit, overwritten
000B56r 2               ;   afterwards at CHAIN_DIGIT_X — which is a constant only because the string
000B56r 2               ;   is MSG_CHAIN_LEN cells long and TextBanner centres on PANEL_W
000B56r 2               ;   (constants.inc). A chain past 9 says 9 rather than drawing whatever tile
000B56r 2               ;   FONT_DIGIT_0 + 10 turns out to be.
000B56r 2               ; -----------------------------------------------------------------------------
000B56r 2               AnimBannerChain:
000B56r 2  C9 0A          cmp #(CHAIN_MAX_SHOWN + 1)
000B58r 2  90 02          bcc @Show
000B5Ar 2  A9 09          lda #CHAIN_MAX_SHOWN
000B5Cr 2               @Show:
000B5Cr 2  48             pha
000B5Dr 2  A9 rr          lda #<MsgChain
000B5Fr 2  85 rr          sta Ptr1
000B61r 2  A9 rr          lda #>MsgChain
000B63r 2  85 rr          sta Ptr1+1
000B65r 2  20 rr rr       jsr AnimBannerShow
000B68r 2  68             pla
000B69r 2  18             clc
000B6Ar 2  69 10          adc #FONT_DIGIT_0
000B6Cr 2  A2 0E          ldx #CHAIN_DIGIT_X
000B6Er 2  A0 16          ldy #MSG_Y
000B70r 2  4C rr rr       jmp RenderMark
000B73r 2               
000B73r 2               ; =============================================================================
000B73r 2               ;   Game over (SPEC 13.4)
000B73r 2               ; =============================================================================
000B73r 2               
000B73r 2               ; -----------------------------------------------------------------------------
000B73r 2               ;   AnimPetrifyBegin — start the well turning to stone from the floor up
000B73r 2               ;   Out: nothing.  Modifies: A
000B73r 2               ; -----------------------------------------------------------------------------
000B73r 2               AnimPetrifyBegin:
000B73r 2  A9 0F          lda #(BOARD_H - 1)
000B75r 2  8D rr rr       sta PetrifyRow
000B78r 2  A9 02          lda #PETRIFY_FRAMES
000B7Ar 2  8D rr rr       sta AnimTimer
000B7Dr 2  60             rts
000B7Er 2               
000B7Er 2               ; -----------------------------------------------------------------------------
000B7Er 2               ;   AnimPetrifyTick — one frame of it
000B7Er 2               ;   Out: C set while it is still running, clear once the well is stone.
000B7Er 2               ;        Modifies: A, X, Y, AnimIdx, AnimEnd, AnimTimer, PetrifyRow, Board
000B7Er 2               ;   SPEC 13.4 — a row every PETRIFY_FRAMES, bottom upward, 32 frames in all.
000B7Er 2               ;
000B7Er 2               ;   Each cell sets as ITS OWN SHAPE, because group 15 holds the petrified
000B7Er 2               ;   glyphs at the same five offsets the potions use (SPEC A.3): one AND and
000B7Er 2               ;   one ORA, and a bomb sets as a stone bomb at the exact moment the player is
000B7Er 2               ;   looking hardest at the board. Empty cells stay empty — the pile petrifies,
000B7Er 2               ;   not the well.
000B7Er 2               ;
000B7Er 2               ;   A prism has no stone twin, so it sets as the plain one. Testing the colour
000B7Er 2               ;   first is what keeps it off `PETRIFY_BASE + 3`, a stone bomb, which is what
000B7Er 2               ;   a rotating prism's glyph bits would otherwise buy (AnimPrismTick above).
000B7Er 2               ; -----------------------------------------------------------------------------
000B7Er 2               AnimPetrifyTick:
000B7Er 2  AD rr rr       lda PetrifyRow
000B81r 2  30 42          bmi @Finished                 ; $FF — the whole well is stone
000B83r 2  CE rr rr       dec AnimTimer
000B86r 2  D0 3B          bne @Running
000B88r 2               
000B88r 2  A9 02          lda #PETRIFY_FRAMES
000B8Ar 2  8D rr rr       sta AnimTimer
000B8Dr 2  AD rr rr       lda PetrifyRow
000B90r 2  0A             asl a                         ; Row base — the board's stride is 8
000B91r 2  0A             asl a
000B92r 2  0A             asl a
000B93r 2  85 rr          sta AnimIdx
000B95r 2  18             clc
000B96r 2  69 06          adc #BOARD_W
000B98r 2  85 rr          sta AnimEnd
000B9Ar 2               @Cell:
000B9Ar 2  A6 rr          ldx AnimIdx
000B9Cr 2  BD rr rr       lda Board,x
000B9Fr 2  F0 17          beq @Next                     ; Empty stays empty (SPEC 13.4)
000BA1r 2  29 F8          and #COLOR_MASK
000BA3r 2  C9 70          cmp #WILD_BASE
000BA5r 2  F0 09          beq @Prism
000BA7r 2  BD rr rr       lda Board,x
000BAAr 2  29 07          and #GLYPH_MASK
000BACr 2  09 78          ora #PETRIFY_BASE
000BAEr 2  D0 02          bne @Set                      ; Always — PETRIFY_BASE is 120
000BB0r 2               @Prism:
000BB0r 2  A9 78          lda #PETRIFY_BASE
000BB2r 2               @Set:
000BB2r 2  9D rr rr       sta Board,x
000BB5r 2  20 rr rr       jsr RenderCell
000BB8r 2               @Next:
000BB8r 2  E6 rr          inc AnimIdx
000BBAr 2  A5 rr          lda AnimIdx
000BBCr 2  C5 rr          cmp AnimEnd
000BBEr 2  90 DA          bcc @Cell
000BC0r 2  CE rr rr       dec PetrifyRow
000BC3r 2               @Running:
000BC3r 2  38             sec
000BC4r 2  60             rts
000BC5r 2               @Finished:
000BC5r 2  18             clc
000BC6r 2  60             rts
000BC7r 2               
000BC7r 1               .include "../src/score.asm"
000BC7r 2               ; =============================================================================
000BC7r 2               ;   score.asm — Wizards Lab, scoring
000BC7r 2               ; =============================================================================
000BC7r 2               ;   SPEC.md section 9. Seven digits of packed BCD in four bytes, low byte
000BC7r 2               ;   first; the top nibble of ScoreTop is held at zero. Every value in
000BC7r 2               ;   tables.inc is a multiple of ten, so scoring is a SED / ADC chain and never
000BC7r 2               ;   a multiply — the one place a tile count has to be multiplied by a table
000BC7r 2               ;   value, it is done as a loop of BCD additions, and the count is at most 21.
000BC7r 2               ;
000BC7r 2               ;   The score clamps at 9999999. It never wraps.
000BC7r 2               ;
000BC7r 2               ;   Display is always all seven digits, zero padded — see TextBcd. Nothing
000BC7r 2               ;   here strips a leading zero, and nothing downstream may either.
000BC7r 2               ;
000BC7r 2               ;   TWO WAYS IN, AND THEY ARE NOT INTERCHANGEABLE (D5):
000BC7r 2               ;
000BC7r 2               ;     CascadeAdd / CascadeAddTimes    points scored INSIDE a cascade. They go
000BC7r 2               ;                                     into Cascade{Lo,Mid,Hi} and stay there
000BC7r 2               ;                                     until CascadeSettle, because a star
000BC7r 2               ;                                     caught anywhere in the cascade doubles
000BC7r 2               ;                                     everything it scored, retroactively
000BC7r 2               ;                                     (SPEC 9.6).
000BC7r 2               ;     ScoreAward                      the awards SPEC 9.6 gives outside a
000BC7r 2               ;                                     cascade — the soft drop and the level-up
000BC7r 2               ;                                     bonus. These reach Score at once and a
000BC7r 2               ;                                     star never touches them.
000BC7r 2               ;
000BC7r 2               ;   Both funnel through ScoreBank, which is the only routine that writes
000BC7r 2               ;   Score, the only one that clamps, and the only one that can hand the high
000BC7r 2               ;   score over to the player.
000BC7r 2               ; =============================================================================
000BC7r 2               
000BC7r 2               ; -----------------------------------------------------------------------------
000BC7r 2               ;   ScoreHighInit — seed the session high score, once, at power-on
000BC7r 2               ;   SPEC 9.8 — the high score is not persisted; it starts at 0010000 on every
000BC7r 2               ;   power-on, which is the target the first game is played against. It then
000BC7r 2               ;   survives every game in the session, so this is deliberately NOT part of
000BC7r 2               ;   ScoreReset. Nothing may infer "cold boot" from the value being zero: BSS
000BC7r 2               ;   is not cleared on all three machines.
000BC7r 2               ;   Out: nothing.  Modifies: A
000BC7r 2               ; -----------------------------------------------------------------------------
000BC7r 2               ScoreHighInit:
000BC7r 2  A9 00          lda #HIGH_INIT_LO
000BC9r 2  8D rr rr       sta HighLo
000BCCr 2  A9 00          lda #HIGH_INIT_MID
000BCEr 2  8D rr rr       sta HighMid
000BD1r 2  A9 01          lda #HIGH_INIT_HI
000BD3r 2  8D rr rr       sta HighHi
000BD6r 2  A9 00          lda #HIGH_INIT_TOP
000BD8r 2  8D rr rr       sta HighTop
000BDBr 2  A9 01          lda #$01                      ; BCD — the level the target was "set" on
000BDDr 2  8D rr rr       sta HighLevel
000BE0r 2  60             rts
000BE1r 2               
000BE1r 2               ; -----------------------------------------------------------------------------
000BE1r 2               ;   ScoreReset — zero the score for a new game
000BE1r 2               ;   Out: nothing.  Modifies: A
000BE1r 2               ;
000BE1r 2               ;   The high score itself is NOT reset (SPEC 9.8) — but the two flags that say
000BE1r 2               ;   what this game has done about it are, or the second game of a session
000BE1r 2               ;   would never flash.
000BE1r 2               ; -----------------------------------------------------------------------------
000BE1r 2               ScoreReset:
000BE1r 2  A9 00          lda #0
000BE3r 2  8D rr rr       sta ScoreLo
000BE6r 2  8D rr rr       sta ScoreMid
000BE9r 2  8D rr rr       sta ScoreHi
000BECr 2  8D rr rr       sta ScoreTop
000BEFr 2  8D rr rr       sta CascadeLo
000BF2r 2  8D rr rr       sta CascadeMid
000BF5r 2  8D rr rr       sta CascadeHi
000BF8r 2  8D rr rr       sta StarCount
000BFBr 2  8D rr rr       sta HighOwned
000BFEr 2  8D rr rr       sta HighFlash
000C01r 2  8D rr rr       sta HighTimer
000C04r 2  60             rts
000C05r 2               
000C05r 2               ; -----------------------------------------------------------------------------
000C05r 2               ;   CascadeAdd — add a 16-bit BCD value to the cascade accumulator
000C05r 2               ;   In:  A = low BCD byte, X = high BCD byte
000C05r 2               ;   Out: nothing.  Modifies: A, flags.  PRESERVES X and Y.
000C05r 2               ;
000C05r 2               ;   Preserving X and Y is what lets CascadeAddTimes loop over this without
000C05r 2               ;   spilling anything, and Tmp0-Tmp3 may not be held across a JSR anyway
000C05r 2               ;   (zeropage.inc).
000C05r 2               ; -----------------------------------------------------------------------------
000C05r 2               CascadeAdd:
000C05r 2  F8             sed
000C06r 2  18             clc
000C07r 2  6D rr rr       adc CascadeLo
000C0Ar 2  8D rr rr       sta CascadeLo
000C0Dr 2  8A             txa
000C0Er 2  6D rr rr       adc CascadeMid
000C11r 2  8D rr rr       sta CascadeMid
000C14r 2  AD rr rr       lda CascadeHi
000C17r 2  69 00          adc #0
000C19r 2  8D rr rr       sta CascadeHi
000C1Cr 2  D8             cld                           ; CLD leaves the carry alone
000C1Dr 2  B0 01          bcs CascadeClamp
000C1Fr 2  60             rts
000C20r 2               
000C20r 2               ; -----------------------------------------------------------------------------
000C20r 2               ;   CascadeClamp — six nines, when an accumulate would have wrapped
000C20r 2               ;   Out: nothing.  Modifies: A.  PRESERVES X and Y.
000C20r 2               ;
000C20r 2               ;   Not reachable by playing: nothing is ever ADDED to the board during a
000C20r 2               ;   cascade, so one cascade can never remove more than the 96 cells the well
000C20r 2               ;   holds, and 96 cells at the dearest tile value there is (650, SPEC 9.2)
000C20r 2               ;   plus every bonus in section 9 comes to a little over 200,000 — a fifth of
000C20r 2               ;   what three bytes hold, and an eighth of what it would take to wrap after
000C20r 2               ;   the star cap has doubled it three times. It is here because "never wraps"
000C20r 2               ;   in SPEC 9 has to be true of every accumulator on the path, not just of the
000C20r 2               ;   one the player can see.
000C20r 2               ; -----------------------------------------------------------------------------
000C20r 2               CascadeClamp:
000C20r 2  A9 99          lda #$99
000C22r 2  8D rr rr       sta CascadeLo
000C25r 2  8D rr rr       sta CascadeMid
000C28r 2  8D rr rr       sta CascadeHi
000C2Br 2  60             rts
000C2Cr 2               
000C2Cr 2               ; -----------------------------------------------------------------------------
000C2Cr 2               ;   CascadeAddTimes — add a value N times (the tiles-cleared multiply)
000C2Cr 2               ;   In:  A = low BCD, X = high BCD, Y = count
000C2Cr 2               ;   Out: nothing.  Modifies: A, Y, flags.  PRESERVES X.
000C2Cr 2               ;
000C2Cr 2               ;   SPEC 9 chose values that are all multiples of ten so that scoring is an
000C2Cr 2               ;   ADC chain, but `length * TileValue[chain]` is still a multiply. The count
000C2Cr 2               ;   is a run length — three to sixteen — so a loop of BCD additions is both
000C2Cr 2               ;   smaller and, at these counts, faster than any multiply routine worth
000C2Cr 2               ;   writing.
000C2Cr 2               ; -----------------------------------------------------------------------------
000C2Cr 2               CascadeAddTimes:
000C2Cr 2  48             pha                           ; The low byte rides the stack, because
000C2Dr 2               @Loop:                          ;   CascadeAdd returns in A
000C2Dr 2  C0 00          cpy #0
000C2Fr 2  F0 08          beq @Done
000C31r 2  68             pla
000C32r 2  48             pha
000C33r 2  20 rr rr       jsr CascadeAdd
000C36r 2  88             dey
000C37r 2  D0 F4          bne @Loop
000C39r 2               @Done:
000C39r 2  68             pla
000C3Ar 2  60             rts
000C3Br 2               
000C3Br 2               ; -----------------------------------------------------------------------------
000C3Br 2               ;   CascadeDouble — one BCD doubling of the cascade accumulator
000C3Br 2               ;   Out: nothing.  Modifies: A, flags.  PRESERVES X and Y.
000C3Br 2               ;   A doubling in BCD is a self-addition; three of them is the star cap.
000C3Br 2               ; -----------------------------------------------------------------------------
000C3Br 2               CascadeDouble:
000C3Br 2  F8             sed
000C3Cr 2  18             clc
000C3Dr 2  AD rr rr       lda CascadeLo
000C40r 2  6D rr rr       adc CascadeLo
000C43r 2  8D rr rr       sta CascadeLo
000C46r 2  AD rr rr       lda CascadeMid
000C49r 2  6D rr rr       adc CascadeMid
000C4Cr 2  8D rr rr       sta CascadeMid
000C4Fr 2  AD rr rr       lda CascadeHi
000C52r 2  6D rr rr       adc CascadeHi
000C55r 2  8D rr rr       sta CascadeHi
000C58r 2  D8             cld
000C59r 2  B0 C5          bcs CascadeClamp
000C5Br 2  60             rts
000C5Cr 2               
000C5Cr 2               ; -----------------------------------------------------------------------------
000C5Cr 2               ;   ScoreAdd — bank the cascade accumulator into Score, clamped
000C5Cr 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
000C5Cr 2               ;   SPEC 9.8 — the high score updates live, so the player watches the overtake.
000C5Cr 2               ; -----------------------------------------------------------------------------
000C5Cr 2               ScoreAdd:
000C5Cr 2  AD rr rr       lda CascadeLo
000C5Fr 2  85 rr          sta Tmp0
000C61r 2  AD rr rr       lda CascadeMid
000C64r 2  85 rr          sta Tmp1
000C66r 2  AD rr rr       lda CascadeHi
000C69r 2  85 rr          sta Tmp2
000C6Br 2  4C rr rr       jmp ScoreBank
000C6Er 2               
000C6Er 2               ; -----------------------------------------------------------------------------
000C6Er 2               ;   ScoreAward — add a 16-bit BCD value straight to Score
000C6Er 2               ;   In:  A = low BCD byte, X = high BCD byte
000C6Er 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
000C6Er 2               ;
000C6Er 2               ;   The two awards SPEC 9.6 gives outside a cascade: one point a row for a
000C6Er 2               ;   soft drop, and BONUS_LEVELUP when the level advances. Neither is a cascade
000C6Er 2               ;   point and neither is doubled by a star, which is the whole reason they do
000C6Er 2               ;   not go through CascadeAdd.
000C6Er 2               ; -----------------------------------------------------------------------------
000C6Er 2               ScoreAward:
000C6Er 2  85 rr          sta Tmp0
000C70r 2  86 rr          stx Tmp1
000C72r 2  A9 00          lda #0
000C74r 2  85 rr          sta Tmp2
000C76r 2                 ; falls through into ScoreBank
000C76r 2               
000C76r 2               ; -----------------------------------------------------------------------------
000C76r 2               ;   ScoreBank — Score += the three BCD bytes in Tmp0-Tmp2, clamped at 9999999
000C76r 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
000C76r 2               ;
000C76r 2               ;   The only writer of Score. It redraws the field itself, because there is no
000C76r 2               ;   other moment at which the score is known to have changed (SPEC 12.6 —
000C76r 2               ;   nothing polls).
000C76r 2               ; -----------------------------------------------------------------------------
000C76r 2               ScoreBank:
000C76r 2  F8             sed
000C77r 2  18             clc
000C78r 2  AD rr rr       lda ScoreLo
000C7Br 2  65 rr          adc Tmp0
000C7Dr 2  8D rr rr       sta ScoreLo
000C80r 2  AD rr rr       lda ScoreMid
000C83r 2  65 rr          adc Tmp1
000C85r 2  8D rr rr       sta ScoreMid
000C88r 2  AD rr rr       lda ScoreHi
000C8Br 2  65 rr          adc Tmp2
000C8Dr 2  8D rr rr       sta ScoreHi
000C90r 2  AD rr rr       lda ScoreTop
000C93r 2  69 00          adc #0
000C95r 2  8D rr rr       sta ScoreTop
000C98r 2  D8             cld                           ; CLD leaves the carry alone
000C99r 2  B0 07          bcs @Clamp
000C9Br 2  AD rr rr       lda ScoreTop                  ; The eighth digit is held at zero (SPEC 9),
000C9Er 2  C9 10          cmp #$10                      ;   so anything that reached it has overflowed
000CA0r 2  90 10          bcc @Drawn                    ;   the seven the panel shows
000CA2r 2               @Clamp:
000CA2r 2  A9 99          lda #$99
000CA4r 2  8D rr rr       sta ScoreLo
000CA7r 2  8D rr rr       sta ScoreMid
000CAAr 2  8D rr rr       sta ScoreHi
000CADr 2  A9 09          lda #$09
000CAFr 2  8D rr rr       sta ScoreTop
000CB2r 2               @Drawn:
000CB2r 2  20 rr rr       jsr RenderScore
000CB5r 2                 ; falls through into ScoreHighCheck
000CB5r 2               
000CB5r 2               ; -----------------------------------------------------------------------------
000CB5r 2               ;   ScoreHighCheck — hand the high score over the moment the score reaches it
000CB5r 2               ;   Out: C set if the score is level with or past the high score — which, once
000CB5r 2               ;        it has been taken, is EVERY call. The one-shot is HighOwned below, not
000CB5r 2               ;        this flag; nothing currently reads it.  Modifies: A, X, Y, Tmp0
000CB5r 2               ;
000CB5r 2               ;   SPEC 9.8. The copy happens on every call once the score is level with the
000CB5r 2               ;   high score, not just on the first — that is what keeps HighLevel tracking
000CB5r 2               ;   the live level while a run is holding its own record, which is the point of
000CB5r 2               ;   the number: it says how deep you have to get to beat it.
000CB5r 2               ;
000CB5r 2               ;   The fanfare and the flash are the one-shot half, and HighOwned is what
000CB5r 2               ;   makes them one: without it every subsequent bank would fire them again,
000CB5r 2               ;   because from the overtake onward the score and the high score are equal.
000CB5r 2               ; -----------------------------------------------------------------------------
000CB5r 2               ScoreHighCheck:
000CB5r 2  AD rr rr       lda HighTop                   ; Four-byte compare, most significant first
000CB8r 2  CD rr rr       cmp ScoreTop
000CBBr 2  D0 16          bne @Test
000CBDr 2  AD rr rr       lda HighHi
000CC0r 2  CD rr rr       cmp ScoreHi
000CC3r 2  D0 0E          bne @Test
000CC5r 2  AD rr rr       lda HighMid
000CC8r 2  CD rr rr       cmp ScoreMid
000CCBr 2  D0 06          bne @Test
000CCDr 2  AD rr rr       lda HighLo
000CD0r 2  CD rr rr       cmp ScoreLo
000CD3r 2               @Test:
000CD3r 2  90 02          bcc @Take                     ; high < score
000CD5r 2  D0 3E          bne @Behind                   ; high > score — nothing to do
000CD7r 2                                               ; equal: still copy, so HighLevel tracks
000CD7r 2               @Take:
000CD7r 2  AD rr rr       lda ScoreLo
000CDAr 2  8D rr rr       sta HighLo
000CDDr 2  AD rr rr       lda ScoreMid
000CE0r 2  8D rr rr       sta HighMid
000CE3r 2  AD rr rr       lda ScoreHi
000CE6r 2  8D rr rr       sta HighHi
000CE9r 2  AD rr rr       lda ScoreTop
000CECr 2  8D rr rr       sta HighTop
000CEFr 2  20 rr rr       jsr ScoreLevelBcd             ; The level box under the digits is BCD; Level
000CF2r 2  8D rr rr       sta HighLevel                 ;   itself is binary (SPEC 12.2)
000CF5r 2  20 rr rr       jsr RenderHigh
000CF8r 2               
000CF8r 2  AD rr rr       lda HighOwned
000CFBr 2  D0 16          bne @Owned
000CFDr 2  EE rr rr       inc HighOwned
000D00r 2  A9 0B          lda #SFX_HIGHSCORE            ; SPEC 9.8 — a longer fanfare, once
000D02r 2  8D rr rr       sta SfxRequest
000D05r 2  A9 06          lda #HIGH_FLASH_BLINKS
000D07r 2  8D rr rr       sta HighFlash
000D0Ar 2  AE rr rr       ldx Region
000D0Dr 2  BD rr rr       lda BlinkHalf,x
000D10r 2  8D rr rr       sta HighTimer
000D13r 2               @Owned:
000D13r 2  38             sec
000D14r 2  60             rts
000D15r 2               
000D15r 2               @Behind:
000D15r 2  18             clc
000D16r 2  60             rts
000D17r 2               
000D17r 2               ; -----------------------------------------------------------------------------
000D17r 2               ;   ScoreLevelBcd — Level (binary 1-99) as one packed BCD byte
000D17r 2               ;   Out: A = the level in BCD.  Modifies: A, X, Tmp0
000D17r 2               ; -----------------------------------------------------------------------------
000D17r 2               ScoreLevelBcd:
000D17r 2  AD rr rr       lda Level
000D1Ar 2  A2 00          ldx #0
000D1Cr 2               @Tens:
000D1Cr 2  C9 0A          cmp #10
000D1Er 2  90 05          bcc @Split
000D20r 2  E9 0A          sbc #10                       ; Carry is set by the CMP that got us here
000D22r 2  E8             inx
000D23r 2  D0 F7          bne @Tens                     ; Always — X tops out at 9
000D25r 2               @Split:
000D25r 2  85 rr          sta Tmp0                      ; Units
000D27r 2  8A             txa
000D28r 2  0A             asl a
000D29r 2  0A             asl a
000D2Ar 2  0A             asl a
000D2Br 2  0A             asl a
000D2Cr 2  05 rr          ora Tmp0
000D2Er 2  60             rts
000D2Fr 2               
000D2Fr 2               ; -----------------------------------------------------------------------------
000D2Fr 2               ;   ScoreSoftDrop — one point for one row descended under soft drop (SPEC 9.6)
000D2Fr 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0-Tmp2
000D2Fr 2               ;
000D2Fr 2               ;   The one award in the game that is not a multiple of ten. BCD does not care.
000D2Fr 2               ; -----------------------------------------------------------------------------
000D2Fr 2               ScoreSoftDrop:
000D2Fr 2  A9 01          lda #$01
000D31r 2  A2 00          ldx #$00
000D33r 2  4C rr rr       jmp ScoreAward
000D36r 2               
000D36r 2               ; -----------------------------------------------------------------------------
000D36r 2               ;   ScoreLevelCheck — advance the level when 30 tiles have gone
000D36r 2               ;   In:  A = tiles removed this step
000D36r 2               ;   Out: C set if the level advanced.  Modifies: A, X, Y, Tmp0-Tmp2
000D36r 2               ;   SPEC 10.1 — at most one advance per step, surplus carries over, so a big
000D36r 2               ;   fireball chain can never skip a level. Match and effect removals both
000D36r 2               ;   count, which is why the count comes from CascadeRemove and not from the
000D36r 2               ;   scan: by then the two are the same cells.
000D36r 2               ; -----------------------------------------------------------------------------
000D36r 2               ScoreLevelCheck:
000D36r 2  18             clc
000D37r 2  6D rr rr       adc TilesCleared
000D3Ar 2  8D rr rr       sta TilesCleared              ; A whole step can clear far more than thirty;
000D3Dr 2  C9 1E          cmp #LEVEL_TILES              ;   the surplus stays here and buys the next
000D3Fr 2  90 23          bcc @No                       ;   level on the next step
000D41r 2  E9 1E          sbc #LEVEL_TILES              ; Carry is set by the CMP that got us here
000D43r 2  8D rr rr       sta TilesCleared
000D46r 2               
000D46r 2  AD rr rr       lda Level
000D49r 2  C9 63          cmp #LEVEL_MAX_SHOWN
000D4Br 2  B0 17          bcs @No                       ; The box is two digits wide (SPEC 10.1), and
000D4Dr 2  EE rr rr       inc Level                     ;   nothing about level 100 is reachable in a
000D50r 2  20 rr rr       jsr RenderLevel               ;   session anyway
000D53r 2  20 rr rr       jsr AnimBannerLevel           ; SPEC 14 — and play carries straight on; the
000D56r 2                                               ;   band clears itself BannerFrames later
000D56r 2  A9 0A          lda #SFX_LEVELUP
000D58r 2  8D rr rr       sta SfxRequest
000D5Br 2  A9 00          lda #<BONUS_LEVELUP           ; SPEC 9.6 — an award, not a cascade point, so
000D5Dr 2  A2 10          ldx #>BONUS_LEVELUP           ;   a star in the same cascade does not double
000D5Fr 2  20 rr rr       jsr ScoreAward                ;   it (D5)
000D62r 2  38             sec
000D63r 2  60             rts
000D64r 2               @No:
000D64r 2  18             clc
000D65r 2  60             rts
000D66r 2               
000D66r 2               ; -----------------------------------------------------------------------------
000D66r 2               ;   ScoreFlashTick — one frame of the HIGH field's overtake flash
000D66r 2               ;   Out: nothing.  Modifies: A, X, Y
000D66r 2               ;   SPEC 9.8, SPEC 14 — the blink period is 30 frames NTSC / 25 PAL, shared
000D66r 2               ;   with the title screen's prompt, so HighFlash counts HALF blinks and
000D66r 2               ;   HighTimer counts the frames of one.
000D66r 2               ;
000D66r 2               ;   HighFlash is odd on the dark half and even on the lit one, and it ends at
000D66r 2               ;   zero, so the field is always left readable however the count is set.
000D66r 2               ; -----------------------------------------------------------------------------
000D66r 2               ScoreFlashTick:
000D66r 2  AD rr rr       lda HighFlash
000D69r 2  F0 1F          beq @Done
000D6Br 2  CE rr rr       dec HighTimer
000D6Er 2  D0 1A          bne @Done
000D70r 2  CE rr rr       dec HighFlash
000D73r 2  F0 12          beq @Show                     ; Out of blinks — end lit
000D75r 2  AE rr rr       ldx Region
000D78r 2  BD rr rr       lda BlinkHalf,x
000D7Br 2  8D rr rr       sta HighTimer
000D7Er 2  AD rr rr       lda HighFlash
000D81r 2  4A             lsr a
000D82r 2  90 03          bcc @Show
000D84r 2  4C rr rr       jmp RenderHighBlank
000D87r 2               @Show:
000D87r 2  4C rr rr       jmp RenderHigh
000D8Ar 2               @Done:
000D8Ar 2  60             rts
000D8Br 2               
000D8Br 2               ; -----------------------------------------------------------------------------
000D8Br 2               ;   ScoreGravity — frames per row for the current level
000D8Br 2               ;   Out: A = frame count, from SpeedNTSC or SpeedPAL per Region.
000D8Br 2               ;        Modifies: A, X
000D8Br 2               ;   SPEC 10.2. Strictly this module is P4's, but the falling piece cannot fall
000D8Br 2               ;   without it, so it is real ahead of the rest of the file — the same reason
000D8Br 2               ;   ScoreHighInit landed here in P1.
000D8Br 2               ; -----------------------------------------------------------------------------
000D8Br 2               ScoreGravity:
000D8Br 2  AE rr rr       ldx Level
000D8Er 2  CA             dex                           ; The table is indexed by level - 1 ...
000D8Fr 2  E0 10          cpx #LEVEL_SPEED_CAP
000D91r 2  90 02          bcc @Level
000D93r 2  A2 0F          ldx #LEVEL_SPEED_CAP - 1      ;   ... and stops improving at the cap
000D95r 2               @Level:
000D95r 2  AD rr rr       lda Region
000D98r 2  D0 04          bne @Pal
000D9Ar 2  BD rr rr       lda SpeedNTSC,x
000D9Dr 2  60             rts
000D9Er 2               @Pal:
000D9Er 2  BD rr rr       lda SpeedPAL,x
000DA1r 2  60             rts
000DA2r 2               
000DA2r 1               .include "../src/render.asm"
000DA2r 2               ; =============================================================================
000DA2r 2               ;   render.asm — Wizards Lab, the dirty-cell renderer
000DA2r 2               ; =============================================================================
000DA2r 2               ;   SPEC.md section 12.6. The screen is never fully redrawn during play.
000DA2r 2               ;   Changed cells are appended to a ring and flushed once a frame, at most
000DA2r 2               ;   DIRTY_FLUSH_MAX per frame with the remainder carried over.
000DA2r 2               ;
000DA2r 2               ;   The cap is NOT a hardware write-spacing limit. S1 measured this loop at
000DA2r 2               ;   165 cycles a cell on the AC6502, which puts two VRAM data writes 165 us
000DA2r 2               ;   apart at 1 MHz and the closest two VDP PORT accesses 8 cycles apart —
000DA2r 2               ;   inside even a real TMS9918A's 8 us and 2 us windows with two orders of
000DA2r 2               ;   magnitude to spare, and further inside a pico9918's, which emulates VRAM
000DA2r 2               ;   in RP2040 memory and has no display contention at all. A 6502 at this
000DA2r 2               ;   clock cannot write a TMS9918 too fast however hard it tries.
000DA2r 2               ;
000DA2r 2               ;   The cap is a TIME BUDGET: DIRTY_FLUSH_MAX cells is what fits in vertical
000DA2r 2               ;   blank on the tightest of the three. See constants.inc and PLAN.md S1.
000DA2r 2               ;
000DA2r 2               ;   All screen access goes through HalPlotCell (see hal.inc). Nothing in this
000DA2r 2               ;   file knows where screen memory is.
000DA2r 2               ; =============================================================================
000DA2r 2               
000DA2r 2               ; -----------------------------------------------------------------------------
000DA2r 2               ;   RenderDirtyReset — empty the ring and cancel any outstanding board redraw
000DA2r 2               ;   Call this after anything that draws the whole screen behind the renderer's
000DA2r 2               ;   back (HalBlitScreen), because every queued cell then describes a screen
000DA2r 2               ;   that no longer exists.
000DA2r 2               ;   In:  nothing        Out: nothing.  Modifies: A
000DA2r 2               ; -----------------------------------------------------------------------------
000DA2r 2               RenderDirtyReset:
000DA2r 2  A9 00          lda #0
000DA4r 2  8D rr rr       sta DirtyCount
000DA7r 2  8D rr rr       sta DirtyHead
000DAAr 2  8D rr rr       sta DirtyTail
000DADr 2  A9 FF          lda #$FF
000DAFr 2  8D rr rr       sta RedrawIdx
000DB2r 2  60             rts
000DB3r 2               
000DB3r 2               ; -----------------------------------------------------------------------------
000DB3r 2               ;   RenderMark — queue one panel cell
000DB3r 2               ;   In:  A = tile, X = panel column, Y = panel row
000DB3r 2               ;   Out: nothing.  Modifies: A, X.  PRESERVES Y and every byte of zero page.
000DB3r 2               ;
000DB3r 2               ;   The PANEL_X / PANEL_Y offset is applied here, once, so nothing upstream
000DB3r 2               ;   has to know which machine it is running on.
000DB3r 2               ;
000DB3r 2               ;   Preserving Y and zero page is a contract, not an accident: text.asm holds
000DB3r 2               ;   its string cursor across this call (see zeropage.inc). The three values
000DB3r 2               ;   ride the stack rather than scratch bytes because A, X and Y are all live
000DB3r 2               ;   at once and there is no fourth register to index the ring with.
000DB3r 2               ;
000DB3r 2               ;   A mark that arrives with the ring full is DROPPED, silently (D6).
000DB3r 2               ; -----------------------------------------------------------------------------
000DB3r 2               RenderMark:
000DB3r 2  48             pha                           ; Tile
000DB4r 2  98             tya
000DB5r 2  18             clc
000DB6r 2  69 00          adc #PANEL_Y                  ; Panel row -> screen row
000DB8r 2  48             pha
000DB9r 2  8A             txa
000DBAr 2  18             clc
000DBBr 2  69 05          adc #PANEL_X                  ; Panel column -> screen column
000DBDr 2  48             pha
000DBEr 2               
000DBEr 2  AD rr rr       lda DirtyCount
000DC1r 2  C9 40          cmp #DIRTY_ENTRIES
000DC3r 2  B0 1F          bcs @Full
000DC5r 2  EE rr rr       inc DirtyCount
000DC8r 2               
000DC8r 2  AE rr rr       ldx DirtyTail
000DCBr 2  68             pla
000DCCr 2  9D rr rr       sta Dirty+0,x                 ; Screen column
000DCFr 2  68             pla
000DD0r 2  9D rr rr       sta Dirty+1,x                 ; Screen row
000DD3r 2  68             pla
000DD4r 2  9D rr rr       sta Dirty+2,x                 ; Tile
000DD7r 2               
000DD7r 2  E8             inx                           ; Step one entry, wrapping the ring
000DD8r 2  E8             inx
000DD9r 2  E8             inx
000DDAr 2  E0 C0          cpx #DIRTY_BYTES
000DDCr 2  90 02          bcc @Store
000DDEr 2  A2 00          ldx #0
000DE0r 2               @Store:
000DE0r 2  8E rr rr       stx DirtyTail
000DE3r 2  60             rts
000DE4r 2               
000DE4r 2               @Full:
000DE4r 2  68             pla                           ; Unwind and drop it. The cell is wrong until
000DE5r 2  68             pla                           ;   something marks it again.
000DE6r 2  68             pla
000DE7r 2  60             rts
000DE8r 2               
000DE8r 2               ; -----------------------------------------------------------------------------
000DE8r 2               ;   RenderFlush — push up to DIRTY_FLUSH_MAX queued cells to the screen
000DE8r 2               ;   Called once per frame, from the top of the main loop.
000DE8r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
000DE8r 2               ; -----------------------------------------------------------------------------
000DE8r 2               RenderFlush:
000DE8r 2  20 rr rr       jsr RenderBoardStep           ; Top the ring up from a board redraw, if one
000DEBr 2                                               ;   is outstanding, so it always makes progress
000DEBr 2  AD rr rr       lda DirtyCount
000DEEr 2  F0 31          beq @Done
000DF0r 2  C9 18          cmp #DIRTY_FLUSH_MAX
000DF2r 2  90 02          bcc @Budget
000DF4r 2  A9 18          lda #DIRTY_FLUSH_MAX
000DF6r 2               @Budget:
000DF6r 2  85 rr          sta FlushLeft
000DF8r 2               
000DF8r 2               @Cell:
000DF8r 2  AE rr rr       ldx DirtyHead
000DFBr 2  BD rr rr       lda Dirty+1,x
000DFEr 2  A8             tay                           ; Y = screen row
000DFFr 2  BD rr rr       lda Dirty+2,x
000E02r 2  48             pha                           ; Tile
000E03r 2  BD rr rr       lda Dirty+0,x
000E06r 2  AA             tax                           ; X = screen column
000E07r 2  68             pla                           ; A = tile
000E08r 2  20 rr rr       jsr HalPlotCell
000E0Br 2               
000E0Br 2  AD rr rr       lda DirtyHead                 ; Step one entry, wrapping the ring
000E0Er 2  18             clc
000E0Fr 2  69 03          adc #3
000E11r 2  C9 C0          cmp #DIRTY_BYTES
000E13r 2  90 02          bcc @Store
000E15r 2  A9 00          lda #0
000E17r 2               @Store:
000E17r 2  8D rr rr       sta DirtyHead
000E1Ar 2  CE rr rr       dec DirtyCount
000E1Dr 2  C6 rr          dec FlushLeft
000E1Fr 2  D0 D7          bne @Cell
000E21r 2               @Done:
000E21r 2  60             rts
000E22r 2               
000E22r 2               ; -----------------------------------------------------------------------------
000E22r 2               ;   RenderBoard — ask for the whole 6 x 16 well to be redrawn
000E22r 2               ;   Used on state entry and after a pause, not per frame.
000E22r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000E22r 2               ;
000E22r 2               ;   The well is 96 cells and the ring holds DIRTY_ENTRIES; a redraw therefore
000E22r 2               ;   cannot be queued in one go. This only sets the cursor. RenderBoardStep,
000E22r 2               ;   which RenderFlush calls every frame, feeds the ring as fast as it drains,
000E22r 2               ;   so the redraw spreads over as many frames as it needs and never drops a
000E22r 2               ;   cell.
000E22r 2               ; -----------------------------------------------------------------------------
000E22r 2               RenderBoard:
000E22r 2  A9 00          lda #0
000E24r 2  8D rr rr       sta RedrawIdx                 ; Board index 0 = row 0, column 0
000E27r 2  60             rts                           ; And nothing else. Falling through into the
000E28r 2                                               ;   step below would fill the ring here and
000E28r 2                                               ;   drop whatever the caller marks next.
000E28r 2               
000E28r 2               ; -----------------------------------------------------------------------------
000E28r 2               ;   RenderBoardStep — queue as much of an outstanding board redraw as fits
000E28r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000E28r 2               ;   Does nothing when RedrawIdx is $FF.
000E28r 2               ; -----------------------------------------------------------------------------
000E28r 2               RenderBoardStep:
000E28r 2  AD rr rr       lda RedrawIdx
000E2Br 2  30 41          bmi @Done                     ; $FF — nothing outstanding
000E2Dr 2               
000E2Dr 2               @Cell:
000E2Dr 2  AD rr rr       lda DirtyCount
000E30r 2  C9 40          cmp #DIRTY_ENTRIES
000E32r 2  B0 3A          bcs @Done                     ; Ring full — pick this cell up next frame
000E34r 2               
000E34r 2  AE rr rr       ldx RedrawIdx
000E37r 2  8A             txa
000E38r 2  29 07          and #(BOARD_STRIDE - 1)
000E3Ar 2  18             clc
000E3Br 2  69 01          adc #WELL_ORIGIN_X
000E3Dr 2  85 rr          sta RedrawCol
000E3Fr 2  8A             txa
000E40r 2  4A             lsr a                         ; Board index >> 3 is the row (stride 8)
000E41r 2  4A             lsr a
000E42r 2  4A             lsr a
000E43r 2  18             clc
000E44r 2  69 04          adc #WELL_ORIGIN_Y
000E46r 2  A8             tay                           ; Y = panel row
000E47r 2  BD rr rr       lda Board,x                   ; The board byte IS the tile — empty is $00,
000E4Ar 2  A6 rr          ldx RedrawCol                 ;   which is TILE_BLANK (SPEC 3.3, 4.2)
000E4Cr 2  20 rr rr       jsr RenderMark
000E4Fr 2               
000E4Fr 2  AE rr rr       ldx RedrawIdx                 ; Advance, stepping over the two sentinel
000E52r 2  E8             inx                           ;   columns at the end of each row
000E53r 2  8A             txa
000E54r 2  29 07          and #(BOARD_STRIDE - 1)
000E56r 2  C9 06          cmp #BOARD_W
000E58r 2  90 05          bcc @Save
000E5Ar 2  8A             txa
000E5Br 2  18             clc
000E5Cr 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000E5Er 2  AA             tax
000E5Fr 2               @Save:
000E5Fr 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
000E61r 2  B0 06          bcs @Finish
000E63r 2  8E rr rr       stx RedrawIdx
000E66r 2  4C rr rr       jmp @Cell
000E69r 2               
000E69r 2               @Finish:
000E69r 2  A9 FF          lda #$FF
000E6Br 2  8D rr rr       sta RedrawIdx
000E6Er 2               @Done:
000E6Er 2  60             rts
000E6Fr 2               
000E6Fr 2               ; -----------------------------------------------------------------------------
000E6Fr 2               ;   RenderCell — queue one board cell by board index
000E6Fr 2               ;   In:  X = board index (row * BOARD_STRIDE + column)
000E6Fr 2               ;   Out: nothing.  Modifies: A, X, Y
000E6Fr 2               ;   The single-cell form of RenderBoardStep, for the phases that move one tile
000E6Fr 2               ;   at a time.
000E6Fr 2               ; -----------------------------------------------------------------------------
000E6Fr 2               RenderCell:
000E6Fr 2  BD rr rr       lda Board,x                   ; The board byte IS the tile (SPEC 3.3)
000E72r 2                 ; falls through
000E72r 2               
000E72r 2               ; -----------------------------------------------------------------------------
000E72r 2               ;   RenderCellAs — queue one board cell showing something else entirely
000E72r 2               ;   In:  X = board index, A = tile
000E72r 2               ;   Out: nothing.  Modifies: A, X, Y
000E72r 2               ;
000E72r 2               ;   The animation frames are the only tiles in the game that are NOT what the
000E72r 2               ;   board holds: a glow glyph, a beam, a ring frame and a blip frame are all
000E72r 2               ;   drawn over a cell whose board byte still says what it really is, right up
000E72r 2               ;   until CascadeRemove zeroes it (anim.asm, SPEC 8 step 5). Everything else
000E72r 2               ;   goes through RenderCell above and never has to think about it.
000E72r 2               ; -----------------------------------------------------------------------------
000E72r 2               RenderCellAs:
000E72r 2  48             pha
000E73r 2  8A             txa
000E74r 2  29 07          and #(BOARD_STRIDE - 1)
000E76r 2  18             clc
000E77r 2  69 01          adc #WELL_ORIGIN_X
000E79r 2  85 rr          sta RedrawCol
000E7Br 2  8A             txa
000E7Cr 2  4A             lsr a
000E7Dr 2  4A             lsr a
000E7Er 2  4A             lsr a
000E7Fr 2  18             clc
000E80r 2  69 04          adc #WELL_ORIGIN_Y
000E82r 2  A8             tay
000E83r 2  68             pla
000E84r 2  A6 rr          ldx RedrawCol
000E86r 2  4C rr rr       jmp RenderMark
000E89r 2               
000E89r 2               ; -----------------------------------------------------------------------------
000E89r 2               ;   RenderPiece — queue the three falling cells at where the piece is now
000E89r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000E89r 2               ;
000E89r 2               ;   RenderMark clobbers X and keeps Y, so the panel column is parked in
000E89r 2               ;   RedrawCol and the panel row rides Y down the three cells. Cell C can never
000E89r 2               ;   be lower than board row 15, so all three are always inside the well and
000E89r 2               ;   there is nothing to clip.
000E89r 2               ; -----------------------------------------------------------------------------
000E89r 2               RenderPiece:
000E89r 2  AD rr rr       lda PieceCol
000E8Cr 2  18             clc
000E8Dr 2  69 01          adc #WELL_ORIGIN_X
000E8Fr 2  85 rr          sta RedrawCol
000E91r 2  AD rr rr       lda PieceRow
000E94r 2  18             clc
000E95r 2  69 04          adc #WELL_ORIGIN_Y
000E97r 2  A8             tay
000E98r 2  AD rr rr       lda PieceA
000E9Br 2  A6 rr          ldx RedrawCol
000E9Dr 2  20 rr rr       jsr RenderMark
000EA0r 2  C8             iny
000EA1r 2  AD rr rr       lda PieceB
000EA4r 2  A6 rr          ldx RedrawCol
000EA6r 2  20 rr rr       jsr RenderMark
000EA9r 2  C8             iny
000EAAr 2  AD rr rr       lda PieceC
000EADr 2  A6 rr          ldx RedrawCol
000EAFr 2  4C rr rr       jmp RenderMark
000EB2r 2               
000EB2r 2               ; -----------------------------------------------------------------------------
000EB2r 2               ;   RenderPieceErase — blank the three cells the piece is leaving
000EB2r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000EB2r 2               ;
000EB2r 2               ;   Three blanks rather than three board reads, because the cells under a
000EB2r 2               ;   falling piece are always empty: every move and every gravity step tests
000EB2r 2               ;   the target cells before it happens, and the one thing that writes them is
000EB2r 2               ;   PieceLock, after which nothing erases the piece again (piece.asm).
000EB2r 2               ; -----------------------------------------------------------------------------
000EB2r 2               RenderPieceErase:
000EB2r 2  AD rr rr       lda PieceCol
000EB5r 2  18             clc
000EB6r 2  69 01          adc #WELL_ORIGIN_X
000EB8r 2  85 rr          sta RedrawCol
000EBAr 2  AD rr rr       lda PieceRow
000EBDr 2  18             clc
000EBEr 2  69 04          adc #WELL_ORIGIN_Y
000EC0r 2  A8             tay
000EC1r 2  A9 00          lda #TILE_EMPTY
000EC3r 2  A6 rr          ldx RedrawCol
000EC5r 2  20 rr rr       jsr RenderMark
000EC8r 2  C8             iny
000EC9r 2  A9 00          lda #TILE_EMPTY
000ECBr 2  A6 rr          ldx RedrawCol
000ECDr 2  20 rr rr       jsr RenderMark
000ED0r 2  C8             iny
000ED1r 2  A9 00          lda #TILE_EMPTY
000ED3r 2  A6 rr          ldx RedrawCol
000ED5r 2  4C rr rr       jmp RenderMark
000ED8r 2               
000ED8r 2               ; -----------------------------------------------------------------------------
000ED8r 2               ;   RenderNext — the preview, panel column NEXT_X, rows NEXT_Y..NEXT_Y+2
000ED8r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000ED8r 2               ;
000ED8r 2               ;   All three cells every time. The play screen image ships with a piece
000ED8r 2               ;   already drawn in the NEXT box (SPEC 12.1), so this has to overwrite rather
000ED8r 2               ;   than assume it is drawing onto backdrop.
000ED8r 2               ; -----------------------------------------------------------------------------
000ED8r 2               RenderNext:
000ED8r 2  A0 10          ldy #NEXT_Y
000EDAr 2  AD rr rr       lda NextA
000EDDr 2  A2 0B          ldx #NEXT_X
000EDFr 2  20 rr rr       jsr RenderMark
000EE2r 2  C8             iny
000EE3r 2  AD rr rr       lda NextB
000EE6r 2  A2 0B          ldx #NEXT_X
000EE8r 2  20 rr rr       jsr RenderMark
000EEBr 2  C8             iny
000EECr 2  AD rr rr       lda NextC
000EEFr 2  A2 0B          ldx #NEXT_X
000EF1r 2  4C rr rr       jmp RenderMark
000EF4r 2               
000EF4r 2               ; -----------------------------------------------------------------------------
000EF4r 2               ;   RenderScore / RenderHigh / RenderLevel — only called when a value changes
000EF4r 2               ;   Nothing here compares anything: the caller knows when it changed a value
000EF4r 2               ;   and these are not cheap enough to run every frame. SCORE_DIGITS cells is
000EF4r 2               ;   most of a frame's flush budget on its own.
000EF4r 2               ; -----------------------------------------------------------------------------
000EF4r 2               RenderScore:
000EF4r 2  A9 rr          lda #<ScoreLo
000EF6r 2  85 rr          sta Ptr1
000EF8r 2  A9 rr          lda #>ScoreLo
000EFAr 2  85 rr          sta Ptr1+1
000EFCr 2  A2 0C          ldx #SCORE_X
000EFEr 2  A0 05          ldy #SCORE_Y
000F00r 2  A9 07          lda #SCORE_DIGITS
000F02r 2  4C rr rr       jmp TextBcd
000F05r 2               
000F05r 2               RenderHigh:
000F05r 2  A9 rr          lda #<HighLo
000F07r 2  85 rr          sta Ptr1
000F09r 2  A9 rr          lda #>HighLo
000F0Br 2  85 rr          sta Ptr1+1
000F0Dr 2  A2 0C          ldx #HIGH_X
000F0Fr 2  A0 0A          ldy #HIGH_Y
000F11r 2  A9 07          lda #SCORE_DIGITS
000F13r 2  20 rr rr       jsr TextBcd
000F16r 2               
000F16r 2  A9 rr          lda #<HighLevel               ; The level it was set on, under the digits
000F18r 2  85 rr          sta Ptr1
000F1Ar 2  A9 rr          lda #>HighLevel
000F1Cr 2  85 rr          sta Ptr1+1
000F1Er 2  A2 0F          ldx #HIGHLVL_X
000F20r 2  A0 0B          ldy #HIGHLVL_Y
000F22r 2  A9 02          lda #LEVEL_DIGITS
000F24r 2  4C rr rr       jmp TextBcd
000F27r 2               
000F27r 2               ; -----------------------------------------------------------------------------
000F27r 2               ;   RenderHighBlank — the dark half of the HIGH field's overtake flash
000F27r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y, TextCol
000F27r 2               ;   SPEC 9.8. The seven digits only; the level under them stays put, so the
000F27r 2               ;   box never looks empty and the flash costs seven cells of the budget.
000F27r 2               ; -----------------------------------------------------------------------------
000F27r 2               RenderHighBlank:
000F27r 2  A9 0C          lda #HIGH_X
000F29r 2  85 rr          sta TextCol                   ; Not X: RenderMark clobbers it
000F2Br 2               @Cell:
000F2Br 2  A9 00          lda #TILE_BLANK
000F2Dr 2  A6 rr          ldx TextCol
000F2Fr 2  A0 0A          ldy #HIGH_Y
000F31r 2  20 rr rr       jsr RenderMark
000F34r 2  E6 rr          inc TextCol
000F36r 2  A5 rr          lda TextCol
000F38r 2  C9 13          cmp #(HIGH_X + SCORE_DIGITS)
000F3Ar 2  90 EF          bcc @Cell
000F3Cr 2  60             rts
000F3Dr 2               
000F3Dr 2               RenderLevel:
000F3Dr 2  AD rr rr       lda Level
000F40r 2  4C rr rr       jmp TextLevel
000F43r 2               
000F43r 1               .include "../src/text.asm"
000F43r 2               ; =============================================================================
000F43r 2               ;   text.asm — Wizards Lab, text and numbers on the panel
000F43r 2               ; =============================================================================
000F43r 2               ;   The font lives in tile groups 2-6, forty glyphs in the order
000F43r 2               ;
000F43r 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
000F43r 2               ;
000F43r 2               ;   starting at FONT_BASE, so a digit is FONT_DIGIT_0 + value and a letter is
000F43r 2               ;   FONT_LETTER_A + (letter - 'A'). Strings are stored pre-converted to tile
000F43r 2               ;   numbers, terminated by TEXT_END, so drawing one is a copy with no
000F43r 2               ;   translation. src/strings.inc holds them and the macro that encodes them.
000F43r 2               ;
000F43r 2               ;   Everything here draws through RenderMark, never to the screen: text is
000F43r 2               ;   panel cells like any other and goes through the same one flush a frame.
000F43r 2               ;   That is also why the cursor state lives in the zero-page block RenderMark
000F43r 2               ;   promises not to touch (zeropage.inc) rather than in Tmp0-Tmp3.
000F43r 2               ; =============================================================================
000F43r 2               
000F43r 2               ; -----------------------------------------------------------------------------
000F43r 2               ;   TextDraw — draw a tile-encoded string
000F43r 2               ;   In:  Ptr1 -> string (TEXT_END terminated), X = panel column, Y = panel row
000F43r 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx
000F43r 2               ; -----------------------------------------------------------------------------
000F43r 2               TextDraw:
000F43r 2  86 rr          stx TextCol
000F45r 2  84 rr          sty TextRow
000F47r 2  A9 00          lda #0
000F49r 2  85 rr          sta TextIdx
000F4Br 2               @Char:
000F4Br 2  A4 rr          ldy TextIdx
000F4Dr 2  B1 rr          lda (Ptr1),y
000F4Fr 2  C9 FF          cmp #TEXT_END
000F51r 2  F0 0D          beq @Done
000F53r 2  A6 rr          ldx TextCol
000F55r 2  A4 rr          ldy TextRow
000F57r 2  20 rr rr       jsr RenderMark
000F5Ar 2  E6 rr          inc TextCol
000F5Cr 2  E6 rr          inc TextIdx
000F5Er 2  D0 EB          bne @Char                     ; Always — a string is never 256 tiles long
000F60r 2               @Done:
000F60r 2  60             rts
000F61r 2               
000F61r 2               ; -----------------------------------------------------------------------------
000F61r 2               ;   TextBcd — draw a packed-BCD number, zero padded
000F61r 2               ;   In:  Ptr1 -> BCD bytes (low first), A = digit count,
000F61r 2               ;        X = panel column, Y = panel row
000F61r 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx, TextByte,
000F61r 2               ;        TextSkip
000F61r 2               ;
000F61r 2               ;   SCORE_DIGITS (7) for the score and the high score, 2 for the high score's
000F61r 2               ;   level. The LEVEL box is not drawn with this — see TextLevel.
000F61r 2               ;
000F61r 2               ;   The count is in DIGITS, not bytes, because the score is seven digits in
000F61r 2               ;   four bytes: the top nibble of the most significant byte is held at zero
000F61r 2               ;   (SPEC 9) and must not be drawn, or the field would be eight cells wide and
000F61r 2               ;   no longer centred. An odd count starts at the LOW nibble of the top byte.
000F61r 2               ;
000F61r 2               ;   **Every digit is drawn, every time.** A leading zero is a zero glyph, not
000F61r 2               ;   a blank: 1250 draws as 0001250. There is no suppression pass and no
000F61r 2               ;   right-alignment — the field is fixed width so a digit never changes
000F61r 2               ;   column while the player is watching it (SPEC 9). This also makes the
000F61r 2               ;   routine branchless, and lets RenderScore mark a fixed run of cells dirty.
000F61r 2               ; -----------------------------------------------------------------------------
000F61r 2               TextBcd:
000F61r 2  86 rr          stx TextCol
000F63r 2  84 rr          sty TextRow
000F65r 2  48             pha                           ; Digit count
000F66r 2  29 01          and #$01
000F68r 2  85 rr          sta TextSkip                  ; Odd count: the top high nibble is not drawn
000F6Ar 2  68             pla
000F6Br 2  18             clc
000F6Cr 2  69 01          adc #1                        ; Bytes = (digits + 1) / 2
000F6Er 2  4A             lsr a
000F6Fr 2  AA             tax
000F70r 2  CA             dex
000F71r 2  86 rr          stx TextIdx                   ; Start at the most significant byte
000F73r 2               
000F73r 2               @Byte:
000F73r 2  A4 rr          ldy TextIdx
000F75r 2  B1 rr          lda (Ptr1),y
000F77r 2  85 rr          sta TextByte
000F79r 2               
000F79r 2  A5 rr          lda TextSkip
000F7Br 2  D0 09          bne @Low
000F7Dr 2  A5 rr          lda TextByte
000F7Fr 2  4A             lsr a
000F80r 2  4A             lsr a
000F81r 2  4A             lsr a
000F82r 2  4A             lsr a
000F83r 2  20 rr rr       jsr TextDigit
000F86r 2               @Low:
000F86r 2  A9 00          lda #0
000F88r 2  85 rr          sta TextSkip
000F8Ar 2  A5 rr          lda TextByte
000F8Cr 2  29 0F          and #$0F
000F8Er 2  20 rr rr       jsr TextDigit
000F91r 2               
000F91r 2  C6 rr          dec TextIdx
000F93r 2  10 DE          bpl @Byte
000F95r 2  60             rts
000F96r 2               
000F96r 2               ; -----------------------------------------------------------------------------
000F96r 2               ;   TextDigit — draw one digit at the cursor and step it right
000F96r 2               ;   In:  A = value 0-9      Modifies: A, X, Y, TextCol
000F96r 2               ; -----------------------------------------------------------------------------
000F96r 2               TextDigit:
000F96r 2  18             clc
000F97r 2  69 10          adc #FONT_DIGIT_0
000F99r 2  A6 rr          ldx TextCol
000F9Br 2  A4 rr          ldy TextRow
000F9Dr 2  20 rr rr       jsr RenderMark
000FA0r 2  E6 rr          inc TextCol
000FA2r 2  60             rts
000FA3r 2               
000FA3r 2               ; -----------------------------------------------------------------------------
000FA3r 2               ;   TextBanner — centre a string in the one-row message band
000FA3r 2               ;   In:  Ptr1 -> string
000FA3r 2               ;   Out: nothing.  Modifies: A, X, Y and the text cursor
000FA3r 2               ;
000FA3r 2               ;   SPEC 12.2 — the band is panel row MSG_Y, full width, one row only. The
000FA3r 2               ;   string arrives already wrapped as `~~ TEXT ~~` — two FONT_TILDE, a blank,
000FA3r 2               ;   the text, a blank, two FONT_TILDE. Centring is (PANEL_W - length) / 2,
000FA3r 2               ;   which is why banner strings are drawn even-length.
000FA3r 2               ; -----------------------------------------------------------------------------
000FA3r 2               TextBanner:
000FA3r 2  A0 00          ldy #0
000FA5r 2               @Len:
000FA5r 2  B1 rr          lda (Ptr1),y
000FA7r 2  C9 FF          cmp #TEXT_END
000FA9r 2  F0 03          beq @Got
000FABr 2  C8             iny
000FACr 2  D0 F7          bne @Len
000FAEr 2               @Got:
000FAEr 2  98             tya
000FAFr 2  85 rr          sta TextIdx
000FB1r 2  A9 16          lda #PANEL_W
000FB3r 2  38             sec
000FB4r 2  E5 rr          sbc TextIdx
000FB6r 2  4A             lsr a                         ; (PANEL_W - length) / 2
000FB7r 2  AA             tax
000FB8r 2  A0 16          ldy #MSG_Y
000FBAr 2  4C rr rr       jmp TextDraw
000FBDr 2               
000FBDr 2               ; -----------------------------------------------------------------------------
000FBDr 2               ;   TextBannerClear — blank the message band back to backdrop
000FBDr 2               ;   Out: nothing.  Modifies: A, X, Y
000FBDr 2               ;
000FBDr 2               ;   Columns MSG_X .. MSG_X + MSG_W - 1 only. The shelf tiles at either end of
000FBDr 2               ;   the band belong to the static screen image and are never redrawn.
000FBDr 2               ; -----------------------------------------------------------------------------
000FBDr 2               TextBannerClear:
000FBDr 2  A9 02          lda #MSG_X
000FBFr 2  85 rr          sta TextCol                   ; Not X: RenderMark clobbers it
000FC1r 2               @Cell:
000FC1r 2  A9 00          lda #TILE_BLANK
000FC3r 2  A6 rr          ldx TextCol
000FC5r 2  A0 16          ldy #MSG_Y
000FC7r 2  20 rr rr       jsr RenderMark
000FCAr 2  E6 rr          inc TextCol
000FCCr 2  A5 rr          lda TextCol
000FCEr 2  C9 14          cmp #(MSG_X + MSG_W)
000FD0r 2  90 EF          bcc @Cell
000FD2r 2  60             rts
000FD3r 2               
000FD3r 2               ; -----------------------------------------------------------------------------
000FD3r 2               ;   TextLevel — the LEVEL box, tens above units in one column
000FD3r 2               ;   In:  A = level (binary, 1-99)
000FD3r 2               ;   Out: nothing.  Modifies: A, X, Y, TextByte
000FD3r 2               ;   SPEC 12.2 — LEVEL_X, tens at LEVEL_Y and units at LEVEL_Y + 1. Always two
000FD3r 2               ;   digits: level 5 draws "0" over "5".
000FD3r 2               ; -----------------------------------------------------------------------------
000FD3r 2               TextLevel:
000FD3r 2  A2 00          ldx #0
000FD5r 2               @Tens:
000FD5r 2  C9 0A          cmp #10
000FD7r 2  90 05          bcc @Split
000FD9r 2  E9 0A          sbc #10                       ; Carry is set by the CMP that got us here
000FDBr 2  E8             inx
000FDCr 2  D0 F7          bne @Tens                     ; Always — X tops out at 9
000FDEr 2               @Split:
000FDEr 2  85 rr          sta TextByte                  ; Units
000FE0r 2  8A             txa
000FE1r 2  18             clc
000FE2r 2  69 10          adc #FONT_DIGIT_0
000FE4r 2  A2 12          ldx #LEVEL_X
000FE6r 2  A0 11          ldy #LEVEL_Y
000FE8r 2  20 rr rr       jsr RenderMark
000FEBr 2  A5 rr          lda TextByte
000FEDr 2  18             clc
000FEEr 2  69 10          adc #FONT_DIGIT_0
000FF0r 2  A2 12          ldx #LEVEL_X
000FF2r 2  A0 12          ldy #LEVEL_Y + 1
000FF4r 2  4C rr rr       jmp RenderMark
000FF7r 2               
000FF7r 1               .include "../src/audio.asm"
000FF7r 2               ; =============================================================================
000FF7r 2               ;   audio.asm — Wizards Lab, sound
000FF7r 2               ; =============================================================================
000FF7r 2               ;   SPEC.md section 16. Out of scope for the first playable build, but the
000FF7r 2               ;   hook is here from the start so game logic never has to be revisited to add
000FF7r 2               ;   it: logic writes an effect id to SfxRequest and forgets about it.
000FF7r 2               ;
000FF7r 2               ;   The AC6502 and the C64 both have a SID and can share a driver — only the
000FF7r 2               ;   register base differs ($9800 against $D400). The VIC-20 needs its own,
000FF7r 2               ;   against $900A-$900E.
000FF7r 2               ; =============================================================================
000FF7r 2               
000FF7r 2               SFX_MOVE        = 1
000FF7r 2               SFX_ROTATE      = 2
000FF7r 2               SFX_LOCK        = 3
000FF7r 2               SFX_MATCH       = 4
000FF7r 2               SFX_FIREBALL    = 5
000FF7r 2               SFX_BOLT        = 6
000FF7r 2               SFX_BOMB        = 7
000FF7r 2               SFX_STAR        = 8
000FF7r 2               SFX_PRISM       = 9
000FF7r 2               SFX_LEVELUP     = 10
000FF7r 2               SFX_HIGHSCORE   = 11
000FF7r 2               SFX_GAMEOVER    = 12
000FF7r 2               
000FF7r 2               ; -----------------------------------------------------------------------------
000FF7r 2               ;   AudioInit — silence everything
000FF7r 2               ; -----------------------------------------------------------------------------
000FF7r 2               AudioInit:
000FF7r 2  A9 00          lda #0
000FF9r 2  8D rr rr       sta SfxRequest
000FFCr 2  8D rr rr       sta SfxTimer
000FFFr 2  60             rts
001000r 2               
001000r 2               ; -----------------------------------------------------------------------------
001000r 2               ;   AudioTick — called once per frame, consumes SfxRequest
001000r 2               ; -----------------------------------------------------------------------------
001000r 2               AudioTick:
001000r 2                 ; TODO: start a new effect when SfxRequest is non-zero, then advance the
001000r 2                 ; envelope of whatever is playing. Calls HalSfx for the register writes.
001000r 2  A9 00          lda #0
001002r 2  8D rr rr       sta SfxRequest
001005r 2  60             rts
001006r 2               
001006r 1               
001006r 1               ; =============================================================================
001006r 1               ;   HAL — TMS9918 Graphics Mode I
001006r 1               ; =============================================================================
001006r 1               
001006r 1               ; -----------------------------------------------------------------------------
001006r 1               ;   VdpSetWrite — point the VDP at a VRAM address for writing
001006r 1               ;   In:  A = address low, X = address high
001006r 1               ; -----------------------------------------------------------------------------
001006r 1               VdpSetWrite:
001006r 1  8D 01 9C       sta VC_REG
001009r 1  8A             txa
00100Ar 1  09 40          ora #$40                      ; Bit 6 selects write
00100Cr 1  8D 01 9C       sta VC_REG
00100Fr 1  60             rts
001010r 1               
001010r 1               ; -----------------------------------------------------------------------------
001010r 1               ;   VdpSetReg — write a VDP control register
001010r 1               ;   In:  A = value, X = register number
001010r 1               ; -----------------------------------------------------------------------------
001010r 1               VdpSetReg:
001010r 1  8D 01 9C       sta VC_REG
001013r 1  8A             txa
001014r 1  09 80          ora #$80
001016r 1  8D 01 9C       sta VC_REG
001019r 1  60             rts
00101Ar 1               
00101Ar 1               ; -----------------------------------------------------------------------------
00101Ar 1               ;   HalInitVideo — Graphics I, tiles loaded, screen cleared, everything black
00101Ar 1               ; -----------------------------------------------------------------------------
00101Ar 1               HalInitVideo:
00101Ar 1  A2 00          ldx #0                        ; R0: external VDP disabled, Graphics I
00101Cr 1  A9 00          lda #$00
00101Er 1  20 rr rr       jsr VdpSetReg
001021r 1  A2 01          ldx #1                        ; R1: 16 K, display on, IRQ enabled, 8x8 sprites
001023r 1  A9 E0          lda #$E0                      ; The IE bit stays SET even though this game
001025r 1  20 rr rr       jsr VdpSetReg                 ;   polls: HalWaitFrame reads the status
001028r 1                                               ;   register for the vblank flag, and the flag
001028r 1                                               ;   only raises when IE is on. The CPU's own I
001028r 1                                               ;   flag is never cleared, so the interrupt is
001028r 1                                               ;   asserted and simply ignored — reading the
001028r 1                                               ;   status register acknowledges it.
001028r 1  A2 02          ldx #2                        ; R2: name table    $1400 / $400
00102Ar 1  A9 05          lda #$05
00102Cr 1  20 rr rr       jsr VdpSetReg
00102Fr 1  A2 03          ldx #3                        ; R3: colour table  $2000 / $40
001031r 1  A9 80          lda #$80
001033r 1  20 rr rr       jsr VdpSetReg
001036r 1  A2 04          ldx #4                        ; R4: pattern table $0000 / $800
001038r 1  A9 00          lda #$00
00103Ar 1  20 rr rr       jsr VdpSetReg
00103Dr 1  A2 05          ldx #5                        ; R5: sprite attrs  $1B00 / $80
00103Fr 1  A9 36          lda #$36
001041r 1  20 rr rr       jsr VdpSetReg
001044r 1  A2 06          ldx #6                        ; R6: sprite patterns $0000
001046r 1  A9 00          lda #$00
001048r 1  20 rr rr       jsr VdpSetReg
00104Br 1  A2 07          ldx #7                        ; R7: backdrop black
00104Dr 1  A9 01          lda #$01
00104Fr 1  20 rr rr       jsr VdpSetReg
001052r 1               
001052r 1  20 rr rr       jsr LoadTileset
001055r 1  20 rr rr       jsr LoadColorTable
001058r 1  20 rr rr       jsr DisableSprites
00105Br 1                 ; falls through
00105Br 1               
00105Br 1               ; -----------------------------------------------------------------------------
00105Br 1               ;   HalClearScreen — fill the name table with the blank tile
00105Br 1               ; -----------------------------------------------------------------------------
00105Br 1               HalClearScreen:
00105Br 1  A9 00          lda #<VRAM_NAMES
00105Dr 1  A2 14          ldx #>VRAM_NAMES
00105Fr 1  20 rr rr       jsr VdpSetWrite
001062r 1  A2 03          ldx #3                        ; 3 x 256 = 768 cells
001064r 1  A0 00          ldy #0
001066r 1               @Cell:
001066r 1  A9 00          lda #TILE_BLANK
001068r 1  8D 00 9C       sta VC_DATA
00106Br 1  C8             iny
00106Cr 1  D0 F8          bne @Cell
00106Er 1  CA             dex
00106Fr 1  D0 F5          bne @Cell
001071r 1  60             rts
001072r 1               
001072r 1               ; -----------------------------------------------------------------------------
001072r 1               ;   LoadTileset — 2 K of patterns into VRAM
001072r 1               ;   PLACEHOLDER ART: Tileset is data/tileset.bin. See data/README.md.
001072r 1               ; -----------------------------------------------------------------------------
001072r 1               LoadTileset:
001072r 1  A9 00          lda #<VRAM_PATTERNS
001074r 1  A2 00          ldx #>VRAM_PATTERNS
001076r 1  20 rr rr       jsr VdpSetWrite
001079r 1               
001079r 1  A9 rr          lda #<Tileset
00107Br 1  85 rr          sta SrcPtr
00107Dr 1  A9 rr          lda #>Tileset
00107Fr 1  85 rr          sta SrcPtr+1
001081r 1               
001081r 1  A2 08          ldx #8                        ; 8 x 256 = 2048 bytes
001083r 1  A0 00          ldy #0
001085r 1               @Byte:
001085r 1  B1 rr          lda (SrcPtr),y
001087r 1  8D 00 9C       sta VC_DATA
00108Ar 1  C8             iny
00108Br 1  D0 F8          bne @Byte
00108Dr 1  E6 rr          inc SrcPtr+1
00108Fr 1  CA             dex
001090r 1  D0 F3          bne @Byte
001092r 1  60             rts
001093r 1               
001093r 1               ; -----------------------------------------------------------------------------
001093r 1               ;   LoadColorTable — 32 bytes, one per 8-pattern group
001093r 1               ;   This is what makes a tile red: its pattern number selects the group, and
001093r 1               ;   the group's byte here selects the colour. Nothing is per cell.
001093r 1               ; -----------------------------------------------------------------------------
001093r 1               LoadColorTable:
001093r 1  A9 00          lda #<VRAM_COLORS
001095r 1  A2 20          ldx #>VRAM_COLORS
001097r 1  20 rr rr       jsr VdpSetWrite
00109Ar 1  A0 00          ldy #0
00109Cr 1               @Byte:
00109Cr 1  B9 rr rr       lda TileColorTMS,y
00109Fr 1  8D 00 9C       sta VC_DATA
0010A2r 1  C8             iny
0010A3r 1  C0 20          cpy #32
0010A5r 1  D0 F5          bne @Byte
0010A7r 1  60             rts
0010A8r 1               
0010A8r 1               ; -----------------------------------------------------------------------------
0010A8r 1               ;   DisableSprites — park every sprite off screen
0010A8r 1               ;   The game uses none; $D0 in the first Y byte terminates the sprite list.
0010A8r 1               ; -----------------------------------------------------------------------------
0010A8r 1               DisableSprites:
0010A8r 1  A9 00          lda #<VRAM_SPRITES
0010AAr 1  A2 1B          ldx #>VRAM_SPRITES
0010ACr 1  20 rr rr       jsr VdpSetWrite
0010AFr 1  A9 D0          lda #$D0
0010B1r 1  8D 00 9C       sta VC_DATA
0010B4r 1  60             rts
0010B5r 1               
0010B5r 1               ; -----------------------------------------------------------------------------
0010B5r 1               ;   HalWaitFrame — poll the VDP status register for vertical blank
0010B5r 1               ;   No raster interrupt here, and the status poll is self-syncing.
0010B5r 1               ; -----------------------------------------------------------------------------
0010B5r 1               HalWaitFrame:
0010B5r 1               @Wait:
0010B5r 1  AD 01 9C       lda VC_STATUS
0010B8r 1  29 80          and #$80                      ; Bit 7 sets at the end of each frame
0010BAr 1  F0 F9          beq @Wait
0010BCr 1  60             rts
0010BDr 1               
0010BDr 1               ; -----------------------------------------------------------------------------
0010BDr 1               ;   HalPlotCell — In: A = tile, X = screen column, Y = screen row
0010BDr 1               ; -----------------------------------------------------------------------------
0010BDr 1               HalPlotCell:
0010BDr 1  48             pha
0010BEr 1  20 rr rr       jsr NameAddr                  ; Ptr1 = VRAM_NAMES + row * 32 + col
0010C1r 1  A5 rr          lda Ptr1
0010C3r 1  A6 rr          ldx Ptr1+1
0010C5r 1  20 rr rr       jsr VdpSetWrite
0010C8r 1  68             pla
0010C9r 1  8D 00 9C       sta VC_DATA
0010CCr 1  60             rts
0010CDr 1               
0010CDr 1               ; -----------------------------------------------------------------------------
0010CDr 1               ;   NameAddr — In: X = column, Y = row.  Out: Ptr1 = name table address
0010CDr 1               ; -----------------------------------------------------------------------------
0010CDr 1               NameAddr:
0010CDr 1  98             tya
0010CEr 1  29 07          and #$07
0010D0r 1  0A             asl a                         ; (row & 7) * 32 lands in bits 5-7...
0010D1r 1  0A             asl a
0010D2r 1  0A             asl a
0010D3r 1  0A             asl a
0010D4r 1  0A             asl a
0010D5r 1  85 rr          sta Ptr1
0010D7r 1  8A             txa
0010D8r 1  05 rr          ora Ptr1                      ; ...leaving bits 0-4 free for the column
0010DAr 1  85 rr          sta Ptr1
0010DCr 1  98             tya
0010DDr 1  4A             lsr a                         ; row >> 3 is the page within the name table
0010DEr 1  4A             lsr a
0010DFr 1  4A             lsr a
0010E0r 1  18             clc
0010E1r 1  69 14          adc #>VRAM_NAMES
0010E3r 1  85 rr          sta Ptr1+1
0010E5r 1  60             rts
0010E6r 1               
0010E6r 1               ; -----------------------------------------------------------------------------
0010E6r 1               ;   HalBlitScreen — draw a full 768-byte name table image
0010E6r 1               ;   In: SrcPtr -> image. Ptr1 (colour) is ignored: this machine has no colour
0010E6r 1               ;   RAM, so the same image drives every platform's layout and only the palette
0010E6r 1               ;   mechanism differs.
0010E6r 1               ; -----------------------------------------------------------------------------
0010E6r 1               HalBlitScreen:
0010E6r 1  A9 00          lda #<VRAM_NAMES
0010E8r 1  A2 14          ldx #>VRAM_NAMES
0010EAr 1  20 rr rr       jsr VdpSetWrite
0010EDr 1               
0010EDr 1  A2 03          ldx #3                        ; 3 full pages
0010EFr 1  A0 00          ldy #0
0010F1r 1               @Byte:
0010F1r 1  B1 rr          lda (SrcPtr),y
0010F3r 1  8D 00 9C       sta VC_DATA
0010F6r 1  C8             iny
0010F7r 1  D0 F8          bne @Byte
0010F9r 1  E6 rr          inc SrcPtr+1
0010FBr 1  CA             dex
0010FCr 1  D0 F3          bne @Byte
0010FEr 1  60             rts
0010FFr 1               
0010FFr 1               ; -----------------------------------------------------------------------------
0010FFr 1               ;   HalReadInput — joystick 1 and the keyboard, in one active-high mask
0010FFr 1               ;   The port is active low, %RLDUYXBA (ac6502.inc).
0010FFr 1               ;
0010FFr 1               ;   This machine has no key matrix to scan. Two encoders sit on the VIA ports
0010FFr 1               ;   the joysticks share and hand over one ASCII byte per keystroke, strobing
0010FFr 1               ;   CB1 (matrix keyboard) or CA1 (PS/2) when it is ready. There is no key-up
0010FFr 1               ;   event and no way to ask whether a key is still down, so a key here is a
0010FFr 1               ;   ONE-FRAME PULSE rather than a held bit: the edge-triggered controls
0010FFr 1               ;   (rotate, pause, fire) work exactly as they do on a stick, and the held
0010FFr 1               ;   ones (left, right, soft drop) advance once per keystroke and once per
0010FFr 1               ;   encoder auto-repeat. DAS never engages from the keyboard, because the bit
0010FFr 1               ;   is never down two frames running.
0010FFr 1               ;
0010FFr 1               ;   Polled, not interrupt driven: the IFR flag raises on the strobe whether or
0010FFr 1               ;   not the VIA is allowed to assert IRQ, and this cartridge never clears the
0010FFr 1               ;   CPU's I flag (D7). Reading the port takes the byte and clears the flag.
0010FFr 1               ; -----------------------------------------------------------------------------
0010FFr 1               HalReadInput:
0010FFr 1  AD 0D 03       lda HW_PRESENT
001102r 1  29 20          and #HW_GPIO                  ; No GPIO card means a floating bus, not input
001104r 1  F0 51          beq @None
001106r 1               
001106r 1  20 rr rr       jsr ScanKeys                  ; BEFORE the joystick: ReadJoystick1 releases
001109r 1  85 rr          sta Tmp2                      ;   both encoders, and a key pending at that
00110Br 1                                               ;   moment would go with them
00110Br 1               
00110Br 1  20 48 A0       jsr ReadJoystick1
00110Er 1  49 FF          eor #$FF                      ; Active low in, active high out
001110r 1  85 rr          sta Tmp0
001112r 1               
001112r 1  A9 00          lda #0
001114r 1  85 rr          sta Tmp1
001116r 1               
001116r 1  A5 rr          lda Tmp0
001118r 1  29 10          and #%00010000                  ; U
00111Ar 1  F0 06          beq @NoUp
00111Cr 1  A5 rr          lda Tmp1
00111Er 1  09 01          ora #INPUT_UP
001120r 1  85 rr          sta Tmp1
001122r 1               @NoUp:
001122r 1  A5 rr          lda Tmp0
001124r 1  29 20          and #%00100000                  ; D
001126r 1  F0 06          beq @NoDown
001128r 1  A5 rr          lda Tmp1
00112Ar 1  09 02          ora #INPUT_DOWN
00112Cr 1  85 rr          sta Tmp1
00112Er 1               @NoDown:
00112Er 1  A5 rr          lda Tmp0
001130r 1  29 40          and #%01000000                  ; L
001132r 1  F0 06          beq @NoLeft
001134r 1  A5 rr          lda Tmp1
001136r 1  09 04          ora #INPUT_LEFT
001138r 1  85 rr          sta Tmp1
00113Ar 1               @NoLeft:
00113Ar 1  A5 rr          lda Tmp0
00113Cr 1  29 80          and #%10000000                  ; R
00113Er 1  F0 06          beq @NoRight
001140r 1  A5 rr          lda Tmp1
001142r 1  09 08          ora #INPUT_RIGHT
001144r 1  85 rr          sta Tmp1
001146r 1               @NoRight:
001146r 1  A5 rr          lda Tmp0
001148r 1  29 01          and #%00000001                  ; A
00114Ar 1  F0 06          beq @NoFire
00114Cr 1  A5 rr          lda Tmp1
00114Er 1  09 10          ora #INPUT_FIRE
001150r 1  85 rr          sta Tmp1
001152r 1               @NoFire:
001152r 1               
001152r 1  A5 rr          lda Tmp1
001154r 1  05 rr          ora Tmp2
001156r 1  60             rts
001157r 1               
001157r 1               @None:
001157r 1  A9 00          lda #0
001159r 1  60             rts
00115Ar 1               
00115Ar 1               ; -----------------------------------------------------------------------------
00115Ar 1               ;   ScanKeys — whatever the two encoders have strobed since the last frame
00115Ar 1               ;   Out: A = INPUT_* bits.  Modifies: A, X, Tmp2
00115Ar 1               ;   Both are checked, so either keyboard drives the game.
00115Ar 1               ; -----------------------------------------------------------------------------
00115Ar 1               ScanKeys:
00115Ar 1  A9 00          lda #0
00115Cr 1  85 rr          sta Tmp2
00115Er 1               
00115Er 1  AD 0D 94       lda GPIO_IFR
001161r 1  29 10          and #GPIO_INT_CB1             ; Matrix keyboard encoder, on port B
001163r 1  F0 0A          beq @Ps2
001165r 1  AD 00 94       lda GPIO_PORTB                ; Reading it takes the byte and clears CB1
001168r 1  20 rr rr       jsr KeyBit
00116Br 1  05 rr          ora Tmp2
00116Dr 1  85 rr          sta Tmp2
00116Fr 1               
00116Fr 1               @Ps2:
00116Fr 1  AD 0D 94       lda GPIO_IFR
001172r 1  29 02          and #GPIO_INT_CA1             ; PS/2 encoder, on port A
001174r 1  F0 0A          beq @Done
001176r 1  AD 01 94       lda GPIO_PORTA
001179r 1  20 rr rr       jsr KeyBit
00117Cr 1  05 rr          ora Tmp2
00117Er 1  85 rr          sta Tmp2
001180r 1               
001180r 1               @Done:
001180r 1  A5 rr          lda Tmp2
001182r 1  60             rts
001183r 1               
001183r 1               ; -----------------------------------------------------------------------------
001183r 1               ;   KeyBit — one ASCII byte to one input bit
001183r 1               ;   In:  A = character      Out: A = INPUT_* bit, or 0 for anything else
001183r 1               ;   SPEC 11.2. The arrow keys are not here: the encoders define no code for
001183r 1               ;   them, so WASD is the whole of the keyboard control scheme on this machine.
001183r 1               ; -----------------------------------------------------------------------------
001183r 1               KeyBit:
001183r 1  C9 0D          cmp #$0D                      ; RETURN — confirm
001185r 1  F0 2D          beq @Fire
001187r 1  C9 20          cmp #' '                      ; SPACE — rotate, and start (D15)
001189r 1  F0 1D          beq @Up
00118Br 1  09 20          ora #$20                      ; Fold to lower case. Anything that is not a
00118Dr 1  C9 77          cmp #'w'                      ;   letter simply matches nothing below.
00118Fr 1  F0 17          beq @Up
001191r 1  C9 73          cmp #'s'
001193r 1  F0 16          beq @Down
001195r 1  C9 61          cmp #'a'
001197r 1  F0 15          beq @Left
001199r 1  C9 64          cmp #'d'
00119Br 1  F0 14          beq @Right
00119Dr 1  C9 71          cmp #'q'
00119Fr 1  F0 13          beq @Fire
0011A1r 1  C9 70          cmp #'p'
0011A3r 1  F0 12          beq @Pause
0011A5r 1  A9 00          lda #0
0011A7r 1  60             rts
0011A8r 1               
0011A8r 1               @Up:
0011A8r 1  A9 01          lda #INPUT_UP
0011AAr 1  60             rts
0011ABr 1               @Down:
0011ABr 1  A9 02          lda #INPUT_DOWN
0011ADr 1  60             rts
0011AEr 1               @Left:
0011AEr 1  A9 04          lda #INPUT_LEFT
0011B0r 1  60             rts
0011B1r 1               @Right:
0011B1r 1  A9 08          lda #INPUT_RIGHT
0011B3r 1  60             rts
0011B4r 1               @Fire:
0011B4r 1  A9 10          lda #INPUT_FIRE
0011B6r 1  60             rts
0011B7r 1               @Pause:
0011B7r 1  A9 20          lda #INPUT_PAUSE
0011B9r 1  60             rts
0011BAr 1               
0011BAr 1               ; -----------------------------------------------------------------------------
0011BAr 1               ;   HalDetectRegion — the TMS9918 here is 60 Hz
0011BAr 1               ; -----------------------------------------------------------------------------
0011BAr 1               HalDetectRegion:
0011BAr 1  A9 00          lda #0                        ; NTSC
0011BCr 1  60             rts
0011BDr 1               
0011BDr 1               ; -----------------------------------------------------------------------------
0011BDr 1               ;   HalColorFlash — the fireball's detonation (SPEC 4.6, 14)
0011BDr 1               ;   In:  A = colour key ($40..$68), or TINT_NONE.  Modifies: A, X, Y, TintColor
0011BDr 1               ;
0011BDr 1               ;   ONE BYTE. A tile's colour on this machine belongs to its 8-pattern group
0011BDr 1               ;   and not to the cell, so turning every red tile on the board white is a
0011BDr 1               ;   single write to the VDP colour table — and its undo is another. SPEC 4.6
0011BDr 1               ;   calls this the fireball's free trick and it is not an exaggeration: the
0011BDr 1               ;   Commodores' equivalent costs a compare on every cell they draw for as long
0011BDr 1               ;   as the flash lasts, and this costs nothing at all once it is lit.
0011BDr 1               ;
0011BDr 1               ;   The group index is the colour key >> 3, because both the tile map and the
0011BDr 1               ;   colour table are eight patterns to a group (SPEC Appendix A).
0011BDr 1               ;
0011BDr 1               ;   The old colour goes back BEFORE the new one is lit, so two fireballs of
0011BDr 1               ;   different colours in one step leave exactly one group flashing rather than
0011BDr 1               ;   one group flashing and another stuck white for the rest of the game.
0011BDr 1               ; -----------------------------------------------------------------------------
0011BDr 1               HalColorFlash:
0011BDr 1  48             pha
0011BEr 1  AC rr rr       ldy TintColor
0011C1r 1  C0 01          cpy #TINT_NONE
0011C3r 1  F0 0B          beq @Light                    ; Nothing lit — nothing to put back
0011C5r 1  98             tya
0011C6r 1  4A             lsr a
0011C7r 1  4A             lsr a
0011C8r 1  4A             lsr a
0011C9r 1  A8             tay
0011CAr 1  B9 rr rr       lda TileColorTMS,y            ; Its own colour, straight out of the table the
0011CDr 1  20 rr rr       jsr VdpPutColor               ;   init loaded from
0011D0r 1               
0011D0r 1               @Light:
0011D0r 1  68             pla
0011D1r 1  8D rr rr       sta TintColor
0011D4r 1  C9 01          cmp #TINT_NONE
0011D6r 1  F0 0E          beq @Done
0011D8r 1  4A             lsr a
0011D9r 1  4A             lsr a
0011DAr 1  4A             lsr a
0011DBr 1  A8             tay
0011DCr 1  B9 rr rr       lda TileColorTMS,y
0011DFr 1  29 0F          and #$0F                      ; Keep the background nibble — black (SPEC 4.3)
0011E1r 1  09 F0          ora #$F0                      ; ...and make the foreground white
0011E3r 1  20 rr rr       jsr VdpPutColor
0011E6r 1               @Done:
0011E6r 1  60             rts
0011E7r 1               
0011E7r 1               ; -----------------------------------------------------------------------------
0011E7r 1               ;   VdpPutColor — In: A = colour byte, Y = group 0-31.  Modifies: A, X, Y
0011E7r 1               ; -----------------------------------------------------------------------------
0011E7r 1               VdpPutColor:
0011E7r 1  48             pha
0011E8r 1  98             tya
0011E9r 1  18             clc
0011EAr 1  69 00          adc #<VRAM_COLORS             ; 32 bytes, one per group; the low byte of the
0011ECr 1  A2 20          ldx #>VRAM_COLORS             ;   table's address is zero so this cannot carry
0011EEr 1  20 rr rr       jsr VdpSetWrite
0011F1r 1  68             pla
0011F2r 1  8D 00 9C       sta VC_DATA
0011F5r 1  60             rts
0011F6r 1               
0011F6r 1               ; -----------------------------------------------------------------------------
0011F6r 1               ;   HalSfx — TODO: SID at $9800. Shares a driver with the C64's $D400.
0011F6r 1               ; -----------------------------------------------------------------------------
0011F6r 1               HalSfx:
0011F6r 1  60             rts
0011F7r 1               
0011F7r 1               ; =============================================================================
0011F7r 1               ;   Data
0011F7r 1               ; =============================================================================
0011F7r 1               
0011F7r 1               .segment "RODATA"
000000r 1               
000000r 1               .include "../data/tilecolor-tms9918.inc"
000000r 2               ; =============================================================================
000000r 2               ;   tilecolor-tms9918.inc — TMS9918 Graphics I colour table
000000r 2               ; =============================================================================
000000r 2               ;   Generated from SPEC.md section 4.3 and Appendix A. Spec-derived data, not
000000r 2               ;   artwork: edit this file by hand, it is never overwritten by an editor
000000r 2               ;   export. Tile groups 16-31 (tiles 128-255) are the margin artwork and their
000000r 2               ;   colours are the artist's to choose.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               
000000r 2               ;   32 bytes -> VDP colour table. Each byte is (foreground << 4) | background;
000000r 2               ;   background is 1 (black) throughout, matching the backdrop register.
000000r 2               
000000r 2               TileColorTMS:
000000r 2  F1             .byte $F1                        ; group 0  tiles   0-7    UI / well frame        white
000001r 2  E1             .byte $E1                        ; group 1  tiles   8-15   UI accents             gray
000002r 2  F1             .byte $F1                        ; group 2  tiles  16-23   Font  0 1 2 3 4 5 6 7  white
000003r 2  F1             .byte $F1                        ; group 3  tiles  24-31   Font  8 9 A B C D E F  white
000004r 2  F1             .byte $F1                        ; group 4  tiles  32-39   Font  G H I J K L M N  white
000005r 2  F1             .byte $F1                        ; group 5  tiles  40-47   Font  O P Q R S T U V  white
000006r 2  F1             .byte $F1                        ; group 6  tiles  48-55   Font  W X Y Z . x ! -  white
000007r 2  F1             .byte $F1                        ; group 7  tiles  56-63   VFX                    white
000008r 2  81             .byte $81                        ; group 8  tiles  64-71   POTION 0  RED
000009r 2  B1             .byte $B1                        ; group 9  tiles  72-79   POTION 1  YELLOW
00000Ar 2  31             .byte $31                        ; group 10 tiles  80-87   POTION 2  GREEN
00000Br 2  71             .byte $71                        ; group 11 tiles  88-95   POTION 3  CYAN
00000Cr 2  51             .byte $51                        ; group 12 tiles  96-103  POTION 4  BLUE
00000Dr 2  D1             .byte $D1                        ; group 13 tiles 104-111  POTION 5  PURPLE
00000Er 2  F1             .byte $F1                        ; group 14 tiles 112-119  POTION 6  WILD / prism white
00000Fr 2  61             .byte $61                        ; group 15 tiles 120-127  Wall / stone           dark red
000010r 2  E1             .byte $E1                        ; group 16 tiles 128-135  artwork
000011r 2  61             .byte $61                        ; group 17 tiles 136-143  artwork
000012r 2  C1             .byte $C1                        ; group 18 tiles 144-151  artwork
000013r 2  A1             .byte $A1                        ; group 19 tiles 152-159  artwork
000014r 2  41             .byte $41                        ; group 20 tiles 160-167  artwork
000015r 2  21             .byte $21                        ; group 21 tiles 168-175  artwork
000016r 2  91             .byte $91                        ; group 22 tiles 176-183  artwork
000017r 2  71             .byte $71                        ; group 23 tiles 184-191  artwork
000018r 2  B1             .byte $B1                        ; group 24 tiles 192-199  artwork
000019r 2  51             .byte $51                        ; group 25 tiles 200-207  artwork
00001Ar 2  D1             .byte $D1                        ; group 26 tiles 208-215  artwork
00001Br 2  31             .byte $31                        ; group 27 tiles 216-223  artwork
00001Cr 2  81             .byte $81                        ; group 28 tiles 224-231  artwork
00001Dr 2  F1             .byte $F1                        ; group 29 tiles 232-239  artwork
00001Er 2  E1             .byte $E1                        ; group 30 tiles 240-247  artwork
00001Fr 2  F1             .byte $F1                        ; group 31 tiles 248-255  artwork
000020r 2               
000020r 1               .include "../src/tables.inc"
000020r 2               ; =============================================================================
000020r 2               ;   tables.inc — Wizards Lab, spec-derived lookup tables
000020r 2               ; =============================================================================
000020r 2               ;   Straight out of SPEC.md sections 5.3, 9 and 10. Hand-authored, never
000020r 2               ;   overwritten by an editor export. Included once, from the RODATA segment.
000020r 2               ;
000020r 2               ;   Score values above 99 do not fit in a byte, so every scoring table is a
000020r 2               ;   pair of parallel arrays — low BCD byte and high BCD byte — indexed by the
000020r 2               ;   same value.
000020r 2               ; =============================================================================
000020r 2               
000020r 2               ; --- Gravity, frames per row (SPEC 10.2) -------------------------------------
000020r 2               ;   Indexed by (level - 1), clamped to LEVEL_SPEED_CAP - 1.
000020r 2               ;   PAL is round(NTSC * 50/60), so wall-clock speed matches across regions.
000020r 2               
000020r 2               SpeedNTSC:
000020r 2  30 2B 26 22    .byte  48, 43, 38, 34, 30, 26, 23, 20   ; levels  1- 8   0.800s .. 0.333s
000024r 2  1E 1A 17 14  
000028r 2  11 0F 0D 0B    .byte  17, 15, 13, 11,  9,  8,  7,  6   ; levels  9-16   0.283s .. 0.100s
00002Cr 2  09 08 07 06  
000030r 2               
000030r 2               SpeedPAL:
000030r 2  28 24 20 1C    .byte  40, 36, 32, 28, 25, 22, 19, 17   ; levels  1- 8   0.800s .. 0.340s
000034r 2  19 16 13 11  
000038r 2  0E 0D 0B 09    .byte  14, 13, 11,  9,  8,  7,  6,  5   ; levels  9-16   0.280s .. 0.100s
00003Cr 2  08 07 06 05  
000040r 2               
000040r 2               ; --- Frame counts that differ by region (SPEC 5.6, 11.3, 14) -----------------
000040r 2               ;   Indexed by Region: 0 = NTSC, 1 = PAL. PAL is round(NTSC * 50/60) wherever
000040r 2               ;   the difference is worth a frame, so a piece takes the same number of
000040r 2               ;   SECONDS to lock on both machines rather than the same number of frames.
000040r 2               ;
000040r 2               ;   Two bytes each rather than one table of pairs, because every read is
000040r 2               ;   `ldx Region / lda Name,x` and a pair table would need the index doubled.
000040r 2               
000040r 2               LockDelay:                              ; SPEC 5.6
000040r 2  10 0E          .byte 16, 14
000042r 2               AreDelay:                               ; Entry delay after a cascade settles
000042r 2  0C 0A          .byte 12, 10
000044r 2               DasInitial:                             ; SPEC 11.3 — first repeat
000044r 2  0C 0A          .byte 12, 10
000046r 2               DasRepeat:                              ; ...and every one after it
000046r 2  04 03          .byte  4,  3
000048r 2               SoftDropRate:                           ; Frames per row while DOWN is held.
000048r 2  03 02          .byte  3,  2                          ;   Never used when gravity is faster.
00004Ar 2               BlinkHalf:                              ; SPEC 14 — half of the 30 / 25 frame
00004Ar 2  0F 0D          .byte 15, 13                          ;   blink period, which is what a
00004Cr 2                                                       ;   blinking field actually counts
00004Cr 2               GlowFrames:                             ; SPEC 14 — the GLOW window: the match
00004Cr 2  06 05          .byte  6,  5                          ;   glow and the bolt's beams
00004Er 2               FlashFrames:                            ; ...and what the window grows to when
00004Er 2  08 07          .byte  8,  7                          ;   a fireball fired, because its flash
000050r 2                                                       ;   is the longer of the two and both
000050r 2                                                       ;   are showing at once (constants.inc)
000050r 2               BannerFrames:                           ; SPEC 14 — how long LEVEL UP and
000050r 2  2D 26          .byte 45, 38                          ;   CHAIN xN stay in the message band
000052r 2               
000052r 2               ; --- The two removal animations (SPEC 14, Appendix A.3) ----------------------
000052r 2               ;   One ring, run in both directions. Indexed by AnimStep, which advances every
000052r 2               ;   VFX_FRAMES frames.
000052r 2               ;
000052r 2               ;   Potions, reagents, the bomb blast and the star all open OUTWARD and are
000052r 2               ;   gone in SHATTER_STEPS frames; the fourth entry only ever comes up when a
000052r 2               ;   marked prism is blipping out beside them and holding the window open, and
000052r 2               ;   it blanks the cell rather than leaving the last ring frame sitting there
000052r 2               ;   for four more frames.
000052r 2               
000052r 2               VfxShatter:
000052r 2  38 39 3A 00    .byte VFX_REMOVE1, VFX_REMOVE2, VFX_REMOVE3, TILE_EMPTY
000056r 2               
000056r 2               ;   The prism closes INWARD, and does not pass through the glow (SPEC A.3 —
000056r 2               ;   group 14 has no glyph +6). Five frames, so a step that clears one runs
000056r 2               ;   BLIP_STEPS rather than SHATTER_STEPS.
000056r 2               
000056r 2               VfxBlip:
000056r 2  74 75 39 38    .byte PRISM_BLIP, PRISM_BLIP + 1, VFX_REMOVE2, VFX_REMOVE1, FONT_DOT
00005Ar 2  34           
00005Br 2               
00005Br 2               ; --- Per-tile value for MATCH removals (SPEC 9.1) ----------------------------
00005Br 2               ;   Indexed by (chain - 1), clamped to 7.   20 50 100 200 300 400 500 600
00005Br 2               TileValueLo:
00005Br 2  20 50 00 00    .byte $20, $50, $00, $00, $00, $00, $00, $00
00005Fr 2  00 00 00 00  
000063r 2               TileValueHi:
000063r 2  00 00 01 02    .byte $00, $00, $01, $02, $03, $04, $05, $06
000067r 2  03 04 05 06  
00006Br 2               
00006Br 2               ; --- Per-tile value for EFFECT removals (SPEC 9.2) ---------------------------
00006Br 2               ;   Indexed by (chain - 1), clamped to 7.   30 60 120 240 350 450 550 650
00006Br 2               EffectValueLo:
00006Br 2  30 60 20 40    .byte $30, $60, $20, $40, $50, $50, $50, $50
00006Fr 2  50 50 50 50  
000073r 2               EffectValueHi:
000073r 2  00 00 01 02    .byte $00, $00, $01, $02, $03, $04, $05, $06
000077r 2  03 04 05 06  
00007Br 2               
00007Br 2               ; --- Run length bonus (SPEC 9.3) ---------------------------------------------
00007Br 2               ;   Indexed by (length - 3), clamped to 4.  0 100 300 600 1000
00007Br 2               LengthBonusLo:
00007Br 2  00 00 00 00    .byte $00, $00, $00, $00, $00
00007Fr 2  00           
000080r 2               LengthBonusHi:
000080r 2  00 01 03 06    .byte $00, $01, $03, $06, $10
000084r 2  10           
000085r 2               
000085r 2               ; --- Simultaneous run bonus (SPEC 9.4) ---------------------------------------
000085r 2               ;   Indexed by (runs - 1), clamped to 4.    0 200 500 1000 2000
000085r 2               MultiBonusLo:
000085r 2  00 00 00 00    .byte $00, $00, $00, $00, $00
000089r 2  00           
00008Ar 2               MultiBonusHi:
00008Ar 2  00 02 05 10    .byte $00, $02, $05, $10, $20
00008Er 2  20           
00008Fr 2               
00008Fr 2               ; --- Level -> reagent probability band (SPEC 5.3) ----------------------------
00008Fr 2               ;   Indexed by (level - 1), clamped to 15. Bands are 1-3, 4-6, 7-9, 10-12, 13+.
00008Fr 2               LevelBand:
00008Fr 2  00 00 00 01    .byte 0, 0, 0, 1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 4
000093r 2  01 01 02 02  
000097r 2  02 03 03 03  
00009Fr 2               
00009Fr 2               ; --- Chance a piece carries a reagent, out of 256 (SPEC 5.3) -----------------
00009Fr 2               ;   Indexed by band.                        15%  22%  27%  32%  36%
00009Fr 2               PSpecial:
00009Fr 2  26 38 45 52    .byte  38,  56,  69,  82,  92
0000A3r 2  5C           
0000A4r 2               
0000A4r 2               ; --- Reagent type, cumulative thresholds out of 256 (SPEC 5.3) ---------------
0000A4r 2               ;   Four thresholds per band; a roll at or above the last one is a Prism.
0000A4r 2               ;       roll <  [0] -> Fireball
0000A4r 2               ;       roll <  [1] -> Bolt
0000A4r 2               ;       roll <  [2] -> Bomb
0000A4r 2               ;       roll <  [3] -> Star
0000A4r 2               ;       else        -> Prism
0000A4r 2               ReagentThresholds:
0000A4r 2  4D 8A C3 EC    .byte  77, 138, 195, 236             ; band 0   levels  1-3
0000A8r 2  4D 8D C0 EE    .byte  77, 141, 192, 238             ; band 1   levels  4-6
0000ACr 2  52 92 C5 EE    .byte  82, 146, 197, 238             ; band 2   levels  7-9
0000B0r 2  4F 8D C3 EE    .byte  79, 141, 195, 238             ; band 3   levels 10-12
0000B4r 2  4F 8F C7 F0    .byte  79, 143, 199, 240             ; band 4   levels 13+
0000B8r 2               
0000B8r 2               ; --- Reagent trigger bonuses, indexed by glyph (SPEC 9.5) --------------------
0000B8r 2               ;   Glyph 0 potion and 4 star award nothing here (the star multiplies instead).
0000B8r 2               TriggerBonusLo:
0000B8r 2  00 00 00 00    .byte $00, $00, $00, $00, $00, $00, $00, $00
0000BCr 2  00 00 00 00  
0000C0r 2               TriggerBonusHi:
0000C0r 2  00 05 03 03    .byte $00, $05, $03, $03, $00, $00, $00, $00
0000C4r 2  00 00 00 00  
0000C8r 2               
0000C8r 1               .include "../src/strings.inc"
0000C8r 2               ; =============================================================================
0000C8r 2               ;   strings.inc — Wizards Lab, tile-encoded text
0000C8r 2               ; =============================================================================
0000C8r 2               ;   Strings are stored as TILE numbers, not ASCII, terminated by TEXT_END, so
0000C8r 2               ;   TextDraw is a copy with no translation at run time (see text.asm). The
0000C8r 2               ;   translation happens here instead, at assembly time, in TileStr.
0000C8r 2               ;
0000C8r 2               ;   Hand-authored, never overwritten by an editor export (D3). Included once,
0000C8r 2               ;   from each platform's RODATA segment.
0000C8r 2               ; =============================================================================
0000C8r 2               
0000C8r 2               ; -----------------------------------------------------------------------------
0000C8r 2               ;   TileChar / TileStr — ASCII source, tile bytes out
0000C8r 2               ;   The font is forty glyphs in one run from FONT_BASE:
0000C8r 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
0000C8r 2               ;   and a space is TILE_BLANK. Anything else is not in the tileset and is an
0000C8r 2               ;   assembly error rather than a wrong glyph on the screen.
0000C8r 2               ; -----------------------------------------------------------------------------
0000C8r 2               .macro TileChar c
0000C8r 2                 .if c = ' '
0000C8r 2                   .byte TILE_BLANK
0000C8r 2                 .elseif (c >= '0') .and (c <= '9')
0000C8r 2                   .byte FONT_DIGIT_0 + (c - '0')
0000C8r 2                 .elseif (c >= 'A') .and (c <= 'Z')
0000C8r 2                   .byte FONT_LETTER_A + (c - 'A')
0000C8r 2                 .elseif c = '.'
0000C8r 2                   .byte FONT_DOT
0000C8r 2                 .elseif c = 'x'
0000C8r 2                   .byte FONT_TIMES
0000C8r 2                 .elseif c = '!'
0000C8r 2                   .byte FONT_BANG
0000C8r 2                 .elseif c = '~'
0000C8r 2                   .byte FONT_TILDE
0000C8r 2                 .else
0000C8r 2                   .error "strings.inc: no tile for this character"
0000C8r 2                 .endif
0000C8r 2               .endmacro
0000C8r 2               
0000C8r 2               .macro TileStr s
0000C8r 2                 .repeat .strlen(s), I
0000C8r 2                   TileChar {.strat(s, I)}
0000C8r 2                 .endrepeat
0000C8r 2                 .byte TEXT_END
0000C8r 2               .endmacro
0000C8r 2               
0000C8r 2               ; -----------------------------------------------------------------------------
0000C8r 2               ;   Banners — SPEC 12.2, 13.3
0000C8r 2               ;   Even length, so (PANEL_W - length) / 2 centres exactly. The band is 18
0000C8r 2               ;   cells of backdrop between two shelf tiles either side, so a banner has 18
0000C8r 2               ;   to play with before it starts overwriting the artwork.
0000C8r 2               ;
0000C8r 2               ;   MsgPaused matches the play screen image byte for byte on purpose: the
0000C8r 2               ;   artwork ships with the band already reading `~~ PAUSED ~~` (see SPEC 12.1),
0000C8r 2               ;   so entering play clears the band and pausing draws this straight back.
0000C8r 2               ; -----------------------------------------------------------------------------
0000C8r 2               MsgPaused:
0000C8r 2  37 37 00 29    TileStr "~~ PAUSED ~~"                 ; 12 cells, centres at panel column 5
0000CCr 2  1A 2E 2C 1E  
0000D0r 2  1D 00 37 37  
0000D5r 2               
0000D5r 2               MsgLevelUp:
0000D5r 2  37 37 00 25    TileStr "~~ LEVEL UP ~~"               ; 14 cells, centres at panel column 4
0000D9r 2  1E 2F 1E 25  
0000DDr 2  00 2E 29 00  
0000E4r 2               
0000E4r 2               ; The chain banner carries a number, and TextDraw copies bytes rather than
0000E4r 2               ; formatting them, so the digit is a placeholder that CascadeSettle overwrites
0000E4r 2               ; with one RenderMark at CHAIN_DIGIT_X (constants.inc). Keeping the length at
0000E4r 2               ; MSG_CHAIN_LEN is what makes that column a constant instead of a measurement.
0000E4r 2               MsgChain:
0000E4r 2  37 37 00 1C    TileStr "~~ CHAIN x0 ~~"               ; 14 cells; the `0` is panel column 14
0000E8r 2  21 1A 22 27  
0000ECr 2  00 35 10 00  
0000F3r 2               
0000F3r 1               
0000F3r 1               ; --- PLACEHOLDER ART — replace via TMS9918-EDITOR, see data/README.md --------
0000F3r 1  00 00 00 00  TitleScreen:  .incbin "../data/screen-title-ac6502.bin"
0000F7r 1  00 00 00 00  
0000FBr 1  00 00 00 00  
0003F3r 1  7F 7F 7F 7F  PlayScreen:   .incbin "../data/screen-play-ac6502.bin"
0003F7r 1  7F 7E 7E 7E  
0003FBr 1  7E 7E 7E 7E  
0006F3r 1               TitleColor    = TitleScreen      ; No colour RAM on this machine
0006F3r 1               PlayColor     = PlayScreen
0006F3r 1               
0006F3r 1               .segment "TILES"
000000r 1               
000000r 1  00 00 00 00  Tileset:      .incbin "../data/tileset.bin"
000004r 1  00 00 00 00  
000008r 1  00 00 7E AB  
000800r 1               
000800r 1               ; =============================================================================
000800r 1               ;   Interrupt trampolines and CPU vectors
000800r 1               ; =============================================================================
000800r 1               ;   KernalInit has already pointed the RAM vectors at the default handlers, so
000800r 1               ;   bouncing through them keeps keyboard and serial input alive without this
000800r 1               ;   cartridge writing a handler of its own.
000800r 1               
000800r 1               .segment "CODE"
0011F7r 1               
0011F7r 1               IrqTrampoline:
0011F7r 1  6C 00 03       jmp (IRQ_PTR)
0011FAr 1               
0011FAr 1               NmiTrampoline:
0011FAr 1  6C 04 03       jmp (NMI_PTR)
0011FDr 1               
0011FDr 1               .segment "VECTORS"
000000r 1               
000000r 1  rr rr        .word   NmiTrampoline           ; NMI
000002r 1  rr rr        .word   CartReset               ; RESET — the cartridge entry point
000004r 1  rr rr        .word   IrqTrampoline           ; IRQ
000004r 1               
