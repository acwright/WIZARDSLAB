000100r 2               
000100r 1               .include "../src/tables.inc"
000100r 2               ; =============================================================================
000100r 2               ;   tables.inc — Wizards Lab, spec-derived lookup tables
000100r 2               ; =============================================================================
000100r 2               ;   Straight out of SPEC.md sections 5.3, 9 and 10. Hand-authored, never
000100r 2               ;   overwritten by an editor export. Included once, from the RODATA segment.
000100r 2               ;
000100r 2               ;   Score values above 99 do not fit in a byte, so every scoring table is a
000100r 2               ;   pair of parallel arrays — low BCD byte and high BCD byte — indexed by the
000100r 2               ;   same value.
000100r 2               ; =============================================================================
000100r 2               
000100r 2               ; --- Gravity, frames per row (SPEC 10.2) -------------------------------------
000100r 2               ;   Indexed by (level - 1), clamped to LEVEL_SPEED_CAP - 1.
000100r 2               ;   PAL is round(NTSC * 50/60), so wall-clock speed matches across regions.
000100r 2               
000100r 2               SpeedNTSC:
000100r 2  30 2B 26 22    .byte  48, 43, 38, 34, 30, 26, 23, 20   ; levels  1- 8   0.800s .. 0.333s
000104r 2  1E 1A 17 14  
000108r 2  11 0F 0D 0B    .byte  17, 15, 13, 11,  9,  8,  7,  6   ; levels  9-16   0.283s .. 0.100s
00010Cr 2  09 08 07 06  
000110r 2               
000110r 2               SpeedPAL:
000110r 2  28 24 20 1C    .byte  40, 36, 32, 28, 25, 22, 19, 17   ; levels  1- 8   0.800s .. 0.340s
000114r 2  19 16 13 11  
000118r 2  0E 0D 0B 09    .byte  14, 13, 11,  9,  8,  7,  6,  5   ; levels  9-16   0.280s .. 0.100s
00011Cr 2  08 07 06 05  
000120r 2               
000120r 2               ; --- Frame counts that differ by region (SPEC 5.6, 11.3, 14) -----------------
000120r 2               ;   Indexed by Region: 0 = NTSC, 1 = PAL. PAL is round(NTSC * 50/60) wherever
000120r 2               ;   the difference is worth a frame, so a piece takes the same number of
000120r 2               ;   SECONDS to lock on both machines rather than the same number of frames.
000120r 2               ;
000120r 2               ;   Two bytes each rather than one table of pairs, because every read is
000120r 2               ;   `ldx Region / lda Name,x` and a pair table would need the index doubled.
000120r 2               
000120r 2               LockDelay:                              ; SPEC 5.6
000120r 2  10 0E          .byte 16, 14
000122r 2               AreDelay:                               ; Entry delay after a cascade settles
000122r 2  0C 0A          .byte 12, 10
000124r 2               DasInitial:                             ; SPEC 11.3 — first repeat
000124r 2  0C 0A          .byte 12, 10
000126r 2               DasRepeat:                              ; ...and every one after it
000126r 2  04 03          .byte  4,  3
000128r 2               SoftDropRate:                           ; Frames per row while DOWN is held.
000128r 2  03 02          .byte  3,  2                          ;   Never used when gravity is faster.
00012Ar 2               BlinkHalf:                              ; SPEC 14 — half of the 30 / 25 frame
00012Ar 2  0F 0D          .byte 15, 13                          ;   blink period, which is what a
00012Cr 2                                                       ;   blinking field actually counts
00012Cr 2               GlowFrames:                             ; SPEC 14 — the GLOW window: the match
00012Cr 2  06 05          .byte  6,  5                          ;   glow and the bolt's beams
00012Er 2               FlashFrames:                            ; ...and what the window grows to when
00012Er 2  08 07          .byte  8,  7                          ;   a fireball fired, because its flash
000130r 2                                                       ;   is the longer of the two and both
000130r 2                                                       ;   are showing at once (constants.inc)
000130r 2               BannerFrames:                           ; SPEC 14 — how long LEVEL UP and
000130r 2  2D 26          .byte 45, 38                          ;   CHAIN xN stay in the message band
000132r 2               
000132r 2               ; --- The two removal animations (SPEC 14, Appendix A.3) ----------------------
000132r 2               ;   One ring, run in both directions. Indexed by AnimStep, which advances every
000132r 2               ;   VFX_FRAMES frames.
000132r 2               ;
000132r 2               ;   Potions, reagents, the bomb blast and the star all open OUTWARD and are
000132r 2               ;   gone in SHATTER_STEPS frames; the fourth entry only ever comes up when a
000132r 2               ;   marked prism is blipping out beside them and holding the window open, and
000132r 2               ;   it blanks the cell rather than leaving the last ring frame sitting there
000132r 2               ;   for four more frames.
000132r 2               
000132r 2               VfxShatter:
000132r 2  38 39 3A 00    .byte VFX_REMOVE1, VFX_REMOVE2, VFX_REMOVE3, TILE_EMPTY
000136r 2               
000136r 2               ;   The prism closes INWARD, and does not pass through the glow (SPEC A.3 —
000136r 2               ;   group 14 has no glyph +6). Five frames, so a step that clears one runs
000136r 2               ;   BLIP_STEPS rather than SHATTER_STEPS.
000136r 2               
000136r 2               VfxBlip:
000136r 2  74 75 39 38    .byte PRISM_BLIP, PRISM_BLIP + 1, VFX_REMOVE2, VFX_REMOVE1, FONT_DOT
00013Ar 2  34           
00013Br 2               
00013Br 2               ; --- Per-tile value for MATCH removals (SPEC 9.1) ----------------------------
00013Br 2               ;   Indexed by (chain - 1), clamped to 7.   20 50 100 200 300 400 500 600
00013Br 2               TileValueLo:
00013Br 2  20 50 00 00    .byte $20, $50, $00, $00, $00, $00, $00, $00
00013Fr 2  00 00 00 00  
000143r 2               TileValueHi:
000143r 2  00 00 01 02    .byte $00, $00, $01, $02, $03, $04, $05, $06
000147r 2  03 04 05 06  
00014Br 2               
00014Br 2               ; --- Per-tile value for EFFECT removals (SPEC 9.2) ---------------------------
00014Br 2               ;   Indexed by (chain - 1), clamped to 7.   30 60 120 240 350 450 550 650
00014Br 2               EffectValueLo:
00014Br 2  30 60 20 40    .byte $30, $60, $20, $40, $50, $50, $50, $50
00014Fr 2  50 50 50 50  
000153r 2               EffectValueHi:
000153r 2  00 00 01 02    .byte $00, $00, $01, $02, $03, $04, $05, $06
000157r 2  03 04 05 06  
00015Br 2               
00015Br 2               ; --- Run length bonus (SPEC 9.3) ---------------------------------------------
00015Br 2               ;   Indexed by (length - 3), clamped to 4.  0 100 300 600 1000
00015Br 2               LengthBonusLo:
00015Br 2  00 00 00 00    .byte $00, $00, $00, $00, $00
00015Fr 2  00           
000160r 2               LengthBonusHi:
000160r 2  00 01 03 06    .byte $00, $01, $03, $06, $10
000164r 2  10           
000165r 2               
000165r 2               ; --- Simultaneous run bonus (SPEC 9.4) ---------------------------------------
000165r 2               ;   Indexed by (runs - 1), clamped to 4.    0 200 500 1000 2000
000165r 2               MultiBonusLo:
000165r 2  00 00 00 00    .byte $00, $00, $00, $00, $00
000169r 2  00           
00016Ar 2               MultiBonusHi:
00016Ar 2  00 02 05 10    .byte $00, $02, $05, $10, $20
00016Er 2  20           
00016Fr 2               
00016Fr 2               ; --- Level -> reagent probability band (SPEC 5.3) ----------------------------
00016Fr 2               ;   Indexed by (level - 1), clamped to 15. Bands are 1-3, 4-6, 7-9, 10-12, 13+.
00016Fr 2               LevelBand:
00016Fr 2  00 00 00 01    .byte 0, 0, 0, 1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 4
000173r 2  01 01 02 02  
000177r 2  02 03 03 03  
00017Fr 2               
00017Fr 2               ; --- Chance a piece carries a reagent, out of 256 (SPEC 5.3) -----------------
00017Fr 2               ;   Indexed by band.                        15%  22%  27%  32%  36%
00017Fr 2               PSpecial:
00017Fr 2  26 38 45 52    .byte  38,  56,  69,  82,  92
000183r 2  5C           
000184r 2               
000184r 2               ; --- Reagent type, cumulative thresholds out of 256 (SPEC 5.3) ---------------
000184r 2               ;   Four thresholds per band; a roll at or above the last one is a Prism.
000184r 2               ;       roll <  [0] -> Fireball
000184r 2               ;       roll <  [1] -> Bolt
000184r 2               ;       roll <  [2] -> Bomb
000184r 2               ;       roll <  [3] -> Star
000184r 2               ;       else        -> Prism
000184r 2               ReagentThresholds:
000184r 2  4D 8A C3 EC    .byte  77, 138, 195, 236             ; band 0   levels  1-3
000188r 2  4D 8D C0 EE    .byte  77, 141, 192, 238             ; band 1   levels  4-6
00018Cr 2  52 92 C5 EE    .byte  82, 146, 197, 238             ; band 2   levels  7-9
000190r 2  4F 8D C3 EE    .byte  79, 141, 195, 238             ; band 3   levels 10-12
000194r 2  4F 8F C7 F0    .byte  79, 143, 199, 240             ; band 4   levels 13+
000198r 2               
000198r 2               ; --- Reagent trigger bonuses, indexed by glyph (SPEC 9.5) --------------------
000198r 2               ;   Glyph 0 potion and 4 star award nothing here (the star multiplies instead).
000198r 2               TriggerBonusLo:
000198r 2  00 00 00 00    .byte $00, $00, $00, $00, $00, $00, $00, $00
00019Cr 2  00 00 00 00  
0001A0r 2               TriggerBonusHi:
0001A0r 2  00 05 03 03    .byte $00, $05, $03, $03, $00, $00, $00, $00
0001A4r 2  00 00 00 00  
0001A8r 2               
0001A8r 1               .include "../src/strings.inc"
0001A8r 2               ; =============================================================================
0001A8r 2               ;   strings.inc — Wizards Lab, tile-encoded text
0001A8r 2               ; =============================================================================
0001A8r 2               ;   Strings are stored as TILE numbers, not ASCII, terminated by TEXT_END, so
0001A8r 2               ;   TextDraw is a copy with no translation at run time (see text.asm). The
0001A8r 2               ;   translation happens here instead, at assembly time, in TileStr.
0001A8r 2               ;
0001A8r 2               ;   Hand-authored, never overwritten by an editor export (D3). Included once,
0001A8r 2               ;   from each platform's RODATA segment.
0001A8r 2               ; =============================================================================
0001A8r 2               
0001A8r 2               ; -----------------------------------------------------------------------------
0001A8r 2               ;   TileChar / TileStr — ASCII source, tile bytes out
0001A8r 2               ;   The font is forty glyphs in one run from FONT_BASE:
0001A8r 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
0001A8r 2               ;   and a space is TILE_BLANK. Anything else is not in the tileset and is an
0001A8r 2               ;   assembly error rather than a wrong glyph on the screen.
0001A8r 2               ; -----------------------------------------------------------------------------
0001A8r 2               .macro TileChar c
0001A8r 2                 .if c = ' '
0001A8r 2                   .byte TILE_BLANK
0001A8r 2                 .elseif (c >= '0') .and (c <= '9')
0001A8r 2                   .byte FONT_DIGIT_0 + (c - '0')
0001A8r 2                 .elseif (c >= 'A') .and (c <= 'Z')
0001A8r 2                   .byte FONT_LETTER_A + (c - 'A')
0001A8r 2                 .elseif c = '.'
0001A8r 2                   .byte FONT_DOT
0001A8r 2                 .elseif c = 'x'
0001A8r 2                   .byte FONT_TIMES
0001A8r 2                 .elseif c = '!'
0001A8r 2                   .byte FONT_BANG
0001A8r 2                 .elseif c = '~'
0001A8r 2                   .byte FONT_TILDE
0001A8r 2                 .else
0001A8r 2                   .error "strings.inc: no tile for this character"
0001A8r 2                 .endif
0001A8r 2               .endmacro
0001A8r 2               
0001A8r 2               .macro TileStr s
0001A8r 2                 .repeat .strlen(s), I
0001A8r 2                   TileChar {.strat(s, I)}
0001A8r 2                 .endrepeat
0001A8r 2                 .byte TEXT_END
0001A8r 2               .endmacro
0001A8r 2               
0001A8r 2               ; -----------------------------------------------------------------------------
0001A8r 2               ;   Banners — SPEC 12.2, 13.3
0001A8r 2               ;   Even length, so (PANEL_W - length) / 2 centres exactly. The band is 18
0001A8r 2               ;   cells of backdrop between two shelf tiles either side, so a banner has 18
0001A8r 2               ;   to play with before it starts overwriting the artwork.
0001A8r 2               ;
0001A8r 2               ;   MsgPaused matches the play screen image byte for byte on purpose: the
0001A8r 2               ;   artwork ships with the band already reading `~~ PAUSED ~~` (see SPEC 12.1),
0001A8r 2               ;   so entering play clears the band and pausing draws this straight back.
0001A8r 2               ; -----------------------------------------------------------------------------
0001A8r 2               MsgPaused:
0001A8r 2  37 37 00 29    TileStr "~~ PAUSED ~~"                 ; 12 cells, centres at panel column 5
0001ACr 2  1A 2E 2C 1E  
0001B0r 2  1D 00 37 37  
0001B5r 2               
0001B5r 2               MsgLevelUp:
0001B5r 2  37 37 00 25    TileStr "~~ LEVEL UP ~~"               ; 14 cells, centres at panel column 4
0001B9r 2  1E 2F 1E 25  
0001BDr 2  00 2E 29 00  
0001C4r 2               
0001C4r 2               ; The chain banner carries a number, and TextDraw copies bytes rather than
0001C4r 2               ; formatting them, so the digit is a placeholder that CascadeSettle overwrites
0001C4r 2               ; with one RenderMark at CHAIN_DIGIT_X (constants.inc). Keeping the length at
0001C4r 2               ; MSG_CHAIN_LEN is what makes that column a constant instead of a measurement.
0001C4r 2               MsgChain:
0001C4r 2  37 37 00 1C    TileStr "~~ CHAIN x0 ~~"               ; 14 cells; the `0` is panel column 14
0001C8r 2  21 1A 22 27  
0001CCr 2  00 35 10 00  
0001D3r 2               
0001D3r 1               
0001D3r 1               ; --- Screen row start addresses ----------------------------------------------
0001D3r 1               RowLo:
0001D3r 1  00 28 50 78    .repeat SCR_ROWS, i
0001D7r 1  A0 C8 F0 18  
0001DBr 1  40 68 90 B8  
0001ECr 1                   .byte <(SCREEN + i * SCR_COLS)
0001ECr 1                 .endrepeat
0001ECr 1               RowHi:
0001ECr 1  04 04 04 04    .repeat SCR_ROWS, i
0001F0r 1  04 04 04 05  
0001F4r 1  05 05 05 05  
000205r 1                   .byte >(SCREEN + i * SCR_COLS)
000205r 1                 .endrepeat
000205r 1               
000205r 1               .segment "TILES"
000000r 1               
000000r 1               ; --- PLACEHOLDER ART — see data/README.md ------------------------------------
000000r 1  00 00 00 00  Tileset:      .incbin "../data/tileset.bin"
000004r 1  00 00 00 00  
000008r 1  00 00 7E AB  
000800r 1  00 00 00 00  TitleScreen:  .incbin "../data/screen-title-c64.bin"
000804r 1  00 00 00 00  
000808r 1  00 00 00 00  
000BE8r 1  01 01 01 01  TitleColor:   .incbin "../data/screen-title-c64-color.bin"
000BECr 1  01 01 01 01  
000BF0r 1  01 01 01 01  
000FD0r 1  7F 7F 7F 7F  PlayScreen:   .incbin "../data/screen-play-c64.bin"
000FD4r 1  7F 7F 7F 7F  
000FD8r 1  7F 7E 7E 7E  
0013B8r 1  02 02 02 02  PlayColor:    .incbin "../data/screen-play-c64-color.bin"
0013BCr 1  02 02 02 02  
0013C0r 1  02 02 02 02  
