000000r 1               ; =============================================================================
000000r 1               ;   Wizards Lab — Commodore 64
000000r 1               ; =============================================================================
000000r 1               ;   A 16 K cartridge: EXROM and GAME both low, so ROML ($8000-$9FFF) and ROMH
000000r 1               ;   ($A000-$BFFF) map contiguously and the whole thing is one image.
000000r 1               ;
000000r 1               ;   The C64 is the roomiest of the three targets and gets no gameplay
000000r 1               ;   advantage for it. The 22 x 23 panel is centred at (9, 1) and the nine
000000r 1               ;   columns either side are static artwork, drawn once on entering a state and
000000r 1               ;   never touched again — so they cost tiles, not cycles.
000000r 1               ;
000000r 1               ;   Its first eight colours are numerically identical to the VIC-20's eight
000000r 1               ;   hi-res colours, so the playfield colour bytes are the same numbers on both
000000r 1               ;   machines. The upper eight are for margin artwork only.
000000r 1               ;
000000r 1               ;   No sprites. Everything is tiles, on every platform, by design.
000000r 1               ;
000000r 1               ;   Built with C64-16K.cfg.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               .include "../include/c64.inc"
000000r 2               ; C64 Include File for ca65
000000r 2               ; KERNAL routines, VIC-II, SID, and CIA registers
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; KERNAL Routines
000000r 2               ;=============================================================================
000000r 2               CHROUT          = $FFD2         ; Output character in A
000000r 2               CHRIN           = $FFCF         ; Input character
000000r 2               GETIN           = $FFE4         ; Get character from keyboard buffer
000000r 2               SCNKEY          = $FF9F         ; Scan the keyboard
000000r 2               PLOT            = $FFF0         ; Read/set cursor position
000000r 2               CLRSCR          = $E544         ; Clear the screen
000000r 2               STOP            = $FFE1         ; Test the STOP key
000000r 2               SETLFS          = $FFBA         ; Set logical file parameters
000000r 2               SETNAM          = $FFBD         ; Set filename
000000r 2               LOAD            = $FFD5         ; Load from device
000000r 2               SAVE            = $FFD8         ; Save to device
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Memory
000000r 2               ;=============================================================================
000000r 2               SCREEN          = $0400         ; Screen memory (40 x 25)
000000r 2               COLRAM          = $D800         ; Color RAM
000000r 2               BASIC_START     = $0801         ; Start of BASIC program area
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; VIC-II - Video
000000r 2               ;=============================================================================
000000r 2               VIC_SPR0X       = $D000         ; Sprite 0 X position
000000r 2               VIC_SPR0Y       = $D001         ; Sprite 0 Y position
000000r 2               VIC_SPRENA      = $D015         ; Sprite enable
000000r 2               VIC_CTRL1       = $D011         ; Control register 1
000000r 2               VIC_RASTER      = $D012         ; Raster line
000000r 2               VIC_CTRL2       = $D016         ; Control register 2
000000r 2               VIC_MEMPTR      = $D018         ; Memory pointers
000000r 2               VIC_IRR         = $D019         ; Interrupt request register
000000r 2               VIC_IMR         = $D01A         ; Interrupt mask register
000000r 2               VIC_BORDERCOL   = $D020         ; Border color
000000r 2               VIC_BGCOL0      = $D021         ; Background color 0
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; SID - Sound
000000r 2               ;=============================================================================
000000r 2               SID_V1_FREQ     = $D400         ; Voice 1 frequency
000000r 2               SID_V1_CTRL     = $D404         ; Voice 1 control
000000r 2               SID_V1_AD       = $D405         ; Voice 1 attack/decay
000000r 2               SID_V1_SR       = $D406         ; Voice 1 sustain/release
000000r 2               SID_VOLUME      = $D418         ; Volume and filter select
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; CIA - I/O
000000r 2               ;=============================================================================
000000r 2               CIA1_PRA        = $DC00         ; Port A (keyboard/joystick 2)
000000r 2               CIA1_PRB        = $DC01         ; Port B (keyboard/joystick 1)
000000r 2               CIA1_ICR        = $DC0D         ; Interrupt control
000000r 2               CIA2_PRA        = $DD00         ; Port A (VIC bank select)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Colors
000000r 2               ;=============================================================================
000000r 2               COL_BLACK       = 0
000000r 2               COL_WHITE       = 1
000000r 2               COL_RED         = 2
000000r 2               COL_CYAN        = 3
000000r 2               COL_PURPLE      = 4
000000r 2               COL_GREEN       = 5
000000r 2               COL_BLUE        = 6
000000r 2               COL_YELLOW      = 7
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; PETSCII Control Codes
000000r 2               ;=============================================================================
000000r 2               CHR_CLEAR       = $93           ; Clear screen
000000r 2               CHR_HOME        = $13           ; Cursor home
000000r 2               CHR_CR          = $0D           ; Carriage return
000000r 2               CHR_WHITE       = $05           ; Set text color to white
000000r 2               
000000r 1               
000000r 1               ; --- Platform constants (hal.inc) --------------------------------------------
000000r 1               SCR_COLS         = 40
000000r 1               SCR_ROWS         = 25
000000r 1               SCR_CELLS        = 1000          ; 40 x 25
000000r 1               PANEL_X             = 9             ; (40 - 22) / 2 — exact centring
000000r 1               PANEL_Y             = 0             ; Panel is 24 rows; screen row 24 is the
000000r 1                                                   ;   one spare course of margin
000000r 1               HAS_COLOR_RAM       = 1
000000r 1               COLOR_WHITE         = 1             ; The fireball flash (SPEC 4.6)
000000r 1               
000000r 1               CHARSET_RAM         = $2000         ; 2 K, VIC bank 0
000000r 1               
000000r 1               .include "../src/constants.inc"
000000r 2               ; =============================================================================
000000r 2               ;   constants.inc — Wizards Lab, shared game constants
000000r 2               ; =============================================================================
000000r 2               ;   Everything here comes straight out of SPEC.md. If a number changes there,
000000r 2               ;   it changes here, and nowhere else. Nothing in this file is platform
000000r 2               ;   specific — see the per-platform WizardsLab.asm for PANEL_X / PANEL_Y and
000000r 2               ;   the hardware addresses.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Board (SPEC 3) ----------------------------------------------------------
000000r 2               BOARD_W             = 6         ; Playfield columns
000000r 2               BOARD_H             = 16        ; Playfield rows
000000r 2               BOARD_STRIDE        = 8         ; Bytes per row — two wasted, on purpose
000000r 2               BOARD_ROWS_ALLOC    = 20        ; 16 playfield + 2 floor sentinels + 2 reserved
000000r 2               BOARD_BYTES         = BOARD_ROWS_ALLOC * BOARD_STRIDE    ; 160
000000r 2               SPAWN_COL           = 2         ; 0-indexed, left of centre
000000r 2               MATCH_MIN           = 3         ; Run length that clears
000000r 2               
000000r 2               ; --- Tile encoding (SPEC 4) --------------------------------------------------
000000r 2               ;   tile = COLOR_BASE + (color << 3) + glyph
000000r 2               ;   The board byte IS the tile index. No translation on the way to the screen.
000000r 2               TILE_EMPTY          = $00
000000r 2               TILE_WALL           = $FF
000000r 2               COLOR_BASE          = $40
000000r 2               COLOR_MASK          = $F8       ; AND this and you have the colour key
000000r 2               GLYPH_MASK          = $07
000000r 2               WILD_BASE           = $70       ; Colour 6 — the prism
000000r 2               NUM_COLORS          = 6
000000r 2               
000000r 2               COLOR_RED           = 0
000000r 2               COLOR_YELLOW        = 1
000000r 2               COLOR_GREEN         = 2
000000r 2               COLOR_CYAN          = 3
000000r 2               COLOR_BLUE          = 4
000000r 2               COLOR_PURPLE        = 5
000000r 2               COLOR_WILD          = 6
000000r 2               
000000r 2               GLYPH_POTION        = 0
000000r 2               GLYPH_FIREBALL      = 1
000000r 2               GLYPH_BOLT          = 2
000000r 2               GLYPH_BOMB          = 3
000000r 2               GLYPH_STAR          = 4
000000r 2               GLYPH_GLOW          = 6         ; Match-flash frame. Potion colours only —
000000r 2                                               ;   WILD_BASE + GLYPH_GLOW is an arrow, not a
000000r 2                                               ;   glow, so the prism never takes this path.
000000r 2                                               ;   See PRISM_BLIP below and SPEC 4.4.
000000r 2               
000000r 2               ; --- Named tiles -------------------------------------------------------------
000000r 2               TILE_BLANK          = 0
000000r 2               TILE_BAR_H          = 1
000000r 2               TILE_BAR_V          = 2
000000r 2               TILE_COR_TL         = 3
000000r 2               TILE_COR_TR         = 4
000000r 2               TILE_COR_BL         = 5
000000r 2               TILE_COR_BR         = 6
000000r 2               TILE_WASH           = 7         ; PAUSE / dim wash, white
000000r 2               FONT_BASE           = 16        ; '0'..'9' then 'A'..'Z' then . x ! ~
000000r 2               FONT_DIGIT_0        = 16
000000r 2               FONT_LETTER_A       = 26
000000r 2               FONT_DOT            = 52        ; A CENTRED dot, not a baseline period — it is
000000r 2                                               ;   also frame 0 of the removal ring below
000000r 2               FONT_TIMES          = 53
000000r 2               FONT_BANG           = 54
000000r 2               FONT_TILDE          = 55        ; The banner ornament, ~~~LIKE THIS~~~
000000r 2               TEXT_END            = $FF       ; String terminator. Shares its value with
000000r 2                                               ;   TILE_WALL, which costs nothing: no string
000000r 2                                               ;   ever contains tile 255.
000000r 2               
000000r 2               ; The removal ring (SPEC 14). One animation, used for every removal there is:
000000r 2               ; the match shatter, the bomb blast, the star. It opens outward
000000r 2               ;
000000r 2               ;       FONT_DOT -> VFX_REMOVE1 -> VFX_REMOVE2 -> VFX_REMOVE3 -> empty
000000r 2               ;
000000r 2               ; and the prism's blip-out runs the same tiles closed inward (PRISM_BLIP).
000000r 2               VFX_REMOVE1         = 56
000000r 2               VFX_REMOVE2         = 57
000000r 2               VFX_REMOVE3         = 58
000000r 2               VFX_BEAM_H          = 59        ; The bolt's row
000000r 2               VFX_BEAM_V          = 60        ; The bolt's column
000000r 2               VFX_BEAM_CROSS      = 61        ; Drawn once, at the bolt's own cell
000000r 2               ARROW_UP            = 62        ; The title screen's controls (SPEC 13.1).
000000r 2               ARROW_DOWN          = 63        ;   Up and down live in group 7, left and
000000r 2               ARROW_LEFT          = 118       ;   right in group 14 — whichever white group
000000r 2               ARROW_RIGHT         = 119       ;   had a slot spare. Nothing indexes them.
000000r 2               
000000r 2               ; Group 14 is the prism's. Slots +0..+3 are its idle rotation and +4..+5 its
000000r 2               ; blip-out; there is no glow slot (SPEC A.3).
000000r 2               PRISM_SPIN          = WILD_BASE ; Four frames, WILD_BASE + 0..3
000000r 2               PRISM_SPIN_FRAMES   = 4
000000r 2               PRISM_BLIP          = WILD_BASE + 4     ; Two frames, then VFX_REMOVE2,
000000r 2                                                       ;   VFX_REMOVE1, FONT_DOT, empty
000000r 2               
000000r 2               ; Group 15 is the stone group: the petrified glyph set at the same offsets the
000000r 2               ; potions use, so a cell petrifies into its own shape —
000000r 2               ;
000000r 2               ;       petrified = PETRIFY_BASE + (tile & GLYPH_MASK)     for glyphs 0-4
000000r 2               ;
000000r 2               ; — and then the two tiles the margins are built from.
000000r 2               PETRIFY_BASE        = 120       ; +0 potion, +1 fireball, +2 bolt,
000000r 2                                               ;   +3 bomb, +4 star
000000r 2               TILE_RESERVED       = 125       ; Held for a sixth glyph, if one is ever added
000000r 2               TILE_SHELF          = 126       ; The shelf the panel stands on
000000r 2               TILE_BRICK          = 127       ; Brick — the margin fill
000000r 2               FRAME_DIM           = 8         ; Group 1 is group 0 byte for byte, one colour
000000r 2                                               ;   quieter, so frame_tile + FRAME_DIM is any
000000r 2                                               ;   frame piece's dim twin (SPEC A.3)
000000r 2               ART_BASE            = 128       ; Groups 16-31 — one hatch in sixteen colours,
000000r 2                                               ;   the title screen's magic field (SPEC 13.1)
000000r 2               ART_TILES           = 128
000000r 2               
000000r 2               ; --- Panel geometry (SPEC 12) ------------------------------------------------
000000r 2               ;   One 22 x 24 panel, rendered identically on all three machines. PANEL_Y is
000000r 2               ;   0 everywhere; only PANEL_X differs. The panel is vertically symmetric —
000000r 2               ;   backdrop row, band row, backdrop row, eighteen rows of frame, backdrop row,
000000r 2               ;   band row, backdrop row — which is why 24 is the height. The AC6502 is the
000000r 2               ;   exact fit; the VIC-20 clips panel row 23 off the bottom and the C64 has one
000000r 2               ;   spare screen row (24) below the panel. See SPEC 12.4.
000000r 2               PANEL_W             = 22
000000r 2               PANEL_H             = 24
000000r 2               
000000r 2               WELL_ORIGIN_X       = 1         ; Panel-relative: board (0,0) lives here
000000r 2               WELL_ORIGIN_Y       = 4
000000r 2               
000000r 2               SCORE_X             = 12        ; 7 digits, cols 12-18
000000r 2               SCORE_Y             = 5
000000r 2               HIGH_X              = 12        ; 7 digits, cols 12-18
000000r 2               HIGH_Y              = 10
000000r 2               HIGHLVL_X           = 15        ; Level the high score was set on, 2 digits;
000000r 2                                               ;   the 'L' at col 14 is in the static image
000000r 2               HIGHLVL_Y           = 11
000000r 2               LEVEL_X             = 18        ; Single column: tens above units
000000r 2               LEVEL_Y             = 17        ; Tens at LEVEL_Y, units at LEVEL_Y + 1
000000r 2               NEXT_X              = 11        ; Single tile column
000000r 2               NEXT_Y              = 16        ; Cells A, B, C at NEXT_Y, +1, +2
000000r 2               MSG_X               = 2         ; The band's OWNED cells. Panel columns 0-1 and
000000r 2               MSG_W               = 18        ;   20-21 of row 22 are shelf in the static
000000r 2               MSG_Y               = 22        ;   image and code never touches them; the
000000r 2                                               ;   banner still centres on the full PANEL_W,
000000r 2                                               ;   which lands in the same place for an
000000r 2                                               ;   even-length string (SPEC 12.2).
000000r 2               
000000r 2               MSG_CHAIN_LEN       = 14        ; `~~ CHAIN x0 ~~` (strings.inc)
000000r 2               MSG_CHAIN_DIGIT     = 10        ; Where the digit sits inside it
000000r 2               CHAIN_DIGIT_X       = (PANEL_W - MSG_CHAIN_LEN) / 2 + MSG_CHAIN_DIGIT
000000r 2                                               ; TextBanner centres on PANEL_W, so the one
000000r 2                                               ;   cell the chain banner overwrites afterwards
000000r 2                                               ;   is worked out here rather than counted off
000000r 2                                               ;   the screen
000000r 2               CHAIN_MAX_SHOWN     = 9         ; One digit. A chain past 9 says 9 rather than
000000r 2                                               ;   drawing a glyph that is not a numeral
000000r 2               
000000r 2               SCORE_DIGITS        = 7         ; Always all 7 drawn, zero padded
000000r 2               LEVEL_DIGITS        = 2         ; Always zero padded — level 5 draws "0" / "5"
000000r 2               
000000r 2               ; --- Piece and timing (SPEC 5.6, 11.3, 14) -----------------------------------
000000r 2               ;   Every duration in the game is a frame count, and most of them differ
000000r 2               ;   between NTSC and PAL so that wall-clock speed matches. Those live in
000000r 2               ;   tables.inc as two-entry tables indexed by Region, not here — a constant
000000r 2               ;   that is not one number is not a constant. The ones below are the same on
000000r 2               ;   both machines.
000000r 2               LOCK_RESET_MAX      = 4         ; Horizontal moves that may reset the lock
000000r 2                                               ;   delay, per piece. Rotation never resets it.
000000r 2               FALL_FRAMES         = 2         ; Frames a row while the pile falls into the
000000r 2                                               ;   holes a clear left (SPEC 14). The one
000000r 2                                               ;   duration in the game that is the same on
000000r 2                                               ;   both regions, because SPEC 14 says so: at
000000r 2                                               ;   two frames there is nothing to round.
000000r 2               
000000r 2               ; --- Animation (SPEC 14) -----------------------------------------------------
000000r 2               ;   A clear step animates in two windows, and everything SPEC 14 lists happens
000000r 2               ;   inside one of them. A window lasts as long as the LONGEST thing in it:
000000r 2               ;
000000r 2               ;     GLOW      the matched cells' glow glyph, the bolt's beams and the
000000r 2               ;               fireball's white flash. GlowFrames, or the longer FlashFrames
000000r 2               ;               when a fireball fired (tables.inc)
000000r 2               ;     SHATTER   the removal ring, and the prism's blip-out running alongside
000000r 2               ;               it. SHATTER_STEPS ring frames, or BLIP_STEPS when a marked
000000r 2               ;               prism is winking out with them
000000r 2               ;
000000r 2               ;   The two counts below are the SAME on both regions, for the reason
000000r 2               ;   FALL_FRAMES is: they are a tile count times VFX_FRAMES, and two frames a
000000r 2               ;   tile does not round to 1.67. SPEC 14 says so.
000000r 2               VFX_FRAMES          = 2         ; Frames each tile of a removal ring holds
000000r 2               SHATTER_STEPS       = 3         ; VFX_REMOVE1..3           — 6 frames
000000r 2               BLIP_STEPS          = 5         ; PRISM_BLIP, +1, VFX_REMOVE2, VFX_REMOVE1,
000000r 2                                               ;   FONT_DOT               — 10 frames
000000r 2               PRISM_SPIN_RATE     = 8         ; Frames per idle rotation frame (SPEC 14).
000000r 2                                               ;   The only tile on the board that moves when
000000r 2                                               ;   nothing is happening
000000r 2               PETRIFY_FRAMES      = 2         ; Frames per row of the game-over petrify
000000r 2                                               ;   (SPEC 13.4). Same number as FALL_FRAMES
000000r 2                                               ;   and not the same thing, so it is its own
000000r 2                                               ;   constant
000000r 2               TINT_NONE           = $01       ; TintColor when nothing is flashing white.
000000r 2                                               ;   Every real colour key has its low three
000000r 2                                               ;   bits clear, so $01 is a value no masked
000000r 2                                               ;   tile can equal — which is what lets the
000000r 2                                               ;   Commodores' HalPlotCell test the tint with
000000r 2                                               ;   one CMP and no separate "is anything
000000r 2                                               ;   flashing at all" branch (SPEC 4.6)
000000r 2               
000000r 2               ; --- The title screen (SPEC 13.1) --------------------------------------------
000000r 2               ;   Panel-relative, and every one of them is a measurement off the drawn
000000r 2               ;   screen rather than a choice: `make artwork` owns data/screen-title-*.bin
000000r 2               ;   and the numbers below have to agree with it. The magic field is the block
000000r 2               ;   of hatch tiles at rows 8-9 and the prompt is the ten cells that say
000000r 2               ;   PRESS FIRE, which is the one string code redraws over its own image.
000000r 2               FIELD_X             = 4         ; The magic field, 14 x 2 (SPEC 13.1)
000000r 2               FIELD_Y             = 8
000000r 2               FIELD_W             = 14
000000r 2               FIELD_CELLS         = FIELD_W * 2       ; 28, and one of them changes a frame
000000r 2               PROMPT_X            = 6         ; `PRESS FIRE`, blinked at SPEC 14's period
000000r 2               PROMPT_Y            = 11
000000r 2               PROMPT_LEN          = 10
000000r 2               
000000r 2               ; --- Game over (SPEC 13.4) ---------------------------------------------------
000000r 2               GAMEOVER_SECS       = 10        ; Seconds on the game-over screen before it
000000r 2                                               ;   returns to the title by itself. SECONDS,
000000r 2                                               ;   not frames: 600 does not fit in a byte and
000000r 2                                               ;   would not be the same wall clock on both
000000r 2                                               ;   regions if it did, so the timeout counts
000000r 2                                               ;   seconds and SecondFrames counts the frames
000000r 2                                               ;   of one (tables.inc)
000000r 2               
000000r 2               ; --- Levels (SPEC 10) --------------------------------------------------------
000000r 2               LEVEL_TILES         = 30        ; Tiles cleared per level
000000r 2               LEVEL_SPEED_CAP     = 16        ; Speed stops improving here
000000r 2               LEVEL_MAX_SHOWN     = 99
000000r 2               
000000r 2               ; --- Scoring (SPEC 9) --------------------------------------------------------
000000r 2               BONUS_FIREBALL      = $0500     ; BCD
000000r 2               BONUS_BOLT          = $0300
000000r 2               BONUS_BOMB          = $0300
000000r 2               BONUS_PRISM         = $0400
000000r 2               BONUS_LEVELUP       = $1000
000000r 2               STAR_SHIFT_CAP      = 3         ; Three doublings — x8
000000r 2               HIGH_FLASH_BLINKS   = 6         ; Half-blinks of the HIGH field when the score
000000r 2                                               ;   overtakes it (SPEC 9.8) — three dark, three
000000r 2                                               ;   lit, ending lit. At SPEC 14's 30-frame
000000r 2                                               ;   blink period that is about a second and a
000000r 2                                               ;   half, and play never stops for it.
000000r 2               SCORE_BYTES         = 4         ; 8 nibbles packed BCD; the top one stays 0,
000000r 2                                               ;   so 7 digits show and the score wraps at
000000r 2                                               ;   10,000,000.
000000r 2               HIGH_INIT_LO        = $00       ; 0010000
000000r 2               HIGH_INIT_MID       = $00
000000r 2               HIGH_INIT_HI        = $01
000000r 2               HIGH_INIT_TOP       = $00
000000r 2               
000000r 2               ; --- Audio (SPEC 16) ---------------------------------------------------------
000000r 2               ;   Twelve effects, one channel. The id IS the priority: SPEC 16 lists them
000000r 2               ;   from the quietest event to the loudest, so a request takes the channel only
000000r 2               ;   when its id is at least the id of whatever is already playing, and a
000000r 2               ;   fireball is never talked over by the blip of the move that set it off
000000r 2               ;   (audio.asm). Two things have been added above the twelve since — read on;
000000r 2               ;   the ordering rule is what decides where they go and it decides it easily.
000000r 2               SFX_MOVE            = 1
000000r 2               SFX_ROTATE          = 2
000000r 2               SFX_LOCK            = 3
000000r 2               SFX_MATCH           = 4
000000r 2               SFX_FIREBALL        = 5
000000r 2               SFX_BOLT            = 6
000000r 2               SFX_BOMB            = 7
000000r 2               SFX_STAR            = 8
000000r 2               SFX_PRISM           = 9
000000r 2               SFX_LEVELUP         = 10
000000r 2               SFX_HIGHSCORE       = 11
000000r 2               SFX_GAMEOVER        = 12
000000r 2               SFX_COUNT           = 12        ; ...which is where SPEC 16's list ends
000000r 2               
000000r 2               ;   A THIRTEENTH EVENT that SPEC 16 does not have: the game announcing itself.
000000r 2               ;   It is above the game-over run in the ordering deliberately — a game that
000000r 2               ;   has just started is the loudest thing that has ever happened on this
000000r 2               ;   machine, and nothing may talk over it, least of all the blip of the first
000000r 2               ;   move the player makes while it is still going.
000000r 2               SFX_START           = 13
000000r 2               
000000r 2               ;   ...and three that are NOT EVENTS AT ALL. The title screen's ambience is
000000r 2               ;   built out of the same step lists as everything else (tables.inc), so its
000000r 2               ;   sounds need ids to be indexed by, and the ids have to sit above the events
000000r 2               ;   because that is where the table has room. They are therefore the LOUDEST
000000r 2               ;   ids in the game, which would be exactly wrong if anything ever asked for
000000r 2               ;   one: nothing may. The ambience calls SfxBeginShifted directly, on a frame
000000r 2               ;   where the channel is already known to be silent, and never goes near
000000r 2               ;   SfxPlay (ambience.asm).
000000r 2               SFX_BUBBLE          = 14        ; A bloop rising out of the cauldron
000000r 2               SFX_GLOOP           = 15        ; ...a heavier one turning over, and falling
000000r 2               SFX_SEETHE          = 16        ; ...and the churn underneath both
000000r 2               SFX_CAULDRON        = 14        ; The first of the three. An id below this one
000000r 2                                               ;   that the ambience plays was borrowed from
000000r 2                                               ;   the game and earns the longer gap after it
000000r 2                                               ;   (AMB_GAP_EVENT); one at or above it is the
000000r 2                                               ;   cauldron and does not
000000r 2               
000000r 2               SFX_STEP_BYTES      = 3         ; frames, timbre, note (tables.inc)
000000r 2               SFX_CHAIN_SHIFT     = 2         ; Semitones the match chime rises per chain
000000r 2               SFX_CHAIN_MAX       = 8         ;   link, and the most it ever rises (SPEC 16)
000000r 2               
000000r 2               ; --- The title screen's ambience ---------------------------------------------
000000r 2               ;   Sounds of the lab rather than a tune: a cauldron bubbling away under the
000000r 2               ;   title, and every so often one of the game's own effects drifting past at
000000r 2               ;   half volume, as though an experiment two benches over just went off.
000000r 2               ;   ambience.asm sequences it; AmbTable (tables.inc) is the mix.
000000r 2               AMB_ENTRIES         = 32        ; Rows in AmbTable. A power of two, so five
000000r 2                                               ;   random bits pick one evenly with an AND.
000000r 2                                               ;   Thirty-two rather than sixteen because it
000000r 2                                               ;   is how often a borrowed effect comes up
000000r 2                                               ;   that this table tunes, and halving that
000000r 2                                               ;   without dropping any of the five means
000000r 2                                               ;   twice the rows (tables.inc)
000000r 2               AMB_SHIFT_RANGE     = 8         ; Semitones a sound may be pitched up by, so no
000000r 2                                               ;   two bubbles are the same size. Every list
000000r 2                                               ;   below is written low enough that +7 stays
000000r 2                                               ;   inside NOTE_MAX.
000000r 2               AMB_GAP_MIN         = 7         ; Frames of quiet between one sound and the
000000r 2               AMB_GAP_RANGE       = 26        ;   next: 7 to 32, rolled every time
000000r 2               AMB_GAP_EVENT       = 40        ; ...and this much more after a borrowed game
000000r 2                                               ;   effect, so the lab goes back to simmering
000000r 2                                               ;   instead of chattering
000000r 2               
000000r 2               ;   A step names a TIMBRE, not a waveform, because the two sound chips have
000000r 2               ;   nothing in common below that level. A timbre is a voice AND an octave:
000000r 2               ;   SOFT sounds an octave below the written note, BUZZ at it, BRIGHT an octave
000000r 2               ;   above. On a SID that is a waveform plus a shift of the frequency; on the
000000r 2               ;   VIC-I it is a choice between three oscillators that are already an octave
000000r 2               ;   apart, so the octave costs nothing there at all (hal.inc).
000000r 2               TIMBRE_OFF          = 0         ; Silence — the note is ignored
000000r 2               TIMBRE_SOFT         = 1         ; triangle / VIC bass       — an octave down
000000r 2               TIMBRE_BUZZ         = 2         ; sawtooth / VIC alto       — as written
000000r 2               TIMBRE_BRIGHT       = 3         ; pulse    / VIC soprano    — an octave up
000000r 2               TIMBRE_NOISE        = 4         ; noise    / VIC noise
000000r 2               TIMBRE_COUNT        = 5
000000r 2               
000000r 2               ;   Bit 7 of the same byte is a LEVEL and not a voice. Both sound chips have
000000r 2               ;   one master volume and no per-voice one, so "quieter" cannot be a property
000000r 2               ;   of a note — it is a register the platform writes on its way past, and the
000000r 2               ;   cheapest place to carry the choice is the byte already going there. It is
000000r 2               ;   set for everything the title screen plays and clear for everything the game
000000r 2               ;   plays (audio.asm, hal.inc), which is the whole of its use.
000000r 2               TIMBRE_QUIET        = $80       ; ...OR it into a timbre
000000r 2               TIMBRE_MASK         = $7F       ; ...and AND it back off, which every HalSfx
000000r 2                                               ;   does first, so a quiet TIMBRE_OFF is still
000000r 2                                               ;   silence and not a fifth voice
000000r 2               
000000r 2               ;   A note is a count of semitones above C3, so one number means the same pitch
000000r 2               ;   on both sound chips and each platform keeps its own NOTE_MAX + 1 entry
000000r 2               ;   table to turn it into register values. Write a note as an octave plus a
000000r 2               ;   degree — OCT_4 + SEMI_G is G4.
000000r 2               OCT_3               = 0
000000r 2               OCT_4               = 12
000000r 2               OCT_5               = 24
000000r 2               OCT_6               = 36
000000r 2               SEMI_C              = 0
000000r 2               SEMI_D              = 2
000000r 2               SEMI_E              = 4
000000r 2               SEMI_F              = 5
000000r 2               SEMI_G              = 7
000000r 2               SEMI_A              = 9
000000r 2               SEMI_B              = 11
000000r 2               NOTE_MAX            = 36        ; C6, the top of both note tables. A chain
000000r 2                                               ;   transposing the match chime past it is
000000r 2                                               ;   clamped rather than allowed to index off
000000r 2                                               ;   the end (audio.asm)
000000r 2               
000000r 2               ; --- Reagent probability, out of 256 (SPEC 5.3) ------------------------------
000000r 2               PSPECIAL_BANDS      = 5
000000r 2               
000000r 2               ; --- Input bitmask (SPEC 11.1) -----------------------------------------------
000000r 2               ;   Active HIGH. Each platform inverts and remaps its own hardware into this.
000000r 2               INPUT_UP            = %00000001 ; Rotate forward
000000r 2               INPUT_DOWN          = %00000010 ; Soft drop
000000r 2               INPUT_LEFT          = %00000100
000000r 2               INPUT_RIGHT         = %00001000
000000r 2               INPUT_FIRE          = %00010000 ; Rotate reverse / confirm
000000r 2               INPUT_PAUSE         = %00100000
000000r 2               INPUT_MASK          = %00111111 ; Everything the game reads. Bits 6-7 are free
000000r 2                                               ;   for a platform to use as scratch inside
000000r 2                                               ;   HalReadInput, as long as it strips them.
000000r 2               
000000r 2               ; --- Game states (SPEC 13) ---------------------------------------------------
000000r 2               STATE_TITLE         = 0
000000r 2               STATE_PLAY          = 1
000000r 2               STATE_PAUSE         = 2
000000r 2               STATE_GAMEOVER      = 3
000000r 2               
000000r 2               ; --- Play sub-states (SPEC 8) ------------------------------------------------
000000r 2               PLAY_FALLING        = 0
000000r 2               PLAY_LOCKING        = 1
000000r 2               PLAY_GLOW           = 2
000000r 2               PLAY_SHATTER        = 3
000000r 2               PLAY_GRAVITY        = 4
000000r 2               PLAY_ARE            = 5
000000r 2               
000000r 2               ; --- Buffer sizes (SPEC 17.1) ------------------------------------------------
000000r 2               MARKS_BYTES         = 16        ; One byte per row, bits 0-5
000000r 2               EFFECTQ_ENTRIES     = 48        ; ONE byte each — the board index of a pending
000000r 2               EFFECTQ_BYTES       = EFFECTQ_ENTRIES   ;   detonation, and nothing else.
000000r 2                                               ;   SPEC 8 budgeted two bytes for a packed
000000r 2                                               ;   glyph/row/column, which is a copy of what
000000r 2                                               ;   the board already holds: cells are not
000000r 2                                               ;   zeroed until step 6 and the queue is drained
000000r 2                                               ;   in step 4, so the tile is still there when
000000r 2                                               ;   the effect pops and its glyph and colour are
000000r 2                                               ;   one `lda Board,x` away. Half the RAM for
000000r 2                                               ;   nothing (SPEC 17.1).
000000r 2                                               ;   A ring keeps one slot free, so 47 pending
000000r 2                                               ;   detonations. On overflow an effect is
000000r 2                                               ;   dropped rather than growing the buffer (D6);
000000r 2                                               ;   at one reagent a piece it is not reachable.
000000r 2               DIRTY_ENTRIES       = 64        ; 3 bytes each: offset lo, offset hi, tile
000000r 2               DIRTY_BYTES         = DIRTY_ENTRIES * 3
000000r 2               DIRTY_FLUSH_MAX     = 24        ; Cells pushed to the screen per frame.
000000r 2                                               ;   MEASURED, not estimated (PLAN.md S1). A
000000r 2                                               ;   flush costs 165 cycles a cell on the
000000r 2                                               ;   AC6502 and about 132 on the Commodores, so
000000r 2                                               ;   24 cells is 3965 cycles — inside vertical
000000r 2                                               ;   blank on all three, and tightest on the
000000r 2                                               ;   AC6502 at 1 MHz, whose 70 blank lines are
000000r 2                                               ;   roughly 4450. It is also a quarter of the
000000r 2                                               ;   96-cell well, so a full redraw is exactly
000000r 2                                               ;   four frames.
000000r 2                                               ;   Overrunning vblank is not dangerous on any
000000r 2                                               ;   of the three — no VRAM write spacing is
000000r 2                                               ;   anywhere near violated (S1) — it only
000000r 2                                               ;   risks a cell landing a frame late. This is
000000r 2                                               ;   a budget, not a hardware limit.
000000r 2               
000000r 1               .include "../src/zeropage.inc"
000000r 2               ; =============================================================================
000000r 2               ;   zeropage.inc — Wizards Lab, zero page allocation
000000r 2               ; =============================================================================
000000r 2               ;   The ZEROPAGE segment is placed at $40 on every platform. That window is
000000r 2               ;   free on all three:
000000r 2               ;
000000r 2               ;     AC6502   $003A-$00FF free for user programs (6502.inc memory map)
000000r 2               ;     VIC-20   all of page zero, once the cartridge stops calling the KERNAL
000000r 2               ;     C64      all of page zero EXCEPT $00/$01, which are the processor port
000000r 2               ;
000000r 2               ;   Starting at $40 clears the C64's port bytes and the AC6502's system
000000r 2               ;   scratch with room to spare, and keeps one number in three linker configs.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               .segment "ZEROPAGE"
000000r 2               
000000r 2  xx xx        Ptr1:           .res 2      ; General pointer — free across any call boundary
000002r 2  xx xx        Ptr2:           .res 2      ; General pointer
000004r 2  xx xx        SrcPtr:         .res 2      ; Block copy source
000006r 2  xx xx        DstPtr:         .res 2      ; Block copy destination
000008r 2  xx xx        ScreenPtr:      .res 2      ; Current screen row base
00000Ar 2  xx xx        ColorPtr:       .res 2      ; Current colour RAM row base (Commodore only)
00000Cr 2               
00000Cr 2  xx           RngLo:          .res 1      ; 16-bit LFSR state — never both zero
00000Dr 2  xx           RngHi:          .res 1
00000Er 2               
00000Er 2  xx           Tmp0:           .res 1      ; Scratch. Never live across a JSR.
00000Fr 2  xx           Tmp1:           .res 1
000010r 2  xx           Tmp2:           .res 1
000011r 2  xx           Tmp3:           .res 1
000012r 2               
000012r 2               ; --- The match scanner (SPEC 6.2) --------------------------------------------
000012r 2               ;   One line of one pass at a time. The cursor is a BOARD INDEX rather than a
000012r 2               ;   row and a column, because all four passes are the same walk with a
000012r 2               ;   different step: +1 horizontal, +8 vertical, +9 diagonal, +7 anti-diagonal.
000012r 2  xx           ScanIdx:        .res 1      ; Where the cursor was when a run ended: ScanLine
000013r 2                                           ;   keeps it in X and spills it only here
000013r 2  xx           ScanStep:       .res 1      ; What to add to reach the next cell of this line
000014r 2  xx           ScanColor:      .res 1      ; Colour key of the run in progress ($FF = unset)
000015r 2  xx           ScanLen:        .res 1      ; Cells in it so far, wildcards included
000016r 2  xx           ScanEnd:        .res 1      ; Walk-back cursor while a finished run is marked
000017r 2  xx           ScanTop:        .res 1      ; Row base of the top of the pile. Every pass
000018r 2                                           ;   starts there rather than at row 0, which is
000018r 2                                           ;   most of the cost of a scan (match.asm)
000018r 2               
000018r 2               ; --- Board walks that call the renderer (SPEC 8 steps 6 and 8) ---------------
000018r 2               ;   RenderCell clobbers A, X and Y, so a walk that marks what it changes
000018r 2               ;   cannot keep its cursor in a register. GravIdx also has to survive from one
000018r 2               ;   frame to the next: a row of falling is a cursor and not a bulk enqueue,
000018r 2               ;   because a full well is more cells than the dirty ring holds (D12,
000018r 2               ;   SPEC 12.6).
000018r 2  xx           GravIdx:        .res 1      ; Cell the fall is walking up from, $FF when the
000019r 2                                           ;   row is finished
000019r 2  xx           GravMoved:      .res 1      ; Non-zero if this row of falling moved anything
00001Ar 2  xx           CellCount:      .res 1      ; Cells CascadeRemove has taken off the board
00001Br 2               
00001Br 2               ; --- Reagent effects (SPEC 7.3, SPEC 8 step 4) -------------------------------
00001Br 2               ;   EffectHit marks a cell, scores it and enqueues whatever it holds, so it
00001Br 2               ;   clobbers A, X and Y — which means a walk that offers it cells cannot keep
00001Br 2               ;   its cursor in a register either. Same reason GravIdx exists, and the same
00001Br 2               ;   reason these are not Tmp0-Tmp3: those are dead across a JSR.
00001Br 2  xx           EffectIdx:      .res 1      ; The cell the walk in progress is on
00001Cr 2  xx           EffectEnd:      .res 1      ; Where it stops. The bolt's row end, or the bomb's
00001Dr 2                                           ;   last row
00001Dr 2  xx           EffectRow:      .res 1      ; First cell of the bomb's current row
00001Er 2  xx           EffectArg:      .res 1      ; What the walk is looking for: the fireball's
00001Fr 2                                           ;   colour key, or the bomb's last column
00001Fr 2               
00001Fr 2               ; --- Animation walks (SPEC 14) -----------------------------------------------
00001Fr 2               ;   The glow, the beams and the shatter all walk MARKS and mark what they find,
00001Fr 2               ;   so their cursors cannot live in registers either — RenderMark clobbers A
00001Fr 2               ;   and X. There are two of them because the beam pass NESTS: the outer walk is
00001Fr 2               ;   over the marked cells, looking for bolts, and the inner one is over the
00001Fr 2               ;   cross each bolt draws.
00001Fr 2  xx           AnimMode:       .res 1      ; Which of the four the walk is doing
000020r 2  xx           AnimIdx:        .res 1      ; Outer cursor — the marked cell being animated
000021r 2  xx           AnimCur:        .res 1      ; Inner cursor — the beam cell being drawn
000022r 2  xx           AnimEnd:        .res 1      ; Where the inner walk stops
000023r 2  xx           AnimArg:        .res 1      ; What it is drawing, or the bolt's own column
000024r 2               
000024r 2               ; --- Render and text scratch -------------------------------------------------
000024r 2               ;   These ARE live across a JSR, unlike Tmp0-Tmp3, because text.asm calls
000024r 2               ;   RenderMark once per cell and has to remember where it is. That is safe
000024r 2               ;   only because RenderMark touches nothing here: it clobbers A, X and the
000024r 2               ;   stack and nothing else (see render.asm). Do not call anything else from a
000024r 2               ;   loop that holds one of these.
000024r 2  xx           TextCol:        .res 1      ; Panel column the next glyph goes in
000025r 2  xx           TextRow:        .res 1      ; Panel row the string is drawn on
000026r 2  xx           TextIdx:        .res 1      ; Cursor within the string, or the BCD byte index
000027r 2  xx           TextByte:       .res 1      ; The BCD byte being split into two digits
000028r 2  xx           TextSkip:       .res 1      ; Non-zero while the first high nibble is skipped
000029r 2  xx           FlushLeft:      .res 1      ; Cells left in this frame's flush budget
00002Ar 2  xx           RedrawCol:      .res 1      ; Panel column of the cell being marked. Shared by
00002Br 2                                           ;   every routine that marks a run of cells in one
00002Br 2                                           ;   column, because RenderMark clobbers X.
00002Br 2               
00002Br 1               .include "../src/ram.inc"
00002Br 2               ; =============================================================================
00002Br 2               ;   ram.inc — Wizards Lab, work RAM
00002Br 2               ; =============================================================================
00002Br 2               ;   SPEC.md section 17.1. Around 530 bytes, which is what lets the whole game
00002Br 2               ;   fit the VIC-20's 1 KB of usable work RAM — the tightest of the three
00002Br 2               ;   targets, and therefore the one the layout is designed against.
00002Br 2               ;
00002Br 2               ;   Every platform places the BSS segment somewhere different (see each
00002Br 2               ;   linker config); nothing in this file cares where.
00002Br 2               ; =============================================================================
00002Br 2               
00002Br 2               .segment "BSS"
000000r 2               
000000r 2               ; --- The board (SPEC 3.2) ----------------------------------------------------
000000r 2               ;   20 rows x 8 stride. Columns 6-7 of every row and rows 16-19 entirely are
000000r 2               ;   permanent $FF sentinels, so scans walk off the edge and stop by themselves.
000000r 2               ;   Page-align it: address(row,col) = Board + (row << 3) + col.
000000r 2               .align 256
000000r 2  xx xx xx xx  Board:          .res BOARD_BYTES
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
0000A0r 2               
0000A0r 2               ; --- Match / cascade state (SPEC 6.2, 8) -------------------------------------
0000A0r 2  xx xx xx xx  Marks:          .res MARKS_BYTES        ; One byte per row, bits 0-5 = columns
0000A4r 2  xx xx xx xx  
0000A8r 2  xx xx xx xx  
0000B0r 2  xx xx xx xx  EffectQ:        .res EFFECTQ_BYTES      ; Ring of pending reagent detonations —
0000B4r 2  xx xx xx xx  
0000B8r 2  xx xx xx xx  
0000E0r 2                                                       ;   the board INDEX of each, one byte,
0000E0r 2                                                       ;   because the tile is still on the
0000E0r 2                                                       ;   board when the entry pops
0000E0r 2                                                       ;   (constants.inc, SPEC 8)
0000E0r 2  xx           EffectQHead:    .res 1
0000E1r 2  xx           EffectQTail:    .res 1
0000E2r 2  xx           RunCount:       .res 1                  ; Runs resolved in the current step
0000E3r 2  xx           ChainStep:      .res 1                  ; 1 on the first step of a cascade
0000E4r 2  xx           StarCount:      .res 1                  ; Doublings pending, capped at 3
0000E5r 2  xx           CascadeLo:      .res 1                  ; Cascade point accumulator, packed BCD
0000E6r 2  xx           CascadeMid:     .res 1
0000E7r 2  xx           CascadeHi:      .res 1
0000E8r 2               
0000E8r 2               ; --- Animation (SPEC 14) -----------------------------------------------------
0000E8r 2  xx           AnimStep:       .res 1                  ; Ring frame the shatter is showing,
0000E9r 2                                                       ;   0 .. AnimSteps - 1
0000E9r 2  xx           AnimSteps:      .res 1                  ; SHATTER_STEPS, or BLIP_STEPS when a
0000EAr 2                                                       ;   marked prism is blipping out along
0000EAr 2                                                       ;   with the rest (constants.inc)
0000EAr 2  xx           TintColor:      .res 1                  ; Colour key currently drawn WHITE — the
0000EBr 2                                                       ;   fireball flash (SPEC 4.6) — or
0000EBr 2                                                       ;   TINT_NONE. Read by HalPlotCell on
0000EBr 2                                                       ;   the Commodores and written to the
0000EBr 2                                                       ;   VDP colour table on the AC6502;
0000EBr 2                                                       ;   HalColorFlash is the only thing that
0000EBr 2                                                       ;   sets it (hal.inc)
0000EBr 2  xx           PrismFrame:     .res 1                  ; Idle rotation frame, 0-3
0000ECr 2  xx           PrismTimer:     .res 1                  ; Frames until the next one
0000EDr 2  xx           PetrifyRow:     .res 1                  ; Board row the game-over petrify is
0000EEr 2                                                       ;   working up from, $FF when it is done
0000EEr 2  xx           TitleTimer:     .res 1                  ; Frames until the title prompt's next
0000EFr 2                                                       ;   half-blink (SPEC 13.1, 14)
0000EFr 2  xx           TitlePhase:     .res 1                  ; 0 while it is lit, 1 while it is dark
0000F0r 2               
0000F0r 2               ; --- Render (SPEC 12.6) ------------------------------------------------------
0000F0r 2               ;   A ring of DIRTY_ENTRIES cells waiting to be pushed to the screen, three
0000F0r 2               ;   bytes each: SCREEN column, SCREEN row, tile. Not a 16-bit screen offset —
0000F0r 2               ;   HalPlotCell takes a column and a row (hal.inc), and every platform reaches
0000F0r 2               ;   a cell through a per-row pointer table (SPEC 12.3), so an offset would only
0000F0r 2               ;   have to be taken apart again at the far end.
0000F0r 2               ;
0000F0r 2               ;   A ring rather than a list with a resume index, because a frame that flushes
0000F0r 2               ;   its cap leaves a remainder and the next frame's marks have to go somewhere.
0000F0r 2               ;   Head and tail are BYTE offsets into Dirty, not entry numbers, so stepping
0000F0r 2               ;   one entry is an add of 3 and never a multiply.
0000F0r 2  xx xx xx xx  Dirty:          .res DIRTY_BYTES        ; screen col, screen row, tile
0000F4r 2  xx xx xx xx  
0000F8r 2  xx xx xx xx  
0001B0r 2  xx           DirtyCount:     .res 1                  ; Entries pending, 0..DIRTY_ENTRIES
0001B1r 2  xx           DirtyHead:      .res 1                  ; Byte offset of the oldest pending
0001B2r 2  xx           DirtyTail:      .res 1                  ; Byte offset the next mark goes to
0001B3r 2  xx           RedrawIdx:      .res 1                  ; Board index RenderBoardStep resumes
0001B4r 2                                                       ;   at, or $FF when no redraw is
0001B4r 2                                                       ;   outstanding
0001B4r 2  xx           RedrawWash:     .res 1                  ; TILE_WASH while the cursor above is
0001B5r 2                                                       ;   painting the PAUSE wash rather than
0001B5r 2                                                       ;   the board, zero otherwise. Both are
0001B5r 2                                                       ;   96 cells against a 64-entry ring, so
0001B5r 2                                                       ;   both have to be a cursor (D12) and
0001B5r 2                                                       ;   one byte is cheaper than a second
0001B5r 2                                                       ;   one (SPEC 13.3)
0001B5r 2               
0001B5r 2               ; --- The falling piece (SPEC 5) ----------------------------------------------
0001B5r 2  xx           PieceCol:       .res 1
0001B6r 2  xx           PieceRow:       .res 1                  ; Row of cell A (the top cell)
0001B7r 2  xx           PieceA:         .res 1                  ; Tile bytes, top to bottom
0001B8r 2  xx           PieceB:         .res 1
0001B9r 2  xx           PieceC:         .res 1
0001BAr 2  xx           NextA:          .res 1                  ; The preview piece
0001BBr 2  xx           NextB:          .res 1
0001BCr 2  xx           NextC:          .res 1
0001BDr 2  xx           PieceDirty:     .res 1                  ; Non-zero when the three cells need
0001BEr 2                                                       ;   drawing. Not drawn on the spot,
0001BEr 2                                                       ;   because a full-board redraw may be
0001BEr 2                                                       ;   in flight and would paint over
0001BEr 2                                                       ;   them — see StatePlay (D14).
0001BEr 2               
0001BEr 2               ; --- Progress (SPEC 9, 10) ---------------------------------------------------
0001BEr 2  xx           ScoreLo:        .res 1                  ; 7 digits packed BCD, low byte first;
0001BFr 2  xx           ScoreMid:       .res 1                  ;   the top nibble of ScoreTop stays 0
0001C0r 2  xx           ScoreHi:        .res 1
0001C1r 2  xx           ScoreTop:       .res 1
0001C2r 2  xx           HighLo:         .res 1
0001C3r 2  xx           HighMid:        .res 1
0001C4r 2  xx           HighHi:         .res 1
0001C5r 2  xx           HighTop:        .res 1
0001C6r 2  xx           HighLevel:      .res 1                  ; Level the high score was set on, BCD
0001C7r 2  xx           HighOwned:      .res 1                  ; Non-zero once THIS game has taken the
0001C8r 2                                                       ;   high score. From the overtake on,
0001C8r 2                                                       ;   score and high score are equal and
0001C8r 2                                                       ;   every bank copies again, so without
0001C8r 2                                                       ;   this the one-shot fanfare and flash
0001C8r 2                                                       ;   would fire on every one (SPEC 9.8)
0001C8r 2  xx           HighFlash:      .res 1                  ; Half-blinks of the HIGH field left to
0001C9r 2                                                       ;   run. Odd = dark, even = lit, and it
0001C9r 2                                                       ;   ends at zero, so the field is always
0001C9r 2                                                       ;   left readable
0001C9r 2  xx           HighTimer:      .res 1                  ; Frames until the next half-blink
0001CAr 2  xx           Level:          .res 1                  ; Binary, 1-99
0001CBr 2  xx           TilesCleared:   .res 1                  ; Toward the next level, carries past 30
0001CCr 2               
0001CCr 2               ; --- Timers, all in frames (SPEC 14) -----------------------------------------
0001CCr 2  xx           GravityTimer:   .res 1
0001CDr 2  xx           LockTimer:      .res 1
0001CEr 2  xx           LockResets:     .res 1
0001CFr 2  xx           DasTimer:       .res 1
0001D0r 2  xx           DasDir:         .res 1
0001D1r 2  xx           AreTimer:       .res 1
0001D2r 2  xx           AnimTimer:      .res 1
0001D3r 2  xx           BannerTimer:    .res 1
0001D4r 2  xx           FrameCounter:   .res 1                  ; Free-running from power-on; seeds RNG
0001D5r 2               
0001D5r 2               ; --- Input (SPEC 11.1) -------------------------------------------------------
0001D5r 2  xx           InputNow:       .res 1
0001D6r 2  xx           InputPrev:      .res 1
0001D7r 2  xx           InputEdge:      .res 1                  ; Newly pressed this frame
0001D8r 2               
0001D8r 2               ; --- State machine (SPEC 13) -------------------------------------------------
0001D8r 2  xx           GameState:      .res 1                  ; STATE_*
0001D9r 2  xx           PlayState:      .res 1                  ; PLAY_*
0001DAr 2  xx           OverSecs:       .res 1                  ; Seconds left on the game-over screen,
0001DBr 2                                                       ;   and ZERO until the petrify has
0001DBr 2                                                       ;   finished and the banner is up. That
0001DBr 2                                                       ;   double duty is what makes the setup
0001DBr 2                                                       ;   a one-shot without a second flag:
0001DBr 2                                                       ;   the count never rests at zero,
0001DBr 2                                                       ;   because reaching it returns to the
0001DBr 2                                                       ;   title in the same frame (SPEC 13.4)
0001DBr 2  xx           OverTimer:      .res 1                  ; Frames until the next second of it
0001DCr 2  xx           Region:         .res 1                  ; 0 = NTSC, 1 = PAL
0001DDr 2  xx           NeedsRedraw:    .res 1
0001DEr 2               
0001DEr 2               ; --- Audio (SPEC 16) ---------------------------------------------------------
0001DEr 2               ;   Seven bytes, not the sixteen SPEC 17.1 budgeted — five for SPEC 16's
0001DEr 2               ;   channel and two more for the title screen's ambience. The effect data is a
0001DEr 2               ;   step list in ROM (tables.inc) and the driver is a cursor into it, so the
0001DEr 2               ;   only thing RAM has to hold is where in that list the one playing channel is.
0001DEr 2  xx           SfxRequest:     .res 1                  ; Effect asked for THIS frame, or 0.
0001DFr 2                                                       ;   Logic writes it through SfxPlay,
0001DFr 2                                                       ;   which keeps the loudest of several
0001DFr 2                                                       ;   in one frame; AudioTick consumes and
0001DFr 2                                                       ;   clears it (audio.asm)
0001DFr 2  xx           SfxId:          .res 1                  ; Effect playing, or 0 for silence. It
0001E0r 2                                                       ;   is also the priority a new request
0001E0r 2                                                       ;   has to beat (constants.inc)
0001E0r 2  xx           SfxStepIdx:     .res 1                  ; Byte offset into SfxSteps of the NEXT
0001E1r 2                                                       ;   step — which is why that table has
0001E1r 2                                                       ;   to stay under 256 bytes
0001E1r 2  xx           SfxTimer:       .res 1                  ; Frames left in the step now sounding
0001E2r 2  xx           SfxShift:       .res 1                  ; Semitones added to every note of the
0001E3r 2                                                       ;   effect playing. Zero for eleven of
0001E3r 2                                                       ;   the twelve; the match chime sets it
0001E3r 2                                                       ;   from the chain (SPEC 16)
0001E3r 2  xx           SfxLevel:       .res 1                  ; TIMBRE_QUIET while the title screen
0001E4r 2                                                       ;   owns the channel, 0 while the game
0001E4r 2                                                       ;   does. ORed into every timbre on its
0001E4r 2                                                       ;   way to the platform (audio.asm), and
0001E4r 2                                                       ;   it doubles as the flag that says the
0001E4r 2                                                       ;   ambience is running at all — the two
0001E4r 2                                                       ;   are the same fact, because the title
0001E4r 2                                                       ;   screen is the only thing that turns
0001E4r 2                                                       ;   the volume down and the only thing
0001E4r 2                                                       ;   that bubbles (ambience.asm)
0001E4r 2  xx           AmbTimer:       .res 1                  ; Frames of quiet left before the lab
0001E5r 2                                                       ;   makes its next noise. Counted only
0001E5r 2                                                       ;   on frames where nothing is sounding,
0001E5r 2                                                       ;   so a long effect does not eat the gap
0001E5r 2                                                       ;   that follows it
0001E5r 2               
0001E5r 1               .include "../src/hal.inc"
0001E5r 2               ; =============================================================================
0001E5r 2               ;   hal.inc — Wizards Lab, the platform contract
0001E5r 2               ; =============================================================================
0001E5r 2               ;   Everything in src/ is shared, unmodified, by all three machines. The only
0001E5r 2               ;   things that differ are collected here: each platform's WizardsLab.asm must
0001E5r 2               ;   define these constants and implement these eight routines, and nothing
0001E5r 2               ;   else in src/ may touch hardware directly.
0001E5r 2               ;
0001E5r 2               ;   This file declares nothing. It is the documentation for the boundary, kept
0001E5r 2               ;   next to the code it constrains so it cannot drift out of date unnoticed.
0001E5r 2               ;
0001E5r 2               ;   CONSTANTS the platform must define BEFORE including the shared sources
0001E5r 2               ;   ---------------------------------------------------------------------
0001E5r 2               ;     PANEL_X, PANEL_Y      Where the 22 x 24 panel sits on this screen.
0001E5r 2               ;                             AC6502  5, 0      VIC-20  0, 0      C64  9, 0
0001E5r 2               ;                           PANEL_Y is 0 everywhere; the VIC-20 clips panel
0001E5r 2               ;                           row 23 and the C64 has one spare row below it.
0001E5r 2               ;     SCR_COLS           32 / 22 / 40
0001E5r 2               ;     SCR_ROWS           24 / 23 / 25
0001E5r 2               ;     HAS_COLOR_RAM         1 on the Commodores, 0 on the AC6502, whose colour
0001E5r 2               ;                           lives in the VDP colour table instead.
0001E5r 2               ;
0001E5r 2               ;   ROUTINES the platform must implement
0001E5r 2               ;   ------------------------------------
0001E5r 2               ;     HalInitVideo      Bring up the video hardware: black background and
0001E5r 2               ;                       border, the correct text/tile mode, tileset in place,
0001E5r 2               ;                       colours configured, screen cleared. Called once.
0001E5r 2               ;                       In:  nothing        Out: nothing
0001E5r 2               ;
0001E5r 2               ;     HalWaitFrame      Block until the start of the next vertical blank.
0001E5r 2               ;                       Everything below is called only between frames.
0001E5r 2               ;                       In:  nothing        Out: nothing
0001E5r 2               ;
0001E5r 2               ;     HalPlotCell       Write one cell, colour included where the platform has
0001E5r 2               ;                       per-cell colour — white instead, for any tile whose
0001E5r 2               ;                       colour key is TintColor (see HalColorFlash).
0001E5r 2               ;                       In:  A = tile, X = screen column, Y = screen row
0001E5r 2               ;                       Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
0001E5r 2               ;
0001E5r 2               ;     HalBlitScreen     Draw a whole static screen from a name-table image in
0001E5r 2               ;                       ROM: SCR_COLS * SCR_ROWS bytes, row-major, plus
0001E5r 2               ;                       the matching colour image where the platform needs one.
0001E5r 2               ;                       In:  SrcPtr -> name table, Ptr1 -> colour table
0001E5r 2               ;                       Out: nothing
0001E5r 2               ;
0001E5r 2               ;     HalReadInput      Read stick and keyboard, fold both into one mask.
0001E5r 2               ;                       In:  nothing
0001E5r 2               ;                       Out: A = INPUT_* bits, ACTIVE HIGH
0001E5r 2               ;
0001E5r 2               ;     HalDetectRegion   Decide NTSC or PAL so the timing tables can be picked.
0001E5r 2               ;                       In:  nothing        Out: A = 0 NTSC, 1 PAL
0001E5r 2               ;
0001E5r 2               ;     HalColorFlash     Draw every tile of one colour white, or stop doing so.
0001E5r 2               ;                       The fireball's detonation (SPEC 4.6, 14).
0001E5r 2               ;                       In:  A = colour key ($40..$68), or TINT_NONE for none
0001E5r 2               ;                       Out: nothing.  Modifies: A, X, Y, and TintColor, which
0001E5r 2               ;                            it OWNS: nothing else may write that byte.
0001E5r 2               ;                       The platform must handle the transition, not just the
0001E5r 2               ;                       new value — a second call with a different colour puts
0001E5r 2               ;                       the first one back before lighting the second.
0001E5r 2               ;                       On the AC6502 this is ONE byte in the VDP colour table,
0001E5r 2               ;                       because a tile's colour there belongs to its 8-pattern
0001E5r 2               ;                       group and not to the cell. On the Commodores colour is
0001E5r 2               ;                       per cell, so HalPlotCell reads TintColor instead and
0001E5r 2               ;                       substitutes white for any tile of that colour as it
0001E5r 2               ;                       draws it — which also means every tinted cell has to be
0001E5r 2               ;                       re-marked, and the animation is already marking all of
0001E5r 2               ;                       them (anim.asm).
0001E5r 2               ;
0001E5r 2               ;     HalSfx            Sound ONE note, in one timbre, at one of two levels,
0001E5r 2               ;                       until told otherwise.
0001E5r 2               ;                       In:  A = TIMBRE_* (constants.inc), optionally with
0001E5r 2               ;                            TIMBRE_QUIET (bit 7) set; X = note in semitones
0001E5r 2               ;                            above C3, 0..NOTE_MAX. TIMBRE_OFF ends whatever is
0001E5r 2               ;                            sounding and ignores X.
0001E5r 2               ;                       Out: nothing.  Modifies: A, X, Y, Tmp0-Tmp2
0001E5r 2               ;                       This is NOT "play effect 4". Which effect is playing,
0001E5r 2               ;                       which step of it, how long the step lasts and what
0001E5r 2               ;                       note it is are all shared code (audio.asm), because
0001E5r 2               ;                       none of that differs between a SID and a VIC-I; what
0001E5r 2               ;                       does differ is the register values one note comes out
0001E5r 2               ;                       as, and that is the whole of this routine. SPEC 16
0001E5r 2               ;                       expected the split one level lower — a SID driver
0001E5r 2               ;                       shared by two machines and a third written twice —
0001E5r 2               ;                       and this is the same code shared by three (D22).
0001E5r 2               ;                       A timbre is a voice AND an octave: SOFT sounds an
0001E5r 2               ;                       octave below the note it is given, BUZZ at it, BRIGHT
0001E5r 2               ;                       an octave above. On a SID that is a waveform and a
0001E5r 2               ;                       shift; on the VIC-I the three tone oscillators are
0001E5r 2               ;                       already an octave apart, so it is free.
0001E5r 2               ;                       Bit 7 is neither. It is a LEVEL — quiet, for the title
0001E5r 2               ;                       screen's ambience (src/ambience.asm) — and both chips
0001E5r 2               ;                       have only a master volume to put it in, so every
0001E5r 2               ;                       implementation must MASK IT OFF (TIMBRE_MASK) before it
0001E5r 2               ;                       compares or indexes anything. A quiet TIMBRE_OFF is
0001E5r 2               ;                       silence, not a fifth voice.
0001E5r 2               ;                       A machine with no sound card must still return: the
0001E5r 2               ;                       AC6502's is optional hardware and the game plays
0001E5r 2               ;                       silently on one that has none.
0001E5r 2               ;
0001E5r 2               ;   The shared code assumes nothing about interrupts. Each platform may drive
0001E5r 2               ;   HalWaitFrame from a raster IRQ, a timer, or a status-register poll.
0001E5r 2               ; =============================================================================
0001E5r 2               
0001E5r 1               
0001E5r 1               ; =============================================================================
0001E5r 1               ;   Cartridge header — $8000
0001E5r 1               ; =============================================================================
0001E5r 1               
0001E5r 1               .segment "CARTHDR"
000000r 1               
000000r 1  rr rr        .addr ColdStart                 ; Cold start vector
000002r 1  rr rr        .addr ColdStart                 ; Warm start vector (NMI)
000004r 1  C3 C2 CD 38  .byte $C3, $C2, $CD, $38, $30   ; "CBM80" autostart signature
000008r 1  30           
000009r 1               
000009r 1               ; =============================================================================
000009r 1               ;   Entry
000009r 1               ; =============================================================================
000009r 1               
000009r 1               .segment "CODE"
000000r 1               
000000r 1               ColdStart:
000000r 1  78             sei
000001r 1  D8             cld
000002r 1  A2 FF          ldx #$FF
000004r 1  9A             txs                           ; The KERNAL jumped here before doing any of this
000005r 1               
000005r 1  A9 7F          lda #$7F                      ; Silence the CIA timer interrupt...
000007r 1  8D 0D DC       sta $DC0D
00000Ar 1  AD 0D DC       lda $DC0D                     ;   ...and acknowledge whatever was pending
00000Dr 1  A9 00          lda #$00
00000Fr 1  8D 1A D0       sta VIC_IMR                   ; No raster interrupt either — we poll instead
000012r 1               
000012r 1  20 rr rr       jsr GameInit                  ; Never returns
000015r 1               
000015r 1               ; --- Shared game code --------------------------------------------------------
000015r 1               .include "../src/main.asm"
000015r 2               ; =============================================================================
000015r 2               ;   main.asm — Wizards Lab, shared entry point and main loop
000015r 2               ; =============================================================================
000015r 2               ;   Included by every platform's WizardsLab.asm after that file has defined
000015r 2               ;   PANEL_X / PANEL_Y and its half of the HAL (see hal.inc). Nothing below
000015r 2               ;   touches hardware.
000015r 2               ;
000015r 2               ;   BUILD STATUS
000015r 2               ;   ------------
000015r 2               ;   Pieces spawn, steer, rotate, fall and lock, runs of three or more clear,
000015r 2               ;   the pile falls into the holes, chains keep going until nothing matches, all
000015r 2               ;   of it scores and ramps the level, the five reagents fire and set each other
000015r 2               ;   off, a clear glows and shatters on the frame clock instead of happening
000015r 2               ;   between two frames, the arcade loop around all of it is closed — title,
000015r 2               ;   play, pause, game over, title — and every event of SPEC 16 makes a noise
000015r 2               ;   (PLAN.md P2 to P8). The game is complete; what is left is real hardware
000015r 2               ;   (P10).
000015r 2               ; =============================================================================
000015r 2               
000015r 2               ; -----------------------------------------------------------------------------
000015r 2               ;   GameInit — one-time setup, called from the cartridge entry point
000015r 2               ; -----------------------------------------------------------------------------
000015r 2               GameInit:
000015r 2  20 rr rr       jsr HalDetectRegion
000018r 2  8D rr rr       sta Region
00001Br 2               
00001Br 2  20 rr rr       jsr HalInitVideo              ; Tiles in place, screen black and cleared
00001Er 2  20 rr rr       jsr AudioInit
000021r 2  20 rr rr       jsr RenderDirtyReset
000024r 2               
000024r 2  A9 00          lda #0
000026r 2  8D rr rr       sta FrameCounter
000029r 2  20 rr rr       jsr RngSeed                   ; A zero LFSR state sticks at zero forever, and
00002Cr 2                                               ;   BSS is not cleared on all three machines, so
00002Cr 2                                               ;   seed it once here just to get it out of that
00002Cr 2                                               ;   hole. This is NOT the game's seed — SPEC 15
00002Cr 2                                               ;   forbids a constant one, and StateTitle
00002Cr 2                                               ;   reseeds from the player's reaction time
00002Cr 2                                               ;   before the first piece is ever rolled.
00002Cr 2  A9 00          lda #0
00002Er 2  8D rr rr       sta InputNow
000031r 2  8D rr rr       sta InputPrev
000034r 2  8D rr rr       sta InputEdge
000037r 2  8D rr rr       sta TitlePhase                ; The title prompt starts lit, and the game-over
00003Ar 2  8D rr rr       sta OverSecs                  ;   screen starts un-entered. Both are BSS, and
00003Dr 2                                               ;   BSS is not cleared on all three machines.
00003Dr 2  A9 01          lda #1
00003Fr 2  8D rr rr       sta PrismTimer                ; A zero here would DEC to 255 and stall the
000042r 2                                               ;   prism's rotation for four seconds
000042r 2  A9 01          lda #TINT_NONE                ; BSS is not cleared on all three machines, and
000044r 2  8D rr rr       sta TintColor                 ;   a garbage colour key here would draw the
000047r 2                                               ;   title screen's tiles of that colour white
000047r 2                                               ;   on the Commodores. Set before anything
000047r 2                                               ;   plots a cell, not in HalColorFlash, which
000047r 2                                               ;   reads it to undo the last flash (hal.inc).
000047r 2               
000047r 2  20 rr rr       jsr ScoreHighInit             ; Once a session, before the first ScoreReset
00004Ar 2  20 rr rr       jsr ScoreReset
00004Dr 2  20 rr rr       jsr BoardClear
000050r 2               
000050r 2               .ifdef WL_DEBUG
000050r 2  20 rr rr       jsr GameStart                 ; TEMPORARY: skip the title and start playing,
000053r 2                                               ;   because a headless machine has no input
000053r 2                                               ;   attached and would sit on the title screen
000053r 2                                               ;   forever. Nothing else about the build
000053r 2                                               ;   differs any more (PLAN.md section 3).
000053r 2               .else
000053r 2                 lda #STATE_TITLE
000053r 2                 sta GameState
000053r 2                 lda #1
000053r 2                 sta NeedsRedraw
000053r 2               .endif
000053r 2                 ; falls through into GameLoop
000053r 2               
000053r 2               ; -----------------------------------------------------------------------------
000053r 2               ;   GameLoop — never returns
000053r 2               ; -----------------------------------------------------------------------------
000053r 2               GameLoop:
000053r 2  20 rr rr       jsr HalWaitFrame
000056r 2  EE rr rr       inc FrameCounter              ; Free-running from power-on; seeds the RNG
000059r 2               
000059r 2  20 rr rr       jsr RenderFlush               ; Screen writes happen in vertical blank only
00005Cr 2  20 rr rr       jsr InputPoll
00005Fr 2               
00005Fr 2  AD rr rr       lda GameState                 ; Dispatch on the current screen state
000062r 2  C9 00          cmp #STATE_TITLE
000064r 2  F0 0E          beq @Title
000066r 2  C9 01          cmp #STATE_PLAY
000068r 2  F0 10          beq @Play
00006Ar 2  C9 02          cmp #STATE_PAUSE
00006Cr 2  F0 12          beq @Pause
00006Er 2  20 rr rr       jsr StateGameOver             ; JSR, not JMP — every state handler ends in an
000071r 2  4C rr rr       jmp @Audio                    ;   RTS, and a JMP here would hand that RTS the
000074r 2                                               ;   return address of the JSR GameInit that the
000074r 2                                               ;   cart entry point never expects back. The
000074r 2                                               ;   first loss unwound the loop into GameInit;
000074r 2                                               ;   the second pulled from an empty stack.
000074r 2               
000074r 2               @Title:
000074r 2  20 rr rr       jsr StateTitle
000077r 2  4C rr rr       jmp @Audio
00007Ar 2               @Play:
00007Ar 2  20 rr rr       jsr StatePlay
00007Dr 2  4C rr rr       jmp @Audio
000080r 2               @Pause:
000080r 2  20 rr rr       jsr StatePause
000083r 2               
000083r 2               @Audio:
000083r 2  20 rr rr       jsr AudioTick
000086r 2  4C rr rr       jmp GameLoop
000089r 2               
000089r 2               ; =============================================================================
000089r 2               ;   States (SPEC 13)
000089r 2               ; =============================================================================
000089r 2               
000089r 2               ; -----------------------------------------------------------------------------
000089r 2               ;   StateTitle — blinking prompt over the drawn screen, and the magic field
000089r 2               ;   SPEC 13.1. There are no help pages: the controls are part of the screen
000089r 2               ;   image, so the only things moving here are the prompt and the field.
000089r 2               ;
000089r 2               ;   Nothing below ticks the sound. The title screen's ambience hangs off the
000089r 2               ;   silent branch of AudioTick instead, because what it is filling is the gaps
000089r 2               ;   between sounds and this routine cannot see them (ambience.asm).
000089r 2               ; -----------------------------------------------------------------------------
000089r 2               StateTitle:
000089r 2  AD rr rr       lda NeedsRedraw
00008Cr 2  F0 11          beq @Live
00008Er 2  A9 00          lda #0
000090r 2  8D rr rr       sta NeedsRedraw
000093r 2  20 rr rr       jsr DrawTitleScreen
000096r 2  20 rr rr       jsr RenderDirtyReset          ; A full blit went behind the renderer's back
000099r 2               
000099r 2  20 rr rr       jsr AnimTitleBegin            ; ...and the prompt blinks from lit, so it never
00009Cr 2                                               ;   starts a second visit dark
00009Cr 2  20 rr rr       jsr AmbienceBegin             ; ...and the lab starts murmuring under it
00009Fr 2               @Live:
00009Fr 2  20 rr rr       jsr AnimTitleField            ; The two things that move here, and the whole
0000A2r 2  20 rr rr       jsr AnimTitleBlink            ;   of the screen's animation (SPEC 13.1)
0000A5r 2               
0000A5r 2  AD rr rr       lda InputEdge
0000A8r 2  29 11          and #(INPUT_FIRE | INPUT_UP)  ; Fire, or SPACE, which the keyboards fold
0000AAr 2  F0 06          beq @Done                     ;   into UP so it can rotate in play (D15)
0000ACr 2               
0000ACr 2  20 rr rr       jsr RngSeed                   ; SPEC 15 — seed from reaction time, not a constant
0000AFr 2  20 rr rr       jsr GameStart
0000B2r 2               @Done:
0000B2r 2  60             rts
0000B3r 2               
0000B3r 2               ; -----------------------------------------------------------------------------
0000B3r 2               ;   GameStart — enter play from the title screen
0000B3r 2               ; -----------------------------------------------------------------------------
0000B3r 2               GameStart:
0000B3r 2  20 rr rr       jsr AmbienceEnd               ; The cauldron stops HERE, mid-bubble if it has
0000B6r 2                                               ;   to: the next noise this machine makes
0000B6r 2                                               ;   belongs to the game (ambience.asm)
0000B6r 2  A9 0D          lda #SFX_START                ; ...and it is this one — the game-over run
0000B8r 2  20 rr rr       jsr SfxPlay                   ;   climbed instead of fallen (tables.inc). The
0000BBr 2                                               ;   loudest id there is, so the first move the
0000BBr 2                                               ;   player makes cannot blip over it
0000BBr 2  20 rr rr       jsr ScoreReset
0000BEr 2  20 rr rr       jsr BoardClear
0000C1r 2               
0000C1r 2  A9 01          lda #1
0000C3r 2  8D rr rr       sta Level
0000C6r 2  A9 00          lda #0
0000C8r 2  8D rr rr       sta TilesCleared
0000CBr 2  8D rr rr       sta DasDir                    ; No direction is held into a new game
0000CEr 2  8D rr rr       sta DasTimer
0000D1r 2  8D rr rr       sta PieceDirty
0000D4r 2  8D rr rr       sta BannerTimer               ; Nothing from the last game is still up
0000D7r 2  8D rr rr       sta PrismFrame
0000DAr 2  A9 01          lda #1
0000DCr 2  8D rr rr       sta PrismTimer
0000DFr 2  A9 01          lda #TINT_NONE                ; ...and no colour is still flashing white, on
0000E1r 2  20 rr rr       jsr HalColorFlash             ;   a machine where that is a VDP register and
0000E4r 2                                               ;   not a byte of RAM (SPEC 4.6)
0000E4r 2               
0000E4r 2  20 rr rr       jsr DrawPlayScreen            ; The whole screen at once, behind the
0000E7r 2  20 rr rr       jsr RenderDirtyReset          ;   renderer's back — so drop anything queued
0000EAr 2                                               ;   against the screen that just went away
0000EAr 2               
0000EAr 2  20 rr rr       jsr TextBannerClear           ; The play image ships with the band reading
0000EDr 2                                               ;   `~~ PAUSED ~~` (SPEC 12.1); play owns it,
0000EDr 2                                               ;   and so does whatever the last game left in
0000EDr 2                                               ;   it — GAME OVER stays up until here
0000EDr 2  20 rr rr       jsr RenderScore               ; The panel fields are code's, not the image's
0000F0r 2  20 rr rr       jsr RenderHigh
0000F3r 2  20 rr rr       jsr RenderLevel
0000F6r 2  20 rr rr       jsr RenderBoard               ; Queued across as many frames as it takes
0000F9r 2               
0000F9r 2  20 rr rr       jsr PieceGenerateNext         ; Fill the preview...
0000FCr 2  20 rr rr       jsr PieceSpawn                ; ...then promote it and refill. The board is
0000FFr 2  20 rr rr       jsr PieceGenerateNext         ;   empty, so the spawn cannot be blocked.
000102r 2  20 rr rr       jsr RenderNext
000105r 2               
000105r 2  A9 00          lda #PLAY_FALLING
000107r 2  8D rr rr       sta PlayState
00010Ar 2  A9 01          lda #STATE_PLAY
00010Cr 2  8D rr rr       sta GameState
00010Fr 2  60             rts
000110r 2               
000110r 2               ; -----------------------------------------------------------------------------
000110r 2               ;   StatePlay — the game
000110r 2               ;   SPEC 13.2. One frame is: advance whatever the play sub-state is doing,
000110r 2               ;   then queue whatever changed. Cascades run as sub-states rather than in a
000110r 2               ;   blocking loop so animation stays on the frame clock.
000110r 2               ; -----------------------------------------------------------------------------
000110r 2               StatePlay:
000110r 2  20 rr rr       jsr ScoreFlashTick            ; SPEC 9.8 — the HIGH field blinking after an
000113r 2                                               ;   overtake. Play never stops for it, so it
000113r 2                                               ;   ticks alongside whatever the sub-state is
000113r 2                                               ;   doing rather than inside one.
000113r 2  20 rr rr       jsr AnimBannerTick            ; ...and neither does it for a banner (SPEC 14)
000116r 2  20 rr rr       jsr AnimPrismTick             ; ...nor for the one tile that moves at rest
000119r 2               
000119r 2  AD rr rr       lda InputEdge
00011Cr 2  29 20          and #INPUT_PAUSE
00011Er 2  D0 52          bne @ToPause
000120r 2               
000120r 2  AD rr rr       lda PlayState
000123r 2  C9 00          cmp #PLAY_FALLING
000125r 2  F0 17          beq @Falling
000127r 2  C9 01          cmp #PLAY_LOCKING
000129r 2  F0 19          beq @Locking
00012Br 2  C9 02          cmp #PLAY_GLOW
00012Dr 2  F0 1B          beq @Glow
00012Fr 2  C9 03          cmp #PLAY_SHATTER
000131r 2  F0 1D          beq @Shatter
000133r 2  C9 04          cmp #PLAY_GRAVITY
000135r 2  F0 1F          beq @Gravity
000137r 2  C9 05          cmp #PLAY_ARE
000139r 2  F0 21          beq @Are
00013Br 2  4C rr rr       jmp @Draw                     ; Not a state anything sets
00013Er 2               
00013Er 2               @Falling:
00013Er 2  20 rr rr       jsr PlayFalling
000141r 2  4C rr rr       jmp @Draw
000144r 2               @Locking:
000144r 2  20 rr rr       jsr PlayLocking
000147r 2  4C rr rr       jmp @Draw
00014Ar 2               @Glow:
00014Ar 2  20 rr rr       jsr PlayGlow
00014Dr 2  4C rr rr       jmp @Draw
000150r 2               @Shatter:
000150r 2  20 rr rr       jsr PlayShatter
000153r 2  4C rr rr       jmp @Draw
000156r 2               @Gravity:
000156r 2  20 rr rr       jsr PlayGravity
000159r 2  4C rr rr       jmp @Draw
00015Cr 2               @Are:
00015Cr 2  20 rr rr       jsr PlayAre
00015Fr 2               
00015Fr 2                 ; --- draw the piece, once whatever else wanted the screen has finished ----
00015Fr 2                 ;   D14. RenderBoard is a cursor that feeds the ring over several frames
00015Fr 2                 ;   (D12), so marks made while one is outstanding are drawn BEFORE the
00015Fr 2                 ;   redraw reaches those cells and are then painted over. Holding the piece
00015Fr 2                 ;   back until the redraw has finished is one byte and always right; the
00015Fr 2                 ;   alternative is a piece that vanishes for four frames after every pause.
00015Fr 2               @Draw:
00015Fr 2  AD rr rr       lda PieceDirty
000162r 2  F0 0D          beq @Done
000164r 2  AD rr rr       lda RedrawIdx
000167r 2  10 08          bpl @Done                     ; A board redraw is still in flight
000169r 2  A9 00          lda #0
00016Br 2  8D rr rr       sta PieceDirty
00016Er 2  20 rr rr       jsr RenderPiece
000171r 2               @Done:
000171r 2  60             rts
000172r 2               
000172r 2               @ToPause:
000172r 2  A9 02          lda #STATE_PAUSE
000174r 2  8D rr rr       sta GameState
000177r 2  A9 rr          lda #<MsgPaused               ; SPEC 12.2 — without this the screen does not
000179r 2  85 rr          sta Ptr1                      ;   change at all on a pause, and a paused game
00017Br 2  A9 rr          lda #>MsgPaused               ;   is indistinguishable from a hung one
00017Dr 2  85 rr          sta Ptr1+1
00017Fr 2  20 rr rr       jsr TextBanner
000182r 2  4C rr rr       jmp RenderWash                ; SPEC 13.3 — the well is covered, not blanked,
000185r 2                                               ;   so a pause cannot be used to study the
000185r 2                                               ;   board. Queued as a cursor because 96 cells
000185r 2                                               ;   do not fit the ring (render.asm, D12), and
000185r 2                                               ;   AFTER the banner, so the banner's marks are
000185r 2                                               ;   in the ring before the wash starts filling
000185r 2                                               ;   it
000185r 2               
000185r 2               ; -----------------------------------------------------------------------------
000185r 2               ;   PlayFalling — steer the piece, and drop it a row when the timer runs out
000185r 2               ;   SPEC 5.5, 5.6, 11.3
000185r 2               ; -----------------------------------------------------------------------------
000185r 2               PlayFalling:
000185r 2  20 rr rr       jsr PieceControl              ; Rotation and DAS; the result is ignored here
000188r 2                                               ;   because there is no lock delay to reset yet
000188r 2  20 rr rr       jsr PieceFallRate
00018Br 2  85 rr          sta Tmp0
00018Dr 2  AD rr rr       lda GravityTimer              ; Pressing DOWN mid-wait must shorten the wait
000190r 2  C5 rr          cmp Tmp0                      ;   in progress, not just the next one
000192r 2  90 05          bcc @Tick
000194r 2  A5 rr          lda Tmp0
000196r 2  8D rr rr       sta GravityTimer
000199r 2               @Tick:
000199r 2  CE rr rr       dec GravityTimer
00019Cr 2  D0 1E          bne @Done
00019Er 2  20 rr rr       jsr PieceStep
0001A1r 2  B0 0B          bcs @Land
0001A3r 2  20 rr rr       jsr PieceFallRate             ; ...and C tells us whose rate the row that
0001A6r 2  8D rr rr       sta GravityTimer              ;   just fell used. STA leaves it alone.
0001A9r 2  B0 11          bcs @Done
0001ABr 2  4C rr rr       jmp ScoreSoftDrop             ; SPEC 9.6 — one point, one row
0001AEr 2               
0001AEr 2               @Land:
0001AEr 2  AE rr rr       ldx Region
0001B1r 2  BD rr rr       lda LockDelay,x
0001B4r 2  8D rr rr       sta LockTimer
0001B7r 2  A9 01          lda #PLAY_LOCKING
0001B9r 2  8D rr rr       sta PlayState
0001BCr 2               @Done:
0001BCr 2  60             rts
0001BDr 2               
0001BDr 2               ; -----------------------------------------------------------------------------
0001BDr 2               ;   PlayLocking — the lock delay, and the moves that may reset it
0001BDr 2               ;   SPEC 5.6 — a horizontal move resets the delay LOCK_RESET_MAX times; after
0001BDr 2               ;   that it runs out regardless. Rotation never resets it. A move that opens a
0001BDr 2               ;   gap underneath resumes falling, and the reset count carries.
0001BDr 2               ; -----------------------------------------------------------------------------
0001BDr 2               PlayLocking:
0001BDr 2  20 rr rr       jsr PieceControl
0001C0r 2  90 13          bcc @Settled
0001C2r 2  AD rr rr       lda LockResets
0001C5r 2  C9 04          cmp #LOCK_RESET_MAX
0001C7r 2  B0 0C          bcs @Settled
0001C9r 2  EE rr rr       inc LockResets
0001CCr 2  AE rr rr       ldx Region
0001CFr 2  BD rr rr       lda LockDelay,x
0001D2r 2  8D rr rr       sta LockTimer
0001D5r 2               
0001D5r 2               @Settled:
0001D5r 2  20 rr rr       jsr PieceCanFall
0001D8r 2  90 0C          bcc @Tick
0001DAr 2  A9 00          lda #PLAY_FALLING             ; It moved over a hole — fall again. SPEC 5.6
0001DCr 2  8D rr rr       sta PlayState                 ;   says the lock counter clears here and the
0001DFr 2                                               ;   reset count does not; nothing reads
0001DFr 2                                               ;   LockTimer while falling and the next
0001DFr 2                                               ;   landing loads it fresh, so it is already
0001DFr 2                                               ;   clear in every sense that matters.
0001DFr 2  20 rr rr       jsr PieceFallRate
0001E2r 2  8D rr rr       sta GravityTimer
0001E5r 2  60             rts
0001E6r 2               
0001E6r 2               @Tick:
0001E6r 2  CE rr rr       dec LockTimer
0001E9r 2  D0 09          bne @Done
0001EBr 2  20 rr rr       jsr PieceLock
0001EEr 2  20 rr rr       jsr CascadeBegin              ; SPEC 8 — the cascade starts the moment the
0001F1r 2  4C rr rr       jmp CascadeEnter              ;   piece is board, and runs as sub-states
0001F4r 2               @Done:
0001F4r 2  60             rts
0001F5r 2               
0001F5r 2               ; -----------------------------------------------------------------------------
0001F5r 2               ;   CascadeEnter — run one cascade step and choose the sub-state after it
0001F5r 2               ;   In:  ChainStep set        Out: PlayState set.  Modifies: A, X, Y
0001F5r 2               ;   SPEC 8, D4. Called from the lock, and again from the bottom of every fall.
0001F5r 2               ;
0001F5r 2               ;   A step that marks something hands over to PLAY_GLOW, and the removal and
0001F5r 2               ;   the fall follow it twelve frames later; a step that finds nothing is where
0001F5r 2               ;   the cascade settles and the next piece is queued.
0001F5r 2               ;
0001F5r 2               ;   Nothing has come off the board when CascadeScan returns — that is the whole
0001F5r 2               ;   point of the split (cascade.asm). CascadeFinish does the taking, at the far
0001F5r 2               ;   end of PLAY_SHATTER.
0001F5r 2               ; -----------------------------------------------------------------------------
0001F5r 2               CascadeEnter:
0001F5r 2  20 rr rr       jsr CascadeScan
0001F8r 2  90 08          bcc @Settle
0001FAr 2  A9 04          lda #SFX_MATCH                ; SPEC 16 effect 4, and the chime is pitched by
0001FCr 2  20 rr rr       jsr SfxPlay                   ;   ChainStep when AudioTick starts it. A
0001FFr 2                                               ;   reagent that fired inside the scan has
0001FFr 2                                               ;   already asked for a louder sound and keeps
0001FFr 2                                               ;   the channel (audio.asm)
0001FFr 2  4C rr rr       jmp AnimGlowBegin             ; SPEC 8 step 5
000202r 2               
000202r 2               @Settle:
000202r 2  20 rr rr       jsr CascadeSettle             ; The star multiplier and the bank (SPEC 8
000205r 2                                               ;   SETTLE)
000205r 2  AD rr rr       lda ChainStep                 ; SPEC 8 SETTLE, SPEC 14 — a chain of two links
000208r 2  38             sec                           ;   or more is worth saying out loud. ChainStep
000209r 2  E9 01          sbc #1                        ;   counts the step that found nothing as well,
00020Br 2  C9 02          cmp #2                        ;   so the links are one fewer
00020Dr 2  90 03          bcc @Are
00020Fr 2  20 rr rr       jsr AnimBannerChain
000212r 2               
000212r 2               @Are:
000212r 2  AE rr rr       ldx Region
000215r 2  BD rr rr       lda AreDelay,x
000218r 2  8D rr rr       sta AreTimer
00021Br 2  A9 05          lda #PLAY_ARE
00021Dr 2  8D rr rr       sta PlayState
000220r 2  60             rts
000221r 2               
000221r 2               ; -----------------------------------------------------------------------------
000221r 2               ;   PlayGlow — hold the glow, the beams and the fireball's flash (SPEC 14)
000221r 2               ;   The window is one timer however many things are showing inside it: they all
000221r 2               ;   start together and the longest decides how long it lasts (anim.asm).
000221r 2               ; -----------------------------------------------------------------------------
000221r 2               PlayGlow:
000221r 2  CE rr rr       dec AnimTimer
000224r 2  D0 03          bne @Done
000226r 2  4C rr rr       jmp AnimGlowEnd               ; ...which starts the shatter
000229r 2               @Done:
000229r 2  60             rts
00022Ar 2               
00022Ar 2               ; -----------------------------------------------------------------------------
00022Ar 2               ;   PlayShatter — the removal ring, VFX_FRAMES a tile (SPEC 14)
00022Ar 2               ;   The board is finally emptied at the end of this, not at the start of it:
00022Ar 2               ;   every frame up to here has been drawing over cells that still hold their
00022Ar 2               ;   own tiles (cascade.asm).
00022Ar 2               ; -----------------------------------------------------------------------------
00022Ar 2               PlayShatter:
00022Ar 2  CE rr rr       dec AnimTimer
00022Dr 2  D0 20          bne @Done
00022Fr 2  EE rr rr       inc AnimStep
000232r 2  AD rr rr       lda AnimStep
000235r 2  CD rr rr       cmp AnimSteps
000238r 2  B0 0A          bcs @Over
00023Ar 2  A9 02          lda #VFX_FRAMES
00023Cr 2  8D rr rr       sta AnimTimer
00023Fr 2  A9 03          lda #ANIM_SHATTER
000241r 2  4C rr rr       jmp AnimMarked
000244r 2               
000244r 2               @Over:
000244r 2  20 rr rr       jsr CascadeFinish             ; SPEC 8 steps 6 and 7
000247r 2  20 rr rr       jsr BoardGravityBegin         ; ...and let what was above it fall
00024Ar 2  A9 04          lda #PLAY_GRAVITY
00024Cr 2  8D rr rr       sta PlayState
00024Fr 2               @Done:
00024Fr 2  60             rts
000250r 2               
000250r 2               ; -----------------------------------------------------------------------------
000250r 2               ;   PlayGravity — the pile falls into the holes the clear left
000250r 2               ;   SPEC 8 step 8, SPEC 14 — a row every FALL_FRAMES, and when a row moves
000250r 2               ;   nothing the board has settled and the next step scans it.
000250r 2               ;
000250r 2               ;   The row itself may take more than one frame: BoardGravityStep is a cursor
000250r 2               ;   that stops when the dirty ring is full (board.asm). The beat only starts
000250r 2               ;   once the row has actually landed, so a heavy board falls a little slower
000250r 2               ;   rather than losing cells off the screen.
000250r 2               ; -----------------------------------------------------------------------------
000250r 2               PlayGravity:
000250r 2  A5 rr          lda GravIdx
000252r 2  10 0C          bpl @Working                  ; A row is still coming down
000254r 2               
000254r 2  CE rr rr       dec AnimTimer
000257r 2  D0 11          bne @Done
000259r 2  A5 rr          lda GravMoved
00025Br 2  F0 0E          beq @Landed                   ; The last row moved nothing: everything is
00025Dr 2  20 rr rr       jsr BoardGravityBegin         ;   resting on something
000260r 2               
000260r 2               @Working:
000260r 2  20 rr rr       jsr BoardGravityStep
000263r 2  90 05          bcc @Done                     ; The ring filled — the rest waits for a flush
000265r 2  A9 02          lda #FALL_FRAMES              ; The row is down; hold it there for the beat
000267r 2  8D rr rr       sta AnimTimer
00026Ar 2               @Done:
00026Ar 2  60             rts
00026Br 2               
00026Br 2               @Landed:
00026Br 2  EE rr rr       inc ChainStep                 ; SPEC 8 step 9
00026Er 2  4C rr rr       jmp CascadeEnter
000271r 2               
000271r 2               ; -----------------------------------------------------------------------------
000271r 2               ;   PlayAre — the entry delay, then the next piece
000271r 2               ;   SPEC 5.6, 13.4 — a blocked spawn is game over.
000271r 2               ; -----------------------------------------------------------------------------
000271r 2               PlayAre:
000271r 2  CE rr rr       dec AreTimer
000274r 2  D0 10          bne @Done
000276r 2  20 rr rr       jsr PieceSpawn
000279r 2  B0 0C          bcs @Over
00027Br 2  20 rr rr       jsr PieceGenerateNext
00027Er 2  20 rr rr       jsr RenderNext
000281r 2  A9 00          lda #PLAY_FALLING
000283r 2  8D rr rr       sta PlayState
000286r 2               @Done:
000286r 2  60             rts
000287r 2               
000287r 2               @Over:
000287r 2  A9 0C          lda #SFX_GAMEOVER
000289r 2  20 rr rr       jsr SfxPlay
00028Cr 2  20 rr rr       jsr AnimPetrifyBegin          ; The well turns to stone from the floor up
00028Fr 2  A9 00          lda #0                        ;   while StateGameOver holds the input off
000291r 2  8D rr rr       sta OverSecs                  ; The screen proper has not started yet — the
000294r 2                                               ;   petrify runs first (SPEC 13.4 step 2)
000294r 2  A9 03          lda #STATE_GAMEOVER
000296r 2  8D rr rr       sta GameState
000299r 2  60             rts
00029Ar 2               
00029Ar 2               ; -----------------------------------------------------------------------------
00029Ar 2               ;   StatePause
00029Ar 2               ; -----------------------------------------------------------------------------
00029Ar 2               StatePause:
00029Ar 2  AD rr rr       lda InputEdge
00029Dr 2  29 30          and #(INPUT_PAUSE | INPUT_FIRE)
00029Fr 2  F0 17          beq @Done
0002A1r 2  A9 01          lda #STATE_PLAY
0002A3r 2  8D rr rr       sta GameState
0002A6r 2  20 rr rr       jsr TextBannerClear           ; The banner comes down...
0002A9r 2  20 rr rr       jsr RenderBoard               ; ...the board goes back up...
0002ACr 2  AD rr rr       lda PlayState                 ;   ...and the piece on top of it, once the
0002AFr 2  C9 02          cmp #PLAY_GLOW                ;   redraw has gone by (D14) — but only while
0002B1r 2  B0 05          bcs @Done                     ;   there IS one. From GLOW on up the piece is
0002B3r 2  A9 01          lda #1                        ;   in the board and PieceA-C are stale; the
0002B5r 2  8D rr rr       sta PieceDirty                ;   cascade may have taken those cells away
0002B8r 2               @Done:                          ;   entirely.
0002B8r 2  60             rts
0002B9r 2               
0002B9r 2               ; -----------------------------------------------------------------------------
0002B9r 2               ;   StateGameOver — petrify, banner, fanfare, back to the title
0002B9r 2               ;   SPEC 13.4, in its own order: the well sets to stone, THEN the band says so,
0002B9r 2               ;   and only then does the screen start counting itself out.
0002B9r 2               ;
0002B9r 2               ;   OverSecs is the phase as well as the count. It is zero for the length of
0002B9r 2               ;   the petrify and never zero afterwards, because the frame it would reach
0002B9r 2               ;   zero is the frame this state ends — so the one-shot in the middle needs no
0002B9r 2               ;   flag of its own.
0002B9r 2               ;
0002B9r 2               ;   Nothing here ticks the banner down (AnimBannerTick is StatePlay's), which
0002B9r 2               ;   is what leaves GAME OVER up for the whole ten seconds rather than the 45
0002B9r 2               ;   frames every other banner gets. GameStart clears the band on the way out.
0002B9r 2               ; -----------------------------------------------------------------------------
0002B9r 2               StateGameOver:
0002B9r 2  20 rr rr       jsr AnimPetrifyTick           ; SPEC 13.4 step 2, a row every PETRIFY_FRAMES
0002BCr 2  B0 56          bcs @Done                     ; Still setting. A press during the petrify is
0002BEr 2                                               ;   ignored rather than queued: the animation
0002BEr 2                                               ;   is the game telling the player it is over
0002BEr 2                                               ;   and skipping it reads as a dropped input.
0002BEr 2  AD rr rr       lda OverSecs
0002C1r 2  D0 2A          bne @Waiting
0002C3r 2               
0002C3r 2  20 rr rr       jsr AnimBannerOver            ; SPEC 13.4 step 3
0002C6r 2  AD rr rr       lda HighOwned                 ; Step 4 — the fanfare and the flash, but only
0002C9r 2  F0 13          beq @Start                    ;   if THIS game took the record. HighOwned is
0002CBr 2                                               ;   what says so, and ScoreReset clears it for
0002CBr 2                                               ;   the next one (score.asm, SPEC 9.8)
0002CBr 2  A9 0B          lda #SFX_HIGHSCORE
0002CDr 2  20 rr rr       jsr SfxPlay
0002D0r 2  A9 06          lda #HIGH_FLASH_BLINKS
0002D2r 2  8D rr rr       sta HighFlash
0002D5r 2  AE rr rr       ldx Region
0002D8r 2  BD rr rr       lda BlinkHalf,x
0002DBr 2  8D rr rr       sta HighTimer
0002DEr 2               @Start:
0002DEr 2  A9 0A          lda #GAMEOVER_SECS
0002E0r 2  8D rr rr       sta OverSecs
0002E3r 2  AE rr rr       ldx Region
0002E6r 2  BD rr rr       lda SecondFrames,x
0002E9r 2  8D rr rr       sta OverTimer
0002ECr 2  60             rts
0002EDr 2               
0002EDr 2               @Waiting:
0002EDr 2  20 rr rr       jsr ScoreFlashTick            ; The HIGH field blinks here for the same
0002F0r 2                                               ;   reason it does in play — nothing else is
0002F0r 2                                               ;   calling it now that StatePlay has stopped
0002F0r 2  CE rr rr       dec OverTimer
0002F3r 2  D0 0E          bne @Input
0002F5r 2  AE rr rr       ldx Region
0002F8r 2  BD rr rr       lda SecondFrames,x
0002FBr 2  8D rr rr       sta OverTimer
0002FEr 2  CE rr rr       dec OverSecs
000301r 2  F0 07          beq @ToTitle                  ; SPEC 13.4 step 5 — ten seconds, unattended
000303r 2               @Input:
000303r 2  AD rr rr       lda InputEdge
000306r 2  29 11          and #(INPUT_FIRE | INPUT_UP)  ; Fire, or SPACE (D15)
000308r 2  F0 0A          beq @Done
00030Ar 2               @ToTitle:
00030Ar 2  A9 00          lda #STATE_TITLE
00030Cr 2  8D rr rr       sta GameState
00030Fr 2  A9 01          lda #1
000311r 2  8D rr rr       sta NeedsRedraw
000314r 2               @Done:
000314r 2  60             rts
000315r 2               
000315r 2               ; =============================================================================
000315r 2               ;   Static screen drawing
000315r 2               ; =============================================================================
000315r 2               ;   The whole static layout — panel frame, labels, and the margin artwork that
000315r 2               ;   fills the screen either side of it — comes out of the editors as one
000315r 2               ;   name-table image per platform. Code only ever draws over the top of it:
000315r 2               ;   the well, the score and level digits, the preview, and the message band.
000315r 2               ;
000315r 2               ;   All six images are real. They come out of artwork/WizardsLab.tms9918 —
000315r 2               ;   the master — by way of `make artwork`. See data/README.md.
000315r 2               ; =============================================================================
000315r 2               
000315r 2               DrawTitleScreen:
000315r 2  A9 rr          lda #<TitleScreen
000317r 2  85 rr          sta SrcPtr
000319r 2  A9 rr          lda #>TitleScreen
00031Br 2  85 rr          sta SrcPtr+1
00031Dr 2  A9 rr          lda #<TitleColor
00031Fr 2  85 rr          sta Ptr1
000321r 2  A9 rr          lda #>TitleColor
000323r 2  85 rr          sta Ptr1+1
000325r 2  4C rr rr       jmp HalBlitScreen
000328r 2               
000328r 2               DrawPlayScreen:
000328r 2  A9 rr          lda #<PlayScreen
00032Ar 2  85 rr          sta SrcPtr
00032Cr 2  A9 rr          lda #>PlayScreen
00032Er 2  85 rr          sta SrcPtr+1
000330r 2  A9 rr          lda #<PlayColor
000332r 2  85 rr          sta Ptr1
000334r 2  A9 rr          lda #>PlayColor
000336r 2  85 rr          sta Ptr1+1
000338r 2  4C rr rr       jmp HalBlitScreen
00033Br 2               
00033Br 1               .include "../src/rng.asm"
00033Br 2               ; =============================================================================
00033Br 2               ;   rng.asm — Wizards Lab, random numbers
00033Br 2               ; =============================================================================
00033Br 2               ;   A 16-bit Galois LFSR with the conventional $B400 taps, which is maximal
00033Br 2               ;   length: it visits all 65535 non-zero states before repeating. Eight shifts
00033Br 2               ;   per call, one whole byte out.
00033Br 2               ;
00033Br 2               ;   Seeding matters more than the generator does. A fixed seed would deal the
00033Br 2               ;   same first three pieces every session and the game would feel dead, so the
00033Br 2               ;   seed is taken from the free-running frame counter at the moment the player
00033Br 2               ;   presses fire on the title screen — human reaction time is the entropy.
00033Br 2               ;
00033Br 2               ;   SPEC.md section 15.
00033Br 2               ; =============================================================================
00033Br 2               
00033Br 2               ; -----------------------------------------------------------------------------
00033Br 2               ;   RngSeed — seed from the frame counter
00033Br 2               ;   In:  nothing (reads FrameCounter)
00033Br 2               ;   Out: nothing.  Modifies: A
00033Br 2               ; -----------------------------------------------------------------------------
00033Br 2               RngSeed:
00033Br 2  AD rr rr       lda FrameCounter
00033Er 2  09 01          ora #$01                      ; Never let the state reach zero — it sticks
000340r 2  85 rr          sta RngLo
000342r 2  49 5A          eor #$5A                      ; Spread one byte of entropy over both halves
000344r 2  85 rr          sta RngHi
000346r 2  60             rts
000347r 2               
000347r 2               ; -----------------------------------------------------------------------------
000347r 2               ;   RngNext — next pseudo-random byte
000347r 2               ;   In:  nothing
000347r 2               ;   Out: A = random 0-255.  Modifies: A, X, flags
000347r 2               ; -----------------------------------------------------------------------------
000347r 2               RngNext:
000347r 2  A2 08          ldx #8                        ; Eight shifts give one whole output byte
000349r 2               @Bit:
000349r 2  46 rr          lsr RngHi                     ; Shift the 16-bit state right one place,
00034Br 2  66 rr          ror RngLo                     ;   the bit falling out of bit 0 lands in C
00034Dr 2  90 06          bcc @NoTap
00034Fr 2  A5 rr          lda RngHi
000351r 2  49 B4          eor #$B4                      ; Galois feedback mask $B400
000353r 2  85 rr          sta RngHi
000355r 2               @NoTap:
000355r 2  CA             dex
000356r 2  D0 F1          bne @Bit
000358r 2  A5 rr          lda RngLo
00035Ar 2  60             rts
00035Br 2               
00035Br 2               ; -----------------------------------------------------------------------------
00035Br 2               ;   RngRange — a random number below a small limit
00035Br 2               ;   In:  A = limit, 1-128
00035Br 2               ;   Out: A = 0 .. limit-1.  Modifies: A, X, Tmp0, Tmp1.  PRESERVES Y.
00035Br 2               ;
00035Br 2               ;   Not a modulo. `random % 6` throws four of the 256 outcomes into the low
00035Br 2               ;   values and leaves colours 0-3 a shade likelier than 4-5; this takes the
00035Br 2               ;   HIGH byte of (random * limit) instead, which spreads the remainder evenly
00035Br 2               ;   across the range and costs a fixed eight shifts either way.
00035Br 2               ;
00035Br 2               ;   The eight-bit multiply keeps only the high byte: the low half falls out of
00035Br 2               ;   the accumulator one bit at a time and is never wanted.
00035Br 2               ;
00035Br 2               ;   Y is preserved so a caller can loop over the three cells of a piece with
00035Br 2               ;   it (piece.asm does).
00035Br 2               ; -----------------------------------------------------------------------------
00035Br 2               RngRange:
00035Br 2  48             pha                           ; The limit — RngNext wants A
00035Cr 2  20 rr rr       jsr RngNext
00035Fr 2  85 rr          sta Tmp0                      ; The random byte
000361r 2  68             pla
000362r 2  85 rr          sta Tmp1                      ; The limit, shifted out one bit at a time
000364r 2  A9 00          lda #0
000366r 2  A2 08          ldx #8
000368r 2               @Bit:
000368r 2  46 rr          lsr Tmp1                      ; Next multiplier bit into C
00036Ar 2  90 03          bcc @NoAdd
00036Cr 2  18             clc
00036Dr 2  65 rr          adc Tmp0                      ; Partial product, carry out into C
00036Fr 2               @NoAdd:
00036Fr 2  6A             ror a                         ; Shift the accumulator down, carry in at bit 7
000370r 2  CA             dex
000371r 2  D0 F5          bne @Bit
000373r 2  60             rts
000374r 2               
000374r 1               .include "../src/input.asm"
000374r 2               ; =============================================================================
000374r 2               ;   input.asm — Wizards Lab, input conditioning
000374r 2               ; =============================================================================
000374r 2               ;   SPEC.md section 11. HalReadInput hands back one active-high mask however
000374r 2               ;   the platform likes; everything above this line works on that mask and
000374r 2               ;   never touches hardware.
000374r 2               ;
000374r 2               ;   Auto-repeat applies to LEFT and RIGHT only. Rotate does NOT repeat — up
000374r 2               ;   must be released and pressed again. That is not a preference: a repeating
000374r 2               ;   rotate makes a three-cell Columns piece impossible to aim.
000374r 2               ; =============================================================================
000374r 2               
000374r 2               ; -----------------------------------------------------------------------------
000374r 2               ;   InputPoll — read the hardware and work out what is newly pressed
000374r 2               ;   In:  nothing
000374r 2               ;   Out: InputNow, InputPrev, InputEdge updated.  Modifies: A
000374r 2               ; -----------------------------------------------------------------------------
000374r 2               InputPoll:
000374r 2  AD rr rr       lda InputNow
000377r 2  8D rr rr       sta InputPrev
00037Ar 2  20 rr rr       jsr HalReadInput
00037Dr 2  8D rr rr       sta InputNow
000380r 2  4D rr rr       eor InputPrev                 ; Bits that changed
000383r 2  2D rr rr       and InputNow                  ; ...and are now down = newly pressed
000386r 2  8D rr rr       sta InputEdge
000389r 2  60             rts
00038Ar 2               
00038Ar 2               ; -----------------------------------------------------------------------------
00038Ar 2               ;   InputShift — LEFT/RIGHT with delayed auto shift
00038Ar 2               ;   Out: A = INPUT_LEFT, INPUT_RIGHT, or 0 if no move should happen this frame.
00038Ar 2               ;        Modifies: A, X
00038Ar 2               ;   SPEC 11.3 — initial delay 12 frames NTSC / 10 PAL, then 4 / 3.
00038Ar 2               ;
00038Ar 2               ;   A fresh press fires on the same frame it arrives; the delay is what comes
00038Ar 2               ;   after it, not before it, so a tap is always exactly one column.
00038Ar 2               ;
00038Ar 2               ;   Holding both directions at once is not something a stick can do, but two
00038Ar 2               ;   keys can. LEFT wins, and it wins consistently, so the piece sits still
00038Ar 2               ;   rather than shivering between the two.
00038Ar 2               ; -----------------------------------------------------------------------------
00038Ar 2               InputShift:
00038Ar 2  AD rr rr       lda InputNow
00038Dr 2  29 04          and #INPUT_LEFT
00038Fr 2  D0 07          bne @Dir
000391r 2  AD rr rr       lda InputNow
000394r 2  29 08          and #INPUT_RIGHT
000396r 2  F0 2A          beq @None
000398r 2               
000398r 2               @Dir:
000398r 2  CD rr rr       cmp DasDir
00039Br 2  F0 10          beq @Held
00039Dr 2               
00039Dr 2  8D rr rr       sta DasDir                    ; A new direction: fire now, then wait
0003A0r 2  AE rr rr       ldx Region
0003A3r 2  BD rr rr       lda DasInitial,x
0003A6r 2  8D rr rr       sta DasTimer
0003A9r 2  AD rr rr       lda DasDir
0003ACr 2  60             rts
0003ADr 2               
0003ADr 2               @Held:
0003ADr 2  CE rr rr       dec DasTimer                  ; Always loaded non-zero, so this cannot wrap
0003B0r 2  D0 0D          bne @Wait
0003B2r 2  AE rr rr       ldx Region
0003B5r 2  BD rr rr       lda DasRepeat,x
0003B8r 2  8D rr rr       sta DasTimer
0003BBr 2  AD rr rr       lda DasDir
0003BEr 2  60             rts
0003BFr 2               
0003BFr 2               @Wait:
0003BFr 2  A9 00          lda #0
0003C1r 2  60             rts
0003C2r 2               
0003C2r 2               @None:
0003C2r 2  8D rr rr       sta DasDir                    ; A is already 0 — release, so the next press
0003C5r 2  60             rts                           ;   counts as fresh
0003C6r 2               
0003C6r 1               .include "../src/board.asm"
0003C6r 2               ; =============================================================================
0003C6r 2               ;   board.asm — Wizards Lab, the playfield
0003C6r 2               ; =============================================================================
0003C6r 2               ;   SPEC.md section 3. The board is 20 rows of 8 bytes, page-aligned, with
0003C6r 2               ;   columns 6-7 and rows 16-19 held permanently at $FF. Those sentinels are
0003C6r 2               ;   what let every scan in match.asm run without a bounds check.
0003C6r 2               ;
0003C6r 2               ;   address(row, col) = Board + (row << 3) + col
0003C6r 2               ; =============================================================================
0003C6r 2               
0003C6r 2               ; -----------------------------------------------------------------------------
0003C6r 2               ;   BoardClear — empty the playfield and lay the sentinels back down
0003C6r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X
0003C6r 2               ;
0003C6r 2               ;   Walls first over the whole 160 bytes, then the six playfield columns of
0003C6r 2               ;   the sixteen playfield rows punched back out to empty. Doing it in that
0003C6r 2               ;   order means the sentinels can never be forgotten: everything that is not
0003C6r 2               ;   explicitly playfield is a wall.
0003C6r 2               ;
0003C6r 2               ;   The wall loop counts UP and ends on a CPX. Counting down from 159 to a BPL
0003C6r 2               ;   looks tidier and is wrong: 159 is $9F, bit 7 already set, so the branch
0003C6r 2               ;   falls through after the first store and the other 159 bytes keep whatever
0003C6r 2               ;   the machine powered up with. That went unnoticed for a whole phase,
0003C6r 2               ;   because nothing read a sentinel until the falling piece needed a floor.
0003C6r 2               ; -----------------------------------------------------------------------------
0003C6r 2               BoardClear:
0003C6r 2  A9 FF          lda #TILE_WALL
0003C8r 2  A2 00          ldx #0
0003CAr 2               @Wall:
0003CAr 2  9D rr rr       sta Board,x
0003CDr 2  E8             inx
0003CEr 2  E0 A0          cpx #BOARD_BYTES
0003D0r 2  D0 F8          bne @Wall
0003D2r 2               
0003D2r 2  A2 00          ldx #0                        ; X walks the row bases, 0, 8, 16, ...
0003D4r 2               @Row:
0003D4r 2  A9 00          lda #TILE_EMPTY               ; Reloaded every row: the TXA below eats it
0003D6r 2  9D rr rr 9D    .repeat BOARD_W, COL
0003DAr 2  rr rr 9D rr  
0003DEr 2  rr 9D rr rr  
0003E8r 2                   sta Board + COL, x
0003E8r 2                 .endrepeat
0003E8r 2  8A             txa
0003E9r 2  18             clc
0003EAr 2  69 08          adc #BOARD_STRIDE
0003ECr 2  AA             tax
0003EDr 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
0003EFr 2  90 E3          bcc @Row
0003F1r 2  60             rts
0003F2r 2               
0003F2r 2               ; -----------------------------------------------------------------------------
0003F2r 2               ;   BoardRowPtr — point Ptr1 at the start of a board row
0003F2r 2               ;   In:  A = row        Out: Ptr1 = &Board[row][0].  Modifies: A, Ptr1
0003F2r 2               ;
0003F2r 2               ;   Board is page-aligned and 160 bytes, so row * 8 is at most 152 and the low
0003F2r 2               ;   byte can never carry into the high one.
0003F2r 2               ; -----------------------------------------------------------------------------
0003F2r 2               BoardRowPtr:
0003F2r 2  0A             asl a
0003F3r 2  0A             asl a
0003F4r 2  0A             asl a
0003F5r 2  18             clc
0003F6r 2  69 rr          adc #<Board
0003F8r 2  85 rr          sta Ptr1
0003FAr 2  A9 rr          lda #>Board
0003FCr 2  85 rr          sta Ptr1+1
0003FEr 2  60             rts
0003FFr 2               
0003FFr 2               ; -----------------------------------------------------------------------------
0003FFr 2               ;   BoardGravityBegin / BoardGravityStep — the pile falls, one row at a time
0003FFr 2               ;   SPEC 8 step 8, SPEC 14: tiles descend one row every FALL_FRAMES.
0003FFr 2               ;
0003FFr 2               ;   A row of falling is one pass over the board, bottom to top, moving every
0003FFr 2               ;   tile that has an empty cell under it down into it. Repeat until a pass
0003FFr 2               ;   moves nothing and the columns are compacted — but repeat it a row at a
0003FFr 2               ;   time, because the fall is animated and a column that dropped four rows in
0003FFr 2               ;   one frame would read as a teleport.
0003FFr 2               ;
0003FFr 2               ;   Walking BOTTOM TO TOP is what makes a whole column fall together rather
0003FFr 2               ;   than one tile a frame: by the time the pass reaches a tile, the tile below
0003FFr 2               ;   it has already moved and left the gap.
0003FFr 2               ;
0003FFr 2               ;   The pass is a CURSOR, not a loop that runs to completion (D12, SPEC 12.6).
0003FFr 2               ;   Sixty tiles falling is a hundred-odd changed cells and the dirty ring holds
0003FFr 2               ;   64, so the pass stops when the ring is full and picks up where it stopped
0003FFr 2               ;   next frame. Nothing is dropped and the board is a legal board at every
0003FFr 2               ;   point it stops — one frame's worth of columns has fallen a row and the
0003FFr 2               ;   rest has not, which is a stagger nobody can see.
0003FFr 2               ;
0003FFr 2               ;   The two sentinel columns need no special case: a wall's "cell below" is
0003FFr 2               ;   another wall, so columns 6 and 7 never move.
0003FFr 2               ; -----------------------------------------------------------------------------
0003FFr 2               GRAV_TOP = (BOARD_H - 1) * BOARD_STRIDE - 1     ; The last cell of row 14, the
0003FFr 2                                                               ;   lowest row that can fall at
0003FFr 2                                                               ;   all. Row 15 is on the floor
0003FFr 2               BoardGravityBegin:
0003FFr 2  A9 77          lda #GRAV_TOP
000401r 2  85 rr          sta GravIdx
000403r 2  A9 00          lda #0
000405r 2  85 rr          sta GravMoved
000407r 2  60             rts
000408r 2               
000408r 2               ; -----------------------------------------------------------------------------
000408r 2               ;   BoardGravityStep — carry on with the current row of falling
000408r 2               ;   In:  nothing
000408r 2               ;   Out: C set when the row is finished; GravMoved non-zero if it moved
000408r 2               ;        anything. Modifies: A, X, Y, GravIdx, GravMoved, RedrawCol
000408r 2               ; -----------------------------------------------------------------------------
000408r 2               BoardGravityStep:
000408r 2  A5 rr          lda GravIdx
00040Ar 2  30 3F          bmi @Finished                 ; $FF — the row is already done
00040Cr 2               
00040Cr 2               @Cell:
00040Cr 2  AD rr rr       lda DirtyCount                ; Room for both cells of a move, or wait for
00040Fr 2  C9 3E          cmp #(DIRTY_ENTRIES - 2)      ;   the flush. A mark dropped here would never
000411r 2  B0 3A          bcs @Later                    ;   be marked again (D6 is survivable only
000413r 2                                               ;   because nothing that MUST land uses it)
000413r 2               
000413r 2  A6 rr          ldx GravIdx
000415r 2  BD rr rr       lda Board,x
000418r 2  F0 2D          beq @Next                     ; Nothing here to fall
00041Ar 2  BD rr rr       lda Board + BOARD_STRIDE,x
00041Dr 2  D0 28          bne @Next                     ; Something under it — a tile, or the floor
00041Fr 2               
00041Fr 2  BD rr rr       lda Board,x                   ; Move it down one row
000422r 2  9D rr rr       sta Board + BOARD_STRIDE,x
000425r 2  A9 00          lda #TILE_EMPTY
000427r 2  9D rr rr       sta Board,x
00042Ar 2  E6 rr          inc GravMoved
00042Cr 2               
00042Cr 2  A5 rr          lda GravIdx                   ; The cell it LEFT only needs redrawing if it
00042Er 2  C9 08          cmp #BOARD_STRIDE             ;   is going to stay empty. If there is a tile
000430r 2  90 07          bcc @Vacated                  ;   above it, that tile lands here later in
000432r 2  A6 rr          ldx GravIdx                   ;   this same pass and its own arrival mark
000434r 2  BD rr rr       lda Board - BOARD_STRIDE,x    ;   covers the cell. Half the marks of a
000437r 2  D0 05          bne @Arrived                  ;   sliding column, which is what the ring
000439r 2               @Vacated:                       ;   pressure is made of.
000439r 2  A6 rr          ldx GravIdx
00043Br 2  20 rr rr       jsr RenderCell
00043Er 2               @Arrived:
00043Er 2  A5 rr          lda GravIdx
000440r 2  18             clc
000441r 2  69 08          adc #BOARD_STRIDE
000443r 2  AA             tax
000444r 2  20 rr rr       jsr RenderCell
000447r 2               
000447r 2               @Next:
000447r 2  C6 rr          dec GravIdx                   ; Down to 0, then $FF, which ends the pass —
000449r 2  10 C1          bpl @Cell                     ;   GRAV_TOP is 119, so bit 7 starts clear
00044Br 2                                               ;   (see PLAN.md section 3)
00044Br 2               @Finished:
00044Br 2  38             sec
00044Cr 2  60             rts
00044Dr 2               
00044Dr 2               @Later:
00044Dr 2  18             clc                           ; Ring full: the rest of this row waits a frame
00044Er 2  60             rts
00044Fr 2               
00044Fr 1               .include "../src/piece.asm"
00044Fr 2               ; =============================================================================
00044Fr 2               ;   piece.asm — Wizards Lab, the falling piece
00044Fr 2               ; =============================================================================
00044Fr 2               ;   SPEC.md section 5. A piece is three independently generated cells stacked
00044Fr 2               ;   vertically, A on top. At most one of the three carries a reagent, which is
00044Fr 2               ;   enforced by rolling once for the piece rather than once per cell.
00044Fr 2               ;
00044Fr 2               ;   The piece is NOT in the board while it falls. Board cells under it stay
00044Fr 2               ;   empty until PieceLock writes them, which is what makes the movement tests
00044Fr 2               ;   below a plain read of the three target cells and what lets the erase be
00044Fr 2               ;   three blanks rather than three board reads.
00044Fr 2               ;
00044Fr 2               ;   Nothing here draws. Every routine that changes where the piece is or what
00044Fr 2               ;   it holds sets PieceDirty and lets StatePlay pick the moment (D14).
00044Fr 2               ; =============================================================================
00044Fr 2               
00044Fr 2               ; -----------------------------------------------------------------------------
00044Fr 2               ;   PieceIndex — board index of the piece's top cell
00044Fr 2               ;   In:  nothing
00044Fr 2               ;   Out: A = X = PieceRow * BOARD_STRIDE + PieceCol.  Modifies: A, X
00044Fr 2               ;
00044Fr 2               ;   Cells B and C are one and two strides on from it, and the cell below C is
00044Fr 2               ;   three — which is the only address arithmetic the rest of this file needs.
00044Fr 2               ;   Row 16 and beyond is a wall row, so "below C" is always a legal read.
00044Fr 2               ; -----------------------------------------------------------------------------
00044Fr 2               PieceIndex:
00044Fr 2  AD rr rr       lda PieceRow
000452r 2  0A             asl a
000453r 2  0A             asl a
000454r 2  0A             asl a                         ; row * 8
000455r 2  18             clc
000456r 2  6D rr rr       adc PieceCol
000459r 2  AA             tax
00045Ar 2  60             rts
00045Br 2               
00045Br 2               ; -----------------------------------------------------------------------------
00045Br 2               ;   PieceGenerateNext — roll the preview piece into NextA/NextB/NextC
00045Br 2               ;   In:  nothing (reads Level)
00045Br 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0, Tmp1
00045Br 2               ;   SPEC 5.2, 5.3 — colours uniform over 0-5, then one reagent roll.
00045Br 2               ; -----------------------------------------------------------------------------
00045Br 2               PieceGenerateNext:
00045Br 2  A0 00          ldy #0                        ; RngRange preserves Y, so it can index the
00045Dr 2               @Color:                         ;   three cells across the call
00045Dr 2  A9 06          lda #NUM_COLORS
00045Fr 2  20 rr rr       jsr RngRange                  ; 0-5, uniform (SPEC 5.2)
000462r 2  0A             asl a
000463r 2  0A             asl a
000464r 2  0A             asl a                         ; colour << 3 ...
000465r 2  18             clc
000466r 2  69 40          adc #COLOR_BASE               ;   ... + base, glyph 0, so it is a potion
000468r 2  99 rr rr       sta NextA,y                   ; NextA/B/C are three consecutive bytes
00046Br 2  C8             iny
00046Cr 2  C0 03          cpy #3
00046Er 2  90 ED          bcc @Color
000470r 2               
000470r 2                 ; --- does this piece carry a reagent at all? (SPEC 5.3) -------------------
000470r 2                 ;   One roll for the whole piece, which both caps it at one reagent and
000470r 2                 ;   costs three rolls fewer than asking each cell.
000470r 2  20 rr rr       jsr RngNext
000473r 2  85 rr          sta Tmp0                      ; The roll. Nothing below calls out until it
000475r 2                                               ;   has been compared, so Tmp0 is safe.
000475r 2  AE rr rr       ldx Level
000478r 2  CA             dex                           ; LevelBand is indexed by level - 1 ...
000479r 2  E0 10          cpx #16
00047Br 2  90 02          bcc @Band
00047Dr 2  A2 0F          ldx #15                       ;   ... and clamped: band 4 is "13 and up"
00047Fr 2               @Band:
00047Fr 2  BD rr rr       lda LevelBand,x
000482r 2  AA             tax                           ; X = band 0-4
000483r 2  A5 rr          lda Tmp0
000485r 2  DD rr rr       cmp PSpecial,x                ; C clear = the roll came in under the chance
000488r 2  B0 2E          bcs @Done
00048Ar 2               
00048Ar 2                 ; --- which cell, and which reagent ----------------------------------------
00048Ar 2  8A             txa
00048Br 2  48             pha                           ; The band, across the cell roll
00048Cr 2  A9 03          lda #3
00048Er 2  20 rr rr       jsr RngRange                  ; 0, 1 or 2 — uniform over A, B and C
000491r 2  A8             tay                           ; Y survives the type roll below
000492r 2  68             pla
000493r 2  0A             asl a
000494r 2  0A             asl a                         ; band * 4 — ReagentThresholds is four
000495r 2  48             pha                           ;   thresholds per band
000496r 2  20 rr rr       jsr RngNext
000499r 2  85 rr          sta Tmp0                      ; The type roll
00049Br 2  68             pla
00049Cr 2  AA             tax
00049Dr 2  A5 rr          lda Tmp0
00049Fr 2               
00049Fr 2  DD rr rr       cmp ReagentThresholds+0,x     ; The cumulative-weight compare chain SPEC 5.3
0004A2r 2  90 15          bcc @Fireball                 ;   recommends over a 1280-byte lookup
0004A4r 2  DD rr rr       cmp ReagentThresholds+1,x
0004A7r 2  90 14          bcc @Bolt
0004A9r 2  DD rr rr       cmp ReagentThresholds+2,x
0004ACr 2  90 13          bcc @Bomb
0004AEr 2  DD rr rr       cmp ReagentThresholds+3,x
0004B1r 2  90 12          bcc @Star
0004B3r 2               
0004B3r 2  A9 70          lda #WILD_BASE                ; A Prism discards the colour it rolled and
0004B5r 2  99 rr rr       sta NextA,y                   ;   joins group 14 (SPEC 5.2)
0004B8r 2               @Done:
0004B8r 2  60             rts
0004B9r 2               
0004B9r 2               @Fireball:
0004B9r 2  A9 01          lda #GLYPH_FIREBALL
0004BBr 2  D0 0A          bne @Apply                    ; Always — every glyph below is non-zero
0004BDr 2               @Bolt:
0004BDr 2  A9 02          lda #GLYPH_BOLT
0004BFr 2  D0 06          bne @Apply
0004C1r 2               @Bomb:
0004C1r 2  A9 03          lda #GLYPH_BOMB
0004C3r 2  D0 02          bne @Apply
0004C5r 2               @Star:
0004C5r 2  A9 04          lda #GLYPH_STAR
0004C7r 2               @Apply:
0004C7r 2  19 rr rr       ora NextA,y                   ; The cell's glyph nibble is 0, so an ORA sets
0004CAr 2  99 rr rr       sta NextA,y                   ;   the reagent and keeps the rolled colour
0004CDr 2  60             rts
0004CEr 2               
0004CEr 2               ; -----------------------------------------------------------------------------
0004CEr 2               ;   PieceSpawn — promote the preview to the falling piece
0004CEr 2               ;   In:  nothing
0004CEr 2               ;   Out: C set if the spawn cells were occupied (game over)
0004CEr 2               ;        Modifies: A, X
0004CEr 2               ;   SPEC 5.4 — spawn column SPAWN_COL, rows 0-2, visible immediately.
0004CEr 2               ;
0004CEr 2               ;   The preview is copied whether or not the spawn succeeds; on a blocked
0004CEr 2               ;   spawn nothing looks at the piece again.
0004CEr 2               ; -----------------------------------------------------------------------------
0004CEr 2               PieceSpawn:
0004CEr 2  AD rr rr       lda NextA
0004D1r 2  8D rr rr       sta PieceA
0004D4r 2  AD rr rr       lda NextB
0004D7r 2  8D rr rr       sta PieceB
0004DAr 2  AD rr rr       lda NextC
0004DDr 2  8D rr rr       sta PieceC
0004E0r 2               
0004E0r 2  A9 02          lda #SPAWN_COL
0004E2r 2  8D rr rr       sta PieceCol
0004E5r 2  A9 00          lda #0
0004E7r 2  8D rr rr       sta PieceRow
0004EAr 2  8D rr rr       sta LockTimer
0004EDr 2  8D rr rr       sta LockResets                ; The reset allowance is per piece (SPEC 5.6)
0004F0r 2               
0004F0r 2  AD rr rr       lda Board + 0 * BOARD_STRIDE + SPAWN_COL
0004F3r 2  0D rr rr       ora Board + 1 * BOARD_STRIDE + SPAWN_COL
0004F6r 2  0D rr rr       ora Board + 2 * BOARD_STRIDE + SPAWN_COL
0004F9r 2  D0 0D          bne @Blocked
0004FBr 2               
0004FBr 2  20 rr rr       jsr ScoreGravity
0004FEr 2  8D rr rr       sta GravityTimer
000501r 2  A9 01          lda #1
000503r 2  8D rr rr       sta PieceDirty                ; Drawn immediately — there is no off-screen
000506r 2  18             clc                           ;   entry (SPEC 5.4)
000507r 2  60             rts
000508r 2               
000508r 2               @Blocked:
000508r 2  38             sec
000509r 2  60             rts
00050Ar 2               
00050Ar 2               ; -----------------------------------------------------------------------------
00050Ar 2               ;   PieceMoveLeft / PieceMoveRight — one column, if all three cells are free
00050Ar 2               ;   Out: C set if the move happened (the caller resets the lock timer).
00050Ar 2               ;        Modifies: A, X
00050Ar 2               ;   SPEC 5.5 — no wall kicks; a 1-wide piece has nothing to kick off.
00050Ar 2               ;
00050Ar 2               ;   The right edge needs no bounds check: column 6 is a permanent $FF sentinel
00050Ar 2               ;   and fails the emptiness test on its own (SPEC 3.2). The LEFT edge does,
00050Ar 2               ;   because column -1 of row 0 is the byte before a page-aligned Board and
00050Ar 2               ;   belongs to nobody.
00050Ar 2               ; -----------------------------------------------------------------------------
00050Ar 2               PieceMoveLeft:
00050Ar 2  AD rr rr       lda PieceCol
00050Dr 2  F0 18          beq @No                       ; Column 0 — there is no sentinel to the left
00050Fr 2  20 rr rr       jsr PieceIndex
000512r 2  CA             dex
000513r 2  BD rr rr       lda Board + 0 * BOARD_STRIDE,x
000516r 2  1D rr rr       ora Board + 1 * BOARD_STRIDE,x
000519r 2  1D rr rr       ora Board + 2 * BOARD_STRIDE,x
00051Cr 2  D0 09          bne @No
00051Er 2  20 rr rr       jsr RenderPieceErase
000521r 2  CE rr rr       dec PieceCol
000524r 2  4C rr rr       jmp PieceShifted
000527r 2               
000527r 2               @No:
000527r 2  18             clc
000528r 2  60             rts
000529r 2               
000529r 2               PieceMoveRight:
000529r 2  20 rr rr       jsr PieceIndex
00052Cr 2  E8             inx
00052Dr 2  BD rr rr       lda Board + 0 * BOARD_STRIDE,x
000530r 2  1D rr rr       ora Board + 1 * BOARD_STRIDE,x
000533r 2  1D rr rr       ora Board + 2 * BOARD_STRIDE,x
000536r 2  D0 09          bne @No
000538r 2  20 rr rr       jsr RenderPieceErase
00053Br 2  EE rr rr       inc PieceCol
00053Er 2  4C rr rr       jmp PieceShifted
000541r 2               @No:
000541r 2  18             clc
000542r 2  60             rts
000543r 2               
000543r 2               ; -----------------------------------------------------------------------------
000543r 2               ;   PieceShifted — a horizontal move landed (SPEC 16 effect 1)
000543r 2               ;   Out: C set.  Modifies: A
000543r 2               ;   Separate from PieceMoved because gravity goes through THAT and a row of
000543r 2               ;   falling makes no noise: the blip belongs to the player's hand, not to the
000543r 2               ;   piece changing cells.
000543r 2               ; -----------------------------------------------------------------------------
000543r 2               PieceShifted:
000543r 2  A9 01          lda #SFX_MOVE
000545r 2  20 rr rr       jsr SfxPlay
000548r 2                 ; falls through
000548r 2               
000548r 2               ; -----------------------------------------------------------------------------
000548r 2               ;   PieceMoved — mark the piece for redraw and report success
000548r 2               ;   Out: C set.  Modifies: A
000548r 2               ; -----------------------------------------------------------------------------
000548r 2               PieceMoved:
000548r 2  A9 01          lda #1
00054Ar 2  8D rr rr       sta PieceDirty
00054Dr 2  38             sec
00054Er 2  60             rts
00054Fr 2               
00054Fr 2               ; -----------------------------------------------------------------------------
00054Fr 2               ;   PieceRotate / PieceRotateBack — cycle the three cells
00054Fr 2               ;   Out: nothing.  Modifies: A, X
00054Fr 2               ;   SPEC 5.5 — (A,B,C) -> (B,C,A) forward, (C,A,B) back. Always succeeds: the
00054Fr 2               ;   footprint never changes, so there is nothing to test and nothing to erase.
00054Fr 2               ;   Rotation does not reset the lock delay (SPEC 5.6).
00054Fr 2               ; -----------------------------------------------------------------------------
00054Fr 2               PieceRotate:
00054Fr 2  AD rr rr       lda PieceA
000552r 2  AE rr rr       ldx PieceB
000555r 2  8E rr rr       stx PieceA
000558r 2  AE rr rr       ldx PieceC
00055Br 2  8E rr rr       stx PieceB
00055Er 2  8D rr rr       sta PieceC
000561r 2  A9 01          lda #1
000563r 2  8D rr rr       sta PieceDirty
000566r 2  A9 02          lda #SFX_ROTATE               ; SPEC 16 effect 2 — both directions, one sound
000568r 2  4C rr rr       jmp SfxPlay
00056Br 2               
00056Br 2               PieceRotateBack:
00056Br 2  AD rr rr       lda PieceC
00056Er 2  AE rr rr       ldx PieceB
000571r 2  8E rr rr       stx PieceC
000574r 2  AE rr rr       ldx PieceA
000577r 2  8E rr rr       stx PieceB
00057Ar 2  8D rr rr       sta PieceA
00057Dr 2  A9 01          lda #1
00057Fr 2  8D rr rr       sta PieceDirty
000582r 2  A9 02          lda #SFX_ROTATE
000584r 2  4C rr rr       jmp SfxPlay
000587r 2               
000587r 2               ; -----------------------------------------------------------------------------
000587r 2               ;   PieceCanFall — is the cell below C free?
000587r 2               ;   Out: C set if the piece can descend one row.  Modifies: A, X
000587r 2               ;   Three strides past cell A. With C on row 15 that reads row 18, which is a
000587r 2               ;   permanent wall row, so the floor needs no special case (SPEC 3.2).
000587r 2               ; -----------------------------------------------------------------------------
000587r 2               PieceCanFall:
000587r 2  20 rr rr       jsr PieceIndex
00058Ar 2  BD rr rr       lda Board + 3 * BOARD_STRIDE,x
00058Dr 2  D0 02          bne @No
00058Fr 2  38             sec
000590r 2  60             rts
000591r 2               @No:
000591r 2  18             clc
000592r 2  60             rts
000593r 2               
000593r 2               ; -----------------------------------------------------------------------------
000593r 2               ;   PieceStep — one row of gravity
000593r 2               ;   Out: C set if the piece has landed and the lock delay should start.
000593r 2               ;        Modifies: A, X
000593r 2               ; -----------------------------------------------------------------------------
000593r 2               PieceStep:
000593r 2  20 rr rr       jsr PieceCanFall
000596r 2  90 0B          bcc @Landed
000598r 2  20 rr rr       jsr RenderPieceErase
00059Br 2  EE rr rr       inc PieceRow
00059Er 2  20 rr rr       jsr PieceMoved
0005A1r 2  18             clc                           ; Moved, so it has not landed
0005A2r 2  60             rts
0005A3r 2               @Landed:
0005A3r 2  38             sec
0005A4r 2  60             rts
0005A5r 2               
0005A5r 2               ; -----------------------------------------------------------------------------
0005A5r 2               ;   PieceLock — write the three cells into the board
0005A5r 2               ;   Out: nothing.  Modifies: A, X, Y
0005A5r 2               ;   SPEC 5.6 — after this the caller runs a cascade.
0005A5r 2               ;
0005A5r 2               ;   Once the board holds the piece, drawing the piece and drawing those three
0005A5r 2               ;   board cells are the same three writes, so RenderPiece does the queueing.
0005A5r 2               ; -----------------------------------------------------------------------------
0005A5r 2               PieceLock:
0005A5r 2  20 rr rr       jsr PieceIndex
0005A8r 2  AD rr rr       lda PieceA
0005ABr 2  9D rr rr       sta Board + 0 * BOARD_STRIDE,x
0005AEr 2  AD rr rr       lda PieceB
0005B1r 2  9D rr rr       sta Board + 1 * BOARD_STRIDE,x
0005B4r 2  AD rr rr       lda PieceC
0005B7r 2  9D rr rr       sta Board + 2 * BOARD_STRIDE,x
0005BAr 2               
0005BAr 2  20 rr rr       jsr RenderPiece
0005BDr 2  A9 00          lda #0
0005BFr 2  8D rr rr       sta PieceDirty                ; It is board now; nothing owes it a redraw
0005C2r 2  A9 03          lda #SFX_LOCK                 ; SPEC 16 effect 3. A match in the same frame is
0005C4r 2  4C rr rr       jmp SfxPlay                   ;   louder and takes the channel off it
0005C7r 2                                               ;   (audio.asm)
0005C7r 2               
0005C7r 2               ; -----------------------------------------------------------------------------
0005C7r 2               ;   PieceFallRate — frames per row for this frame
0005C7r 2               ;   Out: A = frame count, C CLEAR if that rate is the soft drop's.
0005C7r 2               ;        Modifies: A, X, Tmp0
0005C7r 2               ;   SPEC 5.5, 11.3 — soft drop substitutes its own rate and is ignored when
0005C7r 2               ;   gravity is already the faster of the two (levels 14+ on NTSC).
0005C7r 2               ;
0005C7r 2               ;   The carry is what pays for the soft drop: SPEC 9.6 gives a point per row
0005C7r 2               ;   "descended under soft drop", and a row that fell at gravity's rate with
0005C7r 2               ;   DOWN held down was not one, so holding DOWN at level 16 earns nothing.
0005C7r 2               ;   Working it out here costs nothing — the comparison has already happened.
0005C7r 2               ; -----------------------------------------------------------------------------
0005C7r 2               PieceFallRate:
0005C7r 2  20 rr rr       jsr ScoreGravity              ; Speed[level] for this region
0005CAr 2  85 rr          sta Tmp0
0005CCr 2  AD rr rr       lda InputNow
0005CFr 2  29 02          and #INPUT_DOWN
0005D1r 2  F0 0A          beq @Gravity
0005D3r 2  AE rr rr       ldx Region
0005D6r 2  BD rr rr       lda SoftDropRate,x
0005D9r 2  C5 rr          cmp Tmp0                      ; C clear = soft drop is the faster
0005DBr 2  90 04          bcc @Soft
0005DDr 2               @Gravity:
0005DDr 2  A5 rr          lda Tmp0
0005DFr 2  38             sec
0005E0r 2  60             rts
0005E1r 2               @Soft:
0005E1r 2  18             clc
0005E2r 2  60             rts
0005E3r 2               
0005E3r 2               ; -----------------------------------------------------------------------------
0005E3r 2               ;   PieceControl — apply this frame's input to the piece
0005E3r 2               ;   Out: C set if a horizontal move succeeded (the caller may reset the lock
0005E3r 2               ;        delay).  Modifies: A, X, Y
0005E3r 2               ;
0005E3r 2               ;   Rotation is edge triggered and never repeats: UP has to be released and
0005E3r 2               ;   pressed again. SPEC 11.3 calls that non-negotiable and it is — a
0005E3r 2               ;   repeating rotate makes a three-cell piece impossible to aim. Left and
0005E3r 2               ;   right go through InputShift, which is where the repeat lives.
0005E3r 2               ; -----------------------------------------------------------------------------
0005E3r 2               PieceControl:
0005E3r 2  AD rr rr       lda InputEdge
0005E6r 2  29 01          and #INPUT_UP
0005E8r 2  F0 03          beq @NoRotate
0005EAr 2  20 rr rr       jsr PieceRotate
0005EDr 2               @NoRotate:
0005EDr 2  AD rr rr       lda InputEdge
0005F0r 2  29 10          and #INPUT_FIRE
0005F2r 2  F0 03          beq @NoBack
0005F4r 2  20 rr rr       jsr PieceRotateBack
0005F7r 2               @NoBack:
0005F7r 2  20 rr rr       jsr InputShift
0005FAr 2  C9 04          cmp #INPUT_LEFT
0005FCr 2  F0 06          beq @Left
0005FEr 2  C9 08          cmp #INPUT_RIGHT
000600r 2  F0 05          beq @Right
000602r 2  18             clc
000603r 2  60             rts
000604r 2               @Left:
000604r 2  4C rr rr       jmp PieceMoveLeft
000607r 2               @Right:
000607r 2  4C rr rr       jmp PieceMoveRight
00060Ar 2               
00060Ar 1               .include "../src/match.asm"
00060Ar 2               ; =============================================================================
00060Ar 2               ;   match.asm — Wizards Lab, the match scanner
00060Ar 2               ; =============================================================================
00060Ar 2               ;   SPEC.md section 6. Four passes — horizontal, vertical, and both diagonals —
00060Ar 2               ;   each walking its axis and tracking a run colour and length. A run of three
00060Ar 2               ;   or more sets the MARK bit for each of its cells.
00060Ar 2               ;
00060Ar 2               ;   Colour comparison is the whole trick:
00060Ar 2               ;
00060Ar 2               ;       lda cell
00060Ar 2               ;       and #COLOR_MASK         ; the low three bits are the glyph, ignore them
00060Ar 2               ;       cmp ScanColor
00060Ar 2               ;
00060Ar 2               ;   which is why a red potion, a red fireball and a red star all match. The
00060Ar 2               ;   glyph decides what happens on removal, never whether cells match.
00060Ar 2               ;
00060Ar 2               ;   Wildcards (SPEC 6.3): a WILD cell continues any run. If the run has no
00060Ar 2               ;   colour yet it stays unset and is adopted from the first non-wild cell, so
00060Ar 2               ;   one prism can close a red horizontal run and a blue vertical run at once.
00060Ar 2               ;
00060Ar 2               ;   THE FOUR PASSES ARE ONE LOOP. A line is a start cell and a step, and the
00060Ar 2               ;   step is the only thing that differs: +1 across, +8 down, +9 down-right,
00060Ar 2               ;   +7 down-left. Every one of them ends on a sentinel rather than on a bounds
00060Ar 2               ;   check, which is what the 8-byte stride was bought for (SPEC 3.2):
00060Ar 2               ;
00060Ar 2               ;     across   from column 5, +1 lands on column 6      — wall
00060Ar 2               ;     down     from row 15,   +8 lands on row 16        — wall row
00060Ar 2               ;     down-r   from column 5, +9 lands on row+1 col 6   — wall
00060Ar 2               ;     down-l   from column 0, +7 lands on THIS row's column 7 — wall
00060Ar 2               ;
00060Ar 2               ;   The last one is the reason the left edge needs no test either: the byte
00060Ar 2               ;   before column 0 belongs to the row above, and it is already a wall.
00060Ar 2               ; =============================================================================
00060Ar 2               
00060Ar 2               ; -----------------------------------------------------------------------------
00060Ar 2               ;   MatchScan — find every run on the board
00060Ar 2               ;   In:  nothing
00060Ar 2               ;   Out: Marks filled, RunCount set, Z set if nothing matched.
00060Ar 2               ;        Modifies: A, X, Y, Scan*
00060Ar 2               ; -----------------------------------------------------------------------------
00060Ar 2               MatchScan:
00060Ar 2  20 rr rr       jsr MarksClear
00060Dr 2  A9 00          lda #0
00060Fr 2  8D rr rr       sta RunCount
000612r 2               
000612r 2  20 rr rr       jsr ScanFindTop               ; Everything below skips the empty air above
000615r 2  A5 rr          lda ScanTop                   ;   the pile, which on most boards is most of
000617r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE) ;   the board
000619r 2  B0 0C          bcs @Done                     ; Nothing on the board at all
00061Br 2               
00061Br 2  20 rr rr       jsr MatchScanHorizontal
00061Er 2  20 rr rr       jsr MatchScanVertical
000621r 2  20 rr rr       jsr MatchScanDiagonal
000624r 2  20 rr rr       jsr MatchScanAntiDiagonal
000627r 2               @Done:
000627r 2  AD rr rr       lda RunCount                  ; Z set when nothing matched
00062Ar 2  60             rts
00062Br 2               
00062Br 2               ; -----------------------------------------------------------------------------
00062Br 2               ;   ScanFindTop — board index of the first row that holds anything
00062Br 2               ;   Out: ScanTop = row base, or BOARD_H * BOARD_STRIDE if the board is empty.
00062Br 2               ;        Modifies: A, X, ScanTop
00062Br 2               ;
00062Br 2               ;   Every pass below starts here instead of at row 0. A pile six rows deep is
00062Br 2               ;   scanned as six rows: 178 cells against 448, and the four passes come in
00062Br 2               ;   under a third of the frame instead of over two whole ones. Finding it costs
00062Br 2               ;   about 45 cycles a row of empty air, which is the cheapest part of the scan.
00062Br 2               ;
00062Br 2               ;   Correct as well as quick, and for a reason worth writing down: a line that
00062Br 2               ;   reaches the pile at all must CROSS the pile's top row, because every one of
00062Br 2               ;   the four steps moves down at most one row at a time. Starting the diagonals
00062Br 2               ;   on that row rather than on row 0 therefore misses nothing.
00062Br 2               ; -----------------------------------------------------------------------------
00062Br 2               ScanFindTop:
00062Br 2  A2 00          ldx #0
00062Dr 2               @Row:
00062Dr 2  BD rr rr       lda Board + 0,x               ; The six playfield columns; the two sentinel
000630r 2  1D rr rr       ora Board + 1,x               ;   ones would make every row look occupied
000633r 2  1D rr rr       ora Board + 2,x
000636r 2  1D rr rr       ora Board + 3,x
000639r 2  1D rr rr       ora Board + 4,x
00063Cr 2  1D rr rr       ora Board + 5,x
00063Fr 2  D0 09          bne @Found
000641r 2  8A             txa
000642r 2  18             clc
000643r 2  69 08          adc #BOARD_STRIDE
000645r 2  AA             tax
000646r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
000648r 2  90 E3          bcc @Row
00064Ar 2               @Found:
00064Ar 2  86 rr          stx ScanTop
00064Cr 2  60             rts
00064Dr 2               
00064Dr 2               ; -----------------------------------------------------------------------------
00064Dr 2               ;   The four passes (SPEC 6.2). Each sets a step and hands ScanLine its start
00064Dr 2               ;   cells; the start cell rides the stack because ScanLine needs both index
00064Dr 2               ;   registers and the scratch bytes below it.
00064Dr 2               ; -----------------------------------------------------------------------------
00064Dr 2               MatchScanHorizontal:            ; Every row of the pile, column 0 rightward
00064Dr 2  A9 01          lda #1
00064Fr 2  85 rr          sta ScanStep
000651r 2  A5 rr          lda ScanTop
000653r 2               @Line:
000653r 2  48             pha
000654r 2  20 rr rr       jsr ScanLine
000657r 2  68             pla
000658r 2  18             clc
000659r 2  69 08          adc #BOARD_STRIDE
00065Br 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
00065Dr 2  90 F4          bcc @Line
00065Fr 2  60             rts
000660r 2               
000660r 2               MatchScanVertical:              ; 6 columns, top of the pile downward
000660r 2  A9 08          lda #BOARD_STRIDE
000662r 2  85 rr          sta ScanStep
000664r 2  4C rr rr       jmp ScanTopRow
000667r 2               
000667r 2               MatchScanDiagonal:              ; down-right: the top row, then the left edge
000667r 2  A9 09          lda #(BOARD_STRIDE + 1)
000669r 2  85 rr          sta ScanStep
00066Br 2  20 rr rr       jsr ScanTopRow
00066Er 2  A9 00          lda #0
000670r 2  4C rr rr       jmp ScanEdgeColumn
000673r 2               
000673r 2               MatchScanAntiDiagonal:          ; down-left: the top row, then the right edge
000673r 2  A9 07          lda #(BOARD_STRIDE - 1)
000675r 2  85 rr          sta ScanStep
000677r 2  20 rr rr       jsr ScanTopRow
00067Ar 2  A9 05          lda #(BOARD_W - 1)
00067Cr 2  4C rr rr       jmp ScanEdgeColumn
00067Fr 2               
00067Fr 2               ; -----------------------------------------------------------------------------
00067Fr 2               ;   ScanTopRow — scan a line from each of the six cells of the pile's top row
00067Fr 2               ;   ScanEdgeColumn — and from the rows below it, in the column in A
00067Fr 2               ;   In:  ScanStep set, ScanTop set; A = column (ScanEdgeColumn only)
00067Fr 2               ;
00067Fr 2               ;   Between them those are every start cell a diagonal needs, and the top row
00067Fr 2               ;   alone is every start cell the vertical pass needs. The top row is scanned
00067Fr 2               ;   by the first, so the second skips it rather than scanning the longest
00067Fr 2               ;   diagonal twice.
00067Fr 2               ; -----------------------------------------------------------------------------
00067Fr 2               ScanTopRow:
00067Fr 2  A5 rr          lda ScanTop
000681r 2               @Line:
000681r 2  48             pha
000682r 2  20 rr rr       jsr ScanLine
000685r 2  68             pla
000686r 2  18             clc
000687r 2  69 01          adc #1
000689r 2  48             pha                           ; Six columns of that row, whichever row it
00068Ar 2  29 07          and #(BOARD_STRIDE - 1)       ;   is, so it is the COLUMN that ends the loop
00068Cr 2  C9 06          cmp #BOARD_W                  ;   and not the index
00068Er 2  68             pla                           ; PLA leaves C alone
00068Fr 2  90 F0          bcc @Line
000691r 2  60             rts
000692r 2               
000692r 2               ScanEdgeColumn:
000692r 2  18             clc
000693r 2  65 rr          adc ScanTop                   ; That column, on the pile's top row...
000695r 2  18             clc
000696r 2  69 08          adc #BOARD_STRIDE             ;   ...and then the row below it
000698r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
00069Ar 2  B0 0C          bcs @Done                     ; The pile is one row deep — there is no below
00069Cr 2               @Line:
00069Cr 2  48             pha
00069Dr 2  20 rr rr       jsr ScanLine
0006A0r 2  68             pla
0006A1r 2  18             clc
0006A2r 2  69 08          adc #BOARD_STRIDE
0006A4r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
0006A6r 2  90 F4          bcc @Line
0006A8r 2               @Done:
0006A8r 2  60             rts
0006A9r 2               
0006A9r 2               ; -----------------------------------------------------------------------------
0006A9r 2               ;   ScanLine — walk one line, marking every run of MATCH_MIN or more
0006A9r 2               ;   In:  A = start board index, ScanStep = direction
0006A9r 2               ;   Out: nothing.  Modifies: A, X, Scan*, Marks, RunCount
0006A9r 2               ;
0006A9r 2               ;   ONLY A WALL ENDS THE LINE. A hole in the middle of a row breaks the run
0006A9r 2               ;   and the walk carries on past it, because the cells beyond it are a run of
0006A9r 2               ;   their own — a line that stopped at the first empty cell would never look
0006A9r 2               ;   below the top of the pile at all, which is very nearly the whole board.
0006A9r 2               ;
0006A9r 2               ;   A colour change ends the run and starts a new one at the cell that broke
0006A9r 2               ;   it — the cell that broke a red run is the first cell of the blue one, and
0006A9r 2               ;   any prisms that were riding the red run stay with the red run. SPEC 6.3
0006A9r 2               ;   gives a wildcard to the run it is already in, not to both.
0006A9r 2               ; -----------------------------------------------------------------------------
0006A9r 2               ScanLine:
0006A9r 2  AA             tax                           ; The cursor lives in X for the whole line:
0006AAr 2  A9 FF          lda #$FF                      ;   this loop runs about four hundred times a
0006ACr 2  85 rr          sta ScanColor                 ;   scan and every cycle in it is four hundred
0006AEr 2  A9 00          lda #0                        ;   cycles of the frame
0006B0r 2  85 rr          sta ScanLen
0006B2r 2               
0006B2r 2               @Cell:
0006B2r 2  BD rr rr       lda Board,x
0006B5r 2  F0 41          beq @Gap                      ; A hole breaks the run, not the line
0006B7r 2  C9 FF          cmp #TILE_WALL
0006B9r 2  F0 52          beq @End                      ; A wall is where the line stops
0006BBr 2  29 F8          and #COLOR_MASK               ; The colour key, glyph discarded (SPEC 4.2)
0006BDr 2  C5 rr          cmp ScanColor
0006BFr 2  F0 19          beq @Grow                     ; Same colour — the commonest case, first
0006C1r 2  C9 70          cmp #WILD_BASE
0006C3r 2  F0 15          beq @Grow                     ; A prism continues any run (SPEC 6.3)
0006C5r 2               
0006C5r 2  A8             tay                           ; A different colour. Park it: everything
0006C6r 2  A5 rr          lda ScanColor                 ;   below either adopts it or starts a run
0006C8r 2  30 0E          bmi @Adopt                    ;   with it. $FF is the only value here with
0006CAr 2                                               ;   bit 7 set — colours are $40 to $70
0006CAr 2  A5 rr          lda ScanLen
0006CCr 2  C9 03          cmp #MATCH_MIN
0006CEr 2  B0 14          bcs @Close                    ; The run it broke was long enough to mark
0006D0r 2               
0006D0r 2  84 rr          sty ScanColor                 ; It was not, so no call and no marking: this
0006D2r 2  A9 01          lda #1                        ;   cell is simply the start of the next run.
0006D4r 2  85 rr          sta ScanLen                   ;   Five adjacent cells in six differ in
0006D6r 2  D0 04          bne @Advance                  ;   colour, so this is the path that decides
0006D8r 2                                               ;   what a scan costs
0006D8r 2               @Adopt:
0006D8r 2  84 rr          sty ScanColor
0006DAr 2               @Grow:
0006DAr 2  E6 rr          inc ScanLen
0006DCr 2               @Advance:
0006DCr 2  8A             txa
0006DDr 2  18             clc
0006DEr 2  65 rr          adc ScanStep
0006E0r 2  AA             tax
0006E1r 2  4C rr rr       jmp @Cell
0006E4r 2               
0006E4r 2               @Close:
0006E4r 2  86 rr          stx ScanIdx
0006E6r 2  20 rr rr       jsr MatchEmit                 ; Mark it — and MatchEmit leaves ScanLen zero
0006E9r 2  A6 rr          ldx ScanIdx
0006EBr 2  BD rr rr       lda Board,x
0006EEr 2  29 F8          and #COLOR_MASK
0006F0r 2  85 rr          sta ScanColor
0006F2r 2  A9 01          lda #1
0006F4r 2  85 rr          sta ScanLen
0006F6r 2  D0 E4          bne @Advance                  ; Always
0006F8r 2               
0006F8r 2               @Gap:
0006F8r 2  A5 rr          lda ScanLen
0006FAr 2  F0 E0          beq @Advance                  ; Nothing running — step over the hole. This
0006FCr 2                                               ;   is the cell the scan meets most often, so
0006FCr 2                                               ;   it is the one that must not call anything
0006FCr 2  86 rr          stx ScanIdx
0006FEr 2  20 rr rr       jsr MatchEmit                 ; Close the run the hole broke...
000701r 2  A6 rr          ldx ScanIdx
000703r 2  A9 FF          lda #$FF
000705r 2  85 rr          sta ScanColor                 ;   ...and start again on the far side of it
000707r 2  A9 00          lda #0
000709r 2  85 rr          sta ScanLen
00070Br 2  F0 CF          beq @Advance                  ; Always
00070Dr 2               
00070Dr 2               @End:
00070Dr 2  A5 rr          lda ScanLen
00070Fr 2  F0 05          beq @Nothing                  ; The line ran out with nothing in hand
000711r 2  86 rr          stx ScanIdx
000713r 2  4C rr rr       jmp MatchEmit                 ; Whatever was running ends with the line
000716r 2               @Nothing:
000716r 2  60             rts
000717r 2               
000717r 2               ; -----------------------------------------------------------------------------
000717r 2               ;   MatchEmit — a run has ended; mark it if it was long enough
000717r 2               ;   In:  ScanIdx = one cell PAST the run's last, ScanLen, ScanColor, ScanStep
000717r 2               ;   Out: nothing.  Modifies: A, X, Y, ScanEnd, ScanLen, RunCount, Marks
000717r 2               ;
000717r 2               ;   Runs are marked, not removed: a cell can be in a horizontal run and a
000717r 2               ;   vertical one at once, and it clears once while both runs score (SPEC 6.1).
000717r 2               ;   The union is what the MARKS bitmap is for.
000717r 2               ;
000717r 2               ;   SCORING HAPPENS HERE, before the mark loop and for the same reason the
000717r 2               ;   comment above used to promise it would: ScanLen still describes the run at
000717r 2               ;   this point and nowhere else, because the mark loop counts it down to zero
000717r 2               ;   on its way back along the line. MatchScoreRun leaves it alone.
000717r 2               ; -----------------------------------------------------------------------------
000717r 2               MatchEmit:
000717r 2  A5 rr          lda ScanLen
000719r 2  C9 03          cmp #MATCH_MIN
00071Br 2  90 1D          bcc @Done                     ; Two in a row is not a run
00071Dr 2               
00071Dr 2  EE rr rr       inc RunCount
000720r 2  20 rr rr       jsr MatchScoreRun             ; SPEC 8 step 2, per run
000723r 2  A5 rr          lda ScanIdx
000725r 2  38             sec
000726r 2  E5 rr          sbc ScanStep                  ; Back onto the run's last cell
000728r 2  85 rr          sta ScanEnd
00072Ar 2               @Mark:
00072Ar 2  A5 rr          lda ScanEnd
00072Cr 2  20 rr rr       jsr MarkSet
00072Fr 2  A5 rr          lda ScanEnd
000731r 2  38             sec
000732r 2  E5 rr          sbc ScanStep
000734r 2  85 rr          sta ScanEnd
000736r 2  C6 rr          dec ScanLen
000738r 2  D0 F0          bne @Mark
00073Ar 2               @Done:
00073Ar 2  60             rts
00073Br 2               
00073Br 2               ; -----------------------------------------------------------------------------
00073Br 2               ;   MatchScoreRun — the two per-run awards of SPEC 8 step 2
00073Br 2               ;   In:  ScanLen = run length, ChainStep = the cascade step this is
00073Br 2               ;   Out: nothing.  Modifies: A, X, Y.  Leaves ScanLen and ScanColor alone.
00073Br 2               ;
00073Br 2               ;       cascade_pts += length * TileValue[chain]
00073Br 2               ;       cascade_pts += LengthBonus[length]
00073Br 2               ;
00073Br 2               ;   A cell in a horizontal run AND a vertical one is scored by both, and
00073Br 2               ;   removed once (SPEC 6.1) — which is why this is per run and not per marked
00073Br 2               ;   cell, and why it runs before the union in MARKS has anything to say.
00073Br 2               ;
00073Br 2               ;   MultiBonus is NOT here: it is per step, not per run, and CascadeScan adds
00073Br 2               ;   it once the four passes have finished counting.
00073Br 2               ; -----------------------------------------------------------------------------
00073Br 2               MatchScoreRun:
00073Br 2  AE rr rr       ldx ChainStep
00073Er 2  CA             dex                           ; TileValue is indexed by chain - 1 ...
00073Fr 2  E0 08          cpx #8
000741r 2  90 02          bcc @Chain
000743r 2  A2 07          ldx #7                        ;   ... and flattens out at 8 (SPEC 9.1)
000745r 2               @Chain:
000745r 2  A4 rr          ldy ScanLen                   ; The multiply is Y additions (score.asm)
000747r 2  BD rr rr       lda TileValueLo,x
00074Ar 2  48             pha
00074Br 2  BD rr rr       lda TileValueHi,x
00074Er 2  AA             tax
00074Fr 2  68             pla
000750r 2  20 rr rr       jsr CascadeAddTimes
000753r 2               
000753r 2  A6 rr          ldx ScanLen
000755r 2  CA             dex
000756r 2  CA             dex
000757r 2  CA             dex                           ; LengthBonus is indexed by length - 3 ...
000758r 2  E0 05          cpx #5
00075Ar 2  90 02          bcc @Length
00075Cr 2  A2 04          ldx #4                        ;   ... and flattens out at 7 (SPEC 9.3). A
00075Er 2               @Length:                        ;   vertical run can be all sixteen rows long
00075Er 2  BD rr rr       lda LengthBonusLo,x
000761r 2  48             pha
000762r 2  BD rr rr       lda LengthBonusHi,x
000765r 2  AA             tax
000766r 2  68             pla
000767r 2  4C rr rr       jmp CascadeAdd
00076Ar 2               
00076Ar 2               ; -----------------------------------------------------------------------------
00076Ar 2               ;   MarksClear / MarkSet / MarkTest — the 16-byte bitmap
00076Ar 2               ;   One byte per row, bits 0-5 = columns 0-5. Union of runs is a free ORA.
00076Ar 2               ;
00076Ar 2               ;   MarkBits has eight entries rather than six so that the two sentinel
00076Ar 2               ;   columns index it harmlessly: bits 6 and 7 of a Marks byte are never set,
00076Ar 2               ;   so a walk over the whole 8-byte stride can test every cell it meets
00076Ar 2               ;   without first asking whether the cell is a wall.
00076Ar 2               ; -----------------------------------------------------------------------------
00076Ar 2               MarkBits:
00076Ar 2  01 02 04 08    .byte $01, $02, $04, $08, $10, $20, $40, $80
00076Er 2  10 20 40 80  
000772r 2               
000772r 2               MarksClear:
000772r 2  A9 00          lda #0
000774r 2  A2 00          ldx #0
000776r 2               @Row:
000776r 2  9D rr rr       sta Marks,x
000779r 2  E8             inx
00077Ar 2  E0 10          cpx #MARKS_BYTES
00077Cr 2  D0 F8          bne @Row
00077Er 2  60             rts
00077Fr 2               
00077Fr 2               MarkSet:                        ; In: A = board index.  Modifies: A, X, Y
00077Fr 2  AA             tax
000780r 2  29 07          and #(BOARD_STRIDE - 1)
000782r 2  A8             tay                           ; Y = column
000783r 2  8A             txa
000784r 2  4A             lsr a
000785r 2  4A             lsr a
000786r 2  4A             lsr a
000787r 2  AA             tax                           ; X = row
000788r 2  BD rr rr       lda Marks,x
00078Br 2  19 rr rr       ora MarkBits,y
00078Er 2  9D rr rr       sta Marks,x
000791r 2  60             rts
000792r 2               
000792r 2               MarkTest:                       ; In: A = board index.  Out: C set if marked
000792r 2  AA             tax                           ;     Modifies: A, X, Y
000793r 2  29 07          and #(BOARD_STRIDE - 1)
000795r 2  A8             tay
000796r 2  8A             txa
000797r 2  4A             lsr a
000798r 2  4A             lsr a
000799r 2  4A             lsr a
00079Ar 2  AA             tax
00079Br 2  BD rr rr       lda Marks,x
00079Er 2  39 rr rr       and MarkBits,y
0007A1r 2  F0 02          beq @No
0007A3r 2  38             sec
0007A4r 2  60             rts
0007A5r 2               @No:
0007A5r 2  18             clc
0007A6r 2  60             rts
0007A7r 2               
0007A7r 1               .include "../src/cascade.asm"
0007A7r 2               ; =============================================================================
0007A7r 2               ;   cascade.asm — Wizards Lab, clear resolution
0007A7r 2               ; =============================================================================
0007A7r 2               ;   SPEC.md section 8. A cascade runs from the moment a piece locks until no
0007A7r 2               ;   further matches exist, one step per iteration, with ChainStep counting the
0007A7r 2               ;   steps. The step order is fixed:
0007A7r 2               ;
0007A7r 2               ;       scan -> score matches -> enqueue reagents -> resolve queue
0007A7r 2               ;            -> animate -> remove -> level check -> gravity -> repeat
0007A7r 2               ;
0007A7r 2               ;   The effect queue always drains. Effects only ever remove tiles, never add
0007A7r 2               ;   them, and each cell can be marked at most once, so the queue is bounded by
0007A7r 2               ;   the 96 cells of the playfield.
0007A7r 2               ; =============================================================================
0007A7r 2               
0007A7r 2               ; -----------------------------------------------------------------------------
0007A7r 2               ;   CascadeBegin — called immediately after PieceLock
0007A7r 2               ;   Out: nothing.  Modifies: A
0007A7r 2               ; -----------------------------------------------------------------------------
0007A7r 2               CascadeBegin:
0007A7r 2  A9 01          lda #1
0007A9r 2  8D rr rr       sta ChainStep                 ; The step about to run is step 1 (SPEC 8)
0007ACr 2  A9 00          lda #0
0007AEr 2  8D rr rr       sta CascadeLo
0007B1r 2  8D rr rr       sta CascadeMid
0007B4r 2  8D rr rr       sta CascadeHi
0007B7r 2  8D rr rr       sta StarCount
0007BAr 2  8D rr rr       sta RunCount
0007BDr 2  4C rr rr       jmp EffectQClear
0007C0r 2               
0007C0r 2               ; -----------------------------------------------------------------------------
0007C0r 2               ;   CascadeScan — steps 1 to 4: find the runs, score them, fire the reagents
0007C0r 2               ;   In:  nothing
0007C0r 2               ;   Out: C set if anything is marked and the step has something to animate.
0007C0r 2               ;        C clear when nothing matched and the cascade has settled.
0007C0r 2               ;        Modifies: A, X, Y, Scan*, Marks, RunCount, Cascade*, StarCount
0007C0r 2               ;
0007C0r 2               ;   Steps 3 and 4 are the reagents, and they run between the scan and the
0007C0r 2               ;   removal because everything they do is add cells to Marks: by the time
0007C0r 2               ;   CascadeRemove walks the bitmap it cannot tell a cell the scan found from
0007C0r 2               ;   a cell a fireball took, and does not need to.
0007C0r 2               ;
0007C0r 2               ;   NOTHING HAS LEFT THE BOARD WHEN THIS RETURNS. Step 5 — the glow and the
0007C0r 2               ;   shatter (anim.asm) — happens between here and CascadeFinish below, over
0007C0r 2               ;   several frames, and it can only draw a cell's own colour and its own
0007C0r 2               ;   reagent because the cell is still sitting there saying what it is. That
0007C0r 2               ;   split is what the whole of P6 rests on, and it is the same property that
0007C0r 2               ;   let P5 make an effect queue entry one byte.
0007C0r 2               ;
0007C0r 2               ;   Step 2's per-run half is in MatchEmit, which is the one moment a run's
0007C0r 2               ;   length and colour are both in hand; what is left of it here is the bonus
0007C0r 2               ;   for having found several at once, which nothing knows until all four
0007C0r 2               ;   passes have finished.
0007C0r 2               ; -----------------------------------------------------------------------------
0007C0r 2               CascadeScan:
0007C0r 2  20 rr rr       jsr MatchScan
0007C3r 2  F0 1E          beq @Settled                  ; RunCount is zero — nothing left to clear
0007C5r 2               
0007C5r 2  AE rr rr       ldx RunCount                  ; SPEC 8 step 2, last line, and SPEC 9.4
0007C8r 2  CA             dex                           ; MultiBonus is indexed by runs - 1 ...
0007C9r 2  E0 05          cpx #5
0007CBr 2  90 02          bcc @Multi
0007CDr 2  A2 04          ldx #4                        ;   ... and flattens out at 5
0007CFr 2               @Multi:
0007CFr 2  BD rr rr       lda MultiBonusLo,x
0007D2r 2  48             pha
0007D3r 2  BD rr rr       lda MultiBonusHi,x
0007D6r 2  AA             tax
0007D7r 2  68             pla
0007D8r 2  20 rr rr       jsr CascadeAdd
0007DBr 2               
0007DBr 2  20 rr rr       jsr EffectEnqueueMarked       ; SPEC 8 step 3
0007DEr 2  20 rr rr       jsr EffectResolve             ; SPEC 8 step 4
0007E1r 2  38             sec
0007E2r 2  60             rts
0007E3r 2               @Settled:
0007E3r 2  18             clc
0007E4r 2  60             rts
0007E5r 2               
0007E5r 2               ; -----------------------------------------------------------------------------
0007E5r 2               ;   CascadeFinish — steps 6 and 7, once the animation has finished with them
0007E5r 2               ;   In:  Marks, as CascadeScan left it
0007E5r 2               ;   Out: nothing.  Modifies: A, X, Y, CellCount, Board, Level
0007E5r 2               ; -----------------------------------------------------------------------------
0007E5r 2               CascadeFinish:
0007E5r 2  20 rr rr       jsr CascadeRemove             ; SPEC 8 step 6
0007E8r 2  A5 rr          lda CellCount
0007EAr 2  4C rr rr       jmp ScoreLevelCheck           ; SPEC 8 step 7 — match and effect removals
0007EDr 2                                               ;   both count, and by here they are the same
0007EDr 2                                               ;   cells
0007EDr 2               
0007EDr 2               ; -----------------------------------------------------------------------------
0007EDr 2               ;   CascadeRemove — empty every marked cell and queue it for redraw
0007EDr 2               ;   In:  Marks
0007EDr 2               ;   Out: CellCount = cells removed.  Modifies: A, X, Y, CellCount, RedrawCol
0007EDr 2               ;   SPEC 8 step 6.
0007EDr 2               ;
0007EDr 2               ;   Every marked cell is zeroed in one go, because the gravity that follows
0007EDr 2               ;   needs a board that is finished changing. Only the REDRAW is rationed: at
0007EDr 2               ;   most 96 cells can be marked and the dirty ring holds 64, and P5 made that
0007EDr 2               ;   reachable — a bolt is 21 cells on its own and a chain of them is most of
0007EDr 2               ;   the well. A mark dropped by a full ring is never made again (D6), so
0007EDr 2               ;   rather than drop one this falls back to RenderBoard, the whole-well cursor
0007EDr 2               ;   RenderFlush already feeds a frame at a time (D12). Four frames of redraw
0007EDr 2               ;   instead of a hole in the screen, and only on the rare huge step: a plain
0007EDr 2               ;   three-in-a-row never comes near the cap.
0007EDr 2               ;
0007EDr 2               ;   CellCount goes to ScoreLevelCheck — thirty cleared tiles is a level
0007EDr 2               ;   (SPEC 10.1). By the time this runs the cells have already glowed and
0007EDr 2               ;   shattered (anim.asm); what it draws over them is the empty well behind.
0007EDr 2               ; -----------------------------------------------------------------------------
0007EDr 2               CascadeRemove:
0007EDr 2  A9 00          lda #0
0007EFr 2  85 rr          sta CellCount
0007F1r 2  AA             tax                           ; X = board index, walked a row at a time
0007F2r 2               @Row:
0007F2r 2  8A             txa
0007F3r 2  4A             lsr a
0007F4r 2  4A             lsr a
0007F5r 2  4A             lsr a
0007F6r 2  A8             tay
0007F7r 2  B9 rr rr       lda Marks,y
0007FAr 2  F0 38          beq @NextRow                  ; Nothing marked in this row, and most rows
0007FCr 2                                               ;   hold nothing marked
0007FCr 2               @Cell:
0007FCr 2  8A             txa
0007FDr 2  48             pha
0007FEr 2  20 rr rr       jsr MarkTest
000801r 2  68             pla
000802r 2  AA             tax                           ; MarkTest needs X, so the cursor comes back
000803r 2  90 1F          bcc @NextCell                 ;   through A. Neither PLA nor TAX touches C.
000805r 2  A9 00          lda #TILE_EMPTY
000807r 2  9D rr rr       sta Board,x
00080Ar 2  E6 rr          inc CellCount
00080Cr 2               
00080Cr 2  AD rr rr       lda DirtyCount                ; Room to mark this one?
00080Fr 2  C9 40          cmp #DIRTY_ENTRIES
000811r 2  B0 0A          bcs @Bulk                     ; No — redraw the lot instead of losing it
000813r 2  8A             txa
000814r 2  48             pha
000815r 2  20 rr rr       jsr RenderCell
000818r 2  68             pla
000819r 2  AA             tax
00081Ar 2  4C rr rr       jmp @NextCell
00081Dr 2               @Bulk:
00081Dr 2  8A             txa
00081Er 2  48             pha
00081Fr 2  20 rr rr       jsr RenderBoard               ; Sets the cursor and nothing else, so the
000822r 2  68             pla                           ;   cells already queued still land and the
000823r 2  AA             tax                           ;   redraw overwrites them with the same values
000824r 2               @NextCell:
000824r 2  E8             inx
000825r 2  8A             txa
000826r 2  29 07          and #(BOARD_STRIDE - 1)
000828r 2  C9 06          cmp #BOARD_W
00082Ar 2  90 D0          bcc @Cell
00082Cr 2               
00082Cr 2  8A             txa                           ; X is on the row's first sentinel column;
00082Dr 2  18             clc                           ;   step over both of them
00082Er 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000830r 2  AA             tax
000831r 2  4C rr rr       jmp @Test
000834r 2               
000834r 2               @NextRow:
000834r 2  8A             txa
000835r 2  18             clc
000836r 2  69 08          adc #BOARD_STRIDE
000838r 2  AA             tax
000839r 2               @Test:
000839r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
00083Br 2  90 B5          bcc @Row
00083Dr 2  60             rts
00083Er 2               
00083Er 2               ; -----------------------------------------------------------------------------
00083Er 2               ;   CascadeSettle — apply the star multiplier and bank the points
00083Er 2               ;   SPEC 8 SETTLE, SPEC 9.6 — the doubling covers the WHOLE cascade, including
00083Er 2               ;   points scored before the star cleared.
00083Er 2               ; -----------------------------------------------------------------------------
00083Er 2               CascadeSettle:
00083Er 2  AD rr rr       lda StarCount
000841r 2  C9 03          cmp #STAR_SHIFT_CAP
000843r 2  90 02          bcc @Shift
000845r 2  A9 03          lda #STAR_SHIFT_CAP           ; x8 and no further, however many were caught
000847r 2               @Shift:
000847r 2  AA             tax
000848r 2  F0 06          beq @Bank
00084Ar 2               @Double:
00084Ar 2  20 rr rr       jsr CascadeDouble             ; A doubling in BCD is one self-addition
00084Dr 2  CA             dex
00084Er 2  D0 FA          bne @Double
000850r 2               @Bank:
000850r 2  4C rr rr       jmp ScoreAdd                  ; Its carry is not read: ScoreHighCheck has
000853r 2                                               ;   already raised the fanfare and the flash
000853r 2                                               ;   itself, and does so exactly once
000853r 2               
000853r 2               
000853r 2               ; =============================================================================
000853r 2               ;   The reagents (SPEC 7)
000853r 2               ; =============================================================================
000853r 2               ;   Steps 3 and 4 of SPEC 8, and the five effects between them. The shape is:
000853r 2               ;
000853r 2               ;     EffectEnqueueMarked   walks MARKS once the scan has finished, and offers
000853r 2               ;                           every matched cell to EffectEnqueue
000853r 2               ;     EffectEnqueue         decides what a cell being removed is worth — a
000853r 2               ;                           prism pays, a star counts, a fireball/bolt/bomb
000853r 2               ;                           queues
000853r 2               ;     EffectResolve         drains the queue, detonating each in turn
000853r 2               ;     EffectFireball/Bolt/  list the cells a detonation reaches, and offer each
000853r 2               ;       Bomb                one to EffectHit
000853r 2               ;     EffectHit             marks it, scores it, and offers it to
000853r 2               ;                           EffectEnqueue in its turn — which is the whole of
000853r 2               ;                           SPEC 7.2's chain reaction, in one routine
000853r 2               ;
000853r 2               ;   TERMINATION IS STRUCTURAL, not a limit. An effect only ever MARKS cells and
000853r 2               ;   never adds one, and EffectHit refuses a cell that is already marked, so a
000853r 2               ;   cell can be pushed at most once and the loop is bounded by the 96 cells of
000853r 2               ;   the well.
000853r 2               ;
000853r 2               ;   Nothing here touches the board. Marked cells are still sitting there,
000853r 2               ;   readable, until CascadeRemove zeroes them in step 6 — which is what lets a
000853r 2               ;   queue entry be a board index and nothing else (constants.inc).
000853r 2               ; =============================================================================
000853r 2               
000853r 2               ; -----------------------------------------------------------------------------
000853r 2               ;   EffectEnqueueMarked — SPEC 8 step 3
000853r 2               ;   In:  Marks, as MatchScan left it
000853r 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectQ, StarCount, Cascade*
000853r 2               ;
000853r 2               ;   Nothing called from here marks anything, so the bitmap being walked cannot
000853r 2               ;   change underneath the walk. Step 4 is where marking starts, and the cells
000853r 2               ;   it marks enqueue themselves as they are marked (EffectHit) rather than
000853r 2               ;   waiting for a second pass over MARKS.
000853r 2               ;
000853r 2               ;   It has to be a pass over the union rather than part of MatchEmit's mark
000853r 2               ;   loop: a cell in a horizontal run AND a vertical one is marked twice and
000853r 2               ;   would then detonate twice (SPEC 6.1).
000853r 2               ; -----------------------------------------------------------------------------
000853r 2               EffectEnqueueMarked:
000853r 2  A9 00          lda #0
000855r 2  85 rr          sta EffectIdx
000857r 2               @Row:
000857r 2  A5 rr          lda EffectIdx
000859r 2  4A             lsr a
00085Ar 2  4A             lsr a
00085Br 2  4A             lsr a
00085Cr 2  A8             tay
00085Dr 2  B9 rr rr       lda Marks,y
000860r 2  F0 20          beq @NextRow                  ; Nothing marked in this row, which is most
000862r 2                                               ;   rows of most steps
000862r 2               @Cell:
000862r 2  A5 rr          lda EffectIdx
000864r 2  20 rr rr       jsr MarkTest
000867r 2  90 05          bcc @NextCell
000869r 2  A6 rr          ldx EffectIdx
00086Br 2  20 rr rr       jsr EffectEnqueue
00086Er 2               @NextCell:
00086Er 2  E6 rr          inc EffectIdx
000870r 2  A5 rr          lda EffectIdx
000872r 2  29 07          and #(BOARD_STRIDE - 1)
000874r 2  C9 06          cmp #BOARD_W
000876r 2  90 EA          bcc @Cell
000878r 2               
000878r 2  A5 rr          lda EffectIdx                 ; On the row's first sentinel column; step
00087Ar 2  18             clc                           ;   over both of them
00087Br 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
00087Dr 2  85 rr          sta EffectIdx
00087Fr 2  4C rr rr       jmp @Test
000882r 2               
000882r 2               @NextRow:
000882r 2  A5 rr          lda EffectIdx
000884r 2  18             clc
000885r 2  69 08          adc #BOARD_STRIDE
000887r 2  85 rr          sta EffectIdx
000889r 2               @Test:
000889r 2  A5 rr          lda EffectIdx
00088Br 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
00088Dr 2  90 C8          bcc @Row
00088Fr 2  60             rts
000890r 2               
000890r 2               ; -----------------------------------------------------------------------------
000890r 2               ;   EffectEnqueue — a marked cell is going; make what it holds count
000890r 2               ;   In:  X = board index of a cell that is ALREADY marked
000890r 2               ;   Out: nothing.  Modifies: A, X, Y
000890r 2               ;
000890r 2               ;   Called exactly once per removed cell — from step 3 for the cells the scan
000890r 2               ;   found, and from EffectHit for every cell an effect takes. Three outcomes:
000890r 2               ;
000890r 2               ;     a prism   pays BONUS_PRISM here and now and is never queued: it has no
000890r 2               ;               effect to fire, only a bonus (SPEC 7.3)
000890r 2               ;     a star    counts into StarCount and is never queued either — SPEC 8
000890r 2               ;               step 3 is explicit that stars are counted, not queued
000890r 2               ;     the rest  go on the queue, and pay their trigger bonus when they pop
000890r 2               ;
000890r 2               ;   THE COLOUR IS TESTED BEFORE THE GLYPH, and that order is not cosmetic. A
000890r 2               ;   prism is glyph 0 of colour 6, indistinguishable from a plain potion by its
000890r 2               ;   glyph alone — and from P6 onward the board may hold any of the prism's four
000890r 2               ;   idle rotation frames, whose low three bits read as a bolt or a bomb and
000890r 2               ;   would detonate one. Colour 6 is the only test that stays true.
000890r 2               ; -----------------------------------------------------------------------------
000890r 2               EffectEnqueue:
000890r 2  BD rr rr       lda Board,x
000893r 2  29 F8          and #COLOR_MASK
000895r 2  C9 70          cmp #WILD_BASE
000897r 2  F0 12          beq @Prism
000899r 2  BD rr rr       lda Board,x
00089Cr 2  29 07          and #GLYPH_MASK
00089Er 2  F0 0A          beq @Done                     ; A plain potion, which is most of the board
0008A0r 2  C9 04          cmp #GLYPH_STAR
0008A2r 2  F0 0A          beq @Star
0008A4r 2  B0 04          bcs @Done                     ; Glyphs 5-7 are animation frames (SPEC 4.4),
0008A6r 2                                               ;   never reagents
0008A6r 2  8A             txa
0008A7r 2  4C rr rr       jmp EffectQPush               ; Fireball, bolt or bomb — glyphs 1 to 3
0008AAr 2               @Done:
0008AAr 2  60             rts
0008ABr 2               @Prism:
0008ABr 2  4C rr rr       jmp EffectPrism               ; Both of these are the far side of the three
0008AEr 2               @Star:                          ;   detonations below, well out of branch range
0008AEr 2  4C rr rr       jmp EffectStar
0008B1r 2               
0008B1r 2               ; -----------------------------------------------------------------------------
0008B1r 2               ;   EffectHit — one cell of one detonation
0008B1r 2               ;   In:  X = board index
0008B1r 2               ;   Out: nothing.  Modifies: A, X, Y
0008B1r 2               ;
0008B1r 2               ;   The whole of SPEC 8 step 4's inner loop, which is why every effect below
0008B1r 2               ;   is nothing but a list of cells to offer it.
0008B1r 2               ;
0008B1r 2               ;   A cell that is empty, a wall, or already marked is not a target. "Not
0008B1r 2               ;   already marked" is what makes the queue terminate and what stops a cell
0008B1r 2               ;   being paid for twice; testing the WALL here is what lets the walks above
0008B1r 2               ;   run over the two sentinel columns without bounds checks of their own. A
0008B1r 2               ;   marked sentinel would be zeroed by CascadeRemove and the well would grow
0008B1r 2               ;   a hole in its floor.
0008B1r 2               ; -----------------------------------------------------------------------------
0008B1r 2               EffectHit:
0008B1r 2  BD rr rr       lda Board,x
0008B4r 2  F0 1A          beq @Done                     ; Empty
0008B6r 2  C9 FF          cmp #TILE_WALL
0008B8r 2  F0 16          beq @Done                     ; A sentinel is never a target
0008BAr 2  8A             txa
0008BBr 2  48             pha
0008BCr 2  20 rr rr       jsr MarkTest
0008BFr 2  68             pla
0008C0r 2  AA             tax                           ; Neither PLA nor TAX touches C
0008C1r 2  B0 0D          bcs @Done                     ; Already going
0008C3r 2               
0008C3r 2  8A             txa
0008C4r 2  48             pha                           ; MarkSet takes the index in A, which PHA left
0008C5r 2  20 rr rr       jsr MarkSet                   ;   alone
0008C8r 2  20 rr rr       jsr EffectScoreCell           ; SPEC 9.2, per cell an effect took
0008CBr 2  68             pla
0008CCr 2  AA             tax
0008CDr 2  4C rr rr       jmp EffectEnqueue             ; ...and if it was a reagent, it fires too
0008D0r 2               @Done:
0008D0r 2  60             rts
0008D1r 2               
0008D1r 2               ; -----------------------------------------------------------------------------
0008D1r 2               ;   EffectScoreCell — EffectValue[chain] for one cell taken by an effect
0008D1r 2               ;   Out: nothing.  Modifies: A, X, Y
0008D1r 2               ;   SPEC 9.2 — deliberately dearer than a matched tile at low chain depth, so
0008D1r 2               ;   that the first reagent a player ever sets off feels better than plain play.
0008D1r 2               ; -----------------------------------------------------------------------------
0008D1r 2               EffectScoreCell:
0008D1r 2  AE rr rr       ldx ChainStep
0008D4r 2  CA             dex                           ; Indexed by chain - 1 ...
0008D5r 2  E0 08          cpx #8
0008D7r 2  90 02          bcc @Chain
0008D9r 2  A2 07          ldx #7                        ;   ... and flattens out at 8
0008DBr 2               @Chain:
0008DBr 2  BD rr rr       lda EffectValueLo,x
0008DEr 2  48             pha
0008DFr 2  BD rr rr       lda EffectValueHi,x
0008E2r 2  AA             tax
0008E3r 2  68             pla
0008E4r 2  4C rr rr       jmp CascadeAdd
0008E7r 2               
0008E7r 2               ; -----------------------------------------------------------------------------
0008E7r 2               ;   EffectResolve — drain the queue (SPEC 8 step 4)
0008E7r 2               ;   Out: nothing.  Modifies: A, X, Y, Effect*, Marks, Cascade*, StarCount
0008E7r 2               ;
0008E7r 2               ;   The detonation runs first and the trigger bonus is paid on the way back,
0008E7r 2               ;   which is the order SPEC 8 step 4 sets out. It makes no difference to the
0008E7r 2               ;   total — everything lands in the same accumulator — but it does mean the
0008E7r 2               ;   glyph has to survive a routine that clobbers all three registers, and the
0008E7r 2               ;   stack is the cheapest place to put it.
0008E7r 2               ; -----------------------------------------------------------------------------
0008E7r 2               EffectResolve:
0008E7r 2               @Loop:
0008E7r 2  20 rr rr       jsr EffectQPop
0008EAr 2  90 45          bcc @Done                     ; Empty — the step is finished
0008ECr 2               
0008ECr 2  AA             tax                           ; X = the detonating cell
0008EDr 2  BD rr rr       lda Board,x                   ; Still on the board: step 6 has not run
0008F0r 2  29 07          and #GLYPH_MASK
0008F2r 2  48             pha
0008F3r 2  C9 01          cmp #GLYPH_FIREBALL
0008F5r 2  F0 0F          beq @Fireball
0008F7r 2  C9 02          cmp #GLYPH_BOLT
0008F9r 2  F0 20          beq @Bolt
0008FBr 2               
0008FBr 2  A9 07          lda #SFX_BOMB                 ; Glyph 3 — nothing else ever reaches here
0008FDr 2  20 rr rr       jsr SfxPlay
000900r 2  20 rr rr       jsr EffectBomb
000903r 2  4C rr rr       jmp @Bonus
000906r 2               
000906r 2               @Fireball:
000906r 2  A9 05          lda #SFX_FIREBALL
000908r 2  20 rr rr       jsr SfxPlay
00090Br 2  BD rr rr       lda Board,x
00090Er 2  29 F8          and #COLOR_MASK               ; Its own colour, which can never be wild
000910r 2  48             pha
000911r 2  20 rr rr       jsr HalColorFlash             ; SPEC 4.6, 14 — every tile of that colour goes
000914r 2  68             pla                           ;   white for the glow window, which is one VDP
000915r 2                                               ;   colour byte here and one compare a cell on
000915r 2                                               ;   the Commodores. AnimGlowBegin reads
000915r 2                                               ;   TintColor to find out that it happened
000915r 2  20 rr rr       jsr EffectFireball
000918r 2  4C rr rr       jmp @Bonus
00091Br 2               
00091Br 2               @Bolt:
00091Br 2  A9 06          lda #SFX_BOLT
00091Dr 2  20 rr rr       jsr SfxPlay
000920r 2  20 rr rr       jsr EffectBolt
000923r 2               
000923r 2               @Bonus:
000923r 2  68             pla
000924r 2  A8             tay                           ; TriggerBonus is indexed by glyph (SPEC 9.5),
000925r 2  B9 rr rr       lda TriggerBonusLo,y          ;   and is paid however the reagent was removed
000928r 2  BE rr rr       ldx TriggerBonusHi,y
00092Br 2  20 rr rr       jsr CascadeAdd
00092Er 2  4C rr rr       jmp @Loop
000931r 2               @Done:
000931r 2  60             rts
000932r 2               
000932r 2               ; -----------------------------------------------------------------------------
000932r 2               ;   The five reagents (SPEC 7.3). Each lists the cells it reaches and leaves
000932r 2               ;   the marking, the scoring and the chain reaction to EffectHit.
000932r 2               ; -----------------------------------------------------------------------------
000932r 2               
000932r 2               ; -----------------------------------------------------------------------------
000932r 2               ;   EffectFireball — every remaining tile of one colour, board wide
000932r 2               ;   In:  A = the colour key ($40 to $68)
000932r 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectArg, Marks, Cascade*
000932r 2               ;   SPEC 7.3 — the signature reagent, and the reason a chain goes three deep.
000932r 2               ;
000932r 2               ;   PRISMS ARE IMMUNE AND IT COSTS NOTHING TO MAKE THEM SO (SPEC 7.4). A prism
000932r 2               ;   is colour 6 and a fireball's colour never is, so the compare below is the
000932r 2               ;   immunity — there is no special case to forget. An empty cell and a wall
000932r 2               ;   fail it for the same reason, which is why this walks all eight columns of
000932r 2               ;   every row rather than stepping over the sentinels.
000932r 2               ;
000932r 2               ;   The fireball's own cell is already marked, so it is not a target of itself,
000932r 2               ;   and a second fireball of the same colour in the same step finds nothing
000932r 2               ;   left to take — and still pays its trigger bonus (SPEC 7.3).
000932r 2               ; -----------------------------------------------------------------------------
000932r 2               EffectFireball:
000932r 2  85 rr          sta EffectArg                 ; The colour it is hunting
000934r 2  A9 00          lda #0
000936r 2  85 rr          sta EffectIdx
000938r 2               @Cell:
000938r 2  A6 rr          ldx EffectIdx
00093Ar 2  BD rr rr       lda Board,x
00093Dr 2  29 F8          and #COLOR_MASK
00093Fr 2  C5 rr          cmp EffectArg
000941r 2  D0 03          bne @Next
000943r 2  20 rr rr       jsr EffectHit
000946r 2               @Next:
000946r 2  E6 rr          inc EffectIdx
000948r 2  A5 rr          lda EffectIdx
00094Ar 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
00094Cr 2  90 EA          bcc @Cell
00094Er 2  60             rts
00094Fr 2               
00094Fr 2               ; -----------------------------------------------------------------------------
00094Fr 2               ;   EffectBolt — the whole row and the whole column through the bolt's cell
00094Fr 2               ;   In:  X = board index
00094Fr 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectEnd, EffectArg, Marks
00094Fr 2               ;   SPEC 7.3 — up to 6 + 16 - 1 = 21 cells, and the only reagent that reaches
00094Fr 2               ;   something buried at the bottom of a column.
00094Fr 2               ;
00094Fr 2               ;   Neither walk needs clipping: a row is six cells wherever it is, and a
00094Fr 2               ;   column is sixteen. The bolt's own cell is offered twice, once by each, and
00094Fr 2               ;   is refused both times because it was marked before this was called.
00094Fr 2               ; -----------------------------------------------------------------------------
00094Fr 2               EffectBolt:
00094Fr 2  8A             txa
000950r 2  29 07          and #(BOARD_STRIDE - 1)
000952r 2  85 rr          sta EffectArg                 ; Its column, for the second walk
000954r 2  8A             txa
000955r 2  29 F8          and #(256 - BOARD_STRIDE)     ; $F8 — its row base
000957r 2  85 rr          sta EffectIdx
000959r 2  18             clc
00095Ar 2  69 06          adc #BOARD_W
00095Cr 2  85 rr          sta EffectEnd                 ; One past the row's last playfield cell
00095Er 2               @Row:
00095Er 2  A6 rr          ldx EffectIdx
000960r 2  20 rr rr       jsr EffectHit
000963r 2  E6 rr          inc EffectIdx
000965r 2  A5 rr          lda EffectIdx
000967r 2  C5 rr          cmp EffectEnd
000969r 2  90 F3          bcc @Row
00096Br 2               
00096Br 2  A5 rr          lda EffectArg                 ; The column, row 0 downward
00096Dr 2  85 rr          sta EffectIdx
00096Fr 2               @Col:
00096Fr 2  A6 rr          ldx EffectIdx
000971r 2  20 rr rr       jsr EffectHit
000974r 2  A5 rr          lda EffectIdx
000976r 2  18             clc
000977r 2  69 08          adc #BOARD_STRIDE
000979r 2  85 rr          sta EffectIdx
00097Br 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
00097Dr 2  90 F0          bcc @Col
00097Fr 2  60             rts
000980r 2               
000980r 2               ; -----------------------------------------------------------------------------
000980r 2               ;   EffectBomb — the 3 x 3 block centred on the bomb, clipped at the edges
000980r 2               ;   In:  X = board index
000980r 2               ;   Out: nothing.  Modifies: A, X, Y, Effect*, Tmp0, Tmp1, Marks, Cascade*
000980r 2               ;   SPEC 7.3 — up to 9 cells, and the reagent most likely to catch another.
000980r 2               ;
000980r 2               ;   BOTH SPANS ARE CLIPPED, and the row span has to be: row 0 minus one row is
000980r 2               ;   index minus 8, which underflows a byte and reads the BSS in front of a
000980r 2               ;   page-aligned Board. The column span could lean on the sentinels the way
000980r 2               ;   every other walk in the game does — except at row 0, column 0, where
000980r 2               ;   "one to the left" is index $FF and off the end of the board. Clipping both
000980r 2               ;   is smaller than special-casing one corner.
000980r 2               ;
000980r 2               ;   Tmp0 and Tmp1 are finished with before the first JSR, which is what the
000980r 2               ;   rule about them says (zeropage.inc).
000980r 2               ; -----------------------------------------------------------------------------
000980r 2               EffectBomb:
000980r 2  8A             txa                           ; --- the column span ---
000981r 2  29 07          and #(BOARD_STRIDE - 1)
000983r 2  A8             tay
000984r 2  F0 01          beq @Left                     ; Column 0 — the block starts there
000986r 2  88             dey
000987r 2               @Left:
000987r 2  84 rr          sty Tmp0                      ; First column of the block
000989r 2  8A             txa
00098Ar 2  29 07          and #(BOARD_STRIDE - 1)
00098Cr 2  C9 05          cmp #(BOARD_W - 1)
00098Er 2  B0 02          bcs @Right                    ; Already against the right wall
000990r 2  69 01          adc #1                        ; C is clear — the CMP above failed
000992r 2               @Right:
000992r 2  85 rr          sta EffectArg                 ; Last column of the block
000994r 2               
000994r 2  8A             txa                           ; --- the row span ---
000995r 2  29 F8          and #(256 - BOARD_STRIDE)
000997r 2  85 rr          sta Tmp1                      ; The bomb's own row base
000999r 2  F0 03          beq @Top                      ; Row 0 — the block starts there
00099Br 2  38             sec
00099Cr 2  E9 08          sbc #BOARD_STRIDE
00099Er 2               @Top:
00099Er 2  18             clc
00099Fr 2  65 rr          adc Tmp0
0009A1r 2  85 rr          sta EffectRow                 ; First cell of the block's first row
0009A3r 2               
0009A3r 2  A5 rr          lda Tmp1
0009A5r 2  C9 78          cmp #((BOARD_H - 1) * BOARD_STRIDE)
0009A7r 2  B0 03          bcs @Bottom                   ; Row 15 — the block ends there
0009A9r 2  18             clc
0009AAr 2  69 08          adc #BOARD_STRIDE
0009ACr 2               @Bottom:
0009ACr 2  18             clc
0009ADr 2  65 rr          adc Tmp0
0009AFr 2  85 rr          sta EffectEnd                 ; First cell of the block's LAST row
0009B1r 2               
0009B1r 2               @Rows:
0009B1r 2  A5 rr          lda EffectRow
0009B3r 2  85 rr          sta EffectIdx
0009B5r 2               @Cell:
0009B5r 2  A6 rr          ldx EffectIdx
0009B7r 2  20 rr rr       jsr EffectHit
0009BAr 2  A5 rr          lda EffectIdx
0009BCr 2  29 07          and #(BOARD_STRIDE - 1)
0009BEr 2  C5 rr          cmp EffectArg
0009C0r 2  E6 rr          inc EffectIdx                 ; INC touches N and Z only, so the CMP's carry
0009C2r 2  90 F1          bcc @Cell                     ;   is still the one being branched on
0009C4r 2               
0009C4r 2  A5 rr          lda EffectRow
0009C6r 2  C5 rr          cmp EffectEnd
0009C8r 2  B0 07          bcs @Done                     ; That was the last row of the block
0009CAr 2  18             clc
0009CBr 2  69 08          adc #BOARD_STRIDE
0009CDr 2  85 rr          sta EffectRow
0009CFr 2  D0 E0          bne @Rows                     ; Always — a row base past the first is >= 8
0009D1r 2               @Done:
0009D1r 2  60             rts
0009D2r 2               
0009D2r 2               ; -----------------------------------------------------------------------------
0009D2r 2               ;   EffectStar — removes nothing; it multiplies (SPEC 7.3)
0009D2r 2               ;   Out: nothing.  Modifies: A
0009D2r 2               ;
0009D2r 2               ;   The cap is not applied here. SPEC 9.6 doubles the WHOLE cascade up to three
0009D2r 2               ;   times at the end, so the count has to survive to CascadeSettle, which is
0009D2r 2               ;   where min(StarCount, STAR_SHIFT_CAP) is taken. A cascade cannot remove more
0009D2r 2               ;   than the 96 cells of the well, so the count cannot wrap on its way there.
0009D2r 2               ; -----------------------------------------------------------------------------
0009D2r 2               EffectStar:
0009D2r 2  EE rr rr       inc StarCount
0009D5r 2  A9 08          lda #SFX_STAR
0009D7r 2  20 rr rr       jsr SfxPlay
0009DAr 2  60             rts
0009DBr 2               
0009DBr 2               ; -----------------------------------------------------------------------------
0009DBr 2               ;   EffectPrism — removes nothing; a flat bonus per prism cleared (SPEC 9.5)
0009DBr 2               ;   Out: nothing.  Modifies: A, X
0009DBr 2               ;
0009DBr 2               ;   It goes through CascadeAdd and not ScoreAward, so a star in the same
0009DBr 2               ;   cascade doubles it: SPEC 9.6 exempts only the soft drop and the level
0009DBr 2               ;   bonus from the multiplier (D5, D18).
0009DBr 2               ; -----------------------------------------------------------------------------
0009DBr 2               EffectPrism:
0009DBr 2  A9 09          lda #SFX_PRISM
0009DDr 2  20 rr rr       jsr SfxPlay
0009E0r 2  A9 00          lda #<BONUS_PRISM
0009E2r 2  A2 04          ldx #>BONUS_PRISM
0009E4r 2  4C rr rr       jmp CascadeAdd
0009E7r 2               
0009E7r 2               ; -----------------------------------------------------------------------------
0009E7r 2               ;   The effect queue — a ring of board indices, one byte an entry.
0009E7r 2               ;
0009E7r 2               ;   The board still holds every pending reagent when its entry pops, because
0009E7r 2               ;   nothing is zeroed until step 6, so the glyph and the colour SPEC 8 packs
0009E7r 2               ;   into the entry are one `lda Board,x` away and storing them again would be
0009E7r 2               ;   storing a copy of the board (constants.inc).
0009E7r 2               ;
0009E7r 2               ;   Head and tail are entry numbers; the ring keeps one slot free, so it holds
0009E7r 2               ;   EFFECTQ_ENTRIES - 1. On overflow the effect is DROPPED and the cascade
0009E7r 2               ;   carries on (D6) — the cell is still marked, still scored and still removed,
0009E7r 2               ;   it simply does not detonate. With at most one reagent a piece, 47 pending
0009E7r 2               ;   detonations is not somewhere a real board goes.
0009E7r 2               ; -----------------------------------------------------------------------------
0009E7r 2               EffectQClear:
0009E7r 2  A9 00          lda #0
0009E9r 2  8D rr rr       sta EffectQHead
0009ECr 2  8D rr rr       sta EffectQTail
0009EFr 2  60             rts
0009F0r 2               
0009F0r 2               ; -----------------------------------------------------------------------------
0009F0r 2               ;   EffectQPush — In: A = board index.  Modifies: A, X, Y
0009F0r 2               ; -----------------------------------------------------------------------------
0009F0r 2               EffectQPush:
0009F0r 2  AE rr rr       ldx EffectQTail
0009F3r 2  AC rr rr       ldy EffectQTail
0009F6r 2  C8             iny
0009F7r 2  C0 30          cpy #EFFECTQ_ENTRIES
0009F9r 2  90 02          bcc @Store
0009FBr 2  A0 00          ldy #0                        ; Wrap
0009FDr 2               @Store:
0009FDr 2  CC rr rr       cpy EffectQHead
000A00r 2  F0 06          beq @Full                     ; One slot free is the ring being full
000A02r 2  9D rr rr       sta EffectQ,x
000A05r 2  8C rr rr       sty EffectQTail
000A08r 2               @Full:
000A08r 2  60             rts
000A09r 2               
000A09r 2               ; -----------------------------------------------------------------------------
000A09r 2               ;   EffectQPop — Out: C set and A = board index; C clear when empty
000A09r 2               ;   Modifies: A, X
000A09r 2               ; -----------------------------------------------------------------------------
000A09r 2               EffectQPop:
000A09r 2  AE rr rr       ldx EffectQHead
000A0Cr 2  EC rr rr       cpx EffectQTail
000A0Fr 2  F0 0F          beq @Empty
000A11r 2  BD rr rr       lda EffectQ,x
000A14r 2  E8             inx
000A15r 2  E0 30          cpx #EFFECTQ_ENTRIES
000A17r 2  90 02          bcc @Store
000A19r 2  A2 00          ldx #0                        ; Wrap
000A1Br 2               @Store:
000A1Br 2  8E rr rr       stx EffectQHead
000A1Er 2  38             sec
000A1Fr 2  60             rts
000A20r 2               @Empty:
000A20r 2  18             clc
000A21r 2  60             rts
000A22r 2               
000A22r 1               .include "../src/anim.asm"
000A22r 2               ; =============================================================================
000A22r 2               ;   anim.asm — Wizards Lab, the animations a clear is made of
000A22r 2               ; =============================================================================
000A22r 2               ;   SPEC.md section 14, and step 5 of SPEC 8. Everything here is a frame's
000A22r 2               ;   worth of work and then a return: nothing waits, nothing loops on a timer,
000A22r 2               ;   and the main loop never stops for any of it (D4).
000A22r 2               ;
000A22r 2               ;   A CLEAR STEP ANIMATES IN TWO WINDOWS, and every event SPEC 14 lists lands
000A22r 2               ;   inside one of them:
000A22r 2               ;
000A22r 2               ;     PLAY_GLOW      matched cells wear glyph +6 of their own colour, the
000A22r 2               ;                    bolt's beams lie over its row and column, and the
000A22r 2               ;                    fireball's colour is white board-wide. GlowFrames, or the
000A22r 2               ;                    longer FlashFrames when a fireball fired
000A22r 2               ;     PLAY_SHATTER   the removal ring opens outward over every marked cell,
000A22r 2               ;                    two frames a tile, with a marked prism's blip-out closing
000A22r 2               ;                    inward beside it. SHATTER_STEPS ring frames, or the
000A22r 2               ;                    prism's BLIP_STEPS when there is one
000A22r 2               ;
000A22r 2               ;   A window is as long as the LONGEST thing in it, which is the one rule that
000A22r 2               ;   makes the durations in SPEC 14 hold without a timer per effect.
000A22r 2               ;
000A22r 2               ;   THE BOARD IS UNTOUCHED THE WHOLE TIME. Marked cells are not zeroed until
000A22r 2               ;   CascadeRemove runs at the end of the shatter (SPEC 8 step 6), so every
000A22r 2               ;   routine below can read a cell to find out what it is while drawing
000A22r 2               ;   something else entirely over it — which is also what let P5 make an effect
000A22r 2               ;   queue entry one byte (cascade.asm). Nothing here writes Board except the
000A22r 2               ;   prism's idle rotation and the game-over petrify, both of which change what
000A22r 2               ;   a cell IS and not merely what it shows.
000A22r 2               ;
000A22r 2               ;   THE COLOUR IS TESTED BEFORE THE GLYPH, everywhere, for the reason P5 found
000A22r 2               ;   the hard way: a prism is glyph 0 of colour 6 and, now that it rotates, its
000A22r 2               ;   board byte is WILD_BASE + 0..3, whose low three bits read as a bolt or a
000A22r 2               ;   bomb. Colour 6 is the only test that stays true.
000A22r 2               ; =============================================================================
000A22r 2               
000A22r 2               ANIM_GLOW           = 0         ; The four passes AnimMarked can make over the
000A22r 2               ANIM_BEAM           = 1         ;   marked cells. AnimMode picks one; the walk
000A22r 2               ANIM_UNBEAM         = 2         ;   itself is the same 30 bytes for all four
000A22r 2               ANIM_SHATTER        = 3         ;   and is written once.
000A22r 2               
000A22r 2               ; -----------------------------------------------------------------------------
000A22r 2               ;   AnimMarked — run one pass over every marked cell
000A22r 2               ;   In:  A = ANIM_*      Out: nothing.  Modifies: A, X, Y, Anim*, and whatever
000A22r 2               ;        the pass itself touches
000A22r 2               ;
000A22r 2               ;   The same walk as EffectEnqueueMarked (cascade.asm) and for the same reason:
000A22r 2               ;   MARKS is the union of everything the step is taking, and a cell in a
000A22r 2               ;   horizontal run AND a vertical one appears in it once. Marks are read only
000A22r 2               ;   here — no pass sets one — so the bitmap cannot change underneath the walk.
000A22r 2               ;
000A22r 2               ;   The cursor is in memory rather than in X because everything the passes call
000A22r 2               ;   ends at RenderMark, which clobbers A and X (D13).
000A22r 2               ; -----------------------------------------------------------------------------
000A22r 2               AnimMarked:
000A22r 2  85 rr          sta AnimMode
000A24r 2  A9 00          lda #0
000A26r 2  85 rr          sta AnimIdx
000A28r 2               @Row:
000A28r 2  A5 rr          lda AnimIdx
000A2Ar 2  4A             lsr a
000A2Br 2  4A             lsr a
000A2Cr 2  4A             lsr a
000A2Dr 2  A8             tay
000A2Er 2  B9 rr rr       lda Marks,y
000A31r 2  F0 20          beq @NextRow                  ; Nothing marked in this row, which is most
000A33r 2                                               ;   rows of most steps
000A33r 2               @Cell:
000A33r 2  A5 rr          lda AnimIdx
000A35r 2  20 rr rr       jsr MarkTest
000A38r 2  90 05          bcc @NextCell
000A3Ar 2  A6 rr          ldx AnimIdx
000A3Cr 2  20 rr rr       jsr AnimCell
000A3Fr 2               @NextCell:
000A3Fr 2  E6 rr          inc AnimIdx
000A41r 2  A5 rr          lda AnimIdx
000A43r 2  29 07          and #(BOARD_STRIDE - 1)
000A45r 2  C9 06          cmp #BOARD_W
000A47r 2  90 EA          bcc @Cell
000A49r 2               
000A49r 2  A5 rr          lda AnimIdx                   ; On the row's first sentinel column; step
000A4Br 2  18             clc                           ;   over both of them
000A4Cr 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000A4Er 2  85 rr          sta AnimIdx
000A50r 2  4C rr rr       jmp @Test
000A53r 2               
000A53r 2               @NextRow:
000A53r 2  A5 rr          lda AnimIdx
000A55r 2  18             clc
000A56r 2  69 08          adc #BOARD_STRIDE
000A58r 2  85 rr          sta AnimIdx
000A5Ar 2               @Test:
000A5Ar 2  A5 rr          lda AnimIdx
000A5Cr 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000A5Er 2  90 C8          bcc @Row
000A60r 2  60             rts
000A61r 2               
000A61r 2               ; -----------------------------------------------------------------------------
000A61r 2               ;   AnimCell — one marked cell, in whichever pass is running
000A61r 2               ;   In:  X = board index, AnimMode      Out: nothing.  Modifies: A, X, Y
000A61r 2               ; -----------------------------------------------------------------------------
000A61r 2               AnimCell:
000A61r 2  A5 rr          lda AnimMode
000A63r 2  F0 1A          beq AnimCellGlow
000A65r 2  C9 03          cmp #ANIM_SHATTER
000A67r 2  F0 2A          beq AnimCellShatter
000A69r 2                 ; falls through into the two beam passes, which are the same test
000A69r 2               
000A69r 2               ; -----------------------------------------------------------------------------
000A69r 2               ;   AnimCellBolt — is this cell a bolt? If so, draw or undraw its cross
000A69r 2               ;   In:  X = board index      Out: nothing.  Modifies: A, X, Y, Anim*
000A69r 2               ;
000A69r 2               ;   The beams are their own pass and not a case inside the glow, because a
000A69r 2               ;   beam goes OVER a glow: a cell in a bolt's row is very often also a matched
000A69r 2               ;   cell, and both have to be drawn in that order.
000A69r 2               ; -----------------------------------------------------------------------------
000A69r 2               AnimCellBolt:
000A69r 2  BD rr rr       lda Board,x
000A6Cr 2  29 F8          and #COLOR_MASK
000A6Er 2  C9 70          cmp #WILD_BASE
000A70r 2  F0 0C          beq @Done                     ; Colour before glyph: a rotating prism's low
000A72r 2                                               ;   three bits say "bolt" and it is not one
000A72r 2  BD rr rr       lda Board,x
000A75r 2  29 07          and #GLYPH_MASK
000A77r 2  C9 02          cmp #GLYPH_BOLT
000A79r 2  D0 03          bne @Done
000A7Br 2  4C rr rr       jmp AnimBeam
000A7Er 2               @Done:
000A7Er 2  60             rts
000A7Fr 2               
000A7Fr 2               ; -----------------------------------------------------------------------------
000A7Fr 2               ;   AnimCellGlow — glyph +6 of the cell's own colour (SPEC 14)
000A7Fr 2               ;   In:  X = board index      Out: nothing.  Modifies: A, X, Y, AnimSteps
000A7Fr 2               ;
000A7Fr 2               ;   A MARKED PRISM SITS THE GLOW OUT. Group 14's slot +6 is an arrow, not a
000A7Fr 2               ;   glow (SPEC A.3), so `WILD_BASE + GLYPH_GLOW` must never be constructed —
000A7Fr 2               ;   the prism holds whatever rotation frame it was on and blips out later
000A7Fr 2               ;   instead. Meeting one here is also how the shatter window learns it has to
000A7Fr 2               ;   run BLIP_STEPS rather than SHATTER_STEPS, which saves a second walk.
000A7Fr 2               ; -----------------------------------------------------------------------------
000A7Fr 2               AnimCellGlow:
000A7Fr 2  BD rr rr       lda Board,x
000A82r 2  29 F8          and #COLOR_MASK
000A84r 2  C9 70          cmp #WILD_BASE
000A86r 2  F0 05          beq @Prism
000A88r 2  09 06          ora #GLYPH_GLOW               ; The colour key's low three bits are clear, so
000A8Ar 2  4C rr rr       jmp RenderCellAs              ;   an ORA is the whole conversion (SPEC 4.2)
000A8Dr 2               @Prism:
000A8Dr 2  A9 05          lda #BLIP_STEPS
000A8Fr 2  8D rr rr       sta AnimSteps
000A92r 2  60             rts
000A93r 2               
000A93r 2               ; -----------------------------------------------------------------------------
000A93r 2               ;   AnimCellShatter — the ring frame this cell is showing right now
000A93r 2               ;   In:  X = board index, AnimStep      Out: nothing.  Modifies: A, X, Y
000A93r 2               ;   SPEC 14, Appendix A.3 — one ring, opening outward for everything except a
000A93r 2               ;   prism, which runs it closed inward.
000A93r 2               ; -----------------------------------------------------------------------------
000A93r 2               AnimCellShatter:
000A93r 2  BD rr rr       lda Board,x
000A96r 2  29 F8          and #COLOR_MASK
000A98r 2  C9 70          cmp #WILD_BASE
000A9Ar 2  F0 0D          beq @Blip
000A9Cr 2  AC rr rr       ldy AnimStep
000A9Fr 2  C0 04          cpy #(SHATTER_STEPS + 1)
000AA1r 2  B0 0F          bcs @Done                     ; The ring is spent and the cell already blank.
000AA3r 2  B9 rr rr       lda VfxShatter,y              ;   Only reachable while a prism holds the
000AA6r 2  4C rr rr       jmp RenderCellAs              ;   window open for its last two frames
000AA9r 2               @Blip:
000AA9r 2  AC rr rr       ldy AnimStep
000AACr 2  B9 rr rr       lda VfxBlip,y
000AAFr 2  4C rr rr       jmp RenderCellAs
000AB2r 2               @Done:
000AB2r 2  60             rts
000AB3r 2               
000AB3r 2               ; -----------------------------------------------------------------------------
000AB3r 2               ;   AnimBeam — the bolt's beams, along its whole row and its whole column
000AB3r 2               ;   In:  X = board index of the bolt; AnimIdx holds the same index, because
000AB3r 2               ;        this is only ever reached from AnimMarked's cursor
000AB3r 2               ;   Out: nothing.  Modifies: A, X, Y, AnimCur, AnimEnd, AnimArg
000AB3r 2               ;   SPEC 14, Appendix A.3.
000AB3r 2               ;
000AB3r 2               ;   The beams cover EVERY cell of the row and the column, empty ones included.
000AB3r 2               ;   A beam has to butt against its neighbours to read as a beam, and the cells
000AB3r 2               ;   the bolt found empty were never marked — so those are also the cells the
000AB3r 2               ;   ANIM_UNBEAM pass exists to put back, since nothing else would ever draw
000AB3r 2               ;   them again.
000AB3r 2               ;
000AB3r 2               ;   The cross goes down last, over both walks, because it is the one cell that
000AB3r 2               ;   belongs to each.
000AB3r 2               ; -----------------------------------------------------------------------------
000AB3r 2               AnimBeam:
000AB3r 2  8A             txa
000AB4r 2  29 07          and #(BOARD_STRIDE - 1)
000AB6r 2  85 rr          sta AnimArg                   ; Its column, for the second walk
000AB8r 2  8A             txa
000AB9r 2  29 F8          and #(256 - BOARD_STRIDE)     ; $F8 — its row base
000ABBr 2  85 rr          sta AnimCur
000ABDr 2  18             clc
000ABEr 2  69 06          adc #BOARD_W
000AC0r 2  85 rr          sta AnimEnd                   ; One past the row's last playfield cell
000AC2r 2               @Row:
000AC2r 2  A6 rr          ldx AnimCur
000AC4r 2  A9 3B          lda #VFX_BEAM_H
000AC6r 2  20 rr rr       jsr AnimBeamCell
000AC9r 2  E6 rr          inc AnimCur
000ACBr 2  A5 rr          lda AnimCur
000ACDr 2  C5 rr          cmp AnimEnd
000ACFr 2  90 F1          bcc @Row
000AD1r 2               
000AD1r 2  A5 rr          lda AnimArg                   ; The column, row 0 downward
000AD3r 2  85 rr          sta AnimCur
000AD5r 2               @Col:
000AD5r 2  A6 rr          ldx AnimCur
000AD7r 2  A9 3C          lda #VFX_BEAM_V
000AD9r 2  20 rr rr       jsr AnimBeamCell
000ADCr 2  A5 rr          lda AnimCur
000ADEr 2  18             clc
000ADFr 2  69 08          adc #BOARD_STRIDE
000AE1r 2  85 rr          sta AnimCur
000AE3r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000AE5r 2  90 EE          bcc @Col
000AE7r 2               
000AE7r 2  A6 rr          ldx AnimIdx                   ; The bolt's own cell. The outer walk is still
000AE9r 2  A9 3D          lda #VFX_BEAM_CROSS           ;   standing on it, which is cheaper than
000AEBr 2                 ; falls through                ;   keeping a copy across both walks
000AEBr 2               
000AEBr 2               ; -----------------------------------------------------------------------------
000AEBr 2               ;   AnimBeamCell — one cell of a beam, drawn or put back
000AEBr 2               ;   In:  X = board index, A = beam tile      Modifies: A, X, Y
000AEBr 2               ;
000AEBr 2               ;   On the way back only the cells that are NOT marked need anything: the
000AEBr 2               ;   marked ones are about to be drawn by the shatter, twice a frame apart, and
000AEBr 2               ;   drawing them here as well would only queue two marks for one cell.
000AEBr 2               ;
000AEBr 2               ;   THE RESTORE IS THE ONE MARK IN THE WHOLE ANIMATION THAT CANNOT BE DROPPED.
000AEBr 2               ;   Every other one is made again within a few frames — a lost glow is covered
000AEBr 2               ;   by the shatter six frames later, a lost ring frame by CascadeRemove at the
000AEBr 2               ;   end of it — but a beam laid over an EMPTY cell has nothing behind it that
000AEBr 2               ;   anything will ever draw again, and D6's drop-on-overflow would leave a
000AEBr 2               ;   white beam sitting in the well for the rest of the game. Five bolts in one
000AEBr 2               ;   run put 110 beam cells through here against a 64-entry ring, so this is
000AEBr 2               ;   reachable and not theoretical. It takes the same way out CascadeRemove
000AEBr 2               ;   does: the whole-well redraw cursor, which repaints every one of them from
000AEBr 2               ;   the board (D12).
000AEBr 2               ; -----------------------------------------------------------------------------
000AEBr 2               AnimBeamCell:
000AEBr 2  A4 rr          ldy AnimMode
000AEDr 2  C0 01          cpy #ANIM_BEAM
000AEFr 2  D0 03          bne @Restore
000AF1r 2  4C rr rr       jmp RenderCellAs
000AF4r 2               @Restore:
000AF4r 2  8A             txa
000AF5r 2  48             pha                           ; MarkTest takes the index in A and clobbers
000AF6r 2  20 rr rr       jsr MarkTest                  ;   X; neither PLA nor TAX touches C
000AF9r 2  68             pla
000AFAr 2  AA             tax
000AFBr 2  B0 0D          bcs @Done                     ; Marked — the shatter has it
000AFDr 2  AD rr rr       lda DirtyCount
000B00r 2  C9 40          cmp #DIRTY_ENTRIES
000B02r 2  B0 03          bcs @Bulk                     ; No room, and this cell must not be lost
000B04r 2  4C rr rr       jmp RenderCell                ; Board,x — empty, in every case that gets here
000B07r 2               @Bulk:
000B07r 2  4C rr rr       jmp RenderBoard               ; Sets the cursor and nothing else; the cells
000B0Ar 2                                               ;   already queued still land and the redraw
000B0Ar 2                                               ;   goes over them with the same values
000B0Ar 2               @Done:
000B0Ar 2  60             rts
000B0Br 2               
000B0Br 2               ; =============================================================================
000B0Br 2               ;   The two windows
000B0Br 2               ; =============================================================================
000B0Br 2               
000B0Br 2               ; -----------------------------------------------------------------------------
000B0Br 2               ;   AnimGlowBegin — SPEC 8 step 5, first half. Called with MARKS filled and
000B0Br 2               ;   the effect queue drained, from CascadeEnter.
000B0Br 2               ;   Out: PlayState = PLAY_GLOW.  Modifies: A, X, Y, Anim*
000B0Br 2               ;
000B0Br 2               ;   The fireball's flash is already lit: EffectResolve calls HalColorFlash as
000B0Br 2               ;   it detonates, so TintColor arriving here as anything but TINT_NONE is how
000B0Br 2               ;   this knows a fireball fired and the window has to be the longer one
000B0Br 2               ;   (SPEC 14). Two fireballs of different colours in one step leave the LAST
000B0Br 2               ;   one's colour flashing — one byte can only name one group, and the other's
000B0Br 2               ;   cells still glow and still shatter.
000B0Br 2               ; -----------------------------------------------------------------------------
000B0Br 2               AnimGlowBegin:
000B0Br 2  A9 03          lda #SHATTER_STEPS            ; Raised to BLIP_STEPS by AnimCellGlow if it
000B0Dr 2  8D rr rr       sta AnimSteps                 ;   meets a marked prism
000B10r 2  A9 00          lda #ANIM_GLOW
000B12r 2  20 rr rr       jsr AnimMarked
000B15r 2  A9 01          lda #ANIM_BEAM
000B17r 2  20 rr rr       jsr AnimMarked
000B1Ar 2               
000B1Ar 2  AE rr rr       ldx Region
000B1Dr 2  BD rr rr       lda GlowFrames,x
000B20r 2  AC rr rr       ldy TintColor
000B23r 2  C0 01          cpy #TINT_NONE
000B25r 2  F0 08          beq @Time
000B27r 2  BD rr rr       lda FlashFrames,x
000B2Ar 2  48             pha
000B2Br 2  20 rr rr       jsr RenderNext                ; The preview is redrawn so that a piece of the
000B2Er 2  68             pla                           ;   flashing colour goes white there too. On
000B2Fr 2                                               ;   the AC6502 the whole group recolours and
000B2Fr 2                                               ;   this changes nothing; on the Commodores the
000B2Fr 2                                               ;   tint is per cell and this is the only way
000B2Fr 2                                               ;   those three cells hear about it (SPEC 4.6)
000B2Fr 2               @Time:
000B2Fr 2  8D rr rr       sta AnimTimer
000B32r 2  A9 02          lda #PLAY_GLOW
000B34r 2  8D rr rr       sta PlayState
000B37r 2  60             rts
000B38r 2               
000B38r 2               ; -----------------------------------------------------------------------------
000B38r 2               ;   AnimGlowEnd — take the beams and the flash down, and start the shatter
000B38r 2               ;   Out: PlayState = PLAY_SHATTER.  Modifies: A, X, Y, Anim*
000B38r 2               ; -----------------------------------------------------------------------------
000B38r 2               AnimGlowEnd:
000B38r 2  A9 02          lda #ANIM_UNBEAM
000B3Ar 2  20 rr rr       jsr AnimMarked
000B3Dr 2               
000B3Dr 2  AD rr rr       lda TintColor
000B40r 2  C9 01          cmp #TINT_NONE
000B42r 2  F0 08          beq AnimShatterBegin
000B44r 2  A9 01          lda #TINT_NONE
000B46r 2  20 rr rr       jsr HalColorFlash             ; The flash ends with the window; every cell it
000B49r 2  20 rr rr       jsr RenderNext                ;   covered is marked and about to be redrawn
000B4Cr 2                                               ;   by the shatter, so only the preview needs
000B4Cr 2                                               ;   asking for again
000B4Cr 2                 ; falls through
000B4Cr 2               
000B4Cr 2               ; -----------------------------------------------------------------------------
000B4Cr 2               ;   AnimShatterBegin — SPEC 8 step 5, second half
000B4Cr 2               ;   Out: PlayState = PLAY_SHATTER.  Modifies: A, X, Y, Anim*
000B4Cr 2               ;   Frame 0 of the ring goes up now rather than next frame, so the window is
000B4Cr 2               ;   AnimSteps * VFX_FRAMES frames long and every tile of it holds for
000B4Cr 2               ;   VFX_FRAMES, the last one included.
000B4Cr 2               ; -----------------------------------------------------------------------------
000B4Cr 2               AnimShatterBegin:
000B4Cr 2  A9 00          lda #0
000B4Er 2  8D rr rr       sta AnimStep
000B51r 2  A9 02          lda #VFX_FRAMES
000B53r 2  8D rr rr       sta AnimTimer
000B56r 2  A9 03          lda #PLAY_SHATTER
000B58r 2  8D rr rr       sta PlayState
000B5Br 2  A9 03          lda #ANIM_SHATTER
000B5Dr 2  4C rr rr       jmp AnimMarked
000B60r 2               
000B60r 2               ; =============================================================================
000B60r 2               ;   The prism at rest (SPEC 7.3, 14)
000B60r 2               ; =============================================================================
000B60r 2               
000B60r 2               ; -----------------------------------------------------------------------------
000B60r 2               ;   AnimPrismTick — advance the idle rotation, one frame every PRISM_SPIN_RATE
000B60r 2               ;   Out: nothing.  Modifies: A, X, Y, AnimIdx, AnimArg, PrismFrame, PrismTimer
000B60r 2               ;
000B60r 2               ;   The only tile in the game that moves when nothing is happening, and the
000B60r 2               ;   only place other than the petrify that WRITES a tile to the board without
000B60r 2               ;   the board having changed: a prism's cell really does hold WILD_BASE + 0..3
000B60r 2               ;   from here on. Everything that reads a cell masks the colour first, so the
000B60r 2               ;   glyph bits carrying a frame number rather than a zero is invisible to the
000B60r 2               ;   scan, to gravity and to the effects — but it is exactly why P5 made
000B60r 2               ;   EffectEnqueue test the colour before the glyph, and why the petrify below
000B60r 2               ;   does too.
000B60r 2               ;
000B60r 2               ;   IT DOES NOT RUN DURING THE GLOW OR THE SHATTER. A marked prism has to hold
000B60r 2               ;   still for the glow window and then play its blip-out, and it is cheaper to
000B60r 2               ;   stand the whole walk down for those twelve frames than to test every cell
000B60r 2               ;   against MARKS.
000B60r 2               ;
000B60r 2               ;   The walk is the 96 cells of the well every eighth frame whether a prism is
000B60r 2               ;   on the board or not — about 150 cycles a frame amortised, against a board
000B60r 2               ;   scan's eleven thousand. Remembering where the prisms are would cost more
000B60r 2               ;   than it saves, and would have to be kept right through gravity.
000B60r 2               ; -----------------------------------------------------------------------------
000B60r 2               AnimPrismTick:
000B60r 2  AD rr rr       lda PlayState
000B63r 2  C9 02          cmp #PLAY_GLOW
000B65r 2  F0 4B          beq @Done
000B67r 2  C9 03          cmp #PLAY_SHATTER
000B69r 2  F0 47          beq @Done
000B6Br 2  CE rr rr       dec PrismTimer
000B6Er 2  D0 42          bne @Done
000B70r 2               
000B70r 2  A9 08          lda #PRISM_SPIN_RATE
000B72r 2  8D rr rr       sta PrismTimer
000B75r 2  EE rr rr       inc PrismFrame
000B78r 2  AD rr rr       lda PrismFrame
000B7Br 2  29 03          and #(PRISM_SPIN_FRAMES - 1)
000B7Dr 2  8D rr rr       sta PrismFrame
000B80r 2  09 70          ora #PRISM_SPIN               ; WILD_BASE + frame (SPEC A.3)
000B82r 2  85 rr          sta AnimArg
000B84r 2               
000B84r 2  A9 00          lda #0
000B86r 2  85 rr          sta AnimIdx
000B88r 2               @Cell:
000B88r 2  A6 rr          ldx AnimIdx
000B8Ar 2  BD rr rr       lda Board,x
000B8Dr 2  29 F8          and #COLOR_MASK
000B8Fr 2  C9 70          cmp #WILD_BASE
000B91r 2  D0 08          bne @Next
000B93r 2  A5 rr          lda AnimArg
000B95r 2  9D rr rr       sta Board,x
000B98r 2  20 rr rr       jsr RenderCell
000B9Br 2               @Next:
000B9Br 2  E6 rr          inc AnimIdx
000B9Dr 2  A5 rr          lda AnimIdx
000B9Fr 2  29 07          and #(BOARD_STRIDE - 1)
000BA1r 2  C9 06          cmp #BOARD_W
000BA3r 2  90 07          bcc @Test
000BA5r 2  A5 rr          lda AnimIdx                   ; Over the two sentinel columns
000BA7r 2  18             clc
000BA8r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000BAAr 2  85 rr          sta AnimIdx
000BACr 2               @Test:
000BACr 2  A5 rr          lda AnimIdx
000BAEr 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000BB0r 2  90 D6          bcc @Cell
000BB2r 2               @Done:
000BB2r 2  60             rts
000BB3r 2               
000BB3r 2               ; =============================================================================
000BB3r 2               ;   The message band (SPEC 12.2, 14)
000BB3r 2               ; =============================================================================
000BB3r 2               
000BB3r 2               ; -----------------------------------------------------------------------------
000BB3r 2               ;   AnimBannerShow — put a banner up for BannerFrames
000BB3r 2               ;   In:  Ptr1 -> string      Out: nothing.  Modifies: A, X, Y and the text
000BB3r 2               ;        cursor
000BB3r 2               ; -----------------------------------------------------------------------------
000BB3r 2               AnimBannerShow:
000BB3r 2  20 rr rr       jsr TextBanner
000BB6r 2  AE rr rr       ldx Region
000BB9r 2  BD rr rr       lda BannerFrames,x
000BBCr 2  8D rr rr       sta BannerTimer
000BBFr 2  60             rts
000BC0r 2               
000BC0r 2               ; -----------------------------------------------------------------------------
000BC0r 2               ;   AnimBannerTick — one frame of whatever banner is up
000BC0r 2               ;   Out: nothing.  Modifies: A, X, Y
000BC0r 2               ;   Play never stops for a banner: it ticks alongside the sub-states, like the
000BC0r 2               ;   high-score flash it shares its clock with (SPEC 9.8).
000BC0r 2               ; -----------------------------------------------------------------------------
000BC0r 2               AnimBannerTick:
000BC0r 2  AD rr rr       lda BannerTimer
000BC3r 2  F0 08          beq @Done
000BC5r 2  CE rr rr       dec BannerTimer
000BC8r 2  D0 03          bne @Done
000BCAr 2  4C rr rr       jmp TextBannerClear
000BCDr 2               @Done:
000BCDr 2  60             rts
000BCEr 2               
000BCEr 2               ; -----------------------------------------------------------------------------
000BCEr 2               ;   AnimBannerLevel — "~~ LEVEL UP ~~" (SPEC 10.1, 14)
000BCEr 2               ; -----------------------------------------------------------------------------
000BCEr 2               AnimBannerLevel:
000BCEr 2  A9 rr          lda #<MsgLevelUp
000BD0r 2  85 rr          sta Ptr1
000BD2r 2  A9 rr          lda #>MsgLevelUp
000BD4r 2  85 rr          sta Ptr1+1
000BD6r 2  4C rr rr       jmp AnimBannerShow
000BD9r 2               
000BD9r 2               ; -----------------------------------------------------------------------------
000BD9r 2               ;   AnimBannerChain — "~~ CHAIN xN ~~" (SPEC 8 SETTLE, 14)
000BD9r 2               ;   In:  A = links in the cascade      Modifies: A, X, Y and the text cursor
000BD9r 2               ;
000BD9r 2               ;   The banner is a fixed-length string with a placeholder digit, overwritten
000BD9r 2               ;   afterwards at CHAIN_DIGIT_X — which is a constant only because the string
000BD9r 2               ;   is MSG_CHAIN_LEN cells long and TextBanner centres on PANEL_W
000BD9r 2               ;   (constants.inc). A chain past 9 says 9 rather than drawing whatever tile
000BD9r 2               ;   FONT_DIGIT_0 + 10 turns out to be.
000BD9r 2               ; -----------------------------------------------------------------------------
000BD9r 2               AnimBannerChain:
000BD9r 2  C9 0A          cmp #(CHAIN_MAX_SHOWN + 1)
000BDBr 2  90 02          bcc @Show
000BDDr 2  A9 09          lda #CHAIN_MAX_SHOWN
000BDFr 2               @Show:
000BDFr 2  48             pha
000BE0r 2  A9 rr          lda #<MsgChain
000BE2r 2  85 rr          sta Ptr1
000BE4r 2  A9 rr          lda #>MsgChain
000BE6r 2  85 rr          sta Ptr1+1
000BE8r 2  20 rr rr       jsr AnimBannerShow
000BEBr 2  68             pla
000BECr 2  18             clc
000BEDr 2  69 10          adc #FONT_DIGIT_0
000BEFr 2  A2 0E          ldx #CHAIN_DIGIT_X
000BF1r 2  A0 16          ldy #MSG_Y
000BF3r 2  4C rr rr       jmp RenderMark
000BF6r 2               
000BF6r 2               ; -----------------------------------------------------------------------------
000BF6r 2               ;   AnimBannerOver — "~~ GAME OVER! ~~" (SPEC 13.4 step 3)
000BF6r 2               ;   Nothing takes it down again: StateGameOver does not call AnimBannerTick, so
000BF6r 2               ;   the band holds this until the screen itself ends and GameStart clears it.
000BF6r 2               ; -----------------------------------------------------------------------------
000BF6r 2               AnimBannerOver:
000BF6r 2  A9 rr          lda #<MsgGameOver
000BF8r 2  85 rr          sta Ptr1
000BFAr 2  A9 rr          lda #>MsgGameOver
000BFCr 2  85 rr          sta Ptr1+1
000BFEr 2  4C rr rr       jmp AnimBannerShow
000C01r 2               
000C01r 2               ; =============================================================================
000C01r 2               ;   The title screen (SPEC 13.1)
000C01r 2               ; =============================================================================
000C01r 2               ;   Two moving things over one drawn image, and between them they are the whole
000C01r 2               ;   of the title screen: there are no help pages, because the controls are part
000C01r 2               ;   of the artwork and a page nobody is reading teaches nothing.
000C01r 2               ; =============================================================================
000C01r 2               
000C01r 2               ; -----------------------------------------------------------------------------
000C01r 2               ;   AnimTitleBegin — the blink starts lit, with the image the artist drew
000C01r 2               ;   Out: nothing.  Modifies: A, X
000C01r 2               ;   Called from the redraw, so entering the title twice in a session cannot
000C01r 2               ;   leave the prompt dark for the first half period.
000C01r 2               ; -----------------------------------------------------------------------------
000C01r 2               AnimTitleBegin:
000C01r 2  AE rr rr       ldx Region
000C04r 2  BD rr rr       lda BlinkHalf,x
000C07r 2  8D rr rr       sta TitleTimer
000C0Ar 2  A9 00          lda #0
000C0Cr 2  8D rr rr       sta TitlePhase                ; The drawn screen already says PRESS FIRE
000C0Fr 2  60             rts
000C10r 2               
000C10r 2               ; -----------------------------------------------------------------------------
000C10r 2               ;   AnimTitleBlink — one frame of the prompt (SPEC 13.1, 14)
000C10r 2               ;   Out: nothing.  Modifies: A, X, Y, the text cursor, TitleTimer, TitlePhase
000C10r 2               ;
000C10r 2               ;   SPEC 14's blink period is 30 frames NTSC and 25 PAL, and BlinkHalf is half
000C10r 2               ;   of one — the same table and the same shape as the HIGH field's overtake
000C10r 2               ;   flash (score.asm), which is the other thing in the game that blinks. This
000C10r 2               ;   one free-runs instead of counting itself out.
000C10r 2               ; -----------------------------------------------------------------------------
000C10r 2               AnimTitleBlink:
000C10r 2  CE rr rr       dec TitleTimer
000C13r 2  D0 2B          bne @Done
000C15r 2  AE rr rr       ldx Region
000C18r 2  BD rr rr       lda BlinkHalf,x
000C1Br 2  8D rr rr       sta TitleTimer
000C1Er 2  AD rr rr       lda TitlePhase
000C21r 2  49 01          eor #$01
000C23r 2  8D rr rr       sta TitlePhase
000C26r 2  F0 09          beq @Show
000C28r 2               
000C28r 2  A9 0A          lda #PROMPT_LEN               ; The dark half
000C2Ar 2  A2 06          ldx #PROMPT_X
000C2Cr 2  A0 0B          ldy #PROMPT_Y
000C2Er 2  4C rr rr       jmp TextClearRun
000C31r 2               @Show:
000C31r 2  A9 rr          lda #<MsgPressFire            ; ...and back, byte for byte as the title image
000C33r 2  85 rr          sta Ptr1                      ;   has it (strings.inc)
000C35r 2  A9 rr          lda #>MsgPressFire
000C37r 2  85 rr          sta Ptr1+1
000C39r 2  A2 06          ldx #PROMPT_X
000C3Br 2  A0 0B          ldy #PROMPT_Y
000C3Dr 2  4C rr rr       jmp TextDraw
000C40r 2               @Done:
000C40r 2  60             rts
000C41r 2               
000C41r 2               ; -----------------------------------------------------------------------------
000C41r 2               ;   AnimTitleField — one cell of the magic field, every frame (SPEC 13.1)
000C41r 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0, Tmp1
000C41r 2               ;
000C41r 2               ;   Tiles 128-255 are one diagonal hatch in sixteen colours (SPEC Appendix A),
000C41r 2               ;   so writing a random one of them into a random one of the block's 28 cells
000C41r 2               ;   makes the whole block crawl. Two random bytes and one RenderMark: the
000C41r 2               ;   cheapest animation in the game, and the reason the title screen needs no
000C41r 2               ;   art beyond the page it is drawn on.
000C41r 2               ;
000C41r 2               ;   The tile is rolled BEFORE the cell and parked on the stack, because
000C41r 2               ;   RngRange has to be the last call — nothing here may hold a value in
000C41r 2               ;   Tmp0-Tmp3 across it (zeropage.inc).
000C41r 2               ; -----------------------------------------------------------------------------
000C41r 2               AnimTitleField:
000C41r 2  20 rr rr       jsr RngNext
000C44r 2  29 7F          and #(ART_TILES - 1)          ; ART_BASE is 128 and so is ART_TILES, so the
000C46r 2  09 80          ora #ART_BASE                 ;   range is exactly the top bit set
000C48r 2  48             pha
000C49r 2               
000C49r 2  A9 1C          lda #FIELD_CELLS
000C4Br 2  20 rr rr       jsr RngRange                  ; 0 .. 27, evenly — not a modulo (rng.asm)
000C4Er 2  A0 08          ldy #FIELD_Y
000C50r 2  C9 0E          cmp #FIELD_W
000C52r 2  90 03          bcc @Have
000C54r 2  E9 0E          sbc #FIELD_W                  ; C is set by the CMP that got us here
000C56r 2  C8             iny                           ; The second row of the block
000C57r 2               @Have:
000C57r 2  18             clc
000C58r 2  69 04          adc #FIELD_X
000C5Ar 2  AA             tax                           ; X = panel column, Y = panel row
000C5Br 2  68             pla                           ; A = tile
000C5Cr 2  4C rr rr       jmp RenderMark
000C5Fr 2               
000C5Fr 2               ; =============================================================================
000C5Fr 2               ;   Game over (SPEC 13.4)
000C5Fr 2               ; =============================================================================
000C5Fr 2               
000C5Fr 2               ; -----------------------------------------------------------------------------
000C5Fr 2               ;   AnimPetrifyBegin — start the well turning to stone from the floor up
000C5Fr 2               ;   Out: nothing.  Modifies: A
000C5Fr 2               ; -----------------------------------------------------------------------------
000C5Fr 2               AnimPetrifyBegin:
000C5Fr 2  A9 0F          lda #(BOARD_H - 1)
000C61r 2  8D rr rr       sta PetrifyRow
000C64r 2  A9 02          lda #PETRIFY_FRAMES
000C66r 2  8D rr rr       sta AnimTimer
000C69r 2  60             rts
000C6Ar 2               
000C6Ar 2               ; -----------------------------------------------------------------------------
000C6Ar 2               ;   AnimPetrifyTick — one frame of it
000C6Ar 2               ;   Out: C set while it is still running, clear once the well is stone.
000C6Ar 2               ;        Modifies: A, X, Y, AnimIdx, AnimEnd, AnimTimer, PetrifyRow, Board
000C6Ar 2               ;   SPEC 13.4 — a row every PETRIFY_FRAMES, bottom upward, 32 frames in all.
000C6Ar 2               ;
000C6Ar 2               ;   Each cell sets as ITS OWN SHAPE, because group 15 holds the petrified
000C6Ar 2               ;   glyphs at the same five offsets the potions use (SPEC A.3): one AND and
000C6Ar 2               ;   one ORA, and a bomb sets as a stone bomb at the exact moment the player is
000C6Ar 2               ;   looking hardest at the board. Empty cells stay empty — the pile petrifies,
000C6Ar 2               ;   not the well.
000C6Ar 2               ;
000C6Ar 2               ;   A prism has no stone twin, so it sets as the plain one. Testing the colour
000C6Ar 2               ;   first is what keeps it off `PETRIFY_BASE + 3`, a stone bomb, which is what
000C6Ar 2               ;   a rotating prism's glyph bits would otherwise buy (AnimPrismTick above).
000C6Ar 2               ; -----------------------------------------------------------------------------
000C6Ar 2               AnimPetrifyTick:
000C6Ar 2  AD rr rr       lda PetrifyRow
000C6Dr 2  30 42          bmi @Finished                 ; $FF — the whole well is stone
000C6Fr 2  CE rr rr       dec AnimTimer
000C72r 2  D0 3B          bne @Running
000C74r 2               
000C74r 2  A9 02          lda #PETRIFY_FRAMES
000C76r 2  8D rr rr       sta AnimTimer
000C79r 2  AD rr rr       lda PetrifyRow
000C7Cr 2  0A             asl a                         ; Row base — the board's stride is 8
000C7Dr 2  0A             asl a
000C7Er 2  0A             asl a
000C7Fr 2  85 rr          sta AnimIdx
000C81r 2  18             clc
000C82r 2  69 06          adc #BOARD_W
000C84r 2  85 rr          sta AnimEnd
000C86r 2               @Cell:
000C86r 2  A6 rr          ldx AnimIdx
000C88r 2  BD rr rr       lda Board,x
000C8Br 2  F0 17          beq @Next                     ; Empty stays empty (SPEC 13.4)
000C8Dr 2  29 F8          and #COLOR_MASK
000C8Fr 2  C9 70          cmp #WILD_BASE
000C91r 2  F0 09          beq @Prism
000C93r 2  BD rr rr       lda Board,x
000C96r 2  29 07          and #GLYPH_MASK
000C98r 2  09 78          ora #PETRIFY_BASE
000C9Ar 2  D0 02          bne @Set                      ; Always — PETRIFY_BASE is 120
000C9Cr 2               @Prism:
000C9Cr 2  A9 78          lda #PETRIFY_BASE
000C9Er 2               @Set:
000C9Er 2  9D rr rr       sta Board,x
000CA1r 2  20 rr rr       jsr RenderCell
000CA4r 2               @Next:
000CA4r 2  E6 rr          inc AnimIdx
000CA6r 2  A5 rr          lda AnimIdx
000CA8r 2  C5 rr          cmp AnimEnd
000CAAr 2  90 DA          bcc @Cell
000CACr 2  CE rr rr       dec PetrifyRow
000CAFr 2               @Running:
000CAFr 2  38             sec
000CB0r 2  60             rts
000CB1r 2               @Finished:
000CB1r 2  18             clc
000CB2r 2  60             rts
000CB3r 2               
000CB3r 1               .include "../src/score.asm"
000CB3r 2               ; =============================================================================
000CB3r 2               ;   score.asm — Wizards Lab, scoring
000CB3r 2               ; =============================================================================
000CB3r 2               ;   SPEC.md section 9. Seven digits of packed BCD in four bytes, low byte
000CB3r 2               ;   first; the top nibble of ScoreTop is held at zero. Every value in
000CB3r 2               ;   tables.inc is a multiple of ten, so scoring is a SED / ADC chain and never
000CB3r 2               ;   a multiply — the one place a tile count has to be multiplied by a table
000CB3r 2               ;   value, it is done as a loop of BCD additions, and the count is at most 21.
000CB3r 2               ;
000CB3r 2               ;   The score clamps at 9999999. It never wraps.
000CB3r 2               ;
000CB3r 2               ;   Display is always all seven digits, zero padded — see TextBcd. Nothing
000CB3r 2               ;   here strips a leading zero, and nothing downstream may either.
000CB3r 2               ;
000CB3r 2               ;   TWO WAYS IN, AND THEY ARE NOT INTERCHANGEABLE (D5):
000CB3r 2               ;
000CB3r 2               ;     CascadeAdd / CascadeAddTimes    points scored INSIDE a cascade. They go
000CB3r 2               ;                                     into Cascade{Lo,Mid,Hi} and stay there
000CB3r 2               ;                                     until CascadeSettle, because a star
000CB3r 2               ;                                     caught anywhere in the cascade doubles
000CB3r 2               ;                                     everything it scored, retroactively
000CB3r 2               ;                                     (SPEC 9.6).
000CB3r 2               ;     ScoreAward                      the awards SPEC 9.6 gives outside a
000CB3r 2               ;                                     cascade — the soft drop and the level-up
000CB3r 2               ;                                     bonus. These reach Score at once and a
000CB3r 2               ;                                     star never touches them.
000CB3r 2               ;
000CB3r 2               ;   Both funnel through ScoreBank, which is the only routine that writes
000CB3r 2               ;   Score, the only one that clamps, and the only one that can hand the high
000CB3r 2               ;   score over to the player.
000CB3r 2               ; =============================================================================
000CB3r 2               
000CB3r 2               ; -----------------------------------------------------------------------------
000CB3r 2               ;   ScoreHighInit — seed the session high score, once, at power-on
000CB3r 2               ;   SPEC 9.8 — the high score is not persisted; it starts at 0010000 on every
000CB3r 2               ;   power-on, which is the target the first game is played against. It then
000CB3r 2               ;   survives every game in the session, so this is deliberately NOT part of
000CB3r 2               ;   ScoreReset. Nothing may infer "cold boot" from the value being zero: BSS
000CB3r 2               ;   is not cleared on all three machines.
000CB3r 2               ;   Out: nothing.  Modifies: A
000CB3r 2               ; -----------------------------------------------------------------------------
000CB3r 2               ScoreHighInit:
000CB3r 2  A9 00          lda #HIGH_INIT_LO
000CB5r 2  8D rr rr       sta HighLo
000CB8r 2  A9 00          lda #HIGH_INIT_MID
000CBAr 2  8D rr rr       sta HighMid
000CBDr 2  A9 01          lda #HIGH_INIT_HI
000CBFr 2  8D rr rr       sta HighHi
000CC2r 2  A9 00          lda #HIGH_INIT_TOP
000CC4r 2  8D rr rr       sta HighTop
000CC7r 2  A9 01          lda #$01                      ; BCD — the level the target was "set" on
000CC9r 2  8D rr rr       sta HighLevel
000CCCr 2  60             rts
000CCDr 2               
000CCDr 2               ; -----------------------------------------------------------------------------
000CCDr 2               ;   ScoreReset — zero the score for a new game
000CCDr 2               ;   Out: nothing.  Modifies: A
000CCDr 2               ;
000CCDr 2               ;   The high score itself is NOT reset (SPEC 9.8) — but the two flags that say
000CCDr 2               ;   what this game has done about it are, or the second game of a session
000CCDr 2               ;   would never flash.
000CCDr 2               ; -----------------------------------------------------------------------------
000CCDr 2               ScoreReset:
000CCDr 2  A9 00          lda #0
000CCFr 2  8D rr rr       sta ScoreLo
000CD2r 2  8D rr rr       sta ScoreMid
000CD5r 2  8D rr rr       sta ScoreHi
000CD8r 2  8D rr rr       sta ScoreTop
000CDBr 2  8D rr rr       sta CascadeLo
000CDEr 2  8D rr rr       sta CascadeMid
000CE1r 2  8D rr rr       sta CascadeHi
000CE4r 2  8D rr rr       sta StarCount
000CE7r 2  8D rr rr       sta HighOwned
000CEAr 2  8D rr rr       sta HighFlash
000CEDr 2  8D rr rr       sta HighTimer
000CF0r 2  60             rts
000CF1r 2               
000CF1r 2               ; -----------------------------------------------------------------------------
000CF1r 2               ;   CascadeAdd — add a 16-bit BCD value to the cascade accumulator
000CF1r 2               ;   In:  A = low BCD byte, X = high BCD byte
000CF1r 2               ;   Out: nothing.  Modifies: A, flags.  PRESERVES X and Y.
000CF1r 2               ;
000CF1r 2               ;   Preserving X and Y is what lets CascadeAddTimes loop over this without
000CF1r 2               ;   spilling anything, and Tmp0-Tmp3 may not be held across a JSR anyway
000CF1r 2               ;   (zeropage.inc).
000CF1r 2               ; -----------------------------------------------------------------------------
000CF1r 2               CascadeAdd:
000CF1r 2  F8             sed
000CF2r 2  18             clc
000CF3r 2  6D rr rr       adc CascadeLo
000CF6r 2  8D rr rr       sta CascadeLo
000CF9r 2  8A             txa
000CFAr 2  6D rr rr       adc CascadeMid
000CFDr 2  8D rr rr       sta CascadeMid
000D00r 2  AD rr rr       lda CascadeHi
000D03r 2  69 00          adc #0
000D05r 2  8D rr rr       sta CascadeHi
000D08r 2  D8             cld                           ; CLD leaves the carry alone
000D09r 2  B0 01          bcs CascadeClamp
000D0Br 2  60             rts
000D0Cr 2               
000D0Cr 2               ; -----------------------------------------------------------------------------
000D0Cr 2               ;   CascadeClamp — six nines, when an accumulate would have wrapped
000D0Cr 2               ;   Out: nothing.  Modifies: A.  PRESERVES X and Y.
000D0Cr 2               ;
000D0Cr 2               ;   Not reachable by playing: nothing is ever ADDED to the board during a
000D0Cr 2               ;   cascade, so one cascade can never remove more than the 96 cells the well
000D0Cr 2               ;   holds, and 96 cells at the dearest tile value there is (650, SPEC 9.2)
000D0Cr 2               ;   plus every bonus in section 9 comes to a little over 200,000 — a fifth of
000D0Cr 2               ;   what three bytes hold, and an eighth of what it would take to wrap after
000D0Cr 2               ;   the star cap has doubled it three times. It is here because "never wraps"
000D0Cr 2               ;   in SPEC 9 has to be true of every accumulator on the path, not just of the
000D0Cr 2               ;   one the player can see.
000D0Cr 2               ; -----------------------------------------------------------------------------
000D0Cr 2               CascadeClamp:
000D0Cr 2  A9 99          lda #$99
000D0Er 2  8D rr rr       sta CascadeLo
000D11r 2  8D rr rr       sta CascadeMid
000D14r 2  8D rr rr       sta CascadeHi
000D17r 2  60             rts
000D18r 2               
000D18r 2               ; -----------------------------------------------------------------------------
000D18r 2               ;   CascadeAddTimes — add a value N times (the tiles-cleared multiply)
000D18r 2               ;   In:  A = low BCD, X = high BCD, Y = count
000D18r 2               ;   Out: nothing.  Modifies: A, Y, flags.  PRESERVES X.
000D18r 2               ;
000D18r 2               ;   SPEC 9 chose values that are all multiples of ten so that scoring is an
000D18r 2               ;   ADC chain, but `length * TileValue[chain]` is still a multiply. The count
000D18r 2               ;   is a run length — three to sixteen — so a loop of BCD additions is both
000D18r 2               ;   smaller and, at these counts, faster than any multiply routine worth
000D18r 2               ;   writing.
000D18r 2               ; -----------------------------------------------------------------------------
000D18r 2               CascadeAddTimes:
000D18r 2  48             pha                           ; The low byte rides the stack, because
000D19r 2               @Loop:                          ;   CascadeAdd returns in A
000D19r 2  C0 00          cpy #0
000D1Br 2  F0 08          beq @Done
000D1Dr 2  68             pla
000D1Er 2  48             pha
000D1Fr 2  20 rr rr       jsr CascadeAdd
000D22r 2  88             dey
000D23r 2  D0 F4          bne @Loop
000D25r 2               @Done:
000D25r 2  68             pla
000D26r 2  60             rts
000D27r 2               
000D27r 2               ; -----------------------------------------------------------------------------
000D27r 2               ;   CascadeDouble — one BCD doubling of the cascade accumulator
000D27r 2               ;   Out: nothing.  Modifies: A, flags.  PRESERVES X and Y.
000D27r 2               ;   A doubling in BCD is a self-addition; three of them is the star cap.
000D27r 2               ; -----------------------------------------------------------------------------
000D27r 2               CascadeDouble:
000D27r 2  F8             sed
000D28r 2  18             clc
000D29r 2  AD rr rr       lda CascadeLo
000D2Cr 2  6D rr rr       adc CascadeLo
000D2Fr 2  8D rr rr       sta CascadeLo
000D32r 2  AD rr rr       lda CascadeMid
000D35r 2  6D rr rr       adc CascadeMid
000D38r 2  8D rr rr       sta CascadeMid
000D3Br 2  AD rr rr       lda CascadeHi
000D3Er 2  6D rr rr       adc CascadeHi
000D41r 2  8D rr rr       sta CascadeHi
000D44r 2  D8             cld
000D45r 2  B0 C5          bcs CascadeClamp
000D47r 2  60             rts
000D48r 2               
000D48r 2               ; -----------------------------------------------------------------------------
000D48r 2               ;   ScoreAdd — bank the cascade accumulator into Score, clamped
000D48r 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
000D48r 2               ;   SPEC 9.8 — the high score updates live, so the player watches the overtake.
000D48r 2               ; -----------------------------------------------------------------------------
000D48r 2               ScoreAdd:
000D48r 2  AD rr rr       lda CascadeLo
000D4Br 2  85 rr          sta Tmp0
000D4Dr 2  AD rr rr       lda CascadeMid
000D50r 2  85 rr          sta Tmp1
000D52r 2  AD rr rr       lda CascadeHi
000D55r 2  85 rr          sta Tmp2
000D57r 2  4C rr rr       jmp ScoreBank
000D5Ar 2               
000D5Ar 2               ; -----------------------------------------------------------------------------
000D5Ar 2               ;   ScoreAward — add a 16-bit BCD value straight to Score
000D5Ar 2               ;   In:  A = low BCD byte, X = high BCD byte
000D5Ar 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
000D5Ar 2               ;
000D5Ar 2               ;   The two awards SPEC 9.6 gives outside a cascade: one point a row for a
000D5Ar 2               ;   soft drop, and BONUS_LEVELUP when the level advances. Neither is a cascade
000D5Ar 2               ;   point and neither is doubled by a star, which is the whole reason they do
000D5Ar 2               ;   not go through CascadeAdd.
000D5Ar 2               ; -----------------------------------------------------------------------------
000D5Ar 2               ScoreAward:
000D5Ar 2  85 rr          sta Tmp0
000D5Cr 2  86 rr          stx Tmp1
000D5Er 2  A9 00          lda #0
000D60r 2  85 rr          sta Tmp2
000D62r 2                 ; falls through into ScoreBank
000D62r 2               
000D62r 2               ; -----------------------------------------------------------------------------
000D62r 2               ;   ScoreBank — Score += the three BCD bytes in Tmp0-Tmp2, clamped at 9999999
000D62r 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
000D62r 2               ;
000D62r 2               ;   The only writer of Score. It redraws the field itself, because there is no
000D62r 2               ;   other moment at which the score is known to have changed (SPEC 12.6 —
000D62r 2               ;   nothing polls).
000D62r 2               ; -----------------------------------------------------------------------------
000D62r 2               ScoreBank:
000D62r 2  F8             sed
000D63r 2  18             clc
000D64r 2  AD rr rr       lda ScoreLo
000D67r 2  65 rr          adc Tmp0
000D69r 2  8D rr rr       sta ScoreLo
000D6Cr 2  AD rr rr       lda ScoreMid
000D6Fr 2  65 rr          adc Tmp1
000D71r 2  8D rr rr       sta ScoreMid
000D74r 2  AD rr rr       lda ScoreHi
000D77r 2  65 rr          adc Tmp2
000D79r 2  8D rr rr       sta ScoreHi
000D7Cr 2  AD rr rr       lda ScoreTop
000D7Fr 2  69 00          adc #0
000D81r 2  8D rr rr       sta ScoreTop
000D84r 2  D8             cld                           ; CLD leaves the carry alone
000D85r 2  B0 07          bcs @Clamp
000D87r 2  AD rr rr       lda ScoreTop                  ; The eighth digit is held at zero (SPEC 9),
000D8Ar 2  C9 10          cmp #$10                      ;   so anything that reached it has overflowed
000D8Cr 2  90 10          bcc @Drawn                    ;   the seven the panel shows
000D8Er 2               @Clamp:
000D8Er 2  A9 99          lda #$99
000D90r 2  8D rr rr       sta ScoreLo
000D93r 2  8D rr rr       sta ScoreMid
000D96r 2  8D rr rr       sta ScoreHi
000D99r 2  A9 09          lda #$09
000D9Br 2  8D rr rr       sta ScoreTop
000D9Er 2               @Drawn:
000D9Er 2  20 rr rr       jsr RenderScore
000DA1r 2                 ; falls through into ScoreHighCheck
000DA1r 2               
000DA1r 2               ; -----------------------------------------------------------------------------
000DA1r 2               ;   ScoreHighCheck — hand the high score over the moment the score reaches it
000DA1r 2               ;   Out: C set if the score is level with or past the high score — which, once
000DA1r 2               ;        it has been taken, is EVERY call. The one-shot is HighOwned below, not
000DA1r 2               ;        this flag; nothing currently reads it.  Modifies: A, X, Y, Tmp0
000DA1r 2               ;
000DA1r 2               ;   SPEC 9.8. The copy happens on every call once the score is level with the
000DA1r 2               ;   high score, not just on the first — that is what keeps HighLevel tracking
000DA1r 2               ;   the live level while a run is holding its own record, which is the point of
000DA1r 2               ;   the number: it says how deep you have to get to beat it.
000DA1r 2               ;
000DA1r 2               ;   The fanfare and the flash are the one-shot half, and HighOwned is what
000DA1r 2               ;   makes them one: without it every subsequent bank would fire them again,
000DA1r 2               ;   because from the overtake onward the score and the high score are equal.
000DA1r 2               ; -----------------------------------------------------------------------------
000DA1r 2               ScoreHighCheck:
000DA1r 2  AD rr rr       lda HighTop                   ; Four-byte compare, most significant first
000DA4r 2  CD rr rr       cmp ScoreTop
000DA7r 2  D0 16          bne @Test
000DA9r 2  AD rr rr       lda HighHi
000DACr 2  CD rr rr       cmp ScoreHi
000DAFr 2  D0 0E          bne @Test
000DB1r 2  AD rr rr       lda HighMid
000DB4r 2  CD rr rr       cmp ScoreMid
000DB7r 2  D0 06          bne @Test
000DB9r 2  AD rr rr       lda HighLo
000DBCr 2  CD rr rr       cmp ScoreLo
000DBFr 2               @Test:
000DBFr 2  90 02          bcc @Take                     ; high < score
000DC1r 2  D0 3E          bne @Behind                   ; high > score — nothing to do
000DC3r 2                                               ; equal: still copy, so HighLevel tracks
000DC3r 2               @Take:
000DC3r 2  AD rr rr       lda ScoreLo
000DC6r 2  8D rr rr       sta HighLo
000DC9r 2  AD rr rr       lda ScoreMid
000DCCr 2  8D rr rr       sta HighMid
000DCFr 2  AD rr rr       lda ScoreHi
000DD2r 2  8D rr rr       sta HighHi
000DD5r 2  AD rr rr       lda ScoreTop
000DD8r 2  8D rr rr       sta HighTop
000DDBr 2  20 rr rr       jsr ScoreLevelBcd             ; The level box under the digits is BCD; Level
000DDEr 2  8D rr rr       sta HighLevel                 ;   itself is binary (SPEC 12.2)
000DE1r 2  20 rr rr       jsr RenderHigh
000DE4r 2               
000DE4r 2  AD rr rr       lda HighOwned
000DE7r 2  D0 16          bne @Owned
000DE9r 2  EE rr rr       inc HighOwned
000DECr 2  A9 0B          lda #SFX_HIGHSCORE            ; SPEC 9.8 — a longer fanfare, once
000DEEr 2  20 rr rr       jsr SfxPlay
000DF1r 2  A9 06          lda #HIGH_FLASH_BLINKS
000DF3r 2  8D rr rr       sta HighFlash
000DF6r 2  AE rr rr       ldx Region
000DF9r 2  BD rr rr       lda BlinkHalf,x
000DFCr 2  8D rr rr       sta HighTimer
000DFFr 2               @Owned:
000DFFr 2  38             sec
000E00r 2  60             rts
000E01r 2               
000E01r 2               @Behind:
000E01r 2  18             clc
000E02r 2  60             rts
000E03r 2               
000E03r 2               ; -----------------------------------------------------------------------------
000E03r 2               ;   ScoreLevelBcd — Level (binary 1-99) as one packed BCD byte
000E03r 2               ;   Out: A = the level in BCD.  Modifies: A, X, Tmp0
000E03r 2               ; -----------------------------------------------------------------------------
000E03r 2               ScoreLevelBcd:
000E03r 2  AD rr rr       lda Level
000E06r 2  A2 00          ldx #0
000E08r 2               @Tens:
000E08r 2  C9 0A          cmp #10
000E0Ar 2  90 05          bcc @Split
000E0Cr 2  E9 0A          sbc #10                       ; Carry is set by the CMP that got us here
000E0Er 2  E8             inx
000E0Fr 2  D0 F7          bne @Tens                     ; Always — X tops out at 9
000E11r 2               @Split:
000E11r 2  85 rr          sta Tmp0                      ; Units
000E13r 2  8A             txa
000E14r 2  0A             asl a
000E15r 2  0A             asl a
000E16r 2  0A             asl a
000E17r 2  0A             asl a
000E18r 2  05 rr          ora Tmp0
000E1Ar 2  60             rts
000E1Br 2               
000E1Br 2               ; -----------------------------------------------------------------------------
000E1Br 2               ;   ScoreSoftDrop — one point for one row descended under soft drop (SPEC 9.6)
000E1Br 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0-Tmp2
000E1Br 2               ;
000E1Br 2               ;   The one award in the game that is not a multiple of ten. BCD does not care.
000E1Br 2               ; -----------------------------------------------------------------------------
000E1Br 2               ScoreSoftDrop:
000E1Br 2  A9 01          lda #$01
000E1Dr 2  A2 00          ldx #$00
000E1Fr 2  4C rr rr       jmp ScoreAward
000E22r 2               
000E22r 2               ; -----------------------------------------------------------------------------
000E22r 2               ;   ScoreLevelCheck — advance the level when 30 tiles have gone
000E22r 2               ;   In:  A = tiles removed this step
000E22r 2               ;   Out: C set if the level advanced.  Modifies: A, X, Y, Tmp0-Tmp2
000E22r 2               ;   SPEC 10.1 — at most one advance per step, surplus carries over, so a big
000E22r 2               ;   fireball chain can never skip a level. Match and effect removals both
000E22r 2               ;   count, which is why the count comes from CascadeRemove and not from the
000E22r 2               ;   scan: by then the two are the same cells.
000E22r 2               ; -----------------------------------------------------------------------------
000E22r 2               ScoreLevelCheck:
000E22r 2  18             clc
000E23r 2  6D rr rr       adc TilesCleared
000E26r 2  8D rr rr       sta TilesCleared              ; A whole step can clear far more than thirty;
000E29r 2  C9 1E          cmp #LEVEL_TILES              ;   the surplus stays here and buys the next
000E2Br 2  90 23          bcc @No                       ;   level on the next step
000E2Dr 2  E9 1E          sbc #LEVEL_TILES              ; Carry is set by the CMP that got us here
000E2Fr 2  8D rr rr       sta TilesCleared
000E32r 2               
000E32r 2  AD rr rr       lda Level
000E35r 2  C9 63          cmp #LEVEL_MAX_SHOWN
000E37r 2  B0 17          bcs @No                       ; The box is two digits wide (SPEC 10.1), and
000E39r 2  EE rr rr       inc Level                     ;   nothing about level 100 is reachable in a
000E3Cr 2  20 rr rr       jsr RenderLevel               ;   session anyway
000E3Fr 2  20 rr rr       jsr AnimBannerLevel           ; SPEC 14 — and play carries straight on; the
000E42r 2                                               ;   band clears itself BannerFrames later
000E42r 2  A9 0A          lda #SFX_LEVELUP
000E44r 2  20 rr rr       jsr SfxPlay
000E47r 2  A9 00          lda #<BONUS_LEVELUP           ; SPEC 9.6 — an award, not a cascade point, so
000E49r 2  A2 10          ldx #>BONUS_LEVELUP           ;   a star in the same cascade does not double
000E4Br 2  20 rr rr       jsr ScoreAward                ;   it (D5)
000E4Er 2  38             sec
000E4Fr 2  60             rts
000E50r 2               @No:
000E50r 2  18             clc
000E51r 2  60             rts
000E52r 2               
000E52r 2               ; -----------------------------------------------------------------------------
000E52r 2               ;   ScoreFlashTick — one frame of the HIGH field's overtake flash
000E52r 2               ;   Out: nothing.  Modifies: A, X, Y
000E52r 2               ;   SPEC 9.8, SPEC 14 — the blink period is 30 frames NTSC / 25 PAL, shared
000E52r 2               ;   with the title screen's prompt, so HighFlash counts HALF blinks and
000E52r 2               ;   HighTimer counts the frames of one.
000E52r 2               ;
000E52r 2               ;   HighFlash is odd on the dark half and even on the lit one, and it ends at
000E52r 2               ;   zero, so the field is always left readable however the count is set.
000E52r 2               ; -----------------------------------------------------------------------------
000E52r 2               ScoreFlashTick:
000E52r 2  AD rr rr       lda HighFlash
000E55r 2  F0 1F          beq @Done
000E57r 2  CE rr rr       dec HighTimer
000E5Ar 2  D0 1A          bne @Done
000E5Cr 2  CE rr rr       dec HighFlash
000E5Fr 2  F0 12          beq @Show                     ; Out of blinks — end lit
000E61r 2  AE rr rr       ldx Region
000E64r 2  BD rr rr       lda BlinkHalf,x
000E67r 2  8D rr rr       sta HighTimer
000E6Ar 2  AD rr rr       lda HighFlash
000E6Dr 2  4A             lsr a
000E6Er 2  90 03          bcc @Show
000E70r 2  4C rr rr       jmp RenderHighBlank
000E73r 2               @Show:
000E73r 2  4C rr rr       jmp RenderHigh
000E76r 2               @Done:
000E76r 2  60             rts
000E77r 2               
000E77r 2               ; -----------------------------------------------------------------------------
000E77r 2               ;   ScoreGravity — frames per row for the current level
000E77r 2               ;   Out: A = frame count, from SpeedNTSC or SpeedPAL per Region.
000E77r 2               ;        Modifies: A, X
000E77r 2               ;   SPEC 10.2. Strictly this module is P4's, but the falling piece cannot fall
000E77r 2               ;   without it, so it is real ahead of the rest of the file — the same reason
000E77r 2               ;   ScoreHighInit landed here in P1.
000E77r 2               ; -----------------------------------------------------------------------------
000E77r 2               ScoreGravity:
000E77r 2  AE rr rr       ldx Level
000E7Ar 2  CA             dex                           ; The table is indexed by level - 1 ...
000E7Br 2  E0 10          cpx #LEVEL_SPEED_CAP
000E7Dr 2  90 02          bcc @Level
000E7Fr 2  A2 0F          ldx #LEVEL_SPEED_CAP - 1      ;   ... and stops improving at the cap
000E81r 2               @Level:
000E81r 2  AD rr rr       lda Region
000E84r 2  D0 04          bne @Pal
000E86r 2  BD rr rr       lda SpeedNTSC,x
000E89r 2  60             rts
000E8Ar 2               @Pal:
000E8Ar 2  BD rr rr       lda SpeedPAL,x
000E8Dr 2  60             rts
000E8Er 2               
000E8Er 1               .include "../src/render.asm"
000E8Er 2               ; =============================================================================
000E8Er 2               ;   render.asm — Wizards Lab, the dirty-cell renderer
000E8Er 2               ; =============================================================================
000E8Er 2               ;   SPEC.md section 12.6. The screen is never fully redrawn during play.
000E8Er 2               ;   Changed cells are appended to a ring and flushed once a frame, at most
000E8Er 2               ;   DIRTY_FLUSH_MAX per frame with the remainder carried over.
000E8Er 2               ;
000E8Er 2               ;   The cap is NOT a hardware write-spacing limit. S1 measured this loop at
000E8Er 2               ;   165 cycles a cell on the AC6502, which puts two VRAM data writes 165 us
000E8Er 2               ;   apart at 1 MHz and the closest two VDP PORT accesses 8 cycles apart —
000E8Er 2               ;   inside even a real TMS9918A's 8 us and 2 us windows with two orders of
000E8Er 2               ;   magnitude to spare, and further inside a pico9918's, which emulates VRAM
000E8Er 2               ;   in RP2040 memory and has no display contention at all. A 6502 at this
000E8Er 2               ;   clock cannot write a TMS9918 too fast however hard it tries.
000E8Er 2               ;
000E8Er 2               ;   The cap is a TIME BUDGET: DIRTY_FLUSH_MAX cells is what fits in vertical
000E8Er 2               ;   blank on the tightest of the three. See constants.inc and PLAN.md S1.
000E8Er 2               ;
000E8Er 2               ;   All screen access goes through HalPlotCell (see hal.inc). Nothing in this
000E8Er 2               ;   file knows where screen memory is.
000E8Er 2               ; =============================================================================
000E8Er 2               
000E8Er 2               ; -----------------------------------------------------------------------------
000E8Er 2               ;   RenderDirtyReset — empty the ring and cancel any outstanding board redraw
000E8Er 2               ;   Call this after anything that draws the whole screen behind the renderer's
000E8Er 2               ;   back (HalBlitScreen), because every queued cell then describes a screen
000E8Er 2               ;   that no longer exists.
000E8Er 2               ;   In:  nothing        Out: nothing.  Modifies: A
000E8Er 2               ; -----------------------------------------------------------------------------
000E8Er 2               RenderDirtyReset:
000E8Er 2  A9 00          lda #0
000E90r 2  8D rr rr       sta DirtyCount
000E93r 2  8D rr rr       sta DirtyHead
000E96r 2  8D rr rr       sta DirtyTail
000E99r 2  8D rr rr       sta RedrawWash
000E9Cr 2  A9 FF          lda #$FF
000E9Er 2  8D rr rr       sta RedrawIdx
000EA1r 2  60             rts
000EA2r 2               
000EA2r 2               ; -----------------------------------------------------------------------------
000EA2r 2               ;   RenderMark — queue one panel cell
000EA2r 2               ;   In:  A = tile, X = panel column, Y = panel row
000EA2r 2               ;   Out: nothing.  Modifies: A, X.  PRESERVES Y and every byte of zero page.
000EA2r 2               ;
000EA2r 2               ;   The PANEL_X / PANEL_Y offset is applied here, once, so nothing upstream
000EA2r 2               ;   has to know which machine it is running on.
000EA2r 2               ;
000EA2r 2               ;   Preserving Y and zero page is a contract, not an accident: text.asm holds
000EA2r 2               ;   its string cursor across this call (see zeropage.inc). The three values
000EA2r 2               ;   ride the stack rather than scratch bytes because A, X and Y are all live
000EA2r 2               ;   at once and there is no fourth register to index the ring with.
000EA2r 2               ;
000EA2r 2               ;   A mark that arrives with the ring full is DROPPED, silently (D6).
000EA2r 2               ; -----------------------------------------------------------------------------
000EA2r 2               RenderMark:
000EA2r 2  48             pha                           ; Tile
000EA3r 2  98             tya
000EA4r 2  18             clc
000EA5r 2  69 00          adc #PANEL_Y                  ; Panel row -> screen row
000EA7r 2  48             pha
000EA8r 2  8A             txa
000EA9r 2  18             clc
000EAAr 2  69 09          adc #PANEL_X                  ; Panel column -> screen column
000EACr 2  48             pha
000EADr 2               
000EADr 2  AD rr rr       lda DirtyCount
000EB0r 2  C9 40          cmp #DIRTY_ENTRIES
000EB2r 2  B0 1F          bcs @Full
000EB4r 2  EE rr rr       inc DirtyCount
000EB7r 2               
000EB7r 2  AE rr rr       ldx DirtyTail
000EBAr 2  68             pla
000EBBr 2  9D rr rr       sta Dirty+0,x                 ; Screen column
000EBEr 2  68             pla
000EBFr 2  9D rr rr       sta Dirty+1,x                 ; Screen row
000EC2r 2  68             pla
000EC3r 2  9D rr rr       sta Dirty+2,x                 ; Tile
000EC6r 2               
000EC6r 2  E8             inx                           ; Step one entry, wrapping the ring
000EC7r 2  E8             inx
000EC8r 2  E8             inx
000EC9r 2  E0 C0          cpx #DIRTY_BYTES
000ECBr 2  90 02          bcc @Store
000ECDr 2  A2 00          ldx #0
000ECFr 2               @Store:
000ECFr 2  8E rr rr       stx DirtyTail
000ED2r 2  60             rts
000ED3r 2               
000ED3r 2               @Full:
000ED3r 2  68             pla                           ; Unwind and drop it. The cell is wrong until
000ED4r 2  68             pla                           ;   something marks it again.
000ED5r 2  68             pla
000ED6r 2  60             rts
000ED7r 2               
000ED7r 2               ; -----------------------------------------------------------------------------
000ED7r 2               ;   RenderFlush — push up to DIRTY_FLUSH_MAX queued cells to the screen
000ED7r 2               ;   Called once per frame, from the top of the main loop.
000ED7r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
000ED7r 2               ; -----------------------------------------------------------------------------
000ED7r 2               RenderFlush:
000ED7r 2  20 rr rr       jsr RenderBoardStep           ; Top the ring up from a board redraw, if one
000EDAr 2                                               ;   is outstanding, so it always makes progress
000EDAr 2  AD rr rr       lda DirtyCount
000EDDr 2  F0 31          beq @Done
000EDFr 2  C9 18          cmp #DIRTY_FLUSH_MAX
000EE1r 2  90 02          bcc @Budget
000EE3r 2  A9 18          lda #DIRTY_FLUSH_MAX
000EE5r 2               @Budget:
000EE5r 2  85 rr          sta FlushLeft
000EE7r 2               
000EE7r 2               @Cell:
000EE7r 2  AE rr rr       ldx DirtyHead
000EEAr 2  BD rr rr       lda Dirty+1,x
000EEDr 2  A8             tay                           ; Y = screen row
000EEEr 2  BD rr rr       lda Dirty+2,x
000EF1r 2  48             pha                           ; Tile
000EF2r 2  BD rr rr       lda Dirty+0,x
000EF5r 2  AA             tax                           ; X = screen column
000EF6r 2  68             pla                           ; A = tile
000EF7r 2  20 rr rr       jsr HalPlotCell
000EFAr 2               
000EFAr 2  AD rr rr       lda DirtyHead                 ; Step one entry, wrapping the ring
000EFDr 2  18             clc
000EFEr 2  69 03          adc #3
000F00r 2  C9 C0          cmp #DIRTY_BYTES
000F02r 2  90 02          bcc @Store
000F04r 2  A9 00          lda #0
000F06r 2               @Store:
000F06r 2  8D rr rr       sta DirtyHead
000F09r 2  CE rr rr       dec DirtyCount
000F0Cr 2  C6 rr          dec FlushLeft
000F0Er 2  D0 D7          bne @Cell
000F10r 2               @Done:
000F10r 2  60             rts
000F11r 2               
000F11r 2               ; -----------------------------------------------------------------------------
000F11r 2               ;   RenderBoard — ask for the whole 6 x 16 well to be redrawn
000F11r 2               ;   Used on state entry and after a pause, not per frame.
000F11r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000F11r 2               ;
000F11r 2               ;   The well is 96 cells and the ring holds DIRTY_ENTRIES; a redraw therefore
000F11r 2               ;   cannot be queued in one go. This only sets the cursor. RenderBoardStep,
000F11r 2               ;   which RenderFlush calls every frame, feeds the ring as fast as it drains,
000F11r 2               ;   so the redraw spreads over as many frames as it needs and never drops a
000F11r 2               ;   cell.
000F11r 2               ; -----------------------------------------------------------------------------
000F11r 2               RenderBoard:
000F11r 2  A9 00          lda #0
000F13r 2  8D rr rr       sta RedrawWash                ; From the board, not the PAUSE wash
000F16r 2  8D rr rr       sta RedrawIdx                 ; Board index 0 = row 0, column 0
000F19r 2  60             rts                           ; And nothing else. Falling through into the
000F1Ar 2                                               ;   step below would fill the ring here and
000F1Ar 2                                               ;   drop whatever the caller marks next.
000F1Ar 2               
000F1Ar 2               ; -----------------------------------------------------------------------------
000F1Ar 2               ;   RenderWash — ask for the well to be covered rather than shown
000F1Ar 2               ;   In:  nothing        Out: nothing.  Modifies: A
000F1Ar 2               ;   SPEC 13.3 — pausing washes all 96 cells with TILE_WASH so the board cannot
000F1Ar 2               ;   be studied while the clock is stopped. A wash and not a blank: a blanked
000F1Ar 2               ;   well reads as a crash, a stippled one reads as covered.
000F1Ar 2               ;
000F1Ar 2               ;   The same cursor as RenderBoard, because it is the same 96 cells against
000F1Ar 2               ;   the same 64-entry ring, and it is undone the same way — the resume calls
000F1Ar 2               ;   RenderBoard, which turns the flag off and repaints every cell from the
000F1Ar 2               ;   board it never stopped being (D12).
000F1Ar 2               ; -----------------------------------------------------------------------------
000F1Ar 2               RenderWash:
000F1Ar 2  A9 07          lda #TILE_WASH
000F1Cr 2  8D rr rr       sta RedrawWash
000F1Fr 2  A9 00          lda #0
000F21r 2  8D rr rr       sta RedrawIdx
000F24r 2  60             rts
000F25r 2               
000F25r 2               ; -----------------------------------------------------------------------------
000F25r 2               ;   RenderBoardStep — queue as much of an outstanding board redraw as fits
000F25r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000F25r 2               ;   Does nothing when RedrawIdx is $FF.
000F25r 2               ; -----------------------------------------------------------------------------
000F25r 2               RenderBoardStep:
000F25r 2  AD rr rr       lda RedrawIdx
000F28r 2  30 46          bmi @Done                     ; $FF — nothing outstanding
000F2Ar 2               
000F2Ar 2               @Cell:
000F2Ar 2  AD rr rr       lda DirtyCount
000F2Dr 2  C9 40          cmp #DIRTY_ENTRIES
000F2Fr 2  B0 3F          bcs @Done                     ; Ring full — pick this cell up next frame
000F31r 2               
000F31r 2  AE rr rr       ldx RedrawIdx
000F34r 2  8A             txa
000F35r 2  29 07          and #(BOARD_STRIDE - 1)
000F37r 2  18             clc
000F38r 2  69 01          adc #WELL_ORIGIN_X
000F3Ar 2  85 rr          sta RedrawCol
000F3Cr 2  8A             txa
000F3Dr 2  4A             lsr a                         ; Board index >> 3 is the row (stride 8)
000F3Er 2  4A             lsr a
000F3Fr 2  4A             lsr a
000F40r 2  18             clc
000F41r 2  69 04          adc #WELL_ORIGIN_Y
000F43r 2  A8             tay                           ; Y = panel row
000F44r 2  AD rr rr       lda RedrawWash                ; The PAUSE wash is the same walk drawing one
000F47r 2  D0 03          bne @Tile                     ;   tile over every cell instead (SPEC 13.3)
000F49r 2  BD rr rr       lda Board,x                   ; The board byte IS the tile — empty is $00,
000F4Cr 2               @Tile:                          ;   which is TILE_BLANK (SPEC 3.3, 4.2)
000F4Cr 2  A6 rr          ldx RedrawCol
000F4Er 2  20 rr rr       jsr RenderMark
000F51r 2               
000F51r 2  AE rr rr       ldx RedrawIdx                 ; Advance, stepping over the two sentinel
000F54r 2  E8             inx                           ;   columns at the end of each row
000F55r 2  8A             txa
000F56r 2  29 07          and #(BOARD_STRIDE - 1)
000F58r 2  C9 06          cmp #BOARD_W
000F5Ar 2  90 05          bcc @Save
000F5Cr 2  8A             txa
000F5Dr 2  18             clc
000F5Er 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000F60r 2  AA             tax
000F61r 2               @Save:
000F61r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
000F63r 2  B0 06          bcs @Finish
000F65r 2  8E rr rr       stx RedrawIdx
000F68r 2  4C rr rr       jmp @Cell
000F6Br 2               
000F6Br 2               @Finish:
000F6Br 2  A9 FF          lda #$FF
000F6Dr 2  8D rr rr       sta RedrawIdx
000F70r 2               @Done:
000F70r 2  60             rts
000F71r 2               
000F71r 2               ; -----------------------------------------------------------------------------
000F71r 2               ;   RenderCell — queue one board cell by board index
000F71r 2               ;   In:  X = board index (row * BOARD_STRIDE + column)
000F71r 2               ;   Out: nothing.  Modifies: A, X, Y
000F71r 2               ;   The single-cell form of RenderBoardStep, for the phases that move one tile
000F71r 2               ;   at a time.
000F71r 2               ; -----------------------------------------------------------------------------
000F71r 2               RenderCell:
000F71r 2  BD rr rr       lda Board,x                   ; The board byte IS the tile (SPEC 3.3)
000F74r 2                 ; falls through
000F74r 2               
000F74r 2               ; -----------------------------------------------------------------------------
000F74r 2               ;   RenderCellAs — queue one board cell showing something else entirely
000F74r 2               ;   In:  X = board index, A = tile
000F74r 2               ;   Out: nothing.  Modifies: A, X, Y
000F74r 2               ;
000F74r 2               ;   The animation frames are the only tiles in the game that are NOT what the
000F74r 2               ;   board holds: a glow glyph, a beam, a ring frame and a blip frame are all
000F74r 2               ;   drawn over a cell whose board byte still says what it really is, right up
000F74r 2               ;   until CascadeRemove zeroes it (anim.asm, SPEC 8 step 5). Everything else
000F74r 2               ;   goes through RenderCell above and never has to think about it.
000F74r 2               ; -----------------------------------------------------------------------------
000F74r 2               RenderCellAs:
000F74r 2  48             pha
000F75r 2  8A             txa
000F76r 2  29 07          and #(BOARD_STRIDE - 1)
000F78r 2  18             clc
000F79r 2  69 01          adc #WELL_ORIGIN_X
000F7Br 2  85 rr          sta RedrawCol
000F7Dr 2  8A             txa
000F7Er 2  4A             lsr a
000F7Fr 2  4A             lsr a
000F80r 2  4A             lsr a
000F81r 2  18             clc
000F82r 2  69 04          adc #WELL_ORIGIN_Y
000F84r 2  A8             tay
000F85r 2  68             pla
000F86r 2  A6 rr          ldx RedrawCol
000F88r 2  4C rr rr       jmp RenderMark
000F8Br 2               
000F8Br 2               ; -----------------------------------------------------------------------------
000F8Br 2               ;   RenderPiece — queue the three falling cells at where the piece is now
000F8Br 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000F8Br 2               ;
000F8Br 2               ;   RenderMark clobbers X and keeps Y, so the panel column is parked in
000F8Br 2               ;   RedrawCol and the panel row rides Y down the three cells. Cell C can never
000F8Br 2               ;   be lower than board row 15, so all three are always inside the well and
000F8Br 2               ;   there is nothing to clip.
000F8Br 2               ; -----------------------------------------------------------------------------
000F8Br 2               RenderPiece:
000F8Br 2  AD rr rr       lda PieceCol
000F8Er 2  18             clc
000F8Fr 2  69 01          adc #WELL_ORIGIN_X
000F91r 2  85 rr          sta RedrawCol
000F93r 2  AD rr rr       lda PieceRow
000F96r 2  18             clc
000F97r 2  69 04          adc #WELL_ORIGIN_Y
000F99r 2  A8             tay
000F9Ar 2  AD rr rr       lda PieceA
000F9Dr 2  A6 rr          ldx RedrawCol
000F9Fr 2  20 rr rr       jsr RenderMark
000FA2r 2  C8             iny
000FA3r 2  AD rr rr       lda PieceB
000FA6r 2  A6 rr          ldx RedrawCol
000FA8r 2  20 rr rr       jsr RenderMark
000FABr 2  C8             iny
000FACr 2  AD rr rr       lda PieceC
000FAFr 2  A6 rr          ldx RedrawCol
000FB1r 2  4C rr rr       jmp RenderMark
000FB4r 2               
000FB4r 2               ; -----------------------------------------------------------------------------
000FB4r 2               ;   RenderPieceErase — blank the three cells the piece is leaving
000FB4r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000FB4r 2               ;
000FB4r 2               ;   Three blanks rather than three board reads, because the cells under a
000FB4r 2               ;   falling piece are always empty: every move and every gravity step tests
000FB4r 2               ;   the target cells before it happens, and the one thing that writes them is
000FB4r 2               ;   PieceLock, after which nothing erases the piece again (piece.asm).
000FB4r 2               ; -----------------------------------------------------------------------------
000FB4r 2               RenderPieceErase:
000FB4r 2  AD rr rr       lda PieceCol
000FB7r 2  18             clc
000FB8r 2  69 01          adc #WELL_ORIGIN_X
000FBAr 2  85 rr          sta RedrawCol
000FBCr 2  AD rr rr       lda PieceRow
000FBFr 2  18             clc
000FC0r 2  69 04          adc #WELL_ORIGIN_Y
000FC2r 2  A8             tay
000FC3r 2  A9 00          lda #TILE_EMPTY
000FC5r 2  A6 rr          ldx RedrawCol
000FC7r 2  20 rr rr       jsr RenderMark
000FCAr 2  C8             iny
000FCBr 2  A9 00          lda #TILE_EMPTY
000FCDr 2  A6 rr          ldx RedrawCol
000FCFr 2  20 rr rr       jsr RenderMark
000FD2r 2  C8             iny
000FD3r 2  A9 00          lda #TILE_EMPTY
000FD5r 2  A6 rr          ldx RedrawCol
000FD7r 2  4C rr rr       jmp RenderMark
000FDAr 2               
000FDAr 2               ; -----------------------------------------------------------------------------
000FDAr 2               ;   RenderNext — the preview, panel column NEXT_X, rows NEXT_Y..NEXT_Y+2
000FDAr 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000FDAr 2               ;
000FDAr 2               ;   All three cells every time. The play screen image ships with a piece
000FDAr 2               ;   already drawn in the NEXT box (SPEC 12.1), so this has to overwrite rather
000FDAr 2               ;   than assume it is drawing onto backdrop.
000FDAr 2               ; -----------------------------------------------------------------------------
000FDAr 2               RenderNext:
000FDAr 2  A0 10          ldy #NEXT_Y
000FDCr 2  AD rr rr       lda NextA
000FDFr 2  A2 0B          ldx #NEXT_X
000FE1r 2  20 rr rr       jsr RenderMark
000FE4r 2  C8             iny
000FE5r 2  AD rr rr       lda NextB
000FE8r 2  A2 0B          ldx #NEXT_X
000FEAr 2  20 rr rr       jsr RenderMark
000FEDr 2  C8             iny
000FEEr 2  AD rr rr       lda NextC
000FF1r 2  A2 0B          ldx #NEXT_X
000FF3r 2  4C rr rr       jmp RenderMark
000FF6r 2               
000FF6r 2               ; -----------------------------------------------------------------------------
000FF6r 2               ;   RenderScore / RenderHigh / RenderLevel — only called when a value changes
000FF6r 2               ;   Nothing here compares anything: the caller knows when it changed a value
000FF6r 2               ;   and these are not cheap enough to run every frame. SCORE_DIGITS cells is
000FF6r 2               ;   most of a frame's flush budget on its own.
000FF6r 2               ; -----------------------------------------------------------------------------
000FF6r 2               RenderScore:
000FF6r 2  A9 rr          lda #<ScoreLo
000FF8r 2  85 rr          sta Ptr1
000FFAr 2  A9 rr          lda #>ScoreLo
000FFCr 2  85 rr          sta Ptr1+1
000FFEr 2  A2 0C          ldx #SCORE_X
001000r 2  A0 05          ldy #SCORE_Y
001002r 2  A9 07          lda #SCORE_DIGITS
001004r 2  4C rr rr       jmp TextBcd
001007r 2               
001007r 2               RenderHigh:
001007r 2  A9 rr          lda #<HighLo
001009r 2  85 rr          sta Ptr1
00100Br 2  A9 rr          lda #>HighLo
00100Dr 2  85 rr          sta Ptr1+1
00100Fr 2  A2 0C          ldx #HIGH_X
001011r 2  A0 0A          ldy #HIGH_Y
001013r 2  A9 07          lda #SCORE_DIGITS
001015r 2  20 rr rr       jsr TextBcd
001018r 2               
001018r 2  A9 rr          lda #<HighLevel               ; The level it was set on, under the digits
00101Ar 2  85 rr          sta Ptr1
00101Cr 2  A9 rr          lda #>HighLevel
00101Er 2  85 rr          sta Ptr1+1
001020r 2  A2 0F          ldx #HIGHLVL_X
001022r 2  A0 0B          ldy #HIGHLVL_Y
001024r 2  A9 02          lda #LEVEL_DIGITS
001026r 2  4C rr rr       jmp TextBcd
001029r 2               
001029r 2               ; -----------------------------------------------------------------------------
001029r 2               ;   RenderHighBlank — the dark half of the HIGH field's overtake flash
001029r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y, TextCol
001029r 2               ;   SPEC 9.8. The seven digits only; the level under them stays put, so the
001029r 2               ;   box never looks empty and the flash costs seven cells of the budget.
001029r 2               ; -----------------------------------------------------------------------------
001029r 2               RenderHighBlank:
001029r 2  A9 07          lda #SCORE_DIGITS
00102Br 2  A2 0C          ldx #HIGH_X
00102Dr 2  A0 0A          ldy #HIGH_Y
00102Fr 2  4C rr rr       jmp TextClearRun
001032r 2               
001032r 2               RenderLevel:
001032r 2  AD rr rr       lda Level
001035r 2  4C rr rr       jmp TextLevel
001038r 2               
001038r 1               .include "../src/text.asm"
001038r 2               ; =============================================================================
001038r 2               ;   text.asm — Wizards Lab, text and numbers on the panel
001038r 2               ; =============================================================================
001038r 2               ;   The font lives in tile groups 2-6, forty glyphs in the order
001038r 2               ;
001038r 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
001038r 2               ;
001038r 2               ;   starting at FONT_BASE, so a digit is FONT_DIGIT_0 + value and a letter is
001038r 2               ;   FONT_LETTER_A + (letter - 'A'). Strings are stored pre-converted to tile
001038r 2               ;   numbers, terminated by TEXT_END, so drawing one is a copy with no
001038r 2               ;   translation. src/strings.inc holds them and the macro that encodes them.
001038r 2               ;
001038r 2               ;   Everything here draws through RenderMark, never to the screen: text is
001038r 2               ;   panel cells like any other and goes through the same one flush a frame.
001038r 2               ;   That is also why the cursor state lives in the zero-page block RenderMark
001038r 2               ;   promises not to touch (zeropage.inc) rather than in Tmp0-Tmp3.
001038r 2               ; =============================================================================
001038r 2               
001038r 2               ; -----------------------------------------------------------------------------
001038r 2               ;   TextDraw — draw a tile-encoded string
001038r 2               ;   In:  Ptr1 -> string (TEXT_END terminated), X = panel column, Y = panel row
001038r 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx
001038r 2               ; -----------------------------------------------------------------------------
001038r 2               TextDraw:
001038r 2  86 rr          stx TextCol
00103Ar 2  84 rr          sty TextRow
00103Cr 2  A9 00          lda #0
00103Er 2  85 rr          sta TextIdx
001040r 2               @Char:
001040r 2  A4 rr          ldy TextIdx
001042r 2  B1 rr          lda (Ptr1),y
001044r 2  C9 FF          cmp #TEXT_END
001046r 2  F0 0D          beq @Done
001048r 2  A6 rr          ldx TextCol
00104Ar 2  A4 rr          ldy TextRow
00104Cr 2  20 rr rr       jsr RenderMark
00104Fr 2  E6 rr          inc TextCol
001051r 2  E6 rr          inc TextIdx
001053r 2  D0 EB          bne @Char                     ; Always — a string is never 256 tiles long
001055r 2               @Done:
001055r 2  60             rts
001056r 2               
001056r 2               ; -----------------------------------------------------------------------------
001056r 2               ;   TextBcd — draw a packed-BCD number, zero padded
001056r 2               ;   In:  Ptr1 -> BCD bytes (low first), A = digit count,
001056r 2               ;        X = panel column, Y = panel row
001056r 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx, TextByte,
001056r 2               ;        TextSkip
001056r 2               ;
001056r 2               ;   SCORE_DIGITS (7) for the score and the high score, 2 for the high score's
001056r 2               ;   level. The LEVEL box is not drawn with this — see TextLevel.
001056r 2               ;
001056r 2               ;   The count is in DIGITS, not bytes, because the score is seven digits in
001056r 2               ;   four bytes: the top nibble of the most significant byte is held at zero
001056r 2               ;   (SPEC 9) and must not be drawn, or the field would be eight cells wide and
001056r 2               ;   no longer centred. An odd count starts at the LOW nibble of the top byte.
001056r 2               ;
001056r 2               ;   **Every digit is drawn, every time.** A leading zero is a zero glyph, not
001056r 2               ;   a blank: 1250 draws as 0001250. There is no suppression pass and no
001056r 2               ;   right-alignment — the field is fixed width so a digit never changes
001056r 2               ;   column while the player is watching it (SPEC 9). This also makes the
001056r 2               ;   routine branchless, and lets RenderScore mark a fixed run of cells dirty.
001056r 2               ; -----------------------------------------------------------------------------
001056r 2               TextBcd:
001056r 2  86 rr          stx TextCol
001058r 2  84 rr          sty TextRow
00105Ar 2  48             pha                           ; Digit count
00105Br 2  29 01          and #$01
00105Dr 2  85 rr          sta TextSkip                  ; Odd count: the top high nibble is not drawn
00105Fr 2  68             pla
001060r 2  18             clc
001061r 2  69 01          adc #1                        ; Bytes = (digits + 1) / 2
001063r 2  4A             lsr a
001064r 2  AA             tax
001065r 2  CA             dex
001066r 2  86 rr          stx TextIdx                   ; Start at the most significant byte
001068r 2               
001068r 2               @Byte:
001068r 2  A4 rr          ldy TextIdx
00106Ar 2  B1 rr          lda (Ptr1),y
00106Cr 2  85 rr          sta TextByte
00106Er 2               
00106Er 2  A5 rr          lda TextSkip
001070r 2  D0 09          bne @Low
001072r 2  A5 rr          lda TextByte
001074r 2  4A             lsr a
001075r 2  4A             lsr a
001076r 2  4A             lsr a
001077r 2  4A             lsr a
001078r 2  20 rr rr       jsr TextDigit
00107Br 2               @Low:
00107Br 2  A9 00          lda #0
00107Dr 2  85 rr          sta TextSkip
00107Fr 2  A5 rr          lda TextByte
001081r 2  29 0F          and #$0F
001083r 2  20 rr rr       jsr TextDigit
001086r 2               
001086r 2  C6 rr          dec TextIdx
001088r 2  10 DE          bpl @Byte
00108Ar 2  60             rts
00108Br 2               
00108Br 2               ; -----------------------------------------------------------------------------
00108Br 2               ;   TextDigit — draw one digit at the cursor and step it right
00108Br 2               ;   In:  A = value 0-9      Modifies: A, X, Y, TextCol
00108Br 2               ; -----------------------------------------------------------------------------
00108Br 2               TextDigit:
00108Br 2  18             clc
00108Cr 2  69 10          adc #FONT_DIGIT_0
00108Er 2  A6 rr          ldx TextCol
001090r 2  A4 rr          ldy TextRow
001092r 2  20 rr rr       jsr RenderMark
001095r 2  E6 rr          inc TextCol
001097r 2  60             rts
001098r 2               
001098r 2               ; -----------------------------------------------------------------------------
001098r 2               ;   TextBanner — centre a string in the one-row message band
001098r 2               ;   In:  Ptr1 -> string
001098r 2               ;   Out: nothing.  Modifies: A, X, Y and the text cursor
001098r 2               ;
001098r 2               ;   SPEC 12.2 — the band is panel row MSG_Y, full width, one row only. The
001098r 2               ;   string arrives already wrapped as `~~ TEXT ~~` — two FONT_TILDE, a blank,
001098r 2               ;   the text, a blank, two FONT_TILDE. Centring is (PANEL_W - length) / 2,
001098r 2               ;   which is why banner strings are drawn even-length.
001098r 2               ;
001098r 2               ;   THE BAND EITHER SIDE OF THE STRING IS BLANKED, and only that. Banners are
001098r 2               ;   not all the same width — `~~ PAUSED ~~` is two cells narrower than
001098r 2               ;   `~~ LEVEL UP ~~`, which is exactly what pausing during a level-up meets —
001098r 2               ;   so a shorter one drawn straight over a longer one would leave the tail of
001098r 2               ;   the old ornament sitting either side of it. Blanking the WHOLE band first
001098r 2               ;   would fix that too, and cost 18 marks on top of the string's: past
001098r 2               ;   DIRTY_FLUSH_MAX, so every banner in the game would take an extra frame to
001098r 2               ;   arrive. Blanking the margins costs only the cells the string is not
001098r 2               ;   covering — six for the narrowest banner in the game, two for the widest.
001098r 2               ; -----------------------------------------------------------------------------
001098r 2               TextBanner:
001098r 2  A0 00          ldy #0
00109Ar 2               @Len:
00109Ar 2  B1 rr          lda (Ptr1),y
00109Cr 2  C9 FF          cmp #TEXT_END
00109Er 2  F0 03          beq @Got
0010A0r 2  C8             iny
0010A1r 2  D0 F7          bne @Len
0010A3r 2               @Got:
0010A3r 2  98             tya
0010A4r 2  85 rr          sta TextIdx
0010A6r 2  A9 16          lda #PANEL_W
0010A8r 2  38             sec
0010A9r 2  E5 rr          sbc TextIdx
0010ABr 2  4A             lsr a                         ; (PANEL_W - length) / 2
0010ACr 2  85 rr          sta TextByte                  ; Where the string starts...
0010AEr 2  18             clc
0010AFr 2  65 rr          adc TextIdx
0010B1r 2  85 rr          sta TextSkip                  ; ...and one cell past where it ends. Neither
0010B3r 2                                               ;   is TextCol / TextRow / TextIdx, because
0010B3r 2                                               ;   TextClearRun below takes those
0010B3r 2               
0010B3r 2  A5 rr          lda TextByte                  ; The band to the left of it
0010B5r 2  38             sec
0010B6r 2  E9 02          sbc #MSG_X
0010B8r 2  F0 07          beq @Right
0010BAr 2  A2 02          ldx #MSG_X
0010BCr 2  A0 16          ldy #MSG_Y
0010BEr 2  20 rr rr       jsr TextClearRun
0010C1r 2               @Right:
0010C1r 2  A9 14          lda #(MSG_X + MSG_W)          ; ...and to the right
0010C3r 2  38             sec
0010C4r 2  E5 rr          sbc TextSkip
0010C6r 2  F0 07          beq @Draw
0010C8r 2  A6 rr          ldx TextSkip
0010CAr 2  A0 16          ldy #MSG_Y
0010CCr 2  20 rr rr       jsr TextClearRun
0010CFr 2               @Draw:
0010CFr 2  A6 rr          ldx TextByte
0010D1r 2  A0 16          ldy #MSG_Y
0010D3r 2  4C rr rr       jmp TextDraw
0010D6r 2               
0010D6r 2               ; -----------------------------------------------------------------------------
0010D6r 2               ;   TextBannerClear — blank the message band back to backdrop
0010D6r 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx
0010D6r 2               ;
0010D6r 2               ;   Columns MSG_X .. MSG_X + MSG_W - 1 only. The shelf tiles at either end of
0010D6r 2               ;   the band belong to the static screen image and are never redrawn.
0010D6r 2               ; -----------------------------------------------------------------------------
0010D6r 2               TextBannerClear:
0010D6r 2  A9 12          lda #MSG_W
0010D8r 2  A2 02          ldx #MSG_X
0010DAr 2  A0 16          ldy #MSG_Y
0010DCr 2                 ; falls through
0010DCr 2               
0010DCr 2               ; -----------------------------------------------------------------------------
0010DCr 2               ;   TextClearRun — blank a horizontal run of panel cells
0010DCr 2               ;   In:  A = width (never 0), X = panel column, Y = panel row
0010DCr 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx
0010DCr 2               ;
0010DCr 2               ;   Three callers wanted this loop with different numbers in it: the message
0010DCr 2               ;   band above, the HIGH field's dark half (SPEC 9.8) and the title screen's
0010DCr 2               ;   blinking prompt (SPEC 13.1). The cursor is in memory for the usual reason —
0010DCr 2               ;   RenderMark clobbers A and X and keeps only Y (D13).
0010DCr 2               ; -----------------------------------------------------------------------------
0010DCr 2               TextClearRun:
0010DCr 2  85 rr          sta TextIdx                   ; Cells left
0010DEr 2  86 rr          stx TextCol
0010E0r 2  84 rr          sty TextRow
0010E2r 2               @Cell:
0010E2r 2  A9 00          lda #TILE_BLANK
0010E4r 2  A6 rr          ldx TextCol
0010E6r 2  A4 rr          ldy TextRow
0010E8r 2  20 rr rr       jsr RenderMark
0010EBr 2  E6 rr          inc TextCol
0010EDr 2  C6 rr          dec TextIdx
0010EFr 2  D0 F1          bne @Cell
0010F1r 2  60             rts
0010F2r 2               
0010F2r 2               ; -----------------------------------------------------------------------------
0010F2r 2               ;   TextLevel — the LEVEL box, tens above units in one column
0010F2r 2               ;   In:  A = level (binary, 1-99)
0010F2r 2               ;   Out: nothing.  Modifies: A, X, Y, TextByte
0010F2r 2               ;   SPEC 12.2 — LEVEL_X, tens at LEVEL_Y and units at LEVEL_Y + 1. Always two
0010F2r 2               ;   digits: level 5 draws "0" over "5".
0010F2r 2               ; -----------------------------------------------------------------------------
0010F2r 2               TextLevel:
0010F2r 2  A2 00          ldx #0
0010F4r 2               @Tens:
0010F4r 2  C9 0A          cmp #10
0010F6r 2  90 05          bcc @Split
0010F8r 2  E9 0A          sbc #10                       ; Carry is set by the CMP that got us here
0010FAr 2  E8             inx
0010FBr 2  D0 F7          bne @Tens                     ; Always — X tops out at 9
0010FDr 2               @Split:
0010FDr 2  85 rr          sta TextByte                  ; Units
0010FFr 2  8A             txa
001100r 2  18             clc
001101r 2  69 10          adc #FONT_DIGIT_0
001103r 2  A2 12          ldx #LEVEL_X
001105r 2  A0 11          ldy #LEVEL_Y
001107r 2  20 rr rr       jsr RenderMark
00110Ar 2  A5 rr          lda TextByte
00110Cr 2  18             clc
00110Dr 2  69 10          adc #FONT_DIGIT_0
00110Fr 2  A2 12          ldx #LEVEL_X
001111r 2  A0 12          ldy #LEVEL_Y + 1
001113r 2  4C rr rr       jmp RenderMark
001116r 2               
001116r 1               .include "../src/audio.asm"
001116r 2               ; =============================================================================
001116r 2               ;   audio.asm — Wizards Lab, sound
001116r 2               ; =============================================================================
001116r 2               ;   SPEC.md section 16. Twelve effects, one channel, and none of it knows what
001116r 2               ;   a sound chip is: an effect is a list of STEPS in ROM (tables.inc), a step
001116r 2               ;   is a duration, a timbre and a note, and pushing one at the hardware is
001116r 2               ;   HalSfx's whole job (hal.inc).
001116r 2               ;
001116r 2               ;   That split is the opposite way round from the one SPEC 16 assumed. It said
001116r 2               ;   the AC6502 and the C64 would share a SID driver and the VIC-20 would need
001116r 2               ;   its own, which is true of the twenty lines that write registers and of
001116r 2               ;   nothing else: the sequencing, the priority, the envelope of an effect
001116r 2               ;   across frames and every note in the game are the same on all three, so
001116r 2               ;   they live here and are shared by all three rather than by two (PLAN.md
001116r 2               ;   D22). What each platform still owns is a note table and five stores.
001116r 2               ;
001116r 2               ;   ONE CHANNEL. The id is the priority — SPEC 16 lists the twelve from the
001116r 2               ;   quietest event to the loudest — so a request takes the channel only if its
001116r 2               ;   id is at least the id of what is already playing. That is what keeps the
001116r 2               ;   move blip out of the middle of a fireball, and it is why SfxPlay exists
001116r 2               ;   rather than logic storing into SfxRequest: a lock, a match and a bomb can
001116r 2               ;   all be requested in ONE frame, and last-write-wins would pick whichever
001116r 2               ;   the code happened to reach last.
001116r 2               ;
001116r 2               ;   AND ONE LEVEL. Neither sound chip has a per-voice volume, so "quieter"
001116r 2               ;   cannot be a property of a note: it is a master register the platform writes
001116r 2               ;   on its way past, and the byte that carries the choice to it is the timbre,
001116r 2               ;   bit 7 (constants.inc). Nothing the GAME plays ever sets it. It exists for
001116r 2               ;   the title screen, which plays the same twelve effects at half volume
001116r 2               ;   underneath a cauldron (ambience.asm).
001116r 2               ;
001116r 2               ;   Nothing here waits, loops over cells, or touches the screen. AudioTick is
001116r 2               ;   fifteen cycles on a frame where nothing changes and a step's worth of
001116r 2               ;   register writes on a frame where something does, so it cannot delay a
001116r 2               ;   frame however the frame is going.
001116r 2               ; =============================================================================
001116r 2               
001116r 2               ; -----------------------------------------------------------------------------
001116r 2               ;   AudioInit — silence, and whatever the sound chip needs to be told once
001116r 2               ;   Out: nothing.  Modifies: A, X
001116r 2               ; -----------------------------------------------------------------------------
001116r 2               AudioInit:
001116r 2  A9 00          lda #0
001118r 2  8D rr rr       sta SfxRequest
00111Br 2  8D rr rr       sta SfxId
00111Er 2  8D rr rr       sta SfxTimer
001121r 2  8D rr rr       sta SfxShift
001124r 2  8D rr rr       sta SfxStepIdx
001127r 2  8D rr rr       sta SfxLevel                  ; Full volume, and no ambience — the title
00112Ar 2                                               ;   screen turns both on for itself
00112Ar 2  A2 00          ldx #0
00112Cr 2  A9 00          lda #TIMBRE_OFF
00112Er 2  4C rr rr       jmp HalSfx
001131r 2               
001131r 2               ; -----------------------------------------------------------------------------
001131r 2               ;   SfxPlay — ask for an effect
001131r 2               ;   In:  A = SFX_* id
001131r 2               ;   Out: nothing.  Modifies: A only — X, Y and zero page are untouched, because
001131r 2               ;        half the callers are in the middle of a walk that is holding a cursor
001131r 2               ;        in a register (cascade.asm).
001131r 2               ;
001131r 2               ;   The loudest request in a frame is the one that survives, and the id is the
001131r 2               ;   loudness. A quieter one is not queued for later: by the next frame the
001131r 2               ;   event it belonged to is over.
001131r 2               ; -----------------------------------------------------------------------------
001131r 2               SfxPlay:
001131r 2  CD rr rr       cmp SfxRequest
001134r 2  90 03          bcc @Done                     ; Something at least as loud is already asked
001136r 2  8D rr rr       sta SfxRequest                ;   for this frame
001139r 2               @Done:
001139r 2  60             rts
00113Ar 2               
00113Ar 2               ; -----------------------------------------------------------------------------
00113Ar 2               ;   AudioTick — one frame of sound. Called from the bottom of the main loop.
00113Ar 2               ;   Out: nothing.  Modifies: A, X, Y
00113Ar 2               ; -----------------------------------------------------------------------------
00113Ar 2               AudioTick:
00113Ar 2  AD rr rr       lda SfxRequest
00113Dr 2  F0 0D          beq @Advance                  ; Nothing asked for — carry on with what plays
00113Fr 2  A2 00          ldx #0
001141r 2  8E rr rr       stx SfxRequest                ; Consumed either way: a request that loses is
001144r 2  CD rr rr       cmp SfxId                     ;   dropped, not held over
001147r 2  90 03          bcc @Advance
001149r 2  4C rr rr       jmp SfxBegin
00114Cr 2               
00114Cr 2               @Advance:
00114Cr 2  AD rr rr       lda SfxId
00114Fr 2  F0 09          beq @Idle                     ; Silent...
001151r 2  CE rr rr       dec SfxTimer
001154r 2  D0 03          bne @Done                     ; The step still has frames left in it
001156r 2  4C rr rr       jmp SfxStep                   ; ...and when it does not, the next one starts
001159r 2               @Done:
001159r 2  60             rts
00115Ar 2               
00115Ar 2               @Idle:                          ; ...and silence is where the title screen puts
00115Ar 2  4C rr rr       jmp AmbienceTick              ;   its cauldron. Nine cycles and an RTS in
00115Dr 2                                               ;   play, where the ambience is off
00115Dr 2               
00115Dr 2               ; -----------------------------------------------------------------------------
00115Dr 2               ;   SfxBegin — start an effect from its first step
00115Dr 2               ;   In:  A = SFX_* id
00115Dr 2               ;   Out: nothing.  Modifies: A, X, Y
00115Dr 2               ;
00115Dr 2               ;   Eleven of the twelve play at the pitch tables.inc wrote them at. The match
00115Dr 2               ;   chime is the one SPEC 16 says rises with the chain, and it rises by
00115Dr 2               ;   transposing the whole effect rather than by having a step list per depth —
00115Dr 2               ;   which is the whole of what this routine does before it hands over to
00115Dr 2               ;   SfxBeginShifted below.
00115Dr 2               ; -----------------------------------------------------------------------------
00115Dr 2               SfxBegin:
00115Dr 2  A2 00          ldx #0
00115Fr 2  C9 04          cmp #SFX_MATCH
001161r 2  D0 12          bne SfxBeginShifted
001163r 2               
001163r 2  48             pha                           ; The id; SfxBeginShifted wants it in A
001164r 2  AD rr rr       lda ChainStep                 ; 1 on the first step of a cascade (SPEC 8)
001167r 2  F0 0B          beq @Flat                     ; Never zero in practice; X is already 0
001169r 2  38             sec
00116Ar 2  E9 01          sbc #1
00116Cr 2  0A             asl a                         ; SFX_CHAIN_SHIFT semitones a link
00116Dr 2  C9 09          cmp #(SFX_CHAIN_MAX + 1)
00116Fr 2  90 02          bcc @Capped
001171r 2  A9 08          lda #SFX_CHAIN_MAX
001173r 2               @Capped:
001173r 2  AA             tax
001174r 2               @Flat:
001174r 2  68             pla
001175r 2                 ; falls through
001175r 2               
001175r 2               ; -----------------------------------------------------------------------------
001175r 2               ;   SfxBeginShifted — start an effect transposed by a given number of semitones
001175r 2               ;   In:  A = SFX_* id, X = semitones to add to every note of it
001175r 2               ;   Out: nothing.  Modifies: A, X, Y
001175r 2               ;
001175r 2               ;   Split out of SfxBegin for the title screen's ambience, which pitches every
001175r 2               ;   bubble by a fresh random amount and would otherwise have to write SfxShift
001175r 2               ;   after SfxBegin had already played the first step at the wrong pitch
001175r 2               ;   (ambience.asm). It takes the channel unconditionally and is not a request:
001175r 2               ;   the only caller outside SfxBegin knows the channel is silent because it is
001175r 2               ;   only reached on a frame where it was.
001175r 2               ; -----------------------------------------------------------------------------
001175r 2               SfxBeginShifted:
001175r 2  8D rr rr       sta SfxId
001178r 2  8E rr rr       stx SfxShift
00117Br 2  AE rr rr       ldx SfxId
00117Er 2  BD rr rr       lda SfxOffsets - 1,x          ; The id is 1-based; the table is not
001181r 2  8D rr rr       sta SfxStepIdx
001184r 2                 ; falls through into the first step
001184r 2               
001184r 2               ; -----------------------------------------------------------------------------
001184r 2               ;   SfxStep — play the step at SfxStepIdx and advance past it
001184r 2               ;   Out: nothing.  Modifies: A, X, Y
001184r 2               ;   A zero frame count is the end of the effect and returns the channel to
001184r 2               ;   silence — which is a real event on a SID, where it is the gate coming down.
001184r 2               ; -----------------------------------------------------------------------------
001184r 2               SfxStep:
001184r 2  AE rr rr       ldx SfxStepIdx
001187r 2  BD rr rr       lda SfxSteps,x
00118Ar 2  F0 25          beq @End
00118Cr 2  8D rr rr       sta SfxTimer
00118Fr 2               
00118Fr 2  BD rr rr       lda SfxSteps + 2,x            ; The note...
001192r 2  18             clc
001193r 2  6D rr rr       adc SfxShift                  ;   ...transposed, for the match chime
001196r 2  C9 25          cmp #(NOTE_MAX + 1)
001198r 2  90 02          bcc @Note
00119Ar 2  A9 24          lda #NOTE_MAX                 ; Both note tables stop at C6 and a chain deep
00119Cr 2               @Note:                          ;   enough to push past it clamps rather than
00119Cr 2  A8             tay                           ;   reading off the end of one
00119Dr 2  BD rr rr       lda SfxSteps + 1,x            ; The timbre...
0011A0r 2  0D rr rr       ora SfxLevel                  ;   ...and how loud, which is bit 7 of the same
0011A3r 2                                               ;   byte and is zero for everything the game
0011A3r 2                                               ;   itself plays (constants.inc). A step whose
0011A3r 2                                               ;   timbre is TIMBRE_OFF — a rest — comes out of
0011A3r 2                                               ;   here as $80, and every HalSfx masks the bit
0011A3r 2                                               ;   off before it looks, so a quiet rest is
0011A3r 2                                               ;   still a rest
0011A3r 2  48             pha
0011A4r 2  8A             txa
0011A5r 2  18             clc
0011A6r 2  69 03          adc #SFX_STEP_BYTES
0011A8r 2  8D rr rr       sta SfxStepIdx
0011ABr 2  98             tya
0011ACr 2  AA             tax                           ; X = note
0011ADr 2  68             pla                           ; A = timbre
0011AEr 2  4C rr rr       jmp HalSfx
0011B1r 2               
0011B1r 2               @End:
0011B1r 2  A9 00          lda #0
0011B3r 2  8D rr rr       sta SfxId
0011B6r 2  A2 00          ldx #0
0011B8r 2  AD rr rr       lda SfxLevel                  ; TIMBRE_OFF at the level the channel is AT, and
0011BBr 2                                               ;   TIMBRE_OFF is zero, so the level is the
0011BBr 2                                               ;   whole byte. Letting go at full volume
0011BBr 2                                               ;   instead would put the master register back
0011BBr 2                                               ;   up before the SID's release tail of a quiet
0011BBr 2                                               ;   note had finished, and every bubble on the
0011BBr 2                                               ;   title screen would end in a click
0011BBr 2                                               ;   (include/sid.inc)
0011BBr 2  4C rr rr       jmp HalSfx
0011BEr 2               
0011BEr 1               .include "../src/ambience.asm"
0011BEr 2               ; =============================================================================
0011BEr 2               ;   ambience.asm — Wizards Lab, the sound of the title screen
0011BEr 2               ; =============================================================================
0011BEr 2               ;   SPEC 13.1 gives the title screen two moving things and no sound at all.
0011BEr 2               ;   This is a third: not music, which one channel and no envelope cannot carry
0011BEr 2               ;   for thirty seconds without becoming a nursery rhyme, but the ROOM. A
0011BEr 2               ;   cauldron bubbling away somewhere under the page, and every so often one of
0011BEr 2               ;   the game's own effects drifting past at half volume as though an experiment
0011BEr 2               ;   two benches over just went off.
0011BEr 2               ;
0011BEr 2               ;   HOW IT FITS IN ONE CHANNEL. It does not mix, because nothing here can mix:
0011BEr 2               ;   there is one voice and no way to sum two sounds into it. What it does
0011BEr 2               ;   instead is fill the gaps. AudioTick calls this from the frame where the
0011BEr 2               ;   channel fell silent and from no other (audio.asm), so the ambience only
0011BEr 2               ;   ever speaks when nothing else is speaking, and a bubble is not a special
0011BEr 2               ;   case of anything — it is an effect out of the same table, begun through the
0011BEr 2               ;   same driver, at half volume and a random pitch.
0011BEr 2               ;
0011BEr 2               ;   That last part is what stops it sounding like a loop. There are three
0011BEr 2               ;   cauldron sounds; there are thirty-two entries in AmbTable saying how often
0011BEr 2               ;   each of them and each of the five borrowed effects comes up; every one is
0011BEr 2               ;   transposed by a fresh 0-7 semitones as it starts; and the quiet between
0011BEr 2               ;   them is rolled every time. Two random bytes and a table lookup per sound.
0011BEr 2               ;
0011BEr 2               ;   WHY IT NEEDS NO OFF SWITCH IN PLAY. SfxLevel is both the volume and the
0011BEr 2               ;   flag, and the game never sets it. A frame of play reaches AmbienceTick only
0011BEr 2               ;   when nothing is sounding, reads one byte, finds zero and returns: nine
0011BEr 2               ;   cycles, and no branch anywhere else in the audio path (ram.inc).
0011BEr 2               ; =============================================================================
0011BEr 2               
0011BEr 2               ; -----------------------------------------------------------------------------
0011BEr 2               ;   AmbienceBegin — the lab starts murmuring
0011BEr 2               ;   Out: nothing.  Modifies: A
0011BEr 2               ;   Called from the title screen's redraw, beside AnimTitleBegin, so a second
0011BEr 2               ;   visit in a session sounds like the first one (main.asm).
0011BEr 2               ; -----------------------------------------------------------------------------
0011BEr 2               AmbienceBegin:
0011BEr 2  A9 80          lda #TIMBRE_QUIET             ; Half volume from here until GameStart, and
0011C0r 2  8D rr rr       sta SfxLevel                  ;   the flag that says this routine is live
0011C3r 2  A9 07          lda #AMB_GAP_MIN
0011C5r 2  8D rr rr       sta AmbTimer                  ; A beat before the first sound, not a bloop on
0011C8r 2  60             rts                           ;   the frame the screen appears — the title
0011C9r 2                                               ;   arrives from a game-over fanfare as often as
0011C9r 2                                               ;   from a cold boot, and a cauldron that starts
0011C9r 2                                               ;   ON the cut reads as part of the fanfare
0011C9r 2               
0011C9r 2               ; -----------------------------------------------------------------------------
0011C9r 2               ;   AmbienceEnd — and stops
0011C9r 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0-Tmp2 (HalSfx)
0011C9r 2               ;
0011C9r 2               ;   Cuts whatever is sounding rather than letting it finish, because what
0011C9r 2               ;   follows this is the play screen and the first thing on it is a piece
0011C9r 2               ;   spawning. A bubble carried over the cut would be the game's first noise.
0011C9r 2               ; -----------------------------------------------------------------------------
0011C9r 2               AmbienceEnd:
0011C9r 2  A9 00          lda #0
0011CBr 2  8D rr rr       sta SfxLevel
0011CEr 2  8D rr rr       sta SfxId
0011D1r 2  8D rr rr       sta SfxRequest                ; Nothing on the title screen asks for a sound,
0011D4r 2                                               ;   but a byte of BSS is not a promise
0011D4r 2  A2 00          ldx #0
0011D6r 2  A9 00          lda #TIMBRE_OFF
0011D8r 2  4C rr rr       jmp HalSfx
0011DBr 2               
0011DBr 2               ; -----------------------------------------------------------------------------
0011DBr 2               ;   AmbienceTick — one frame of it, from AudioTick's silent branch
0011DBr 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0, Tmp1
0011DBr 2               ;
0011DBr 2               ;   The gap is counted HERE and not in the main loop, which is the reason this
0011DBr 2               ;   hangs off the silent branch rather than off StateTitle: a sound that runs
0011DBr 2               ;   forty frames should be followed by the full gap, not by whatever is left of
0011DBr 2               ;   one that was ticking down underneath it. Silence is the only thing the
0011DBr 2               ;   timer measures.
0011DBr 2               ; -----------------------------------------------------------------------------
0011DBr 2               AmbienceTick:
0011DBr 2  AD rr rr       lda SfxLevel
0011DEr 2  F0 2E          beq @Done                     ; The game is playing — this is the whole cost
0011E0r 2  CE rr rr       dec AmbTimer
0011E3r 2  D0 29          bne @Done                     ; Still quiet
0011E5r 2               
0011E5r 2  20 rr rr       jsr RngNext
0011E8r 2  29 1F          and #(AMB_ENTRIES - 1)        ; A power-of-two table, so a masked byte picks
0011EAr 2  AA             tax                           ;   one evenly without RngRange
0011EBr 2  BD rr rr       lda AmbTable,x
0011EEr 2  48             pha                           ; The sound, parked while the pitch is rolled —
0011EFr 2                                               ;   nothing may hold a value in Tmp0-Tmp3
0011EFr 2                                               ;   across RngRange (zeropage.inc)
0011EFr 2  A9 08          lda #AMB_SHIFT_RANGE
0011F1r 2  20 rr rr       jsr RngRange                  ; 0 .. 7 semitones up: what makes two bubbles
0011F4r 2  AA             tax                           ;   two different sizes rather than one sound
0011F5r 2  68             pla
0011F6r 2  20 rr rr       jsr SfxBeginShifted           ; The channel is silent — that is the only
0011F9r 2                                               ;   frame this routine runs on — so it is taken
0011F9r 2                                               ;   outright and not asked for (audio.asm)
0011F9r 2               
0011F9r 2  A9 1A          lda #AMB_GAP_RANGE
0011FBr 2  20 rr rr       jsr RngRange
0011FEr 2  18             clc
0011FFr 2  69 07          adc #AMB_GAP_MIN              ; AMB_GAP_MIN .. MIN + RANGE - 1 frames of quiet
001201r 2  AE rr rr       ldx SfxId                     ; What just started, read back off the channel
001204r 2  E0 0E          cpx #SFX_CAULDRON             ;   rather than remembered across two calls
001206r 2  B0 03          bcs @Set                      ; The cauldron carries straight on...
001208r 2  18             clc
001209r 2  69 28          adc #AMB_GAP_EVENT            ; ...but the lab goes quiet for a while after
00120Br 2               @Set:                           ;   something actually happens in it
00120Br 2  8D rr rr       sta AmbTimer
00120Er 2               @Done:
00120Er 2  60             rts
00120Fr 2               
00120Fr 1               
00120Fr 1               ; =============================================================================
00120Fr 1               ;   HAL — VIC-II, standard text mode
00120Fr 1               ; =============================================================================
00120Fr 1               
00120Fr 1               ; -----------------------------------------------------------------------------
00120Fr 1               ;   HalInitVideo — 40 x 25 cells, custom charset at $2000, everything black
00120Fr 1               ; -----------------------------------------------------------------------------
00120Fr 1               HalInitVideo:
00120Fr 1  AD 00 DD       lda $DD00                     ; VIC bank 0: $0000-$3FFF
001212r 1  09 03          ora #$03
001214r 1  8D 00 DD       sta $DD00
001217r 1               
001217r 1  A9 1B          lda #$1B                      ; Text mode, display on, 25 rows
001219r 1  8D 11 D0       sta VIC_CTRL1
00121Cr 1  A9 C8          lda #$C8                      ; 40 columns, no multicolor
00121Er 1  8D 16 D0       sta VIC_CTRL2
001221r 1  A9 18          lda #$18                      ; Screen $0400, character set $2000
001223r 1  8D 18 D0       sta VIC_MEMPTR
001226r 1  A9 00          lda #$00
001228r 1  8D 20 D0       sta VIC_BORDERCOL
00122Br 1  8D 21 D0       sta VIC_BGCOL0
00122Er 1  8D 15 D0       sta VIC_SPRENA                ; No sprites. Not an oversight — see the header.
001231r 1               
001231r 1  20 rr rr       jsr LoadTileset
001234r 1                 ; falls through
001234r 1               
001234r 1               ; -----------------------------------------------------------------------------
001234r 1               ;   HalClearScreen — blank tiles, white colour RAM
001234r 1               ; -----------------------------------------------------------------------------
001234r 1               HalClearScreen:
001234r 1  A2 00          ldx #0
001236r 1               @Cell:
001236r 1  A9 00          lda #TILE_BLANK
001238r 1  9D 00 04       sta SCREEN + $0000,x
00123Br 1  9D 00 05       sta SCREEN + $0100,x
00123Er 1  9D 00 06       sta SCREEN + $0200,x
001241r 1  9D 00 07       sta SCREEN + $0300,x
001244r 1  A9 01          lda #1                        ; White
001246r 1  9D 00 D8       sta COLRAM + $0000,x
001249r 1  9D 00 D9       sta COLRAM + $0100,x
00124Cr 1  9D 00 DA       sta COLRAM + $0200,x
00124Fr 1  9D 00 DB       sta COLRAM + $0300,x
001252r 1  E8             inx
001253r 1  D0 E1          bne @Cell
001255r 1  60             rts
001256r 1               
001256r 1               ; -----------------------------------------------------------------------------
001256r 1               ;   LoadTileset — copy 2 K of patterns from cartridge ROM to $2000
001256r 1               ;   PLACEHOLDER ART: Tileset is data/tileset.bin. The same 2048-byte file
001256r 1               ;   drives all three machines — the pattern format is identical. See
001256r 1               ;   data/README.md.
001256r 1               ; -----------------------------------------------------------------------------
001256r 1               LoadTileset:
001256r 1  A9 rr          lda #<Tileset
001258r 1  85 rr          sta SrcPtr
00125Ar 1  A9 rr          lda #>Tileset
00125Cr 1  85 rr          sta SrcPtr+1
00125Er 1  A9 00          lda #<CHARSET_RAM
001260r 1  85 rr          sta DstPtr
001262r 1  A9 20          lda #>CHARSET_RAM
001264r 1  85 rr          sta DstPtr+1
001266r 1               
001266r 1  A2 08          ldx #8                        ; 8 x 256 = 2048 bytes
001268r 1  A0 00          ldy #0
00126Ar 1               @Byte:
00126Ar 1  B1 rr          lda (SrcPtr),y
00126Cr 1  91 rr          sta (DstPtr),y
00126Er 1  C8             iny
00126Fr 1  D0 F9          bne @Byte
001271r 1  E6 rr          inc SrcPtr+1
001273r 1  E6 rr          inc DstPtr+1
001275r 1  CA             dex
001276r 1  D0 F2          bne @Byte
001278r 1  60             rts
001279r 1               
001279r 1               ; -----------------------------------------------------------------------------
001279r 1               ;   HalWaitFrame — sync on raster line 251, below the visible area
001279r 1               ; -----------------------------------------------------------------------------
001279r 1               HalWaitFrame:
001279r 1               @NotYet:
001279r 1  AD 12 D0       lda VIC_RASTER
00127Cr 1  C9 FB          cmp #251
00127Er 1  F0 F9          beq @NotYet                   ; Leave the line first, so a fast frame
001280r 1               @Wait:                          ;   cannot fall straight through
001280r 1  AD 12 D0       lda VIC_RASTER
001283r 1  C9 FB          cmp #251
001285r 1  D0 F9          bne @Wait
001287r 1  60             rts
001288r 1               
001288r 1               ; -----------------------------------------------------------------------------
001288r 1               ;   HalPlotCell — In: A = tile, X = screen column, Y = screen row
001288r 1               ; -----------------------------------------------------------------------------
001288r 1               HalPlotCell:
001288r 1  48             pha                           ; Hold the tile; RowPtrs needs A
001289r 1  20 rr rr       jsr RowPtrs
00128Cr 1  8A             txa
00128Dr 1  A8             tay                           ; Y = column
00128Er 1  68             pla                           ; A = tile
00128Fr 1  91 rr          sta (ScreenPtr),y
001291r 1  AA             tax                           ; The tile is its own colour lookup index...
001292r 1  29 F8          and #COLOR_MASK               ; ...unless its colour is the one a fireball is
001294r 1  CD rr rr       cmp TintColor                 ;   flashing white (SPEC 4.6). TintColor is
001297r 1  F0 06          beq @White                    ;   TINT_NONE when nothing is, and no masked
001299r 1  BD rr rr       lda TileColorC64,x                ;   tile can equal that, so the test needs no
00129Cr 1  4C rr rr       jmp @Put                      ;   separate "is anything lit at all" branch —
00129Fr 1               @White:                         ;   one CMP a cell, and only while it is lit
00129Fr 1  A9 01          lda #COLOR_WHITE              ;   does a cell come out any different
0012A1r 1               @Put:
0012A1r 1  91 rr          sta (ColorPtr),y
0012A3r 1  60             rts
0012A4r 1               
0012A4r 1               ; -----------------------------------------------------------------------------
0012A4r 1               ;   RowPtrs — In: Y = screen row.  Out: ScreenPtr, ColorPtr at that row
0012A4r 1               ; -----------------------------------------------------------------------------
0012A4r 1               RowPtrs:
0012A4r 1  B9 rr rr       lda RowLo,y
0012A7r 1  85 rr          sta ScreenPtr
0012A9r 1  85 rr          sta ColorPtr
0012ABr 1  B9 rr rr       lda RowHi,y
0012AEr 1  85 rr          sta ScreenPtr+1
0012B0r 1  18             clc
0012B1r 1  69 D4          adc #(>COLRAM - >SCREEN)      ; Colour RAM mirrors the matrix, page-offset
0012B3r 1  85 rr          sta ColorPtr+1
0012B5r 1  60             rts
0012B6r 1               
0012B6r 1               ; -----------------------------------------------------------------------------
0012B6r 1               ;   HalBlitScreen — draw a full 1000-byte screen plus its colour image
0012B6r 1               ;   In: SrcPtr -> name table, Ptr1 -> colour table
0012B6r 1               ; -----------------------------------------------------------------------------
0012B6r 1               HalBlitScreen:
0012B6r 1  A0 00          ldy #0
0012B8r 1               @Page0:
0012B8r 1  B1 rr          lda (SrcPtr),y
0012BAr 1  99 00 04       sta SCREEN + $0000,y
0012BDr 1  B1 rr          lda (Ptr1),y
0012BFr 1  99 00 D8       sta COLRAM + $0000,y
0012C2r 1  C8             iny
0012C3r 1  D0 F3          bne @Page0
0012C5r 1               
0012C5r 1  E6 rr          inc SrcPtr+1
0012C7r 1  E6 rr          inc Ptr1+1
0012C9r 1  A0 00          ldy #0
0012CBr 1               @Page1:
0012CBr 1  B1 rr          lda (SrcPtr),y
0012CDr 1  99 00 05       sta SCREEN + $0100,y
0012D0r 1  B1 rr          lda (Ptr1),y
0012D2r 1  99 00 D9       sta COLRAM + $0100,y
0012D5r 1  C8             iny
0012D6r 1  D0 F3          bne @Page1
0012D8r 1               
0012D8r 1  E6 rr          inc SrcPtr+1
0012DAr 1  E6 rr          inc Ptr1+1
0012DCr 1  A0 00          ldy #0
0012DEr 1               @Page2:
0012DEr 1  B1 rr          lda (SrcPtr),y
0012E0r 1  99 00 06       sta SCREEN + $0200,y
0012E3r 1  B1 rr          lda (Ptr1),y
0012E5r 1  99 00 DA       sta COLRAM + $0200,y
0012E8r 1  C8             iny
0012E9r 1  D0 F3          bne @Page2
0012EBr 1               
0012EBr 1  E6 rr          inc SrcPtr+1
0012EDr 1  E6 rr          inc Ptr1+1
0012EFr 1  A0 00          ldy #0
0012F1r 1               @Page3:
0012F1r 1  B1 rr          lda (SrcPtr),y
0012F3r 1  99 00 07       sta SCREEN + $0300,y
0012F6r 1  B1 rr          lda (Ptr1),y
0012F8r 1  99 00 DB       sta COLRAM + $0300,y
0012FBr 1  C8             iny
0012FCr 1  C0 E8          cpy #232                      ; 1000 - 768
0012FEr 1  D0 F1          bne @Page3
001300r 1  60             rts
001301r 1               
001301r 1               ; -----------------------------------------------------------------------------
001301r 1               ;   HalReadInput — joystick port 2 and the keyboard, in one active-high mask
001301r 1               ;
001301r 1               ;   Port 1 shares its lines with the keyboard columns, so only port 2 is
001301r 1               ;   supported — but port 2 shares CIA1's port A with them as well, and that is
001301r 1               ;   not avoidable: a held direction pulls a column line low and looks to the
001301r 1               ;   scan below like every key in that column being down at once. Every C64
001301r 1               ;   game with both has this; the joystick is read FIRST, with all columns
001301r 1               ;   driven high, so at least the stick is never confused by the keyboard.
001301r 1               ;
001301r 1               ;   The KERNAL's IRQ scanner is off (see ColdStart), so the matrix is ours.
001301r 1               ; -----------------------------------------------------------------------------
001301r 1               HalReadInput:
001301r 1  A9 FF          lda #$FF                      ; CIA1 DDRA: the column lines drive
001303r 1  8D 02 DC       sta $DC02
001306r 1  A9 00          lda #$00                      ; CIA1 DDRB: the row lines are read
001308r 1  8D 03 DC       sta $DC03
00130Br 1               
00130Br 1  A9 FF          lda #$FF                      ; No column selected — a pressed stick is then
00130Dr 1  8D 00 DC       sta $DC00                     ;   the only thing that can pull a line low
001310r 1  AD 00 DC       lda $DC00                     ; Active low: bit0 U, 1 D, 2 L, 3 R, 4 fire
001313r 1  49 FF          eor #$FF
001315r 1  29 1F          and #$1F
001317r 1  85 rr          sta Tmp0
001319r 1               
001319r 1  A9 00          lda #0
00131Br 1  85 rr          sta Tmp1
00131Dr 1               
00131Dr 1  A5 rr          lda Tmp0
00131Fr 1  29 01          and #%00000001                  ; U
001321r 1  F0 06          beq @NoUp
001323r 1  A5 rr          lda Tmp1
001325r 1  09 01          ora #INPUT_UP
001327r 1  85 rr          sta Tmp1
001329r 1               @NoUp:
001329r 1  A5 rr          lda Tmp0
00132Br 1  29 02          and #%00000010                  ; D
00132Dr 1  F0 06          beq @NoDown
00132Fr 1  A5 rr          lda Tmp1
001331r 1  09 02          ora #INPUT_DOWN
001333r 1  85 rr          sta Tmp1
001335r 1               @NoDown:
001335r 1  A5 rr          lda Tmp0
001337r 1  29 04          and #%00000100                  ; L
001339r 1  F0 06          beq @NoLeft
00133Br 1  A5 rr          lda Tmp1
00133Dr 1  09 04          ora #INPUT_LEFT
00133Fr 1  85 rr          sta Tmp1
001341r 1               @NoLeft:
001341r 1  A5 rr          lda Tmp0
001343r 1  29 08          and #%00001000                  ; R
001345r 1  F0 06          beq @NoRight
001347r 1  A5 rr          lda Tmp1
001349r 1  09 08          ora #INPUT_RIGHT
00134Br 1  85 rr          sta Tmp1
00134Dr 1               @NoRight:
00134Dr 1  A5 rr          lda Tmp0
00134Fr 1  29 10          and #%00010000                  ; fire
001351r 1  F0 06          beq @NoFire
001353r 1  A5 rr          lda Tmp1
001355r 1  09 10          ora #INPUT_FIRE
001357r 1  85 rr          sta Tmp1
001359r 1               @NoFire:
001359r 1               
001359r 1  20 rr rr       jsr ScanKeys
00135Cr 1  05 rr          ora Tmp1
00135Er 1  60             rts
00135Fr 1               
00135Fr 1               ; -----------------------------------------------------------------------------
00135Fr 1               ;   ScanKeys — the keyboard matrix, as the same active-high mask
00135Fr 1               ;   Out: A = INPUT_* bits.  Modifies: A, X, Tmp2
00135Fr 1               ;
00135Fr 1               ;   CIA1 $DC00 drives the columns (one bit LOW selects one) and $DC01 reads
00135Fr 1               ;   the rows, active low. The two cursor keys come after the table because
00135Fr 1               ;   SHIFT turns them around, and that means knowing the SHIFT state first.
00135Fr 1               ; -----------------------------------------------------------------------------
00135Fr 1               KEY_SHIFT           = %01000000 ; Scratch inside this file only — INPUT_MASK
00135Fr 1                                               ;   strips it before the mask leaves here
00135Fr 1               
00135Fr 1               ScanKeys:
00135Fr 1  A9 00          lda #0
001361r 1  85 rr          sta Tmp2
001363r 1  A2 00          ldx #0
001365r 1               @Key:
001365r 1  BD rr rr       lda KeyTable,x
001368r 1  F0 19          beq @Cursors                  ; $00 selects every column at once — the
00136Ar 1  8D 00 DC       sta $DC00                     ;   terminator, because it is no column mask
00136Dr 1  AD 01 DC       lda $DC01
001370r 1  49 FF          eor #$FF                      ; Active low in, active high out
001372r 1  3D rr rr       and KeyTable+1,x
001375r 1  F0 07          beq @Next
001377r 1  A5 rr          lda Tmp2
001379r 1  1D rr rr       ora KeyTable+2,x
00137Cr 1  85 rr          sta Tmp2
00137Er 1               @Next:
00137Er 1  E8             inx
00137Fr 1  E8             inx
001380r 1  E8             inx
001381r 1  D0 E2          bne @Key                      ; Always — the table is far shorter than 256
001383r 1               
001383r 1                 ; --- the two cursor keys, which SHIFT turns around (SPEC 11.2) ------------
001383r 1                 ;   Unshifted they are RIGHT and DOWN, shifted LEFT and UP, which is exactly
001383r 1                 ;   the four the game wants and the reason for reading the matrix rather
001383r 1                 ;   than letting the KERNAL turn a keystroke into one character.
001383r 1               @Cursors:
001383r 1  A9 FE          lda #%11111110                ; Column 0 — CRSR L/R shares it with RETURN
001385r 1  8D 00 DC       sta $DC00                     ;   and the function keys
001388r 1  AD 01 DC       lda $DC01
00138Br 1  29 04          and #%00000100                ; Row 2
00138Dr 1  D0 0F          bne @NoLeftRight              ; Still high, so not pressed
00138Fr 1  A2 08          ldx #INPUT_RIGHT
001391r 1  A5 rr          lda Tmp2
001393r 1  29 40          and #KEY_SHIFT
001395r 1  F0 02          beq @LeftRight
001397r 1  A2 04          ldx #INPUT_LEFT
001399r 1               @LeftRight:
001399r 1  8A             txa
00139Ar 1  05 rr          ora Tmp2
00139Cr 1  85 rr          sta Tmp2
00139Er 1               @NoLeftRight:
00139Er 1               
00139Er 1  A9 FE          lda #%11111110                ; Column 0 again — CRSR U/D is its last row
0013A0r 1  8D 00 DC       sta $DC00
0013A3r 1  AD 01 DC       lda $DC01
0013A6r 1  29 80          and #%10000000                ; Row 7
0013A8r 1  D0 0F          bne @NoUpDown
0013AAr 1  A2 02          ldx #INPUT_DOWN
0013ACr 1  A5 rr          lda Tmp2
0013AEr 1  29 40          and #KEY_SHIFT
0013B0r 1  F0 02          beq @UpDown
0013B2r 1  A2 01          ldx #INPUT_UP
0013B4r 1               @UpDown:
0013B4r 1  8A             txa
0013B5r 1  05 rr          ora Tmp2
0013B7r 1  85 rr          sta Tmp2
0013B9r 1               @NoUpDown:
0013B9r 1               
0013B9r 1  A5 rr          lda Tmp2
0013BBr 1  29 3F          and #INPUT_MASK               ; Drop KEY_SHIFT — it is not an input
0013BDr 1  60             rts
0013BEr 1               
0013BEr 1               ; -----------------------------------------------------------------------------
0013BEr 1               ;   KeyTable — column mask, row mask, input bit.  Terminated by $00.
0013BEr 1               ;
0013BEr 1               ;   These are C64 matrix positions, which are NOT the VIC-20's with the axes
0013BEr 1               ;   renamed: the two machines wire genuinely different keys to the same
0013BEr 1               ;   (row, column). Only W and D sit on a symmetric position, which is why they
0013BEr 1               ;   were the two that worked when this table still held the VIC-20's numbers.
0013BEr 1               ; -----------------------------------------------------------------------------
0013BEr 1               KeyTable:
0013BEr 1  FD 02 01       .byte %11111101, %00000010, INPUT_UP      ; W        col 1, row 1
0013C1r 1  FD 04 04       .byte %11111101, %00000100, INPUT_LEFT    ; A        col 1, row 2
0013C4r 1  FD 20 02       .byte %11111101, %00100000, INPUT_DOWN    ; S        col 1, row 5
0013C7r 1  FB 04 08       .byte %11111011, %00000100, INPUT_RIGHT   ; D        col 2, row 2
0013CAr 1  7F 40 10       .byte %01111111, %01000000, INPUT_FIRE    ; Q        col 7, row 6
0013CDr 1  DF 02 20       .byte %11011111, %00000010, INPUT_PAUSE   ; P        col 5, row 1
0013D0r 1  7F 10 01       .byte %01111111, %00010000, INPUT_UP      ; SPACE    col 7, row 4
0013D3r 1  FE 02 10       .byte %11111110, %00000010, INPUT_FIRE    ; RETURN   col 0, row 1
0013D6r 1  FD 80 40       .byte %11111101, %10000000, KEY_SHIFT     ; LSHIFT   col 1, row 7
0013D9r 1  BF 10 40       .byte %10111111, %00010000, KEY_SHIFT     ; RSHIFT   col 6, row 4
0013DCr 1  00             .byte $00
0013DDr 1               
0013DDr 1               ; -----------------------------------------------------------------------------
0013DDr 1               ;   HalDetectRegion — PAL has 312 raster lines, NTSC 263
0013DDr 1               ;   Both overflow $D012, so sample it only while $D011 bit 7 (raster bit 8) is
0013DDr 1               ;   set: PAL climbs to $37 up there, NTSC only to about $06.
0013DDr 1               ; -----------------------------------------------------------------------------
0013DDr 1               HalDetectRegion:
0013DDr 1  A9 00          lda #0
0013DFr 1  85 rr          sta Tmp0                      ; Highest high-page line seen
0013E1r 1  A2 00          ldx #0
0013E3r 1  A0 00          ldy #0
0013E5r 1               @Sample:
0013E5r 1  AD 11 D0       lda VIC_CTRL1
0013E8r 1  10 09          bpl @Next                     ; Raster bit 8 clear — not the range we want
0013EAr 1  AD 12 D0       lda VIC_RASTER
0013EDr 1  C5 rr          cmp Tmp0
0013EFr 1  90 02          bcc @Next
0013F1r 1  85 rr          sta Tmp0
0013F3r 1               @Next:
0013F3r 1  C8             iny
0013F4r 1  D0 EF          bne @Sample
0013F6r 1  E8             inx
0013F7r 1  E0 40          cpx #64                       ; 16384 samples — comfortably over one frame
0013F9r 1  D0 EA          bne @Sample
0013FBr 1               
0013FBr 1  A5 rr          lda Tmp0
0013FDr 1  C9 20          cmp #$20
0013FFr 1  90 03          bcc @Ntsc
001401r 1  A9 01          lda #1                        ; PAL
001403r 1  60             rts
001404r 1               @Ntsc:
001404r 1  A9 00          lda #0
001406r 1  60             rts
001407r 1               
001407r 1               ; -----------------------------------------------------------------------------
001407r 1               ;   HalColorFlash — the fireball's detonation (SPEC 4.6, 14)
001407r 1               ;   In:  A = colour key ($40..$68), or TINT_NONE.  Modifies: A, TintColor
001407r 1               ;
001407r 1               ;   Colour here is per CELL, so there is no single byte to poke: the flash is
001407r 1               ;   HalPlotCell substituting white for any tile of TintColor as it draws it,
001407r 1               ;   and the animation re-marking every cell that has to change. Storing the
001407r 1               ;   colour is therefore the whole routine, and the transition HalColorFlash
001407r 1               ;   promises to handle costs nothing — the previous colour stops being
001407r 1               ;   substituted the moment this byte changes, and its cells are re-marked by
001407r 1               ;   the same pass that marks the new one (anim.asm, hal.inc).
001407r 1               ;
001407r 1               ;   The AC6502 does it in one VDP write instead. Same frame count, same look,
001407r 1               ;   completely different mechanism — which is exactly what SPEC 4.6 predicted.
001407r 1               ; -----------------------------------------------------------------------------
001407r 1               HalColorFlash:
001407r 1  8D rr rr       sta TintColor
00140Ar 1  60             rts
00140Br 1               
00140Br 1               ; -----------------------------------------------------------------------------
00140Br 1               ;   HalSfx — one note on the SID at $D400 (hal.inc)
00140Br 1               ;   In:  A = TIMBRE_*, X = note.  Out: nothing.  Modifies: A, X, Y, Tmp0-Tmp2
00140Br 1               ;
00140Br 1               ;   Byte for byte the AC6502's, which is the whole point of include/sid.inc:
00140Br 1               ;   the two machines differ in where the chip is and in nothing else. This one
00140Br 1               ;   needs no presence check either — a C64 without a SID is not a C64.
00140Br 1               ; -----------------------------------------------------------------------------
00140Br 1               SID_BASE = $D400
00140Br 1               .include "../include/sid.inc"
00140Br 2               ; =============================================================================
00140Br 2               ;   sid.inc — the SID half of the HAL, shared by the two machines that have one
00140Br 2               ; =============================================================================
00140Br 2               ;   SPEC.md section 16: the AC6502 and the C64 "share SID driver code almost
00140Br 2               ;   verbatim (register base differs: $9800 vs $D400)". This is that code, and
00140Br 2               ;   the base is all that differs — the platform defines SID_BASE and includes
00140Br 2               ;   this file once, from inside its CODE segment.
00140Br 2               ;
00140Br 2               ;   It is the one file in include/ that is not a list of equates. It has
00140Br 2               ;   nowhere else to be: it belongs to two platforms and not to the third, so
00140Br 2               ;   it cannot live in either WizardsLab.asm without one machine including the
00140Br 2               ;   other's, and it cannot live in src/, where nothing touches hardware
00140Br 2               ;   (PLAN.md D2, D22).
00140Br 2               ;
00140Br 2               ;   What it does NOT contain is a driver in the sequencing sense. Which effect
00140Br 2               ;   is playing, which step of it, how long the step lasts and what note it is
00140Br 2               ;   are all in src/audio.asm and shared by all three machines; SidSfx is asked
00140Br 2               ;   for one note in one timbre and writes eleven registers.
00140Br 2               ;
00140Br 2               ;   ONE VOICE. Voice 1 only — the game plays one sound at a time by design
00140Br 2               ;   (audio.asm), and voices 2 and 3 are left silent rather than half-used.
00140Br 2               ;
00140Br 2               ;   Leaves the RODATA segment selected; every caller declares its own segment
00140Br 2               ;   immediately afterwards.
00140Br 2               ; =============================================================================
00140Br 2               
00140Br 2               ; --- Register offsets from SID_BASE ------------------------------------------
00140Br 2               SID_FREQ_LO         = 0
00140Br 2               SID_FREQ_HI         = 1
00140Br 2               SID_PW_LO           = 2
00140Br 2               SID_PW_HI           = 3
00140Br 2               SID_CTRL            = 4         ; Waveform in the high nibble, GATE in bit 0
00140Br 2               SID_AD              = 5
00140Br 2               SID_SR              = 6
00140Br 2               SID_VOL             = 24        ; Master volume, low nibble
00140Br 2               
00140Br 2               ; --- The two levels (constants.inc) ------------------------------------------
00140Br 2               ;   A SID has no per-voice volume, so this register is the only place a
00140Br 2               ;   "quieter" can live. The game plays at full; the title screen's ambience
00140Br 2               ;   plays under it (ambience.asm).
00140Br 2               SID_VOL_FULL        = $0F
00140Br 2               SID_VOL_QUIET       = $06
00140Br 2               
00140Br 2               ; -----------------------------------------------------------------------------
00140Br 2               ;   SidSfx — HalSfx for a SID (hal.inc)
00140Br 2               ;   In:  A = TIMBRE_*, optionally + TIMBRE_QUIET; X = note (semitones above C3;
00140Br 2               ;        ignored when A is TIMBRE_OFF)
00140Br 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0-Tmp2
00140Br 2               ; -----------------------------------------------------------------------------
00140Br 2               SidSfx:
00140Br 2                 ; --- the level, which is bit 7 of the timbre and not a voice --------------
00140Br 2                 ;   Written before the note rather than with it, so the volume is already
00140Br 2                 ;   where it belongs when the gate comes up. Masked off first and on every
00140Br 2                 ;   path, which is what makes a QUIET TIMBRE_OFF ($80) still silence.
00140Br 2  A0 0F          ldy #SID_VOL_FULL
00140Dr 2  C9 80          cmp #TIMBRE_QUIET
00140Fr 2  90 04          bcc @Level
001411r 2  29 7F          and #TIMBRE_MASK
001413r 2  A0 06          ldy #SID_VOL_QUIET
001415r 2               @Level:
001415r 2  8C 18 D4       sty SID_BASE + SID_VOL
001418r 2               
001418r 2  C9 00          cmp #TIMBRE_OFF
00141Ar 2  F0 50          beq SidGateOff
00141Cr 2               
00141Cr 2  85 rr          sta Tmp0                      ; The timbre, 1..4 — an index into the three
00141Er 2                                               ;   tables at the bottom of this file
00141Er 2  BD rr rr       lda SidNoteLo,x
001421r 2  85 rr          sta Tmp1
001423r 2  BD rr rr       lda SidNoteHi,x
001426r 2  85 rr          sta Tmp2
001428r 2               
001428r 2                 ; --- the timbre's octave (constants.inc) ----------------------------------
001428r 2                 ;   A SID frequency register is linear in Hz, so an octave is a shift. On the
001428r 2                 ;   VIC-20 the same octave is free, because its three tone oscillators are
001428r 2                 ;   already an octave apart and the timbre picks between them.
001428r 2  A4 rr          ldy Tmp0
00142Ar 2  C0 01          cpy #TIMBRE_SOFT
00142Cr 2  D0 04          bne @NotSoft
00142Er 2  46 rr          lsr Tmp2                      ; Down one
001430r 2  66 rr          ror Tmp1
001432r 2               @NotSoft:
001432r 2  C0 03          cpy #TIMBRE_BRIGHT
001434r 2  D0 04          bne @NotBright
001436r 2  06 rr          asl Tmp1                      ; Up one
001438r 2  26 rr          rol Tmp2
00143Ar 2               @NotBright:
00143Ar 2               
00143Ar 2                 ; --- the hard restart ------------------------------------------------------
00143Ar 2                 ;   Gate down with a zeroed envelope BEFORE the new note. Without it the
00143Ar 2                 ;   SID's envelope generator can be caught mid-release and skip the attack
00143Ar 2                 ;   of the note that follows — the ADSR delay bug — and every step of every
00143Ar 2                 ;   effect comes through here, so a skipped attack is a silent sound effect
00143Ar 2                 ;   rather than a quiet one.
00143Ar 2  A9 00          lda #0
00143Cr 2  8D 04 D4       sta SID_BASE + SID_CTRL
00143Fr 2  8D 05 D4       sta SID_BASE + SID_AD
001442r 2  8D 06 D4       sta SID_BASE + SID_SR
001445r 2               
001445r 2  A5 rr          lda Tmp1
001447r 2  8D 00 D4       sta SID_BASE + SID_FREQ_LO
00144Ar 2  A5 rr          lda Tmp2
00144Cr 2  8D 01 D4       sta SID_BASE + SID_FREQ_HI
00144Fr 2  A9 00          lda #$00                      ; A 50% pulse, which is a square wave. Only
001451r 2  8D 02 D4       sta SID_BASE + SID_PW_LO      ;   TIMBRE_BRIGHT reads it, and it never
001454r 2  A9 08          lda #$08                      ;   changes, so it is written with everything
001456r 2  8D 03 D4       sta SID_BASE + SID_PW_HI      ;   else rather than kept as state
001459r 2               
001459r 2  B9 rr rr       lda SidAD - 1,y               ; The timbre tables are 1-based: TIMBRE_OFF
00145Cr 2  8D 05 D4       sta SID_BASE + SID_AD         ;   never reaches them
00145Fr 2  B9 rr rr       lda SidSR - 1,y
001462r 2  8D 06 D4       sta SID_BASE + SID_SR
001465r 2               
001465r 2  B9 rr rr       lda SidWave - 1,y
001468r 2  8D 04 D4       sta SID_BASE + SID_CTRL       ; Waveform and GATE — the note starts here
00146Br 2  60             rts
00146Cr 2               
00146Cr 2               ; -----------------------------------------------------------------------------
00146Cr 2               ;   SidGateOff — end whatever is sounding
00146Cr 2               ;   The release does the rest. Voice 1 keeps its frequency and waveform, which
00146Cr 2               ;   costs nothing and means the next note writes the same registers either way.
00146Cr 2               ; -----------------------------------------------------------------------------
00146Cr 2               SidGateOff:
00146Cr 2  A9 00          lda #0
00146Er 2  8D 04 D4       sta SID_BASE + SID_CTRL
001471r 2  60             rts
001472r 2               
001472r 2               ; =============================================================================
001472r 2               ;   SID tables
001472r 2               ; =============================================================================
001472r 2               
001472r 2               .segment "RODATA"
000000r 2               
000000r 2               ; --- Waveform and envelope by timbre, indexed 1..4 (constants.inc) -----------
000000r 2               ;   TIMBRE_SOFT   triangle, decaying to a low sustain — the lock's thunk and
000000r 2               ;                 the game-over run
000000r 2               ;   TIMBRE_BUZZ   sawtooth, full sustain
000000r 2               ;   TIMBRE_BRIGHT pulse, full sustain — chimes, blips and fanfares
000000r 2               ;   TIMBRE_NOISE  noise, no sustain at all: it decays to nothing on its own,
000000r 2               ;                 which is what makes a crack a crack rather than a hiss that
000000r 2               ;                 lasts exactly as long as its step
000000r 2               SidWave:
000000r 2  11 21 41 81    .byte $11, $21, $41, $81      ; ...and bit 0 of each is the gate, set
000004r 2               SidAD:
000004r 2  08 00 00 05    .byte $08, $00, $00, $05      ; Attack 0 on all four — a sound effect that
000008r 2                                               ;   fades in is a sound effect that is late
000008r 2               SidSR:
000008r 2  40 F0 C0 00    .byte $40, $F0, $C0, $00
00000Cr 2               
00000Cr 2               ; --- Note table: semitones above C3, C3 to C6 (NOTE_MAX) ---------------------
00000Cr 2               ;   Register value = round(Hz * 16777216 / 1000000), equal temperament from
00000Cr 2               ;   A4 = 440 Hz. That is the AC6502's 1 MHz SID clock exactly and the C64's
00000Cr 2               ;   within 2.3% either way — under half a semitone, and the SAME fraction for
00000Cr 2               ;   every note, so a C64 plays this perfectly in tune with itself and a hair
00000Cr 2               ;   sharp of an AC6502. Its two regions are a uniform transposition of each
00000Cr 2               ;   other for the same reason, which is why there is no second table here and
00000Cr 2               ;   nothing in this file reads Region.
00000Cr 2               ;
00000Cr 2               ;   The octave a note actually sounds in is the timbre's (constants.inc), so
00000Cr 2               ;   TIMBRE_BRIGHT doubles what it reads here and TIMBRE_SOFT halves it. C6
00000Cr 2               ;   doubled is 35114, well inside the register.
00000Cr 2               SidNoteLo:
00000Cr 2  93 15 9F 32    .byte $93, $15, $9F, $32, $CD, $72, $20, $D8, $9C, $6B, $46, $2F   ; C3-B3
000010r 2  CD 72 20 D8  
000014r 2  9C 6B 46 2F  
000018r 2  25 2A 3F 64    .byte $25, $2A, $3F, $64, $9A, $E3, $3F, $B1, $38, $D6, $8D, $5E   ; C4-B4
00001Cr 2  9A E3 3F B1  
000020r 2  38 D6 8D 5E  
000024r 2  4B 55 7E C8    .byte $4B, $55, $7E, $C8, $34, $C6, $7F, $61, $6F, $AC, $1A, $BC   ; C5-B5
000028r 2  34 C6 7F 61  
00002Cr 2  6F AC 1A BC  
000030r 2  95             .byte $95                                                          ; C6
000031r 2               SidNoteHi:
000031r 2  08 09 09 0A    .byte $08, $09, $09, $0A, $0A, $0B, $0C, $0C, $0D, $0E, $0F, $10   ; C3-B3
000035r 2  0A 0B 0C 0C  
000039r 2  0D 0E 0F 10  
00003Dr 2  11 12 13 14    .byte $11, $12, $13, $14, $15, $16, $18, $19, $1B, $1C, $1E, $20   ; C4-B4
000041r 2  15 16 18 19  
000045r 2  1B 1C 1E 20  
000049r 2  22 24 26 28    .byte $22, $24, $26, $28, $2B, $2D, $30, $33, $36, $39, $3D, $40   ; C5-B5
00004Dr 2  2B 2D 30 33  
000051r 2  36 39 3D 40  
000055r 2  44             .byte $44                                                          ; C6
000056r 2               
000056r 1               
000056r 1               HalSfx = SidSfx                 ; Not a JMP: the contract is the same routine
000056r 1               
000056r 1               ; =============================================================================
000056r 1               ;   Data
000056r 1               ; =============================================================================
000056r 1               
000056r 1               .segment "RODATA"
000056r 1               
000056r 1               .include "../data/tilecolor-c64.inc"
000056r 2               ; =============================================================================
000056r 2               ;   tilecolor-c64.inc — C64 tile -> colour RAM table
000056r 2               ; =============================================================================
000056r 2               ;   Generated from SPEC.md section 4.3 and Appendix A. Spec-derived data, not
000056r 2               ;   artwork: edit this file by hand, it is never overwritten by an editor
000056r 2               ;   export. Tile groups 16-31 (tiles 128-255) are the margin artwork and their
000056r 2               ;   colours are the artist's to choose.
000056r 2               ; =============================================================================
000056r 2               
000056r 2               
000056r 2               ;   256 bytes, indexed by tile number. Render is:
000056r 2               ;       SCREEN,x = tile   /   COLRAM,x = TileColor,tile
000056r 2               ;   C64: all 16 colours available. Groups 0-15 match the VIC-20
000056r 2               ;   table except where the VIC has no equivalent (gray).
000056r 2               
000056r 2               TileColorC64:
000056r 2  01 01 01 01    .res 8, $01                      ; tiles   0-7    group 0  UI / well frame        white
00005Ar 2  01 01 01 01  
00005Er 2  0F 0F 0F 0F    .res 8, $0F                      ; tiles   8-15   group 1  UI accents             gray
000062r 2  0F 0F 0F 0F  
000066r 2  01 01 01 01    .res 8, $01                      ; tiles  16-23   group 2  Font  0 1 2 3 4 5 6 7  white
00006Ar 2  01 01 01 01  
00006Er 2  01 01 01 01    .res 8, $01                      ; tiles  24-31   group 3  Font  8 9 A B C D E F  white
000072r 2  01 01 01 01  
000076r 2  01 01 01 01    .res 8, $01                      ; tiles  32-39   group 4  Font  G H I J K L M N  white
00007Ar 2  01 01 01 01  
00007Er 2  01 01 01 01    .res 8, $01                      ; tiles  40-47   group 5  Font  O P Q R S T U V  white
000082r 2  01 01 01 01  
000086r 2  01 01 01 01    .res 8, $01                      ; tiles  48-55   group 6  Font  W X Y Z . x ! -  white
00008Ar 2  01 01 01 01  
00008Er 2  01 01 01 01    .res 8, $01                      ; tiles  56-63   group 7  VFX                    white
000092r 2  01 01 01 01  
000096r 2  02 02 02 02    .res 8, $02                      ; tiles  64-71   group 8  POTION 0  RED
00009Ar 2  02 02 02 02  
00009Er 2  07 07 07 07    .res 8, $07                      ; tiles  72-79   group 9  POTION 1  YELLOW
0000A2r 2  07 07 07 07  
0000A6r 2  05 05 05 05    .res 8, $05                      ; tiles  80-87   group 10 POTION 2  GREEN
0000AAr 2  05 05 05 05  
0000AEr 2  03 03 03 03    .res 8, $03                      ; tiles  88-95   group 11 POTION 3  CYAN
0000B2r 2  03 03 03 03  
0000B6r 2  06 06 06 06    .res 8, $06                      ; tiles  96-103  group 12 POTION 4  BLUE
0000BAr 2  06 06 06 06  
0000BEr 2  04 04 04 04    .res 8, $04                      ; tiles 104-111  group 13 POTION 5  PURPLE
0000C2r 2  04 04 04 04  
0000C6r 2  01 01 01 01    .res 8, $01                      ; tiles 112-119  group 14 POTION 6  WILD / prism white
0000CAr 2  01 01 01 01  
0000CEr 2  02 02 02 02    .res 8, $02                      ; tiles 120-127  group 15 Wall / stone           red
0000D2r 2  02 02 02 02  
0000D6r 2  0F 0F 0F 0F    .res 8, $0F                      ; tiles 128-135  group 16 artwork
0000DAr 2  0F 0F 0F 0F  
0000DEr 2  09 09 09 09    .res 8, $09                      ; tiles 136-143  group 17 artwork
0000E2r 2  09 09 09 09  
0000E6r 2  0C 0C 0C 0C    .res 8, $0C                      ; tiles 144-151  group 18 artwork
0000EAr 2  0C 0C 0C 0C  
0000EEr 2  08 08 08 08    .res 8, $08                      ; tiles 152-159  group 19 artwork
0000F2r 2  08 08 08 08  
0000F6r 2  0B 0B 0B 0B    .res 8, $0B                      ; tiles 160-167  group 20 artwork
0000FAr 2  0B 0B 0B 0B  
0000FEr 2  0D 0D 0D 0D    .res 8, $0D                      ; tiles 168-175  group 21 artwork
000102r 2  0D 0D 0D 0D  
000106r 2  0A 0A 0A 0A    .res 8, $0A                      ; tiles 176-183  group 22 artwork
00010Ar 2  0A 0A 0A 0A  
00010Er 2  03 03 03 03    .res 8, $03                      ; tiles 184-191  group 23 artwork
000112r 2  03 03 03 03  
000116r 2  07 07 07 07    .res 8, $07                      ; tiles 192-199  group 24 artwork
00011Ar 2  07 07 07 07  
00011Er 2  0E 0E 0E 0E    .res 8, $0E                      ; tiles 200-207  group 25 artwork
000122r 2  0E 0E 0E 0E  
000126r 2  04 04 04 04    .res 8, $04                      ; tiles 208-215  group 26 artwork
00012Ar 2  04 04 04 04  
00012Er 2  05 05 05 05    .res 8, $05                      ; tiles 216-223  group 27 artwork
000132r 2  05 05 05 05  
000136r 2  02 02 02 02    .res 8, $02                      ; tiles 224-231  group 28 artwork
00013Ar 2  02 02 02 02  
00013Er 2  01 01 01 01    .res 8, $01                      ; tiles 232-239  group 29 artwork
000142r 2  01 01 01 01  
000146r 2  0F 0F 0F 0F    .res 8, $0F                      ; tiles 240-247  group 30 artwork
