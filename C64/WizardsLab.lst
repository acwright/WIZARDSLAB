000000r 1               ; =============================================================================
000000r 1               ;   Wizards Lab — Commodore 64
000000r 1               ; =============================================================================
000000r 1               ;   A 16 K cartridge: EXROM and GAME both low, so ROML ($8000-$9FFF) and ROMH
000000r 1               ;   ($A000-$BFFF) map contiguously and the whole thing is one image.
000000r 1               ;
000000r 1               ;   The C64 is the roomiest of the three targets and gets no gameplay
000000r 1               ;   advantage for it. The 22 x 23 panel is centred at (9, 1) and the nine
000000r 1               ;   columns either side are static artwork, drawn once on entering a state and
000000r 1               ;   never touched again — so they cost tiles, not cycles.
000000r 1               ;
000000r 1               ;   Its first eight colours are numerically identical to the VIC-20's eight
000000r 1               ;   hi-res colours, so the playfield colour bytes are the same numbers on both
000000r 1               ;   machines. The upper eight are for margin artwork only.
000000r 1               ;
000000r 1               ;   No sprites. Everything is tiles, on every platform, by design.
000000r 1               ;
000000r 1               ;   Built with C64-16K.cfg.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               .include "../include/c64.inc"
000000r 2               ; C64 Include File for ca65
000000r 2               ; KERNAL routines, VIC-II, SID, and CIA registers
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; KERNAL Routines
000000r 2               ;=============================================================================
000000r 2               CHROUT          = $FFD2         ; Output character in A
000000r 2               CHRIN           = $FFCF         ; Input character
000000r 2               GETIN           = $FFE4         ; Get character from keyboard buffer
000000r 2               SCNKEY          = $FF9F         ; Scan the keyboard
000000r 2               PLOT            = $FFF0         ; Read/set cursor position
000000r 2               CLRSCR          = $E544         ; Clear the screen
000000r 2               STOP            = $FFE1         ; Test the STOP key
000000r 2               SETLFS          = $FFBA         ; Set logical file parameters
000000r 2               SETNAM          = $FFBD         ; Set filename
000000r 2               LOAD            = $FFD5         ; Load from device
000000r 2               SAVE            = $FFD8         ; Save to device
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Memory
000000r 2               ;=============================================================================
000000r 2               SCREEN          = $0400         ; Screen memory (40 x 25)
000000r 2               COLRAM          = $D800         ; Color RAM
000000r 2               BASIC_START     = $0801         ; Start of BASIC program area
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; VIC-II - Video
000000r 2               ;=============================================================================
000000r 2               VIC_SPR0X       = $D000         ; Sprite 0 X position
000000r 2               VIC_SPR0Y       = $D001         ; Sprite 0 Y position
000000r 2               VIC_SPRENA      = $D015         ; Sprite enable
000000r 2               VIC_CTRL1       = $D011         ; Control register 1
000000r 2               VIC_RASTER      = $D012         ; Raster line
000000r 2               VIC_CTRL2       = $D016         ; Control register 2
000000r 2               VIC_MEMPTR      = $D018         ; Memory pointers
000000r 2               VIC_IRR         = $D019         ; Interrupt request register
000000r 2               VIC_IMR         = $D01A         ; Interrupt mask register
000000r 2               VIC_BORDERCOL   = $D020         ; Border color
000000r 2               VIC_BGCOL0      = $D021         ; Background color 0
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; SID - Sound
000000r 2               ;=============================================================================
000000r 2               SID_V1_FREQ     = $D400         ; Voice 1 frequency
000000r 2               SID_V1_CTRL     = $D404         ; Voice 1 control
000000r 2               SID_V1_AD       = $D405         ; Voice 1 attack/decay
000000r 2               SID_V1_SR       = $D406         ; Voice 1 sustain/release
000000r 2               SID_VOLUME      = $D418         ; Volume and filter select
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; CIA - I/O
000000r 2               ;=============================================================================
000000r 2               CIA1_PRA        = $DC00         ; Port A (keyboard/joystick 2)
000000r 2               CIA1_PRB        = $DC01         ; Port B (keyboard/joystick 1)
000000r 2               CIA1_ICR        = $DC0D         ; Interrupt control
000000r 2               CIA2_PRA        = $DD00         ; Port A (VIC bank select)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Colors
000000r 2               ;=============================================================================
000000r 2               COL_BLACK       = 0
000000r 2               COL_WHITE       = 1
000000r 2               COL_RED         = 2
000000r 2               COL_CYAN        = 3
000000r 2               COL_PURPLE      = 4
000000r 2               COL_GREEN       = 5
000000r 2               COL_BLUE        = 6
000000r 2               COL_YELLOW      = 7
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; PETSCII Control Codes
000000r 2               ;=============================================================================
000000r 2               CHR_CLEAR       = $93           ; Clear screen
000000r 2               CHR_HOME        = $13           ; Cursor home
000000r 2               CHR_CR          = $0D           ; Carriage return
000000r 2               CHR_WHITE       = $05           ; Set text color to white
000000r 2               
000000r 1               
000000r 1               ; --- Platform constants (hal.inc) --------------------------------------------
000000r 1               SCR_COLS         = 40
000000r 1               SCR_ROWS         = 25
000000r 1               SCR_CELLS        = 1000          ; 40 x 25
000000r 1               PANEL_X             = 9             ; (40 - 22) / 2 — exact centring
000000r 1               PANEL_Y             = 0             ; Panel is 24 rows; screen row 24 is the
000000r 1                                                   ;   one spare course of margin
000000r 1               HAS_COLOR_RAM       = 1
000000r 1               
000000r 1               CHARSET_RAM         = $2000         ; 2 K, VIC bank 0
000000r 1               
000000r 1               .include "../src/constants.inc"
000000r 2               ; =============================================================================
000000r 2               ;   constants.inc — Wizards Lab, shared game constants
000000r 2               ; =============================================================================
000000r 2               ;   Everything here comes straight out of SPEC.md. If a number changes there,
000000r 2               ;   it changes here, and nowhere else. Nothing in this file is platform
000000r 2               ;   specific — see the per-platform WizardsLab.asm for PANEL_X / PANEL_Y and
000000r 2               ;   the hardware addresses.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Board (SPEC 3) ----------------------------------------------------------
000000r 2               BOARD_W             = 6         ; Playfield columns
000000r 2               BOARD_H             = 16        ; Playfield rows
000000r 2               BOARD_STRIDE        = 8         ; Bytes per row — two wasted, on purpose
000000r 2               BOARD_ROWS_ALLOC    = 20        ; 16 playfield + 2 floor sentinels + 2 reserved
000000r 2               BOARD_BYTES         = BOARD_ROWS_ALLOC * BOARD_STRIDE    ; 160
000000r 2               SPAWN_COL           = 2         ; 0-indexed, left of centre
000000r 2               MATCH_MIN           = 3         ; Run length that clears
000000r 2               
000000r 2               ; --- Tile encoding (SPEC 4) --------------------------------------------------
000000r 2               ;   tile = COLOR_BASE + (color << 3) + glyph
000000r 2               ;   The board byte IS the tile index. No translation on the way to the screen.
000000r 2               TILE_EMPTY          = $00
000000r 2               TILE_WALL           = $FF
000000r 2               COLOR_BASE          = $40
000000r 2               COLOR_MASK          = $F8       ; AND this and you have the colour key
000000r 2               GLYPH_MASK          = $07
000000r 2               WILD_BASE           = $70       ; Colour 6 — the prism
000000r 2               NUM_COLORS          = 6
000000r 2               
000000r 2               COLOR_RED           = 0
000000r 2               COLOR_YELLOW        = 1
000000r 2               COLOR_GREEN         = 2
000000r 2               COLOR_CYAN          = 3
000000r 2               COLOR_BLUE          = 4
000000r 2               COLOR_PURPLE        = 5
000000r 2               COLOR_WILD          = 6
000000r 2               
000000r 2               GLYPH_POTION        = 0
000000r 2               GLYPH_FIREBALL      = 1
000000r 2               GLYPH_BOLT          = 2
000000r 2               GLYPH_BOMB          = 3
000000r 2               GLYPH_STAR          = 4
000000r 2               GLYPH_GLOW          = 6         ; Match-flash frame. Potion colours only —
000000r 2                                               ;   WILD_BASE + GLYPH_GLOW is an arrow, not a
000000r 2                                               ;   glow, so the prism never takes this path.
000000r 2                                               ;   See PRISM_BLIP below and SPEC 4.4.
000000r 2               
000000r 2               ; --- Named tiles -------------------------------------------------------------
000000r 2               TILE_BLANK          = 0
000000r 2               TILE_BAR_H          = 1
000000r 2               TILE_BAR_V          = 2
000000r 2               TILE_COR_TL         = 3
000000r 2               TILE_COR_TR         = 4
000000r 2               TILE_COR_BL         = 5
000000r 2               TILE_COR_BR         = 6
000000r 2               TILE_WASH           = 7         ; PAUSE / dim wash, white
000000r 2               FONT_BASE           = 16        ; '0'..'9' then 'A'..'Z' then . x ! ~
000000r 2               FONT_DIGIT_0        = 16
000000r 2               FONT_LETTER_A       = 26
000000r 2               FONT_DOT            = 52        ; A CENTRED dot, not a baseline period — it is
000000r 2                                               ;   also frame 0 of the removal ring below
000000r 2               FONT_TIMES          = 53
000000r 2               FONT_BANG           = 54
000000r 2               FONT_TILDE          = 55        ; The banner ornament, ~~~LIKE THIS~~~
000000r 2               TEXT_END            = $FF       ; String terminator. Shares its value with
000000r 2                                               ;   TILE_WALL, which costs nothing: no string
000000r 2                                               ;   ever contains tile 255.
000000r 2               
000000r 2               ; The removal ring (SPEC 14). One animation, used for every removal there is:
000000r 2               ; the match shatter, the bomb blast, the star. It opens outward
000000r 2               ;
000000r 2               ;       FONT_DOT -> VFX_REMOVE1 -> VFX_REMOVE2 -> VFX_REMOVE3 -> empty
000000r 2               ;
000000r 2               ; and the prism's blip-out runs the same tiles closed inward (PRISM_BLIP).
000000r 2               VFX_REMOVE1         = 56
000000r 2               VFX_REMOVE2         = 57
000000r 2               VFX_REMOVE3         = 58
000000r 2               VFX_BEAM_H          = 59        ; The bolt's row
000000r 2               VFX_BEAM_V          = 60        ; The bolt's column
000000r 2               VFX_BEAM_CROSS      = 61        ; Drawn once, at the bolt's own cell
000000r 2               ARROW_UP            = 62        ; The title screen's controls (SPEC 13.1).
000000r 2               ARROW_DOWN          = 63        ;   Up and down live in group 7, left and
000000r 2               ARROW_LEFT          = 118       ;   right in group 14 — whichever white group
000000r 2               ARROW_RIGHT         = 119       ;   had a slot spare. Nothing indexes them.
000000r 2               
000000r 2               ; Group 14 is the prism's. Slots +0..+3 are its idle rotation and +4..+5 its
000000r 2               ; blip-out; there is no glow slot (SPEC A.3).
000000r 2               PRISM_SPIN          = WILD_BASE ; Four frames, WILD_BASE + 0..3
000000r 2               PRISM_SPIN_FRAMES   = 4
000000r 2               PRISM_BLIP          = WILD_BASE + 4     ; Two frames, then VFX_REMOVE2,
000000r 2                                                       ;   VFX_REMOVE1, FONT_DOT, empty
000000r 2               
000000r 2               ; Group 15 is the stone group: the petrified glyph set at the same offsets the
000000r 2               ; potions use, so a cell petrifies into its own shape —
000000r 2               ;
000000r 2               ;       petrified = PETRIFY_BASE + (tile & GLYPH_MASK)     for glyphs 0-4
000000r 2               ;
000000r 2               ; — and then the two tiles the margins are built from.
000000r 2               PETRIFY_BASE        = 120       ; +0 potion, +1 fireball, +2 bolt,
000000r 2                                               ;   +3 bomb, +4 star
000000r 2               TILE_RESERVED       = 125       ; Held for a sixth glyph, if one is ever added
000000r 2               TILE_SHELF          = 126       ; The shelf the panel stands on
000000r 2               TILE_BRICK          = 127       ; Brick — the margin fill
000000r 2               FRAME_DIM           = 8         ; Group 1 is group 0 byte for byte, one colour
000000r 2                                               ;   quieter, so frame_tile + FRAME_DIM is any
000000r 2                                               ;   frame piece's dim twin (SPEC A.3)
000000r 2               ART_BASE            = 128       ; Groups 16-31 — one hatch in sixteen colours,
000000r 2                                               ;   the title screen's magic field (SPEC 13.1)
000000r 2               ART_TILES           = 128
000000r 2               
000000r 2               ; --- Panel geometry (SPEC 12) ------------------------------------------------
000000r 2               ;   One 22 x 24 panel, rendered identically on all three machines. PANEL_Y is
000000r 2               ;   0 everywhere; only PANEL_X differs. The panel is vertically symmetric —
000000r 2               ;   backdrop row, band row, backdrop row, eighteen rows of frame, backdrop row,
000000r 2               ;   band row, backdrop row — which is why 24 is the height. The AC6502 is the
000000r 2               ;   exact fit; the VIC-20 clips panel row 23 off the bottom and the C64 has one
000000r 2               ;   spare screen row (24) below the panel. See SPEC 12.4.
000000r 2               PANEL_W             = 22
000000r 2               PANEL_H             = 24
000000r 2               
000000r 2               WELL_ORIGIN_X       = 1         ; Panel-relative: board (0,0) lives here
000000r 2               WELL_ORIGIN_Y       = 4
000000r 2               
000000r 2               SCORE_X             = 12        ; 7 digits, cols 12-18
000000r 2               SCORE_Y             = 5
000000r 2               HIGH_X              = 12        ; 7 digits, cols 12-18
000000r 2               HIGH_Y              = 10
000000r 2               HIGHLVL_X           = 15        ; Level the high score was set on, 2 digits;
000000r 2                                               ;   the 'L' at col 14 is in the static image
000000r 2               HIGHLVL_Y           = 11
000000r 2               LEVEL_X             = 18        ; Single column: tens above units
000000r 2               LEVEL_Y             = 17        ; Tens at LEVEL_Y, units at LEVEL_Y + 1
000000r 2               NEXT_X              = 11        ; Single tile column
000000r 2               NEXT_Y              = 16        ; Cells A, B, C at NEXT_Y, +1, +2
000000r 2               MSG_X               = 2         ; The band's OWNED cells. Panel columns 0-1 and
000000r 2               MSG_W               = 18        ;   20-21 of row 22 are shelf in the static
000000r 2               MSG_Y               = 22        ;   image and code never touches them; the
000000r 2                                               ;   banner still centres on the full PANEL_W,
000000r 2                                               ;   which lands in the same place for an
000000r 2                                               ;   even-length string (SPEC 12.2).
000000r 2               
000000r 2               SCORE_DIGITS        = 7         ; Always all 7 drawn, zero padded
000000r 2               LEVEL_DIGITS        = 2         ; Always zero padded — level 5 draws "0" / "5"
000000r 2               
000000r 2               ; --- Levels (SPEC 10) --------------------------------------------------------
000000r 2               LEVEL_TILES         = 30        ; Tiles cleared per level
000000r 2               LEVEL_SPEED_CAP     = 16        ; Speed stops improving here
000000r 2               LEVEL_MAX_SHOWN     = 99
000000r 2               
000000r 2               ; --- Scoring (SPEC 9) --------------------------------------------------------
000000r 2               BONUS_FIREBALL      = $0500     ; BCD
000000r 2               BONUS_BOLT          = $0300
000000r 2               BONUS_BOMB          = $0300
000000r 2               BONUS_PRISM         = $0400
000000r 2               BONUS_LEVELUP       = $1000
000000r 2               STAR_SHIFT_CAP      = 3         ; Three doublings — x8
000000r 2               SCORE_BYTES         = 4         ; 8 nibbles packed BCD; the top one stays 0,
000000r 2                                               ;   so 7 digits show and the score wraps at
000000r 2                                               ;   10,000,000.
000000r 2               HIGH_INIT_LO        = $00       ; 0010000
000000r 2               HIGH_INIT_MID       = $00
000000r 2               HIGH_INIT_HI        = $01
000000r 2               HIGH_INIT_TOP       = $00
000000r 2               
000000r 2               ; --- Reagent probability, out of 256 (SPEC 5.3) ------------------------------
000000r 2               PSPECIAL_BANDS      = 5
000000r 2               
000000r 2               ; --- Input bitmask (SPEC 11.1) -----------------------------------------------
000000r 2               ;   Active HIGH. Each platform inverts and remaps its own hardware into this.
000000r 2               INPUT_UP            = %00000001 ; Rotate forward
000000r 2               INPUT_DOWN          = %00000010 ; Soft drop
000000r 2               INPUT_LEFT          = %00000100
000000r 2               INPUT_RIGHT         = %00001000
000000r 2               INPUT_FIRE          = %00010000 ; Rotate reverse / confirm
000000r 2               INPUT_PAUSE         = %00100000
000000r 2               
000000r 2               ; --- Game states (SPEC 13) ---------------------------------------------------
000000r 2               STATE_TITLE         = 0
000000r 2               STATE_PLAY          = 1
000000r 2               STATE_PAUSE         = 2
000000r 2               STATE_GAMEOVER      = 3
000000r 2               
000000r 2               ; --- Play sub-states (SPEC 8) ------------------------------------------------
000000r 2               PLAY_FALLING        = 0
000000r 2               PLAY_LOCKING        = 1
000000r 2               PLAY_GLOW           = 2
000000r 2               PLAY_SHATTER        = 3
000000r 2               PLAY_GRAVITY        = 4
000000r 2               PLAY_ARE            = 5
000000r 2               
000000r 2               ; --- Buffer sizes (SPEC 17.1) ------------------------------------------------
000000r 2               MARKS_BYTES         = 16        ; One byte per row, bits 0-5
000000r 2               EFFECTQ_ENTRIES     = 48        ; 2 bytes each; drop on overflow
000000r 2               EFFECTQ_BYTES       = EFFECTQ_ENTRIES * 2
000000r 2               DIRTY_ENTRIES       = 64        ; 3 bytes each: offset lo, offset hi, tile
000000r 2               DIRTY_BYTES         = DIRTY_ENTRIES * 3
000000r 2               DIRTY_FLUSH_MAX     = 24        ; Cells pushed to the screen per frame.
000000r 2                                               ;   MEASURED, not estimated (PLAN.md S1). A
000000r 2                                               ;   flush costs 165 cycles a cell on the
000000r 2                                               ;   AC6502 and about 132 on the Commodores, so
000000r 2                                               ;   24 cells is 3965 cycles — inside vertical
000000r 2                                               ;   blank on all three, and tightest on the
000000r 2                                               ;   AC6502 at 1 MHz, whose 70 blank lines are
000000r 2                                               ;   roughly 4450. It is also a quarter of the
000000r 2                                               ;   96-cell well, so a full redraw is exactly
000000r 2                                               ;   four frames.
000000r 2                                               ;   Overrunning vblank is not dangerous on any
000000r 2                                               ;   of the three — no VRAM write spacing is
000000r 2                                               ;   anywhere near violated (S1) — it only
000000r 2                                               ;   risks a cell landing a frame late. This is
000000r 2                                               ;   a budget, not a hardware limit.
000000r 2               
000000r 1               .include "../src/zeropage.inc"
000000r 2               ; =============================================================================
000000r 2               ;   zeropage.inc — Wizards Lab, zero page allocation
000000r 2               ; =============================================================================
000000r 2               ;   The ZEROPAGE segment is placed at $40 on every platform. That window is
000000r 2               ;   free on all three:
000000r 2               ;
000000r 2               ;     AC6502   $003A-$00FF free for user programs (6502.inc memory map)
000000r 2               ;     VIC-20   all of page zero, once the cartridge stops calling the KERNAL
000000r 2               ;     C64      all of page zero EXCEPT $00/$01, which are the processor port
000000r 2               ;
000000r 2               ;   Starting at $40 clears the C64's port bytes and the AC6502's system
000000r 2               ;   scratch with room to spare, and keeps one number in three linker configs.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               .segment "ZEROPAGE"
000000r 2               
000000r 2  xx xx        Ptr1:           .res 2      ; General pointer — free across any call boundary
000002r 2  xx xx        Ptr2:           .res 2      ; General pointer
000004r 2  xx xx        SrcPtr:         .res 2      ; Block copy source
000006r 2  xx xx        DstPtr:         .res 2      ; Block copy destination
000008r 2  xx xx        ScreenPtr:      .res 2      ; Current screen row base
00000Ar 2  xx xx        ColorPtr:       .res 2      ; Current colour RAM row base (Commodore only)
00000Cr 2               
00000Cr 2  xx           RngLo:          .res 1      ; 16-bit LFSR state — never both zero
00000Dr 2  xx           RngHi:          .res 1
00000Er 2               
00000Er 2  xx           Tmp0:           .res 1      ; Scratch. Never live across a JSR.
00000Fr 2  xx           Tmp1:           .res 1
000010r 2  xx           Tmp2:           .res 1
000011r 2  xx           Tmp3:           .res 1
000012r 2               
000012r 2  xx           ScanRow:        .res 1      ; Match scanner cursor
000013r 2  xx           ScanCol:        .res 1
000014r 2  xx           ScanColor:      .res 1      ; Colour key of the run in progress ($FF = unset)
000015r 2  xx           ScanLen:        .res 1
000016r 2               
000016r 2               ; --- Render and text scratch -------------------------------------------------
000016r 2               ;   These ARE live across a JSR, unlike Tmp0-Tmp3, because text.asm calls
000016r 2               ;   RenderMark once per cell and has to remember where it is. That is safe
000016r 2               ;   only because RenderMark touches nothing here: it clobbers A, X and the
000016r 2               ;   stack and nothing else (see render.asm). Do not call anything else from a
000016r 2               ;   loop that holds one of these.
000016r 2  xx           TextCol:        .res 1      ; Panel column the next glyph goes in
000017r 2  xx           TextRow:        .res 1      ; Panel row the string is drawn on
000018r 2  xx           TextIdx:        .res 1      ; Cursor within the string, or the BCD byte index
000019r 2  xx           TextByte:       .res 1      ; The BCD byte being split into two digits
00001Ar 2  xx           TextSkip:       .res 1      ; Non-zero while the first high nibble is skipped
00001Br 2  xx           FlushLeft:      .res 1      ; Cells left in this frame's flush budget
00001Cr 2  xx           RedrawCol:      .res 1      ; Panel column of the cell RenderBoardStep is on
00001Dr 2               
00001Dr 1               .include "../src/ram.inc"
00001Dr 2               ; =============================================================================
00001Dr 2               ;   ram.inc — Wizards Lab, work RAM
00001Dr 2               ; =============================================================================
00001Dr 2               ;   SPEC.md section 17.1. Around 530 bytes, which is what lets the whole game
00001Dr 2               ;   fit the VIC-20's 1 KB of usable work RAM — the tightest of the three
00001Dr 2               ;   targets, and therefore the one the layout is designed against.
00001Dr 2               ;
00001Dr 2               ;   Every platform places the BSS segment somewhere different (see each
00001Dr 2               ;   linker config); nothing in this file cares where.
00001Dr 2               ; =============================================================================
00001Dr 2               
00001Dr 2               .segment "BSS"
000000r 2               
000000r 2               ; --- The board (SPEC 3.2) ----------------------------------------------------
000000r 2               ;   20 rows x 8 stride. Columns 6-7 of every row and rows 16-19 entirely are
000000r 2               ;   permanent $FF sentinels, so scans walk off the edge and stop by themselves.
000000r 2               ;   Page-align it: address(row,col) = Board + (row << 3) + col.
000000r 2               .align 256
000000r 2  xx xx xx xx  Board:          .res BOARD_BYTES
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
0000A0r 2               
0000A0r 2               ; --- Match / cascade state (SPEC 6.2, 8) -------------------------------------
0000A0r 2  xx xx xx xx  Marks:          .res MARKS_BYTES        ; One byte per row, bits 0-5 = columns
0000A4r 2  xx xx xx xx  
0000A8r 2  xx xx xx xx  
0000B0r 2  xx xx xx xx  EffectQ:        .res EFFECTQ_BYTES      ; Ring of pending reagent detonations
0000B4r 2  xx xx xx xx  
0000B8r 2  xx xx xx xx  
000110r 2  xx           EffectQHead:    .res 1
000111r 2  xx           EffectQTail:    .res 1
000112r 2  xx           RunCount:       .res 1                  ; Runs resolved in the current step
000113r 2  xx           ChainStep:      .res 1                  ; 1 on the first step of a cascade
000114r 2  xx           StarCount:      .res 1                  ; Doublings pending, capped at 3
000115r 2  xx           CascadeLo:      .res 1                  ; Cascade point accumulator, packed BCD
000116r 2  xx           CascadeMid:     .res 1
000117r 2  xx           CascadeHi:      .res 1
000118r 2               
000118r 2               ; --- Render (SPEC 12.6) ------------------------------------------------------
000118r 2               ;   A ring of DIRTY_ENTRIES cells waiting to be pushed to the screen, three
000118r 2               ;   bytes each: SCREEN column, SCREEN row, tile. Not a 16-bit screen offset —
000118r 2               ;   HalPlotCell takes a column and a row (hal.inc), and every platform reaches
000118r 2               ;   a cell through a per-row pointer table (SPEC 12.3), so an offset would only
000118r 2               ;   have to be taken apart again at the far end.
000118r 2               ;
000118r 2               ;   A ring rather than a list with a resume index, because a frame that flushes
000118r 2               ;   its cap leaves a remainder and the next frame's marks have to go somewhere.
000118r 2               ;   Head and tail are BYTE offsets into Dirty, not entry numbers, so stepping
000118r 2               ;   one entry is an add of 3 and never a multiply.
000118r 2  xx xx xx xx  Dirty:          .res DIRTY_BYTES        ; screen col, screen row, tile
00011Cr 2  xx xx xx xx  
000120r 2  xx xx xx xx  
0001D8r 2  xx           DirtyCount:     .res 1                  ; Entries pending, 0..DIRTY_ENTRIES
0001D9r 2  xx           DirtyHead:      .res 1                  ; Byte offset of the oldest pending
0001DAr 2  xx           DirtyTail:      .res 1                  ; Byte offset the next mark goes to
0001DBr 2  xx           RedrawIdx:      .res 1                  ; Board index RenderBoardStep resumes
0001DCr 2                                                       ;   at, or $FF when no redraw is
0001DCr 2                                                       ;   outstanding
0001DCr 2               
0001DCr 2               ; --- The falling piece (SPEC 5) ----------------------------------------------
0001DCr 2  xx           PieceCol:       .res 1
0001DDr 2  xx           PieceRow:       .res 1                  ; Row of cell A (the top cell)
0001DEr 2  xx           PieceA:         .res 1                  ; Tile bytes, top to bottom
0001DFr 2  xx           PieceB:         .res 1
0001E0r 2  xx           PieceC:         .res 1
0001E1r 2  xx           NextA:          .res 1                  ; The preview piece
0001E2r 2  xx           NextB:          .res 1
0001E3r 2  xx           NextC:          .res 1
0001E4r 2               
0001E4r 2               ; --- Progress (SPEC 9, 10) ---------------------------------------------------
0001E4r 2  xx           ScoreLo:        .res 1                  ; 7 digits packed BCD, low byte first;
0001E5r 2  xx           ScoreMid:       .res 1                  ;   the top nibble of ScoreTop stays 0
0001E6r 2  xx           ScoreHi:        .res 1
0001E7r 2  xx           ScoreTop:       .res 1
0001E8r 2  xx           HighLo:         .res 1
0001E9r 2  xx           HighMid:        .res 1
0001EAr 2  xx           HighHi:         .res 1
0001EBr 2  xx           HighTop:        .res 1
0001ECr 2  xx           HighLevel:      .res 1                  ; Level the high score was set on, BCD
0001EDr 2  xx           Level:          .res 1                  ; Binary, 1-99
0001EEr 2  xx           TilesCleared:   .res 1                  ; Toward the next level, wraps at 30
0001EFr 2               
0001EFr 2               ; --- Timers, all in frames (SPEC 14) -----------------------------------------
0001EFr 2  xx           GravityTimer:   .res 1
0001F0r 2  xx           LockTimer:      .res 1
0001F1r 2  xx           LockResets:     .res 1
0001F2r 2  xx           DasTimer:       .res 1
0001F3r 2  xx           DasDir:         .res 1
0001F4r 2  xx           AreTimer:       .res 1
0001F5r 2  xx           AnimTimer:      .res 1
0001F6r 2  xx           BannerTimer:    .res 1
0001F7r 2  xx           FrameCounter:   .res 1                  ; Free-running from power-on; seeds RNG
0001F8r 2               
0001F8r 2               ; --- Input (SPEC 11.1) -------------------------------------------------------
0001F8r 2  xx           InputNow:       .res 1
0001F9r 2  xx           InputPrev:      .res 1
0001FAr 2  xx           InputEdge:      .res 1                  ; Newly pressed this frame
0001FBr 2               
0001FBr 2               ; --- State machine (SPEC 13) -------------------------------------------------
0001FBr 2  xx           GameState:      .res 1                  ; STATE_*
0001FCr 2  xx           PlayState:      .res 1                  ; PLAY_*
0001FDr 2  xx           TitlePage:      .res 1
0001FEr 2  xx           Region:         .res 1                  ; 0 = NTSC, 1 = PAL
0001FFr 2  xx           NeedsRedraw:    .res 1
000200r 2               
000200r 2               ; --- Audio (SPEC 16) ---------------------------------------------------------
000200r 2  xx           SfxRequest:     .res 1                  ; Written by logic, consumed by AudioTick
000201r 2  xx           SfxTimer:       .res 1
000202r 2  xx xx xx xx  SfxState:       .res 14
000206r 2  xx xx xx xx  
00020Ar 2  xx xx xx xx  
000210r 2               
000210r 1               .include "../src/hal.inc"
000210r 2               ; =============================================================================
000210r 2               ;   hal.inc — Wizards Lab, the platform contract
000210r 2               ; =============================================================================
000210r 2               ;   Everything in src/ is shared, unmodified, by all three machines. The only
000210r 2               ;   things that differ are collected here: each platform's WizardsLab.asm must
000210r 2               ;   define these constants and implement these seven routines, and nothing
000210r 2               ;   else in src/ may touch hardware directly.
000210r 2               ;
000210r 2               ;   This file declares nothing. It is the documentation for the boundary, kept
000210r 2               ;   next to the code it constrains so it cannot drift out of date unnoticed.
000210r 2               ;
000210r 2               ;   CONSTANTS the platform must define BEFORE including the shared sources
000210r 2               ;   ---------------------------------------------------------------------
000210r 2               ;     PANEL_X, PANEL_Y      Where the 22 x 24 panel sits on this screen.
000210r 2               ;                             AC6502  5, 0      VIC-20  0, 0      C64  9, 0
000210r 2               ;                           PANEL_Y is 0 everywhere; the VIC-20 clips panel
000210r 2               ;                           row 23 and the C64 has one spare row below it.
000210r 2               ;     SCR_COLS           32 / 22 / 40
000210r 2               ;     SCR_ROWS           24 / 23 / 25
000210r 2               ;     HAS_COLOR_RAM         1 on the Commodores, 0 on the AC6502, whose colour
000210r 2               ;                           lives in the VDP colour table instead.
000210r 2               ;
000210r 2               ;   ROUTINES the platform must implement
000210r 2               ;   ------------------------------------
000210r 2               ;     HalInitVideo      Bring up the video hardware: black background and
000210r 2               ;                       border, the correct text/tile mode, tileset in place,
000210r 2               ;                       colours configured, screen cleared. Called once.
000210r 2               ;                       In:  nothing        Out: nothing
000210r 2               ;
000210r 2               ;     HalWaitFrame      Block until the start of the next vertical blank.
000210r 2               ;                       Everything below is called only between frames.
000210r 2               ;                       In:  nothing        Out: nothing
000210r 2               ;
000210r 2               ;     HalPlotCell       Write one cell, colour included where the platform has
000210r 2               ;                       per-cell colour.
000210r 2               ;                       In:  A = tile, X = screen column, Y = screen row
000210r 2               ;                       Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
000210r 2               ;
000210r 2               ;     HalBlitScreen     Draw a whole static screen from a name-table image in
000210r 2               ;                       ROM: SCR_COLS * SCR_ROWS bytes, row-major, plus
000210r 2               ;                       the matching colour image where the platform needs one.
000210r 2               ;                       In:  SrcPtr -> name table, Ptr1 -> colour table
000210r 2               ;                       Out: nothing
000210r 2               ;
000210r 2               ;     HalReadInput      Read stick and keyboard, fold both into one mask.
000210r 2               ;                       In:  nothing
000210r 2               ;                       Out: A = INPUT_* bits, ACTIVE HIGH
000210r 2               ;
000210r 2               ;     HalDetectRegion   Decide NTSC or PAL so the timing tables can be picked.
000210r 2               ;                       In:  nothing        Out: A = 0 NTSC, 1 PAL
000210r 2               ;
000210r 2               ;     HalSfx            Start a sound effect. May be a bare RTS until audio
000210r 2               ;                       exists.
000210r 2               ;                       In:  A = effect id (SPEC 16)
000210r 2               ;                       Out: nothing
000210r 2               ;
000210r 2               ;   The shared code assumes nothing about interrupts. Each platform may drive
000210r 2               ;   HalWaitFrame from a raster IRQ, a timer, or a status-register poll.
000210r 2               ; =============================================================================
000210r 2               
000210r 1               
000210r 1               ; =============================================================================
000210r 1               ;   Cartridge header — $8000
000210r 1               ; =============================================================================
000210r 1               
000210r 1               .segment "CARTHDR"
000000r 1               
000000r 1  rr rr        .addr ColdStart                 ; Cold start vector
000002r 1  rr rr        .addr ColdStart                 ; Warm start vector (NMI)
000004r 1  C3 C2 CD 38  .byte $C3, $C2, $CD, $38, $30   ; "CBM80" autostart signature
000008r 1  30           
000009r 1               
000009r 1               ; =============================================================================
000009r 1               ;   Entry
000009r 1               ; =============================================================================
000009r 1               
000009r 1               .segment "CODE"
000000r 1               
000000r 1               ColdStart:
000000r 1  78             sei
000001r 1  D8             cld
000002r 1  A2 FF          ldx #$FF
000004r 1  9A             txs                           ; The KERNAL jumped here before doing any of this
000005r 1               
000005r 1  A9 7F          lda #$7F                      ; Silence the CIA timer interrupt...
000007r 1  8D 0D DC       sta $DC0D
00000Ar 1  AD 0D DC       lda $DC0D                     ;   ...and acknowledge whatever was pending
00000Dr 1  A9 00          lda #$00
00000Fr 1  8D 1A D0       sta VIC_IMR                   ; No raster interrupt either — we poll instead
000012r 1               
000012r 1  20 rr rr       jsr GameInit                  ; Never returns
000015r 1               
000015r 1               ; --- Shared game code --------------------------------------------------------
000015r 1               .include "../src/main.asm"
000015r 2               ; =============================================================================
000015r 2               ;   main.asm — Wizards Lab, shared entry point and main loop
000015r 2               ; =============================================================================
000015r 2               ;   Included by every platform's WizardsLab.asm after that file has defined
000015r 2               ;   PANEL_X / PANEL_Y and its half of the HAL (see hal.inc). Nothing below
000015r 2               ;   touches hardware.
000015r 2               ;
000015r 2               ;   BOOTSTRAP STATUS
000015r 2               ;   ----------------
000015r 2               ;   What runs today is SPEC.md Appendix D step 1-2: the machine boots, the
000015r 2               ;   tileset loads, and the static screens blit at the right offset with fire
000015r 2               ;   moving between them. That is deliberately the whole of it — it exercises
000015r 2               ;   every platform-specific thing (cartridge header, video mode, tile format,
000015r 2               ;   colour model, frame sync, input) with none of the game, so when the game
000015r 2               ;   goes in, anything that breaks is the game.
000015r 2               ;
000015r 2               ;   Everything the state machine calls below is a stub in its own module.
000015r 2               ; =============================================================================
000015r 2               
000015r 2               ; -----------------------------------------------------------------------------
000015r 2               ;   GameInit — one-time setup, called from the cartridge entry point
000015r 2               ; -----------------------------------------------------------------------------
000015r 2               GameInit:
000015r 2  20 rr rr       jsr HalDetectRegion
000018r 2  8D rr rr       sta Region
00001Br 2               
00001Br 2  20 rr rr       jsr HalInitVideo              ; Tiles in place, screen black and cleared
00001Er 2  20 rr rr       jsr AudioInit
000021r 2  20 rr rr       jsr RenderDirtyReset
000024r 2               
000024r 2  A9 00          lda #0
000026r 2  8D rr rr       sta FrameCounter
000029r 2  8D rr rr       sta InputNow
00002Cr 2  8D rr rr       sta InputPrev
00002Fr 2  8D rr rr       sta InputEdge
000032r 2  8D rr rr       sta TitlePage
000035r 2               
000035r 2  20 rr rr       jsr ScoreHighInit             ; Once a session, before the first ScoreReset
000038r 2  20 rr rr       jsr ScoreReset
00003Br 2  20 rr rr       jsr BoardClear
00003Er 2               
00003Er 2               .ifdef WL_DEBUG
00003Er 2                 jsr GameStart                 ; TEMPORARY (PLAN.md P1): skip the title and
00003Er 2                                               ;   go straight to a well full of known tiles,
00003Er 2                                               ;   so the render path has something to draw
00003Er 2                                               ;   on a machine with no input attached.
00003Er 2               .else
00003Er 2  A9 00          lda #STATE_TITLE
000040r 2  8D rr rr       sta GameState
000043r 2  A9 01          lda #1
000045r 2  8D rr rr       sta NeedsRedraw
000048r 2               .endif
000048r 2                 ; falls through into GameLoop
000048r 2               
000048r 2               ; -----------------------------------------------------------------------------
000048r 2               ;   GameLoop — never returns
000048r 2               ; -----------------------------------------------------------------------------
000048r 2               GameLoop:
000048r 2  20 rr rr       jsr HalWaitFrame
00004Br 2  EE rr rr       inc FrameCounter              ; Free-running from power-on; seeds the RNG
00004Er 2               
00004Er 2  20 rr rr       jsr RenderFlush               ; Screen writes happen in vertical blank only
000051r 2  20 rr rr       jsr InputPoll
000054r 2               
000054r 2  AD rr rr       lda GameState                 ; Dispatch on the current screen state
000057r 2  C9 00          cmp #STATE_TITLE
000059r 2  F0 0B          beq @Title
00005Br 2  C9 01          cmp #STATE_PLAY
00005Dr 2  F0 0D          beq @Play
00005Fr 2  C9 02          cmp #STATE_PAUSE
000061r 2  F0 0F          beq @Pause
000063r 2  4C rr rr       jmp StateGameOver
000066r 2               
000066r 2               @Title:
000066r 2  20 rr rr       jsr StateTitle
000069r 2  4C rr rr       jmp @Audio
00006Cr 2               @Play:
00006Cr 2  20 rr rr       jsr StatePlay
00006Fr 2  4C rr rr       jmp @Audio
000072r 2               @Pause:
000072r 2  20 rr rr       jsr StatePause
000075r 2               
000075r 2               @Audio:
000075r 2  20 rr rr       jsr AudioTick
000078r 2  4C rr rr       jmp GameLoop
00007Br 2               
00007Br 2               ; =============================================================================
00007Br 2               ;   States (SPEC 13)
00007Br 2               ; =============================================================================
00007Br 2               
00007Br 2               ; -----------------------------------------------------------------------------
00007Br 2               ;   StateTitle — blinking prompt over the drawn screen, and the magic field
00007Br 2               ;   SPEC 13.1. There are no help pages: the controls are part of the screen
00007Br 2               ;   image, so the only things moving here are the prompt and the field.
00007Br 2               ; -----------------------------------------------------------------------------
00007Br 2               StateTitle:
00007Br 2  AD rr rr       lda NeedsRedraw
00007Er 2  F0 0B          beq @Live
000080r 2  A9 00          lda #0
000082r 2  8D rr rr       sta NeedsRedraw
000085r 2  20 rr rr       jsr DrawTitleScreen
000088r 2  20 rr rr       jsr RenderDirtyReset          ; A full blit went behind the renderer's back
00008Br 2               
00008Br 2               @Live:
00008Br 2                 ; TODO: blink the prompt every 30 frames, and shimmer the magic field —
00008Br 2                 ; one NextRandom for a cell in the 14 x 2 block, one for a tile in
00008Br 2                 ; ART_BASE..ART_BASE+ART_TILES-1, one RenderMark.
00008Br 2  AD rr rr       lda InputEdge
00008Er 2  29 10          and #INPUT_FIRE
000090r 2  F0 06          beq @Done
000092r 2               
000092r 2  20 rr rr       jsr RngSeed                   ; SPEC 15 — seed from reaction time, not a constant
000095r 2  20 rr rr       jsr GameStart
000098r 2               @Done:
000098r 2  60             rts
000099r 2               
000099r 2               ; -----------------------------------------------------------------------------
000099r 2               ;   GameStart — enter play from the title screen
000099r 2               ; -----------------------------------------------------------------------------
000099r 2               GameStart:
000099r 2  20 rr rr       jsr ScoreReset
00009Cr 2  20 rr rr       jsr BoardClear
00009Fr 2               .ifdef WL_DEBUG
00009Fr 2                 jsr BoardDebugFill            ; TEMPORARY (PLAN.md P1)
00009Fr 2               .endif
00009Fr 2               
00009Fr 2  A9 01          lda #1
0000A1r 2  8D rr rr       sta Level
0000A4r 2  A9 00          lda #0
0000A6r 2  8D rr rr       sta TilesCleared
0000A9r 2               
0000A9r 2  20 rr rr       jsr DrawPlayScreen            ; The whole screen at once, behind the
0000ACr 2  20 rr rr       jsr RenderDirtyReset          ;   renderer's back — so drop anything queued
0000AFr 2                                               ;   against the screen that just went away
0000AFr 2               
0000AFr 2  20 rr rr       jsr TextBannerClear           ; The play image ships with the band reading
0000B2r 2                                               ;   `~~ PAUSED ~~` (SPEC 12.1); play owns it
0000B2r 2  20 rr rr       jsr RenderScore               ; The panel fields are code's, not the image's
0000B5r 2  20 rr rr       jsr RenderHigh
0000B8r 2  20 rr rr       jsr RenderLevel
0000BBr 2               .ifdef WL_DEBUG
0000BBr 2                 lda #<MsgLevelUp              ; TEMPORARY (PLAN.md P1): something in the band
0000BBr 2                 sta Ptr1
0000BBr 2                 lda #>MsgLevelUp
0000BBr 2                 sta Ptr1+1
0000BBr 2                 jsr TextBanner
0000BBr 2               .endif
0000BBr 2  20 rr rr       jsr RenderBoard               ; Queued across as many frames as it takes
0000BEr 2               
0000BEr 2  20 rr rr       jsr PieceGenerateNext         ; Fill the preview...
0000C1r 2  20 rr rr       jsr PieceSpawn                ; ...then promote it and refill
0000C4r 2  20 rr rr       jsr PieceGenerateNext
0000C7r 2               
0000C7r 2  A9 00          lda #PLAY_FALLING
0000C9r 2  8D rr rr       sta PlayState
0000CCr 2  A9 01          lda #STATE_PLAY
0000CEr 2  8D rr rr       sta GameState
0000D1r 2  60             rts
0000D2r 2               
0000D2r 2               ; -----------------------------------------------------------------------------
0000D2r 2               ;   StatePlay — the game
0000D2r 2               ;   SPEC 13.2. One frame is: advance whatever the play sub-state is doing,
0000D2r 2               ;   then queue whatever changed. Cascades run as sub-states rather than in a
0000D2r 2               ;   blocking loop so animation stays on the frame clock.
0000D2r 2               ; -----------------------------------------------------------------------------
0000D2r 2               StatePlay:
0000D2r 2  AD rr rr       lda InputEdge
0000D5r 2  29 20          and #INPUT_PAUSE
0000D7r 2  D0 01          bne @ToPause
0000D9r 2               
0000D9r 2                 ; TODO: dispatch on PlayState —
0000D9r 2                 ;   PLAY_FALLING   input, DAS, gravity, land detection
0000D9r 2                 ;   PLAY_LOCKING   lock delay with up to LOCK_RESET_MAX moves
0000D9r 2                 ;   PLAY_GLOW      matched cells showing glyph +6, prisms excepted
0000D9r 2                 ;   PLAY_SHATTER   the white removal ring; prisms blip out instead
0000D9r 2                 ;   PLAY_GRAVITY   one row every FALL_FRAMES until settled
0000D9r 2                 ;   PLAY_ARE       entry delay, then spawn or game over
0000D9r 2  60             rts
0000DAr 2               
0000DAr 2               @ToPause:
0000DAr 2  A9 02          lda #STATE_PAUSE
0000DCr 2  8D rr rr       sta GameState
0000DFr 2                 ; TODO: wash the well with TILE_WASH so a pause cannot be used to study the
0000DFr 2                 ; board (13.3). A wash, not a blank — a blanked well reads as crashed.
0000DFr 2  60             rts
0000E0r 2               
0000E0r 2               ; -----------------------------------------------------------------------------
0000E0r 2               ;   StatePause
0000E0r 2               ; -----------------------------------------------------------------------------
0000E0r 2               StatePause:
0000E0r 2  AD rr rr       lda InputEdge
0000E3r 2  29 30          and #(INPUT_PAUSE | INPUT_FIRE)
0000E5r 2  F0 08          beq @Done
0000E7r 2  A9 01          lda #STATE_PLAY
0000E9r 2  8D rr rr       sta GameState
0000ECr 2  20 rr rr       jsr RenderBoard               ; Put the board back
0000EFr 2               @Done:
0000EFr 2  60             rts
0000F0r 2               
0000F0r 2               ; -----------------------------------------------------------------------------
0000F0r 2               ;   StateGameOver — petrify, banner, back to the title
0000F0r 2               ;   SPEC 13.4
0000F0r 2               ; -----------------------------------------------------------------------------
0000F0r 2               StateGameOver:
0000F0r 2                 ; TODO: petrify the well from the bottom up, 2 frames a row, then the banner
0000F0r 2                 ; and a 10 second timeout. Each cell keeps its own shape —
0000F0r 2                 ;   PETRIFY_BASE + (tile & GLYPH_MASK)
0000F0r 2                 ; — and empty cells stay empty (13.4).
0000F0r 2  AD rr rr       lda InputEdge
0000F3r 2  29 10          and #INPUT_FIRE
0000F5r 2  F0 0A          beq @Done
0000F7r 2  A9 00          lda #STATE_TITLE
0000F9r 2  8D rr rr       sta GameState
0000FCr 2  A9 01          lda #1
0000FEr 2  8D rr rr       sta NeedsRedraw
000101r 2               @Done:
000101r 2  60             rts
000102r 2               
000102r 2               ; =============================================================================
000102r 2               ;   Static screen drawing
000102r 2               ; =============================================================================
000102r 2               ;   The whole static layout — panel frame, labels, and the margin artwork that
000102r 2               ;   fills the screen either side of it — comes out of the editors as one
000102r 2               ;   name-table image per platform. Code only ever draws over the top of it:
000102r 2               ;   the well, the score and level digits, the preview, and the message band.
000102r 2               ;
000102r 2               ;   All six images are real. They come out of artwork/WizardsLab.tms9918 —
000102r 2               ;   the master — by way of `make artwork`. See data/README.md.
000102r 2               ; =============================================================================
000102r 2               
000102r 2               DrawTitleScreen:
000102r 2  A9 rr          lda #<TitleScreen
000104r 2  85 rr          sta SrcPtr
000106r 2  A9 rr          lda #>TitleScreen
000108r 2  85 rr          sta SrcPtr+1
00010Ar 2  A9 rr          lda #<TitleColor
00010Cr 2  85 rr          sta Ptr1
00010Er 2  A9 rr          lda #>TitleColor
000110r 2  85 rr          sta Ptr1+1
000112r 2  4C rr rr       jmp HalBlitScreen
000115r 2               
000115r 2               DrawPlayScreen:
000115r 2  A9 rr          lda #<PlayScreen
000117r 2  85 rr          sta SrcPtr
000119r 2  A9 rr          lda #>PlayScreen
00011Br 2  85 rr          sta SrcPtr+1
00011Dr 2  A9 rr          lda #<PlayColor
00011Fr 2  85 rr          sta Ptr1
000121r 2  A9 rr          lda #>PlayColor
000123r 2  85 rr          sta Ptr1+1
000125r 2  4C rr rr       jmp HalBlitScreen
000128r 2               
000128r 1               .include "../src/rng.asm"
000128r 2               ; =============================================================================
000128r 2               ;   rng.asm — Wizards Lab, random numbers
000128r 2               ; =============================================================================
000128r 2               ;   A 16-bit Galois LFSR with the conventional $B400 taps, which is maximal
000128r 2               ;   length: it visits all 65535 non-zero states before repeating. Eight shifts
000128r 2               ;   per call, one whole byte out.
000128r 2               ;
000128r 2               ;   Seeding matters more than the generator does. A fixed seed would deal the
000128r 2               ;   same first three pieces every session and the game would feel dead, so the
000128r 2               ;   seed is taken from the free-running frame counter at the moment the player
000128r 2               ;   presses fire on the title screen — human reaction time is the entropy.
000128r 2               ;
000128r 2               ;   SPEC.md section 15.
000128r 2               ; =============================================================================
000128r 2               
000128r 2               ; -----------------------------------------------------------------------------
000128r 2               ;   RngSeed — seed from the frame counter
000128r 2               ;   In:  nothing (reads FrameCounter)
000128r 2               ;   Out: nothing.  Modifies: A
000128r 2               ; -----------------------------------------------------------------------------
000128r 2               RngSeed:
000128r 2  AD rr rr       lda FrameCounter
00012Br 2  09 01          ora #$01                      ; Never let the state reach zero — it sticks
00012Dr 2  85 rr          sta RngLo
00012Fr 2  49 5A          eor #$5A                      ; Spread one byte of entropy over both halves
000131r 2  85 rr          sta RngHi
000133r 2  60             rts
000134r 2               
000134r 2               ; -----------------------------------------------------------------------------
000134r 2               ;   RngNext — next pseudo-random byte
000134r 2               ;   In:  nothing
000134r 2               ;   Out: A = random 0-255.  Modifies: A, X, flags
000134r 2               ; -----------------------------------------------------------------------------
000134r 2               RngNext:
000134r 2  A2 08          ldx #8                        ; Eight shifts give one whole output byte
000136r 2               @Bit:
000136r 2  46 rr          lsr RngHi                     ; Shift the 16-bit state right one place,
000138r 2  66 rr          ror RngLo                     ;   the bit falling out of bit 0 lands in C
00013Ar 2  90 06          bcc @NoTap
00013Cr 2  A5 rr          lda RngHi
00013Er 2  49 B4          eor #$B4                      ; Galois feedback mask $B400
000140r 2  85 rr          sta RngHi
000142r 2               @NoTap:
000142r 2  CA             dex
000143r 2  D0 F1          bne @Bit
000145r 2  A5 rr          lda RngLo
000147r 2  60             rts
000148r 2               
000148r 1               .include "../src/input.asm"
000148r 2               ; =============================================================================
000148r 2               ;   input.asm — Wizards Lab, input conditioning
000148r 2               ; =============================================================================
000148r 2               ;   SPEC.md section 11. HalReadInput hands back one active-high mask however
000148r 2               ;   the platform likes; everything above this line works on that mask and
000148r 2               ;   never touches hardware.
000148r 2               ;
000148r 2               ;   Auto-repeat applies to LEFT and RIGHT only. Rotate does NOT repeat — up
000148r 2               ;   must be released and pressed again. That is not a preference: a repeating
000148r 2               ;   rotate makes a three-cell Columns piece impossible to aim.
000148r 2               ; =============================================================================
000148r 2               
000148r 2               ; -----------------------------------------------------------------------------
000148r 2               ;   InputPoll — read the hardware and work out what is newly pressed
000148r 2               ;   In:  nothing
000148r 2               ;   Out: InputNow, InputPrev, InputEdge updated.  Modifies: A
000148r 2               ; -----------------------------------------------------------------------------
000148r 2               InputPoll:
000148r 2  AD rr rr       lda InputNow
00014Br 2  8D rr rr       sta InputPrev
00014Er 2  20 rr rr       jsr HalReadInput
000151r 2  8D rr rr       sta InputNow
000154r 2  4D rr rr       eor InputPrev                 ; Bits that changed
000157r 2  2D rr rr       and InputNow                  ; ...and are now down = newly pressed
00015Ar 2  8D rr rr       sta InputEdge
00015Dr 2  60             rts
00015Er 2               
00015Er 2               ; -----------------------------------------------------------------------------
00015Er 2               ;   InputShift — LEFT/RIGHT with delayed auto shift
00015Er 2               ;   Out: A = INPUT_LEFT, INPUT_RIGHT, or 0 if no move should happen this frame.
00015Er 2               ;   SPEC 11.3 — initial delay 12 frames NTSC / 10 PAL, then 4 / 3.
00015Er 2               ; -----------------------------------------------------------------------------
00015Er 2               InputShift:
00015Er 2                 ; TODO: on a fresh press, fire immediately and load DasTimer with the
00015Er 2                 ; initial delay; while held, fire again each time DasTimer runs out and
00015Er 2                 ; reload it with the repeat rate; on release, clear DasDir.
00015Er 2  A9 00          lda #0
000160r 2  60             rts
000161r 2               
000161r 1               .include "../src/board.asm"
000161r 2               ; =============================================================================
000161r 2               ;   board.asm — Wizards Lab, the playfield
000161r 2               ; =============================================================================
000161r 2               ;   SPEC.md section 3. The board is 20 rows of 8 bytes, page-aligned, with
000161r 2               ;   columns 6-7 and rows 16-19 held permanently at $FF. Those sentinels are
000161r 2               ;   what let every scan in match.asm run without a bounds check.
000161r 2               ;
000161r 2               ;   address(row, col) = Board + (row << 3) + col
000161r 2               ; =============================================================================
000161r 2               
000161r 2               ; -----------------------------------------------------------------------------
000161r 2               ;   BoardClear — empty the playfield and lay the sentinels back down
000161r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X
000161r 2               ;
000161r 2               ;   Walls first over the whole 160 bytes, then the six playfield columns of
000161r 2               ;   the sixteen playfield rows punched back out to empty. Doing it in that
000161r 2               ;   order means the sentinels can never be forgotten: everything that is not
000161r 2               ;   explicitly playfield is a wall.
000161r 2               ; -----------------------------------------------------------------------------
000161r 2               BoardClear:
000161r 2  A9 FF          lda #TILE_WALL
000163r 2  A2 9F          ldx #BOARD_BYTES - 1
000165r 2               @Wall:
000165r 2  9D rr rr       sta Board,x
000168r 2  CA             dex
000169r 2  10 FA          bpl @Wall
00016Br 2               
00016Br 2  A2 00          ldx #0                        ; X walks the row bases, 0, 8, 16, ...
00016Dr 2               @Row:
00016Dr 2  A9 00          lda #TILE_EMPTY               ; Reloaded every row: the TXA below eats it
00016Fr 2  9D rr rr 9D    .repeat BOARD_W, COL
000173r 2  rr rr 9D rr  
000177r 2  rr 9D rr rr  
000181r 2                   sta Board + COL, x
000181r 2                 .endrepeat
000181r 2  8A             txa
000182r 2  18             clc
000183r 2  69 08          adc #BOARD_STRIDE
000185r 2  AA             tax
000186r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
000188r 2  90 E3          bcc @Row
00018Ar 2  60             rts
00018Br 2               
00018Br 2               ; -----------------------------------------------------------------------------
00018Br 2               ;   BoardRowPtr — point Ptr1 at the start of a board row
00018Br 2               ;   In:  A = row        Out: Ptr1 = &Board[row][0].  Modifies: A, Ptr1
00018Br 2               ;
00018Br 2               ;   Board is page-aligned and 160 bytes, so row * 8 is at most 152 and the low
00018Br 2               ;   byte can never carry into the high one.
00018Br 2               ; -----------------------------------------------------------------------------
00018Br 2               BoardRowPtr:
00018Br 2  0A             asl a
00018Cr 2  0A             asl a
00018Dr 2  0A             asl a
00018Er 2  18             clc
00018Fr 2  69 rr          adc #<Board
000191r 2  85 rr          sta Ptr1
000193r 2  A9 rr          lda #>Board
000195r 2  85 rr          sta Ptr1+1
000197r 2  60             rts
000198r 2               
000198r 2               ; -----------------------------------------------------------------------------
000198r 2               ;   BoardGravity — compact every column downward
000198r 2               ;   In:  nothing
000198r 2               ;   Out: C set if anything moved.  Modifies: A, X, Y, Ptr1, Tmp0-Tmp2
000198r 2               ;   SPEC 8 step 8.  P3.
000198r 2               ; -----------------------------------------------------------------------------
000198r 2               BoardGravity:
000198r 2                 ; TODO: per column, walk bottom to top with a write cursor; mark moved cells
000198r 2                 ; dirty as they go.
000198r 2  18             clc
000199r 2  60             rts
00019Ar 2               
00019Ar 2               .ifdef WL_DEBUG
00019Ar 2               ; -----------------------------------------------------------------------------
00019Ar 2               ;   BoardDebugFill — a known pattern, for looking at the render path
00019Ar 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
00019Ar 2               ;
00019Ar 2               ;   TEMPORARY (PLAN.md P1). Nothing in the game calls this; it exists so a
00019Ar 2               ;   -DWL_DEBUG build has something in the well to draw, and it is deliberately
00019Ar 2               ;   asymmetric so a transposed row and column, an off-by-one origin or a wrong
00019Ar 2               ;   stride all show up as a picture rather than as a plausible board:
00019Ar 2               ;
00019Ar 2               ;     rows 0-3    empty — the well is not full, and the top edge is visible
00019Ar 2               ;     rows 4-14   a diagonal colour ramp, (row + col) mod 6
00019Ar 2               ;     row 14      column 0 left empty — breaks the diagonal's symmetry
00019Ar 2               ;     row 15      one of every glyph the tileset draws, left to right:
00019Ar 2               ;                 potion, fireball, bolt, bomb, star, then a prism
00019Ar 2               ; -----------------------------------------------------------------------------
00019Ar 2               BoardDebugFill:
00019Ar 2                 ldy #4                        ; Y = row
00019Ar 2               @Row:
00019Ar 2                 ldx #0                        ; X = column
00019Ar 2               @Col:
00019Ar 2                 tya
00019Ar 2                 stx Tmp0
00019Ar 2                 clc
00019Ar 2                 adc Tmp0                      ; row + col
00019Ar 2               @Mod6:
00019Ar 2                 cmp #NUM_COLORS
00019Ar 2                 bcc @Got
00019Ar 2                 sbc #NUM_COLORS
00019Ar 2                 bcs @Mod6                     ; Always — sbc left carry set
00019Ar 2               @Got:
00019Ar 2                 asl a                         ; colour << 3 + COLOR_BASE
00019Ar 2                 asl a
00019Ar 2                 asl a
00019Ar 2                 clc
00019Ar 2                 adc #COLOR_BASE
00019Ar 2                 sta Tmp1
00019Ar 2               
00019Ar 2                 cpy #BOARD_H - 1              ; Bottom row carries the glyph sampler
00019Ar 2                 bne @Plain
00019Ar 2                 txa
00019Ar 2                 cmp #NUM_COLORS - 1           ; Column 5 is the prism
00019Ar 2                 bcc @Glyph
00019Ar 2                 lda #WILD_BASE
00019Ar 2                 sta Tmp1
00019Ar 2                 bne @Store                    ; Always — WILD_BASE is non-zero
00019Ar 2               @Glyph:
00019Ar 2                 ora Tmp1                      ; Glyphs 0-4 of that cell's own colour
00019Ar 2                 sta Tmp1
00019Ar 2                 bne @Store                    ; Always
00019Ar 2               @Plain:
00019Ar 2                 cpy #BOARD_H - 2              ; One hole, so the diagonal is not symmetric
00019Ar 2                 bne @Store
00019Ar 2                 cpx #0
00019Ar 2                 bne @Store
00019Ar 2                 lda #TILE_EMPTY
00019Ar 2                 sta Tmp1
00019Ar 2               
00019Ar 2               @Store:
00019Ar 2                 tya                           ; Board index = row * 8 + column
00019Ar 2                 asl a
00019Ar 2                 asl a
00019Ar 2                 asl a
00019Ar 2                 stx Tmp0
00019Ar 2                 clc
00019Ar 2                 adc Tmp0
00019Ar 2                 tax
00019Ar 2                 lda Tmp1
00019Ar 2                 sta Board,x
00019Ar 2                 ldx Tmp0
00019Ar 2               
00019Ar 2                 inx
00019Ar 2                 cpx #BOARD_W
00019Ar 2                 bcc @Col
00019Ar 2                 iny
00019Ar 2                 cpy #BOARD_H
00019Ar 2                 bcc @Row
00019Ar 2                 rts
00019Ar 2               .endif
00019Ar 2               
00019Ar 1               .include "../src/piece.asm"
00019Ar 2               ; =============================================================================
00019Ar 2               ;   piece.asm — Wizards Lab, the falling piece
00019Ar 2               ; =============================================================================
00019Ar 2               ;   SPEC.md section 5. A piece is three independently generated cells stacked
00019Ar 2               ;   vertically, A on top. At most one of the three carries a reagent, which is
00019Ar 2               ;   enforced by rolling once for the piece rather than once per cell.
00019Ar 2               ; =============================================================================
00019Ar 2               
00019Ar 2               ; -----------------------------------------------------------------------------
00019Ar 2               ;   PieceGenerateNext — roll the preview piece into NextA/NextB/NextC
00019Ar 2               ;   In:  nothing (reads Level)
00019Ar 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0-Tmp2
00019Ar 2               ;   SPEC 5.2, 5.3 — colours uniform over 0-5, then one reagent roll.
00019Ar 2               ; -----------------------------------------------------------------------------
00019Ar 2               PieceGenerateNext:
00019Ar 2                 ; TODO: three RngNext calls for colours; one against PSpecial[LevelBand];
00019Ar 2                 ; on a hit pick a cell and a type from ReagentThresholds. A Prism overwrites
00019Ar 2                 ; the cell's colour with COLOR_WILD.
00019Ar 2  60             rts
00019Br 2               
00019Br 2               ; -----------------------------------------------------------------------------
00019Br 2               ;   PieceSpawn — promote the preview to the falling piece
00019Br 2               ;   In:  nothing
00019Br 2               ;   Out: C set if the spawn cells were occupied (game over)
00019Br 2               ;   SPEC 5.4 — spawn column SPAWN_COL, rows 0-2, visible immediately.
00019Br 2               ; -----------------------------------------------------------------------------
00019Br 2               PieceSpawn:
00019Br 2                 ; TODO
00019Br 2  18             clc
00019Cr 2  60             rts
00019Dr 2               
00019Dr 2               ; -----------------------------------------------------------------------------
00019Dr 2               ;   PieceMoveLeft / PieceMoveRight
00019Dr 2               ;   Out: C set if the move happened (the caller resets the lock timer).
00019Dr 2               ;   SPEC 5.5 — no wall kicks; a 1-wide piece has nothing to kick off.
00019Dr 2               ; -----------------------------------------------------------------------------
00019Dr 2               PieceMoveLeft:
00019Dr 2  18             clc
00019Er 2  60             rts
00019Fr 2               
00019Fr 2               PieceMoveRight:
00019Fr 2  18             clc
0001A0r 2  60             rts
0001A1r 2               
0001A1r 2               ; -----------------------------------------------------------------------------
0001A1r 2               ;   PieceRotate / PieceRotateBack — cycle the three cells
0001A1r 2               ;   SPEC 5.5 — (A,B,C) -> (B,C,A) forward, (C,A,B) back. Always succeeds.
0001A1r 2               ; -----------------------------------------------------------------------------
0001A1r 2               PieceRotate:
0001A1r 2  60             rts
0001A2r 2               
0001A2r 2               PieceRotateBack:
0001A2r 2  60             rts
0001A3r 2               
0001A3r 2               ; -----------------------------------------------------------------------------
0001A3r 2               ;   PieceStep — one row of gravity
0001A3r 2               ;   Out: C set if the piece has landed and the lock delay should start.
0001A3r 2               ; -----------------------------------------------------------------------------
0001A3r 2               PieceStep:
0001A3r 2  18             clc
0001A4r 2  60             rts
0001A5r 2               
0001A5r 2               ; -----------------------------------------------------------------------------
0001A5r 2               ;   PieceLock — write the three cells into the board
0001A5r 2               ;   SPEC 5.6 — after this the caller runs a cascade.
0001A5r 2               ; -----------------------------------------------------------------------------
0001A5r 2               PieceLock:
0001A5r 2  60             rts
0001A6r 2               
0001A6r 1               .include "../src/match.asm"
0001A6r 2               ; =============================================================================
0001A6r 2               ;   match.asm — Wizards Lab, the match scanner
0001A6r 2               ; =============================================================================
0001A6r 2               ;   SPEC.md section 6. Four passes — horizontal, vertical, and both diagonals —
0001A6r 2               ;   each walking its axis and tracking a run colour and length. A run of three
0001A6r 2               ;   or more sets the MARK bit for each of its cells.
0001A6r 2               ;
0001A6r 2               ;   Colour comparison is the whole trick:
0001A6r 2               ;
0001A6r 2               ;       lda cell
0001A6r 2               ;       and #COLOR_MASK         ; the low three bits are the glyph, ignore them
0001A6r 2               ;       cmp ScanColor
0001A6r 2               ;
0001A6r 2               ;   which is why a red potion, a red fireball and a red star all match. The
0001A6r 2               ;   glyph decides what happens on removal, never whether cells match.
0001A6r 2               ;
0001A6r 2               ;   Wildcards (SPEC 6.3): a WILD cell continues any run. If the run has no
0001A6r 2               ;   colour yet it stays unset and is adopted from the first non-wild cell, so
0001A6r 2               ;   one prism can close a red horizontal run and a blue vertical run at once.
0001A6r 2               ; =============================================================================
0001A6r 2               
0001A6r 2               ; -----------------------------------------------------------------------------
0001A6r 2               ;   MatchScan — find every run on the board
0001A6r 2               ;   In:  nothing
0001A6r 2               ;   Out: Marks filled, RunCount set, Z set if nothing matched.
0001A6r 2               ;        Modifies: A, X, Y, Ptr1, Ptr2, Scan*
0001A6r 2               ; -----------------------------------------------------------------------------
0001A6r 2               MatchScan:
0001A6r 2                 ; TODO: MarksClear, then the four passes below, accumulating RunCount and
0001A6r 2                 ; the per-run (length, colour) pairs the scorer needs.
0001A6r 2  A9 00          lda #0
0001A8r 2  8D rr rr       sta RunCount
0001ABr 2  60             rts
0001ACr 2               
0001ACr 2               MatchScanHorizontal:
0001ACr 2  60             rts
0001ADr 2               
0001ADr 2               MatchScanVertical:
0001ADr 2  60             rts
0001AEr 2               
0001AEr 2               MatchScanDiagonal:                ; down-right
0001AEr 2  60             rts
0001AFr 2               
0001AFr 2               MatchScanAntiDiagonal:            ; down-left
0001AFr 2  60             rts
0001B0r 2               
0001B0r 2               ; -----------------------------------------------------------------------------
0001B0r 2               ;   MarksClear / MarkSet / MarkTest — the 16-byte bitmap
0001B0r 2               ;   One byte per row, bits 0-5 = columns 0-5. Union of runs is a free ORA.
0001B0r 2               ; -----------------------------------------------------------------------------
0001B0r 2               MarksClear:
0001B0r 2  60             rts
0001B1r 2               
0001B1r 2               MarkSet:                          ; In: X = row, Y = column
0001B1r 2  60             rts
0001B2r 2               
0001B2r 2               MarkTest:                         ; In: X = row, Y = column.  Out: C = marked
0001B2r 2  18             clc
0001B3r 2  60             rts
0001B4r 2               
0001B4r 1               .include "../src/cascade.asm"
0001B4r 2               ; =============================================================================
0001B4r 2               ;   cascade.asm — Wizards Lab, clear resolution
0001B4r 2               ; =============================================================================
0001B4r 2               ;   SPEC.md section 8. A cascade runs from the moment a piece locks until no
0001B4r 2               ;   further matches exist, one step per iteration, with ChainStep counting the
0001B4r 2               ;   steps. The step order is fixed:
0001B4r 2               ;
0001B4r 2               ;       scan -> score matches -> enqueue reagents -> resolve queue
0001B4r 2               ;            -> animate -> remove -> level check -> gravity -> repeat
0001B4r 2               ;
0001B4r 2               ;   The effect queue always drains. Effects only ever remove tiles, never add
0001B4r 2               ;   them, and each cell can be marked at most once, so the queue is bounded by
0001B4r 2               ;   the 96 cells of the playfield.
0001B4r 2               ; =============================================================================
0001B4r 2               
0001B4r 2               ; -----------------------------------------------------------------------------
0001B4r 2               ;   CascadeBegin — called immediately after PieceLock
0001B4r 2               ; -----------------------------------------------------------------------------
0001B4r 2               CascadeBegin:
0001B4r 2                 ; TODO: ChainStep = 1, Cascade* = 0, StarCount = 0.
0001B4r 2  60             rts
0001B5r 2               
0001B5r 2               ; -----------------------------------------------------------------------------
0001B5r 2               ;   CascadeStep — advance one step
0001B5r 2               ;   Out: C clear when the cascade has settled and CascadeSettle should run.
0001B5r 2               ; -----------------------------------------------------------------------------
0001B5r 2               CascadeStep:
0001B5r 2  18             clc
0001B6r 2  60             rts
0001B7r 2               
0001B7r 2               ; -----------------------------------------------------------------------------
0001B7r 2               ;   CascadeSettle — apply the star multiplier and bank the points
0001B7r 2               ;   SPEC 8 SETTLE, SPEC 9.6 — the doubling covers the WHOLE cascade, including
0001B7r 2               ;   points scored before the star cleared.
0001B7r 2               ; -----------------------------------------------------------------------------
0001B7r 2               CascadeSettle:
0001B7r 2                 ; TODO: shift CascadeLo/Mid/Hi left by min(StarCount, STAR_SHIFT_CAP) in BCD
0001B7r 2                 ; (a BCD doubling is one self-addition), then ScoreAdd.
0001B7r 2  60             rts
0001B8r 2               
0001B8r 2               ; -----------------------------------------------------------------------------
0001B8r 2               ;   The five reagents (SPEC 7.3). Each marks its targets, scores them at
0001B8r 2               ;   EffectValue[chain], and pushes any reagent it uncovers back onto the queue.
0001B8r 2               ; -----------------------------------------------------------------------------
0001B8r 2               EffectFireball:                   ; In: A = colour key. Every tile of it, board wide.
0001B8r 2  60             rts                             ;     Prisms are immune — they have no colour.
0001B9r 2               
0001B9r 2               EffectBolt:                       ; In: X = row, Y = column. Row + column, <= 21 cells.
0001B9r 2  60             rts
0001BAr 2               
0001BAr 2               EffectBomb:                       ; In: X = row, Y = column. 3x3, clipped at the edges.
0001BAr 2  60             rts
0001BBr 2               
0001BBr 2               EffectStar:                       ; Removes nothing; StarCount += 1, capped later.
0001BBr 2  60             rts
0001BCr 2               
0001BCr 2               EffectPrism:                      ; Removes nothing; awards BONUS_PRISM.
0001BCr 2  60             rts
0001BDr 2               
0001BDr 2               ; -----------------------------------------------------------------------------
0001BDr 2               ;   The effect queue — a ring of (glyph, row, col) packed into two bytes.
0001BDr 2               ;   On overflow an effect is dropped rather than growing the buffer; with at
0001BDr 2               ;   most one reagent per piece, EFFECTQ_ENTRIES is not reachable in practice.
0001BDr 2               ; -----------------------------------------------------------------------------
0001BDr 2               EffectQClear:
0001BDr 2  60             rts
0001BEr 2               
0001BEr 2               EffectQPush:                      ; In: A = glyph, X = row, Y = column
0001BEr 2  60             rts
0001BFr 2               
0001BFr 2               EffectQPop:                       ; Out: C clear if empty
0001BFr 2  18             clc
0001C0r 2  60             rts
0001C1r 2               
0001C1r 1               .include "../src/score.asm"
0001C1r 2               ; =============================================================================
0001C1r 2               ;   score.asm — Wizards Lab, scoring
0001C1r 2               ; =============================================================================
0001C1r 2               ;   SPEC.md section 9. Seven digits of packed BCD in four bytes, low byte
0001C1r 2               ;   first; the top nibble of ScoreTop is held at zero. Every value in
0001C1r 2               ;   tables.inc is a multiple of ten, so scoring is a SED / ADC chain and never
0001C1r 2               ;   a multiply — the one place a tile count has to be multiplied by a table
0001C1r 2               ;   value, it is done as a loop of BCD additions, and the count is at most 21.
0001C1r 2               ;
0001C1r 2               ;   The score clamps at 9999999. It never wraps.
0001C1r 2               ;
0001C1r 2               ;   Display is always all seven digits, zero padded — see TextBcd. Nothing
0001C1r 2               ;   here strips a leading zero, and nothing downstream may either.
0001C1r 2               ; =============================================================================
0001C1r 2               
0001C1r 2               ; -----------------------------------------------------------------------------
0001C1r 2               ;   ScoreHighInit — seed the session high score, once, at power-on
0001C1r 2               ;   SPEC 9.8 — the high score is not persisted; it starts at 0010000 on every
0001C1r 2               ;   power-on, which is the target the first game is played against. It then
0001C1r 2               ;   survives every game in the session, so this is deliberately NOT part of
0001C1r 2               ;   ScoreReset. Nothing may infer "cold boot" from the value being zero: BSS
0001C1r 2               ;   is not cleared on all three machines.
0001C1r 2               ;   Out: nothing.  Modifies: A
0001C1r 2               ; -----------------------------------------------------------------------------
0001C1r 2               ScoreHighInit:
0001C1r 2  A9 00          lda #HIGH_INIT_LO
0001C3r 2  8D rr rr       sta HighLo
0001C6r 2  A9 00          lda #HIGH_INIT_MID
0001C8r 2  8D rr rr       sta HighMid
0001CBr 2  A9 01          lda #HIGH_INIT_HI
0001CDr 2  8D rr rr       sta HighHi
0001D0r 2  A9 00          lda #HIGH_INIT_TOP
0001D2r 2  8D rr rr       sta HighTop
0001D5r 2  A9 01          lda #$01                      ; BCD — the level the target was "set" on
0001D7r 2  8D rr rr       sta HighLevel
0001DAr 2  60             rts
0001DBr 2               
0001DBr 2               ; -----------------------------------------------------------------------------
0001DBr 2               ;   ScoreReset — zero the score for a new game
0001DBr 2               ;   Out: nothing.  Modifies: A
0001DBr 2               ; -----------------------------------------------------------------------------
0001DBr 2               ScoreReset:
0001DBr 2  A9 00          lda #0
0001DDr 2  8D rr rr       sta ScoreLo
0001E0r 2  8D rr rr       sta ScoreMid
0001E3r 2  8D rr rr       sta ScoreHi
0001E6r 2  8D rr rr       sta ScoreTop
0001E9r 2  8D rr rr       sta CascadeLo
0001ECr 2  8D rr rr       sta CascadeMid
0001EFr 2  8D rr rr       sta CascadeHi
0001F2r 2  8D rr rr       sta StarCount
0001F5r 2  60             rts
0001F6r 2               
0001F6r 2               ; -----------------------------------------------------------------------------
0001F6r 2               ;   CascadeAdd — add a 16-bit BCD value to the cascade accumulator
0001F6r 2               ;   In:  A = low BCD byte, X = high BCD byte
0001F6r 2               ;   Out: nothing.  Modifies: A, flags
0001F6r 2               ; -----------------------------------------------------------------------------
0001F6r 2               CascadeAdd:
0001F6r 2                 ; TODO: SED, three-byte add into CascadeLo/Mid/Hi, CLD.
0001F6r 2  60             rts
0001F7r 2               
0001F7r 2               ; -----------------------------------------------------------------------------
0001F7r 2               ;   CascadeAddTimes — add a value N times (the tiles-cleared multiply)
0001F7r 2               ;   In:  A = low BCD, X = high BCD, Y = count
0001F7r 2               ; -----------------------------------------------------------------------------
0001F7r 2               CascadeAddTimes:
0001F7r 2  60             rts
0001F8r 2               
0001F8r 2               ; -----------------------------------------------------------------------------
0001F8r 2               ;   ScoreAdd — bank the cascade accumulator into Score, clamped
0001F8r 2               ;   Out: C set if a new high score was reached this call.
0001F8r 2               ;   SPEC 9.8 — the high score updates live, so the player watches the overtake.
0001F8r 2               ; -----------------------------------------------------------------------------
0001F8r 2               ScoreAdd:
0001F8r 2  18             clc
0001F9r 2  60             rts
0001FAr 2               
0001FAr 2               ; -----------------------------------------------------------------------------
0001FAr 2               ;   ScoreLevelCheck — advance the level when 30 tiles have gone
0001FAr 2               ;   In:  A = tiles removed this step
0001FAr 2               ;   Out: C set if the level advanced.
0001FAr 2               ;   SPEC 10.1 — at most one advance per step, surplus carries over, so a big
0001FAr 2               ;   fireball chain can never skip a level.
0001FAr 2               ; -----------------------------------------------------------------------------
0001FAr 2               ScoreLevelCheck:
0001FAr 2  18             clc
0001FBr 2  60             rts
0001FCr 2               
0001FCr 2               ; -----------------------------------------------------------------------------
0001FCr 2               ;   ScoreGravity — frames per row for the current level
0001FCr 2               ;   Out: A = frame count, from SpeedNTSC or SpeedPAL per Region.
0001FCr 2               ; -----------------------------------------------------------------------------
0001FCr 2               ScoreGravity:
0001FCr 2  A9 30          lda #48                       ; TODO: index SpeedNTSC/SpeedPAL by Level-1,
0001FEr 2  60             rts                           ;       clamped to LEVEL_SPEED_CAP - 1
0001FFr 2               
0001FFr 1               .include "../src/render.asm"
0001FFr 2               ; =============================================================================
0001FFr 2               ;   render.asm — Wizards Lab, the dirty-cell renderer
0001FFr 2               ; =============================================================================
0001FFr 2               ;   SPEC.md section 12.6. The screen is never fully redrawn during play.
0001FFr 2               ;   Changed cells are appended to a ring and flushed once a frame, at most
0001FFr 2               ;   DIRTY_FLUSH_MAX per frame with the remainder carried over.
0001FFr 2               ;
0001FFr 2               ;   The cap is NOT a hardware write-spacing limit. S1 measured this loop at
0001FFr 2               ;   165 cycles a cell on the AC6502, which puts two VRAM data writes 165 us
0001FFr 2               ;   apart at 1 MHz and the closest two VDP PORT accesses 8 cycles apart —
0001FFr 2               ;   inside even a real TMS9918A's 8 us and 2 us windows with two orders of
0001FFr 2               ;   magnitude to spare, and further inside a pico9918's, which emulates VRAM
0001FFr 2               ;   in RP2040 memory and has no display contention at all. A 6502 at this
0001FFr 2               ;   clock cannot write a TMS9918 too fast however hard it tries.
0001FFr 2               ;
0001FFr 2               ;   The cap is a TIME BUDGET: DIRTY_FLUSH_MAX cells is what fits in vertical
0001FFr 2               ;   blank on the tightest of the three. See constants.inc and PLAN.md S1.
0001FFr 2               ;
0001FFr 2               ;   All screen access goes through HalPlotCell (see hal.inc). Nothing in this
0001FFr 2               ;   file knows where screen memory is.
0001FFr 2               ; =============================================================================
0001FFr 2               
0001FFr 2               ; -----------------------------------------------------------------------------
0001FFr 2               ;   RenderDirtyReset — empty the ring and cancel any outstanding board redraw
0001FFr 2               ;   Call this after anything that draws the whole screen behind the renderer's
0001FFr 2               ;   back (HalBlitScreen), because every queued cell then describes a screen
0001FFr 2               ;   that no longer exists.
0001FFr 2               ;   In:  nothing        Out: nothing.  Modifies: A
0001FFr 2               ; -----------------------------------------------------------------------------
0001FFr 2               RenderDirtyReset:
0001FFr 2  A9 00          lda #0
000201r 2  8D rr rr       sta DirtyCount
000204r 2  8D rr rr       sta DirtyHead
000207r 2  8D rr rr       sta DirtyTail
00020Ar 2  A9 FF          lda #$FF
00020Cr 2  8D rr rr       sta RedrawIdx
00020Fr 2  60             rts
000210r 2               
000210r 2               ; -----------------------------------------------------------------------------
000210r 2               ;   RenderMark — queue one panel cell
000210r 2               ;   In:  A = tile, X = panel column, Y = panel row
000210r 2               ;   Out: nothing.  Modifies: A, X.  PRESERVES Y and every byte of zero page.
000210r 2               ;
000210r 2               ;   The PANEL_X / PANEL_Y offset is applied here, once, so nothing upstream
000210r 2               ;   has to know which machine it is running on.
000210r 2               ;
000210r 2               ;   Preserving Y and zero page is a contract, not an accident: text.asm holds
000210r 2               ;   its string cursor across this call (see zeropage.inc). The three values
000210r 2               ;   ride the stack rather than scratch bytes because A, X and Y are all live
000210r 2               ;   at once and there is no fourth register to index the ring with.
000210r 2               ;
000210r 2               ;   A mark that arrives with the ring full is DROPPED, silently (D6).
000210r 2               ; -----------------------------------------------------------------------------
000210r 2               RenderMark:
000210r 2  48             pha                           ; Tile
000211r 2  98             tya
000212r 2  18             clc
000213r 2  69 00          adc #PANEL_Y                  ; Panel row -> screen row
000215r 2  48             pha
000216r 2  8A             txa
000217r 2  18             clc
000218r 2  69 09          adc #PANEL_X                  ; Panel column -> screen column
00021Ar 2  48             pha
00021Br 2               
00021Br 2  AD rr rr       lda DirtyCount
00021Er 2  C9 40          cmp #DIRTY_ENTRIES
000220r 2  B0 1F          bcs @Full
000222r 2  EE rr rr       inc DirtyCount
000225r 2               
000225r 2  AE rr rr       ldx DirtyTail
000228r 2  68             pla
000229r 2  9D rr rr       sta Dirty+0,x                 ; Screen column
00022Cr 2  68             pla
00022Dr 2  9D rr rr       sta Dirty+1,x                 ; Screen row
000230r 2  68             pla
000231r 2  9D rr rr       sta Dirty+2,x                 ; Tile
000234r 2               
000234r 2  E8             inx                           ; Step one entry, wrapping the ring
000235r 2  E8             inx
000236r 2  E8             inx
000237r 2  E0 C0          cpx #DIRTY_BYTES
000239r 2  90 02          bcc @Store
00023Br 2  A2 00          ldx #0
00023Dr 2               @Store:
00023Dr 2  8E rr rr       stx DirtyTail
000240r 2  60             rts
000241r 2               
000241r 2               @Full:
000241r 2  68             pla                           ; Unwind and drop it. The cell is wrong until
000242r 2  68             pla                           ;   something marks it again.
000243r 2  68             pla
000244r 2  60             rts
000245r 2               
000245r 2               ; -----------------------------------------------------------------------------
000245r 2               ;   RenderFlush — push up to DIRTY_FLUSH_MAX queued cells to the screen
000245r 2               ;   Called once per frame, from the top of the main loop.
000245r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
000245r 2               ; -----------------------------------------------------------------------------
000245r 2               RenderFlush:
000245r 2  20 rr rr       jsr RenderBoardStep           ; Top the ring up from a board redraw, if one
000248r 2                                               ;   is outstanding, so it always makes progress
000248r 2  AD rr rr       lda DirtyCount
00024Br 2  F0 31          beq @Done
00024Dr 2  C9 18          cmp #DIRTY_FLUSH_MAX
00024Fr 2  90 02          bcc @Budget
000251r 2  A9 18          lda #DIRTY_FLUSH_MAX
000253r 2               @Budget:
000253r 2  85 rr          sta FlushLeft
000255r 2               
000255r 2               @Cell:
000255r 2  AE rr rr       ldx DirtyHead
000258r 2  BD rr rr       lda Dirty+1,x
00025Br 2  A8             tay                           ; Y = screen row
00025Cr 2  BD rr rr       lda Dirty+2,x
00025Fr 2  48             pha                           ; Tile
000260r 2  BD rr rr       lda Dirty+0,x
000263r 2  AA             tax                           ; X = screen column
000264r 2  68             pla                           ; A = tile
000265r 2  20 rr rr       jsr HalPlotCell
000268r 2               
000268r 2  AD rr rr       lda DirtyHead                 ; Step one entry, wrapping the ring
00026Br 2  18             clc
00026Cr 2  69 03          adc #3
00026Er 2  C9 C0          cmp #DIRTY_BYTES
000270r 2  90 02          bcc @Store
000272r 2  A9 00          lda #0
000274r 2               @Store:
000274r 2  8D rr rr       sta DirtyHead
000277r 2  CE rr rr       dec DirtyCount
00027Ar 2  C6 rr          dec FlushLeft
00027Cr 2  D0 D7          bne @Cell
00027Er 2               @Done:
00027Er 2  60             rts
00027Fr 2               
00027Fr 2               ; -----------------------------------------------------------------------------
00027Fr 2               ;   RenderBoard — ask for the whole 6 x 16 well to be redrawn
00027Fr 2               ;   Used on state entry and after a pause, not per frame.
00027Fr 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
00027Fr 2               ;
00027Fr 2               ;   The well is 96 cells and the ring holds DIRTY_ENTRIES; a redraw therefore
00027Fr 2               ;   cannot be queued in one go. This only sets the cursor. RenderBoardStep,
00027Fr 2               ;   which RenderFlush calls every frame, feeds the ring as fast as it drains,
00027Fr 2               ;   so the redraw spreads over as many frames as it needs and never drops a
00027Fr 2               ;   cell.
00027Fr 2               ; -----------------------------------------------------------------------------
00027Fr 2               RenderBoard:
00027Fr 2  A9 00          lda #0
000281r 2  8D rr rr       sta RedrawIdx                 ; Board index 0 = row 0, column 0
000284r 2  60             rts                           ; And nothing else. Falling through into the
000285r 2                                               ;   step below would fill the ring here and
000285r 2                                               ;   drop whatever the caller marks next.
000285r 2               
000285r 2               ; -----------------------------------------------------------------------------
000285r 2               ;   RenderBoardStep — queue as much of an outstanding board redraw as fits
000285r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000285r 2               ;   Does nothing when RedrawIdx is $FF.
000285r 2               ; -----------------------------------------------------------------------------
000285r 2               RenderBoardStep:
000285r 2  AD rr rr       lda RedrawIdx
000288r 2  30 41          bmi @Done                     ; $FF — nothing outstanding
00028Ar 2               
00028Ar 2               @Cell:
00028Ar 2  AD rr rr       lda DirtyCount
00028Dr 2  C9 40          cmp #DIRTY_ENTRIES
00028Fr 2  B0 3A          bcs @Done                     ; Ring full — pick this cell up next frame
000291r 2               
000291r 2  AE rr rr       ldx RedrawIdx
000294r 2  8A             txa
000295r 2  29 07          and #(BOARD_STRIDE - 1)
000297r 2  18             clc
000298r 2  69 01          adc #WELL_ORIGIN_X
00029Ar 2  85 rr          sta RedrawCol
00029Cr 2  8A             txa
00029Dr 2  4A             lsr a                         ; Board index >> 3 is the row (stride 8)
00029Er 2  4A             lsr a
00029Fr 2  4A             lsr a
0002A0r 2  18             clc
0002A1r 2  69 04          adc #WELL_ORIGIN_Y
0002A3r 2  A8             tay                           ; Y = panel row
0002A4r 2  BD rr rr       lda Board,x                   ; The board byte IS the tile — empty is $00,
0002A7r 2  A6 rr          ldx RedrawCol                 ;   which is TILE_BLANK (SPEC 3.3, 4.2)
0002A9r 2  20 rr rr       jsr RenderMark
0002ACr 2               
0002ACr 2  AE rr rr       ldx RedrawIdx                 ; Advance, stepping over the two sentinel
0002AFr 2  E8             inx                           ;   columns at the end of each row
0002B0r 2  8A             txa
0002B1r 2  29 07          and #(BOARD_STRIDE - 1)
0002B3r 2  C9 06          cmp #BOARD_W
0002B5r 2  90 05          bcc @Save
0002B7r 2  8A             txa
0002B8r 2  18             clc
0002B9r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
0002BBr 2  AA             tax
0002BCr 2               @Save:
0002BCr 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
0002BEr 2  B0 06          bcs @Finish
0002C0r 2  8E rr rr       stx RedrawIdx
0002C3r 2  4C rr rr       jmp @Cell
0002C6r 2               
0002C6r 2               @Finish:
0002C6r 2  A9 FF          lda #$FF
0002C8r 2  8D rr rr       sta RedrawIdx
0002CBr 2               @Done:
0002CBr 2  60             rts
0002CCr 2               
0002CCr 2               ; -----------------------------------------------------------------------------
0002CCr 2               ;   RenderCell — queue one board cell by board index
0002CCr 2               ;   In:  X = board index (row * BOARD_STRIDE + column)
0002CCr 2               ;   Out: nothing.  Modifies: A, X, Y
0002CCr 2               ;   The single-cell form of RenderBoardStep, for the phases that move one tile
0002CCr 2               ;   at a time.
0002CCr 2               ; -----------------------------------------------------------------------------
0002CCr 2               RenderCell:
0002CCr 2  8A             txa
0002CDr 2  29 07          and #(BOARD_STRIDE - 1)
0002CFr 2  18             clc
0002D0r 2  69 01          adc #WELL_ORIGIN_X
0002D2r 2  85 rr          sta RedrawCol
0002D4r 2  8A             txa
0002D5r 2  4A             lsr a
0002D6r 2  4A             lsr a
0002D7r 2  4A             lsr a
0002D8r 2  18             clc
0002D9r 2  69 04          adc #WELL_ORIGIN_Y
0002DBr 2  A8             tay
0002DCr 2  BD rr rr       lda Board,x
0002DFr 2  A6 rr          ldx RedrawCol
0002E1r 2  4C rr rr       jmp RenderMark
0002E4r 2               
0002E4r 2               ; -----------------------------------------------------------------------------
0002E4r 2               ;   RenderPiece / RenderPieceErase — the three falling cells
0002E4r 2               ;   P2.
0002E4r 2               ; -----------------------------------------------------------------------------
0002E4r 2               RenderPiece:
0002E4r 2  60             rts
0002E5r 2               
0002E5r 2               RenderPieceErase:
0002E5r 2  60             rts
0002E6r 2               
0002E6r 2               ; -----------------------------------------------------------------------------
0002E6r 2               ;   RenderNext — the preview, panel column NEXT_X, rows NEXT_Y..NEXT_Y+2
0002E6r 2               ;   P2.
0002E6r 2               ; -----------------------------------------------------------------------------
0002E6r 2               RenderNext:
0002E6r 2  60             rts
0002E7r 2               
0002E7r 2               ; -----------------------------------------------------------------------------
0002E7r 2               ;   RenderScore / RenderHigh / RenderLevel — only called when a value changes
0002E7r 2               ;   Nothing here compares anything: the caller knows when it changed a value
0002E7r 2               ;   and these are not cheap enough to run every frame. SCORE_DIGITS cells is
0002E7r 2               ;   most of a frame's flush budget on its own.
0002E7r 2               ; -----------------------------------------------------------------------------
0002E7r 2               RenderScore:
0002E7r 2  A9 rr          lda #<ScoreLo
0002E9r 2  85 rr          sta Ptr1
0002EBr 2  A9 rr          lda #>ScoreLo
0002EDr 2  85 rr          sta Ptr1+1
0002EFr 2  A2 0C          ldx #SCORE_X
0002F1r 2  A0 05          ldy #SCORE_Y
0002F3r 2  A9 07          lda #SCORE_DIGITS
0002F5r 2  4C rr rr       jmp TextBcd
0002F8r 2               
0002F8r 2               RenderHigh:
0002F8r 2  A9 rr          lda #<HighLo
0002FAr 2  85 rr          sta Ptr1
0002FCr 2  A9 rr          lda #>HighLo
0002FEr 2  85 rr          sta Ptr1+1
000300r 2  A2 0C          ldx #HIGH_X
000302r 2  A0 0A          ldy #HIGH_Y
000304r 2  A9 07          lda #SCORE_DIGITS
000306r 2  20 rr rr       jsr TextBcd
000309r 2               
000309r 2  A9 rr          lda #<HighLevel               ; The level it was set on, under the digits
00030Br 2  85 rr          sta Ptr1
00030Dr 2  A9 rr          lda #>HighLevel
00030Fr 2  85 rr          sta Ptr1+1
000311r 2  A2 0F          ldx #HIGHLVL_X
000313r 2  A0 0B          ldy #HIGHLVL_Y
000315r 2  A9 02          lda #LEVEL_DIGITS
000317r 2  4C rr rr       jmp TextBcd
00031Ar 2               
00031Ar 2               RenderLevel:
00031Ar 2  AD rr rr       lda Level
00031Dr 2  4C rr rr       jmp TextLevel
000320r 2               
000320r 1               .include "../src/text.asm"
000320r 2               ; =============================================================================
000320r 2               ;   text.asm — Wizards Lab, text and numbers on the panel
000320r 2               ; =============================================================================
000320r 2               ;   The font lives in tile groups 2-6, forty glyphs in the order
000320r 2               ;
000320r 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
000320r 2               ;
000320r 2               ;   starting at FONT_BASE, so a digit is FONT_DIGIT_0 + value and a letter is
000320r 2               ;   FONT_LETTER_A + (letter - 'A'). Strings are stored pre-converted to tile
000320r 2               ;   numbers, terminated by TEXT_END, so drawing one is a copy with no
000320r 2               ;   translation. src/strings.inc holds them and the macro that encodes them.
000320r 2               ;
000320r 2               ;   Everything here draws through RenderMark, never to the screen: text is
000320r 2               ;   panel cells like any other and goes through the same one flush a frame.
000320r 2               ;   That is also why the cursor state lives in the zero-page block RenderMark
000320r 2               ;   promises not to touch (zeropage.inc) rather than in Tmp0-Tmp3.
000320r 2               ; =============================================================================
000320r 2               
000320r 2               ; -----------------------------------------------------------------------------
000320r 2               ;   TextDraw — draw a tile-encoded string
000320r 2               ;   In:  Ptr1 -> string (TEXT_END terminated), X = panel column, Y = panel row
000320r 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx
000320r 2               ; -----------------------------------------------------------------------------
000320r 2               TextDraw:
000320r 2  86 rr          stx TextCol
000322r 2  84 rr          sty TextRow
000324r 2  A9 00          lda #0
000326r 2  85 rr          sta TextIdx
000328r 2               @Char:
000328r 2  A4 rr          ldy TextIdx
00032Ar 2  B1 rr          lda (Ptr1),y
00032Cr 2  C9 FF          cmp #TEXT_END
00032Er 2  F0 0D          beq @Done
000330r 2  A6 rr          ldx TextCol
000332r 2  A4 rr          ldy TextRow
000334r 2  20 rr rr       jsr RenderMark
000337r 2  E6 rr          inc TextCol
000339r 2  E6 rr          inc TextIdx
00033Br 2  D0 EB          bne @Char                     ; Always — a string is never 256 tiles long
00033Dr 2               @Done:
00033Dr 2  60             rts
00033Er 2               
00033Er 2               ; -----------------------------------------------------------------------------
00033Er 2               ;   TextBcd — draw a packed-BCD number, zero padded
00033Er 2               ;   In:  Ptr1 -> BCD bytes (low first), A = digit count,
00033Er 2               ;        X = panel column, Y = panel row
00033Er 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx, TextByte,
00033Er 2               ;        TextSkip
00033Er 2               ;
00033Er 2               ;   SCORE_DIGITS (7) for the score and the high score, 2 for the high score's
00033Er 2               ;   level. The LEVEL box is not drawn with this — see TextLevel.
00033Er 2               ;
00033Er 2               ;   The count is in DIGITS, not bytes, because the score is seven digits in
00033Er 2               ;   four bytes: the top nibble of the most significant byte is held at zero
00033Er 2               ;   (SPEC 9) and must not be drawn, or the field would be eight cells wide and
00033Er 2               ;   no longer centred. An odd count starts at the LOW nibble of the top byte.
00033Er 2               ;
00033Er 2               ;   **Every digit is drawn, every time.** A leading zero is a zero glyph, not
00033Er 2               ;   a blank: 1250 draws as 0001250. There is no suppression pass and no
00033Er 2               ;   right-alignment — the field is fixed width so a digit never changes
00033Er 2               ;   column while the player is watching it (SPEC 9). This also makes the
00033Er 2               ;   routine branchless, and lets RenderScore mark a fixed run of cells dirty.
00033Er 2               ; -----------------------------------------------------------------------------
00033Er 2               TextBcd:
00033Er 2  86 rr          stx TextCol
000340r 2  84 rr          sty TextRow
000342r 2  48             pha                           ; Digit count
000343r 2  29 01          and #$01
000345r 2  85 rr          sta TextSkip                  ; Odd count: the top high nibble is not drawn
000347r 2  68             pla
000348r 2  18             clc
000349r 2  69 01          adc #1                        ; Bytes = (digits + 1) / 2
00034Br 2  4A             lsr a
00034Cr 2  AA             tax
00034Dr 2  CA             dex
00034Er 2  86 rr          stx TextIdx                   ; Start at the most significant byte
000350r 2               
000350r 2               @Byte:
000350r 2  A4 rr          ldy TextIdx
000352r 2  B1 rr          lda (Ptr1),y
000354r 2  85 rr          sta TextByte
000356r 2               
000356r 2  A5 rr          lda TextSkip
000358r 2  D0 09          bne @Low
00035Ar 2  A5 rr          lda TextByte
00035Cr 2  4A             lsr a
00035Dr 2  4A             lsr a
00035Er 2  4A             lsr a
00035Fr 2  4A             lsr a
000360r 2  20 rr rr       jsr TextDigit
000363r 2               @Low:
000363r 2  A9 00          lda #0
000365r 2  85 rr          sta TextSkip
000367r 2  A5 rr          lda TextByte
000369r 2  29 0F          and #$0F
00036Br 2  20 rr rr       jsr TextDigit
00036Er 2               
00036Er 2  C6 rr          dec TextIdx
000370r 2  10 DE          bpl @Byte
000372r 2  60             rts
000373r 2               
000373r 2               ; -----------------------------------------------------------------------------
000373r 2               ;   TextDigit — draw one digit at the cursor and step it right
000373r 2               ;   In:  A = value 0-9      Modifies: A, X, Y, TextCol
000373r 2               ; -----------------------------------------------------------------------------
000373r 2               TextDigit:
000373r 2  18             clc
000374r 2  69 10          adc #FONT_DIGIT_0
000376r 2  A6 rr          ldx TextCol
000378r 2  A4 rr          ldy TextRow
00037Ar 2  20 rr rr       jsr RenderMark
00037Dr 2  E6 rr          inc TextCol
00037Fr 2  60             rts
000380r 2               
000380r 2               ; -----------------------------------------------------------------------------
000380r 2               ;   TextBanner — centre a string in the one-row message band
000380r 2               ;   In:  Ptr1 -> string
000380r 2               ;   Out: nothing.  Modifies: A, X, Y and the text cursor
000380r 2               ;
000380r 2               ;   SPEC 12.2 — the band is panel row MSG_Y, full width, one row only. The
000380r 2               ;   string arrives already wrapped as `~~ TEXT ~~` — two FONT_TILDE, a blank,
000380r 2               ;   the text, a blank, two FONT_TILDE. Centring is (PANEL_W - length) / 2,
000380r 2               ;   which is why banner strings are drawn even-length.
000380r 2               ; -----------------------------------------------------------------------------
000380r 2               TextBanner:
000380r 2  A0 00          ldy #0
000382r 2               @Len:
000382r 2  B1 rr          lda (Ptr1),y
000384r 2  C9 FF          cmp #TEXT_END
000386r 2  F0 03          beq @Got
000388r 2  C8             iny
000389r 2  D0 F7          bne @Len
00038Br 2               @Got:
00038Br 2  98             tya
00038Cr 2  85 rr          sta TextIdx
00038Er 2  A9 16          lda #PANEL_W
000390r 2  38             sec
000391r 2  E5 rr          sbc TextIdx
000393r 2  4A             lsr a                         ; (PANEL_W - length) / 2
000394r 2  AA             tax
000395r 2  A0 16          ldy #MSG_Y
000397r 2  4C rr rr       jmp TextDraw
00039Ar 2               
00039Ar 2               ; -----------------------------------------------------------------------------
00039Ar 2               ;   TextBannerClear — blank the message band back to backdrop
00039Ar 2               ;   Out: nothing.  Modifies: A, X, Y
00039Ar 2               ;
00039Ar 2               ;   Columns MSG_X .. MSG_X + MSG_W - 1 only. The shelf tiles at either end of
00039Ar 2               ;   the band belong to the static screen image and are never redrawn.
00039Ar 2               ; -----------------------------------------------------------------------------
00039Ar 2               TextBannerClear:
00039Ar 2  A9 02          lda #MSG_X
00039Cr 2  85 rr          sta TextCol                   ; Not X: RenderMark clobbers it
00039Er 2               @Cell:
00039Er 2  A9 00          lda #TILE_BLANK
0003A0r 2  A6 rr          ldx TextCol
0003A2r 2  A0 16          ldy #MSG_Y
0003A4r 2  20 rr rr       jsr RenderMark
0003A7r 2  E6 rr          inc TextCol
0003A9r 2  A5 rr          lda TextCol
0003ABr 2  C9 14          cmp #(MSG_X + MSG_W)
0003ADr 2  90 EF          bcc @Cell
0003AFr 2  60             rts
0003B0r 2               
0003B0r 2               ; -----------------------------------------------------------------------------
0003B0r 2               ;   TextLevel — the LEVEL box, tens above units in one column
0003B0r 2               ;   In:  A = level (binary, 1-99)
0003B0r 2               ;   Out: nothing.  Modifies: A, X, Y, TextByte
0003B0r 2               ;   SPEC 12.2 — LEVEL_X, tens at LEVEL_Y and units at LEVEL_Y + 1. Always two
0003B0r 2               ;   digits: level 5 draws "0" over "5".
0003B0r 2               ; -----------------------------------------------------------------------------
0003B0r 2               TextLevel:
0003B0r 2  A2 00          ldx #0
0003B2r 2               @Tens:
0003B2r 2  C9 0A          cmp #10
0003B4r 2  90 05          bcc @Split
0003B6r 2  E9 0A          sbc #10                       ; Carry is set by the CMP that got us here
0003B8r 2  E8             inx
0003B9r 2  D0 F7          bne @Tens                     ; Always — X tops out at 9
0003BBr 2               @Split:
0003BBr 2  85 rr          sta TextByte                  ; Units
0003BDr 2  8A             txa
0003BEr 2  18             clc
0003BFr 2  69 10          adc #FONT_DIGIT_0
0003C1r 2  A2 12          ldx #LEVEL_X
0003C3r 2  A0 11          ldy #LEVEL_Y
0003C5r 2  20 rr rr       jsr RenderMark
0003C8r 2  A5 rr          lda TextByte
0003CAr 2  18             clc
0003CBr 2  69 10          adc #FONT_DIGIT_0
0003CDr 2  A2 12          ldx #LEVEL_X
0003CFr 2  A0 12          ldy #LEVEL_Y + 1
0003D1r 2  4C rr rr       jmp RenderMark
0003D4r 2               
0003D4r 1               .include "../src/audio.asm"
0003D4r 2               ; =============================================================================
0003D4r 2               ;   audio.asm — Wizards Lab, sound
0003D4r 2               ; =============================================================================
0003D4r 2               ;   SPEC.md section 16. Out of scope for the first playable build, but the
0003D4r 2               ;   hook is here from the start so game logic never has to be revisited to add
0003D4r 2               ;   it: logic writes an effect id to SfxRequest and forgets about it.
0003D4r 2               ;
0003D4r 2               ;   The AC6502 and the C64 both have a SID and can share a driver — only the
0003D4r 2               ;   register base differs ($9800 against $D400). The VIC-20 needs its own,
0003D4r 2               ;   against $900A-$900E.
0003D4r 2               ; =============================================================================
0003D4r 2               
0003D4r 2               SFX_MOVE        = 1
0003D4r 2               SFX_ROTATE      = 2
0003D4r 2               SFX_LOCK        = 3
0003D4r 2               SFX_MATCH       = 4
0003D4r 2               SFX_FIREBALL    = 5
0003D4r 2               SFX_BOLT        = 6
0003D4r 2               SFX_BOMB        = 7
0003D4r 2               SFX_STAR        = 8
0003D4r 2               SFX_PRISM       = 9
0003D4r 2               SFX_LEVELUP     = 10
0003D4r 2               SFX_HIGHSCORE   = 11
0003D4r 2               SFX_GAMEOVER    = 12
0003D4r 2               
0003D4r 2               ; -----------------------------------------------------------------------------
0003D4r 2               ;   AudioInit — silence everything
0003D4r 2               ; -----------------------------------------------------------------------------
0003D4r 2               AudioInit:
0003D4r 2  A9 00          lda #0
0003D6r 2  8D rr rr       sta SfxRequest
0003D9r 2  8D rr rr       sta SfxTimer
0003DCr 2  60             rts
0003DDr 2               
0003DDr 2               ; -----------------------------------------------------------------------------
0003DDr 2               ;   AudioTick — called once per frame, consumes SfxRequest
0003DDr 2               ; -----------------------------------------------------------------------------
0003DDr 2               AudioTick:
0003DDr 2                 ; TODO: start a new effect when SfxRequest is non-zero, then advance the
0003DDr 2                 ; envelope of whatever is playing. Calls HalSfx for the register writes.
0003DDr 2  A9 00          lda #0
0003DFr 2  8D rr rr       sta SfxRequest
0003E2r 2  60             rts
0003E3r 2               
0003E3r 1               
0003E3r 1               ; =============================================================================
0003E3r 1               ;   HAL — VIC-II, standard text mode
0003E3r 1               ; =============================================================================
0003E3r 1               
0003E3r 1               ; -----------------------------------------------------------------------------
0003E3r 1               ;   HalInitVideo — 40 x 25 cells, custom charset at $2000, everything black
0003E3r 1               ; -----------------------------------------------------------------------------
0003E3r 1               HalInitVideo:
0003E3r 1  AD 00 DD       lda $DD00                     ; VIC bank 0: $0000-$3FFF
0003E6r 1  09 03          ora #$03
0003E8r 1  8D 00 DD       sta $DD00
0003EBr 1               
0003EBr 1  A9 1B          lda #$1B                      ; Text mode, display on, 25 rows
0003EDr 1  8D 11 D0       sta VIC_CTRL1
0003F0r 1  A9 C8          lda #$C8                      ; 40 columns, no multicolor
0003F2r 1  8D 16 D0       sta VIC_CTRL2
0003F5r 1  A9 18          lda #$18                      ; Screen $0400, character set $2000
0003F7r 1  8D 18 D0       sta VIC_MEMPTR
0003FAr 1  A9 00          lda #$00
0003FCr 1  8D 20 D0       sta VIC_BORDERCOL
0003FFr 1  8D 21 D0       sta VIC_BGCOL0
000402r 1  8D 15 D0       sta VIC_SPRENA                ; No sprites. Not an oversight — see the header.
000405r 1               
000405r 1  20 rr rr       jsr LoadTileset
000408r 1                 ; falls through
000408r 1               
000408r 1               ; -----------------------------------------------------------------------------
000408r 1               ;   HalClearScreen — blank tiles, white colour RAM
000408r 1               ; -----------------------------------------------------------------------------
000408r 1               HalClearScreen:
000408r 1  A2 00          ldx #0
00040Ar 1               @Cell:
00040Ar 1  A9 00          lda #TILE_BLANK
00040Cr 1  9D 00 04       sta SCREEN + $0000,x
00040Fr 1  9D 00 05       sta SCREEN + $0100,x
000412r 1  9D 00 06       sta SCREEN + $0200,x
000415r 1  9D 00 07       sta SCREEN + $0300,x
000418r 1  A9 01          lda #1                        ; White
00041Ar 1  9D 00 D8       sta COLRAM + $0000,x
00041Dr 1  9D 00 D9       sta COLRAM + $0100,x
000420r 1  9D 00 DA       sta COLRAM + $0200,x
000423r 1  9D 00 DB       sta COLRAM + $0300,x
000426r 1  E8             inx
000427r 1  D0 E1          bne @Cell
000429r 1  60             rts
00042Ar 1               
00042Ar 1               ; -----------------------------------------------------------------------------
00042Ar 1               ;   LoadTileset — copy 2 K of patterns from cartridge ROM to $2000
00042Ar 1               ;   PLACEHOLDER ART: Tileset is data/tileset.bin. The same 2048-byte file
00042Ar 1               ;   drives all three machines — the pattern format is identical. See
00042Ar 1               ;   data/README.md.
00042Ar 1               ; -----------------------------------------------------------------------------
00042Ar 1               LoadTileset:
00042Ar 1  A9 rr          lda #<Tileset
00042Cr 1  85 rr          sta SrcPtr
00042Er 1  A9 rr          lda #>Tileset
000430r 1  85 rr          sta SrcPtr+1
000432r 1  A9 00          lda #<CHARSET_RAM
000434r 1  85 rr          sta DstPtr
000436r 1  A9 20          lda #>CHARSET_RAM
000438r 1  85 rr          sta DstPtr+1
00043Ar 1               
00043Ar 1  A2 08          ldx #8                        ; 8 x 256 = 2048 bytes
00043Cr 1  A0 00          ldy #0
00043Er 1               @Byte:
00043Er 1  B1 rr          lda (SrcPtr),y
000440r 1  91 rr          sta (DstPtr),y
000442r 1  C8             iny
000443r 1  D0 F9          bne @Byte
000445r 1  E6 rr          inc SrcPtr+1
000447r 1  E6 rr          inc DstPtr+1
000449r 1  CA             dex
00044Ar 1  D0 F2          bne @Byte
00044Cr 1  60             rts
00044Dr 1               
00044Dr 1               ; -----------------------------------------------------------------------------
00044Dr 1               ;   HalWaitFrame — sync on raster line 251, below the visible area
00044Dr 1               ; -----------------------------------------------------------------------------
00044Dr 1               HalWaitFrame:
00044Dr 1               @NotYet:
00044Dr 1  AD 12 D0       lda VIC_RASTER
000450r 1  C9 FB          cmp #251
000452r 1  F0 F9          beq @NotYet                   ; Leave the line first, so a fast frame
000454r 1               @Wait:                          ;   cannot fall straight through
000454r 1  AD 12 D0       lda VIC_RASTER
000457r 1  C9 FB          cmp #251
000459r 1  D0 F9          bne @Wait
00045Br 1  60             rts
00045Cr 1               
00045Cr 1               ; -----------------------------------------------------------------------------
00045Cr 1               ;   HalPlotCell — In: A = tile, X = screen column, Y = screen row
00045Cr 1               ; -----------------------------------------------------------------------------
00045Cr 1               HalPlotCell:
00045Cr 1  48             pha                           ; Hold the tile; RowPtrs needs A
00045Dr 1  20 rr rr       jsr RowPtrs
000460r 1  8A             txa
000461r 1  A8             tay                           ; Y = column
000462r 1  68             pla                           ; A = tile
000463r 1  91 rr          sta (ScreenPtr),y
000465r 1  AA             tax                           ; The tile is its own colour lookup index
000466r 1  BD rr rr       lda TileColorC64,x
000469r 1  91 rr          sta (ColorPtr),y
00046Br 1  60             rts
00046Cr 1               
00046Cr 1               ; -----------------------------------------------------------------------------
00046Cr 1               ;   RowPtrs — In: Y = screen row.  Out: ScreenPtr, ColorPtr at that row
00046Cr 1               ; -----------------------------------------------------------------------------
00046Cr 1               RowPtrs:
00046Cr 1  B9 rr rr       lda RowLo,y
00046Fr 1  85 rr          sta ScreenPtr
000471r 1  85 rr          sta ColorPtr
000473r 1  B9 rr rr       lda RowHi,y
000476r 1  85 rr          sta ScreenPtr+1
000478r 1  18             clc
000479r 1  69 D4          adc #(>COLRAM - >SCREEN)      ; Colour RAM mirrors the matrix, page-offset
00047Br 1  85 rr          sta ColorPtr+1
00047Dr 1  60             rts
00047Er 1               
00047Er 1               ; -----------------------------------------------------------------------------
00047Er 1               ;   HalBlitScreen — draw a full 1000-byte screen plus its colour image
00047Er 1               ;   In: SrcPtr -> name table, Ptr1 -> colour table
00047Er 1               ; -----------------------------------------------------------------------------
00047Er 1               HalBlitScreen:
00047Er 1  A0 00          ldy #0
000480r 1               @Page0:
000480r 1  B1 rr          lda (SrcPtr),y
000482r 1  99 00 04       sta SCREEN + $0000,y
000485r 1  B1 rr          lda (Ptr1),y
000487r 1  99 00 D8       sta COLRAM + $0000,y
00048Ar 1  C8             iny
00048Br 1  D0 F3          bne @Page0
00048Dr 1               
00048Dr 1  E6 rr          inc SrcPtr+1
00048Fr 1  E6 rr          inc Ptr1+1
000491r 1  A0 00          ldy #0
000493r 1               @Page1:
000493r 1  B1 rr          lda (SrcPtr),y
000495r 1  99 00 05       sta SCREEN + $0100,y
000498r 1  B1 rr          lda (Ptr1),y
00049Ar 1  99 00 D9       sta COLRAM + $0100,y
00049Dr 1  C8             iny
00049Er 1  D0 F3          bne @Page1
0004A0r 1               
0004A0r 1  E6 rr          inc SrcPtr+1
0004A2r 1  E6 rr          inc Ptr1+1
0004A4r 1  A0 00          ldy #0
0004A6r 1               @Page2:
0004A6r 1  B1 rr          lda (SrcPtr),y
0004A8r 1  99 00 06       sta SCREEN + $0200,y
0004ABr 1  B1 rr          lda (Ptr1),y
0004ADr 1  99 00 DA       sta COLRAM + $0200,y
0004B0r 1  C8             iny
0004B1r 1  D0 F3          bne @Page2
0004B3r 1               
0004B3r 1  E6 rr          inc SrcPtr+1
0004B5r 1  E6 rr          inc Ptr1+1
0004B7r 1  A0 00          ldy #0
0004B9r 1               @Page3:
0004B9r 1  B1 rr          lda (SrcPtr),y
0004BBr 1  99 00 07       sta SCREEN + $0300,y
0004BEr 1  B1 rr          lda (Ptr1),y
0004C0r 1  99 00 DB       sta COLRAM + $0300,y
0004C3r 1  C8             iny
0004C4r 1  C0 E8          cpy #232                      ; 1000 - 768
0004C6r 1  D0 F1          bne @Page3
0004C8r 1  60             rts
0004C9r 1               
0004C9r 1               ; -----------------------------------------------------------------------------
0004C9r 1               ;   HalReadInput — joystick port 2, folded into the abstract active-high mask
0004C9r 1               ;   Port 1 shares the keyboard matrix, so only port 2 is supported. Keyboard
0004C9r 1               ;   is TODO: the KERNAL scanner is off, so it means scanning $DC00/$DC01
0004C9r 1               ;   directly.
0004C9r 1               ; -----------------------------------------------------------------------------
0004C9r 1               HalReadInput:
0004C9r 1  AD 00 DC       lda $DC00                     ; Active low: bit0 U, 1 D, 2 L, 3 R, 4 fire
0004CCr 1  49 FF          eor #$FF
0004CEr 1  29 1F          and #$1F
0004D0r 1  85 rr          sta Tmp0
0004D2r 1               
0004D2r 1  A9 00          lda #0
0004D4r 1  85 rr          sta Tmp1
0004D6r 1               
0004D6r 1  A5 rr          lda Tmp0
0004D8r 1  29 01          and #%00000001                  ; U
0004DAr 1  F0 06          beq @NoUp
0004DCr 1  A5 rr          lda Tmp1
0004DEr 1  09 01          ora #INPUT_UP
0004E0r 1  85 rr          sta Tmp1
0004E2r 1               @NoUp:
0004E2r 1  A5 rr          lda Tmp0
0004E4r 1  29 02          and #%00000010                  ; D
0004E6r 1  F0 06          beq @NoDown
0004E8r 1  A5 rr          lda Tmp1
0004EAr 1  09 02          ora #INPUT_DOWN
0004ECr 1  85 rr          sta Tmp1
0004EEr 1               @NoDown:
0004EEr 1  A5 rr          lda Tmp0
0004F0r 1  29 04          and #%00000100                  ; L
0004F2r 1  F0 06          beq @NoLeft
0004F4r 1  A5 rr          lda Tmp1
0004F6r 1  09 04          ora #INPUT_LEFT
0004F8r 1  85 rr          sta Tmp1
0004FAr 1               @NoLeft:
0004FAr 1  A5 rr          lda Tmp0
0004FCr 1  29 08          and #%00001000                  ; R
0004FEr 1  F0 06          beq @NoRight
000500r 1  A5 rr          lda Tmp1
000502r 1  09 08          ora #INPUT_RIGHT
000504r 1  85 rr          sta Tmp1
000506r 1               @NoRight:
000506r 1  A5 rr          lda Tmp0
000508r 1  29 10          and #%00010000                  ; fire
00050Ar 1  F0 06          beq @NoFire
00050Cr 1  A5 rr          lda Tmp1
00050Er 1  09 10          ora #INPUT_FIRE
000510r 1  85 rr          sta Tmp1
000512r 1               @NoFire:
000512r 1               
000512r 1  A5 rr          lda Tmp1
000514r 1  60             rts
000515r 1               
000515r 1               ; -----------------------------------------------------------------------------
000515r 1               ;   HalDetectRegion — PAL has 312 raster lines, NTSC 263
000515r 1               ;   Both overflow $D012, so sample it only while $D011 bit 7 (raster bit 8) is
000515r 1               ;   set: PAL climbs to $37 up there, NTSC only to about $06.
000515r 1               ; -----------------------------------------------------------------------------
000515r 1               HalDetectRegion:
000515r 1  A9 00          lda #0
000517r 1  85 rr          sta Tmp0                      ; Highest high-page line seen
000519r 1  A2 00          ldx #0
00051Br 1  A0 00          ldy #0
00051Dr 1               @Sample:
00051Dr 1  AD 11 D0       lda VIC_CTRL1
000520r 1  10 09          bpl @Next                     ; Raster bit 8 clear — not the range we want
000522r 1  AD 12 D0       lda VIC_RASTER
000525r 1  C5 rr          cmp Tmp0
000527r 1  90 02          bcc @Next
000529r 1  85 rr          sta Tmp0
00052Br 1               @Next:
00052Br 1  C8             iny
00052Cr 1  D0 EF          bne @Sample
00052Er 1  E8             inx
00052Fr 1  E0 40          cpx #64                       ; 16384 samples — comfortably over one frame
000531r 1  D0 EA          bne @Sample
000533r 1               
000533r 1  A5 rr          lda Tmp0
000535r 1  C9 20          cmp #$20
000537r 1  90 03          bcc @Ntsc
000539r 1  A9 01          lda #1                        ; PAL
00053Br 1  60             rts
00053Cr 1               @Ntsc:
00053Cr 1  A9 00          lda #0
00053Er 1  60             rts
00053Fr 1               
00053Fr 1               ; -----------------------------------------------------------------------------
00053Fr 1               ;   HalSfx — TODO: SID at $D400. Shares a driver with the AC6502's $9800.
00053Fr 1               ; -----------------------------------------------------------------------------
00053Fr 1               HalSfx:
00053Fr 1  60             rts
000540r 1               
000540r 1               ; =============================================================================
000540r 1               ;   Data
000540r 1               ; =============================================================================
000540r 1               
000540r 1               .segment "RODATA"
000000r 1               
000000r 1               .include "../data/tilecolor-c64.inc"
000000r 2               ; =============================================================================
000000r 2               ;   tilecolor-c64.inc — C64 tile -> colour RAM table
000000r 2               ; =============================================================================
000000r 2               ;   Generated from SPEC.md section 4.3 and Appendix A. Spec-derived data, not
000000r 2               ;   artwork: edit this file by hand, it is never overwritten by an editor
000000r 2               ;   export. Tile groups 16-31 (tiles 128-255) are the margin artwork and their
000000r 2               ;   colours are the artist's to choose.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               
000000r 2               ;   256 bytes, indexed by tile number. Render is:
000000r 2               ;       SCREEN,x = tile   /   COLRAM,x = TileColor,tile
000000r 2               ;   C64: all 16 colours available. Groups 0-15 match the VIC-20
000000r 2               ;   table except where the VIC has no equivalent (gray).
000000r 2               
000000r 2               TileColorC64:
000000r 2  01 01 01 01    .res 8, $01                      ; tiles   0-7    group 0  UI / well frame        white
000004r 2  01 01 01 01  
000008r 2  0F 0F 0F 0F    .res 8, $0F                      ; tiles   8-15   group 1  UI accents             gray
00000Cr 2  0F 0F 0F 0F  
000010r 2  01 01 01 01    .res 8, $01                      ; tiles  16-23   group 2  Font  0 1 2 3 4 5 6 7  white
000014r 2  01 01 01 01  
000018r 2  01 01 01 01    .res 8, $01                      ; tiles  24-31   group 3  Font  8 9 A B C D E F  white
00001Cr 2  01 01 01 01  
000020r 2  01 01 01 01    .res 8, $01                      ; tiles  32-39   group 4  Font  G H I J K L M N  white
000024r 2  01 01 01 01  
000028r 2  01 01 01 01    .res 8, $01                      ; tiles  40-47   group 5  Font  O P Q R S T U V  white
00002Cr 2  01 01 01 01  
000030r 2  01 01 01 01    .res 8, $01                      ; tiles  48-55   group 6  Font  W X Y Z . x ! -  white
000034r 2  01 01 01 01  
000038r 2  01 01 01 01    .res 8, $01                      ; tiles  56-63   group 7  VFX                    white
00003Cr 2  01 01 01 01  
000040r 2  02 02 02 02    .res 8, $02                      ; tiles  64-71   group 8  POTION 0  RED
000044r 2  02 02 02 02  
000048r 2  07 07 07 07    .res 8, $07                      ; tiles  72-79   group 9  POTION 1  YELLOW
00004Cr 2  07 07 07 07  
000050r 2  05 05 05 05    .res 8, $05                      ; tiles  80-87   group 10 POTION 2  GREEN
000054r 2  05 05 05 05  
000058r 2  03 03 03 03    .res 8, $03                      ; tiles  88-95   group 11 POTION 3  CYAN
00005Cr 2  03 03 03 03  
000060r 2  06 06 06 06    .res 8, $06                      ; tiles  96-103  group 12 POTION 4  BLUE
000064r 2  06 06 06 06  
000068r 2  04 04 04 04    .res 8, $04                      ; tiles 104-111  group 13 POTION 5  PURPLE
00006Cr 2  04 04 04 04  
000070r 2  01 01 01 01    .res 8, $01                      ; tiles 112-119  group 14 POTION 6  WILD / prism white
000074r 2  01 01 01 01  
000078r 2  02 02 02 02    .res 8, $02                      ; tiles 120-127  group 15 Wall / stone           red
00007Cr 2  02 02 02 02  
000080r 2  0F 0F 0F 0F    .res 8, $0F                      ; tiles 128-135  group 16 artwork
000084r 2  0F 0F 0F 0F  
000088r 2  09 09 09 09    .res 8, $09                      ; tiles 136-143  group 17 artwork
00008Cr 2  09 09 09 09  
000090r 2  0C 0C 0C 0C    .res 8, $0C                      ; tiles 144-151  group 18 artwork
000094r 2  0C 0C 0C 0C  
000098r 2  08 08 08 08    .res 8, $08                      ; tiles 152-159  group 19 artwork
00009Cr 2  08 08 08 08  
0000A0r 2  0B 0B 0B 0B    .res 8, $0B                      ; tiles 160-167  group 20 artwork
0000A4r 2  0B 0B 0B 0B  
0000A8r 2  0D 0D 0D 0D    .res 8, $0D                      ; tiles 168-175  group 21 artwork
0000ACr 2  0D 0D 0D 0D  
0000B0r 2  0A 0A 0A 0A    .res 8, $0A                      ; tiles 176-183  group 22 artwork
0000B4r 2  0A 0A 0A 0A  
0000B8r 2  03 03 03 03    .res 8, $03                      ; tiles 184-191  group 23 artwork
0000BCr 2  03 03 03 03  
0000C0r 2  07 07 07 07    .res 8, $07                      ; tiles 192-199  group 24 artwork
0000C4r 2  07 07 07 07  
0000C8r 2  0E 0E 0E 0E    .res 8, $0E                      ; tiles 200-207  group 25 artwork
0000CCr 2  0E 0E 0E 0E  
0000D0r 2  04 04 04 04    .res 8, $04                      ; tiles 208-215  group 26 artwork
0000D4r 2  04 04 04 04  
0000D8r 2  05 05 05 05    .res 8, $05                      ; tiles 216-223  group 27 artwork
0000DCr 2  05 05 05 05  
0000E0r 2  02 02 02 02    .res 8, $02                      ; tiles 224-231  group 28 artwork
0000E4r 2  02 02 02 02  
0000E8r 2  01 01 01 01    .res 8, $01                      ; tiles 232-239  group 29 artwork
0000ECr 2  01 01 01 01  
0000F0r 2  0F 0F 0F 0F    .res 8, $0F                      ; tiles 240-247  group 30 artwork
0000F4r 2  0F 0F 0F 0F  
0000F8r 2  01 01 01 01    .res 8, $01                      ; tiles 248-255  group 31 artwork
0000FCr 2  01 01 01 01  
000100r 2               
000100r 1               .include "../src/strings.inc"
000100r 2               ; =============================================================================
000100r 2               ;   strings.inc — Wizards Lab, tile-encoded text
000100r 2               ; =============================================================================
000100r 2               ;   Strings are stored as TILE numbers, not ASCII, terminated by TEXT_END, so
000100r 2               ;   TextDraw is a copy with no translation at run time (see text.asm). The
000100r 2               ;   translation happens here instead, at assembly time, in TileStr.
000100r 2               ;
000100r 2               ;   Hand-authored, never overwritten by an editor export (D3). Included once,
000100r 2               ;   from each platform's RODATA segment.
000100r 2               ; =============================================================================
000100r 2               
000100r 2               ; -----------------------------------------------------------------------------
000100r 2               ;   TileChar / TileStr — ASCII source, tile bytes out
000100r 2               ;   The font is forty glyphs in one run from FONT_BASE:
000100r 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
000100r 2               ;   and a space is TILE_BLANK. Anything else is not in the tileset and is an
000100r 2               ;   assembly error rather than a wrong glyph on the screen.
000100r 2               ; -----------------------------------------------------------------------------
000100r 2               .macro TileChar c
000100r 2                 .if c = ' '
000100r 2                   .byte TILE_BLANK
000100r 2                 .elseif (c >= '0') .and (c <= '9')
000100r 2                   .byte FONT_DIGIT_0 + (c - '0')
000100r 2                 .elseif (c >= 'A') .and (c <= 'Z')
000100r 2                   .byte FONT_LETTER_A + (c - 'A')
000100r 2                 .elseif c = '.'
000100r 2                   .byte FONT_DOT
000100r 2                 .elseif c = 'x'
000100r 2                   .byte FONT_TIMES
000100r 2                 .elseif c = '!'
000100r 2                   .byte FONT_BANG
000100r 2                 .elseif c = '~'
000100r 2                   .byte FONT_TILDE
000100r 2                 .else
000100r 2                   .error "strings.inc: no tile for this character"
000100r 2                 .endif
000100r 2               .endmacro
000100r 2               
000100r 2               .macro TileStr s
000100r 2                 .repeat .strlen(s), I
000100r 2                   TileChar {.strat(s, I)}
000100r 2                 .endrepeat
000100r 2                 .byte TEXT_END
000100r 2               .endmacro
000100r 2               
000100r 2               ; -----------------------------------------------------------------------------
000100r 2               ;   Banners — SPEC 12.2, 13.3
000100r 2               ;   Even length, so (PANEL_W - length) / 2 centres exactly. The band is 18
000100r 2               ;   cells of backdrop between two shelf tiles either side, so a banner has 18
000100r 2               ;   to play with before it starts overwriting the artwork.
000100r 2               ;
000100r 2               ;   MsgPaused matches the play screen image byte for byte on purpose: the
000100r 2               ;   artwork ships with the band already reading `~~ PAUSED ~~` (see SPEC 12.1),
000100r 2               ;   so entering play clears the band and pausing draws this straight back.
000100r 2               ; -----------------------------------------------------------------------------
000100r 2               MsgPaused:
000100r 2  37 37 00 29    TileStr "~~ PAUSED ~~"                 ; 12 cells, centres at panel column 5
000104r 2  1A 2E 2C 1E  
000108r 2  1D 00 37 37  
00010Dr 2               
00010Dr 2               MsgLevelUp:
00010Dr 2  37 37 00 25    TileStr "~~ LEVEL UP ~~"               ; 14 cells, centres at panel column 4
000111r 2  1E 2F 1E 25  
000115r 2  00 2E 29 00  
00011Cr 2               
00011Cr 1               
00011Cr 1               ; --- Screen row start addresses ----------------------------------------------
00011Cr 1               RowLo:
00011Cr 1  00 28 50 78    .repeat SCR_ROWS, i
000120r 1  A0 C8 F0 18  
000124r 1  40 68 90 B8  
000135r 1                   .byte <(SCREEN + i * SCR_COLS)
000135r 1                 .endrepeat
000135r 1               RowHi:
000135r 1  04 04 04 04    .repeat SCR_ROWS, i
000139r 1  04 04 04 05  
00013Dr 1  05 05 05 05  
00014Er 1                   .byte >(SCREEN + i * SCR_COLS)
00014Er 1                 .endrepeat
00014Er 1               
00014Er 1               .segment "TILES"
000000r 1               
000000r 1               ; --- PLACEHOLDER ART — see data/README.md ------------------------------------
000000r 1  00 00 00 00  Tileset:      .incbin "../data/tileset.bin"
000004r 1  00 00 00 00  
000008r 1  00 00 7E AB  
000800r 1  00 00 00 00  TitleScreen:  .incbin "../data/screen-title-c64.bin"
000804r 1  00 00 00 00  
000808r 1  00 00 00 00  
000BE8r 1  01 01 01 01  TitleColor:   .incbin "../data/screen-title-c64-color.bin"
000BECr 1  01 01 01 01  
000BF0r 1  01 01 01 01  
000FD0r 1  7F 7F 7F 7F  PlayScreen:   .incbin "../data/screen-play-c64.bin"
000FD4r 1  7F 7F 7F 7F  
000FD8r 1  7F 7E 7E 7E  
0013B8r 1  02 02 02 02  PlayColor:    .incbin "../data/screen-play-c64-color.bin"
0013BCr 1  02 02 02 02  
0013C0r 1  02 02 02 02  
0013B8r 1               
