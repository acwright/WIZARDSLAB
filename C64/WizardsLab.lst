0001DBr 2  5C           
0001DCr 2               
0001DCr 2               ; --- Reagent type, cumulative thresholds out of 256 (SPEC 5.3) ---------------
0001DCr 2               ;   Four thresholds per band; a roll at or above the last one is a Prism.
0001DCr 2               ;       roll <  [0] -> Fireball
0001DCr 2               ;       roll <  [1] -> Bolt
0001DCr 2               ;       roll <  [2] -> Bomb
0001DCr 2               ;       roll <  [3] -> Star
0001DCr 2               ;       else        -> Prism
0001DCr 2               ReagentThresholds:
0001DCr 2  4D 8A C3 EC    .byte  77, 138, 195, 236             ; band 0   levels  1-3
0001E0r 2  4D 8D C0 EE    .byte  77, 141, 192, 238             ; band 1   levels  4-6
0001E4r 2  52 92 C5 EE    .byte  82, 146, 197, 238             ; band 2   levels  7-9
0001E8r 2  4F 8D C3 EE    .byte  79, 141, 195, 238             ; band 3   levels 10-12
0001ECr 2  4F 8F C7 F0    .byte  79, 143, 199, 240             ; band 4   levels 13+
0001F0r 2               
0001F0r 2               ; --- Reagent trigger bonuses, indexed by glyph (SPEC 9.5) --------------------
0001F0r 2               ;   Glyph 0 potion and 4 star award nothing here (the star multiplies instead).
0001F0r 2               TriggerBonusLo:
0001F0r 2  00 00 00 00    .byte $00, $00, $00, $00, $00, $00, $00, $00
0001F4r 2  00 00 00 00  
0001F8r 2               TriggerBonusHi:
0001F8r 2  00 05 03 03    .byte $00, $05, $03, $03, $00, $00, $00, $00
0001FCr 2  00 00 00 00  
000200r 2               
000200r 2               ; --- The twelve sound effects (SPEC 16) --------------------------------------
000200r 2               ;   An effect is a list of STEPS and a step is three bytes: how many FRAMES it
000200r 2               ;   lasts, its TIMBRE, and its NOTE in semitones above C3 (constants.inc). A
000200r 2               ;   zero frame count ends the list. Nothing here is a register value: a note
000200r 2               ;   means the same pitch on both sound chips and each platform turns it into
000200r 2               ;   whatever its own hardware wants (audio.asm, hal.inc).
000200r 2               ;
000200r 2               ;   SPEC 16 gives each effect a CHARACTER and not a tune — "short blip",
000200r 2               ;   "dull thunk", "descending noise sweep" — and the notes below are the
000200r 2               ;   reading of it. What is not a choice is the range: the VIC-I's oscillator
000200r 2               ;   value runs out of resolution above C5, where consecutive semitones start
000200r 2               ;   landing on the same number, so everything melodic is WRITTEN inside C3-C5
000200r 2               ;   and lifted by its timbre instead. TIMBRE_BRIGHT is already an octave up.
000200r 2               ;
000200r 2               ;   SfxStepIdx is a byte offset into SfxSteps, so this table has to stay under
000200r 2               ;   256 bytes. It is 196 — 144 for SPEC 16's twelve, 25 for the thirteenth that
000200r 2               ;   starts a game, and 27 for the three at the bottom that belong to the title
000200r 2               ;   screen's ambience rather than to the game (constants.inc, ambience.asm).
000200r 2               
000200r 2               SfxOffsets:                             ; Indexed by (SFX_* id - 1)
000200r 2  00             .byte SfxMove     - SfxSteps
000201r 2  04             .byte SfxRotate   - SfxSteps
000202r 2  0B             .byte SfxLock     - SfxSteps
000203r 2  12             .byte SfxMatch    - SfxSteps
000204r 2  19             .byte SfxFireball - SfxSteps
000205r 2  29             .byte SfxBolt     - SfxSteps
000206r 2  2D             .byte SfxBomb     - SfxSteps
000207r 2  34             .byte SfxStar     - SfxSteps
000208r 2  41             .byte SfxPrism    - SfxSteps
000209r 2  54             .byte SfxLevelUp  - SfxSteps
00020Ar 2  61             .byte SfxHighScore- SfxSteps
00020Br 2  77             .byte SfxGameOver - SfxSteps
00020Cr 2  90             .byte SfxStart    - SfxSteps          ; 13 is an event SPEC 16 does not have
00020Dr 2  A9             .byte SfxBubble   - SfxSteps          ; 14-16 are the title screen's, and are
00020Er 2  B3             .byte SfxGloop    - SfxSteps          ;   not events — see the ambience at the
00020Fr 2  BA             .byte SfxSeethe   - SfxSteps          ;   bottom of this file
000210r 2               
000210r 2               SfxSteps:
000210r 2               
000210r 2               SfxMove:                                ; 1 — short blip                2 frames
000210r 2  02 03 13       .byte  2, TIMBRE_BRIGHT, OCT_4 + SEMI_G
000213r 2  00             .byte  0
000214r 2               
000214r 2               SfxRotate:                              ; 2 — rising two-step           6 frames
000214r 2  03 03 0C       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_C
000217r 2  03 03 13       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_G
00021Ar 2  00             .byte  0
00021Br 2               
00021Br 2               SfxLock:                                ; 3 — dull thunk                6 frames
00021Br 2  02 04 0C       .byte  2, TIMBRE_NOISE,  OCT_4 + SEMI_C
00021Er 2  04 01 0C       .byte  4, TIMBRE_SOFT,   OCT_4 + SEMI_C
000221r 2  00             .byte  0
000222r 2               
000222r 2               SfxMatch:                               ; 4 — bright chime              9 frames
000222r 2  03 03 0C       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_C   ; ...and the whole thing is
000225r 2  06 03 10       .byte  6, TIMBRE_BRIGHT, OCT_4 + SEMI_E   ;   transposed up by the chain
000228r 2  00             .byte  0                                  ;   (SPEC 16, audio.asm)
000229r 2               
000229r 2               SfxFireball:                            ; 5 — descending noise sweep   10 frames
000229r 2  02 04 24       .byte  2, TIMBRE_NOISE,  OCT_6 + SEMI_C
00022Cr 2  02 04 1F       .byte  2, TIMBRE_NOISE,  OCT_5 + SEMI_G
00022Fr 2  02 04 1A       .byte  2, TIMBRE_NOISE,  OCT_5 + SEMI_D
000232r 2  02 04 15       .byte  2, TIMBRE_NOISE,  OCT_4 + SEMI_A
000235r 2  02 04 10       .byte  2, TIMBRE_NOISE,  OCT_4 + SEMI_E
000238r 2  00             .byte  0
000239r 2               
000239r 2               SfxBolt:                                ; 6 — fast noise crack          3 frames
000239r 2  03 04 21       .byte  3, TIMBRE_NOISE,  OCT_5 + SEMI_A
00023Cr 2  00             .byte  0
00023Dr 2               
00023Dr 2               SfxBomb:                                ; 7 — low noise thump          10 frames
00023Dr 2  02 04 0E       .byte  2, TIMBRE_NOISE,  OCT_4 + SEMI_D
000240r 2  08 04 04       .byte  8, TIMBRE_NOISE,  OCT_3 + SEMI_E
000243r 2  00             .byte  0
000244r 2               
000244r 2               SfxStar:                                ; 8 — sparkle arpeggio          8 frames
000244r 2  02 03 0C       .byte  2, TIMBRE_BRIGHT, OCT_4 + SEMI_C
000247r 2  02 03 10       .byte  2, TIMBRE_BRIGHT, OCT_4 + SEMI_E
00024Ar 2  02 03 13       .byte  2, TIMBRE_BRIGHT, OCT_4 + SEMI_G
00024Dr 2  02 03 18       .byte  2, TIMBRE_BRIGHT, OCT_5 + SEMI_C
000250r 2  00             .byte  0
000251r 2               
000251r 2               SfxPrism:                               ; 9 — shimmer                  12 frames
000251r 2  02 02 18       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_C   ; The one effect that wants an edge
000254r 2  02 02 1C       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_E   ;   to it rather than a bell: a
000257r 2  02 02 18       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_C   ;   sawtooth beating between two
00025Ar 2  02 02 1C       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_E   ;   notes six times in a fifth of
00025Dr 2  02 02 18       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_C   ;   a second
000260r 2  02 02 1C       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_E
000263r 2  00             .byte  0
000264r 2               
000264r 2               SfxLevelUp:                             ; 10 — fanfare                 25 frames
000264r 2  05 03 0C       .byte  5, TIMBRE_BRIGHT, OCT_4 + SEMI_C
000267r 2  05 03 10       .byte  5, TIMBRE_BRIGHT, OCT_4 + SEMI_E
00026Ar 2  05 03 13       .byte  5, TIMBRE_BRIGHT, OCT_4 + SEMI_G
00026Dr 2  0A 03 18       .byte 10, TIMBRE_BRIGHT, OCT_5 + SEMI_C
000270r 2  00             .byte  0
000271r 2               
000271r 2               SfxHighScore:                           ; 11 — longer fanfare          40 frames
000271r 2  04 03 0C       .byte  4, TIMBRE_BRIGHT, OCT_4 + SEMI_C
000274r 2  04 03 10       .byte  4, TIMBRE_BRIGHT, OCT_4 + SEMI_E
000277r 2  04 03 13       .byte  4, TIMBRE_BRIGHT, OCT_4 + SEMI_G
00027Ar 2  04 03 18       .byte  4, TIMBRE_BRIGHT, OCT_5 + SEMI_C
00027Dr 2  04 03 13       .byte  4, TIMBRE_BRIGHT, OCT_4 + SEMI_G
000280r 2  04 03 18       .byte  4, TIMBRE_BRIGHT, OCT_5 + SEMI_C
000283r 2  10 03 1C       .byte 16, TIMBRE_BRIGHT, OCT_5 + SEMI_E
000286r 2  00             .byte  0
000287r 2               
000287r 2               SfxGameOver:                            ; 12 — descending minor run    58 frames
000287r 2  06 01 15       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_A
00028Ar 2  06 01 13       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_G
00028Dr 2  06 01 11       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_F
000290r 2  06 01 10       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_E
000293r 2  06 01 0E       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_D
000296r 2  06 01 0C       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_C
000299r 2  06 01 0B       .byte  6, TIMBRE_SOFT,   OCT_3 + SEMI_B
00029Cr 2  10 01 09       .byte 16, TIMBRE_SOFT,   OCT_3 + SEMI_A
00029Fr 2  00             .byte  0
0002A0r 2               
0002A0r 2               ; --- ...and the thirteenth, which is that one backwards ----------------------
0002A0r 2               ;   The game announcing itself (constants.inc). SPEC 16 has no such effect and
0002A0r 2               ;   the game had no sound at all for the transition that matters most: the
0002A0r 2               ;   screen changes, a piece is already falling, and nothing says so.
0002A0r 2               ;
0002A0r 2               ;   It is the GAME-OVER RUN CLIMBED — the same eight notes of A minor in the
0002A0r 2               ;   other order, so the game opens with the phrase that will close it, played
0002A0r 2               ;   backwards. Two things about it are not mirrored, and both are the point:
0002A0r 2               ;
0002A0r 2               ;     BRIGHT, not SOFT. A timbre is a voice and an octave (constants.inc), so
0002A0r 2               ;     the same written notes come out two octaves above the game-over run
0002A0r 2               ;     rather than beside it. The contour is the quotation; the colour is what
0002A0r 2               ;     says which end of the game you are at.
0002A0r 2               ;
0002A0r 2               ;     THREE FRAMES A STEP, not six. A loss is allowed to take its time because
0002A0r 2               ;     nothing is happening afterwards. A start is not: the first piece is
0002A0r 2               ;     already falling while this plays, and 33 frames is about as long as a
0002A0r 2               ;     sound can hold the top of a screen the player has started using.
0002A0r 2               ;
0002A0r 2               ;   A scale and not an arpeggio, which is what keeps it clear of the two
0002A0r 2               ;   fanfares above — those leap, this walks.
0002A0r 2               
0002A0r 2               SfxStart:                               ; 13 — the run, climbed       33 frames
0002A0r 2  03 03 09       .byte  3, TIMBRE_BRIGHT, OCT_3 + SEMI_A
0002A3r 2  03 03 0B       .byte  3, TIMBRE_BRIGHT, OCT_3 + SEMI_B
0002A6r 2  03 03 0C       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_C
0002A9r 2  03 03 0E       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_D
0002ACr 2  03 03 10       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_E
0002AFr 2  03 03 11       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_F
0002B2r 2  03 03 13       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_G
0002B5r 2  0C 03 15       .byte 12, TIMBRE_BRIGHT, OCT_4 + SEMI_A   ; ...and arrives, rather than
0002B8r 2  00             .byte  0                                  ;   stopping
0002B9r 2               
0002B9r 2               ; --- The cauldron (constants.inc) --------------------------------------------
0002B9r 2               ;   Three more step lists, in the same table and read by the same driver, and
0002B9r 2               ;   the only things about them that are not effects are that no event asks for
0002B9r 2               ;   one and that the ambience pitches each one up by a random 0-7 semitones
0002B9r 2               ;   before it plays. That transposition is what turns three lists into a boil:
0002B9r 2               ;   a bubble is a bubble whatever size it is, and a cauldron of one size sounds
0002B9r 2               ;   like a machine.
0002B9r 2               ;
0002B9r 2               ;   All three are TIMBRE_SOFT or TIMBRE_NOISE and all three are written in the
0002B9r 2               ;   bottom octave and a half, because everything up here has to sit UNDER the
0002B9r 2               ;   title screen rather than on top of it. Nothing bright bubbles.
0002B9r 2               
0002B9r 2               SfxBubble:                              ; 13 — a bloop, rising      8 frames
0002B9r 2  03 01 0C       .byte  3, TIMBRE_SOFT,   OCT_4 + SEMI_C   ; TIMBRE_SOFT sounds an octave
0002BCr 2  03 01 13       .byte  3, TIMBRE_SOFT,   OCT_4 + SEMI_G   ;   below what is written, so this
0002BFr 2  02 01 18       .byte  2, TIMBRE_SOFT,   OCT_5 + SEMI_C   ;   is C3 to C4 (constants.inc)
0002C2r 2  00             .byte  0
0002C3r 2               
0002C3r 2               SfxGloop:                               ; 14 — a heavier one, falling  6 frames
0002C3r 2  02 01 13       .byte  2, TIMBRE_SOFT,   OCT_4 + SEMI_G
0002C6r 2  04 01 0C       .byte  4, TIMBRE_SOFT,   OCT_4 + SEMI_C
0002C9r 2  00             .byte  0
0002CAr 2               
0002CAr 2               SfxSeethe:                              ; 15 — the churn under both    9 frames
0002CAr 2  03 04 07       .byte  3, TIMBRE_NOISE,  OCT_3 + SEMI_G   ; Low noise, dropping: the sound a
0002CDr 2  04 04 00       .byte  4, TIMBRE_NOISE,  OCT_3 + SEMI_C   ;   pot makes between bubbles
0002D0r 2  02 00 00       .byte  2, TIMBRE_OFF,    0                ; A REST, and a legal step — the
0002D3r 2  00             .byte  0                                  ;   driver hands TIMBRE_OFF to the
0002D4r 2                                                           ;   platform like any other timbre
0002D4r 2                                                           ;   and gets silence for a beat,
0002D4r 2                                                           ;   which keeps the churn from
0002D4r 2                                                           ;   running straight into whatever
0002D4r 2                                                           ;   the next roll deals
0002D4r 2               
0002D4r 2               ; --- The mix (ambience.asm) --------------------------------------------------
0002D4r 2               ;   Rolled once per sound, indexed by five random bits, so the shape of the
0002D4r 2               ;   ambience is this table and nothing else: twenty-seven bubbles of one kind
0002D4r 2               ;   or another to five borrowed effects, which is one thing happening in the
0002D4r 2               ;   lab for every five or six the cauldron does. Change the balance by changing
0002D4r 2               ;   the entries — there is no other knob and no code to edit.
0002D4r 2               ;
0002D4r 2               ;   THIRTY-TWO ROWS AND NOT SIXTEEN, which is the whole of how the borrowed
0002D4r 2               ;   effects were halved after the first version came out too busy: the five of
0002D4r 2               ;   them are the same five, spread over twice as many rolls. Doing it the other
0002D4r 2               ;   way — dropping two or three of the five from a sixteen-row table — would
0002D4r 2               ;   have changed which sounds the lab makes as well as how often it makes one,
0002D4r 2               ;   and the mix among them was not the problem.
0002D4r 2               ;
0002D4r 2               ;   The five borrowed ones are the game's own sounds (SPEC 16), played half
0002D4r 2               ;   volume and out of context: the prism's shimmer and the star's arpeggio read
0002D4r 2               ;   as apparatus, the bolt's crack as a spark somewhere off to the side, the
0002D4r 2               ;   lock's thunk as something heavy being set down, and the match chime as a
0002D4r 2               ;   phial being touched. Nothing louder than those — a game-over run drifting
0002D4r 2               ;   past the title screen would sound like a fault, not a laboratory.
0002D4r 2               ;
0002D4r 2               ;   Position means nothing here; only the counts do. Every roll is independent,
0002D4r 2               ;   so the five are spread out to be read rather than to be heard that way.
0002D4r 2               
0002D4r 2               AmbTable:
0002D4r 2  0E 10 0E 09    .byte SFX_BUBBLE, SFX_SEETHE, SFX_BUBBLE, SFX_PRISM
0002D8r 2  0F 0E 0E 10    .byte SFX_GLOOP,  SFX_BUBBLE, SFX_BUBBLE, SFX_SEETHE
0002DCr 2  0E 0F 06 0E    .byte SFX_BUBBLE, SFX_GLOOP,  SFX_BOLT,   SFX_BUBBLE
0002E0r 2  0F 10 0E 0E    .byte SFX_GLOOP,  SFX_SEETHE, SFX_BUBBLE, SFX_BUBBLE
0002E4r 2  04 0E 0F 0E    .byte SFX_MATCH,  SFX_BUBBLE, SFX_GLOOP,  SFX_BUBBLE
0002E8r 2  10 0E 0F 08    .byte SFX_SEETHE, SFX_BUBBLE, SFX_GLOOP,  SFX_STAR
0002ECr 2  0F 0E 10 0E    .byte SFX_GLOOP,  SFX_BUBBLE, SFX_SEETHE, SFX_BUBBLE
0002F0r 2  0E 03 0F 0E    .byte SFX_BUBBLE, SFX_LOCK,   SFX_GLOOP,  SFX_BUBBLE
0002F4r 2               
0002F4r 2               
0002F4r 1               .include "../src/strings.inc"
0002F4r 2               ; =============================================================================
0002F4r 2               ;   strings.inc — Wizards Lab, tile-encoded text
0002F4r 2               ; =============================================================================
0002F4r 2               ;   Strings are stored as TILE numbers, not ASCII, terminated by TEXT_END, so
0002F4r 2               ;   TextDraw is a copy with no translation at run time (see text.asm). The
0002F4r 2               ;   translation happens here instead, at assembly time, in TileStr.
0002F4r 2               ;
0002F4r 2               ;   Hand-authored, never overwritten by an editor export (D3). Included once,
0002F4r 2               ;   from each platform's RODATA segment.
0002F4r 2               ; =============================================================================
0002F4r 2               
0002F4r 2               ; -----------------------------------------------------------------------------
0002F4r 2               ;   TileChar / TileStr — ASCII source, tile bytes out
0002F4r 2               ;   The font is forty glyphs in one run from FONT_BASE:
0002F4r 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
0002F4r 2               ;   and a space is TILE_BLANK. Anything else is not in the tileset and is an
0002F4r 2               ;   assembly error rather than a wrong glyph on the screen.
0002F4r 2               ; -----------------------------------------------------------------------------
0002F4r 2               .macro TileChar c
0002F4r 2                 .if c = ' '
0002F4r 2                   .byte TILE_BLANK
0002F4r 2                 .elseif (c >= '0') .and (c <= '9')
0002F4r 2                   .byte FONT_DIGIT_0 + (c - '0')
0002F4r 2                 .elseif (c >= 'A') .and (c <= 'Z')
0002F4r 2                   .byte FONT_LETTER_A + (c - 'A')
0002F4r 2                 .elseif c = '.'
0002F4r 2                   .byte FONT_DOT
0002F4r 2                 .elseif c = 'x'
0002F4r 2                   .byte FONT_TIMES
0002F4r 2                 .elseif c = '!'
0002F4r 2                   .byte FONT_BANG
0002F4r 2                 .elseif c = '~'
0002F4r 2                   .byte FONT_TILDE
0002F4r 2                 .else
0002F4r 2                   .error "strings.inc: no tile for this character"
0002F4r 2                 .endif
0002F4r 2               .endmacro
0002F4r 2               
0002F4r 2               .macro TileStr s
0002F4r 2                 .repeat .strlen(s), I
0002F4r 2                   TileChar {.strat(s, I)}
0002F4r 2                 .endrepeat
0002F4r 2                 .byte TEXT_END
0002F4r 2               .endmacro
0002F4r 2               
0002F4r 2               ; -----------------------------------------------------------------------------
0002F4r 2               ;   Banners — SPEC 12.2, 13.3
0002F4r 2               ;   Even length, so (PANEL_W - length) / 2 centres exactly. The band is 18
0002F4r 2               ;   cells of backdrop between two shelf tiles either side, so a banner has 18
0002F4r 2               ;   to play with before it starts overwriting the artwork.
0002F4r 2               ;
0002F4r 2               ;   MsgPaused matches the play screen image byte for byte on purpose: the
0002F4r 2               ;   artwork ships with the band already reading `~~ PAUSED ~~` (see SPEC 12.1),
0002F4r 2               ;   so entering play clears the band and pausing draws this straight back.
0002F4r 2               ; -----------------------------------------------------------------------------
0002F4r 2               MsgPaused:
0002F4r 2  37 37 00 29    TileStr "~~ PAUSED ~~"                 ; 12 cells, centres at panel column 5
0002F8r 2  1A 2E 2C 1E  
0002FCr 2  1D 00 37 37  
000301r 2               
000301r 2               MsgLevelUp:
000301r 2  37 37 00 25    TileStr "~~ LEVEL UP ~~"               ; 14 cells, centres at panel column 4
000305r 2  1E 2F 1E 25  
000309r 2  00 2E 29 00  
000310r 2               
000310r 2               ; `GAME OVER` is nine characters, so a symmetric ornament around it is always
000310r 2               ; an ODD length and would sit half a cell left of centre. The bang makes it
000310r 2               ; even and is the reason it is there; SPEC 13.4 records the wording.
000310r 2               MsgGameOver:
000310r 2  37 37 00 20    TileStr "~~ GAME OVER! ~~"             ; 16 cells, centres at panel column 3
000314r 2  1A 26 1E 00  
000318r 2  28 2F 1E 2B  
000321r 2               
000321r 2               ; The chain banner carries a number, and TextDraw copies bytes rather than
000321r 2               ; formatting them, so the digit is a placeholder that CascadeSettle overwrites
000321r 2               ; with one RenderMark at CHAIN_DIGIT_X (constants.inc). Keeping the length at
000321r 2               ; MSG_CHAIN_LEN is what makes that column a constant instead of a measurement.
000321r 2               MsgChain:
000321r 2  37 37 00 1C    TileStr "~~ CHAIN x0 ~~"               ; 14 cells; the `0` is panel column 14
000325r 2  21 1A 22 27  
000329r 2  00 35 10 00  
000330r 2               
000330r 2               ; -----------------------------------------------------------------------------
000330r 2               ;   The title screen's prompt (SPEC 13.1)
000330r 2               ;   Not a banner: it is ten cells of the DRAWN title image, and the only reason
000330r 2               ;   the string exists at all is that blinking it means putting it back. It must
000330r 2               ;   match data/screen-title-*.bin at PROMPT_X, PROMPT_Y byte for byte, or the
000330r 2               ;   first blink would redraw the screen slightly differently from the way the
000330r 2               ;   artist drew it.
000330r 2               ; -----------------------------------------------------------------------------
000330r 2               MsgPressFire:
000330r 2  29 2B 1E 2C    TileStr "PRESS FIRE"                   ; PROMPT_LEN cells (constants.inc)
000334r 2  2C 00 1F 22  
000338r 2  2B 1E FF     
00033Br 2               
00033Br 1               
00033Br 1               ; --- Screen row start addresses ----------------------------------------------
00033Br 1               RowLo:
00033Br 1  00 28 50 78    .repeat SCR_ROWS, i
00033Fr 1  A0 C8 F0 18  
000343r 1  40 68 90 B8  
000354r 1                   .byte <(SCREEN + i * SCR_COLS)
000354r 1                 .endrepeat
000354r 1               RowHi:
000354r 1  04 04 04 04    .repeat SCR_ROWS, i
000358r 1  04 04 04 05  
00035Cr 1  05 05 05 05  
00036Dr 1                   .byte >(SCREEN + i * SCR_COLS)
00036Dr 1                 .endrepeat
00036Dr 1               
00036Dr 1               .segment "TILES"
000000r 1               
000000r 1               ; --- PLACEHOLDER ART — see data/README.md ------------------------------------
000000r 1  00 00 00 00  Tileset:      .incbin "../data/tileset.bin"
000004r 1  00 00 00 00  
000008r 1  00 00 7E AB  
000800r 1  00 00 00 00  TitleScreen:  .incbin "../data/screen-title-c64.bin"
000804r 1  00 00 00 00  
000808r 1  00 00 00 00  
000BE8r 1  01 01 01 01  TitleColor:   .incbin "../data/screen-title-c64-color.bin"
000BECr 1  01 01 01 01  
000BF0r 1  01 01 01 01  
000FD0r 1  7F 7F 7F 7F  PlayScreen:   .incbin "../data/screen-play-c64.bin"
000FD4r 1  7F 7F 7F 7F  
000FD8r 1  7F 7E 7E 7E  
0013B8r 1  02 02 02 02  PlayColor:    .incbin "../data/screen-play-c64-color.bin"
0013BCr 1  02 02 02 02  
0013C0r 1  02 02 02 02  
0013B8r 1               
