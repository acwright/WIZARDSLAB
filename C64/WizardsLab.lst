000000r 1               ; =============================================================================
000000r 1               ;   Wizards Lab — Commodore 64
000000r 1               ; =============================================================================
000000r 1               ;   A 16 K cartridge: EXROM and GAME both low, so ROML ($8000-$9FFF) and ROMH
000000r 1               ;   ($A000-$BFFF) map contiguously and the whole thing is one image.
000000r 1               ;
000000r 1               ;   The C64 is the roomiest of the three targets and gets no gameplay
000000r 1               ;   advantage for it. The 22 x 23 panel is centred at (9, 1) and the nine
000000r 1               ;   columns either side are static artwork, drawn once on entering a state and
000000r 1               ;   never touched again — so they cost tiles, not cycles.
000000r 1               ;
000000r 1               ;   Its first eight colours are numerically identical to the VIC-20's eight
000000r 1               ;   hi-res colours, so the playfield colour bytes are the same numbers on both
000000r 1               ;   machines. The upper eight are for margin artwork only.
000000r 1               ;
000000r 1               ;   No sprites. Everything is tiles, on every platform, by design.
000000r 1               ;
000000r 1               ;   Built with C64-16K.cfg.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               .include "../include/c64.inc"
000000r 2               ; C64 Include File for ca65
000000r 2               ; KERNAL routines, VIC-II, SID, and CIA registers
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; KERNAL Routines
000000r 2               ;=============================================================================
000000r 2               CHROUT          = $FFD2         ; Output character in A
000000r 2               CHRIN           = $FFCF         ; Input character
000000r 2               GETIN           = $FFE4         ; Get character from keyboard buffer
000000r 2               SCNKEY          = $FF9F         ; Scan the keyboard
000000r 2               PLOT            = $FFF0         ; Read/set cursor position
000000r 2               CLRSCR          = $E544         ; Clear the screen
000000r 2               STOP            = $FFE1         ; Test the STOP key
000000r 2               SETLFS          = $FFBA         ; Set logical file parameters
000000r 2               SETNAM          = $FFBD         ; Set filename
000000r 2               LOAD            = $FFD5         ; Load from device
000000r 2               SAVE            = $FFD8         ; Save to device
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Memory
000000r 2               ;=============================================================================
000000r 2               SCREEN          = $0400         ; Screen memory (40 x 25)
000000r 2               COLRAM          = $D800         ; Color RAM
000000r 2               BASIC_START     = $0801         ; Start of BASIC program area
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; VIC-II - Video
000000r 2               ;=============================================================================
000000r 2               VIC_SPR0X       = $D000         ; Sprite 0 X position
000000r 2               VIC_SPR0Y       = $D001         ; Sprite 0 Y position
000000r 2               VIC_SPRENA      = $D015         ; Sprite enable
000000r 2               VIC_CTRL1       = $D011         ; Control register 1
000000r 2               VIC_RASTER      = $D012         ; Raster line
000000r 2               VIC_CTRL2       = $D016         ; Control register 2
000000r 2               VIC_MEMPTR      = $D018         ; Memory pointers
000000r 2               VIC_IRR         = $D019         ; Interrupt request register
000000r 2               VIC_IMR         = $D01A         ; Interrupt mask register
000000r 2               VIC_BORDERCOL   = $D020         ; Border color
000000r 2               VIC_BGCOL0      = $D021         ; Background color 0
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; SID - Sound
000000r 2               ;=============================================================================
000000r 2               SID_V1_FREQ     = $D400         ; Voice 1 frequency
000000r 2               SID_V1_CTRL     = $D404         ; Voice 1 control
000000r 2               SID_V1_AD       = $D405         ; Voice 1 attack/decay
000000r 2               SID_V1_SR       = $D406         ; Voice 1 sustain/release
000000r 2               SID_VOLUME      = $D418         ; Volume and filter select
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; CIA - I/O
000000r 2               ;=============================================================================
000000r 2               CIA1_PRA        = $DC00         ; Port A (keyboard/joystick 2)
000000r 2               CIA1_PRB        = $DC01         ; Port B (keyboard/joystick 1)
000000r 2               CIA1_ICR        = $DC0D         ; Interrupt control
000000r 2               CIA2_PRA        = $DD00         ; Port A (VIC bank select)
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; Colors
000000r 2               ;=============================================================================
000000r 2               COL_BLACK       = 0
000000r 2               COL_WHITE       = 1
000000r 2               COL_RED         = 2
000000r 2               COL_CYAN        = 3
000000r 2               COL_PURPLE      = 4
000000r 2               COL_GREEN       = 5
000000r 2               COL_BLUE        = 6
000000r 2               COL_YELLOW      = 7
000000r 2               
000000r 2               ;=============================================================================
000000r 2               ; PETSCII Control Codes
000000r 2               ;=============================================================================
000000r 2               CHR_CLEAR       = $93           ; Clear screen
000000r 2               CHR_HOME        = $13           ; Cursor home
000000r 2               CHR_CR          = $0D           ; Carriage return
000000r 2               CHR_WHITE       = $05           ; Set text color to white
000000r 2               
000000r 1               
000000r 1               ; --- Platform constants (hal.inc) --------------------------------------------
000000r 1               SCR_COLS         = 40
000000r 1               SCR_ROWS         = 25
000000r 1               SCR_CELLS        = 1000          ; 40 x 25
000000r 1               PANEL_X             = 9             ; (40 - 22) / 2 — exact centring
000000r 1               PANEL_Y             = 0             ; Panel is 24 rows; screen row 24 is the
000000r 1                                                   ;   one spare course of margin
000000r 1               HAS_COLOR_RAM       = 1
000000r 1               COLOR_WHITE         = 1             ; The fireball flash (SPEC 4.6)
000000r 1               
000000r 1               CHARSET_RAM         = $2000         ; 2 K, VIC bank 0
000000r 1               
000000r 1               .include "../src/constants.inc"
000000r 2               ; =============================================================================
000000r 2               ;   constants.inc — Wizards Lab, shared game constants
000000r 2               ; =============================================================================
000000r 2               ;   Everything here comes straight out of SPEC.md. If a number changes there,
000000r 2               ;   it changes here, and nowhere else. Nothing in this file is platform
000000r 2               ;   specific — see the per-platform WizardsLab.asm for PANEL_X / PANEL_Y and
000000r 2               ;   the hardware addresses.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Board (SPEC 3) ----------------------------------------------------------
000000r 2               BOARD_W             = 6         ; Playfield columns
000000r 2               BOARD_H             = 16        ; Playfield rows
000000r 2               BOARD_STRIDE        = 8         ; Bytes per row — two wasted, on purpose
000000r 2               BOARD_ROWS_ALLOC    = 20        ; 16 playfield + 2 floor sentinels + 2 reserved
000000r 2               BOARD_BYTES         = BOARD_ROWS_ALLOC * BOARD_STRIDE    ; 160
000000r 2               SPAWN_COL           = 2         ; 0-indexed, left of centre
000000r 2               MATCH_MIN           = 3         ; Run length that clears
000000r 2               
000000r 2               ; --- Tile encoding (SPEC 4) --------------------------------------------------
000000r 2               ;   tile = COLOR_BASE + (color << 3) + glyph
000000r 2               ;   The board byte IS the tile index. No translation on the way to the screen.
000000r 2               TILE_EMPTY          = $00
000000r 2               TILE_WALL           = $FF
000000r 2               COLOR_BASE          = $40
000000r 2               COLOR_MASK          = $F8       ; AND this and you have the colour key
000000r 2               GLYPH_MASK          = $07
000000r 2               WILD_BASE           = $70       ; Colour 6 — the prism
000000r 2               NUM_COLORS          = 6
000000r 2               
000000r 2               COLOR_RED           = 0
000000r 2               COLOR_YELLOW        = 1
000000r 2               COLOR_GREEN         = 2
000000r 2               COLOR_CYAN          = 3
000000r 2               COLOR_BLUE          = 4
000000r 2               COLOR_PURPLE        = 5
000000r 2               COLOR_WILD          = 6
000000r 2               
000000r 2               GLYPH_POTION        = 0
000000r 2               GLYPH_FIREBALL      = 1
000000r 2               GLYPH_BOLT          = 2
000000r 2               GLYPH_BOMB          = 3
000000r 2               GLYPH_STAR          = 4
000000r 2               GLYPH_GLOW          = 6         ; Match-flash frame. Potion colours only —
000000r 2                                               ;   WILD_BASE + GLYPH_GLOW is an arrow, not a
000000r 2                                               ;   glow, so the prism never takes this path.
000000r 2                                               ;   See PRISM_BLIP below and SPEC 4.4.
000000r 2               
000000r 2               ; --- Named tiles -------------------------------------------------------------
000000r 2               TILE_BLANK          = 0
000000r 2               TILE_BAR_H          = 1
000000r 2               TILE_BAR_V          = 2
000000r 2               TILE_COR_TL         = 3
000000r 2               TILE_COR_TR         = 4
000000r 2               TILE_COR_BL         = 5
000000r 2               TILE_COR_BR         = 6
000000r 2               TILE_WASH           = 7         ; PAUSE / dim wash, white
000000r 2               FONT_BASE           = 16        ; '0'..'9' then 'A'..'Z' then . x ! ~
000000r 2               FONT_DIGIT_0        = 16
000000r 2               FONT_LETTER_A       = 26
000000r 2               FONT_DOT            = 52        ; A CENTRED dot, not a baseline period — it is
000000r 2                                               ;   also frame 0 of the removal ring below
000000r 2               FONT_TIMES          = 53
000000r 2               FONT_BANG           = 54
000000r 2               FONT_TILDE          = 55        ; The banner ornament, ~~~LIKE THIS~~~
000000r 2               TEXT_END            = $FF       ; String terminator. Shares its value with
000000r 2                                               ;   TILE_WALL, which costs nothing: no string
000000r 2                                               ;   ever contains tile 255.
000000r 2               
000000r 2               ; The removal ring (SPEC 14). One animation, used for every removal there is:
000000r 2               ; the match shatter, the bomb blast, the star. It opens outward
000000r 2               ;
000000r 2               ;       FONT_DOT -> VFX_REMOVE1 -> VFX_REMOVE2 -> VFX_REMOVE3 -> empty
000000r 2               ;
000000r 2               ; and the prism's blip-out runs the same tiles closed inward (PRISM_BLIP).
000000r 2               VFX_REMOVE1         = 56
000000r 2               VFX_REMOVE2         = 57
000000r 2               VFX_REMOVE3         = 58
000000r 2               VFX_BEAM_H          = 59        ; The bolt's row
000000r 2               VFX_BEAM_V          = 60        ; The bolt's column
000000r 2               VFX_BEAM_CROSS      = 61        ; Drawn once, at the bolt's own cell
000000r 2               ARROW_UP            = 62        ; The title screen's controls (SPEC 13.1).
000000r 2               ARROW_DOWN          = 63        ;   Up and down live in group 7, left and
000000r 2               ARROW_LEFT          = 118       ;   right in group 14 — whichever white group
000000r 2               ARROW_RIGHT         = 119       ;   had a slot spare. Nothing indexes them.
000000r 2               
000000r 2               ; Group 14 is the prism's. Slots +0..+3 are its idle rotation and +4..+5 its
000000r 2               ; blip-out; there is no glow slot (SPEC A.3).
000000r 2               PRISM_SPIN          = WILD_BASE ; Four frames, WILD_BASE + 0..3
000000r 2               PRISM_SPIN_FRAMES   = 4
000000r 2               PRISM_BLIP          = WILD_BASE + 4     ; Two frames, then VFX_REMOVE2,
000000r 2                                                       ;   VFX_REMOVE1, FONT_DOT, empty
000000r 2               
000000r 2               ; Group 15 is the stone group: the petrified glyph set at the same offsets the
000000r 2               ; potions use, so a cell petrifies into its own shape —
000000r 2               ;
000000r 2               ;       petrified = PETRIFY_BASE + (tile & GLYPH_MASK)     for glyphs 0-4
000000r 2               ;
000000r 2               ; — and then the two tiles the margins are built from.
000000r 2               PETRIFY_BASE        = 120       ; +0 potion, +1 fireball, +2 bolt,
000000r 2                                               ;   +3 bomb, +4 star
000000r 2               TILE_RESERVED       = 125       ; Held for a sixth glyph, if one is ever added
000000r 2               TILE_SHELF          = 126       ; The shelf the panel stands on
000000r 2               TILE_BRICK          = 127       ; Brick — the margin fill
000000r 2               FRAME_DIM           = 8         ; Group 1 is group 0 byte for byte, one colour
000000r 2                                               ;   quieter, so frame_tile + FRAME_DIM is any
000000r 2                                               ;   frame piece's dim twin (SPEC A.3)
000000r 2               ART_BASE            = 128       ; Groups 16-31 — one hatch in sixteen colours,
000000r 2                                               ;   the title screen's magic field (SPEC 13.1)
000000r 2               ART_TILES           = 128
000000r 2               
000000r 2               ; --- Panel geometry (SPEC 12) ------------------------------------------------
000000r 2               ;   One 22 x 24 panel, rendered identically on all three machines. PANEL_Y is
000000r 2               ;   0 everywhere; only PANEL_X differs. The panel is vertically symmetric —
000000r 2               ;   backdrop row, band row, backdrop row, eighteen rows of frame, backdrop row,
000000r 2               ;   band row, backdrop row — which is why 24 is the height. The AC6502 is the
000000r 2               ;   exact fit; the VIC-20 clips panel row 23 off the bottom and the C64 has one
000000r 2               ;   spare screen row (24) below the panel. See SPEC 12.4.
000000r 2               PANEL_W             = 22
000000r 2               PANEL_H             = 24
000000r 2               
000000r 2               WELL_ORIGIN_X       = 1         ; Panel-relative: board (0,0) lives here
000000r 2               WELL_ORIGIN_Y       = 4
000000r 2               
000000r 2               SCORE_X             = 12        ; 7 digits, cols 12-18
000000r 2               SCORE_Y             = 5
000000r 2               HIGH_X              = 12        ; 7 digits, cols 12-18
000000r 2               HIGH_Y              = 10
000000r 2               HIGHLVL_X           = 15        ; Level the high score was set on, 2 digits;
000000r 2                                               ;   the 'L' at col 14 is in the static image
000000r 2               HIGHLVL_Y           = 11
000000r 2               LEVEL_X             = 18        ; Single column: tens above units
000000r 2               LEVEL_Y             = 17        ; Tens at LEVEL_Y, units at LEVEL_Y + 1
000000r 2               NEXT_X              = 11        ; Single tile column
000000r 2               NEXT_Y              = 16        ; Cells A, B, C at NEXT_Y, +1, +2
000000r 2               MSG_X               = 2         ; The band's OWNED cells. Panel columns 0-1 and
000000r 2               MSG_W               = 18        ;   20-21 of row 22 are shelf in the static
000000r 2               MSG_Y               = 22        ;   image and code never touches them; the
000000r 2                                               ;   banner still centres on the full PANEL_W,
000000r 2                                               ;   which lands in the same place for an
000000r 2                                               ;   even-length string (SPEC 12.2).
000000r 2               
000000r 2               MSG_CHAIN_LEN       = 14        ; `~~ CHAIN x0 ~~` (strings.inc)
000000r 2               MSG_CHAIN_DIGIT     = 10        ; Where the digit sits inside it
000000r 2               CHAIN_DIGIT_X       = (PANEL_W - MSG_CHAIN_LEN) / 2 + MSG_CHAIN_DIGIT
000000r 2                                               ; TextBanner centres on PANEL_W, so the one
000000r 2                                               ;   cell the chain banner overwrites afterwards
000000r 2                                               ;   is worked out here rather than counted off
000000r 2                                               ;   the screen
000000r 2               CHAIN_MAX_SHOWN     = 9         ; One digit. A chain past 9 says 9 rather than
000000r 2                                               ;   drawing a glyph that is not a numeral
000000r 2               
000000r 2               SCORE_DIGITS        = 7         ; Always all 7 drawn, zero padded
000000r 2               LEVEL_DIGITS        = 2         ; Always zero padded — level 5 draws "0" / "5"
000000r 2               
000000r 2               ; --- Piece and timing (SPEC 5.6, 11.3, 14) -----------------------------------
000000r 2               ;   Every duration in the game is a frame count, and most of them differ
000000r 2               ;   between NTSC and PAL so that wall-clock speed matches. Those live in
000000r 2               ;   tables.inc as two-entry tables indexed by Region, not here — a constant
000000r 2               ;   that is not one number is not a constant. The ones below are the same on
000000r 2               ;   both machines.
000000r 2               LOCK_RESET_MAX      = 4         ; Horizontal moves that may reset the lock
000000r 2                                               ;   delay, per piece. Rotation never resets it.
000000r 2               FALL_FRAMES         = 2         ; Frames a row while the pile falls into the
000000r 2                                               ;   holes a clear left (SPEC 14). The one
000000r 2                                               ;   duration in the game that is the same on
000000r 2                                               ;   both regions, because SPEC 14 says so: at
000000r 2                                               ;   two frames there is nothing to round.
000000r 2               
000000r 2               ; --- Animation (SPEC 14) -----------------------------------------------------
000000r 2               ;   A clear step animates in two windows, and everything SPEC 14 lists happens
000000r 2               ;   inside one of them. A window lasts as long as the LONGEST thing in it:
000000r 2               ;
000000r 2               ;     GLOW      the matched cells' glow glyph, the bolt's beams and the
000000r 2               ;               fireball's white flash. GlowFrames, or the longer FlashFrames
000000r 2               ;               when a fireball fired (tables.inc)
000000r 2               ;     SHATTER   the removal ring, and the prism's blip-out running alongside
000000r 2               ;               it. SHATTER_STEPS ring frames, or BLIP_STEPS when a marked
000000r 2               ;               prism is winking out with them
000000r 2               ;
000000r 2               ;   The two counts below are the SAME on both regions, for the reason
000000r 2               ;   FALL_FRAMES is: they are a tile count times VFX_FRAMES, and two frames a
000000r 2               ;   tile does not round to 1.67. SPEC 14 says so.
000000r 2               VFX_FRAMES          = 2         ; Frames each tile of a removal ring holds
000000r 2               SHATTER_STEPS       = 3         ; VFX_REMOVE1..3           — 6 frames
000000r 2               BLIP_STEPS          = 5         ; PRISM_BLIP, +1, VFX_REMOVE2, VFX_REMOVE1,
000000r 2                                               ;   FONT_DOT               — 10 frames
000000r 2               PRISM_SPIN_RATE     = 8         ; Frames per idle rotation frame (SPEC 14).
000000r 2                                               ;   The only tile on the board that moves when
000000r 2                                               ;   nothing is happening
000000r 2               PETRIFY_FRAMES      = 2         ; Frames per row of the game-over petrify
000000r 2                                               ;   (SPEC 13.4). Same number as FALL_FRAMES
000000r 2                                               ;   and not the same thing, so it is its own
000000r 2                                               ;   constant
000000r 2               TINT_NONE           = $01       ; TintColor when nothing is flashing white.
000000r 2                                               ;   Every real colour key has its low three
000000r 2                                               ;   bits clear, so $01 is a value no masked
000000r 2                                               ;   tile can equal — which is what lets the
000000r 2                                               ;   Commodores' HalPlotCell test the tint with
000000r 2                                               ;   one CMP and no separate "is anything
000000r 2                                               ;   flashing at all" branch (SPEC 4.6)
000000r 2               
000000r 2               ; --- Levels (SPEC 10) --------------------------------------------------------
000000r 2               LEVEL_TILES         = 30        ; Tiles cleared per level
000000r 2               LEVEL_SPEED_CAP     = 16        ; Speed stops improving here
000000r 2               LEVEL_MAX_SHOWN     = 99
000000r 2               
000000r 2               ; --- Scoring (SPEC 9) --------------------------------------------------------
000000r 2               BONUS_FIREBALL      = $0500     ; BCD
000000r 2               BONUS_BOLT          = $0300
000000r 2               BONUS_BOMB          = $0300
000000r 2               BONUS_PRISM         = $0400
000000r 2               BONUS_LEVELUP       = $1000
000000r 2               STAR_SHIFT_CAP      = 3         ; Three doublings — x8
000000r 2               HIGH_FLASH_BLINKS   = 6         ; Half-blinks of the HIGH field when the score
000000r 2                                               ;   overtakes it (SPEC 9.8) — three dark, three
000000r 2                                               ;   lit, ending lit. At SPEC 14's 30-frame
000000r 2                                               ;   blink period that is about a second and a
000000r 2                                               ;   half, and play never stops for it.
000000r 2               SCORE_BYTES         = 4         ; 8 nibbles packed BCD; the top one stays 0,
000000r 2                                               ;   so 7 digits show and the score wraps at
000000r 2                                               ;   10,000,000.
000000r 2               HIGH_INIT_LO        = $00       ; 0010000
000000r 2               HIGH_INIT_MID       = $00
000000r 2               HIGH_INIT_HI        = $01
000000r 2               HIGH_INIT_TOP       = $00
000000r 2               
000000r 2               ; --- Reagent probability, out of 256 (SPEC 5.3) ------------------------------
000000r 2               PSPECIAL_BANDS      = 5
000000r 2               
000000r 2               ; --- Input bitmask (SPEC 11.1) -----------------------------------------------
000000r 2               ;   Active HIGH. Each platform inverts and remaps its own hardware into this.
000000r 2               INPUT_UP            = %00000001 ; Rotate forward
000000r 2               INPUT_DOWN          = %00000010 ; Soft drop
000000r 2               INPUT_LEFT          = %00000100
000000r 2               INPUT_RIGHT         = %00001000
000000r 2               INPUT_FIRE          = %00010000 ; Rotate reverse / confirm
000000r 2               INPUT_PAUSE         = %00100000
000000r 2               INPUT_MASK          = %00111111 ; Everything the game reads. Bits 6-7 are free
000000r 2                                               ;   for a platform to use as scratch inside
000000r 2                                               ;   HalReadInput, as long as it strips them.
000000r 2               
000000r 2               ; --- Game states (SPEC 13) ---------------------------------------------------
000000r 2               STATE_TITLE         = 0
000000r 2               STATE_PLAY          = 1
000000r 2               STATE_PAUSE         = 2
000000r 2               STATE_GAMEOVER      = 3
000000r 2               
000000r 2               ; --- Play sub-states (SPEC 8) ------------------------------------------------
000000r 2               PLAY_FALLING        = 0
000000r 2               PLAY_LOCKING        = 1
000000r 2               PLAY_GLOW           = 2
000000r 2               PLAY_SHATTER        = 3
000000r 2               PLAY_GRAVITY        = 4
000000r 2               PLAY_ARE            = 5
000000r 2               
000000r 2               ; --- Buffer sizes (SPEC 17.1) ------------------------------------------------
000000r 2               MARKS_BYTES         = 16        ; One byte per row, bits 0-5
000000r 2               EFFECTQ_ENTRIES     = 48        ; ONE byte each — the board index of a pending
000000r 2               EFFECTQ_BYTES       = EFFECTQ_ENTRIES   ;   detonation, and nothing else.
000000r 2                                               ;   SPEC 8 budgeted two bytes for a packed
000000r 2                                               ;   glyph/row/column, which is a copy of what
000000r 2                                               ;   the board already holds: cells are not
000000r 2                                               ;   zeroed until step 6 and the queue is drained
000000r 2                                               ;   in step 4, so the tile is still there when
000000r 2                                               ;   the effect pops and its glyph and colour are
000000r 2                                               ;   one `lda Board,x` away. Half the RAM for
000000r 2                                               ;   nothing (SPEC 17.1).
000000r 2                                               ;   A ring keeps one slot free, so 47 pending
000000r 2                                               ;   detonations. On overflow an effect is
000000r 2                                               ;   dropped rather than growing the buffer (D6);
000000r 2                                               ;   at one reagent a piece it is not reachable.
000000r 2               DIRTY_ENTRIES       = 64        ; 3 bytes each: offset lo, offset hi, tile
000000r 2               DIRTY_BYTES         = DIRTY_ENTRIES * 3
000000r 2               DIRTY_FLUSH_MAX     = 24        ; Cells pushed to the screen per frame.
000000r 2                                               ;   MEASURED, not estimated (PLAN.md S1). A
000000r 2                                               ;   flush costs 165 cycles a cell on the
000000r 2                                               ;   AC6502 and about 132 on the Commodores, so
000000r 2                                               ;   24 cells is 3965 cycles — inside vertical
000000r 2                                               ;   blank on all three, and tightest on the
000000r 2                                               ;   AC6502 at 1 MHz, whose 70 blank lines are
000000r 2                                               ;   roughly 4450. It is also a quarter of the
000000r 2                                               ;   96-cell well, so a full redraw is exactly
000000r 2                                               ;   four frames.
000000r 2                                               ;   Overrunning vblank is not dangerous on any
000000r 2                                               ;   of the three — no VRAM write spacing is
000000r 2                                               ;   anywhere near violated (S1) — it only
000000r 2                                               ;   risks a cell landing a frame late. This is
000000r 2                                               ;   a budget, not a hardware limit.
000000r 2               
000000r 1               .include "../src/zeropage.inc"
000000r 2               ; =============================================================================
000000r 2               ;   zeropage.inc — Wizards Lab, zero page allocation
000000r 2               ; =============================================================================
000000r 2               ;   The ZEROPAGE segment is placed at $40 on every platform. That window is
000000r 2               ;   free on all three:
000000r 2               ;
000000r 2               ;     AC6502   $003A-$00FF free for user programs (6502.inc memory map)
000000r 2               ;     VIC-20   all of page zero, once the cartridge stops calling the KERNAL
000000r 2               ;     C64      all of page zero EXCEPT $00/$01, which are the processor port
000000r 2               ;
000000r 2               ;   Starting at $40 clears the C64's port bytes and the AC6502's system
000000r 2               ;   scratch with room to spare, and keeps one number in three linker configs.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               .segment "ZEROPAGE"
000000r 2               
000000r 2  xx xx        Ptr1:           .res 2      ; General pointer — free across any call boundary
000002r 2  xx xx        Ptr2:           .res 2      ; General pointer
000004r 2  xx xx        SrcPtr:         .res 2      ; Block copy source
000006r 2  xx xx        DstPtr:         .res 2      ; Block copy destination
000008r 2  xx xx        ScreenPtr:      .res 2      ; Current screen row base
00000Ar 2  xx xx        ColorPtr:       .res 2      ; Current colour RAM row base (Commodore only)
00000Cr 2               
00000Cr 2  xx           RngLo:          .res 1      ; 16-bit LFSR state — never both zero
00000Dr 2  xx           RngHi:          .res 1
00000Er 2               
00000Er 2  xx           Tmp0:           .res 1      ; Scratch. Never live across a JSR.
00000Fr 2  xx           Tmp1:           .res 1
000010r 2  xx           Tmp2:           .res 1
000011r 2  xx           Tmp3:           .res 1
000012r 2               
000012r 2               ; --- The match scanner (SPEC 6.2) --------------------------------------------
000012r 2               ;   One line of one pass at a time. The cursor is a BOARD INDEX rather than a
000012r 2               ;   row and a column, because all four passes are the same walk with a
000012r 2               ;   different step: +1 horizontal, +8 vertical, +9 diagonal, +7 anti-diagonal.
000012r 2  xx           ScanIdx:        .res 1      ; Where the cursor was when a run ended: ScanLine
000013r 2                                           ;   keeps it in X and spills it only here
000013r 2  xx           ScanStep:       .res 1      ; What to add to reach the next cell of this line
000014r 2  xx           ScanColor:      .res 1      ; Colour key of the run in progress ($FF = unset)
000015r 2  xx           ScanLen:        .res 1      ; Cells in it so far, wildcards included
000016r 2  xx           ScanEnd:        .res 1      ; Walk-back cursor while a finished run is marked
000017r 2  xx           ScanTop:        .res 1      ; Row base of the top of the pile. Every pass
000018r 2                                           ;   starts there rather than at row 0, which is
000018r 2                                           ;   most of the cost of a scan (match.asm)
000018r 2               
000018r 2               ; --- Board walks that call the renderer (SPEC 8 steps 6 and 8) ---------------
000018r 2               ;   RenderCell clobbers A, X and Y, so a walk that marks what it changes
000018r 2               ;   cannot keep its cursor in a register. GravIdx also has to survive from one
000018r 2               ;   frame to the next: a row of falling is a cursor and not a bulk enqueue,
000018r 2               ;   because a full well is more cells than the dirty ring holds (D12,
000018r 2               ;   SPEC 12.6).
000018r 2  xx           GravIdx:        .res 1      ; Cell the fall is walking up from, $FF when the
000019r 2                                           ;   row is finished
000019r 2  xx           GravMoved:      .res 1      ; Non-zero if this row of falling moved anything
00001Ar 2  xx           CellCount:      .res 1      ; Cells CascadeRemove has taken off the board
00001Br 2               
00001Br 2               ; --- Reagent effects (SPEC 7.3, SPEC 8 step 4) -------------------------------
00001Br 2               ;   EffectHit marks a cell, scores it and enqueues whatever it holds, so it
00001Br 2               ;   clobbers A, X and Y — which means a walk that offers it cells cannot keep
00001Br 2               ;   its cursor in a register either. Same reason GravIdx exists, and the same
00001Br 2               ;   reason these are not Tmp0-Tmp3: those are dead across a JSR.
00001Br 2  xx           EffectIdx:      .res 1      ; The cell the walk in progress is on
00001Cr 2  xx           EffectEnd:      .res 1      ; Where it stops. The bolt's row end, or the bomb's
00001Dr 2                                           ;   last row
00001Dr 2  xx           EffectRow:      .res 1      ; First cell of the bomb's current row
00001Er 2  xx           EffectArg:      .res 1      ; What the walk is looking for: the fireball's
00001Fr 2                                           ;   colour key, or the bomb's last column
00001Fr 2               
00001Fr 2               ; --- Animation walks (SPEC 14) -----------------------------------------------
00001Fr 2               ;   The glow, the beams and the shatter all walk MARKS and mark what they find,
00001Fr 2               ;   so their cursors cannot live in registers either — RenderMark clobbers A
00001Fr 2               ;   and X. There are two of them because the beam pass NESTS: the outer walk is
00001Fr 2               ;   over the marked cells, looking for bolts, and the inner one is over the
00001Fr 2               ;   cross each bolt draws.
00001Fr 2  xx           AnimMode:       .res 1      ; Which of the four the walk is doing
000020r 2  xx           AnimIdx:        .res 1      ; Outer cursor — the marked cell being animated
000021r 2  xx           AnimCur:        .res 1      ; Inner cursor — the beam cell being drawn
000022r 2  xx           AnimEnd:        .res 1      ; Where the inner walk stops
000023r 2  xx           AnimArg:        .res 1      ; What it is drawing, or the bolt's own column
000024r 2               
000024r 2               ; --- Render and text scratch -------------------------------------------------
000024r 2               ;   These ARE live across a JSR, unlike Tmp0-Tmp3, because text.asm calls
000024r 2               ;   RenderMark once per cell and has to remember where it is. That is safe
000024r 2               ;   only because RenderMark touches nothing here: it clobbers A, X and the
000024r 2               ;   stack and nothing else (see render.asm). Do not call anything else from a
000024r 2               ;   loop that holds one of these.
000024r 2  xx           TextCol:        .res 1      ; Panel column the next glyph goes in
000025r 2  xx           TextRow:        .res 1      ; Panel row the string is drawn on
000026r 2  xx           TextIdx:        .res 1      ; Cursor within the string, or the BCD byte index
000027r 2  xx           TextByte:       .res 1      ; The BCD byte being split into two digits
000028r 2  xx           TextSkip:       .res 1      ; Non-zero while the first high nibble is skipped
000029r 2  xx           FlushLeft:      .res 1      ; Cells left in this frame's flush budget
00002Ar 2  xx           RedrawCol:      .res 1      ; Panel column of the cell being marked. Shared by
00002Br 2                                           ;   every routine that marks a run of cells in one
00002Br 2                                           ;   column, because RenderMark clobbers X.
00002Br 2               
00002Br 1               .include "../src/ram.inc"
00002Br 2               ; =============================================================================
00002Br 2               ;   ram.inc — Wizards Lab, work RAM
00002Br 2               ; =============================================================================
00002Br 2               ;   SPEC.md section 17.1. Around 530 bytes, which is what lets the whole game
00002Br 2               ;   fit the VIC-20's 1 KB of usable work RAM — the tightest of the three
00002Br 2               ;   targets, and therefore the one the layout is designed against.
00002Br 2               ;
00002Br 2               ;   Every platform places the BSS segment somewhere different (see each
00002Br 2               ;   linker config); nothing in this file cares where.
00002Br 2               ; =============================================================================
00002Br 2               
00002Br 2               .segment "BSS"
000000r 2               
000000r 2               ; --- The board (SPEC 3.2) ----------------------------------------------------
000000r 2               ;   20 rows x 8 stride. Columns 6-7 of every row and rows 16-19 entirely are
000000r 2               ;   permanent $FF sentinels, so scans walk off the edge and stop by themselves.
000000r 2               ;   Page-align it: address(row,col) = Board + (row << 3) + col.
000000r 2               .align 256
000000r 2  xx xx xx xx  Board:          .res BOARD_BYTES
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
0000A0r 2               
0000A0r 2               ; --- Match / cascade state (SPEC 6.2, 8) -------------------------------------
0000A0r 2  xx xx xx xx  Marks:          .res MARKS_BYTES        ; One byte per row, bits 0-5 = columns
0000A4r 2  xx xx xx xx  
0000A8r 2  xx xx xx xx  
0000B0r 2  xx xx xx xx  EffectQ:        .res EFFECTQ_BYTES      ; Ring of pending reagent detonations —
0000B4r 2  xx xx xx xx  
0000B8r 2  xx xx xx xx  
0000E0r 2                                                       ;   the board INDEX of each, one byte,
0000E0r 2                                                       ;   because the tile is still on the
0000E0r 2                                                       ;   board when the entry pops
0000E0r 2                                                       ;   (constants.inc, SPEC 8)
0000E0r 2  xx           EffectQHead:    .res 1
0000E1r 2  xx           EffectQTail:    .res 1
0000E2r 2  xx           RunCount:       .res 1                  ; Runs resolved in the current step
0000E3r 2  xx           ChainStep:      .res 1                  ; 1 on the first step of a cascade
0000E4r 2  xx           StarCount:      .res 1                  ; Doublings pending, capped at 3
0000E5r 2  xx           CascadeLo:      .res 1                  ; Cascade point accumulator, packed BCD
0000E6r 2  xx           CascadeMid:     .res 1
0000E7r 2  xx           CascadeHi:      .res 1
0000E8r 2               
0000E8r 2               ; --- Animation (SPEC 14) -----------------------------------------------------
0000E8r 2  xx           AnimStep:       .res 1                  ; Ring frame the shatter is showing,
0000E9r 2                                                       ;   0 .. AnimSteps - 1
0000E9r 2  xx           AnimSteps:      .res 1                  ; SHATTER_STEPS, or BLIP_STEPS when a
0000EAr 2                                                       ;   marked prism is blipping out along
0000EAr 2                                                       ;   with the rest (constants.inc)
0000EAr 2  xx           TintColor:      .res 1                  ; Colour key currently drawn WHITE — the
0000EBr 2                                                       ;   fireball flash (SPEC 4.6) — or
0000EBr 2                                                       ;   TINT_NONE. Read by HalPlotCell on
0000EBr 2                                                       ;   the Commodores and written to the
0000EBr 2                                                       ;   VDP colour table on the AC6502;
0000EBr 2                                                       ;   HalColorFlash is the only thing that
0000EBr 2                                                       ;   sets it (hal.inc)
0000EBr 2  xx           PrismFrame:     .res 1                  ; Idle rotation frame, 0-3
0000ECr 2  xx           PrismTimer:     .res 1                  ; Frames until the next one
0000EDr 2  xx           PetrifyRow:     .res 1                  ; Board row the game-over petrify is
0000EEr 2                                                       ;   working up from, $FF when it is done
0000EEr 2               
0000EEr 2               ; --- Render (SPEC 12.6) ------------------------------------------------------
0000EEr 2               ;   A ring of DIRTY_ENTRIES cells waiting to be pushed to the screen, three
0000EEr 2               ;   bytes each: SCREEN column, SCREEN row, tile. Not a 16-bit screen offset —
0000EEr 2               ;   HalPlotCell takes a column and a row (hal.inc), and every platform reaches
0000EEr 2               ;   a cell through a per-row pointer table (SPEC 12.3), so an offset would only
0000EEr 2               ;   have to be taken apart again at the far end.
0000EEr 2               ;
0000EEr 2               ;   A ring rather than a list with a resume index, because a frame that flushes
0000EEr 2               ;   its cap leaves a remainder and the next frame's marks have to go somewhere.
0000EEr 2               ;   Head and tail are BYTE offsets into Dirty, not entry numbers, so stepping
0000EEr 2               ;   one entry is an add of 3 and never a multiply.
0000EEr 2  xx xx xx xx  Dirty:          .res DIRTY_BYTES        ; screen col, screen row, tile
0000F2r 2  xx xx xx xx  
0000F6r 2  xx xx xx xx  
0001AEr 2  xx           DirtyCount:     .res 1                  ; Entries pending, 0..DIRTY_ENTRIES
0001AFr 2  xx           DirtyHead:      .res 1                  ; Byte offset of the oldest pending
0001B0r 2  xx           DirtyTail:      .res 1                  ; Byte offset the next mark goes to
0001B1r 2  xx           RedrawIdx:      .res 1                  ; Board index RenderBoardStep resumes
0001B2r 2                                                       ;   at, or $FF when no redraw is
0001B2r 2                                                       ;   outstanding
0001B2r 2               
0001B2r 2               ; --- The falling piece (SPEC 5) ----------------------------------------------
0001B2r 2  xx           PieceCol:       .res 1
0001B3r 2  xx           PieceRow:       .res 1                  ; Row of cell A (the top cell)
0001B4r 2  xx           PieceA:         .res 1                  ; Tile bytes, top to bottom
0001B5r 2  xx           PieceB:         .res 1
0001B6r 2  xx           PieceC:         .res 1
0001B7r 2  xx           NextA:          .res 1                  ; The preview piece
0001B8r 2  xx           NextB:          .res 1
0001B9r 2  xx           NextC:          .res 1
0001BAr 2  xx           PieceDirty:     .res 1                  ; Non-zero when the three cells need
0001BBr 2                                                       ;   drawing. Not drawn on the spot,
0001BBr 2                                                       ;   because a full-board redraw may be
0001BBr 2                                                       ;   in flight and would paint over
0001BBr 2                                                       ;   them — see StatePlay (D14).
0001BBr 2               
0001BBr 2               ; --- Progress (SPEC 9, 10) ---------------------------------------------------
0001BBr 2  xx           ScoreLo:        .res 1                  ; 7 digits packed BCD, low byte first;
0001BCr 2  xx           ScoreMid:       .res 1                  ;   the top nibble of ScoreTop stays 0
0001BDr 2  xx           ScoreHi:        .res 1
0001BEr 2  xx           ScoreTop:       .res 1
0001BFr 2  xx           HighLo:         .res 1
0001C0r 2  xx           HighMid:        .res 1
0001C1r 2  xx           HighHi:         .res 1
0001C2r 2  xx           HighTop:        .res 1
0001C3r 2  xx           HighLevel:      .res 1                  ; Level the high score was set on, BCD
0001C4r 2  xx           HighOwned:      .res 1                  ; Non-zero once THIS game has taken the
0001C5r 2                                                       ;   high score. From the overtake on,
0001C5r 2                                                       ;   score and high score are equal and
0001C5r 2                                                       ;   every bank copies again, so without
0001C5r 2                                                       ;   this the one-shot fanfare and flash
0001C5r 2                                                       ;   would fire on every one (SPEC 9.8)
0001C5r 2  xx           HighFlash:      .res 1                  ; Half-blinks of the HIGH field left to
0001C6r 2                                                       ;   run. Odd = dark, even = lit, and it
0001C6r 2                                                       ;   ends at zero, so the field is always
0001C6r 2                                                       ;   left readable
0001C6r 2  xx           HighTimer:      .res 1                  ; Frames until the next half-blink
0001C7r 2  xx           Level:          .res 1                  ; Binary, 1-99
0001C8r 2  xx           TilesCleared:   .res 1                  ; Toward the next level, carries past 30
0001C9r 2               
0001C9r 2               ; --- Timers, all in frames (SPEC 14) -----------------------------------------
0001C9r 2  xx           GravityTimer:   .res 1
0001CAr 2  xx           LockTimer:      .res 1
0001CBr 2  xx           LockResets:     .res 1
0001CCr 2  xx           DasTimer:       .res 1
0001CDr 2  xx           DasDir:         .res 1
0001CEr 2  xx           AreTimer:       .res 1
0001CFr 2  xx           AnimTimer:      .res 1
0001D0r 2  xx           BannerTimer:    .res 1
0001D1r 2  xx           FrameCounter:   .res 1                  ; Free-running from power-on; seeds RNG
0001D2r 2               
0001D2r 2               ; --- Input (SPEC 11.1) -------------------------------------------------------
0001D2r 2  xx           InputNow:       .res 1
0001D3r 2  xx           InputPrev:      .res 1
0001D4r 2  xx           InputEdge:      .res 1                  ; Newly pressed this frame
0001D5r 2               
0001D5r 2               ; --- State machine (SPEC 13) -------------------------------------------------
0001D5r 2  xx           GameState:      .res 1                  ; STATE_*
0001D6r 2  xx           PlayState:      .res 1                  ; PLAY_*
0001D7r 2  xx           TitlePage:      .res 1
0001D8r 2  xx           Region:         .res 1                  ; 0 = NTSC, 1 = PAL
0001D9r 2  xx           NeedsRedraw:    .res 1
0001DAr 2               
0001DAr 2               ; --- Audio (SPEC 16) ---------------------------------------------------------
0001DAr 2  xx           SfxRequest:     .res 1                  ; Written by logic, consumed by AudioTick
0001DBr 2  xx           SfxTimer:       .res 1
0001DCr 2  xx xx xx xx  SfxState:       .res 14
0001E0r 2  xx xx xx xx  
0001E4r 2  xx xx xx xx  
0001EAr 2               
0001EAr 1               .include "../src/hal.inc"
0001EAr 2               ; =============================================================================
0001EAr 2               ;   hal.inc — Wizards Lab, the platform contract
0001EAr 2               ; =============================================================================
0001EAr 2               ;   Everything in src/ is shared, unmodified, by all three machines. The only
0001EAr 2               ;   things that differ are collected here: each platform's WizardsLab.asm must
0001EAr 2               ;   define these constants and implement these eight routines, and nothing
0001EAr 2               ;   else in src/ may touch hardware directly.
0001EAr 2               ;
0001EAr 2               ;   This file declares nothing. It is the documentation for the boundary, kept
0001EAr 2               ;   next to the code it constrains so it cannot drift out of date unnoticed.
0001EAr 2               ;
0001EAr 2               ;   CONSTANTS the platform must define BEFORE including the shared sources
0001EAr 2               ;   ---------------------------------------------------------------------
0001EAr 2               ;     PANEL_X, PANEL_Y      Where the 22 x 24 panel sits on this screen.
0001EAr 2               ;                             AC6502  5, 0      VIC-20  0, 0      C64  9, 0
0001EAr 2               ;                           PANEL_Y is 0 everywhere; the VIC-20 clips panel
0001EAr 2               ;                           row 23 and the C64 has one spare row below it.
0001EAr 2               ;     SCR_COLS           32 / 22 / 40
0001EAr 2               ;     SCR_ROWS           24 / 23 / 25
0001EAr 2               ;     HAS_COLOR_RAM         1 on the Commodores, 0 on the AC6502, whose colour
0001EAr 2               ;                           lives in the VDP colour table instead.
0001EAr 2               ;
0001EAr 2               ;   ROUTINES the platform must implement
0001EAr 2               ;   ------------------------------------
0001EAr 2               ;     HalInitVideo      Bring up the video hardware: black background and
0001EAr 2               ;                       border, the correct text/tile mode, tileset in place,
0001EAr 2               ;                       colours configured, screen cleared. Called once.
0001EAr 2               ;                       In:  nothing        Out: nothing
0001EAr 2               ;
0001EAr 2               ;     HalWaitFrame      Block until the start of the next vertical blank.
0001EAr 2               ;                       Everything below is called only between frames.
0001EAr 2               ;                       In:  nothing        Out: nothing
0001EAr 2               ;
0001EAr 2               ;     HalPlotCell       Write one cell, colour included where the platform has
0001EAr 2               ;                       per-cell colour — white instead, for any tile whose
0001EAr 2               ;                       colour key is TintColor (see HalColorFlash).
0001EAr 2               ;                       In:  A = tile, X = screen column, Y = screen row
0001EAr 2               ;                       Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
0001EAr 2               ;
0001EAr 2               ;     HalBlitScreen     Draw a whole static screen from a name-table image in
0001EAr 2               ;                       ROM: SCR_COLS * SCR_ROWS bytes, row-major, plus
0001EAr 2               ;                       the matching colour image where the platform needs one.
0001EAr 2               ;                       In:  SrcPtr -> name table, Ptr1 -> colour table
0001EAr 2               ;                       Out: nothing
0001EAr 2               ;
0001EAr 2               ;     HalReadInput      Read stick and keyboard, fold both into one mask.
0001EAr 2               ;                       In:  nothing
0001EAr 2               ;                       Out: A = INPUT_* bits, ACTIVE HIGH
0001EAr 2               ;
0001EAr 2               ;     HalDetectRegion   Decide NTSC or PAL so the timing tables can be picked.
0001EAr 2               ;                       In:  nothing        Out: A = 0 NTSC, 1 PAL
0001EAr 2               ;
0001EAr 2               ;     HalColorFlash     Draw every tile of one colour white, or stop doing so.
0001EAr 2               ;                       The fireball's detonation (SPEC 4.6, 14).
0001EAr 2               ;                       In:  A = colour key ($40..$68), or TINT_NONE for none
0001EAr 2               ;                       Out: nothing.  Modifies: A, X, Y, and TintColor, which
0001EAr 2               ;                            it OWNS: nothing else may write that byte.
0001EAr 2               ;                       The platform must handle the transition, not just the
0001EAr 2               ;                       new value — a second call with a different colour puts
0001EAr 2               ;                       the first one back before lighting the second.
0001EAr 2               ;                       On the AC6502 this is ONE byte in the VDP colour table,
0001EAr 2               ;                       because a tile's colour there belongs to its 8-pattern
0001EAr 2               ;                       group and not to the cell. On the Commodores colour is
0001EAr 2               ;                       per cell, so HalPlotCell reads TintColor instead and
0001EAr 2               ;                       substitutes white for any tile of that colour as it
0001EAr 2               ;                       draws it — which also means every tinted cell has to be
0001EAr 2               ;                       re-marked, and the animation is already marking all of
0001EAr 2               ;                       them (anim.asm).
0001EAr 2               ;
0001EAr 2               ;     HalSfx            Start a sound effect. May be a bare RTS until audio
0001EAr 2               ;                       exists.
0001EAr 2               ;                       In:  A = effect id (SPEC 16)
0001EAr 2               ;                       Out: nothing
0001EAr 2               ;
0001EAr 2               ;   The shared code assumes nothing about interrupts. Each platform may drive
0001EAr 2               ;   HalWaitFrame from a raster IRQ, a timer, or a status-register poll.
0001EAr 2               ; =============================================================================
0001EAr 2               
0001EAr 1               
0001EAr 1               ; =============================================================================
0001EAr 1               ;   Cartridge header — $8000
0001EAr 1               ; =============================================================================
0001EAr 1               
0001EAr 1               .segment "CARTHDR"
000000r 1               
000000r 1  rr rr        .addr ColdStart                 ; Cold start vector
000002r 1  rr rr        .addr ColdStart                 ; Warm start vector (NMI)
000004r 1  C3 C2 CD 38  .byte $C3, $C2, $CD, $38, $30   ; "CBM80" autostart signature
000008r 1  30           
000009r 1               
000009r 1               ; =============================================================================
000009r 1               ;   Entry
000009r 1               ; =============================================================================
000009r 1               
000009r 1               .segment "CODE"
000000r 1               
000000r 1               ColdStart:
000000r 1  78             sei
000001r 1  D8             cld
000002r 1  A2 FF          ldx #$FF
000004r 1  9A             txs                           ; The KERNAL jumped here before doing any of this
000005r 1               
000005r 1  A9 7F          lda #$7F                      ; Silence the CIA timer interrupt...
000007r 1  8D 0D DC       sta $DC0D
00000Ar 1  AD 0D DC       lda $DC0D                     ;   ...and acknowledge whatever was pending
00000Dr 1  A9 00          lda #$00
00000Fr 1  8D 1A D0       sta VIC_IMR                   ; No raster interrupt either — we poll instead
000012r 1               
000012r 1  20 rr rr       jsr GameInit                  ; Never returns
000015r 1               
000015r 1               ; --- Shared game code --------------------------------------------------------
000015r 1               .include "../src/main.asm"
000015r 2               ; =============================================================================
000015r 2               ;   main.asm — Wizards Lab, shared entry point and main loop
000015r 2               ; =============================================================================
000015r 2               ;   Included by every platform's WizardsLab.asm after that file has defined
000015r 2               ;   PANEL_X / PANEL_Y and its half of the HAL (see hal.inc). Nothing below
000015r 2               ;   touches hardware.
000015r 2               ;
000015r 2               ;   BUILD STATUS
000015r 2               ;   ------------
000015r 2               ;   Pieces spawn, steer, rotate, fall and lock, runs of three or more clear,
000015r 2               ;   the pile falls into the holes, chains keep going until nothing matches, all
000015r 2               ;   of it scores and ramps the level, the five reagents fire and set each other
000015r 2               ;   off, and a clear now glows and shatters on the frame clock instead of
000015r 2               ;   happening between two frames (PLAN.md P2 to P6). What is left is the
000015r 2               ;   screens either side of play (P7) and the sound (P8).
000015r 2               ; =============================================================================
000015r 2               
000015r 2               ; -----------------------------------------------------------------------------
000015r 2               ;   GameInit — one-time setup, called from the cartridge entry point
000015r 2               ; -----------------------------------------------------------------------------
000015r 2               GameInit:
000015r 2  20 rr rr       jsr HalDetectRegion
000018r 2  8D rr rr       sta Region
00001Br 2               
00001Br 2  20 rr rr       jsr HalInitVideo              ; Tiles in place, screen black and cleared
00001Er 2  20 rr rr       jsr AudioInit
000021r 2  20 rr rr       jsr RenderDirtyReset
000024r 2               
000024r 2  A9 00          lda #0
000026r 2  8D rr rr       sta FrameCounter
000029r 2  20 rr rr       jsr RngSeed                   ; A zero LFSR state sticks at zero forever, and
00002Cr 2                                               ;   BSS is not cleared on all three machines, so
00002Cr 2                                               ;   seed it once here just to get it out of that
00002Cr 2                                               ;   hole. This is NOT the game's seed — SPEC 15
00002Cr 2                                               ;   forbids a constant one, and StateTitle
00002Cr 2                                               ;   reseeds from the player's reaction time
00002Cr 2                                               ;   before the first piece is ever rolled.
00002Cr 2  A9 00          lda #0
00002Er 2  8D rr rr       sta InputNow
000031r 2  8D rr rr       sta InputPrev
000034r 2  8D rr rr       sta InputEdge
000037r 2  8D rr rr       sta TitlePage
00003Ar 2  A9 01          lda #1
00003Cr 2  8D rr rr       sta PrismTimer                ; A zero here would DEC to 255 and stall the
00003Fr 2                                               ;   prism's rotation for four seconds
00003Fr 2  A9 01          lda #TINT_NONE                ; BSS is not cleared on all three machines, and
000041r 2  8D rr rr       sta TintColor                 ;   a garbage colour key here would draw the
000044r 2                                               ;   title screen's tiles of that colour white
000044r 2                                               ;   on the Commodores. Set before anything
000044r 2                                               ;   plots a cell, not in HalColorFlash, which
000044r 2                                               ;   reads it to undo the last flash (hal.inc).
000044r 2               
000044r 2  20 rr rr       jsr ScoreHighInit             ; Once a session, before the first ScoreReset
000047r 2  20 rr rr       jsr ScoreReset
00004Ar 2  20 rr rr       jsr BoardClear
00004Dr 2               
00004Dr 2               .ifdef WL_DEBUG
00004Dr 2                 jsr GameStart                 ; TEMPORARY: skip the title and start playing,
00004Dr 2                                               ;   because a headless machine has no input
00004Dr 2                                               ;   attached and would sit on the title screen
00004Dr 2                                               ;   forever. Nothing else about the build
00004Dr 2                                               ;   differs any more (PLAN.md section 3).
00004Dr 2               .else
00004Dr 2  A9 00          lda #STATE_TITLE
00004Fr 2  8D rr rr       sta GameState
000052r 2  A9 01          lda #1
000054r 2  8D rr rr       sta NeedsRedraw
000057r 2               .endif
000057r 2                 ; falls through into GameLoop
000057r 2               
000057r 2               ; -----------------------------------------------------------------------------
000057r 2               ;   GameLoop — never returns
000057r 2               ; -----------------------------------------------------------------------------
000057r 2               GameLoop:
000057r 2  20 rr rr       jsr HalWaitFrame
00005Ar 2  EE rr rr       inc FrameCounter              ; Free-running from power-on; seeds the RNG
00005Dr 2               
00005Dr 2  20 rr rr       jsr RenderFlush               ; Screen writes happen in vertical blank only
000060r 2  20 rr rr       jsr InputPoll
000063r 2               
000063r 2  AD rr rr       lda GameState                 ; Dispatch on the current screen state
000066r 2  C9 00          cmp #STATE_TITLE
000068r 2  F0 0E          beq @Title
00006Ar 2  C9 01          cmp #STATE_PLAY
00006Cr 2  F0 10          beq @Play
00006Er 2  C9 02          cmp #STATE_PAUSE
000070r 2  F0 12          beq @Pause
000072r 2  20 rr rr       jsr StateGameOver             ; JSR, not JMP — every state handler ends in an
000075r 2  4C rr rr       jmp @Audio                    ;   RTS, and a JMP here would hand that RTS the
000078r 2                                               ;   return address of the JSR GameInit that the
000078r 2                                               ;   cart entry point never expects back. The
000078r 2                                               ;   first loss unwound the loop into GameInit;
000078r 2                                               ;   the second pulled from an empty stack.
000078r 2               
000078r 2               @Title:
000078r 2  20 rr rr       jsr StateTitle
00007Br 2  4C rr rr       jmp @Audio
00007Er 2               @Play:
00007Er 2  20 rr rr       jsr StatePlay
000081r 2  4C rr rr       jmp @Audio
000084r 2               @Pause:
000084r 2  20 rr rr       jsr StatePause
000087r 2               
000087r 2               @Audio:
000087r 2  20 rr rr       jsr AudioTick
00008Ar 2  4C rr rr       jmp GameLoop
00008Dr 2               
00008Dr 2               ; =============================================================================
00008Dr 2               ;   States (SPEC 13)
00008Dr 2               ; =============================================================================
00008Dr 2               
00008Dr 2               ; -----------------------------------------------------------------------------
00008Dr 2               ;   StateTitle — blinking prompt over the drawn screen, and the magic field
00008Dr 2               ;   SPEC 13.1. There are no help pages: the controls are part of the screen
00008Dr 2               ;   image, so the only things moving here are the prompt and the field.
00008Dr 2               ; -----------------------------------------------------------------------------
00008Dr 2               StateTitle:
00008Dr 2  AD rr rr       lda NeedsRedraw
000090r 2  F0 0B          beq @Live
000092r 2  A9 00          lda #0
000094r 2  8D rr rr       sta NeedsRedraw
000097r 2  20 rr rr       jsr DrawTitleScreen
00009Ar 2  20 rr rr       jsr RenderDirtyReset          ; A full blit went behind the renderer's back
00009Dr 2               
00009Dr 2               @Live:
00009Dr 2                 ; TODO: blink the prompt every 30 frames, and shimmer the magic field —
00009Dr 2                 ; one NextRandom for a cell in the 14 x 2 block, one for a tile in
00009Dr 2                 ; ART_BASE..ART_BASE+ART_TILES-1, one RenderMark.
00009Dr 2  AD rr rr       lda InputEdge
0000A0r 2  29 11          and #(INPUT_FIRE | INPUT_UP)  ; Fire, or SPACE, which the keyboards fold
0000A2r 2  F0 06          beq @Done                     ;   into UP so it can rotate in play (D15)
0000A4r 2               
0000A4r 2  20 rr rr       jsr RngSeed                   ; SPEC 15 — seed from reaction time, not a constant
0000A7r 2  20 rr rr       jsr GameStart
0000AAr 2               @Done:
0000AAr 2  60             rts
0000ABr 2               
0000ABr 2               ; -----------------------------------------------------------------------------
0000ABr 2               ;   GameStart — enter play from the title screen
0000ABr 2               ; -----------------------------------------------------------------------------
0000ABr 2               GameStart:
0000ABr 2  20 rr rr       jsr ScoreReset
0000AEr 2  20 rr rr       jsr BoardClear
0000B1r 2               
0000B1r 2  A9 01          lda #1
0000B3r 2  8D rr rr       sta Level
0000B6r 2  A9 00          lda #0
0000B8r 2  8D rr rr       sta TilesCleared
0000BBr 2  8D rr rr       sta DasDir                    ; No direction is held into a new game
0000BEr 2  8D rr rr       sta DasTimer
0000C1r 2  8D rr rr       sta PieceDirty
0000C4r 2  8D rr rr       sta BannerTimer               ; Nothing from the last game is still up
0000C7r 2  8D rr rr       sta PrismFrame
0000CAr 2  A9 01          lda #1
0000CCr 2  8D rr rr       sta PrismTimer
0000CFr 2  A9 01          lda #TINT_NONE                ; ...and no colour is still flashing white, on
0000D1r 2  20 rr rr       jsr HalColorFlash             ;   a machine where that is a VDP register and
0000D4r 2                                               ;   not a byte of RAM (SPEC 4.6)
0000D4r 2               
0000D4r 2  20 rr rr       jsr DrawPlayScreen            ; The whole screen at once, behind the
0000D7r 2  20 rr rr       jsr RenderDirtyReset          ;   renderer's back — so drop anything queued
0000DAr 2                                               ;   against the screen that just went away
0000DAr 2               
0000DAr 2  20 rr rr       jsr TextBannerClear           ; The play image ships with the band reading
0000DDr 2                                               ;   `~~ PAUSED ~~` (SPEC 12.1); play owns it
0000DDr 2  20 rr rr       jsr RenderScore               ; The panel fields are code's, not the image's
0000E0r 2  20 rr rr       jsr RenderHigh
0000E3r 2  20 rr rr       jsr RenderLevel
0000E6r 2  20 rr rr       jsr RenderBoard               ; Queued across as many frames as it takes
0000E9r 2               
0000E9r 2  20 rr rr       jsr PieceGenerateNext         ; Fill the preview...
0000ECr 2  20 rr rr       jsr PieceSpawn                ; ...then promote it and refill. The board is
0000EFr 2  20 rr rr       jsr PieceGenerateNext         ;   empty, so the spawn cannot be blocked.
0000F2r 2  20 rr rr       jsr RenderNext
0000F5r 2               
0000F5r 2  A9 00          lda #PLAY_FALLING
0000F7r 2  8D rr rr       sta PlayState
0000FAr 2  A9 01          lda #STATE_PLAY
0000FCr 2  8D rr rr       sta GameState
0000FFr 2  60             rts
000100r 2               
000100r 2               ; -----------------------------------------------------------------------------
000100r 2               ;   StatePlay — the game
000100r 2               ;   SPEC 13.2. One frame is: advance whatever the play sub-state is doing,
000100r 2               ;   then queue whatever changed. Cascades run as sub-states rather than in a
000100r 2               ;   blocking loop so animation stays on the frame clock.
000100r 2               ; -----------------------------------------------------------------------------
000100r 2               StatePlay:
000100r 2  20 rr rr       jsr ScoreFlashTick            ; SPEC 9.8 — the HIGH field blinking after an
000103r 2                                               ;   overtake. Play never stops for it, so it
000103r 2                                               ;   ticks alongside whatever the sub-state is
000103r 2                                               ;   doing rather than inside one.
000103r 2  20 rr rr       jsr AnimBannerTick            ; ...and neither does it for a banner (SPEC 14)
000106r 2  20 rr rr       jsr AnimPrismTick             ; ...nor for the one tile that moves at rest
000109r 2               
000109r 2  AD rr rr       lda InputEdge
00010Cr 2  29 20          and #INPUT_PAUSE
00010Er 2  D0 52          bne @ToPause
000110r 2               
000110r 2  AD rr rr       lda PlayState
000113r 2  C9 00          cmp #PLAY_FALLING
000115r 2  F0 17          beq @Falling
000117r 2  C9 01          cmp #PLAY_LOCKING
000119r 2  F0 19          beq @Locking
00011Br 2  C9 02          cmp #PLAY_GLOW
00011Dr 2  F0 1B          beq @Glow
00011Fr 2  C9 03          cmp #PLAY_SHATTER
000121r 2  F0 1D          beq @Shatter
000123r 2  C9 04          cmp #PLAY_GRAVITY
000125r 2  F0 1F          beq @Gravity
000127r 2  C9 05          cmp #PLAY_ARE
000129r 2  F0 21          beq @Are
00012Br 2  4C rr rr       jmp @Draw                     ; Not a state anything sets
00012Er 2               
00012Er 2               @Falling:
00012Er 2  20 rr rr       jsr PlayFalling
000131r 2  4C rr rr       jmp @Draw
000134r 2               @Locking:
000134r 2  20 rr rr       jsr PlayLocking
000137r 2  4C rr rr       jmp @Draw
00013Ar 2               @Glow:
00013Ar 2  20 rr rr       jsr PlayGlow
00013Dr 2  4C rr rr       jmp @Draw
000140r 2               @Shatter:
000140r 2  20 rr rr       jsr PlayShatter
000143r 2  4C rr rr       jmp @Draw
000146r 2               @Gravity:
000146r 2  20 rr rr       jsr PlayGravity
000149r 2  4C rr rr       jmp @Draw
00014Cr 2               @Are:
00014Cr 2  20 rr rr       jsr PlayAre
00014Fr 2               
00014Fr 2                 ; --- draw the piece, once whatever else wanted the screen has finished ----
00014Fr 2                 ;   D14. RenderBoard is a cursor that feeds the ring over several frames
00014Fr 2                 ;   (D12), so marks made while one is outstanding are drawn BEFORE the
00014Fr 2                 ;   redraw reaches those cells and are then painted over. Holding the piece
00014Fr 2                 ;   back until the redraw has finished is one byte and always right; the
00014Fr 2                 ;   alternative is a piece that vanishes for four frames after every pause.
00014Fr 2               @Draw:
00014Fr 2  AD rr rr       lda PieceDirty
000152r 2  F0 0D          beq @Done
000154r 2  AD rr rr       lda RedrawIdx
000157r 2  10 08          bpl @Done                     ; A board redraw is still in flight
000159r 2  A9 00          lda #0
00015Br 2  8D rr rr       sta PieceDirty
00015Er 2  20 rr rr       jsr RenderPiece
000161r 2               @Done:
000161r 2  60             rts
000162r 2               
000162r 2               @ToPause:
000162r 2  A9 02          lda #STATE_PAUSE
000164r 2  8D rr rr       sta GameState
000167r 2  A9 rr          lda #<MsgPaused               ; SPEC 12.2 — without this the screen does not
000169r 2  85 rr          sta Ptr1                      ;   change at all on a pause, and a paused game
00016Br 2  A9 rr          lda #>MsgPaused               ;   is indistinguishable from a hung one
00016Dr 2  85 rr          sta Ptr1+1
00016Fr 2  20 rr rr       jsr TextBanner
000172r 2                 ; TODO (P7): wash the well with TILE_WASH so a pause cannot be used to study
000172r 2                 ; the board (13.3). A wash, not a blank — a blanked well reads as crashed.
000172r 2  60             rts
000173r 2               
000173r 2               ; -----------------------------------------------------------------------------
000173r 2               ;   PlayFalling — steer the piece, and drop it a row when the timer runs out
000173r 2               ;   SPEC 5.5, 5.6, 11.3
000173r 2               ; -----------------------------------------------------------------------------
000173r 2               PlayFalling:
000173r 2  20 rr rr       jsr PieceControl              ; Rotation and DAS; the result is ignored here
000176r 2                                               ;   because there is no lock delay to reset yet
000176r 2  20 rr rr       jsr PieceFallRate
000179r 2  85 rr          sta Tmp0
00017Br 2  AD rr rr       lda GravityTimer              ; Pressing DOWN mid-wait must shorten the wait
00017Er 2  C5 rr          cmp Tmp0                      ;   in progress, not just the next one
000180r 2  90 05          bcc @Tick
000182r 2  A5 rr          lda Tmp0
000184r 2  8D rr rr       sta GravityTimer
000187r 2               @Tick:
000187r 2  CE rr rr       dec GravityTimer
00018Ar 2  D0 1E          bne @Done
00018Cr 2  20 rr rr       jsr PieceStep
00018Fr 2  B0 0B          bcs @Land
000191r 2  20 rr rr       jsr PieceFallRate             ; ...and C tells us whose rate the row that
000194r 2  8D rr rr       sta GravityTimer              ;   just fell used. STA leaves it alone.
000197r 2  B0 11          bcs @Done
000199r 2  4C rr rr       jmp ScoreSoftDrop             ; SPEC 9.6 — one point, one row
00019Cr 2               
00019Cr 2               @Land:
00019Cr 2  AE rr rr       ldx Region
00019Fr 2  BD rr rr       lda LockDelay,x
0001A2r 2  8D rr rr       sta LockTimer
0001A5r 2  A9 01          lda #PLAY_LOCKING
0001A7r 2  8D rr rr       sta PlayState
0001AAr 2               @Done:
0001AAr 2  60             rts
0001ABr 2               
0001ABr 2               ; -----------------------------------------------------------------------------
0001ABr 2               ;   PlayLocking — the lock delay, and the moves that may reset it
0001ABr 2               ;   SPEC 5.6 — a horizontal move resets the delay LOCK_RESET_MAX times; after
0001ABr 2               ;   that it runs out regardless. Rotation never resets it. A move that opens a
0001ABr 2               ;   gap underneath resumes falling, and the reset count carries.
0001ABr 2               ; -----------------------------------------------------------------------------
0001ABr 2               PlayLocking:
0001ABr 2  20 rr rr       jsr PieceControl
0001AEr 2  90 13          bcc @Settled
0001B0r 2  AD rr rr       lda LockResets
0001B3r 2  C9 04          cmp #LOCK_RESET_MAX
0001B5r 2  B0 0C          bcs @Settled
0001B7r 2  EE rr rr       inc LockResets
0001BAr 2  AE rr rr       ldx Region
0001BDr 2  BD rr rr       lda LockDelay,x
0001C0r 2  8D rr rr       sta LockTimer
0001C3r 2               
0001C3r 2               @Settled:
0001C3r 2  20 rr rr       jsr PieceCanFall
0001C6r 2  90 0C          bcc @Tick
0001C8r 2  A9 00          lda #PLAY_FALLING             ; It moved over a hole — fall again. SPEC 5.6
0001CAr 2  8D rr rr       sta PlayState                 ;   says the lock counter clears here and the
0001CDr 2                                               ;   reset count does not; nothing reads
0001CDr 2                                               ;   LockTimer while falling and the next
0001CDr 2                                               ;   landing loads it fresh, so it is already
0001CDr 2                                               ;   clear in every sense that matters.
0001CDr 2  20 rr rr       jsr PieceFallRate
0001D0r 2  8D rr rr       sta GravityTimer
0001D3r 2  60             rts
0001D4r 2               
0001D4r 2               @Tick:
0001D4r 2  CE rr rr       dec LockTimer
0001D7r 2  D0 09          bne @Done
0001D9r 2  20 rr rr       jsr PieceLock
0001DCr 2  20 rr rr       jsr CascadeBegin              ; SPEC 8 — the cascade starts the moment the
0001DFr 2  4C rr rr       jmp CascadeEnter              ;   piece is board, and runs as sub-states
0001E2r 2               @Done:
0001E2r 2  60             rts
0001E3r 2               
0001E3r 2               ; -----------------------------------------------------------------------------
0001E3r 2               ;   CascadeEnter — run one cascade step and choose the sub-state after it
0001E3r 2               ;   In:  ChainStep set        Out: PlayState set.  Modifies: A, X, Y
0001E3r 2               ;   SPEC 8, D4. Called from the lock, and again from the bottom of every fall.
0001E3r 2               ;
0001E3r 2               ;   A step that marks something hands over to PLAY_GLOW, and the removal and
0001E3r 2               ;   the fall follow it twelve frames later; a step that finds nothing is where
0001E3r 2               ;   the cascade settles and the next piece is queued.
0001E3r 2               ;
0001E3r 2               ;   Nothing has come off the board when CascadeScan returns — that is the whole
0001E3r 2               ;   point of the split (cascade.asm). CascadeFinish does the taking, at the far
0001E3r 2               ;   end of PLAY_SHATTER.
0001E3r 2               ; -----------------------------------------------------------------------------
0001E3r 2               CascadeEnter:
0001E3r 2  20 rr rr       jsr CascadeScan
0001E6r 2  90 03          bcc @Settle
0001E8r 2  4C rr rr       jmp AnimGlowBegin             ; SPEC 8 step 5
0001EBr 2               
0001EBr 2               @Settle:
0001EBr 2  20 rr rr       jsr CascadeSettle             ; The star multiplier and the bank (SPEC 8
0001EEr 2                                               ;   SETTLE)
0001EEr 2  AD rr rr       lda ChainStep                 ; SPEC 8 SETTLE, SPEC 14 — a chain of two links
0001F1r 2  38             sec                           ;   or more is worth saying out loud. ChainStep
0001F2r 2  E9 01          sbc #1                        ;   counts the step that found nothing as well,
0001F4r 2  C9 02          cmp #2                        ;   so the links are one fewer
0001F6r 2  90 03          bcc @Are
0001F8r 2  20 rr rr       jsr AnimBannerChain
0001FBr 2               
0001FBr 2               @Are:
0001FBr 2  AE rr rr       ldx Region
0001FEr 2  BD rr rr       lda AreDelay,x
000201r 2  8D rr rr       sta AreTimer
000204r 2  A9 05          lda #PLAY_ARE
000206r 2  8D rr rr       sta PlayState
000209r 2  60             rts
00020Ar 2               
00020Ar 2               ; -----------------------------------------------------------------------------
00020Ar 2               ;   PlayGlow — hold the glow, the beams and the fireball's flash (SPEC 14)
00020Ar 2               ;   The window is one timer however many things are showing inside it: they all
00020Ar 2               ;   start together and the longest decides how long it lasts (anim.asm).
00020Ar 2               ; -----------------------------------------------------------------------------
00020Ar 2               PlayGlow:
00020Ar 2  CE rr rr       dec AnimTimer
00020Dr 2  D0 03          bne @Done
00020Fr 2  4C rr rr       jmp AnimGlowEnd               ; ...which starts the shatter
000212r 2               @Done:
000212r 2  60             rts
000213r 2               
000213r 2               ; -----------------------------------------------------------------------------
000213r 2               ;   PlayShatter — the removal ring, VFX_FRAMES a tile (SPEC 14)
000213r 2               ;   The board is finally emptied at the end of this, not at the start of it:
000213r 2               ;   every frame up to here has been drawing over cells that still hold their
000213r 2               ;   own tiles (cascade.asm).
000213r 2               ; -----------------------------------------------------------------------------
000213r 2               PlayShatter:
000213r 2  CE rr rr       dec AnimTimer
000216r 2  D0 20          bne @Done
000218r 2  EE rr rr       inc AnimStep
00021Br 2  AD rr rr       lda AnimStep
00021Er 2  CD rr rr       cmp AnimSteps
000221r 2  B0 0A          bcs @Over
000223r 2  A9 02          lda #VFX_FRAMES
000225r 2  8D rr rr       sta AnimTimer
000228r 2  A9 03          lda #ANIM_SHATTER
00022Ar 2  4C rr rr       jmp AnimMarked
00022Dr 2               
00022Dr 2               @Over:
00022Dr 2  20 rr rr       jsr CascadeFinish             ; SPEC 8 steps 6 and 7
000230r 2  20 rr rr       jsr BoardGravityBegin         ; ...and let what was above it fall
000233r 2  A9 04          lda #PLAY_GRAVITY
000235r 2  8D rr rr       sta PlayState
000238r 2               @Done:
000238r 2  60             rts
000239r 2               
000239r 2               ; -----------------------------------------------------------------------------
000239r 2               ;   PlayGravity — the pile falls into the holes the clear left
000239r 2               ;   SPEC 8 step 8, SPEC 14 — a row every FALL_FRAMES, and when a row moves
000239r 2               ;   nothing the board has settled and the next step scans it.
000239r 2               ;
000239r 2               ;   The row itself may take more than one frame: BoardGravityStep is a cursor
000239r 2               ;   that stops when the dirty ring is full (board.asm). The beat only starts
000239r 2               ;   once the row has actually landed, so a heavy board falls a little slower
000239r 2               ;   rather than losing cells off the screen.
000239r 2               ; -----------------------------------------------------------------------------
000239r 2               PlayGravity:
000239r 2  A5 rr          lda GravIdx
00023Br 2  10 0C          bpl @Working                  ; A row is still coming down
00023Dr 2               
00023Dr 2  CE rr rr       dec AnimTimer
000240r 2  D0 11          bne @Done
000242r 2  A5 rr          lda GravMoved
000244r 2  F0 0E          beq @Landed                   ; The last row moved nothing: everything is
000246r 2  20 rr rr       jsr BoardGravityBegin         ;   resting on something
000249r 2               
000249r 2               @Working:
000249r 2  20 rr rr       jsr BoardGravityStep
00024Cr 2  90 05          bcc @Done                     ; The ring filled — the rest waits for a flush
00024Er 2  A9 02          lda #FALL_FRAMES              ; The row is down; hold it there for the beat
000250r 2  8D rr rr       sta AnimTimer
000253r 2               @Done:
000253r 2  60             rts
000254r 2               
000254r 2               @Landed:
000254r 2  EE rr rr       inc ChainStep                 ; SPEC 8 step 9
000257r 2  4C rr rr       jmp CascadeEnter
00025Ar 2               
00025Ar 2               ; -----------------------------------------------------------------------------
00025Ar 2               ;   PlayAre — the entry delay, then the next piece
00025Ar 2               ;   SPEC 5.6, 13.4 — a blocked spawn is game over.
00025Ar 2               ; -----------------------------------------------------------------------------
00025Ar 2               PlayAre:
00025Ar 2  CE rr rr       dec AreTimer
00025Dr 2  D0 10          bne @Done
00025Fr 2  20 rr rr       jsr PieceSpawn
000262r 2  B0 0C          bcs @Over
000264r 2  20 rr rr       jsr PieceGenerateNext
000267r 2  20 rr rr       jsr RenderNext
00026Ar 2  A9 00          lda #PLAY_FALLING
00026Cr 2  8D rr rr       sta PlayState
00026Fr 2               @Done:
00026Fr 2  60             rts
000270r 2               
000270r 2               @Over:
000270r 2  A9 0C          lda #SFX_GAMEOVER
000272r 2  8D rr rr       sta SfxRequest
000275r 2  20 rr rr       jsr AnimPetrifyBegin          ; The well turns to stone from the floor up
000278r 2  A9 03          lda #STATE_GAMEOVER           ;   while StateGameOver holds the input off
00027Ar 2  8D rr rr       sta GameState
00027Dr 2  60             rts
00027Er 2               
00027Er 2               ; -----------------------------------------------------------------------------
00027Er 2               ;   StatePause
00027Er 2               ; -----------------------------------------------------------------------------
00027Er 2               StatePause:
00027Er 2  AD rr rr       lda InputEdge
000281r 2  29 30          and #(INPUT_PAUSE | INPUT_FIRE)
000283r 2  F0 17          beq @Done
000285r 2  A9 01          lda #STATE_PLAY
000287r 2  8D rr rr       sta GameState
00028Ar 2  20 rr rr       jsr TextBannerClear           ; The banner comes down...
00028Dr 2  20 rr rr       jsr RenderBoard               ; ...the board goes back up...
000290r 2  AD rr rr       lda PlayState                 ;   ...and the piece on top of it, once the
000293r 2  C9 02          cmp #PLAY_GLOW                ;   redraw has gone by (D14) — but only while
000295r 2  B0 05          bcs @Done                     ;   there IS one. From GLOW on up the piece is
000297r 2  A9 01          lda #1                        ;   in the board and PieceA-C are stale; the
000299r 2  8D rr rr       sta PieceDirty                ;   cascade may have taken those cells away
00029Cr 2               @Done:                          ;   entirely.
00029Cr 2  60             rts
00029Dr 2               
00029Dr 2               ; -----------------------------------------------------------------------------
00029Dr 2               ;   StateGameOver — petrify, banner, back to the title
00029Dr 2               ;   SPEC 13.4
00029Dr 2               ; -----------------------------------------------------------------------------
00029Dr 2               StateGameOver:
00029Dr 2  20 rr rr       jsr AnimPetrifyTick           ; SPEC 13.4 step 2, a row every PETRIFY_FRAMES
0002A0r 2  B0 11          bcs @Done                     ; Still setting. A press during the petrify is
0002A2r 2                                               ;   ignored rather than queued: the animation
0002A2r 2                                               ;   is the game telling the player it is over
0002A2r 2                                               ;   and skipping it reads as a dropped input.
0002A2r 2                 ; TODO (P7): the GAME OVER banner, the high-score fanfare, and the ten
0002A2r 2                 ; second timeout back to the title (13.4 steps 3 to 5).
0002A2r 2  AD rr rr       lda InputEdge
0002A5r 2  29 11          and #(INPUT_FIRE | INPUT_UP)  ; Fire, or SPACE (D15)
0002A7r 2  F0 0A          beq @Done
0002A9r 2  A9 00          lda #STATE_TITLE
0002ABr 2  8D rr rr       sta GameState
0002AEr 2  A9 01          lda #1
0002B0r 2  8D rr rr       sta NeedsRedraw
0002B3r 2               @Done:
0002B3r 2  60             rts
0002B4r 2               
0002B4r 2               ; =============================================================================
0002B4r 2               ;   Static screen drawing
0002B4r 2               ; =============================================================================
0002B4r 2               ;   The whole static layout — panel frame, labels, and the margin artwork that
0002B4r 2               ;   fills the screen either side of it — comes out of the editors as one
0002B4r 2               ;   name-table image per platform. Code only ever draws over the top of it:
0002B4r 2               ;   the well, the score and level digits, the preview, and the message band.
0002B4r 2               ;
0002B4r 2               ;   All six images are real. They come out of artwork/WizardsLab.tms9918 —
0002B4r 2               ;   the master — by way of `make artwork`. See data/README.md.
0002B4r 2               ; =============================================================================
0002B4r 2               
0002B4r 2               DrawTitleScreen:
0002B4r 2  A9 rr          lda #<TitleScreen
0002B6r 2  85 rr          sta SrcPtr
0002B8r 2  A9 rr          lda #>TitleScreen
0002BAr 2  85 rr          sta SrcPtr+1
0002BCr 2  A9 rr          lda #<TitleColor
0002BEr 2  85 rr          sta Ptr1
0002C0r 2  A9 rr          lda #>TitleColor
0002C2r 2  85 rr          sta Ptr1+1
0002C4r 2  4C rr rr       jmp HalBlitScreen
0002C7r 2               
0002C7r 2               DrawPlayScreen:
0002C7r 2  A9 rr          lda #<PlayScreen
0002C9r 2  85 rr          sta SrcPtr
0002CBr 2  A9 rr          lda #>PlayScreen
0002CDr 2  85 rr          sta SrcPtr+1
0002CFr 2  A9 rr          lda #<PlayColor
0002D1r 2  85 rr          sta Ptr1
0002D3r 2  A9 rr          lda #>PlayColor
0002D5r 2  85 rr          sta Ptr1+1
0002D7r 2  4C rr rr       jmp HalBlitScreen
0002DAr 2               
0002DAr 1               .include "../src/rng.asm"
0002DAr 2               ; =============================================================================
0002DAr 2               ;   rng.asm — Wizards Lab, random numbers
0002DAr 2               ; =============================================================================
0002DAr 2               ;   A 16-bit Galois LFSR with the conventional $B400 taps, which is maximal
0002DAr 2               ;   length: it visits all 65535 non-zero states before repeating. Eight shifts
0002DAr 2               ;   per call, one whole byte out.
0002DAr 2               ;
0002DAr 2               ;   Seeding matters more than the generator does. A fixed seed would deal the
0002DAr 2               ;   same first three pieces every session and the game would feel dead, so the
0002DAr 2               ;   seed is taken from the free-running frame counter at the moment the player
0002DAr 2               ;   presses fire on the title screen — human reaction time is the entropy.
0002DAr 2               ;
0002DAr 2               ;   SPEC.md section 15.
0002DAr 2               ; =============================================================================
0002DAr 2               
0002DAr 2               ; -----------------------------------------------------------------------------
0002DAr 2               ;   RngSeed — seed from the frame counter
0002DAr 2               ;   In:  nothing (reads FrameCounter)
0002DAr 2               ;   Out: nothing.  Modifies: A
0002DAr 2               ; -----------------------------------------------------------------------------
0002DAr 2               RngSeed:
0002DAr 2  AD rr rr       lda FrameCounter
0002DDr 2  09 01          ora #$01                      ; Never let the state reach zero — it sticks
0002DFr 2  85 rr          sta RngLo
0002E1r 2  49 5A          eor #$5A                      ; Spread one byte of entropy over both halves
0002E3r 2  85 rr          sta RngHi
0002E5r 2  60             rts
0002E6r 2               
0002E6r 2               ; -----------------------------------------------------------------------------
0002E6r 2               ;   RngNext — next pseudo-random byte
0002E6r 2               ;   In:  nothing
0002E6r 2               ;   Out: A = random 0-255.  Modifies: A, X, flags
0002E6r 2               ; -----------------------------------------------------------------------------
0002E6r 2               RngNext:
0002E6r 2  A2 08          ldx #8                        ; Eight shifts give one whole output byte
0002E8r 2               @Bit:
0002E8r 2  46 rr          lsr RngHi                     ; Shift the 16-bit state right one place,
0002EAr 2  66 rr          ror RngLo                     ;   the bit falling out of bit 0 lands in C
0002ECr 2  90 06          bcc @NoTap
0002EEr 2  A5 rr          lda RngHi
0002F0r 2  49 B4          eor #$B4                      ; Galois feedback mask $B400
0002F2r 2  85 rr          sta RngHi
0002F4r 2               @NoTap:
0002F4r 2  CA             dex
0002F5r 2  D0 F1          bne @Bit
0002F7r 2  A5 rr          lda RngLo
0002F9r 2  60             rts
0002FAr 2               
0002FAr 2               ; -----------------------------------------------------------------------------
0002FAr 2               ;   RngRange — a random number below a small limit
0002FAr 2               ;   In:  A = limit, 1-128
0002FAr 2               ;   Out: A = 0 .. limit-1.  Modifies: A, X, Tmp0, Tmp1.  PRESERVES Y.
0002FAr 2               ;
0002FAr 2               ;   Not a modulo. `random % 6` throws four of the 256 outcomes into the low
0002FAr 2               ;   values and leaves colours 0-3 a shade likelier than 4-5; this takes the
0002FAr 2               ;   HIGH byte of (random * limit) instead, which spreads the remainder evenly
0002FAr 2               ;   across the range and costs a fixed eight shifts either way.
0002FAr 2               ;
0002FAr 2               ;   The eight-bit multiply keeps only the high byte: the low half falls out of
0002FAr 2               ;   the accumulator one bit at a time and is never wanted.
0002FAr 2               ;
0002FAr 2               ;   Y is preserved so a caller can loop over the three cells of a piece with
0002FAr 2               ;   it (piece.asm does).
0002FAr 2               ; -----------------------------------------------------------------------------
0002FAr 2               RngRange:
0002FAr 2  48             pha                           ; The limit — RngNext wants A
0002FBr 2  20 rr rr       jsr RngNext
0002FEr 2  85 rr          sta Tmp0                      ; The random byte
000300r 2  68             pla
000301r 2  85 rr          sta Tmp1                      ; The limit, shifted out one bit at a time
000303r 2  A9 00          lda #0
000305r 2  A2 08          ldx #8
000307r 2               @Bit:
000307r 2  46 rr          lsr Tmp1                      ; Next multiplier bit into C
000309r 2  90 03          bcc @NoAdd
00030Br 2  18             clc
00030Cr 2  65 rr          adc Tmp0                      ; Partial product, carry out into C
00030Er 2               @NoAdd:
00030Er 2  6A             ror a                         ; Shift the accumulator down, carry in at bit 7
00030Fr 2  CA             dex
000310r 2  D0 F5          bne @Bit
000312r 2  60             rts
000313r 2               
000313r 1               .include "../src/input.asm"
000313r 2               ; =============================================================================
000313r 2               ;   input.asm — Wizards Lab, input conditioning
000313r 2               ; =============================================================================
000313r 2               ;   SPEC.md section 11. HalReadInput hands back one active-high mask however
000313r 2               ;   the platform likes; everything above this line works on that mask and
000313r 2               ;   never touches hardware.
000313r 2               ;
000313r 2               ;   Auto-repeat applies to LEFT and RIGHT only. Rotate does NOT repeat — up
000313r 2               ;   must be released and pressed again. That is not a preference: a repeating
000313r 2               ;   rotate makes a three-cell Columns piece impossible to aim.
000313r 2               ; =============================================================================
000313r 2               
000313r 2               ; -----------------------------------------------------------------------------
000313r 2               ;   InputPoll — read the hardware and work out what is newly pressed
000313r 2               ;   In:  nothing
000313r 2               ;   Out: InputNow, InputPrev, InputEdge updated.  Modifies: A
000313r 2               ; -----------------------------------------------------------------------------
000313r 2               InputPoll:
000313r 2  AD rr rr       lda InputNow
000316r 2  8D rr rr       sta InputPrev
000319r 2  20 rr rr       jsr HalReadInput
00031Cr 2  8D rr rr       sta InputNow
00031Fr 2  4D rr rr       eor InputPrev                 ; Bits that changed
000322r 2  2D rr rr       and InputNow                  ; ...and are now down = newly pressed
000325r 2  8D rr rr       sta InputEdge
000328r 2  60             rts
000329r 2               
000329r 2               ; -----------------------------------------------------------------------------
000329r 2               ;   InputShift — LEFT/RIGHT with delayed auto shift
000329r 2               ;   Out: A = INPUT_LEFT, INPUT_RIGHT, or 0 if no move should happen this frame.
000329r 2               ;        Modifies: A, X
000329r 2               ;   SPEC 11.3 — initial delay 12 frames NTSC / 10 PAL, then 4 / 3.
000329r 2               ;
000329r 2               ;   A fresh press fires on the same frame it arrives; the delay is what comes
000329r 2               ;   after it, not before it, so a tap is always exactly one column.
000329r 2               ;
000329r 2               ;   Holding both directions at once is not something a stick can do, but two
000329r 2               ;   keys can. LEFT wins, and it wins consistently, so the piece sits still
000329r 2               ;   rather than shivering between the two.
000329r 2               ; -----------------------------------------------------------------------------
000329r 2               InputShift:
000329r 2  AD rr rr       lda InputNow
00032Cr 2  29 04          and #INPUT_LEFT
00032Er 2  D0 07          bne @Dir
000330r 2  AD rr rr       lda InputNow
000333r 2  29 08          and #INPUT_RIGHT
000335r 2  F0 2A          beq @None
000337r 2               
000337r 2               @Dir:
000337r 2  CD rr rr       cmp DasDir
00033Ar 2  F0 10          beq @Held
00033Cr 2               
00033Cr 2  8D rr rr       sta DasDir                    ; A new direction: fire now, then wait
00033Fr 2  AE rr rr       ldx Region
000342r 2  BD rr rr       lda DasInitial,x
000345r 2  8D rr rr       sta DasTimer
000348r 2  AD rr rr       lda DasDir
00034Br 2  60             rts
00034Cr 2               
00034Cr 2               @Held:
00034Cr 2  CE rr rr       dec DasTimer                  ; Always loaded non-zero, so this cannot wrap
00034Fr 2  D0 0D          bne @Wait
000351r 2  AE rr rr       ldx Region
000354r 2  BD rr rr       lda DasRepeat,x
000357r 2  8D rr rr       sta DasTimer
00035Ar 2  AD rr rr       lda DasDir
00035Dr 2  60             rts
00035Er 2               
00035Er 2               @Wait:
00035Er 2  A9 00          lda #0
000360r 2  60             rts
000361r 2               
000361r 2               @None:
000361r 2  8D rr rr       sta DasDir                    ; A is already 0 — release, so the next press
000364r 2  60             rts                           ;   counts as fresh
000365r 2               
000365r 1               .include "../src/board.asm"
000365r 2               ; =============================================================================
000365r 2               ;   board.asm — Wizards Lab, the playfield
000365r 2               ; =============================================================================
000365r 2               ;   SPEC.md section 3. The board is 20 rows of 8 bytes, page-aligned, with
000365r 2               ;   columns 6-7 and rows 16-19 held permanently at $FF. Those sentinels are
000365r 2               ;   what let every scan in match.asm run without a bounds check.
000365r 2               ;
000365r 2               ;   address(row, col) = Board + (row << 3) + col
000365r 2               ; =============================================================================
000365r 2               
000365r 2               ; -----------------------------------------------------------------------------
000365r 2               ;   BoardClear — empty the playfield and lay the sentinels back down
000365r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X
000365r 2               ;
000365r 2               ;   Walls first over the whole 160 bytes, then the six playfield columns of
000365r 2               ;   the sixteen playfield rows punched back out to empty. Doing it in that
000365r 2               ;   order means the sentinels can never be forgotten: everything that is not
000365r 2               ;   explicitly playfield is a wall.
000365r 2               ;
000365r 2               ;   The wall loop counts UP and ends on a CPX. Counting down from 159 to a BPL
000365r 2               ;   looks tidier and is wrong: 159 is $9F, bit 7 already set, so the branch
000365r 2               ;   falls through after the first store and the other 159 bytes keep whatever
000365r 2               ;   the machine powered up with. That went unnoticed for a whole phase,
000365r 2               ;   because nothing read a sentinel until the falling piece needed a floor.
000365r 2               ; -----------------------------------------------------------------------------
000365r 2               BoardClear:
000365r 2  A9 FF          lda #TILE_WALL
000367r 2  A2 00          ldx #0
000369r 2               @Wall:
000369r 2  9D rr rr       sta Board,x
00036Cr 2  E8             inx
00036Dr 2  E0 A0          cpx #BOARD_BYTES
00036Fr 2  D0 F8          bne @Wall
000371r 2               
000371r 2  A2 00          ldx #0                        ; X walks the row bases, 0, 8, 16, ...
000373r 2               @Row:
000373r 2  A9 00          lda #TILE_EMPTY               ; Reloaded every row: the TXA below eats it
000375r 2  9D rr rr 9D    .repeat BOARD_W, COL
000379r 2  rr rr 9D rr  
00037Dr 2  rr 9D rr rr  
000387r 2                   sta Board + COL, x
000387r 2                 .endrepeat
000387r 2  8A             txa
000388r 2  18             clc
000389r 2  69 08          adc #BOARD_STRIDE
00038Br 2  AA             tax
00038Cr 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
00038Er 2  90 E3          bcc @Row
000390r 2  60             rts
000391r 2               
000391r 2               ; -----------------------------------------------------------------------------
000391r 2               ;   BoardRowPtr — point Ptr1 at the start of a board row
000391r 2               ;   In:  A = row        Out: Ptr1 = &Board[row][0].  Modifies: A, Ptr1
000391r 2               ;
000391r 2               ;   Board is page-aligned and 160 bytes, so row * 8 is at most 152 and the low
000391r 2               ;   byte can never carry into the high one.
000391r 2               ; -----------------------------------------------------------------------------
000391r 2               BoardRowPtr:
000391r 2  0A             asl a
000392r 2  0A             asl a
000393r 2  0A             asl a
000394r 2  18             clc
000395r 2  69 rr          adc #<Board
000397r 2  85 rr          sta Ptr1
000399r 2  A9 rr          lda #>Board
00039Br 2  85 rr          sta Ptr1+1
00039Dr 2  60             rts
00039Er 2               
00039Er 2               ; -----------------------------------------------------------------------------
00039Er 2               ;   BoardGravityBegin / BoardGravityStep — the pile falls, one row at a time
00039Er 2               ;   SPEC 8 step 8, SPEC 14: tiles descend one row every FALL_FRAMES.
00039Er 2               ;
00039Er 2               ;   A row of falling is one pass over the board, bottom to top, moving every
00039Er 2               ;   tile that has an empty cell under it down into it. Repeat until a pass
00039Er 2               ;   moves nothing and the columns are compacted — but repeat it a row at a
00039Er 2               ;   time, because the fall is animated and a column that dropped four rows in
00039Er 2               ;   one frame would read as a teleport.
00039Er 2               ;
00039Er 2               ;   Walking BOTTOM TO TOP is what makes a whole column fall together rather
00039Er 2               ;   than one tile a frame: by the time the pass reaches a tile, the tile below
00039Er 2               ;   it has already moved and left the gap.
00039Er 2               ;
00039Er 2               ;   The pass is a CURSOR, not a loop that runs to completion (D12, SPEC 12.6).
00039Er 2               ;   Sixty tiles falling is a hundred-odd changed cells and the dirty ring holds
00039Er 2               ;   64, so the pass stops when the ring is full and picks up where it stopped
00039Er 2               ;   next frame. Nothing is dropped and the board is a legal board at every
00039Er 2               ;   point it stops — one frame's worth of columns has fallen a row and the
00039Er 2               ;   rest has not, which is a stagger nobody can see.
00039Er 2               ;
00039Er 2               ;   The two sentinel columns need no special case: a wall's "cell below" is
00039Er 2               ;   another wall, so columns 6 and 7 never move.
00039Er 2               ; -----------------------------------------------------------------------------
00039Er 2               GRAV_TOP = (BOARD_H - 1) * BOARD_STRIDE - 1     ; The last cell of row 14, the
00039Er 2                                                               ;   lowest row that can fall at
00039Er 2                                                               ;   all. Row 15 is on the floor
00039Er 2               BoardGravityBegin:
00039Er 2  A9 77          lda #GRAV_TOP
0003A0r 2  85 rr          sta GravIdx
0003A2r 2  A9 00          lda #0
0003A4r 2  85 rr          sta GravMoved
0003A6r 2  60             rts
0003A7r 2               
0003A7r 2               ; -----------------------------------------------------------------------------
0003A7r 2               ;   BoardGravityStep — carry on with the current row of falling
0003A7r 2               ;   In:  nothing
0003A7r 2               ;   Out: C set when the row is finished; GravMoved non-zero if it moved
0003A7r 2               ;        anything. Modifies: A, X, Y, GravIdx, GravMoved, RedrawCol
0003A7r 2               ; -----------------------------------------------------------------------------
0003A7r 2               BoardGravityStep:
0003A7r 2  A5 rr          lda GravIdx
0003A9r 2  30 3F          bmi @Finished                 ; $FF — the row is already done
0003ABr 2               
0003ABr 2               @Cell:
0003ABr 2  AD rr rr       lda DirtyCount                ; Room for both cells of a move, or wait for
0003AEr 2  C9 3E          cmp #(DIRTY_ENTRIES - 2)      ;   the flush. A mark dropped here would never
0003B0r 2  B0 3A          bcs @Later                    ;   be marked again (D6 is survivable only
0003B2r 2                                               ;   because nothing that MUST land uses it)
0003B2r 2               
0003B2r 2  A6 rr          ldx GravIdx
0003B4r 2  BD rr rr       lda Board,x
0003B7r 2  F0 2D          beq @Next                     ; Nothing here to fall
0003B9r 2  BD rr rr       lda Board + BOARD_STRIDE,x
0003BCr 2  D0 28          bne @Next                     ; Something under it — a tile, or the floor
0003BEr 2               
0003BEr 2  BD rr rr       lda Board,x                   ; Move it down one row
0003C1r 2  9D rr rr       sta Board + BOARD_STRIDE,x
0003C4r 2  A9 00          lda #TILE_EMPTY
0003C6r 2  9D rr rr       sta Board,x
0003C9r 2  E6 rr          inc GravMoved
0003CBr 2               
0003CBr 2  A5 rr          lda GravIdx                   ; The cell it LEFT only needs redrawing if it
0003CDr 2  C9 08          cmp #BOARD_STRIDE             ;   is going to stay empty. If there is a tile
0003CFr 2  90 07          bcc @Vacated                  ;   above it, that tile lands here later in
0003D1r 2  A6 rr          ldx GravIdx                   ;   this same pass and its own arrival mark
0003D3r 2  BD rr rr       lda Board - BOARD_STRIDE,x    ;   covers the cell. Half the marks of a
0003D6r 2  D0 05          bne @Arrived                  ;   sliding column, which is what the ring
0003D8r 2               @Vacated:                       ;   pressure is made of.
0003D8r 2  A6 rr          ldx GravIdx
0003DAr 2  20 rr rr       jsr RenderCell
0003DDr 2               @Arrived:
0003DDr 2  A5 rr          lda GravIdx
0003DFr 2  18             clc
0003E0r 2  69 08          adc #BOARD_STRIDE
0003E2r 2  AA             tax
0003E3r 2  20 rr rr       jsr RenderCell
0003E6r 2               
0003E6r 2               @Next:
0003E6r 2  C6 rr          dec GravIdx                   ; Down to 0, then $FF, which ends the pass —
0003E8r 2  10 C1          bpl @Cell                     ;   GRAV_TOP is 119, so bit 7 starts clear
0003EAr 2                                               ;   (see PLAN.md section 3)
0003EAr 2               @Finished:
0003EAr 2  38             sec
0003EBr 2  60             rts
0003ECr 2               
0003ECr 2               @Later:
0003ECr 2  18             clc                           ; Ring full: the rest of this row waits a frame
0003EDr 2  60             rts
0003EEr 2               
0003EEr 1               .include "../src/piece.asm"
0003EEr 2               ; =============================================================================
0003EEr 2               ;   piece.asm — Wizards Lab, the falling piece
0003EEr 2               ; =============================================================================
0003EEr 2               ;   SPEC.md section 5. A piece is three independently generated cells stacked
0003EEr 2               ;   vertically, A on top. At most one of the three carries a reagent, which is
0003EEr 2               ;   enforced by rolling once for the piece rather than once per cell.
0003EEr 2               ;
0003EEr 2               ;   The piece is NOT in the board while it falls. Board cells under it stay
0003EEr 2               ;   empty until PieceLock writes them, which is what makes the movement tests
0003EEr 2               ;   below a plain read of the three target cells and what lets the erase be
0003EEr 2               ;   three blanks rather than three board reads.
0003EEr 2               ;
0003EEr 2               ;   Nothing here draws. Every routine that changes where the piece is or what
0003EEr 2               ;   it holds sets PieceDirty and lets StatePlay pick the moment (D14).
0003EEr 2               ; =============================================================================
0003EEr 2               
0003EEr 2               ; -----------------------------------------------------------------------------
0003EEr 2               ;   PieceIndex — board index of the piece's top cell
0003EEr 2               ;   In:  nothing
0003EEr 2               ;   Out: A = X = PieceRow * BOARD_STRIDE + PieceCol.  Modifies: A, X
0003EEr 2               ;
0003EEr 2               ;   Cells B and C are one and two strides on from it, and the cell below C is
0003EEr 2               ;   three — which is the only address arithmetic the rest of this file needs.
0003EEr 2               ;   Row 16 and beyond is a wall row, so "below C" is always a legal read.
0003EEr 2               ; -----------------------------------------------------------------------------
0003EEr 2               PieceIndex:
0003EEr 2  AD rr rr       lda PieceRow
0003F1r 2  0A             asl a
0003F2r 2  0A             asl a
0003F3r 2  0A             asl a                         ; row * 8
0003F4r 2  18             clc
0003F5r 2  6D rr rr       adc PieceCol
0003F8r 2  AA             tax
0003F9r 2  60             rts
0003FAr 2               
0003FAr 2               ; -----------------------------------------------------------------------------
0003FAr 2               ;   PieceGenerateNext — roll the preview piece into NextA/NextB/NextC
0003FAr 2               ;   In:  nothing (reads Level)
0003FAr 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0, Tmp1
0003FAr 2               ;   SPEC 5.2, 5.3 — colours uniform over 0-5, then one reagent roll.
0003FAr 2               ; -----------------------------------------------------------------------------
0003FAr 2               PieceGenerateNext:
0003FAr 2  A0 00          ldy #0                        ; RngRange preserves Y, so it can index the
0003FCr 2               @Color:                         ;   three cells across the call
0003FCr 2  A9 06          lda #NUM_COLORS
0003FEr 2  20 rr rr       jsr RngRange                  ; 0-5, uniform (SPEC 5.2)
000401r 2  0A             asl a
000402r 2  0A             asl a
000403r 2  0A             asl a                         ; colour << 3 ...
000404r 2  18             clc
000405r 2  69 40          adc #COLOR_BASE               ;   ... + base, glyph 0, so it is a potion
000407r 2  99 rr rr       sta NextA,y                   ; NextA/B/C are three consecutive bytes
00040Ar 2  C8             iny
00040Br 2  C0 03          cpy #3
00040Dr 2  90 ED          bcc @Color
00040Fr 2               
00040Fr 2                 ; --- does this piece carry a reagent at all? (SPEC 5.3) -------------------
00040Fr 2                 ;   One roll for the whole piece, which both caps it at one reagent and
00040Fr 2                 ;   costs three rolls fewer than asking each cell.
00040Fr 2  20 rr rr       jsr RngNext
000412r 2  85 rr          sta Tmp0                      ; The roll. Nothing below calls out until it
000414r 2                                               ;   has been compared, so Tmp0 is safe.
000414r 2  AE rr rr       ldx Level
000417r 2  CA             dex                           ; LevelBand is indexed by level - 1 ...
000418r 2  E0 10          cpx #16
00041Ar 2  90 02          bcc @Band
00041Cr 2  A2 0F          ldx #15                       ;   ... and clamped: band 4 is "13 and up"
00041Er 2               @Band:
00041Er 2  BD rr rr       lda LevelBand,x
000421r 2  AA             tax                           ; X = band 0-4
000422r 2  A5 rr          lda Tmp0
000424r 2  DD rr rr       cmp PSpecial,x                ; C clear = the roll came in under the chance
000427r 2  B0 2E          bcs @Done
000429r 2               
000429r 2                 ; --- which cell, and which reagent ----------------------------------------
000429r 2  8A             txa
00042Ar 2  48             pha                           ; The band, across the cell roll
00042Br 2  A9 03          lda #3
00042Dr 2  20 rr rr       jsr RngRange                  ; 0, 1 or 2 — uniform over A, B and C
000430r 2  A8             tay                           ; Y survives the type roll below
000431r 2  68             pla
000432r 2  0A             asl a
000433r 2  0A             asl a                         ; band * 4 — ReagentThresholds is four
000434r 2  48             pha                           ;   thresholds per band
000435r 2  20 rr rr       jsr RngNext
000438r 2  85 rr          sta Tmp0                      ; The type roll
00043Ar 2  68             pla
00043Br 2  AA             tax
00043Cr 2  A5 rr          lda Tmp0
00043Er 2               
00043Er 2  DD rr rr       cmp ReagentThresholds+0,x     ; The cumulative-weight compare chain SPEC 5.3
000441r 2  90 15          bcc @Fireball                 ;   recommends over a 1280-byte lookup
000443r 2  DD rr rr       cmp ReagentThresholds+1,x
000446r 2  90 14          bcc @Bolt
000448r 2  DD rr rr       cmp ReagentThresholds+2,x
00044Br 2  90 13          bcc @Bomb
00044Dr 2  DD rr rr       cmp ReagentThresholds+3,x
000450r 2  90 12          bcc @Star
000452r 2               
000452r 2  A9 70          lda #WILD_BASE                ; A Prism discards the colour it rolled and
000454r 2  99 rr rr       sta NextA,y                   ;   joins group 14 (SPEC 5.2)
000457r 2               @Done:
000457r 2  60             rts
000458r 2               
000458r 2               @Fireball:
000458r 2  A9 01          lda #GLYPH_FIREBALL
00045Ar 2  D0 0A          bne @Apply                    ; Always — every glyph below is non-zero
00045Cr 2               @Bolt:
00045Cr 2  A9 02          lda #GLYPH_BOLT
00045Er 2  D0 06          bne @Apply
000460r 2               @Bomb:
000460r 2  A9 03          lda #GLYPH_BOMB
000462r 2  D0 02          bne @Apply
000464r 2               @Star:
000464r 2  A9 04          lda #GLYPH_STAR
000466r 2               @Apply:
000466r 2  19 rr rr       ora NextA,y                   ; The cell's glyph nibble is 0, so an ORA sets
000469r 2  99 rr rr       sta NextA,y                   ;   the reagent and keeps the rolled colour
00046Cr 2  60             rts
00046Dr 2               
00046Dr 2               ; -----------------------------------------------------------------------------
00046Dr 2               ;   PieceSpawn — promote the preview to the falling piece
00046Dr 2               ;   In:  nothing
00046Dr 2               ;   Out: C set if the spawn cells were occupied (game over)
00046Dr 2               ;        Modifies: A, X
00046Dr 2               ;   SPEC 5.4 — spawn column SPAWN_COL, rows 0-2, visible immediately.
00046Dr 2               ;
00046Dr 2               ;   The preview is copied whether or not the spawn succeeds; on a blocked
00046Dr 2               ;   spawn nothing looks at the piece again.
00046Dr 2               ; -----------------------------------------------------------------------------
00046Dr 2               PieceSpawn:
00046Dr 2  AD rr rr       lda NextA
000470r 2  8D rr rr       sta PieceA
000473r 2  AD rr rr       lda NextB
000476r 2  8D rr rr       sta PieceB
000479r 2  AD rr rr       lda NextC
00047Cr 2  8D rr rr       sta PieceC
00047Fr 2               
00047Fr 2  A9 02          lda #SPAWN_COL
000481r 2  8D rr rr       sta PieceCol
000484r 2  A9 00          lda #0
000486r 2  8D rr rr       sta PieceRow
000489r 2  8D rr rr       sta LockTimer
00048Cr 2  8D rr rr       sta LockResets                ; The reset allowance is per piece (SPEC 5.6)
00048Fr 2               
00048Fr 2  AD rr rr       lda Board + 0 * BOARD_STRIDE + SPAWN_COL
000492r 2  0D rr rr       ora Board + 1 * BOARD_STRIDE + SPAWN_COL
000495r 2  0D rr rr       ora Board + 2 * BOARD_STRIDE + SPAWN_COL
000498r 2  D0 0D          bne @Blocked
00049Ar 2               
00049Ar 2  20 rr rr       jsr ScoreGravity
00049Dr 2  8D rr rr       sta GravityTimer
0004A0r 2  A9 01          lda #1
0004A2r 2  8D rr rr       sta PieceDirty                ; Drawn immediately — there is no off-screen
0004A5r 2  18             clc                           ;   entry (SPEC 5.4)
0004A6r 2  60             rts
0004A7r 2               
0004A7r 2               @Blocked:
0004A7r 2  38             sec
0004A8r 2  60             rts
0004A9r 2               
0004A9r 2               ; -----------------------------------------------------------------------------
0004A9r 2               ;   PieceMoveLeft / PieceMoveRight — one column, if all three cells are free
0004A9r 2               ;   Out: C set if the move happened (the caller resets the lock timer).
0004A9r 2               ;        Modifies: A, X
0004A9r 2               ;   SPEC 5.5 — no wall kicks; a 1-wide piece has nothing to kick off.
0004A9r 2               ;
0004A9r 2               ;   The right edge needs no bounds check: column 6 is a permanent $FF sentinel
0004A9r 2               ;   and fails the emptiness test on its own (SPEC 3.2). The LEFT edge does,
0004A9r 2               ;   because column -1 of row 0 is the byte before a page-aligned Board and
0004A9r 2               ;   belongs to nobody.
0004A9r 2               ; -----------------------------------------------------------------------------
0004A9r 2               PieceMoveLeft:
0004A9r 2  AD rr rr       lda PieceCol
0004ACr 2  F0 18          beq @No                       ; Column 0 — there is no sentinel to the left
0004AEr 2  20 rr rr       jsr PieceIndex
0004B1r 2  CA             dex
0004B2r 2  BD rr rr       lda Board + 0 * BOARD_STRIDE,x
0004B5r 2  1D rr rr       ora Board + 1 * BOARD_STRIDE,x
0004B8r 2  1D rr rr       ora Board + 2 * BOARD_STRIDE,x
0004BBr 2  D0 09          bne @No
0004BDr 2  20 rr rr       jsr RenderPieceErase
0004C0r 2  CE rr rr       dec PieceCol
0004C3r 2  4C rr rr       jmp PieceMoved
0004C6r 2               
0004C6r 2               @No:
0004C6r 2  18             clc
0004C7r 2  60             rts
0004C8r 2               
0004C8r 2               PieceMoveRight:
0004C8r 2  20 rr rr       jsr PieceIndex
0004CBr 2  E8             inx
0004CCr 2  BD rr rr       lda Board + 0 * BOARD_STRIDE,x
0004CFr 2  1D rr rr       ora Board + 1 * BOARD_STRIDE,x
0004D2r 2  1D rr rr       ora Board + 2 * BOARD_STRIDE,x
0004D5r 2  D0 09          bne @No
0004D7r 2  20 rr rr       jsr RenderPieceErase
0004DAr 2  EE rr rr       inc PieceCol
0004DDr 2  4C rr rr       jmp PieceMoved
0004E0r 2               @No:
0004E0r 2  18             clc
0004E1r 2  60             rts
0004E2r 2               
0004E2r 2               ; -----------------------------------------------------------------------------
0004E2r 2               ;   PieceMoved — mark the piece for redraw and report success
0004E2r 2               ;   Out: C set.  Modifies: A
0004E2r 2               ; -----------------------------------------------------------------------------
0004E2r 2               PieceMoved:
0004E2r 2  A9 01          lda #1
0004E4r 2  8D rr rr       sta PieceDirty
0004E7r 2  38             sec
0004E8r 2  60             rts
0004E9r 2               
0004E9r 2               ; -----------------------------------------------------------------------------
0004E9r 2               ;   PieceRotate / PieceRotateBack — cycle the three cells
0004E9r 2               ;   Out: nothing.  Modifies: A, X
0004E9r 2               ;   SPEC 5.5 — (A,B,C) -> (B,C,A) forward, (C,A,B) back. Always succeeds: the
0004E9r 2               ;   footprint never changes, so there is nothing to test and nothing to erase.
0004E9r 2               ;   Rotation does not reset the lock delay (SPEC 5.6).
0004E9r 2               ; -----------------------------------------------------------------------------
0004E9r 2               PieceRotate:
0004E9r 2  AD rr rr       lda PieceA
0004ECr 2  AE rr rr       ldx PieceB
0004EFr 2  8E rr rr       stx PieceA
0004F2r 2  AE rr rr       ldx PieceC
0004F5r 2  8E rr rr       stx PieceB
0004F8r 2  8D rr rr       sta PieceC
0004FBr 2  A9 01          lda #1
0004FDr 2  8D rr rr       sta PieceDirty
000500r 2  60             rts
000501r 2               
000501r 2               PieceRotateBack:
000501r 2  AD rr rr       lda PieceC
000504r 2  AE rr rr       ldx PieceB
000507r 2  8E rr rr       stx PieceC
00050Ar 2  AE rr rr       ldx PieceA
00050Dr 2  8E rr rr       stx PieceB
000510r 2  8D rr rr       sta PieceA
000513r 2  A9 01          lda #1
000515r 2  8D rr rr       sta PieceDirty
000518r 2  60             rts
000519r 2               
000519r 2               ; -----------------------------------------------------------------------------
000519r 2               ;   PieceCanFall — is the cell below C free?
000519r 2               ;   Out: C set if the piece can descend one row.  Modifies: A, X
000519r 2               ;   Three strides past cell A. With C on row 15 that reads row 18, which is a
000519r 2               ;   permanent wall row, so the floor needs no special case (SPEC 3.2).
000519r 2               ; -----------------------------------------------------------------------------
000519r 2               PieceCanFall:
000519r 2  20 rr rr       jsr PieceIndex
00051Cr 2  BD rr rr       lda Board + 3 * BOARD_STRIDE,x
00051Fr 2  D0 02          bne @No
000521r 2  38             sec
000522r 2  60             rts
000523r 2               @No:
000523r 2  18             clc
000524r 2  60             rts
000525r 2               
000525r 2               ; -----------------------------------------------------------------------------
000525r 2               ;   PieceStep — one row of gravity
000525r 2               ;   Out: C set if the piece has landed and the lock delay should start.
000525r 2               ;        Modifies: A, X
000525r 2               ; -----------------------------------------------------------------------------
000525r 2               PieceStep:
000525r 2  20 rr rr       jsr PieceCanFall
000528r 2  90 0B          bcc @Landed
00052Ar 2  20 rr rr       jsr RenderPieceErase
00052Dr 2  EE rr rr       inc PieceRow
000530r 2  20 rr rr       jsr PieceMoved
000533r 2  18             clc                           ; Moved, so it has not landed
000534r 2  60             rts
000535r 2               @Landed:
000535r 2  38             sec
000536r 2  60             rts
000537r 2               
000537r 2               ; -----------------------------------------------------------------------------
000537r 2               ;   PieceLock — write the three cells into the board
000537r 2               ;   Out: nothing.  Modifies: A, X, Y
000537r 2               ;   SPEC 5.6 — after this the caller runs a cascade.
000537r 2               ;
000537r 2               ;   Once the board holds the piece, drawing the piece and drawing those three
000537r 2               ;   board cells are the same three writes, so RenderPiece does the queueing.
000537r 2               ; -----------------------------------------------------------------------------
000537r 2               PieceLock:
000537r 2  20 rr rr       jsr PieceIndex
00053Ar 2  AD rr rr       lda PieceA
00053Dr 2  9D rr rr       sta Board + 0 * BOARD_STRIDE,x
000540r 2  AD rr rr       lda PieceB
000543r 2  9D rr rr       sta Board + 1 * BOARD_STRIDE,x
000546r 2  AD rr rr       lda PieceC
000549r 2  9D rr rr       sta Board + 2 * BOARD_STRIDE,x
00054Cr 2               
00054Cr 2  20 rr rr       jsr RenderPiece
00054Fr 2  A9 00          lda #0
000551r 2  8D rr rr       sta PieceDirty                ; It is board now; nothing owes it a redraw
000554r 2  60             rts
000555r 2               
000555r 2               ; -----------------------------------------------------------------------------
000555r 2               ;   PieceFallRate — frames per row for this frame
000555r 2               ;   Out: A = frame count, C CLEAR if that rate is the soft drop's.
000555r 2               ;        Modifies: A, X, Tmp0
000555r 2               ;   SPEC 5.5, 11.3 — soft drop substitutes its own rate and is ignored when
000555r 2               ;   gravity is already the faster of the two (levels 14+ on NTSC).
000555r 2               ;
000555r 2               ;   The carry is what pays for the soft drop: SPEC 9.6 gives a point per row
000555r 2               ;   "descended under soft drop", and a row that fell at gravity's rate with
000555r 2               ;   DOWN held down was not one, so holding DOWN at level 16 earns nothing.
000555r 2               ;   Working it out here costs nothing — the comparison has already happened.
000555r 2               ; -----------------------------------------------------------------------------
000555r 2               PieceFallRate:
000555r 2  20 rr rr       jsr ScoreGravity              ; Speed[level] for this region
000558r 2  85 rr          sta Tmp0
00055Ar 2  AD rr rr       lda InputNow
00055Dr 2  29 02          and #INPUT_DOWN
00055Fr 2  F0 0A          beq @Gravity
000561r 2  AE rr rr       ldx Region
000564r 2  BD rr rr       lda SoftDropRate,x
000567r 2  C5 rr          cmp Tmp0                      ; C clear = soft drop is the faster
000569r 2  90 04          bcc @Soft
00056Br 2               @Gravity:
00056Br 2  A5 rr          lda Tmp0
00056Dr 2  38             sec
00056Er 2  60             rts
00056Fr 2               @Soft:
00056Fr 2  18             clc
000570r 2  60             rts
000571r 2               
000571r 2               ; -----------------------------------------------------------------------------
000571r 2               ;   PieceControl — apply this frame's input to the piece
000571r 2               ;   Out: C set if a horizontal move succeeded (the caller may reset the lock
000571r 2               ;        delay).  Modifies: A, X, Y
000571r 2               ;
000571r 2               ;   Rotation is edge triggered and never repeats: UP has to be released and
000571r 2               ;   pressed again. SPEC 11.3 calls that non-negotiable and it is — a
000571r 2               ;   repeating rotate makes a three-cell piece impossible to aim. Left and
000571r 2               ;   right go through InputShift, which is where the repeat lives.
000571r 2               ; -----------------------------------------------------------------------------
000571r 2               PieceControl:
000571r 2  AD rr rr       lda InputEdge
000574r 2  29 01          and #INPUT_UP
000576r 2  F0 03          beq @NoRotate
000578r 2  20 rr rr       jsr PieceRotate
00057Br 2               @NoRotate:
00057Br 2  AD rr rr       lda InputEdge
00057Er 2  29 10          and #INPUT_FIRE
000580r 2  F0 03          beq @NoBack
000582r 2  20 rr rr       jsr PieceRotateBack
000585r 2               @NoBack:
000585r 2  20 rr rr       jsr InputShift
000588r 2  C9 04          cmp #INPUT_LEFT
00058Ar 2  F0 06          beq @Left
00058Cr 2  C9 08          cmp #INPUT_RIGHT
00058Er 2  F0 05          beq @Right
000590r 2  18             clc
000591r 2  60             rts
000592r 2               @Left:
000592r 2  4C rr rr       jmp PieceMoveLeft
000595r 2               @Right:
000595r 2  4C rr rr       jmp PieceMoveRight
000598r 2               
000598r 1               .include "../src/match.asm"
000598r 2               ; =============================================================================
000598r 2               ;   match.asm — Wizards Lab, the match scanner
000598r 2               ; =============================================================================
000598r 2               ;   SPEC.md section 6. Four passes — horizontal, vertical, and both diagonals —
000598r 2               ;   each walking its axis and tracking a run colour and length. A run of three
000598r 2               ;   or more sets the MARK bit for each of its cells.
000598r 2               ;
000598r 2               ;   Colour comparison is the whole trick:
000598r 2               ;
000598r 2               ;       lda cell
000598r 2               ;       and #COLOR_MASK         ; the low three bits are the glyph, ignore them
000598r 2               ;       cmp ScanColor
000598r 2               ;
000598r 2               ;   which is why a red potion, a red fireball and a red star all match. The
000598r 2               ;   glyph decides what happens on removal, never whether cells match.
000598r 2               ;
000598r 2               ;   Wildcards (SPEC 6.3): a WILD cell continues any run. If the run has no
000598r 2               ;   colour yet it stays unset and is adopted from the first non-wild cell, so
000598r 2               ;   one prism can close a red horizontal run and a blue vertical run at once.
000598r 2               ;
000598r 2               ;   THE FOUR PASSES ARE ONE LOOP. A line is a start cell and a step, and the
000598r 2               ;   step is the only thing that differs: +1 across, +8 down, +9 down-right,
000598r 2               ;   +7 down-left. Every one of them ends on a sentinel rather than on a bounds
000598r 2               ;   check, which is what the 8-byte stride was bought for (SPEC 3.2):
000598r 2               ;
000598r 2               ;     across   from column 5, +1 lands on column 6      — wall
000598r 2               ;     down     from row 15,   +8 lands on row 16        — wall row
000598r 2               ;     down-r   from column 5, +9 lands on row+1 col 6   — wall
000598r 2               ;     down-l   from column 0, +7 lands on THIS row's column 7 — wall
000598r 2               ;
000598r 2               ;   The last one is the reason the left edge needs no test either: the byte
000598r 2               ;   before column 0 belongs to the row above, and it is already a wall.
000598r 2               ; =============================================================================
000598r 2               
000598r 2               ; -----------------------------------------------------------------------------
000598r 2               ;   MatchScan — find every run on the board
000598r 2               ;   In:  nothing
000598r 2               ;   Out: Marks filled, RunCount set, Z set if nothing matched.
000598r 2               ;        Modifies: A, X, Y, Scan*
000598r 2               ; -----------------------------------------------------------------------------
000598r 2               MatchScan:
000598r 2  20 rr rr       jsr MarksClear
00059Br 2  A9 00          lda #0
00059Dr 2  8D rr rr       sta RunCount
0005A0r 2               
0005A0r 2  20 rr rr       jsr ScanFindTop               ; Everything below skips the empty air above
0005A3r 2  A5 rr          lda ScanTop                   ;   the pile, which on most boards is most of
0005A5r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE) ;   the board
0005A7r 2  B0 0C          bcs @Done                     ; Nothing on the board at all
0005A9r 2               
0005A9r 2  20 rr rr       jsr MatchScanHorizontal
0005ACr 2  20 rr rr       jsr MatchScanVertical
0005AFr 2  20 rr rr       jsr MatchScanDiagonal
0005B2r 2  20 rr rr       jsr MatchScanAntiDiagonal
0005B5r 2               @Done:
0005B5r 2  AD rr rr       lda RunCount                  ; Z set when nothing matched
0005B8r 2  60             rts
0005B9r 2               
0005B9r 2               ; -----------------------------------------------------------------------------
0005B9r 2               ;   ScanFindTop — board index of the first row that holds anything
0005B9r 2               ;   Out: ScanTop = row base, or BOARD_H * BOARD_STRIDE if the board is empty.
0005B9r 2               ;        Modifies: A, X, ScanTop
0005B9r 2               ;
0005B9r 2               ;   Every pass below starts here instead of at row 0. A pile six rows deep is
0005B9r 2               ;   scanned as six rows: 178 cells against 448, and the four passes come in
0005B9r 2               ;   under a third of the frame instead of over two whole ones. Finding it costs
0005B9r 2               ;   about 45 cycles a row of empty air, which is the cheapest part of the scan.
0005B9r 2               ;
0005B9r 2               ;   Correct as well as quick, and for a reason worth writing down: a line that
0005B9r 2               ;   reaches the pile at all must CROSS the pile's top row, because every one of
0005B9r 2               ;   the four steps moves down at most one row at a time. Starting the diagonals
0005B9r 2               ;   on that row rather than on row 0 therefore misses nothing.
0005B9r 2               ; -----------------------------------------------------------------------------
0005B9r 2               ScanFindTop:
0005B9r 2  A2 00          ldx #0
0005BBr 2               @Row:
0005BBr 2  BD rr rr       lda Board + 0,x               ; The six playfield columns; the two sentinel
0005BEr 2  1D rr rr       ora Board + 1,x               ;   ones would make every row look occupied
0005C1r 2  1D rr rr       ora Board + 2,x
0005C4r 2  1D rr rr       ora Board + 3,x
0005C7r 2  1D rr rr       ora Board + 4,x
0005CAr 2  1D rr rr       ora Board + 5,x
0005CDr 2  D0 09          bne @Found
0005CFr 2  8A             txa
0005D0r 2  18             clc
0005D1r 2  69 08          adc #BOARD_STRIDE
0005D3r 2  AA             tax
0005D4r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
0005D6r 2  90 E3          bcc @Row
0005D8r 2               @Found:
0005D8r 2  86 rr          stx ScanTop
0005DAr 2  60             rts
0005DBr 2               
0005DBr 2               ; -----------------------------------------------------------------------------
0005DBr 2               ;   The four passes (SPEC 6.2). Each sets a step and hands ScanLine its start
0005DBr 2               ;   cells; the start cell rides the stack because ScanLine needs both index
0005DBr 2               ;   registers and the scratch bytes below it.
0005DBr 2               ; -----------------------------------------------------------------------------
0005DBr 2               MatchScanHorizontal:            ; Every row of the pile, column 0 rightward
0005DBr 2  A9 01          lda #1
0005DDr 2  85 rr          sta ScanStep
0005DFr 2  A5 rr          lda ScanTop
0005E1r 2               @Line:
0005E1r 2  48             pha
0005E2r 2  20 rr rr       jsr ScanLine
0005E5r 2  68             pla
0005E6r 2  18             clc
0005E7r 2  69 08          adc #BOARD_STRIDE
0005E9r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
0005EBr 2  90 F4          bcc @Line
0005EDr 2  60             rts
0005EEr 2               
0005EEr 2               MatchScanVertical:              ; 6 columns, top of the pile downward
0005EEr 2  A9 08          lda #BOARD_STRIDE
0005F0r 2  85 rr          sta ScanStep
0005F2r 2  4C rr rr       jmp ScanTopRow
0005F5r 2               
0005F5r 2               MatchScanDiagonal:              ; down-right: the top row, then the left edge
0005F5r 2  A9 09          lda #(BOARD_STRIDE + 1)
0005F7r 2  85 rr          sta ScanStep
0005F9r 2  20 rr rr       jsr ScanTopRow
0005FCr 2  A9 00          lda #0
0005FEr 2  4C rr rr       jmp ScanEdgeColumn
000601r 2               
000601r 2               MatchScanAntiDiagonal:          ; down-left: the top row, then the right edge
000601r 2  A9 07          lda #(BOARD_STRIDE - 1)
000603r 2  85 rr          sta ScanStep
000605r 2  20 rr rr       jsr ScanTopRow
000608r 2  A9 05          lda #(BOARD_W - 1)
00060Ar 2  4C rr rr       jmp ScanEdgeColumn
00060Dr 2               
00060Dr 2               ; -----------------------------------------------------------------------------
00060Dr 2               ;   ScanTopRow — scan a line from each of the six cells of the pile's top row
00060Dr 2               ;   ScanEdgeColumn — and from the rows below it, in the column in A
00060Dr 2               ;   In:  ScanStep set, ScanTop set; A = column (ScanEdgeColumn only)
00060Dr 2               ;
00060Dr 2               ;   Between them those are every start cell a diagonal needs, and the top row
00060Dr 2               ;   alone is every start cell the vertical pass needs. The top row is scanned
00060Dr 2               ;   by the first, so the second skips it rather than scanning the longest
00060Dr 2               ;   diagonal twice.
00060Dr 2               ; -----------------------------------------------------------------------------
00060Dr 2               ScanTopRow:
00060Dr 2  A5 rr          lda ScanTop
00060Fr 2               @Line:
00060Fr 2  48             pha
000610r 2  20 rr rr       jsr ScanLine
000613r 2  68             pla
000614r 2  18             clc
000615r 2  69 01          adc #1
000617r 2  48             pha                           ; Six columns of that row, whichever row it
000618r 2  29 07          and #(BOARD_STRIDE - 1)       ;   is, so it is the COLUMN that ends the loop
00061Ar 2  C9 06          cmp #BOARD_W                  ;   and not the index
00061Cr 2  68             pla                           ; PLA leaves C alone
00061Dr 2  90 F0          bcc @Line
00061Fr 2  60             rts
000620r 2               
000620r 2               ScanEdgeColumn:
000620r 2  18             clc
000621r 2  65 rr          adc ScanTop                   ; That column, on the pile's top row...
000623r 2  18             clc
000624r 2  69 08          adc #BOARD_STRIDE             ;   ...and then the row below it
000626r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000628r 2  B0 0C          bcs @Done                     ; The pile is one row deep — there is no below
00062Ar 2               @Line:
00062Ar 2  48             pha
00062Br 2  20 rr rr       jsr ScanLine
00062Er 2  68             pla
00062Fr 2  18             clc
000630r 2  69 08          adc #BOARD_STRIDE
000632r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000634r 2  90 F4          bcc @Line
000636r 2               @Done:
000636r 2  60             rts
000637r 2               
000637r 2               ; -----------------------------------------------------------------------------
000637r 2               ;   ScanLine — walk one line, marking every run of MATCH_MIN or more
000637r 2               ;   In:  A = start board index, ScanStep = direction
000637r 2               ;   Out: nothing.  Modifies: A, X, Scan*, Marks, RunCount
000637r 2               ;
000637r 2               ;   ONLY A WALL ENDS THE LINE. A hole in the middle of a row breaks the run
000637r 2               ;   and the walk carries on past it, because the cells beyond it are a run of
000637r 2               ;   their own — a line that stopped at the first empty cell would never look
000637r 2               ;   below the top of the pile at all, which is very nearly the whole board.
000637r 2               ;
000637r 2               ;   A colour change ends the run and starts a new one at the cell that broke
000637r 2               ;   it — the cell that broke a red run is the first cell of the blue one, and
000637r 2               ;   any prisms that were riding the red run stay with the red run. SPEC 6.3
000637r 2               ;   gives a wildcard to the run it is already in, not to both.
000637r 2               ; -----------------------------------------------------------------------------
000637r 2               ScanLine:
000637r 2  AA             tax                           ; The cursor lives in X for the whole line:
000638r 2  A9 FF          lda #$FF                      ;   this loop runs about four hundred times a
00063Ar 2  85 rr          sta ScanColor                 ;   scan and every cycle in it is four hundred
00063Cr 2  A9 00          lda #0                        ;   cycles of the frame
00063Er 2  85 rr          sta ScanLen
000640r 2               
000640r 2               @Cell:
000640r 2  BD rr rr       lda Board,x
000643r 2  F0 41          beq @Gap                      ; A hole breaks the run, not the line
000645r 2  C9 FF          cmp #TILE_WALL
000647r 2  F0 52          beq @End                      ; A wall is where the line stops
000649r 2  29 F8          and #COLOR_MASK               ; The colour key, glyph discarded (SPEC 4.2)
00064Br 2  C5 rr          cmp ScanColor
00064Dr 2  F0 19          beq @Grow                     ; Same colour — the commonest case, first
00064Fr 2  C9 70          cmp #WILD_BASE
000651r 2  F0 15          beq @Grow                     ; A prism continues any run (SPEC 6.3)
000653r 2               
000653r 2  A8             tay                           ; A different colour. Park it: everything
000654r 2  A5 rr          lda ScanColor                 ;   below either adopts it or starts a run
000656r 2  30 0E          bmi @Adopt                    ;   with it. $FF is the only value here with
000658r 2                                               ;   bit 7 set — colours are $40 to $70
000658r 2  A5 rr          lda ScanLen
00065Ar 2  C9 03          cmp #MATCH_MIN
00065Cr 2  B0 14          bcs @Close                    ; The run it broke was long enough to mark
00065Er 2               
00065Er 2  84 rr          sty ScanColor                 ; It was not, so no call and no marking: this
000660r 2  A9 01          lda #1                        ;   cell is simply the start of the next run.
000662r 2  85 rr          sta ScanLen                   ;   Five adjacent cells in six differ in
000664r 2  D0 04          bne @Advance                  ;   colour, so this is the path that decides
000666r 2                                               ;   what a scan costs
000666r 2               @Adopt:
000666r 2  84 rr          sty ScanColor
000668r 2               @Grow:
000668r 2  E6 rr          inc ScanLen
00066Ar 2               @Advance:
00066Ar 2  8A             txa
00066Br 2  18             clc
00066Cr 2  65 rr          adc ScanStep
00066Er 2  AA             tax
00066Fr 2  4C rr rr       jmp @Cell
000672r 2               
000672r 2               @Close:
000672r 2  86 rr          stx ScanIdx
000674r 2  20 rr rr       jsr MatchEmit                 ; Mark it — and MatchEmit leaves ScanLen zero
000677r 2  A6 rr          ldx ScanIdx
000679r 2  BD rr rr       lda Board,x
00067Cr 2  29 F8          and #COLOR_MASK
00067Er 2  85 rr          sta ScanColor
000680r 2  A9 01          lda #1
000682r 2  85 rr          sta ScanLen
000684r 2  D0 E4          bne @Advance                  ; Always
000686r 2               
000686r 2               @Gap:
000686r 2  A5 rr          lda ScanLen
000688r 2  F0 E0          beq @Advance                  ; Nothing running — step over the hole. This
00068Ar 2                                               ;   is the cell the scan meets most often, so
00068Ar 2                                               ;   it is the one that must not call anything
00068Ar 2  86 rr          stx ScanIdx
00068Cr 2  20 rr rr       jsr MatchEmit                 ; Close the run the hole broke...
00068Fr 2  A6 rr          ldx ScanIdx
000691r 2  A9 FF          lda #$FF
000693r 2  85 rr          sta ScanColor                 ;   ...and start again on the far side of it
000695r 2  A9 00          lda #0
000697r 2  85 rr          sta ScanLen
000699r 2  F0 CF          beq @Advance                  ; Always
00069Br 2               
00069Br 2               @End:
00069Br 2  A5 rr          lda ScanLen
00069Dr 2  F0 05          beq @Nothing                  ; The line ran out with nothing in hand
00069Fr 2  86 rr          stx ScanIdx
0006A1r 2  4C rr rr       jmp MatchEmit                 ; Whatever was running ends with the line
0006A4r 2               @Nothing:
0006A4r 2  60             rts
0006A5r 2               
0006A5r 2               ; -----------------------------------------------------------------------------
0006A5r 2               ;   MatchEmit — a run has ended; mark it if it was long enough
0006A5r 2               ;   In:  ScanIdx = one cell PAST the run's last, ScanLen, ScanColor, ScanStep
0006A5r 2               ;   Out: nothing.  Modifies: A, X, Y, ScanEnd, ScanLen, RunCount, Marks
0006A5r 2               ;
0006A5r 2               ;   Runs are marked, not removed: a cell can be in a horizontal run and a
0006A5r 2               ;   vertical one at once, and it clears once while both runs score (SPEC 6.1).
0006A5r 2               ;   The union is what the MARKS bitmap is for.
0006A5r 2               ;
0006A5r 2               ;   SCORING HAPPENS HERE, before the mark loop and for the same reason the
0006A5r 2               ;   comment above used to promise it would: ScanLen still describes the run at
0006A5r 2               ;   this point and nowhere else, because the mark loop counts it down to zero
0006A5r 2               ;   on its way back along the line. MatchScoreRun leaves it alone.
0006A5r 2               ; -----------------------------------------------------------------------------
0006A5r 2               MatchEmit:
0006A5r 2  A5 rr          lda ScanLen
0006A7r 2  C9 03          cmp #MATCH_MIN
0006A9r 2  90 1D          bcc @Done                     ; Two in a row is not a run
0006ABr 2               
0006ABr 2  EE rr rr       inc RunCount
0006AEr 2  20 rr rr       jsr MatchScoreRun             ; SPEC 8 step 2, per run
0006B1r 2  A5 rr          lda ScanIdx
0006B3r 2  38             sec
0006B4r 2  E5 rr          sbc ScanStep                  ; Back onto the run's last cell
0006B6r 2  85 rr          sta ScanEnd
0006B8r 2               @Mark:
0006B8r 2  A5 rr          lda ScanEnd
0006BAr 2  20 rr rr       jsr MarkSet
0006BDr 2  A5 rr          lda ScanEnd
0006BFr 2  38             sec
0006C0r 2  E5 rr          sbc ScanStep
0006C2r 2  85 rr          sta ScanEnd
0006C4r 2  C6 rr          dec ScanLen
0006C6r 2  D0 F0          bne @Mark
0006C8r 2               @Done:
0006C8r 2  60             rts
0006C9r 2               
0006C9r 2               ; -----------------------------------------------------------------------------
0006C9r 2               ;   MatchScoreRun — the two per-run awards of SPEC 8 step 2
0006C9r 2               ;   In:  ScanLen = run length, ChainStep = the cascade step this is
0006C9r 2               ;   Out: nothing.  Modifies: A, X, Y.  Leaves ScanLen and ScanColor alone.
0006C9r 2               ;
0006C9r 2               ;       cascade_pts += length * TileValue[chain]
0006C9r 2               ;       cascade_pts += LengthBonus[length]
0006C9r 2               ;
0006C9r 2               ;   A cell in a horizontal run AND a vertical one is scored by both, and
0006C9r 2               ;   removed once (SPEC 6.1) — which is why this is per run and not per marked
0006C9r 2               ;   cell, and why it runs before the union in MARKS has anything to say.
0006C9r 2               ;
0006C9r 2               ;   MultiBonus is NOT here: it is per step, not per run, and CascadeScan adds
0006C9r 2               ;   it once the four passes have finished counting.
0006C9r 2               ; -----------------------------------------------------------------------------
0006C9r 2               MatchScoreRun:
0006C9r 2  AE rr rr       ldx ChainStep
0006CCr 2  CA             dex                           ; TileValue is indexed by chain - 1 ...
0006CDr 2  E0 08          cpx #8
0006CFr 2  90 02          bcc @Chain
0006D1r 2  A2 07          ldx #7                        ;   ... and flattens out at 8 (SPEC 9.1)
0006D3r 2               @Chain:
0006D3r 2  A4 rr          ldy ScanLen                   ; The multiply is Y additions (score.asm)
0006D5r 2  BD rr rr       lda TileValueLo,x
0006D8r 2  48             pha
0006D9r 2  BD rr rr       lda TileValueHi,x
0006DCr 2  AA             tax
0006DDr 2  68             pla
0006DEr 2  20 rr rr       jsr CascadeAddTimes
0006E1r 2               
0006E1r 2  A6 rr          ldx ScanLen
0006E3r 2  CA             dex
0006E4r 2  CA             dex
0006E5r 2  CA             dex                           ; LengthBonus is indexed by length - 3 ...
0006E6r 2  E0 05          cpx #5
0006E8r 2  90 02          bcc @Length
0006EAr 2  A2 04          ldx #4                        ;   ... and flattens out at 7 (SPEC 9.3). A
0006ECr 2               @Length:                        ;   vertical run can be all sixteen rows long
0006ECr 2  BD rr rr       lda LengthBonusLo,x
0006EFr 2  48             pha
0006F0r 2  BD rr rr       lda LengthBonusHi,x
0006F3r 2  AA             tax
0006F4r 2  68             pla
0006F5r 2  4C rr rr       jmp CascadeAdd
0006F8r 2               
0006F8r 2               ; -----------------------------------------------------------------------------
0006F8r 2               ;   MarksClear / MarkSet / MarkTest — the 16-byte bitmap
0006F8r 2               ;   One byte per row, bits 0-5 = columns 0-5. Union of runs is a free ORA.
0006F8r 2               ;
0006F8r 2               ;   MarkBits has eight entries rather than six so that the two sentinel
0006F8r 2               ;   columns index it harmlessly: bits 6 and 7 of a Marks byte are never set,
0006F8r 2               ;   so a walk over the whole 8-byte stride can test every cell it meets
0006F8r 2               ;   without first asking whether the cell is a wall.
0006F8r 2               ; -----------------------------------------------------------------------------
0006F8r 2               MarkBits:
0006F8r 2  01 02 04 08    .byte $01, $02, $04, $08, $10, $20, $40, $80
0006FCr 2  10 20 40 80  
000700r 2               
000700r 2               MarksClear:
000700r 2  A9 00          lda #0
000702r 2  A2 00          ldx #0
000704r 2               @Row:
000704r 2  9D rr rr       sta Marks,x
000707r 2  E8             inx
000708r 2  E0 10          cpx #MARKS_BYTES
00070Ar 2  D0 F8          bne @Row
00070Cr 2  60             rts
00070Dr 2               
00070Dr 2               MarkSet:                        ; In: A = board index.  Modifies: A, X, Y
00070Dr 2  AA             tax
00070Er 2  29 07          and #(BOARD_STRIDE - 1)
000710r 2  A8             tay                           ; Y = column
000711r 2  8A             txa
000712r 2  4A             lsr a
000713r 2  4A             lsr a
000714r 2  4A             lsr a
000715r 2  AA             tax                           ; X = row
000716r 2  BD rr rr       lda Marks,x
000719r 2  19 rr rr       ora MarkBits,y
00071Cr 2  9D rr rr       sta Marks,x
00071Fr 2  60             rts
000720r 2               
000720r 2               MarkTest:                       ; In: A = board index.  Out: C set if marked
000720r 2  AA             tax                           ;     Modifies: A, X, Y
000721r 2  29 07          and #(BOARD_STRIDE - 1)
000723r 2  A8             tay
000724r 2  8A             txa
000725r 2  4A             lsr a
000726r 2  4A             lsr a
000727r 2  4A             lsr a
000728r 2  AA             tax
000729r 2  BD rr rr       lda Marks,x
00072Cr 2  39 rr rr       and MarkBits,y
00072Fr 2  F0 02          beq @No
000731r 2  38             sec
000732r 2  60             rts
000733r 2               @No:
000733r 2  18             clc
000734r 2  60             rts
000735r 2               
000735r 1               .include "../src/cascade.asm"
000735r 2               ; =============================================================================
000735r 2               ;   cascade.asm — Wizards Lab, clear resolution
000735r 2               ; =============================================================================
000735r 2               ;   SPEC.md section 8. A cascade runs from the moment a piece locks until no
000735r 2               ;   further matches exist, one step per iteration, with ChainStep counting the
000735r 2               ;   steps. The step order is fixed:
000735r 2               ;
000735r 2               ;       scan -> score matches -> enqueue reagents -> resolve queue
000735r 2               ;            -> animate -> remove -> level check -> gravity -> repeat
000735r 2               ;
000735r 2               ;   The effect queue always drains. Effects only ever remove tiles, never add
000735r 2               ;   them, and each cell can be marked at most once, so the queue is bounded by
000735r 2               ;   the 96 cells of the playfield.
000735r 2               ; =============================================================================
000735r 2               
000735r 2               ; -----------------------------------------------------------------------------
000735r 2               ;   CascadeBegin — called immediately after PieceLock
000735r 2               ;   Out: nothing.  Modifies: A
000735r 2               ; -----------------------------------------------------------------------------
000735r 2               CascadeBegin:
000735r 2  A9 01          lda #1
000737r 2  8D rr rr       sta ChainStep                 ; The step about to run is step 1 (SPEC 8)
00073Ar 2  A9 00          lda #0
00073Cr 2  8D rr rr       sta CascadeLo
00073Fr 2  8D rr rr       sta CascadeMid
000742r 2  8D rr rr       sta CascadeHi
000745r 2  8D rr rr       sta StarCount
000748r 2  8D rr rr       sta RunCount
00074Br 2  4C rr rr       jmp EffectQClear
00074Er 2               
00074Er 2               ; -----------------------------------------------------------------------------
00074Er 2               ;   CascadeScan — steps 1 to 4: find the runs, score them, fire the reagents
00074Er 2               ;   In:  nothing
00074Er 2               ;   Out: C set if anything is marked and the step has something to animate.
00074Er 2               ;        C clear when nothing matched and the cascade has settled.
00074Er 2               ;        Modifies: A, X, Y, Scan*, Marks, RunCount, Cascade*, StarCount
00074Er 2               ;
00074Er 2               ;   Steps 3 and 4 are the reagents, and they run between the scan and the
00074Er 2               ;   removal because everything they do is add cells to Marks: by the time
00074Er 2               ;   CascadeRemove walks the bitmap it cannot tell a cell the scan found from
00074Er 2               ;   a cell a fireball took, and does not need to.
00074Er 2               ;
00074Er 2               ;   NOTHING HAS LEFT THE BOARD WHEN THIS RETURNS. Step 5 — the glow and the
00074Er 2               ;   shatter (anim.asm) — happens between here and CascadeFinish below, over
00074Er 2               ;   several frames, and it can only draw a cell's own colour and its own
00074Er 2               ;   reagent because the cell is still sitting there saying what it is. That
00074Er 2               ;   split is what the whole of P6 rests on, and it is the same property that
00074Er 2               ;   let P5 make an effect queue entry one byte.
00074Er 2               ;
00074Er 2               ;   Step 2's per-run half is in MatchEmit, which is the one moment a run's
00074Er 2               ;   length and colour are both in hand; what is left of it here is the bonus
00074Er 2               ;   for having found several at once, which nothing knows until all four
00074Er 2               ;   passes have finished.
00074Er 2               ; -----------------------------------------------------------------------------
00074Er 2               CascadeScan:
00074Er 2  20 rr rr       jsr MatchScan
000751r 2  F0 1E          beq @Settled                  ; RunCount is zero — nothing left to clear
000753r 2               
000753r 2  AE rr rr       ldx RunCount                  ; SPEC 8 step 2, last line, and SPEC 9.4
000756r 2  CA             dex                           ; MultiBonus is indexed by runs - 1 ...
000757r 2  E0 05          cpx #5
000759r 2  90 02          bcc @Multi
00075Br 2  A2 04          ldx #4                        ;   ... and flattens out at 5
00075Dr 2               @Multi:
00075Dr 2  BD rr rr       lda MultiBonusLo,x
000760r 2  48             pha
000761r 2  BD rr rr       lda MultiBonusHi,x
000764r 2  AA             tax
000765r 2  68             pla
000766r 2  20 rr rr       jsr CascadeAdd
000769r 2               
000769r 2  20 rr rr       jsr EffectEnqueueMarked       ; SPEC 8 step 3
00076Cr 2  20 rr rr       jsr EffectResolve             ; SPEC 8 step 4
00076Fr 2  38             sec
000770r 2  60             rts
000771r 2               @Settled:
000771r 2  18             clc
000772r 2  60             rts
000773r 2               
000773r 2               ; -----------------------------------------------------------------------------
000773r 2               ;   CascadeFinish — steps 6 and 7, once the animation has finished with them
000773r 2               ;   In:  Marks, as CascadeScan left it
000773r 2               ;   Out: nothing.  Modifies: A, X, Y, CellCount, Board, Level
000773r 2               ; -----------------------------------------------------------------------------
000773r 2               CascadeFinish:
000773r 2  20 rr rr       jsr CascadeRemove             ; SPEC 8 step 6
000776r 2  A5 rr          lda CellCount
000778r 2  4C rr rr       jmp ScoreLevelCheck           ; SPEC 8 step 7 — match and effect removals
00077Br 2                                               ;   both count, and by here they are the same
00077Br 2                                               ;   cells
00077Br 2               
00077Br 2               ; -----------------------------------------------------------------------------
00077Br 2               ;   CascadeRemove — empty every marked cell and queue it for redraw
00077Br 2               ;   In:  Marks
00077Br 2               ;   Out: CellCount = cells removed.  Modifies: A, X, Y, CellCount, RedrawCol
00077Br 2               ;   SPEC 8 step 6.
00077Br 2               ;
00077Br 2               ;   Every marked cell is zeroed in one go, because the gravity that follows
00077Br 2               ;   needs a board that is finished changing. Only the REDRAW is rationed: at
00077Br 2               ;   most 96 cells can be marked and the dirty ring holds 64, and P5 made that
00077Br 2               ;   reachable — a bolt is 21 cells on its own and a chain of them is most of
00077Br 2               ;   the well. A mark dropped by a full ring is never made again (D6), so
00077Br 2               ;   rather than drop one this falls back to RenderBoard, the whole-well cursor
00077Br 2               ;   RenderFlush already feeds a frame at a time (D12). Four frames of redraw
00077Br 2               ;   instead of a hole in the screen, and only on the rare huge step: a plain
00077Br 2               ;   three-in-a-row never comes near the cap.
00077Br 2               ;
00077Br 2               ;   CellCount goes to ScoreLevelCheck — thirty cleared tiles is a level
00077Br 2               ;   (SPEC 10.1). By the time this runs the cells have already glowed and
00077Br 2               ;   shattered (anim.asm); what it draws over them is the empty well behind.
00077Br 2               ; -----------------------------------------------------------------------------
00077Br 2               CascadeRemove:
00077Br 2  A9 00          lda #0
00077Dr 2  85 rr          sta CellCount
00077Fr 2  AA             tax                           ; X = board index, walked a row at a time
000780r 2               @Row:
000780r 2  8A             txa
000781r 2  4A             lsr a
000782r 2  4A             lsr a
000783r 2  4A             lsr a
000784r 2  A8             tay
000785r 2  B9 rr rr       lda Marks,y
000788r 2  F0 38          beq @NextRow                  ; Nothing marked in this row, and most rows
00078Ar 2                                               ;   hold nothing marked
00078Ar 2               @Cell:
00078Ar 2  8A             txa
00078Br 2  48             pha
00078Cr 2  20 rr rr       jsr MarkTest
00078Fr 2  68             pla
000790r 2  AA             tax                           ; MarkTest needs X, so the cursor comes back
000791r 2  90 1F          bcc @NextCell                 ;   through A. Neither PLA nor TAX touches C.
000793r 2  A9 00          lda #TILE_EMPTY
000795r 2  9D rr rr       sta Board,x
000798r 2  E6 rr          inc CellCount
00079Ar 2               
00079Ar 2  AD rr rr       lda DirtyCount                ; Room to mark this one?
00079Dr 2  C9 40          cmp #DIRTY_ENTRIES
00079Fr 2  B0 0A          bcs @Bulk                     ; No — redraw the lot instead of losing it
0007A1r 2  8A             txa
0007A2r 2  48             pha
0007A3r 2  20 rr rr       jsr RenderCell
0007A6r 2  68             pla
0007A7r 2  AA             tax
0007A8r 2  4C rr rr       jmp @NextCell
0007ABr 2               @Bulk:
0007ABr 2  8A             txa
0007ACr 2  48             pha
0007ADr 2  20 rr rr       jsr RenderBoard               ; Sets the cursor and nothing else, so the
0007B0r 2  68             pla                           ;   cells already queued still land and the
0007B1r 2  AA             tax                           ;   redraw overwrites them with the same values
0007B2r 2               @NextCell:
0007B2r 2  E8             inx
0007B3r 2  8A             txa
0007B4r 2  29 07          and #(BOARD_STRIDE - 1)
0007B6r 2  C9 06          cmp #BOARD_W
0007B8r 2  90 D0          bcc @Cell
0007BAr 2               
0007BAr 2  8A             txa                           ; X is on the row's first sentinel column;
0007BBr 2  18             clc                           ;   step over both of them
0007BCr 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
0007BEr 2  AA             tax
0007BFr 2  4C rr rr       jmp @Test
0007C2r 2               
0007C2r 2               @NextRow:
0007C2r 2  8A             txa
0007C3r 2  18             clc
0007C4r 2  69 08          adc #BOARD_STRIDE
0007C6r 2  AA             tax
0007C7r 2               @Test:
0007C7r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
0007C9r 2  90 B5          bcc @Row
0007CBr 2  60             rts
0007CCr 2               
0007CCr 2               ; -----------------------------------------------------------------------------
0007CCr 2               ;   CascadeSettle — apply the star multiplier and bank the points
0007CCr 2               ;   SPEC 8 SETTLE, SPEC 9.6 — the doubling covers the WHOLE cascade, including
0007CCr 2               ;   points scored before the star cleared.
0007CCr 2               ; -----------------------------------------------------------------------------
0007CCr 2               CascadeSettle:
0007CCr 2  AD rr rr       lda StarCount
0007CFr 2  C9 03          cmp #STAR_SHIFT_CAP
0007D1r 2  90 02          bcc @Shift
0007D3r 2  A9 03          lda #STAR_SHIFT_CAP           ; x8 and no further, however many were caught
0007D5r 2               @Shift:
0007D5r 2  AA             tax
0007D6r 2  F0 06          beq @Bank
0007D8r 2               @Double:
0007D8r 2  20 rr rr       jsr CascadeDouble             ; A doubling in BCD is one self-addition
0007DBr 2  CA             dex
0007DCr 2  D0 FA          bne @Double
0007DEr 2               @Bank:
0007DEr 2  4C rr rr       jmp ScoreAdd                  ; Its carry is not read: ScoreHighCheck has
0007E1r 2                                               ;   already raised the fanfare and the flash
0007E1r 2                                               ;   itself, and does so exactly once
0007E1r 2               
0007E1r 2               
0007E1r 2               ; =============================================================================
0007E1r 2               ;   The reagents (SPEC 7)
0007E1r 2               ; =============================================================================
0007E1r 2               ;   Steps 3 and 4 of SPEC 8, and the five effects between them. The shape is:
0007E1r 2               ;
0007E1r 2               ;     EffectEnqueueMarked   walks MARKS once the scan has finished, and offers
0007E1r 2               ;                           every matched cell to EffectEnqueue
0007E1r 2               ;     EffectEnqueue         decides what a cell being removed is worth — a
0007E1r 2               ;                           prism pays, a star counts, a fireball/bolt/bomb
0007E1r 2               ;                           queues
0007E1r 2               ;     EffectResolve         drains the queue, detonating each in turn
0007E1r 2               ;     EffectFireball/Bolt/  list the cells a detonation reaches, and offer each
0007E1r 2               ;       Bomb                one to EffectHit
0007E1r 2               ;     EffectHit             marks it, scores it, and offers it to
0007E1r 2               ;                           EffectEnqueue in its turn — which is the whole of
0007E1r 2               ;                           SPEC 7.2's chain reaction, in one routine
0007E1r 2               ;
0007E1r 2               ;   TERMINATION IS STRUCTURAL, not a limit. An effect only ever MARKS cells and
0007E1r 2               ;   never adds one, and EffectHit refuses a cell that is already marked, so a
0007E1r 2               ;   cell can be pushed at most once and the loop is bounded by the 96 cells of
0007E1r 2               ;   the well.
0007E1r 2               ;
0007E1r 2               ;   Nothing here touches the board. Marked cells are still sitting there,
0007E1r 2               ;   readable, until CascadeRemove zeroes them in step 6 — which is what lets a
0007E1r 2               ;   queue entry be a board index and nothing else (constants.inc).
0007E1r 2               ; =============================================================================
0007E1r 2               
0007E1r 2               ; -----------------------------------------------------------------------------
0007E1r 2               ;   EffectEnqueueMarked — SPEC 8 step 3
0007E1r 2               ;   In:  Marks, as MatchScan left it
0007E1r 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectQ, StarCount, Cascade*
0007E1r 2               ;
0007E1r 2               ;   Nothing called from here marks anything, so the bitmap being walked cannot
0007E1r 2               ;   change underneath the walk. Step 4 is where marking starts, and the cells
0007E1r 2               ;   it marks enqueue themselves as they are marked (EffectHit) rather than
0007E1r 2               ;   waiting for a second pass over MARKS.
0007E1r 2               ;
0007E1r 2               ;   It has to be a pass over the union rather than part of MatchEmit's mark
0007E1r 2               ;   loop: a cell in a horizontal run AND a vertical one is marked twice and
0007E1r 2               ;   would then detonate twice (SPEC 6.1).
0007E1r 2               ; -----------------------------------------------------------------------------
0007E1r 2               EffectEnqueueMarked:
0007E1r 2  A9 00          lda #0
0007E3r 2  85 rr          sta EffectIdx
0007E5r 2               @Row:
0007E5r 2  A5 rr          lda EffectIdx
0007E7r 2  4A             lsr a
0007E8r 2  4A             lsr a
0007E9r 2  4A             lsr a
0007EAr 2  A8             tay
0007EBr 2  B9 rr rr       lda Marks,y
0007EEr 2  F0 20          beq @NextRow                  ; Nothing marked in this row, which is most
0007F0r 2                                               ;   rows of most steps
0007F0r 2               @Cell:
0007F0r 2  A5 rr          lda EffectIdx
0007F2r 2  20 rr rr       jsr MarkTest
0007F5r 2  90 05          bcc @NextCell
0007F7r 2  A6 rr          ldx EffectIdx
0007F9r 2  20 rr rr       jsr EffectEnqueue
0007FCr 2               @NextCell:
0007FCr 2  E6 rr          inc EffectIdx
0007FEr 2  A5 rr          lda EffectIdx
000800r 2  29 07          and #(BOARD_STRIDE - 1)
000802r 2  C9 06          cmp #BOARD_W
000804r 2  90 EA          bcc @Cell
000806r 2               
000806r 2  A5 rr          lda EffectIdx                 ; On the row's first sentinel column; step
000808r 2  18             clc                           ;   over both of them
000809r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
00080Br 2  85 rr          sta EffectIdx
00080Dr 2  4C rr rr       jmp @Test
000810r 2               
000810r 2               @NextRow:
000810r 2  A5 rr          lda EffectIdx
000812r 2  18             clc
000813r 2  69 08          adc #BOARD_STRIDE
000815r 2  85 rr          sta EffectIdx
000817r 2               @Test:
000817r 2  A5 rr          lda EffectIdx
000819r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
00081Br 2  90 C8          bcc @Row
00081Dr 2  60             rts
00081Er 2               
00081Er 2               ; -----------------------------------------------------------------------------
00081Er 2               ;   EffectEnqueue — a marked cell is going; make what it holds count
00081Er 2               ;   In:  X = board index of a cell that is ALREADY marked
00081Er 2               ;   Out: nothing.  Modifies: A, X, Y
00081Er 2               ;
00081Er 2               ;   Called exactly once per removed cell — from step 3 for the cells the scan
00081Er 2               ;   found, and from EffectHit for every cell an effect takes. Three outcomes:
00081Er 2               ;
00081Er 2               ;     a prism   pays BONUS_PRISM here and now and is never queued: it has no
00081Er 2               ;               effect to fire, only a bonus (SPEC 7.3)
00081Er 2               ;     a star    counts into StarCount and is never queued either — SPEC 8
00081Er 2               ;               step 3 is explicit that stars are counted, not queued
00081Er 2               ;     the rest  go on the queue, and pay their trigger bonus when they pop
00081Er 2               ;
00081Er 2               ;   THE COLOUR IS TESTED BEFORE THE GLYPH, and that order is not cosmetic. A
00081Er 2               ;   prism is glyph 0 of colour 6, indistinguishable from a plain potion by its
00081Er 2               ;   glyph alone — and from P6 onward the board may hold any of the prism's four
00081Er 2               ;   idle rotation frames, whose low three bits read as a bolt or a bomb and
00081Er 2               ;   would detonate one. Colour 6 is the only test that stays true.
00081Er 2               ; -----------------------------------------------------------------------------
00081Er 2               EffectEnqueue:
00081Er 2  BD rr rr       lda Board,x
000821r 2  29 F8          and #COLOR_MASK
000823r 2  C9 70          cmp #WILD_BASE
000825r 2  F0 12          beq @Prism
000827r 2  BD rr rr       lda Board,x
00082Ar 2  29 07          and #GLYPH_MASK
00082Cr 2  F0 0A          beq @Done                     ; A plain potion, which is most of the board
00082Er 2  C9 04          cmp #GLYPH_STAR
000830r 2  F0 0A          beq @Star
000832r 2  B0 04          bcs @Done                     ; Glyphs 5-7 are animation frames (SPEC 4.4),
000834r 2                                               ;   never reagents
000834r 2  8A             txa
000835r 2  4C rr rr       jmp EffectQPush               ; Fireball, bolt or bomb — glyphs 1 to 3
000838r 2               @Done:
000838r 2  60             rts
000839r 2               @Prism:
000839r 2  4C rr rr       jmp EffectPrism               ; Both of these are the far side of the three
00083Cr 2               @Star:                          ;   detonations below, well out of branch range
00083Cr 2  4C rr rr       jmp EffectStar
00083Fr 2               
00083Fr 2               ; -----------------------------------------------------------------------------
00083Fr 2               ;   EffectHit — one cell of one detonation
00083Fr 2               ;   In:  X = board index
00083Fr 2               ;   Out: nothing.  Modifies: A, X, Y
00083Fr 2               ;
00083Fr 2               ;   The whole of SPEC 8 step 4's inner loop, which is why every effect below
00083Fr 2               ;   is nothing but a list of cells to offer it.
00083Fr 2               ;
00083Fr 2               ;   A cell that is empty, a wall, or already marked is not a target. "Not
00083Fr 2               ;   already marked" is what makes the queue terminate and what stops a cell
00083Fr 2               ;   being paid for twice; testing the WALL here is what lets the walks above
00083Fr 2               ;   run over the two sentinel columns without bounds checks of their own. A
00083Fr 2               ;   marked sentinel would be zeroed by CascadeRemove and the well would grow
00083Fr 2               ;   a hole in its floor.
00083Fr 2               ; -----------------------------------------------------------------------------
00083Fr 2               EffectHit:
00083Fr 2  BD rr rr       lda Board,x
000842r 2  F0 1A          beq @Done                     ; Empty
000844r 2  C9 FF          cmp #TILE_WALL
000846r 2  F0 16          beq @Done                     ; A sentinel is never a target
000848r 2  8A             txa
000849r 2  48             pha
00084Ar 2  20 rr rr       jsr MarkTest
00084Dr 2  68             pla
00084Er 2  AA             tax                           ; Neither PLA nor TAX touches C
00084Fr 2  B0 0D          bcs @Done                     ; Already going
000851r 2               
000851r 2  8A             txa
000852r 2  48             pha                           ; MarkSet takes the index in A, which PHA left
000853r 2  20 rr rr       jsr MarkSet                   ;   alone
000856r 2  20 rr rr       jsr EffectScoreCell           ; SPEC 9.2, per cell an effect took
000859r 2  68             pla
00085Ar 2  AA             tax
00085Br 2  4C rr rr       jmp EffectEnqueue             ; ...and if it was a reagent, it fires too
00085Er 2               @Done:
00085Er 2  60             rts
00085Fr 2               
00085Fr 2               ; -----------------------------------------------------------------------------
00085Fr 2               ;   EffectScoreCell — EffectValue[chain] for one cell taken by an effect
00085Fr 2               ;   Out: nothing.  Modifies: A, X, Y
00085Fr 2               ;   SPEC 9.2 — deliberately dearer than a matched tile at low chain depth, so
00085Fr 2               ;   that the first reagent a player ever sets off feels better than plain play.
00085Fr 2               ; -----------------------------------------------------------------------------
00085Fr 2               EffectScoreCell:
00085Fr 2  AE rr rr       ldx ChainStep
000862r 2  CA             dex                           ; Indexed by chain - 1 ...
000863r 2  E0 08          cpx #8
000865r 2  90 02          bcc @Chain
000867r 2  A2 07          ldx #7                        ;   ... and flattens out at 8
000869r 2               @Chain:
000869r 2  BD rr rr       lda EffectValueLo,x
00086Cr 2  48             pha
00086Dr 2  BD rr rr       lda EffectValueHi,x
000870r 2  AA             tax
000871r 2  68             pla
000872r 2  4C rr rr       jmp CascadeAdd
000875r 2               
000875r 2               ; -----------------------------------------------------------------------------
000875r 2               ;   EffectResolve — drain the queue (SPEC 8 step 4)
000875r 2               ;   Out: nothing.  Modifies: A, X, Y, Effect*, Marks, Cascade*, StarCount
000875r 2               ;
000875r 2               ;   The detonation runs first and the trigger bonus is paid on the way back,
000875r 2               ;   which is the order SPEC 8 step 4 sets out. It makes no difference to the
000875r 2               ;   total — everything lands in the same accumulator — but it does mean the
000875r 2               ;   glyph has to survive a routine that clobbers all three registers, and the
000875r 2               ;   stack is the cheapest place to put it.
000875r 2               ; -----------------------------------------------------------------------------
000875r 2               EffectResolve:
000875r 2               @Loop:
000875r 2  20 rr rr       jsr EffectQPop
000878r 2  90 45          bcc @Done                     ; Empty — the step is finished
00087Ar 2               
00087Ar 2  AA             tax                           ; X = the detonating cell
00087Br 2  BD rr rr       lda Board,x                   ; Still on the board: step 6 has not run
00087Er 2  29 07          and #GLYPH_MASK
000880r 2  48             pha
000881r 2  C9 01          cmp #GLYPH_FIREBALL
000883r 2  F0 0F          beq @Fireball
000885r 2  C9 02          cmp #GLYPH_BOLT
000887r 2  F0 20          beq @Bolt
000889r 2               
000889r 2  A9 07          lda #SFX_BOMB                 ; Glyph 3 — nothing else ever reaches here
00088Br 2  8D rr rr       sta SfxRequest
00088Er 2  20 rr rr       jsr EffectBomb
000891r 2  4C rr rr       jmp @Bonus
000894r 2               
000894r 2               @Fireball:
000894r 2  A9 05          lda #SFX_FIREBALL
000896r 2  8D rr rr       sta SfxRequest
000899r 2  BD rr rr       lda Board,x
00089Cr 2  29 F8          and #COLOR_MASK               ; Its own colour, which can never be wild
00089Er 2  48             pha
00089Fr 2  20 rr rr       jsr HalColorFlash             ; SPEC 4.6, 14 — every tile of that colour goes
0008A2r 2  68             pla                           ;   white for the glow window, which is one VDP
0008A3r 2                                               ;   colour byte here and one compare a cell on
0008A3r 2                                               ;   the Commodores. AnimGlowBegin reads
0008A3r 2                                               ;   TintColor to find out that it happened
0008A3r 2  20 rr rr       jsr EffectFireball
0008A6r 2  4C rr rr       jmp @Bonus
0008A9r 2               
0008A9r 2               @Bolt:
0008A9r 2  A9 06          lda #SFX_BOLT
0008ABr 2  8D rr rr       sta SfxRequest
0008AEr 2  20 rr rr       jsr EffectBolt
0008B1r 2               
0008B1r 2               @Bonus:
0008B1r 2  68             pla
0008B2r 2  A8             tay                           ; TriggerBonus is indexed by glyph (SPEC 9.5),
0008B3r 2  B9 rr rr       lda TriggerBonusLo,y          ;   and is paid however the reagent was removed
0008B6r 2  BE rr rr       ldx TriggerBonusHi,y
0008B9r 2  20 rr rr       jsr CascadeAdd
0008BCr 2  4C rr rr       jmp @Loop
0008BFr 2               @Done:
0008BFr 2  60             rts
0008C0r 2               
0008C0r 2               ; -----------------------------------------------------------------------------
0008C0r 2               ;   The five reagents (SPEC 7.3). Each lists the cells it reaches and leaves
0008C0r 2               ;   the marking, the scoring and the chain reaction to EffectHit.
0008C0r 2               ; -----------------------------------------------------------------------------
0008C0r 2               
0008C0r 2               ; -----------------------------------------------------------------------------
0008C0r 2               ;   EffectFireball — every remaining tile of one colour, board wide
0008C0r 2               ;   In:  A = the colour key ($40 to $68)
0008C0r 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectArg, Marks, Cascade*
0008C0r 2               ;   SPEC 7.3 — the signature reagent, and the reason a chain goes three deep.
0008C0r 2               ;
0008C0r 2               ;   PRISMS ARE IMMUNE AND IT COSTS NOTHING TO MAKE THEM SO (SPEC 7.4). A prism
0008C0r 2               ;   is colour 6 and a fireball's colour never is, so the compare below is the
0008C0r 2               ;   immunity — there is no special case to forget. An empty cell and a wall
0008C0r 2               ;   fail it for the same reason, which is why this walks all eight columns of
0008C0r 2               ;   every row rather than stepping over the sentinels.
0008C0r 2               ;
0008C0r 2               ;   The fireball's own cell is already marked, so it is not a target of itself,
0008C0r 2               ;   and a second fireball of the same colour in the same step finds nothing
0008C0r 2               ;   left to take — and still pays its trigger bonus (SPEC 7.3).
0008C0r 2               ; -----------------------------------------------------------------------------
0008C0r 2               EffectFireball:
0008C0r 2  85 rr          sta EffectArg                 ; The colour it is hunting
0008C2r 2  A9 00          lda #0
0008C4r 2  85 rr          sta EffectIdx
0008C6r 2               @Cell:
0008C6r 2  A6 rr          ldx EffectIdx
0008C8r 2  BD rr rr       lda Board,x
0008CBr 2  29 F8          and #COLOR_MASK
0008CDr 2  C5 rr          cmp EffectArg
0008CFr 2  D0 03          bne @Next
0008D1r 2  20 rr rr       jsr EffectHit
0008D4r 2               @Next:
0008D4r 2  E6 rr          inc EffectIdx
0008D6r 2  A5 rr          lda EffectIdx
0008D8r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
0008DAr 2  90 EA          bcc @Cell
0008DCr 2  60             rts
0008DDr 2               
0008DDr 2               ; -----------------------------------------------------------------------------
0008DDr 2               ;   EffectBolt — the whole row and the whole column through the bolt's cell
0008DDr 2               ;   In:  X = board index
0008DDr 2               ;   Out: nothing.  Modifies: A, X, Y, EffectIdx, EffectEnd, EffectArg, Marks
0008DDr 2               ;   SPEC 7.3 — up to 6 + 16 - 1 = 21 cells, and the only reagent that reaches
0008DDr 2               ;   something buried at the bottom of a column.
0008DDr 2               ;
0008DDr 2               ;   Neither walk needs clipping: a row is six cells wherever it is, and a
0008DDr 2               ;   column is sixteen. The bolt's own cell is offered twice, once by each, and
0008DDr 2               ;   is refused both times because it was marked before this was called.
0008DDr 2               ; -----------------------------------------------------------------------------
0008DDr 2               EffectBolt:
0008DDr 2  8A             txa
0008DEr 2  29 07          and #(BOARD_STRIDE - 1)
0008E0r 2  85 rr          sta EffectArg                 ; Its column, for the second walk
0008E2r 2  8A             txa
0008E3r 2  29 F8          and #(256 - BOARD_STRIDE)     ; $F8 — its row base
0008E5r 2  85 rr          sta EffectIdx
0008E7r 2  18             clc
0008E8r 2  69 06          adc #BOARD_W
0008EAr 2  85 rr          sta EffectEnd                 ; One past the row's last playfield cell
0008ECr 2               @Row:
0008ECr 2  A6 rr          ldx EffectIdx
0008EEr 2  20 rr rr       jsr EffectHit
0008F1r 2  E6 rr          inc EffectIdx
0008F3r 2  A5 rr          lda EffectIdx
0008F5r 2  C5 rr          cmp EffectEnd
0008F7r 2  90 F3          bcc @Row
0008F9r 2               
0008F9r 2  A5 rr          lda EffectArg                 ; The column, row 0 downward
0008FBr 2  85 rr          sta EffectIdx
0008FDr 2               @Col:
0008FDr 2  A6 rr          ldx EffectIdx
0008FFr 2  20 rr rr       jsr EffectHit
000902r 2  A5 rr          lda EffectIdx
000904r 2  18             clc
000905r 2  69 08          adc #BOARD_STRIDE
000907r 2  85 rr          sta EffectIdx
000909r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
00090Br 2  90 F0          bcc @Col
00090Dr 2  60             rts
00090Er 2               
00090Er 2               ; -----------------------------------------------------------------------------
00090Er 2               ;   EffectBomb — the 3 x 3 block centred on the bomb, clipped at the edges
00090Er 2               ;   In:  X = board index
00090Er 2               ;   Out: nothing.  Modifies: A, X, Y, Effect*, Tmp0, Tmp1, Marks, Cascade*
00090Er 2               ;   SPEC 7.3 — up to 9 cells, and the reagent most likely to catch another.
00090Er 2               ;
00090Er 2               ;   BOTH SPANS ARE CLIPPED, and the row span has to be: row 0 minus one row is
00090Er 2               ;   index minus 8, which underflows a byte and reads the BSS in front of a
00090Er 2               ;   page-aligned Board. The column span could lean on the sentinels the way
00090Er 2               ;   every other walk in the game does — except at row 0, column 0, where
00090Er 2               ;   "one to the left" is index $FF and off the end of the board. Clipping both
00090Er 2               ;   is smaller than special-casing one corner.
00090Er 2               ;
00090Er 2               ;   Tmp0 and Tmp1 are finished with before the first JSR, which is what the
00090Er 2               ;   rule about them says (zeropage.inc).
00090Er 2               ; -----------------------------------------------------------------------------
00090Er 2               EffectBomb:
00090Er 2  8A             txa                           ; --- the column span ---
00090Fr 2  29 07          and #(BOARD_STRIDE - 1)
000911r 2  A8             tay
000912r 2  F0 01          beq @Left                     ; Column 0 — the block starts there
000914r 2  88             dey
000915r 2               @Left:
000915r 2  84 rr          sty Tmp0                      ; First column of the block
000917r 2  8A             txa
000918r 2  29 07          and #(BOARD_STRIDE - 1)
00091Ar 2  C9 05          cmp #(BOARD_W - 1)
00091Cr 2  B0 02          bcs @Right                    ; Already against the right wall
00091Er 2  69 01          adc #1                        ; C is clear — the CMP above failed
000920r 2               @Right:
000920r 2  85 rr          sta EffectArg                 ; Last column of the block
000922r 2               
000922r 2  8A             txa                           ; --- the row span ---
000923r 2  29 F8          and #(256 - BOARD_STRIDE)
000925r 2  85 rr          sta Tmp1                      ; The bomb's own row base
000927r 2  F0 03          beq @Top                      ; Row 0 — the block starts there
000929r 2  38             sec
00092Ar 2  E9 08          sbc #BOARD_STRIDE
00092Cr 2               @Top:
00092Cr 2  18             clc
00092Dr 2  65 rr          adc Tmp0
00092Fr 2  85 rr          sta EffectRow                 ; First cell of the block's first row
000931r 2               
000931r 2  A5 rr          lda Tmp1
000933r 2  C9 78          cmp #((BOARD_H - 1) * BOARD_STRIDE)
000935r 2  B0 03          bcs @Bottom                   ; Row 15 — the block ends there
000937r 2  18             clc
000938r 2  69 08          adc #BOARD_STRIDE
00093Ar 2               @Bottom:
00093Ar 2  18             clc
00093Br 2  65 rr          adc Tmp0
00093Dr 2  85 rr          sta EffectEnd                 ; First cell of the block's LAST row
00093Fr 2               
00093Fr 2               @Rows:
00093Fr 2  A5 rr          lda EffectRow
000941r 2  85 rr          sta EffectIdx
000943r 2               @Cell:
000943r 2  A6 rr          ldx EffectIdx
000945r 2  20 rr rr       jsr EffectHit
000948r 2  A5 rr          lda EffectIdx
00094Ar 2  29 07          and #(BOARD_STRIDE - 1)
00094Cr 2  C5 rr          cmp EffectArg
00094Er 2  E6 rr          inc EffectIdx                 ; INC touches N and Z only, so the CMP's carry
000950r 2  90 F1          bcc @Cell                     ;   is still the one being branched on
000952r 2               
000952r 2  A5 rr          lda EffectRow
000954r 2  C5 rr          cmp EffectEnd
000956r 2  B0 07          bcs @Done                     ; That was the last row of the block
000958r 2  18             clc
000959r 2  69 08          adc #BOARD_STRIDE
00095Br 2  85 rr          sta EffectRow
00095Dr 2  D0 E0          bne @Rows                     ; Always — a row base past the first is >= 8
00095Fr 2               @Done:
00095Fr 2  60             rts
000960r 2               
000960r 2               ; -----------------------------------------------------------------------------
000960r 2               ;   EffectStar — removes nothing; it multiplies (SPEC 7.3)
000960r 2               ;   Out: nothing.  Modifies: A
000960r 2               ;
000960r 2               ;   The cap is not applied here. SPEC 9.6 doubles the WHOLE cascade up to three
000960r 2               ;   times at the end, so the count has to survive to CascadeSettle, which is
000960r 2               ;   where min(StarCount, STAR_SHIFT_CAP) is taken. A cascade cannot remove more
000960r 2               ;   than the 96 cells of the well, so the count cannot wrap on its way there.
000960r 2               ; -----------------------------------------------------------------------------
000960r 2               EffectStar:
000960r 2  EE rr rr       inc StarCount
000963r 2  A9 08          lda #SFX_STAR
000965r 2  8D rr rr       sta SfxRequest
000968r 2  60             rts
000969r 2               
000969r 2               ; -----------------------------------------------------------------------------
000969r 2               ;   EffectPrism — removes nothing; a flat bonus per prism cleared (SPEC 9.5)
000969r 2               ;   Out: nothing.  Modifies: A, X
000969r 2               ;
000969r 2               ;   It goes through CascadeAdd and not ScoreAward, so a star in the same
000969r 2               ;   cascade doubles it: SPEC 9.6 exempts only the soft drop and the level
000969r 2               ;   bonus from the multiplier (D5, D18).
000969r 2               ; -----------------------------------------------------------------------------
000969r 2               EffectPrism:
000969r 2  A9 09          lda #SFX_PRISM
00096Br 2  8D rr rr       sta SfxRequest
00096Er 2  A9 00          lda #<BONUS_PRISM
000970r 2  A2 04          ldx #>BONUS_PRISM
000972r 2  4C rr rr       jmp CascadeAdd
000975r 2               
000975r 2               ; -----------------------------------------------------------------------------
000975r 2               ;   The effect queue — a ring of board indices, one byte an entry.
000975r 2               ;
000975r 2               ;   The board still holds every pending reagent when its entry pops, because
000975r 2               ;   nothing is zeroed until step 6, so the glyph and the colour SPEC 8 packs
000975r 2               ;   into the entry are one `lda Board,x` away and storing them again would be
000975r 2               ;   storing a copy of the board (constants.inc).
000975r 2               ;
000975r 2               ;   Head and tail are entry numbers; the ring keeps one slot free, so it holds
000975r 2               ;   EFFECTQ_ENTRIES - 1. On overflow the effect is DROPPED and the cascade
000975r 2               ;   carries on (D6) — the cell is still marked, still scored and still removed,
000975r 2               ;   it simply does not detonate. With at most one reagent a piece, 47 pending
000975r 2               ;   detonations is not somewhere a real board goes.
000975r 2               ; -----------------------------------------------------------------------------
000975r 2               EffectQClear:
000975r 2  A9 00          lda #0
000977r 2  8D rr rr       sta EffectQHead
00097Ar 2  8D rr rr       sta EffectQTail
00097Dr 2  60             rts
00097Er 2               
00097Er 2               ; -----------------------------------------------------------------------------
00097Er 2               ;   EffectQPush — In: A = board index.  Modifies: A, X, Y
00097Er 2               ; -----------------------------------------------------------------------------
00097Er 2               EffectQPush:
00097Er 2  AE rr rr       ldx EffectQTail
000981r 2  AC rr rr       ldy EffectQTail
000984r 2  C8             iny
000985r 2  C0 30          cpy #EFFECTQ_ENTRIES
000987r 2  90 02          bcc @Store
000989r 2  A0 00          ldy #0                        ; Wrap
00098Br 2               @Store:
00098Br 2  CC rr rr       cpy EffectQHead
00098Er 2  F0 06          beq @Full                     ; One slot free is the ring being full
000990r 2  9D rr rr       sta EffectQ,x
000993r 2  8C rr rr       sty EffectQTail
000996r 2               @Full:
000996r 2  60             rts
000997r 2               
000997r 2               ; -----------------------------------------------------------------------------
000997r 2               ;   EffectQPop — Out: C set and A = board index; C clear when empty
000997r 2               ;   Modifies: A, X
000997r 2               ; -----------------------------------------------------------------------------
000997r 2               EffectQPop:
000997r 2  AE rr rr       ldx EffectQHead
00099Ar 2  EC rr rr       cpx EffectQTail
00099Dr 2  F0 0F          beq @Empty
00099Fr 2  BD rr rr       lda EffectQ,x
0009A2r 2  E8             inx
0009A3r 2  E0 30          cpx #EFFECTQ_ENTRIES
0009A5r 2  90 02          bcc @Store
0009A7r 2  A2 00          ldx #0                        ; Wrap
0009A9r 2               @Store:
0009A9r 2  8E rr rr       stx EffectQHead
0009ACr 2  38             sec
0009ADr 2  60             rts
0009AEr 2               @Empty:
0009AEr 2  18             clc
0009AFr 2  60             rts
0009B0r 2               
0009B0r 1               .include "../src/anim.asm"
0009B0r 2               ; =============================================================================
0009B0r 2               ;   anim.asm — Wizards Lab, the animations a clear is made of
0009B0r 2               ; =============================================================================
0009B0r 2               ;   SPEC.md section 14, and step 5 of SPEC 8. Everything here is a frame's
0009B0r 2               ;   worth of work and then a return: nothing waits, nothing loops on a timer,
0009B0r 2               ;   and the main loop never stops for any of it (D4).
0009B0r 2               ;
0009B0r 2               ;   A CLEAR STEP ANIMATES IN TWO WINDOWS, and every event SPEC 14 lists lands
0009B0r 2               ;   inside one of them:
0009B0r 2               ;
0009B0r 2               ;     PLAY_GLOW      matched cells wear glyph +6 of their own colour, the
0009B0r 2               ;                    bolt's beams lie over its row and column, and the
0009B0r 2               ;                    fireball's colour is white board-wide. GlowFrames, or the
0009B0r 2               ;                    longer FlashFrames when a fireball fired
0009B0r 2               ;     PLAY_SHATTER   the removal ring opens outward over every marked cell,
0009B0r 2               ;                    two frames a tile, with a marked prism's blip-out closing
0009B0r 2               ;                    inward beside it. SHATTER_STEPS ring frames, or the
0009B0r 2               ;                    prism's BLIP_STEPS when there is one
0009B0r 2               ;
0009B0r 2               ;   A window is as long as the LONGEST thing in it, which is the one rule that
0009B0r 2               ;   makes the durations in SPEC 14 hold without a timer per effect.
0009B0r 2               ;
0009B0r 2               ;   THE BOARD IS UNTOUCHED THE WHOLE TIME. Marked cells are not zeroed until
0009B0r 2               ;   CascadeRemove runs at the end of the shatter (SPEC 8 step 6), so every
0009B0r 2               ;   routine below can read a cell to find out what it is while drawing
0009B0r 2               ;   something else entirely over it — which is also what let P5 make an effect
0009B0r 2               ;   queue entry one byte (cascade.asm). Nothing here writes Board except the
0009B0r 2               ;   prism's idle rotation and the game-over petrify, both of which change what
0009B0r 2               ;   a cell IS and not merely what it shows.
0009B0r 2               ;
0009B0r 2               ;   THE COLOUR IS TESTED BEFORE THE GLYPH, everywhere, for the reason P5 found
0009B0r 2               ;   the hard way: a prism is glyph 0 of colour 6 and, now that it rotates, its
0009B0r 2               ;   board byte is WILD_BASE + 0..3, whose low three bits read as a bolt or a
0009B0r 2               ;   bomb. Colour 6 is the only test that stays true.
0009B0r 2               ; =============================================================================
0009B0r 2               
0009B0r 2               ANIM_GLOW           = 0         ; The four passes AnimMarked can make over the
0009B0r 2               ANIM_BEAM           = 1         ;   marked cells. AnimMode picks one; the walk
0009B0r 2               ANIM_UNBEAM         = 2         ;   itself is the same 30 bytes for all four
0009B0r 2               ANIM_SHATTER        = 3         ;   and is written once.
0009B0r 2               
0009B0r 2               ; -----------------------------------------------------------------------------
0009B0r 2               ;   AnimMarked — run one pass over every marked cell
0009B0r 2               ;   In:  A = ANIM_*      Out: nothing.  Modifies: A, X, Y, Anim*, and whatever
0009B0r 2               ;        the pass itself touches
0009B0r 2               ;
0009B0r 2               ;   The same walk as EffectEnqueueMarked (cascade.asm) and for the same reason:
0009B0r 2               ;   MARKS is the union of everything the step is taking, and a cell in a
0009B0r 2               ;   horizontal run AND a vertical one appears in it once. Marks are read only
0009B0r 2               ;   here — no pass sets one — so the bitmap cannot change underneath the walk.
0009B0r 2               ;
0009B0r 2               ;   The cursor is in memory rather than in X because everything the passes call
0009B0r 2               ;   ends at RenderMark, which clobbers A and X (D13).
0009B0r 2               ; -----------------------------------------------------------------------------
0009B0r 2               AnimMarked:
0009B0r 2  85 rr          sta AnimMode
0009B2r 2  A9 00          lda #0
0009B4r 2  85 rr          sta AnimIdx
0009B6r 2               @Row:
0009B6r 2  A5 rr          lda AnimIdx
0009B8r 2  4A             lsr a
0009B9r 2  4A             lsr a
0009BAr 2  4A             lsr a
0009BBr 2  A8             tay
0009BCr 2  B9 rr rr       lda Marks,y
0009BFr 2  F0 20          beq @NextRow                  ; Nothing marked in this row, which is most
0009C1r 2                                               ;   rows of most steps
0009C1r 2               @Cell:
0009C1r 2  A5 rr          lda AnimIdx
0009C3r 2  20 rr rr       jsr MarkTest
0009C6r 2  90 05          bcc @NextCell
0009C8r 2  A6 rr          ldx AnimIdx
0009CAr 2  20 rr rr       jsr AnimCell
0009CDr 2               @NextCell:
0009CDr 2  E6 rr          inc AnimIdx
0009CFr 2  A5 rr          lda AnimIdx
0009D1r 2  29 07          and #(BOARD_STRIDE - 1)
0009D3r 2  C9 06          cmp #BOARD_W
0009D5r 2  90 EA          bcc @Cell
0009D7r 2               
0009D7r 2  A5 rr          lda AnimIdx                   ; On the row's first sentinel column; step
0009D9r 2  18             clc                           ;   over both of them
0009DAr 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
0009DCr 2  85 rr          sta AnimIdx
0009DEr 2  4C rr rr       jmp @Test
0009E1r 2               
0009E1r 2               @NextRow:
0009E1r 2  A5 rr          lda AnimIdx
0009E3r 2  18             clc
0009E4r 2  69 08          adc #BOARD_STRIDE
0009E6r 2  85 rr          sta AnimIdx
0009E8r 2               @Test:
0009E8r 2  A5 rr          lda AnimIdx
0009EAr 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
0009ECr 2  90 C8          bcc @Row
0009EEr 2  60             rts
0009EFr 2               
0009EFr 2               ; -----------------------------------------------------------------------------
0009EFr 2               ;   AnimCell — one marked cell, in whichever pass is running
0009EFr 2               ;   In:  X = board index, AnimMode      Out: nothing.  Modifies: A, X, Y
0009EFr 2               ; -----------------------------------------------------------------------------
0009EFr 2               AnimCell:
0009EFr 2  A5 rr          lda AnimMode
0009F1r 2  F0 1A          beq AnimCellGlow
0009F3r 2  C9 03          cmp #ANIM_SHATTER
0009F5r 2  F0 2A          beq AnimCellShatter
0009F7r 2                 ; falls through into the two beam passes, which are the same test
0009F7r 2               
0009F7r 2               ; -----------------------------------------------------------------------------
0009F7r 2               ;   AnimCellBolt — is this cell a bolt? If so, draw or undraw its cross
0009F7r 2               ;   In:  X = board index      Out: nothing.  Modifies: A, X, Y, Anim*
0009F7r 2               ;
0009F7r 2               ;   The beams are their own pass and not a case inside the glow, because a
0009F7r 2               ;   beam goes OVER a glow: a cell in a bolt's row is very often also a matched
0009F7r 2               ;   cell, and both have to be drawn in that order.
0009F7r 2               ; -----------------------------------------------------------------------------
0009F7r 2               AnimCellBolt:
0009F7r 2  BD rr rr       lda Board,x
0009FAr 2  29 F8          and #COLOR_MASK
0009FCr 2  C9 70          cmp #WILD_BASE
0009FEr 2  F0 0C          beq @Done                     ; Colour before glyph: a rotating prism's low
000A00r 2                                               ;   three bits say "bolt" and it is not one
000A00r 2  BD rr rr       lda Board,x
000A03r 2  29 07          and #GLYPH_MASK
000A05r 2  C9 02          cmp #GLYPH_BOLT
000A07r 2  D0 03          bne @Done
000A09r 2  4C rr rr       jmp AnimBeam
000A0Cr 2               @Done:
000A0Cr 2  60             rts
000A0Dr 2               
000A0Dr 2               ; -----------------------------------------------------------------------------
000A0Dr 2               ;   AnimCellGlow — glyph +6 of the cell's own colour (SPEC 14)
000A0Dr 2               ;   In:  X = board index      Out: nothing.  Modifies: A, X, Y, AnimSteps
000A0Dr 2               ;
000A0Dr 2               ;   A MARKED PRISM SITS THE GLOW OUT. Group 14's slot +6 is an arrow, not a
000A0Dr 2               ;   glow (SPEC A.3), so `WILD_BASE + GLYPH_GLOW` must never be constructed —
000A0Dr 2               ;   the prism holds whatever rotation frame it was on and blips out later
000A0Dr 2               ;   instead. Meeting one here is also how the shatter window learns it has to
000A0Dr 2               ;   run BLIP_STEPS rather than SHATTER_STEPS, which saves a second walk.
000A0Dr 2               ; -----------------------------------------------------------------------------
000A0Dr 2               AnimCellGlow:
000A0Dr 2  BD rr rr       lda Board,x
000A10r 2  29 F8          and #COLOR_MASK
000A12r 2  C9 70          cmp #WILD_BASE
000A14r 2  F0 05          beq @Prism
000A16r 2  09 06          ora #GLYPH_GLOW               ; The colour key's low three bits are clear, so
000A18r 2  4C rr rr       jmp RenderCellAs              ;   an ORA is the whole conversion (SPEC 4.2)
000A1Br 2               @Prism:
000A1Br 2  A9 05          lda #BLIP_STEPS
000A1Dr 2  8D rr rr       sta AnimSteps
000A20r 2  60             rts
000A21r 2               
000A21r 2               ; -----------------------------------------------------------------------------
000A21r 2               ;   AnimCellShatter — the ring frame this cell is showing right now
000A21r 2               ;   In:  X = board index, AnimStep      Out: nothing.  Modifies: A, X, Y
000A21r 2               ;   SPEC 14, Appendix A.3 — one ring, opening outward for everything except a
000A21r 2               ;   prism, which runs it closed inward.
000A21r 2               ; -----------------------------------------------------------------------------
000A21r 2               AnimCellShatter:
000A21r 2  BD rr rr       lda Board,x
000A24r 2  29 F8          and #COLOR_MASK
000A26r 2  C9 70          cmp #WILD_BASE
000A28r 2  F0 0D          beq @Blip
000A2Ar 2  AC rr rr       ldy AnimStep
000A2Dr 2  C0 04          cpy #(SHATTER_STEPS + 1)
000A2Fr 2  B0 0F          bcs @Done                     ; The ring is spent and the cell already blank.
000A31r 2  B9 rr rr       lda VfxShatter,y              ;   Only reachable while a prism holds the
000A34r 2  4C rr rr       jmp RenderCellAs              ;   window open for its last two frames
000A37r 2               @Blip:
000A37r 2  AC rr rr       ldy AnimStep
000A3Ar 2  B9 rr rr       lda VfxBlip,y
000A3Dr 2  4C rr rr       jmp RenderCellAs
000A40r 2               @Done:
000A40r 2  60             rts
000A41r 2               
000A41r 2               ; -----------------------------------------------------------------------------
000A41r 2               ;   AnimBeam — the bolt's beams, along its whole row and its whole column
000A41r 2               ;   In:  X = board index of the bolt; AnimIdx holds the same index, because
000A41r 2               ;        this is only ever reached from AnimMarked's cursor
000A41r 2               ;   Out: nothing.  Modifies: A, X, Y, AnimCur, AnimEnd, AnimArg
000A41r 2               ;   SPEC 14, Appendix A.3.
000A41r 2               ;
000A41r 2               ;   The beams cover EVERY cell of the row and the column, empty ones included.
000A41r 2               ;   A beam has to butt against its neighbours to read as a beam, and the cells
000A41r 2               ;   the bolt found empty were never marked — so those are also the cells the
000A41r 2               ;   ANIM_UNBEAM pass exists to put back, since nothing else would ever draw
000A41r 2               ;   them again.
000A41r 2               ;
000A41r 2               ;   The cross goes down last, over both walks, because it is the one cell that
000A41r 2               ;   belongs to each.
000A41r 2               ; -----------------------------------------------------------------------------
000A41r 2               AnimBeam:
000A41r 2  8A             txa
000A42r 2  29 07          and #(BOARD_STRIDE - 1)
000A44r 2  85 rr          sta AnimArg                   ; Its column, for the second walk
000A46r 2  8A             txa
000A47r 2  29 F8          and #(256 - BOARD_STRIDE)     ; $F8 — its row base
000A49r 2  85 rr          sta AnimCur
000A4Br 2  18             clc
000A4Cr 2  69 06          adc #BOARD_W
000A4Er 2  85 rr          sta AnimEnd                   ; One past the row's last playfield cell
000A50r 2               @Row:
000A50r 2  A6 rr          ldx AnimCur
000A52r 2  A9 3B          lda #VFX_BEAM_H
000A54r 2  20 rr rr       jsr AnimBeamCell
000A57r 2  E6 rr          inc AnimCur
000A59r 2  A5 rr          lda AnimCur
000A5Br 2  C5 rr          cmp AnimEnd
000A5Dr 2  90 F1          bcc @Row
000A5Fr 2               
000A5Fr 2  A5 rr          lda AnimArg                   ; The column, row 0 downward
000A61r 2  85 rr          sta AnimCur
000A63r 2               @Col:
000A63r 2  A6 rr          ldx AnimCur
000A65r 2  A9 3C          lda #VFX_BEAM_V
000A67r 2  20 rr rr       jsr AnimBeamCell
000A6Ar 2  A5 rr          lda AnimCur
000A6Cr 2  18             clc
000A6Dr 2  69 08          adc #BOARD_STRIDE
000A6Fr 2  85 rr          sta AnimCur
000A71r 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000A73r 2  90 EE          bcc @Col
000A75r 2               
000A75r 2  A6 rr          ldx AnimIdx                   ; The bolt's own cell. The outer walk is still
000A77r 2  A9 3D          lda #VFX_BEAM_CROSS           ;   standing on it, which is cheaper than
000A79r 2                 ; falls through                ;   keeping a copy across both walks
000A79r 2               
000A79r 2               ; -----------------------------------------------------------------------------
000A79r 2               ;   AnimBeamCell — one cell of a beam, drawn or put back
000A79r 2               ;   In:  X = board index, A = beam tile      Modifies: A, X, Y
000A79r 2               ;
000A79r 2               ;   On the way back only the cells that are NOT marked need anything: the
000A79r 2               ;   marked ones are about to be drawn by the shatter, twice a frame apart, and
000A79r 2               ;   drawing them here as well would only queue two marks for one cell.
000A79r 2               ;
000A79r 2               ;   THE RESTORE IS THE ONE MARK IN THE WHOLE ANIMATION THAT CANNOT BE DROPPED.
000A79r 2               ;   Every other one is made again within a few frames — a lost glow is covered
000A79r 2               ;   by the shatter six frames later, a lost ring frame by CascadeRemove at the
000A79r 2               ;   end of it — but a beam laid over an EMPTY cell has nothing behind it that
000A79r 2               ;   anything will ever draw again, and D6's drop-on-overflow would leave a
000A79r 2               ;   white beam sitting in the well for the rest of the game. Five bolts in one
000A79r 2               ;   run put 110 beam cells through here against a 64-entry ring, so this is
000A79r 2               ;   reachable and not theoretical. It takes the same way out CascadeRemove
000A79r 2               ;   does: the whole-well redraw cursor, which repaints every one of them from
000A79r 2               ;   the board (D12).
000A79r 2               ; -----------------------------------------------------------------------------
000A79r 2               AnimBeamCell:
000A79r 2  A4 rr          ldy AnimMode
000A7Br 2  C0 01          cpy #ANIM_BEAM
000A7Dr 2  D0 03          bne @Restore
000A7Fr 2  4C rr rr       jmp RenderCellAs
000A82r 2               @Restore:
000A82r 2  8A             txa
000A83r 2  48             pha                           ; MarkTest takes the index in A and clobbers
000A84r 2  20 rr rr       jsr MarkTest                  ;   X; neither PLA nor TAX touches C
000A87r 2  68             pla
000A88r 2  AA             tax
000A89r 2  B0 0D          bcs @Done                     ; Marked — the shatter has it
000A8Br 2  AD rr rr       lda DirtyCount
000A8Er 2  C9 40          cmp #DIRTY_ENTRIES
000A90r 2  B0 03          bcs @Bulk                     ; No room, and this cell must not be lost
000A92r 2  4C rr rr       jmp RenderCell                ; Board,x — empty, in every case that gets here
000A95r 2               @Bulk:
000A95r 2  4C rr rr       jmp RenderBoard               ; Sets the cursor and nothing else; the cells
000A98r 2                                               ;   already queued still land and the redraw
000A98r 2                                               ;   goes over them with the same values
000A98r 2               @Done:
000A98r 2  60             rts
000A99r 2               
000A99r 2               ; =============================================================================
000A99r 2               ;   The two windows
000A99r 2               ; =============================================================================
000A99r 2               
000A99r 2               ; -----------------------------------------------------------------------------
000A99r 2               ;   AnimGlowBegin — SPEC 8 step 5, first half. Called with MARKS filled and
000A99r 2               ;   the effect queue drained, from CascadeEnter.
000A99r 2               ;   Out: PlayState = PLAY_GLOW.  Modifies: A, X, Y, Anim*
000A99r 2               ;
000A99r 2               ;   The fireball's flash is already lit: EffectResolve calls HalColorFlash as
000A99r 2               ;   it detonates, so TintColor arriving here as anything but TINT_NONE is how
000A99r 2               ;   this knows a fireball fired and the window has to be the longer one
000A99r 2               ;   (SPEC 14). Two fireballs of different colours in one step leave the LAST
000A99r 2               ;   one's colour flashing — one byte can only name one group, and the other's
000A99r 2               ;   cells still glow and still shatter.
000A99r 2               ; -----------------------------------------------------------------------------
000A99r 2               AnimGlowBegin:
000A99r 2  A9 03          lda #SHATTER_STEPS            ; Raised to BLIP_STEPS by AnimCellGlow if it
000A9Br 2  8D rr rr       sta AnimSteps                 ;   meets a marked prism
000A9Er 2  A9 00          lda #ANIM_GLOW
000AA0r 2  20 rr rr       jsr AnimMarked
000AA3r 2  A9 01          lda #ANIM_BEAM
000AA5r 2  20 rr rr       jsr AnimMarked
000AA8r 2               
000AA8r 2  AE rr rr       ldx Region
000AABr 2  BD rr rr       lda GlowFrames,x
000AAEr 2  AC rr rr       ldy TintColor
000AB1r 2  C0 01          cpy #TINT_NONE
000AB3r 2  F0 08          beq @Time
000AB5r 2  BD rr rr       lda FlashFrames,x
000AB8r 2  48             pha
000AB9r 2  20 rr rr       jsr RenderNext                ; The preview is redrawn so that a piece of the
000ABCr 2  68             pla                           ;   flashing colour goes white there too. On
000ABDr 2                                               ;   the AC6502 the whole group recolours and
000ABDr 2                                               ;   this changes nothing; on the Commodores the
000ABDr 2                                               ;   tint is per cell and this is the only way
000ABDr 2                                               ;   those three cells hear about it (SPEC 4.6)
000ABDr 2               @Time:
000ABDr 2  8D rr rr       sta AnimTimer
000AC0r 2  A9 02          lda #PLAY_GLOW
000AC2r 2  8D rr rr       sta PlayState
000AC5r 2  60             rts
000AC6r 2               
000AC6r 2               ; -----------------------------------------------------------------------------
000AC6r 2               ;   AnimGlowEnd — take the beams and the flash down, and start the shatter
000AC6r 2               ;   Out: PlayState = PLAY_SHATTER.  Modifies: A, X, Y, Anim*
000AC6r 2               ; -----------------------------------------------------------------------------
000AC6r 2               AnimGlowEnd:
000AC6r 2  A9 02          lda #ANIM_UNBEAM
000AC8r 2  20 rr rr       jsr AnimMarked
000ACBr 2               
000ACBr 2  AD rr rr       lda TintColor
000ACEr 2  C9 01          cmp #TINT_NONE
000AD0r 2  F0 08          beq AnimShatterBegin
000AD2r 2  A9 01          lda #TINT_NONE
000AD4r 2  20 rr rr       jsr HalColorFlash             ; The flash ends with the window; every cell it
000AD7r 2  20 rr rr       jsr RenderNext                ;   covered is marked and about to be redrawn
000ADAr 2                                               ;   by the shatter, so only the preview needs
000ADAr 2                                               ;   asking for again
000ADAr 2                 ; falls through
000ADAr 2               
000ADAr 2               ; -----------------------------------------------------------------------------
000ADAr 2               ;   AnimShatterBegin — SPEC 8 step 5, second half
000ADAr 2               ;   Out: PlayState = PLAY_SHATTER.  Modifies: A, X, Y, Anim*
000ADAr 2               ;   Frame 0 of the ring goes up now rather than next frame, so the window is
000ADAr 2               ;   AnimSteps * VFX_FRAMES frames long and every tile of it holds for
000ADAr 2               ;   VFX_FRAMES, the last one included.
000ADAr 2               ; -----------------------------------------------------------------------------
000ADAr 2               AnimShatterBegin:
000ADAr 2  A9 00          lda #0
000ADCr 2  8D rr rr       sta AnimStep
000ADFr 2  A9 02          lda #VFX_FRAMES
000AE1r 2  8D rr rr       sta AnimTimer
000AE4r 2  A9 03          lda #PLAY_SHATTER
000AE6r 2  8D rr rr       sta PlayState
000AE9r 2  A9 03          lda #ANIM_SHATTER
000AEBr 2  4C rr rr       jmp AnimMarked
000AEEr 2               
000AEEr 2               ; =============================================================================
000AEEr 2               ;   The prism at rest (SPEC 7.3, 14)
000AEEr 2               ; =============================================================================
000AEEr 2               
000AEEr 2               ; -----------------------------------------------------------------------------
000AEEr 2               ;   AnimPrismTick — advance the idle rotation, one frame every PRISM_SPIN_RATE
000AEEr 2               ;   Out: nothing.  Modifies: A, X, Y, AnimIdx, AnimArg, PrismFrame, PrismTimer
000AEEr 2               ;
000AEEr 2               ;   The only tile in the game that moves when nothing is happening, and the
000AEEr 2               ;   only place other than the petrify that WRITES a tile to the board without
000AEEr 2               ;   the board having changed: a prism's cell really does hold WILD_BASE + 0..3
000AEEr 2               ;   from here on. Everything that reads a cell masks the colour first, so the
000AEEr 2               ;   glyph bits carrying a frame number rather than a zero is invisible to the
000AEEr 2               ;   scan, to gravity and to the effects — but it is exactly why P5 made
000AEEr 2               ;   EffectEnqueue test the colour before the glyph, and why the petrify below
000AEEr 2               ;   does too.
000AEEr 2               ;
000AEEr 2               ;   IT DOES NOT RUN DURING THE GLOW OR THE SHATTER. A marked prism has to hold
000AEEr 2               ;   still for the glow window and then play its blip-out, and it is cheaper to
000AEEr 2               ;   stand the whole walk down for those twelve frames than to test every cell
000AEEr 2               ;   against MARKS.
000AEEr 2               ;
000AEEr 2               ;   The walk is the 96 cells of the well every eighth frame whether a prism is
000AEEr 2               ;   on the board or not — about 150 cycles a frame amortised, against a board
000AEEr 2               ;   scan's eleven thousand. Remembering where the prisms are would cost more
000AEEr 2               ;   than it saves, and would have to be kept right through gravity.
000AEEr 2               ; -----------------------------------------------------------------------------
000AEEr 2               AnimPrismTick:
000AEEr 2  AD rr rr       lda PlayState
000AF1r 2  C9 02          cmp #PLAY_GLOW
000AF3r 2  F0 4B          beq @Done
000AF5r 2  C9 03          cmp #PLAY_SHATTER
000AF7r 2  F0 47          beq @Done
000AF9r 2  CE rr rr       dec PrismTimer
000AFCr 2  D0 42          bne @Done
000AFEr 2               
000AFEr 2  A9 08          lda #PRISM_SPIN_RATE
000B00r 2  8D rr rr       sta PrismTimer
000B03r 2  EE rr rr       inc PrismFrame
000B06r 2  AD rr rr       lda PrismFrame
000B09r 2  29 03          and #(PRISM_SPIN_FRAMES - 1)
000B0Br 2  8D rr rr       sta PrismFrame
000B0Er 2  09 70          ora #PRISM_SPIN               ; WILD_BASE + frame (SPEC A.3)
000B10r 2  85 rr          sta AnimArg
000B12r 2               
000B12r 2  A9 00          lda #0
000B14r 2  85 rr          sta AnimIdx
000B16r 2               @Cell:
000B16r 2  A6 rr          ldx AnimIdx
000B18r 2  BD rr rr       lda Board,x
000B1Br 2  29 F8          and #COLOR_MASK
000B1Dr 2  C9 70          cmp #WILD_BASE
000B1Fr 2  D0 08          bne @Next
000B21r 2  A5 rr          lda AnimArg
000B23r 2  9D rr rr       sta Board,x
000B26r 2  20 rr rr       jsr RenderCell
000B29r 2               @Next:
000B29r 2  E6 rr          inc AnimIdx
000B2Br 2  A5 rr          lda AnimIdx
000B2Dr 2  29 07          and #(BOARD_STRIDE - 1)
000B2Fr 2  C9 06          cmp #BOARD_W
000B31r 2  90 07          bcc @Test
000B33r 2  A5 rr          lda AnimIdx                   ; Over the two sentinel columns
000B35r 2  18             clc
000B36r 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000B38r 2  85 rr          sta AnimIdx
000B3Ar 2               @Test:
000B3Ar 2  A5 rr          lda AnimIdx
000B3Cr 2  C9 80          cmp #(BOARD_H * BOARD_STRIDE)
000B3Er 2  90 D6          bcc @Cell
000B40r 2               @Done:
000B40r 2  60             rts
000B41r 2               
000B41r 2               ; =============================================================================
000B41r 2               ;   The message band (SPEC 12.2, 14)
000B41r 2               ; =============================================================================
000B41r 2               
000B41r 2               ; -----------------------------------------------------------------------------
000B41r 2               ;   AnimBannerShow — put a banner up for BannerFrames
000B41r 2               ;   In:  Ptr1 -> string      Out: nothing.  Modifies: A, X, Y and the text
000B41r 2               ;        cursor
000B41r 2               ; -----------------------------------------------------------------------------
000B41r 2               AnimBannerShow:
000B41r 2  20 rr rr       jsr TextBanner
000B44r 2  AE rr rr       ldx Region
000B47r 2  BD rr rr       lda BannerFrames,x
000B4Ar 2  8D rr rr       sta BannerTimer
000B4Dr 2  60             rts
000B4Er 2               
000B4Er 2               ; -----------------------------------------------------------------------------
000B4Er 2               ;   AnimBannerTick — one frame of whatever banner is up
000B4Er 2               ;   Out: nothing.  Modifies: A, X, Y
000B4Er 2               ;   Play never stops for a banner: it ticks alongside the sub-states, like the
000B4Er 2               ;   high-score flash it shares its clock with (SPEC 9.8).
000B4Er 2               ; -----------------------------------------------------------------------------
000B4Er 2               AnimBannerTick:
000B4Er 2  AD rr rr       lda BannerTimer
000B51r 2  F0 08          beq @Done
000B53r 2  CE rr rr       dec BannerTimer
000B56r 2  D0 03          bne @Done
000B58r 2  4C rr rr       jmp TextBannerClear
000B5Br 2               @Done:
000B5Br 2  60             rts
000B5Cr 2               
000B5Cr 2               ; -----------------------------------------------------------------------------
000B5Cr 2               ;   AnimBannerLevel — "~~ LEVEL UP ~~" (SPEC 10.1, 14)
000B5Cr 2               ; -----------------------------------------------------------------------------
000B5Cr 2               AnimBannerLevel:
000B5Cr 2  A9 rr          lda #<MsgLevelUp
000B5Er 2  85 rr          sta Ptr1
000B60r 2  A9 rr          lda #>MsgLevelUp
000B62r 2  85 rr          sta Ptr1+1
000B64r 2  4C rr rr       jmp AnimBannerShow
000B67r 2               
000B67r 2               ; -----------------------------------------------------------------------------
000B67r 2               ;   AnimBannerChain — "~~ CHAIN xN ~~" (SPEC 8 SETTLE, 14)
000B67r 2               ;   In:  A = links in the cascade      Modifies: A, X, Y and the text cursor
000B67r 2               ;
000B67r 2               ;   The banner is a fixed-length string with a placeholder digit, overwritten
000B67r 2               ;   afterwards at CHAIN_DIGIT_X — which is a constant only because the string
000B67r 2               ;   is MSG_CHAIN_LEN cells long and TextBanner centres on PANEL_W
000B67r 2               ;   (constants.inc). A chain past 9 says 9 rather than drawing whatever tile
000B67r 2               ;   FONT_DIGIT_0 + 10 turns out to be.
000B67r 2               ; -----------------------------------------------------------------------------
000B67r 2               AnimBannerChain:
000B67r 2  C9 0A          cmp #(CHAIN_MAX_SHOWN + 1)
000B69r 2  90 02          bcc @Show
000B6Br 2  A9 09          lda #CHAIN_MAX_SHOWN
000B6Dr 2               @Show:
000B6Dr 2  48             pha
000B6Er 2  A9 rr          lda #<MsgChain
000B70r 2  85 rr          sta Ptr1
000B72r 2  A9 rr          lda #>MsgChain
000B74r 2  85 rr          sta Ptr1+1
000B76r 2  20 rr rr       jsr AnimBannerShow
000B79r 2  68             pla
000B7Ar 2  18             clc
000B7Br 2  69 10          adc #FONT_DIGIT_0
000B7Dr 2  A2 0E          ldx #CHAIN_DIGIT_X
000B7Fr 2  A0 16          ldy #MSG_Y
000B81r 2  4C rr rr       jmp RenderMark
000B84r 2               
000B84r 2               ; =============================================================================
000B84r 2               ;   Game over (SPEC 13.4)
000B84r 2               ; =============================================================================
000B84r 2               
000B84r 2               ; -----------------------------------------------------------------------------
000B84r 2               ;   AnimPetrifyBegin — start the well turning to stone from the floor up
000B84r 2               ;   Out: nothing.  Modifies: A
000B84r 2               ; -----------------------------------------------------------------------------
000B84r 2               AnimPetrifyBegin:
000B84r 2  A9 0F          lda #(BOARD_H - 1)
000B86r 2  8D rr rr       sta PetrifyRow
000B89r 2  A9 02          lda #PETRIFY_FRAMES
000B8Br 2  8D rr rr       sta AnimTimer
000B8Er 2  60             rts
000B8Fr 2               
000B8Fr 2               ; -----------------------------------------------------------------------------
000B8Fr 2               ;   AnimPetrifyTick — one frame of it
000B8Fr 2               ;   Out: C set while it is still running, clear once the well is stone.
000B8Fr 2               ;        Modifies: A, X, Y, AnimIdx, AnimEnd, AnimTimer, PetrifyRow, Board
000B8Fr 2               ;   SPEC 13.4 — a row every PETRIFY_FRAMES, bottom upward, 32 frames in all.
000B8Fr 2               ;
000B8Fr 2               ;   Each cell sets as ITS OWN SHAPE, because group 15 holds the petrified
000B8Fr 2               ;   glyphs at the same five offsets the potions use (SPEC A.3): one AND and
000B8Fr 2               ;   one ORA, and a bomb sets as a stone bomb at the exact moment the player is
000B8Fr 2               ;   looking hardest at the board. Empty cells stay empty — the pile petrifies,
000B8Fr 2               ;   not the well.
000B8Fr 2               ;
000B8Fr 2               ;   A prism has no stone twin, so it sets as the plain one. Testing the colour
000B8Fr 2               ;   first is what keeps it off `PETRIFY_BASE + 3`, a stone bomb, which is what
000B8Fr 2               ;   a rotating prism's glyph bits would otherwise buy (AnimPrismTick above).
000B8Fr 2               ; -----------------------------------------------------------------------------
000B8Fr 2               AnimPetrifyTick:
000B8Fr 2  AD rr rr       lda PetrifyRow
000B92r 2  30 42          bmi @Finished                 ; $FF — the whole well is stone
000B94r 2  CE rr rr       dec AnimTimer
000B97r 2  D0 3B          bne @Running
000B99r 2               
000B99r 2  A9 02          lda #PETRIFY_FRAMES
000B9Br 2  8D rr rr       sta AnimTimer
000B9Er 2  AD rr rr       lda PetrifyRow
000BA1r 2  0A             asl a                         ; Row base — the board's stride is 8
000BA2r 2  0A             asl a
000BA3r 2  0A             asl a
000BA4r 2  85 rr          sta AnimIdx
000BA6r 2  18             clc
000BA7r 2  69 06          adc #BOARD_W
000BA9r 2  85 rr          sta AnimEnd
000BABr 2               @Cell:
000BABr 2  A6 rr          ldx AnimIdx
000BADr 2  BD rr rr       lda Board,x
000BB0r 2  F0 17          beq @Next                     ; Empty stays empty (SPEC 13.4)
000BB2r 2  29 F8          and #COLOR_MASK
000BB4r 2  C9 70          cmp #WILD_BASE
000BB6r 2  F0 09          beq @Prism
000BB8r 2  BD rr rr       lda Board,x
000BBBr 2  29 07          and #GLYPH_MASK
000BBDr 2  09 78          ora #PETRIFY_BASE
000BBFr 2  D0 02          bne @Set                      ; Always — PETRIFY_BASE is 120
000BC1r 2               @Prism:
000BC1r 2  A9 78          lda #PETRIFY_BASE
000BC3r 2               @Set:
000BC3r 2  9D rr rr       sta Board,x
000BC6r 2  20 rr rr       jsr RenderCell
000BC9r 2               @Next:
000BC9r 2  E6 rr          inc AnimIdx
000BCBr 2  A5 rr          lda AnimIdx
000BCDr 2  C5 rr          cmp AnimEnd
000BCFr 2  90 DA          bcc @Cell
000BD1r 2  CE rr rr       dec PetrifyRow
000BD4r 2               @Running:
000BD4r 2  38             sec
000BD5r 2  60             rts
000BD6r 2               @Finished:
000BD6r 2  18             clc
000BD7r 2  60             rts
000BD8r 2               
000BD8r 1               .include "../src/score.asm"
000BD8r 2               ; =============================================================================
000BD8r 2               ;   score.asm — Wizards Lab, scoring
000BD8r 2               ; =============================================================================
000BD8r 2               ;   SPEC.md section 9. Seven digits of packed BCD in four bytes, low byte
000BD8r 2               ;   first; the top nibble of ScoreTop is held at zero. Every value in
000BD8r 2               ;   tables.inc is a multiple of ten, so scoring is a SED / ADC chain and never
000BD8r 2               ;   a multiply — the one place a tile count has to be multiplied by a table
000BD8r 2               ;   value, it is done as a loop of BCD additions, and the count is at most 21.
000BD8r 2               ;
000BD8r 2               ;   The score clamps at 9999999. It never wraps.
000BD8r 2               ;
000BD8r 2               ;   Display is always all seven digits, zero padded — see TextBcd. Nothing
000BD8r 2               ;   here strips a leading zero, and nothing downstream may either.
000BD8r 2               ;
000BD8r 2               ;   TWO WAYS IN, AND THEY ARE NOT INTERCHANGEABLE (D5):
000BD8r 2               ;
000BD8r 2               ;     CascadeAdd / CascadeAddTimes    points scored INSIDE a cascade. They go
000BD8r 2               ;                                     into Cascade{Lo,Mid,Hi} and stay there
000BD8r 2               ;                                     until CascadeSettle, because a star
000BD8r 2               ;                                     caught anywhere in the cascade doubles
000BD8r 2               ;                                     everything it scored, retroactively
000BD8r 2               ;                                     (SPEC 9.6).
000BD8r 2               ;     ScoreAward                      the awards SPEC 9.6 gives outside a
000BD8r 2               ;                                     cascade — the soft drop and the level-up
000BD8r 2               ;                                     bonus. These reach Score at once and a
000BD8r 2               ;                                     star never touches them.
000BD8r 2               ;
000BD8r 2               ;   Both funnel through ScoreBank, which is the only routine that writes
000BD8r 2               ;   Score, the only one that clamps, and the only one that can hand the high
000BD8r 2               ;   score over to the player.
000BD8r 2               ; =============================================================================
000BD8r 2               
000BD8r 2               ; -----------------------------------------------------------------------------
000BD8r 2               ;   ScoreHighInit — seed the session high score, once, at power-on
000BD8r 2               ;   SPEC 9.8 — the high score is not persisted; it starts at 0010000 on every
000BD8r 2               ;   power-on, which is the target the first game is played against. It then
000BD8r 2               ;   survives every game in the session, so this is deliberately NOT part of
000BD8r 2               ;   ScoreReset. Nothing may infer "cold boot" from the value being zero: BSS
000BD8r 2               ;   is not cleared on all three machines.
000BD8r 2               ;   Out: nothing.  Modifies: A
000BD8r 2               ; -----------------------------------------------------------------------------
000BD8r 2               ScoreHighInit:
000BD8r 2  A9 00          lda #HIGH_INIT_LO
000BDAr 2  8D rr rr       sta HighLo
000BDDr 2  A9 00          lda #HIGH_INIT_MID
000BDFr 2  8D rr rr       sta HighMid
000BE2r 2  A9 01          lda #HIGH_INIT_HI
000BE4r 2  8D rr rr       sta HighHi
000BE7r 2  A9 00          lda #HIGH_INIT_TOP
000BE9r 2  8D rr rr       sta HighTop
000BECr 2  A9 01          lda #$01                      ; BCD — the level the target was "set" on
000BEEr 2  8D rr rr       sta HighLevel
000BF1r 2  60             rts
000BF2r 2               
000BF2r 2               ; -----------------------------------------------------------------------------
000BF2r 2               ;   ScoreReset — zero the score for a new game
000BF2r 2               ;   Out: nothing.  Modifies: A
000BF2r 2               ;
000BF2r 2               ;   The high score itself is NOT reset (SPEC 9.8) — but the two flags that say
000BF2r 2               ;   what this game has done about it are, or the second game of a session
000BF2r 2               ;   would never flash.
000BF2r 2               ; -----------------------------------------------------------------------------
000BF2r 2               ScoreReset:
000BF2r 2  A9 00          lda #0
000BF4r 2  8D rr rr       sta ScoreLo
000BF7r 2  8D rr rr       sta ScoreMid
000BFAr 2  8D rr rr       sta ScoreHi
000BFDr 2  8D rr rr       sta ScoreTop
000C00r 2  8D rr rr       sta CascadeLo
000C03r 2  8D rr rr       sta CascadeMid
000C06r 2  8D rr rr       sta CascadeHi
000C09r 2  8D rr rr       sta StarCount
000C0Cr 2  8D rr rr       sta HighOwned
000C0Fr 2  8D rr rr       sta HighFlash
000C12r 2  8D rr rr       sta HighTimer
000C15r 2  60             rts
000C16r 2               
000C16r 2               ; -----------------------------------------------------------------------------
000C16r 2               ;   CascadeAdd — add a 16-bit BCD value to the cascade accumulator
000C16r 2               ;   In:  A = low BCD byte, X = high BCD byte
000C16r 2               ;   Out: nothing.  Modifies: A, flags.  PRESERVES X and Y.
000C16r 2               ;
000C16r 2               ;   Preserving X and Y is what lets CascadeAddTimes loop over this without
000C16r 2               ;   spilling anything, and Tmp0-Tmp3 may not be held across a JSR anyway
000C16r 2               ;   (zeropage.inc).
000C16r 2               ; -----------------------------------------------------------------------------
000C16r 2               CascadeAdd:
000C16r 2  F8             sed
000C17r 2  18             clc
000C18r 2  6D rr rr       adc CascadeLo
000C1Br 2  8D rr rr       sta CascadeLo
000C1Er 2  8A             txa
000C1Fr 2  6D rr rr       adc CascadeMid
000C22r 2  8D rr rr       sta CascadeMid
000C25r 2  AD rr rr       lda CascadeHi
000C28r 2  69 00          adc #0
000C2Ar 2  8D rr rr       sta CascadeHi
000C2Dr 2  D8             cld                           ; CLD leaves the carry alone
000C2Er 2  B0 01          bcs CascadeClamp
000C30r 2  60             rts
000C31r 2               
000C31r 2               ; -----------------------------------------------------------------------------
000C31r 2               ;   CascadeClamp — six nines, when an accumulate would have wrapped
000C31r 2               ;   Out: nothing.  Modifies: A.  PRESERVES X and Y.
000C31r 2               ;
000C31r 2               ;   Not reachable by playing: nothing is ever ADDED to the board during a
000C31r 2               ;   cascade, so one cascade can never remove more than the 96 cells the well
000C31r 2               ;   holds, and 96 cells at the dearest tile value there is (650, SPEC 9.2)
000C31r 2               ;   plus every bonus in section 9 comes to a little over 200,000 — a fifth of
000C31r 2               ;   what three bytes hold, and an eighth of what it would take to wrap after
000C31r 2               ;   the star cap has doubled it three times. It is here because "never wraps"
000C31r 2               ;   in SPEC 9 has to be true of every accumulator on the path, not just of the
000C31r 2               ;   one the player can see.
000C31r 2               ; -----------------------------------------------------------------------------
000C31r 2               CascadeClamp:
000C31r 2  A9 99          lda #$99
000C33r 2  8D rr rr       sta CascadeLo
000C36r 2  8D rr rr       sta CascadeMid
000C39r 2  8D rr rr       sta CascadeHi
000C3Cr 2  60             rts
000C3Dr 2               
000C3Dr 2               ; -----------------------------------------------------------------------------
000C3Dr 2               ;   CascadeAddTimes — add a value N times (the tiles-cleared multiply)
000C3Dr 2               ;   In:  A = low BCD, X = high BCD, Y = count
000C3Dr 2               ;   Out: nothing.  Modifies: A, Y, flags.  PRESERVES X.
000C3Dr 2               ;
000C3Dr 2               ;   SPEC 9 chose values that are all multiples of ten so that scoring is an
000C3Dr 2               ;   ADC chain, but `length * TileValue[chain]` is still a multiply. The count
000C3Dr 2               ;   is a run length — three to sixteen — so a loop of BCD additions is both
000C3Dr 2               ;   smaller and, at these counts, faster than any multiply routine worth
000C3Dr 2               ;   writing.
000C3Dr 2               ; -----------------------------------------------------------------------------
000C3Dr 2               CascadeAddTimes:
000C3Dr 2  48             pha                           ; The low byte rides the stack, because
000C3Er 2               @Loop:                          ;   CascadeAdd returns in A
000C3Er 2  C0 00          cpy #0
000C40r 2  F0 08          beq @Done
000C42r 2  68             pla
000C43r 2  48             pha
000C44r 2  20 rr rr       jsr CascadeAdd
000C47r 2  88             dey
000C48r 2  D0 F4          bne @Loop
000C4Ar 2               @Done:
000C4Ar 2  68             pla
000C4Br 2  60             rts
000C4Cr 2               
000C4Cr 2               ; -----------------------------------------------------------------------------
000C4Cr 2               ;   CascadeDouble — one BCD doubling of the cascade accumulator
000C4Cr 2               ;   Out: nothing.  Modifies: A, flags.  PRESERVES X and Y.
000C4Cr 2               ;   A doubling in BCD is a self-addition; three of them is the star cap.
000C4Cr 2               ; -----------------------------------------------------------------------------
000C4Cr 2               CascadeDouble:
000C4Cr 2  F8             sed
000C4Dr 2  18             clc
000C4Er 2  AD rr rr       lda CascadeLo
000C51r 2  6D rr rr       adc CascadeLo
000C54r 2  8D rr rr       sta CascadeLo
000C57r 2  AD rr rr       lda CascadeMid
000C5Ar 2  6D rr rr       adc CascadeMid
000C5Dr 2  8D rr rr       sta CascadeMid
000C60r 2  AD rr rr       lda CascadeHi
000C63r 2  6D rr rr       adc CascadeHi
000C66r 2  8D rr rr       sta CascadeHi
000C69r 2  D8             cld
000C6Ar 2  B0 C5          bcs CascadeClamp
000C6Cr 2  60             rts
000C6Dr 2               
000C6Dr 2               ; -----------------------------------------------------------------------------
000C6Dr 2               ;   ScoreAdd — bank the cascade accumulator into Score, clamped
000C6Dr 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
000C6Dr 2               ;   SPEC 9.8 — the high score updates live, so the player watches the overtake.
000C6Dr 2               ; -----------------------------------------------------------------------------
000C6Dr 2               ScoreAdd:
000C6Dr 2  AD rr rr       lda CascadeLo
000C70r 2  85 rr          sta Tmp0
000C72r 2  AD rr rr       lda CascadeMid
000C75r 2  85 rr          sta Tmp1
000C77r 2  AD rr rr       lda CascadeHi
000C7Ar 2  85 rr          sta Tmp2
000C7Cr 2  4C rr rr       jmp ScoreBank
000C7Fr 2               
000C7Fr 2               ; -----------------------------------------------------------------------------
000C7Fr 2               ;   ScoreAward — add a 16-bit BCD value straight to Score
000C7Fr 2               ;   In:  A = low BCD byte, X = high BCD byte
000C7Fr 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
000C7Fr 2               ;
000C7Fr 2               ;   The two awards SPEC 9.6 gives outside a cascade: one point a row for a
000C7Fr 2               ;   soft drop, and BONUS_LEVELUP when the level advances. Neither is a cascade
000C7Fr 2               ;   point and neither is doubled by a star, which is the whole reason they do
000C7Fr 2               ;   not go through CascadeAdd.
000C7Fr 2               ; -----------------------------------------------------------------------------
000C7Fr 2               ScoreAward:
000C7Fr 2  85 rr          sta Tmp0
000C81r 2  86 rr          stx Tmp1
000C83r 2  A9 00          lda #0
000C85r 2  85 rr          sta Tmp2
000C87r 2                 ; falls through into ScoreBank
000C87r 2               
000C87r 2               ; -----------------------------------------------------------------------------
000C87r 2               ;   ScoreBank — Score += the three BCD bytes in Tmp0-Tmp2, clamped at 9999999
000C87r 2               ;   Out: C as ScoreHighCheck leaves it.  Modifies: A, X, Y, Tmp0-Tmp2
000C87r 2               ;
000C87r 2               ;   The only writer of Score. It redraws the field itself, because there is no
000C87r 2               ;   other moment at which the score is known to have changed (SPEC 12.6 —
000C87r 2               ;   nothing polls).
000C87r 2               ; -----------------------------------------------------------------------------
000C87r 2               ScoreBank:
000C87r 2  F8             sed
000C88r 2  18             clc
000C89r 2  AD rr rr       lda ScoreLo
000C8Cr 2  65 rr          adc Tmp0
000C8Er 2  8D rr rr       sta ScoreLo
000C91r 2  AD rr rr       lda ScoreMid
000C94r 2  65 rr          adc Tmp1
000C96r 2  8D rr rr       sta ScoreMid
000C99r 2  AD rr rr       lda ScoreHi
000C9Cr 2  65 rr          adc Tmp2
000C9Er 2  8D rr rr       sta ScoreHi
000CA1r 2  AD rr rr       lda ScoreTop
000CA4r 2  69 00          adc #0
000CA6r 2  8D rr rr       sta ScoreTop
000CA9r 2  D8             cld                           ; CLD leaves the carry alone
000CAAr 2  B0 07          bcs @Clamp
000CACr 2  AD rr rr       lda ScoreTop                  ; The eighth digit is held at zero (SPEC 9),
000CAFr 2  C9 10          cmp #$10                      ;   so anything that reached it has overflowed
000CB1r 2  90 10          bcc @Drawn                    ;   the seven the panel shows
000CB3r 2               @Clamp:
000CB3r 2  A9 99          lda #$99
000CB5r 2  8D rr rr       sta ScoreLo
000CB8r 2  8D rr rr       sta ScoreMid
000CBBr 2  8D rr rr       sta ScoreHi
000CBEr 2  A9 09          lda #$09
000CC0r 2  8D rr rr       sta ScoreTop
000CC3r 2               @Drawn:
000CC3r 2  20 rr rr       jsr RenderScore
000CC6r 2                 ; falls through into ScoreHighCheck
000CC6r 2               
000CC6r 2               ; -----------------------------------------------------------------------------
000CC6r 2               ;   ScoreHighCheck — hand the high score over the moment the score reaches it
000CC6r 2               ;   Out: C set if the score is level with or past the high score — which, once
000CC6r 2               ;        it has been taken, is EVERY call. The one-shot is HighOwned below, not
000CC6r 2               ;        this flag; nothing currently reads it.  Modifies: A, X, Y, Tmp0
000CC6r 2               ;
000CC6r 2               ;   SPEC 9.8. The copy happens on every call once the score is level with the
000CC6r 2               ;   high score, not just on the first — that is what keeps HighLevel tracking
000CC6r 2               ;   the live level while a run is holding its own record, which is the point of
000CC6r 2               ;   the number: it says how deep you have to get to beat it.
000CC6r 2               ;
000CC6r 2               ;   The fanfare and the flash are the one-shot half, and HighOwned is what
000CC6r 2               ;   makes them one: without it every subsequent bank would fire them again,
000CC6r 2               ;   because from the overtake onward the score and the high score are equal.
000CC6r 2               ; -----------------------------------------------------------------------------
000CC6r 2               ScoreHighCheck:
000CC6r 2  AD rr rr       lda HighTop                   ; Four-byte compare, most significant first
000CC9r 2  CD rr rr       cmp ScoreTop
000CCCr 2  D0 16          bne @Test
000CCEr 2  AD rr rr       lda HighHi
000CD1r 2  CD rr rr       cmp ScoreHi
000CD4r 2  D0 0E          bne @Test
000CD6r 2  AD rr rr       lda HighMid
000CD9r 2  CD rr rr       cmp ScoreMid
000CDCr 2  D0 06          bne @Test
000CDEr 2  AD rr rr       lda HighLo
000CE1r 2  CD rr rr       cmp ScoreLo
000CE4r 2               @Test:
000CE4r 2  90 02          bcc @Take                     ; high < score
000CE6r 2  D0 3E          bne @Behind                   ; high > score — nothing to do
000CE8r 2                                               ; equal: still copy, so HighLevel tracks
000CE8r 2               @Take:
000CE8r 2  AD rr rr       lda ScoreLo
000CEBr 2  8D rr rr       sta HighLo
000CEEr 2  AD rr rr       lda ScoreMid
000CF1r 2  8D rr rr       sta HighMid
000CF4r 2  AD rr rr       lda ScoreHi
000CF7r 2  8D rr rr       sta HighHi
000CFAr 2  AD rr rr       lda ScoreTop
000CFDr 2  8D rr rr       sta HighTop
000D00r 2  20 rr rr       jsr ScoreLevelBcd             ; The level box under the digits is BCD; Level
000D03r 2  8D rr rr       sta HighLevel                 ;   itself is binary (SPEC 12.2)
000D06r 2  20 rr rr       jsr RenderHigh
000D09r 2               
000D09r 2  AD rr rr       lda HighOwned
000D0Cr 2  D0 16          bne @Owned
000D0Er 2  EE rr rr       inc HighOwned
000D11r 2  A9 0B          lda #SFX_HIGHSCORE            ; SPEC 9.8 — a longer fanfare, once
000D13r 2  8D rr rr       sta SfxRequest
000D16r 2  A9 06          lda #HIGH_FLASH_BLINKS
000D18r 2  8D rr rr       sta HighFlash
000D1Br 2  AE rr rr       ldx Region
000D1Er 2  BD rr rr       lda BlinkHalf,x
000D21r 2  8D rr rr       sta HighTimer
000D24r 2               @Owned:
000D24r 2  38             sec
000D25r 2  60             rts
000D26r 2               
000D26r 2               @Behind:
000D26r 2  18             clc
000D27r 2  60             rts
000D28r 2               
000D28r 2               ; -----------------------------------------------------------------------------
000D28r 2               ;   ScoreLevelBcd — Level (binary 1-99) as one packed BCD byte
000D28r 2               ;   Out: A = the level in BCD.  Modifies: A, X, Tmp0
000D28r 2               ; -----------------------------------------------------------------------------
000D28r 2               ScoreLevelBcd:
000D28r 2  AD rr rr       lda Level
000D2Br 2  A2 00          ldx #0
000D2Dr 2               @Tens:
000D2Dr 2  C9 0A          cmp #10
000D2Fr 2  90 05          bcc @Split
000D31r 2  E9 0A          sbc #10                       ; Carry is set by the CMP that got us here
000D33r 2  E8             inx
000D34r 2  D0 F7          bne @Tens                     ; Always — X tops out at 9
000D36r 2               @Split:
000D36r 2  85 rr          sta Tmp0                      ; Units
000D38r 2  8A             txa
000D39r 2  0A             asl a
000D3Ar 2  0A             asl a
000D3Br 2  0A             asl a
000D3Cr 2  0A             asl a
000D3Dr 2  05 rr          ora Tmp0
000D3Fr 2  60             rts
000D40r 2               
000D40r 2               ; -----------------------------------------------------------------------------
000D40r 2               ;   ScoreSoftDrop — one point for one row descended under soft drop (SPEC 9.6)
000D40r 2               ;   Out: nothing.  Modifies: A, X, Y, Tmp0-Tmp2
000D40r 2               ;
000D40r 2               ;   The one award in the game that is not a multiple of ten. BCD does not care.
000D40r 2               ; -----------------------------------------------------------------------------
000D40r 2               ScoreSoftDrop:
000D40r 2  A9 01          lda #$01
000D42r 2  A2 00          ldx #$00
000D44r 2  4C rr rr       jmp ScoreAward
000D47r 2               
000D47r 2               ; -----------------------------------------------------------------------------
000D47r 2               ;   ScoreLevelCheck — advance the level when 30 tiles have gone
000D47r 2               ;   In:  A = tiles removed this step
000D47r 2               ;   Out: C set if the level advanced.  Modifies: A, X, Y, Tmp0-Tmp2
000D47r 2               ;   SPEC 10.1 — at most one advance per step, surplus carries over, so a big
000D47r 2               ;   fireball chain can never skip a level. Match and effect removals both
000D47r 2               ;   count, which is why the count comes from CascadeRemove and not from the
000D47r 2               ;   scan: by then the two are the same cells.
000D47r 2               ; -----------------------------------------------------------------------------
000D47r 2               ScoreLevelCheck:
000D47r 2  18             clc
000D48r 2  6D rr rr       adc TilesCleared
000D4Br 2  8D rr rr       sta TilesCleared              ; A whole step can clear far more than thirty;
000D4Er 2  C9 1E          cmp #LEVEL_TILES              ;   the surplus stays here and buys the next
000D50r 2  90 23          bcc @No                       ;   level on the next step
000D52r 2  E9 1E          sbc #LEVEL_TILES              ; Carry is set by the CMP that got us here
000D54r 2  8D rr rr       sta TilesCleared
000D57r 2               
000D57r 2  AD rr rr       lda Level
000D5Ar 2  C9 63          cmp #LEVEL_MAX_SHOWN
000D5Cr 2  B0 17          bcs @No                       ; The box is two digits wide (SPEC 10.1), and
000D5Er 2  EE rr rr       inc Level                     ;   nothing about level 100 is reachable in a
000D61r 2  20 rr rr       jsr RenderLevel               ;   session anyway
000D64r 2  20 rr rr       jsr AnimBannerLevel           ; SPEC 14 — and play carries straight on; the
000D67r 2                                               ;   band clears itself BannerFrames later
000D67r 2  A9 0A          lda #SFX_LEVELUP
000D69r 2  8D rr rr       sta SfxRequest
000D6Cr 2  A9 00          lda #<BONUS_LEVELUP           ; SPEC 9.6 — an award, not a cascade point, so
000D6Er 2  A2 10          ldx #>BONUS_LEVELUP           ;   a star in the same cascade does not double
000D70r 2  20 rr rr       jsr ScoreAward                ;   it (D5)
000D73r 2  38             sec
000D74r 2  60             rts
000D75r 2               @No:
000D75r 2  18             clc
000D76r 2  60             rts
000D77r 2               
000D77r 2               ; -----------------------------------------------------------------------------
000D77r 2               ;   ScoreFlashTick — one frame of the HIGH field's overtake flash
000D77r 2               ;   Out: nothing.  Modifies: A, X, Y
000D77r 2               ;   SPEC 9.8, SPEC 14 — the blink period is 30 frames NTSC / 25 PAL, shared
000D77r 2               ;   with the title screen's prompt, so HighFlash counts HALF blinks and
000D77r 2               ;   HighTimer counts the frames of one.
000D77r 2               ;
000D77r 2               ;   HighFlash is odd on the dark half and even on the lit one, and it ends at
000D77r 2               ;   zero, so the field is always left readable however the count is set.
000D77r 2               ; -----------------------------------------------------------------------------
000D77r 2               ScoreFlashTick:
000D77r 2  AD rr rr       lda HighFlash
000D7Ar 2  F0 1F          beq @Done
000D7Cr 2  CE rr rr       dec HighTimer
000D7Fr 2  D0 1A          bne @Done
000D81r 2  CE rr rr       dec HighFlash
000D84r 2  F0 12          beq @Show                     ; Out of blinks — end lit
000D86r 2  AE rr rr       ldx Region
000D89r 2  BD rr rr       lda BlinkHalf,x
000D8Cr 2  8D rr rr       sta HighTimer
000D8Fr 2  AD rr rr       lda HighFlash
000D92r 2  4A             lsr a
000D93r 2  90 03          bcc @Show
000D95r 2  4C rr rr       jmp RenderHighBlank
000D98r 2               @Show:
000D98r 2  4C rr rr       jmp RenderHigh
000D9Br 2               @Done:
000D9Br 2  60             rts
000D9Cr 2               
000D9Cr 2               ; -----------------------------------------------------------------------------
000D9Cr 2               ;   ScoreGravity — frames per row for the current level
000D9Cr 2               ;   Out: A = frame count, from SpeedNTSC or SpeedPAL per Region.
000D9Cr 2               ;        Modifies: A, X
000D9Cr 2               ;   SPEC 10.2. Strictly this module is P4's, but the falling piece cannot fall
000D9Cr 2               ;   without it, so it is real ahead of the rest of the file — the same reason
000D9Cr 2               ;   ScoreHighInit landed here in P1.
000D9Cr 2               ; -----------------------------------------------------------------------------
000D9Cr 2               ScoreGravity:
000D9Cr 2  AE rr rr       ldx Level
000D9Fr 2  CA             dex                           ; The table is indexed by level - 1 ...
000DA0r 2  E0 10          cpx #LEVEL_SPEED_CAP
000DA2r 2  90 02          bcc @Level
000DA4r 2  A2 0F          ldx #LEVEL_SPEED_CAP - 1      ;   ... and stops improving at the cap
000DA6r 2               @Level:
000DA6r 2  AD rr rr       lda Region
000DA9r 2  D0 04          bne @Pal
000DABr 2  BD rr rr       lda SpeedNTSC,x
000DAEr 2  60             rts
000DAFr 2               @Pal:
000DAFr 2  BD rr rr       lda SpeedPAL,x
000DB2r 2  60             rts
000DB3r 2               
000DB3r 1               .include "../src/render.asm"
000DB3r 2               ; =============================================================================
000DB3r 2               ;   render.asm — Wizards Lab, the dirty-cell renderer
000DB3r 2               ; =============================================================================
000DB3r 2               ;   SPEC.md section 12.6. The screen is never fully redrawn during play.
000DB3r 2               ;   Changed cells are appended to a ring and flushed once a frame, at most
000DB3r 2               ;   DIRTY_FLUSH_MAX per frame with the remainder carried over.
000DB3r 2               ;
000DB3r 2               ;   The cap is NOT a hardware write-spacing limit. S1 measured this loop at
000DB3r 2               ;   165 cycles a cell on the AC6502, which puts two VRAM data writes 165 us
000DB3r 2               ;   apart at 1 MHz and the closest two VDP PORT accesses 8 cycles apart —
000DB3r 2               ;   inside even a real TMS9918A's 8 us and 2 us windows with two orders of
000DB3r 2               ;   magnitude to spare, and further inside a pico9918's, which emulates VRAM
000DB3r 2               ;   in RP2040 memory and has no display contention at all. A 6502 at this
000DB3r 2               ;   clock cannot write a TMS9918 too fast however hard it tries.
000DB3r 2               ;
000DB3r 2               ;   The cap is a TIME BUDGET: DIRTY_FLUSH_MAX cells is what fits in vertical
000DB3r 2               ;   blank on the tightest of the three. See constants.inc and PLAN.md S1.
000DB3r 2               ;
000DB3r 2               ;   All screen access goes through HalPlotCell (see hal.inc). Nothing in this
000DB3r 2               ;   file knows where screen memory is.
000DB3r 2               ; =============================================================================
000DB3r 2               
000DB3r 2               ; -----------------------------------------------------------------------------
000DB3r 2               ;   RenderDirtyReset — empty the ring and cancel any outstanding board redraw
000DB3r 2               ;   Call this after anything that draws the whole screen behind the renderer's
000DB3r 2               ;   back (HalBlitScreen), because every queued cell then describes a screen
000DB3r 2               ;   that no longer exists.
000DB3r 2               ;   In:  nothing        Out: nothing.  Modifies: A
000DB3r 2               ; -----------------------------------------------------------------------------
000DB3r 2               RenderDirtyReset:
000DB3r 2  A9 00          lda #0
000DB5r 2  8D rr rr       sta DirtyCount
000DB8r 2  8D rr rr       sta DirtyHead
000DBBr 2  8D rr rr       sta DirtyTail
000DBEr 2  A9 FF          lda #$FF
000DC0r 2  8D rr rr       sta RedrawIdx
000DC3r 2  60             rts
000DC4r 2               
000DC4r 2               ; -----------------------------------------------------------------------------
000DC4r 2               ;   RenderMark — queue one panel cell
000DC4r 2               ;   In:  A = tile, X = panel column, Y = panel row
000DC4r 2               ;   Out: nothing.  Modifies: A, X.  PRESERVES Y and every byte of zero page.
000DC4r 2               ;
000DC4r 2               ;   The PANEL_X / PANEL_Y offset is applied here, once, so nothing upstream
000DC4r 2               ;   has to know which machine it is running on.
000DC4r 2               ;
000DC4r 2               ;   Preserving Y and zero page is a contract, not an accident: text.asm holds
000DC4r 2               ;   its string cursor across this call (see zeropage.inc). The three values
000DC4r 2               ;   ride the stack rather than scratch bytes because A, X and Y are all live
000DC4r 2               ;   at once and there is no fourth register to index the ring with.
000DC4r 2               ;
000DC4r 2               ;   A mark that arrives with the ring full is DROPPED, silently (D6).
000DC4r 2               ; -----------------------------------------------------------------------------
000DC4r 2               RenderMark:
000DC4r 2  48             pha                           ; Tile
000DC5r 2  98             tya
000DC6r 2  18             clc
000DC7r 2  69 00          adc #PANEL_Y                  ; Panel row -> screen row
000DC9r 2  48             pha
000DCAr 2  8A             txa
000DCBr 2  18             clc
000DCCr 2  69 09          adc #PANEL_X                  ; Panel column -> screen column
000DCEr 2  48             pha
000DCFr 2               
000DCFr 2  AD rr rr       lda DirtyCount
000DD2r 2  C9 40          cmp #DIRTY_ENTRIES
000DD4r 2  B0 1F          bcs @Full
000DD6r 2  EE rr rr       inc DirtyCount
000DD9r 2               
000DD9r 2  AE rr rr       ldx DirtyTail
000DDCr 2  68             pla
000DDDr 2  9D rr rr       sta Dirty+0,x                 ; Screen column
000DE0r 2  68             pla
000DE1r 2  9D rr rr       sta Dirty+1,x                 ; Screen row
000DE4r 2  68             pla
000DE5r 2  9D rr rr       sta Dirty+2,x                 ; Tile
000DE8r 2               
000DE8r 2  E8             inx                           ; Step one entry, wrapping the ring
000DE9r 2  E8             inx
000DEAr 2  E8             inx
000DEBr 2  E0 C0          cpx #DIRTY_BYTES
000DEDr 2  90 02          bcc @Store
000DEFr 2  A2 00          ldx #0
000DF1r 2               @Store:
000DF1r 2  8E rr rr       stx DirtyTail
000DF4r 2  60             rts
000DF5r 2               
000DF5r 2               @Full:
000DF5r 2  68             pla                           ; Unwind and drop it. The cell is wrong until
000DF6r 2  68             pla                           ;   something marks it again.
000DF7r 2  68             pla
000DF8r 2  60             rts
000DF9r 2               
000DF9r 2               ; -----------------------------------------------------------------------------
000DF9r 2               ;   RenderFlush — push up to DIRTY_FLUSH_MAX queued cells to the screen
000DF9r 2               ;   Called once per frame, from the top of the main loop.
000DF9r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y, Ptr1, Ptr2
000DF9r 2               ; -----------------------------------------------------------------------------
000DF9r 2               RenderFlush:
000DF9r 2  20 rr rr       jsr RenderBoardStep           ; Top the ring up from a board redraw, if one
000DFCr 2                                               ;   is outstanding, so it always makes progress
000DFCr 2  AD rr rr       lda DirtyCount
000DFFr 2  F0 31          beq @Done
000E01r 2  C9 18          cmp #DIRTY_FLUSH_MAX
000E03r 2  90 02          bcc @Budget
000E05r 2  A9 18          lda #DIRTY_FLUSH_MAX
000E07r 2               @Budget:
000E07r 2  85 rr          sta FlushLeft
000E09r 2               
000E09r 2               @Cell:
000E09r 2  AE rr rr       ldx DirtyHead
000E0Cr 2  BD rr rr       lda Dirty+1,x
000E0Fr 2  A8             tay                           ; Y = screen row
000E10r 2  BD rr rr       lda Dirty+2,x
000E13r 2  48             pha                           ; Tile
000E14r 2  BD rr rr       lda Dirty+0,x
000E17r 2  AA             tax                           ; X = screen column
000E18r 2  68             pla                           ; A = tile
000E19r 2  20 rr rr       jsr HalPlotCell
000E1Cr 2               
000E1Cr 2  AD rr rr       lda DirtyHead                 ; Step one entry, wrapping the ring
000E1Fr 2  18             clc
000E20r 2  69 03          adc #3
000E22r 2  C9 C0          cmp #DIRTY_BYTES
000E24r 2  90 02          bcc @Store
000E26r 2  A9 00          lda #0
000E28r 2               @Store:
000E28r 2  8D rr rr       sta DirtyHead
000E2Br 2  CE rr rr       dec DirtyCount
000E2Er 2  C6 rr          dec FlushLeft
000E30r 2  D0 D7          bne @Cell
000E32r 2               @Done:
000E32r 2  60             rts
000E33r 2               
000E33r 2               ; -----------------------------------------------------------------------------
000E33r 2               ;   RenderBoard — ask for the whole 6 x 16 well to be redrawn
000E33r 2               ;   Used on state entry and after a pause, not per frame.
000E33r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000E33r 2               ;
000E33r 2               ;   The well is 96 cells and the ring holds DIRTY_ENTRIES; a redraw therefore
000E33r 2               ;   cannot be queued in one go. This only sets the cursor. RenderBoardStep,
000E33r 2               ;   which RenderFlush calls every frame, feeds the ring as fast as it drains,
000E33r 2               ;   so the redraw spreads over as many frames as it needs and never drops a
000E33r 2               ;   cell.
000E33r 2               ; -----------------------------------------------------------------------------
000E33r 2               RenderBoard:
000E33r 2  A9 00          lda #0
000E35r 2  8D rr rr       sta RedrawIdx                 ; Board index 0 = row 0, column 0
000E38r 2  60             rts                           ; And nothing else. Falling through into the
000E39r 2                                               ;   step below would fill the ring here and
000E39r 2                                               ;   drop whatever the caller marks next.
000E39r 2               
000E39r 2               ; -----------------------------------------------------------------------------
000E39r 2               ;   RenderBoardStep — queue as much of an outstanding board redraw as fits
000E39r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000E39r 2               ;   Does nothing when RedrawIdx is $FF.
000E39r 2               ; -----------------------------------------------------------------------------
000E39r 2               RenderBoardStep:
000E39r 2  AD rr rr       lda RedrawIdx
000E3Cr 2  30 41          bmi @Done                     ; $FF — nothing outstanding
000E3Er 2               
000E3Er 2               @Cell:
000E3Er 2  AD rr rr       lda DirtyCount
000E41r 2  C9 40          cmp #DIRTY_ENTRIES
000E43r 2  B0 3A          bcs @Done                     ; Ring full — pick this cell up next frame
000E45r 2               
000E45r 2  AE rr rr       ldx RedrawIdx
000E48r 2  8A             txa
000E49r 2  29 07          and #(BOARD_STRIDE - 1)
000E4Br 2  18             clc
000E4Cr 2  69 01          adc #WELL_ORIGIN_X
000E4Er 2  85 rr          sta RedrawCol
000E50r 2  8A             txa
000E51r 2  4A             lsr a                         ; Board index >> 3 is the row (stride 8)
000E52r 2  4A             lsr a
000E53r 2  4A             lsr a
000E54r 2  18             clc
000E55r 2  69 04          adc #WELL_ORIGIN_Y
000E57r 2  A8             tay                           ; Y = panel row
000E58r 2  BD rr rr       lda Board,x                   ; The board byte IS the tile — empty is $00,
000E5Br 2  A6 rr          ldx RedrawCol                 ;   which is TILE_BLANK (SPEC 3.3, 4.2)
000E5Dr 2  20 rr rr       jsr RenderMark
000E60r 2               
000E60r 2  AE rr rr       ldx RedrawIdx                 ; Advance, stepping over the two sentinel
000E63r 2  E8             inx                           ;   columns at the end of each row
000E64r 2  8A             txa
000E65r 2  29 07          and #(BOARD_STRIDE - 1)
000E67r 2  C9 06          cmp #BOARD_W
000E69r 2  90 05          bcc @Save
000E6Br 2  8A             txa
000E6Cr 2  18             clc
000E6Dr 2  69 02          adc #(BOARD_STRIDE - BOARD_W)
000E6Fr 2  AA             tax
000E70r 2               @Save:
000E70r 2  E0 80          cpx #(BOARD_H * BOARD_STRIDE)
000E72r 2  B0 06          bcs @Finish
000E74r 2  8E rr rr       stx RedrawIdx
000E77r 2  4C rr rr       jmp @Cell
000E7Ar 2               
000E7Ar 2               @Finish:
000E7Ar 2  A9 FF          lda #$FF
000E7Cr 2  8D rr rr       sta RedrawIdx
000E7Fr 2               @Done:
000E7Fr 2  60             rts
000E80r 2               
000E80r 2               ; -----------------------------------------------------------------------------
000E80r 2               ;   RenderCell — queue one board cell by board index
000E80r 2               ;   In:  X = board index (row * BOARD_STRIDE + column)
000E80r 2               ;   Out: nothing.  Modifies: A, X, Y
000E80r 2               ;   The single-cell form of RenderBoardStep, for the phases that move one tile
000E80r 2               ;   at a time.
000E80r 2               ; -----------------------------------------------------------------------------
000E80r 2               RenderCell:
000E80r 2  BD rr rr       lda Board,x                   ; The board byte IS the tile (SPEC 3.3)
000E83r 2                 ; falls through
000E83r 2               
000E83r 2               ; -----------------------------------------------------------------------------
000E83r 2               ;   RenderCellAs — queue one board cell showing something else entirely
000E83r 2               ;   In:  X = board index, A = tile
000E83r 2               ;   Out: nothing.  Modifies: A, X, Y
000E83r 2               ;
000E83r 2               ;   The animation frames are the only tiles in the game that are NOT what the
000E83r 2               ;   board holds: a glow glyph, a beam, a ring frame and a blip frame are all
000E83r 2               ;   drawn over a cell whose board byte still says what it really is, right up
000E83r 2               ;   until CascadeRemove zeroes it (anim.asm, SPEC 8 step 5). Everything else
000E83r 2               ;   goes through RenderCell above and never has to think about it.
000E83r 2               ; -----------------------------------------------------------------------------
000E83r 2               RenderCellAs:
000E83r 2  48             pha
000E84r 2  8A             txa
000E85r 2  29 07          and #(BOARD_STRIDE - 1)
000E87r 2  18             clc
000E88r 2  69 01          adc #WELL_ORIGIN_X
000E8Ar 2  85 rr          sta RedrawCol
000E8Cr 2  8A             txa
000E8Dr 2  4A             lsr a
000E8Er 2  4A             lsr a
000E8Fr 2  4A             lsr a
000E90r 2  18             clc
000E91r 2  69 04          adc #WELL_ORIGIN_Y
000E93r 2  A8             tay
000E94r 2  68             pla
000E95r 2  A6 rr          ldx RedrawCol
000E97r 2  4C rr rr       jmp RenderMark
000E9Ar 2               
000E9Ar 2               ; -----------------------------------------------------------------------------
000E9Ar 2               ;   RenderPiece — queue the three falling cells at where the piece is now
000E9Ar 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000E9Ar 2               ;
000E9Ar 2               ;   RenderMark clobbers X and keeps Y, so the panel column is parked in
000E9Ar 2               ;   RedrawCol and the panel row rides Y down the three cells. Cell C can never
000E9Ar 2               ;   be lower than board row 15, so all three are always inside the well and
000E9Ar 2               ;   there is nothing to clip.
000E9Ar 2               ; -----------------------------------------------------------------------------
000E9Ar 2               RenderPiece:
000E9Ar 2  AD rr rr       lda PieceCol
000E9Dr 2  18             clc
000E9Er 2  69 01          adc #WELL_ORIGIN_X
000EA0r 2  85 rr          sta RedrawCol
000EA2r 2  AD rr rr       lda PieceRow
000EA5r 2  18             clc
000EA6r 2  69 04          adc #WELL_ORIGIN_Y
000EA8r 2  A8             tay
000EA9r 2  AD rr rr       lda PieceA
000EACr 2  A6 rr          ldx RedrawCol
000EAEr 2  20 rr rr       jsr RenderMark
000EB1r 2  C8             iny
000EB2r 2  AD rr rr       lda PieceB
000EB5r 2  A6 rr          ldx RedrawCol
000EB7r 2  20 rr rr       jsr RenderMark
000EBAr 2  C8             iny
000EBBr 2  AD rr rr       lda PieceC
000EBEr 2  A6 rr          ldx RedrawCol
000EC0r 2  4C rr rr       jmp RenderMark
000EC3r 2               
000EC3r 2               ; -----------------------------------------------------------------------------
000EC3r 2               ;   RenderPieceErase — blank the three cells the piece is leaving
000EC3r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000EC3r 2               ;
000EC3r 2               ;   Three blanks rather than three board reads, because the cells under a
000EC3r 2               ;   falling piece are always empty: every move and every gravity step tests
000EC3r 2               ;   the target cells before it happens, and the one thing that writes them is
000EC3r 2               ;   PieceLock, after which nothing erases the piece again (piece.asm).
000EC3r 2               ; -----------------------------------------------------------------------------
000EC3r 2               RenderPieceErase:
000EC3r 2  AD rr rr       lda PieceCol
000EC6r 2  18             clc
000EC7r 2  69 01          adc #WELL_ORIGIN_X
000EC9r 2  85 rr          sta RedrawCol
000ECBr 2  AD rr rr       lda PieceRow
000ECEr 2  18             clc
000ECFr 2  69 04          adc #WELL_ORIGIN_Y
000ED1r 2  A8             tay
000ED2r 2  A9 00          lda #TILE_EMPTY
000ED4r 2  A6 rr          ldx RedrawCol
000ED6r 2  20 rr rr       jsr RenderMark
000ED9r 2  C8             iny
000EDAr 2  A9 00          lda #TILE_EMPTY
000EDCr 2  A6 rr          ldx RedrawCol
000EDEr 2  20 rr rr       jsr RenderMark
000EE1r 2  C8             iny
000EE2r 2  A9 00          lda #TILE_EMPTY
000EE4r 2  A6 rr          ldx RedrawCol
000EE6r 2  4C rr rr       jmp RenderMark
000EE9r 2               
000EE9r 2               ; -----------------------------------------------------------------------------
000EE9r 2               ;   RenderNext — the preview, panel column NEXT_X, rows NEXT_Y..NEXT_Y+2
000EE9r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y
000EE9r 2               ;
000EE9r 2               ;   All three cells every time. The play screen image ships with a piece
000EE9r 2               ;   already drawn in the NEXT box (SPEC 12.1), so this has to overwrite rather
000EE9r 2               ;   than assume it is drawing onto backdrop.
000EE9r 2               ; -----------------------------------------------------------------------------
000EE9r 2               RenderNext:
000EE9r 2  A0 10          ldy #NEXT_Y
000EEBr 2  AD rr rr       lda NextA
000EEEr 2  A2 0B          ldx #NEXT_X
000EF0r 2  20 rr rr       jsr RenderMark
000EF3r 2  C8             iny
000EF4r 2  AD rr rr       lda NextB
000EF7r 2  A2 0B          ldx #NEXT_X
000EF9r 2  20 rr rr       jsr RenderMark
000EFCr 2  C8             iny
000EFDr 2  AD rr rr       lda NextC
000F00r 2  A2 0B          ldx #NEXT_X
000F02r 2  4C rr rr       jmp RenderMark
000F05r 2               
000F05r 2               ; -----------------------------------------------------------------------------
000F05r 2               ;   RenderScore / RenderHigh / RenderLevel — only called when a value changes
000F05r 2               ;   Nothing here compares anything: the caller knows when it changed a value
000F05r 2               ;   and these are not cheap enough to run every frame. SCORE_DIGITS cells is
000F05r 2               ;   most of a frame's flush budget on its own.
000F05r 2               ; -----------------------------------------------------------------------------
000F05r 2               RenderScore:
000F05r 2  A9 rr          lda #<ScoreLo
000F07r 2  85 rr          sta Ptr1
000F09r 2  A9 rr          lda #>ScoreLo
000F0Br 2  85 rr          sta Ptr1+1
000F0Dr 2  A2 0C          ldx #SCORE_X
000F0Fr 2  A0 05          ldy #SCORE_Y
000F11r 2  A9 07          lda #SCORE_DIGITS
000F13r 2  4C rr rr       jmp TextBcd
000F16r 2               
000F16r 2               RenderHigh:
000F16r 2  A9 rr          lda #<HighLo
000F18r 2  85 rr          sta Ptr1
000F1Ar 2  A9 rr          lda #>HighLo
000F1Cr 2  85 rr          sta Ptr1+1
000F1Er 2  A2 0C          ldx #HIGH_X
000F20r 2  A0 0A          ldy #HIGH_Y
000F22r 2  A9 07          lda #SCORE_DIGITS
000F24r 2  20 rr rr       jsr TextBcd
000F27r 2               
000F27r 2  A9 rr          lda #<HighLevel               ; The level it was set on, under the digits
000F29r 2  85 rr          sta Ptr1
000F2Br 2  A9 rr          lda #>HighLevel
000F2Dr 2  85 rr          sta Ptr1+1
000F2Fr 2  A2 0F          ldx #HIGHLVL_X
000F31r 2  A0 0B          ldy #HIGHLVL_Y
000F33r 2  A9 02          lda #LEVEL_DIGITS
000F35r 2  4C rr rr       jmp TextBcd
000F38r 2               
000F38r 2               ; -----------------------------------------------------------------------------
000F38r 2               ;   RenderHighBlank — the dark half of the HIGH field's overtake flash
000F38r 2               ;   In:  nothing        Out: nothing.  Modifies: A, X, Y, TextCol
000F38r 2               ;   SPEC 9.8. The seven digits only; the level under them stays put, so the
000F38r 2               ;   box never looks empty and the flash costs seven cells of the budget.
000F38r 2               ; -----------------------------------------------------------------------------
000F38r 2               RenderHighBlank:
000F38r 2  A9 0C          lda #HIGH_X
000F3Ar 2  85 rr          sta TextCol                   ; Not X: RenderMark clobbers it
000F3Cr 2               @Cell:
000F3Cr 2  A9 00          lda #TILE_BLANK
000F3Er 2  A6 rr          ldx TextCol
000F40r 2  A0 0A          ldy #HIGH_Y
000F42r 2  20 rr rr       jsr RenderMark
000F45r 2  E6 rr          inc TextCol
000F47r 2  A5 rr          lda TextCol
000F49r 2  C9 13          cmp #(HIGH_X + SCORE_DIGITS)
000F4Br 2  90 EF          bcc @Cell
000F4Dr 2  60             rts
000F4Er 2               
000F4Er 2               RenderLevel:
000F4Er 2  AD rr rr       lda Level
000F51r 2  4C rr rr       jmp TextLevel
000F54r 2               
000F54r 1               .include "../src/text.asm"
000F54r 2               ; =============================================================================
000F54r 2               ;   text.asm — Wizards Lab, text and numbers on the panel
000F54r 2               ; =============================================================================
000F54r 2               ;   The font lives in tile groups 2-6, forty glyphs in the order
000F54r 2               ;
000F54r 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
000F54r 2               ;
000F54r 2               ;   starting at FONT_BASE, so a digit is FONT_DIGIT_0 + value and a letter is
000F54r 2               ;   FONT_LETTER_A + (letter - 'A'). Strings are stored pre-converted to tile
000F54r 2               ;   numbers, terminated by TEXT_END, so drawing one is a copy with no
000F54r 2               ;   translation. src/strings.inc holds them and the macro that encodes them.
000F54r 2               ;
000F54r 2               ;   Everything here draws through RenderMark, never to the screen: text is
000F54r 2               ;   panel cells like any other and goes through the same one flush a frame.
000F54r 2               ;   That is also why the cursor state lives in the zero-page block RenderMark
000F54r 2               ;   promises not to touch (zeropage.inc) rather than in Tmp0-Tmp3.
000F54r 2               ; =============================================================================
000F54r 2               
000F54r 2               ; -----------------------------------------------------------------------------
000F54r 2               ;   TextDraw — draw a tile-encoded string
000F54r 2               ;   In:  Ptr1 -> string (TEXT_END terminated), X = panel column, Y = panel row
000F54r 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx
000F54r 2               ; -----------------------------------------------------------------------------
000F54r 2               TextDraw:
000F54r 2  86 rr          stx TextCol
000F56r 2  84 rr          sty TextRow
000F58r 2  A9 00          lda #0
000F5Ar 2  85 rr          sta TextIdx
000F5Cr 2               @Char:
000F5Cr 2  A4 rr          ldy TextIdx
000F5Er 2  B1 rr          lda (Ptr1),y
000F60r 2  C9 FF          cmp #TEXT_END
000F62r 2  F0 0D          beq @Done
000F64r 2  A6 rr          ldx TextCol
000F66r 2  A4 rr          ldy TextRow
000F68r 2  20 rr rr       jsr RenderMark
000F6Br 2  E6 rr          inc TextCol
000F6Dr 2  E6 rr          inc TextIdx
000F6Fr 2  D0 EB          bne @Char                     ; Always — a string is never 256 tiles long
000F71r 2               @Done:
000F71r 2  60             rts
000F72r 2               
000F72r 2               ; -----------------------------------------------------------------------------
000F72r 2               ;   TextBcd — draw a packed-BCD number, zero padded
000F72r 2               ;   In:  Ptr1 -> BCD bytes (low first), A = digit count,
000F72r 2               ;        X = panel column, Y = panel row
000F72r 2               ;   Out: nothing.  Modifies: A, X, Y, TextCol, TextRow, TextIdx, TextByte,
000F72r 2               ;        TextSkip
000F72r 2               ;
000F72r 2               ;   SCORE_DIGITS (7) for the score and the high score, 2 for the high score's
000F72r 2               ;   level. The LEVEL box is not drawn with this — see TextLevel.
000F72r 2               ;
000F72r 2               ;   The count is in DIGITS, not bytes, because the score is seven digits in
000F72r 2               ;   four bytes: the top nibble of the most significant byte is held at zero
000F72r 2               ;   (SPEC 9) and must not be drawn, or the field would be eight cells wide and
000F72r 2               ;   no longer centred. An odd count starts at the LOW nibble of the top byte.
000F72r 2               ;
000F72r 2               ;   **Every digit is drawn, every time.** A leading zero is a zero glyph, not
000F72r 2               ;   a blank: 1250 draws as 0001250. There is no suppression pass and no
000F72r 2               ;   right-alignment — the field is fixed width so a digit never changes
000F72r 2               ;   column while the player is watching it (SPEC 9). This also makes the
000F72r 2               ;   routine branchless, and lets RenderScore mark a fixed run of cells dirty.
000F72r 2               ; -----------------------------------------------------------------------------
000F72r 2               TextBcd:
000F72r 2  86 rr          stx TextCol
000F74r 2  84 rr          sty TextRow
000F76r 2  48             pha                           ; Digit count
000F77r 2  29 01          and #$01
000F79r 2  85 rr          sta TextSkip                  ; Odd count: the top high nibble is not drawn
000F7Br 2  68             pla
000F7Cr 2  18             clc
000F7Dr 2  69 01          adc #1                        ; Bytes = (digits + 1) / 2
000F7Fr 2  4A             lsr a
000F80r 2  AA             tax
000F81r 2  CA             dex
000F82r 2  86 rr          stx TextIdx                   ; Start at the most significant byte
000F84r 2               
000F84r 2               @Byte:
000F84r 2  A4 rr          ldy TextIdx
000F86r 2  B1 rr          lda (Ptr1),y
000F88r 2  85 rr          sta TextByte
000F8Ar 2               
000F8Ar 2  A5 rr          lda TextSkip
000F8Cr 2  D0 09          bne @Low
000F8Er 2  A5 rr          lda TextByte
000F90r 2  4A             lsr a
000F91r 2  4A             lsr a
000F92r 2  4A             lsr a
000F93r 2  4A             lsr a
000F94r 2  20 rr rr       jsr TextDigit
000F97r 2               @Low:
000F97r 2  A9 00          lda #0
000F99r 2  85 rr          sta TextSkip
000F9Br 2  A5 rr          lda TextByte
000F9Dr 2  29 0F          and #$0F
000F9Fr 2  20 rr rr       jsr TextDigit
000FA2r 2               
000FA2r 2  C6 rr          dec TextIdx
000FA4r 2  10 DE          bpl @Byte
000FA6r 2  60             rts
000FA7r 2               
000FA7r 2               ; -----------------------------------------------------------------------------
000FA7r 2               ;   TextDigit — draw one digit at the cursor and step it right
000FA7r 2               ;   In:  A = value 0-9      Modifies: A, X, Y, TextCol
000FA7r 2               ; -----------------------------------------------------------------------------
000FA7r 2               TextDigit:
000FA7r 2  18             clc
000FA8r 2  69 10          adc #FONT_DIGIT_0
000FAAr 2  A6 rr          ldx TextCol
000FACr 2  A4 rr          ldy TextRow
000FAEr 2  20 rr rr       jsr RenderMark
000FB1r 2  E6 rr          inc TextCol
000FB3r 2  60             rts
000FB4r 2               
000FB4r 2               ; -----------------------------------------------------------------------------
000FB4r 2               ;   TextBanner — centre a string in the one-row message band
000FB4r 2               ;   In:  Ptr1 -> string
000FB4r 2               ;   Out: nothing.  Modifies: A, X, Y and the text cursor
000FB4r 2               ;
000FB4r 2               ;   SPEC 12.2 — the band is panel row MSG_Y, full width, one row only. The
000FB4r 2               ;   string arrives already wrapped as `~~ TEXT ~~` — two FONT_TILDE, a blank,
000FB4r 2               ;   the text, a blank, two FONT_TILDE. Centring is (PANEL_W - length) / 2,
000FB4r 2               ;   which is why banner strings are drawn even-length.
000FB4r 2               ; -----------------------------------------------------------------------------
000FB4r 2               TextBanner:
000FB4r 2  A0 00          ldy #0
000FB6r 2               @Len:
000FB6r 2  B1 rr          lda (Ptr1),y
000FB8r 2  C9 FF          cmp #TEXT_END
000FBAr 2  F0 03          beq @Got
000FBCr 2  C8             iny
000FBDr 2  D0 F7          bne @Len
000FBFr 2               @Got:
000FBFr 2  98             tya
000FC0r 2  85 rr          sta TextIdx
000FC2r 2  A9 16          lda #PANEL_W
000FC4r 2  38             sec
000FC5r 2  E5 rr          sbc TextIdx
000FC7r 2  4A             lsr a                         ; (PANEL_W - length) / 2
000FC8r 2  AA             tax
000FC9r 2  A0 16          ldy #MSG_Y
000FCBr 2  4C rr rr       jmp TextDraw
000FCEr 2               
000FCEr 2               ; -----------------------------------------------------------------------------
000FCEr 2               ;   TextBannerClear — blank the message band back to backdrop
000FCEr 2               ;   Out: nothing.  Modifies: A, X, Y
000FCEr 2               ;
000FCEr 2               ;   Columns MSG_X .. MSG_X + MSG_W - 1 only. The shelf tiles at either end of
000FCEr 2               ;   the band belong to the static screen image and are never redrawn.
000FCEr 2               ; -----------------------------------------------------------------------------
000FCEr 2               TextBannerClear:
000FCEr 2  A9 02          lda #MSG_X
000FD0r 2  85 rr          sta TextCol                   ; Not X: RenderMark clobbers it
000FD2r 2               @Cell:
000FD2r 2  A9 00          lda #TILE_BLANK
000FD4r 2  A6 rr          ldx TextCol
000FD6r 2  A0 16          ldy #MSG_Y
000FD8r 2  20 rr rr       jsr RenderMark
000FDBr 2  E6 rr          inc TextCol
000FDDr 2  A5 rr          lda TextCol
000FDFr 2  C9 14          cmp #(MSG_X + MSG_W)
000FE1r 2  90 EF          bcc @Cell
000FE3r 2  60             rts
000FE4r 2               
000FE4r 2               ; -----------------------------------------------------------------------------
000FE4r 2               ;   TextLevel — the LEVEL box, tens above units in one column
000FE4r 2               ;   In:  A = level (binary, 1-99)
000FE4r 2               ;   Out: nothing.  Modifies: A, X, Y, TextByte
000FE4r 2               ;   SPEC 12.2 — LEVEL_X, tens at LEVEL_Y and units at LEVEL_Y + 1. Always two
000FE4r 2               ;   digits: level 5 draws "0" over "5".
000FE4r 2               ; -----------------------------------------------------------------------------
000FE4r 2               TextLevel:
000FE4r 2  A2 00          ldx #0
000FE6r 2               @Tens:
000FE6r 2  C9 0A          cmp #10
000FE8r 2  90 05          bcc @Split
000FEAr 2  E9 0A          sbc #10                       ; Carry is set by the CMP that got us here
000FECr 2  E8             inx
000FEDr 2  D0 F7          bne @Tens                     ; Always — X tops out at 9
000FEFr 2               @Split:
000FEFr 2  85 rr          sta TextByte                  ; Units
000FF1r 2  8A             txa
000FF2r 2  18             clc
000FF3r 2  69 10          adc #FONT_DIGIT_0
000FF5r 2  A2 12          ldx #LEVEL_X
000FF7r 2  A0 11          ldy #LEVEL_Y
000FF9r 2  20 rr rr       jsr RenderMark
000FFCr 2  A5 rr          lda TextByte
000FFEr 2  18             clc
000FFFr 2  69 10          adc #FONT_DIGIT_0
001001r 2  A2 12          ldx #LEVEL_X
001003r 2  A0 12          ldy #LEVEL_Y + 1
001005r 2  4C rr rr       jmp RenderMark
001008r 2               
001008r 1               .include "../src/audio.asm"
001008r 2               ; =============================================================================
001008r 2               ;   audio.asm — Wizards Lab, sound
001008r 2               ; =============================================================================
001008r 2               ;   SPEC.md section 16. Out of scope for the first playable build, but the
001008r 2               ;   hook is here from the start so game logic never has to be revisited to add
001008r 2               ;   it: logic writes an effect id to SfxRequest and forgets about it.
001008r 2               ;
001008r 2               ;   The AC6502 and the C64 both have a SID and can share a driver — only the
001008r 2               ;   register base differs ($9800 against $D400). The VIC-20 needs its own,
001008r 2               ;   against $900A-$900E.
001008r 2               ; =============================================================================
001008r 2               
001008r 2               SFX_MOVE        = 1
001008r 2               SFX_ROTATE      = 2
001008r 2               SFX_LOCK        = 3
001008r 2               SFX_MATCH       = 4
001008r 2               SFX_FIREBALL    = 5
001008r 2               SFX_BOLT        = 6
001008r 2               SFX_BOMB        = 7
001008r 2               SFX_STAR        = 8
001008r 2               SFX_PRISM       = 9
001008r 2               SFX_LEVELUP     = 10
001008r 2               SFX_HIGHSCORE   = 11
001008r 2               SFX_GAMEOVER    = 12
001008r 2               
001008r 2               ; -----------------------------------------------------------------------------
001008r 2               ;   AudioInit — silence everything
001008r 2               ; -----------------------------------------------------------------------------
001008r 2               AudioInit:
001008r 2  A9 00          lda #0
00100Ar 2  8D rr rr       sta SfxRequest
00100Dr 2  8D rr rr       sta SfxTimer
001010r 2  60             rts
001011r 2               
001011r 2               ; -----------------------------------------------------------------------------
001011r 2               ;   AudioTick — called once per frame, consumes SfxRequest
001011r 2               ; -----------------------------------------------------------------------------
001011r 2               AudioTick:
001011r 2                 ; TODO: start a new effect when SfxRequest is non-zero, then advance the
001011r 2                 ; envelope of whatever is playing. Calls HalSfx for the register writes.
001011r 2  A9 00          lda #0
001013r 2  8D rr rr       sta SfxRequest
001016r 2  60             rts
001017r 2               
001017r 1               
001017r 1               ; =============================================================================
001017r 1               ;   HAL — VIC-II, standard text mode
001017r 1               ; =============================================================================
001017r 1               
001017r 1               ; -----------------------------------------------------------------------------
001017r 1               ;   HalInitVideo — 40 x 25 cells, custom charset at $2000, everything black
001017r 1               ; -----------------------------------------------------------------------------
001017r 1               HalInitVideo:
001017r 1  AD 00 DD       lda $DD00                     ; VIC bank 0: $0000-$3FFF
00101Ar 1  09 03          ora #$03
00101Cr 1  8D 00 DD       sta $DD00
00101Fr 1               
00101Fr 1  A9 1B          lda #$1B                      ; Text mode, display on, 25 rows
001021r 1  8D 11 D0       sta VIC_CTRL1
001024r 1  A9 C8          lda #$C8                      ; 40 columns, no multicolor
001026r 1  8D 16 D0       sta VIC_CTRL2
001029r 1  A9 18          lda #$18                      ; Screen $0400, character set $2000
00102Br 1  8D 18 D0       sta VIC_MEMPTR
00102Er 1  A9 00          lda #$00
001030r 1  8D 20 D0       sta VIC_BORDERCOL
001033r 1  8D 21 D0       sta VIC_BGCOL0
001036r 1  8D 15 D0       sta VIC_SPRENA                ; No sprites. Not an oversight — see the header.
001039r 1               
001039r 1  20 rr rr       jsr LoadTileset
00103Cr 1                 ; falls through
00103Cr 1               
00103Cr 1               ; -----------------------------------------------------------------------------
00103Cr 1               ;   HalClearScreen — blank tiles, white colour RAM
00103Cr 1               ; -----------------------------------------------------------------------------
00103Cr 1               HalClearScreen:
00103Cr 1  A2 00          ldx #0
00103Er 1               @Cell:
00103Er 1  A9 00          lda #TILE_BLANK
001040r 1  9D 00 04       sta SCREEN + $0000,x
001043r 1  9D 00 05       sta SCREEN + $0100,x
001046r 1  9D 00 06       sta SCREEN + $0200,x
001049r 1  9D 00 07       sta SCREEN + $0300,x
00104Cr 1  A9 01          lda #1                        ; White
00104Er 1  9D 00 D8       sta COLRAM + $0000,x
001051r 1  9D 00 D9       sta COLRAM + $0100,x
001054r 1  9D 00 DA       sta COLRAM + $0200,x
001057r 1  9D 00 DB       sta COLRAM + $0300,x
00105Ar 1  E8             inx
00105Br 1  D0 E1          bne @Cell
00105Dr 1  60             rts
00105Er 1               
00105Er 1               ; -----------------------------------------------------------------------------
00105Er 1               ;   LoadTileset — copy 2 K of patterns from cartridge ROM to $2000
00105Er 1               ;   PLACEHOLDER ART: Tileset is data/tileset.bin. The same 2048-byte file
00105Er 1               ;   drives all three machines — the pattern format is identical. See
00105Er 1               ;   data/README.md.
00105Er 1               ; -----------------------------------------------------------------------------
00105Er 1               LoadTileset:
00105Er 1  A9 rr          lda #<Tileset
001060r 1  85 rr          sta SrcPtr
001062r 1  A9 rr          lda #>Tileset
001064r 1  85 rr          sta SrcPtr+1
001066r 1  A9 00          lda #<CHARSET_RAM
001068r 1  85 rr          sta DstPtr
00106Ar 1  A9 20          lda #>CHARSET_RAM
00106Cr 1  85 rr          sta DstPtr+1
00106Er 1               
00106Er 1  A2 08          ldx #8                        ; 8 x 256 = 2048 bytes
001070r 1  A0 00          ldy #0
001072r 1               @Byte:
001072r 1  B1 rr          lda (SrcPtr),y
001074r 1  91 rr          sta (DstPtr),y
001076r 1  C8             iny
001077r 1  D0 F9          bne @Byte
001079r 1  E6 rr          inc SrcPtr+1
00107Br 1  E6 rr          inc DstPtr+1
00107Dr 1  CA             dex
00107Er 1  D0 F2          bne @Byte
001080r 1  60             rts
001081r 1               
001081r 1               ; -----------------------------------------------------------------------------
001081r 1               ;   HalWaitFrame — sync on raster line 251, below the visible area
001081r 1               ; -----------------------------------------------------------------------------
001081r 1               HalWaitFrame:
001081r 1               @NotYet:
001081r 1  AD 12 D0       lda VIC_RASTER
001084r 1  C9 FB          cmp #251
001086r 1  F0 F9          beq @NotYet                   ; Leave the line first, so a fast frame
001088r 1               @Wait:                          ;   cannot fall straight through
001088r 1  AD 12 D0       lda VIC_RASTER
00108Br 1  C9 FB          cmp #251
00108Dr 1  D0 F9          bne @Wait
00108Fr 1  60             rts
001090r 1               
001090r 1               ; -----------------------------------------------------------------------------
001090r 1               ;   HalPlotCell — In: A = tile, X = screen column, Y = screen row
001090r 1               ; -----------------------------------------------------------------------------
001090r 1               HalPlotCell:
001090r 1  48             pha                           ; Hold the tile; RowPtrs needs A
001091r 1  20 rr rr       jsr RowPtrs
001094r 1  8A             txa
001095r 1  A8             tay                           ; Y = column
001096r 1  68             pla                           ; A = tile
001097r 1  91 rr          sta (ScreenPtr),y
001099r 1  AA             tax                           ; The tile is its own colour lookup index...
00109Ar 1  29 F8          and #COLOR_MASK               ; ...unless its colour is the one a fireball is
00109Cr 1  CD rr rr       cmp TintColor                 ;   flashing white (SPEC 4.6). TintColor is
00109Fr 1  F0 06          beq @White                    ;   TINT_NONE when nothing is, and no masked
0010A1r 1  BD rr rr       lda TileColorC64,x                ;   tile can equal that, so the test needs no
0010A4r 1  4C rr rr       jmp @Put                      ;   separate "is anything lit at all" branch —
0010A7r 1               @White:                         ;   one CMP a cell, and only while it is lit
0010A7r 1  A9 01          lda #COLOR_WHITE              ;   does a cell come out any different
0010A9r 1               @Put:
0010A9r 1  91 rr          sta (ColorPtr),y
0010ABr 1  60             rts
0010ACr 1               
0010ACr 1               ; -----------------------------------------------------------------------------
0010ACr 1               ;   RowPtrs — In: Y = screen row.  Out: ScreenPtr, ColorPtr at that row
0010ACr 1               ; -----------------------------------------------------------------------------
0010ACr 1               RowPtrs:
0010ACr 1  B9 rr rr       lda RowLo,y
0010AFr 1  85 rr          sta ScreenPtr
0010B1r 1  85 rr          sta ColorPtr
0010B3r 1  B9 rr rr       lda RowHi,y
0010B6r 1  85 rr          sta ScreenPtr+1
0010B8r 1  18             clc
0010B9r 1  69 D4          adc #(>COLRAM - >SCREEN)      ; Colour RAM mirrors the matrix, page-offset
0010BBr 1  85 rr          sta ColorPtr+1
0010BDr 1  60             rts
0010BEr 1               
0010BEr 1               ; -----------------------------------------------------------------------------
0010BEr 1               ;   HalBlitScreen — draw a full 1000-byte screen plus its colour image
0010BEr 1               ;   In: SrcPtr -> name table, Ptr1 -> colour table
0010BEr 1               ; -----------------------------------------------------------------------------
0010BEr 1               HalBlitScreen:
0010BEr 1  A0 00          ldy #0
0010C0r 1               @Page0:
0010C0r 1  B1 rr          lda (SrcPtr),y
0010C2r 1  99 00 04       sta SCREEN + $0000,y
0010C5r 1  B1 rr          lda (Ptr1),y
0010C7r 1  99 00 D8       sta COLRAM + $0000,y
0010CAr 1  C8             iny
0010CBr 1  D0 F3          bne @Page0
0010CDr 1               
0010CDr 1  E6 rr          inc SrcPtr+1
0010CFr 1  E6 rr          inc Ptr1+1
0010D1r 1  A0 00          ldy #0
0010D3r 1               @Page1:
0010D3r 1  B1 rr          lda (SrcPtr),y
0010D5r 1  99 00 05       sta SCREEN + $0100,y
0010D8r 1  B1 rr          lda (Ptr1),y
0010DAr 1  99 00 D9       sta COLRAM + $0100,y
0010DDr 1  C8             iny
0010DEr 1  D0 F3          bne @Page1
0010E0r 1               
0010E0r 1  E6 rr          inc SrcPtr+1
0010E2r 1  E6 rr          inc Ptr1+1
0010E4r 1  A0 00          ldy #0
0010E6r 1               @Page2:
0010E6r 1  B1 rr          lda (SrcPtr),y
0010E8r 1  99 00 06       sta SCREEN + $0200,y
0010EBr 1  B1 rr          lda (Ptr1),y
0010EDr 1  99 00 DA       sta COLRAM + $0200,y
0010F0r 1  C8             iny
0010F1r 1  D0 F3          bne @Page2
0010F3r 1               
0010F3r 1  E6 rr          inc SrcPtr+1
0010F5r 1  E6 rr          inc Ptr1+1
0010F7r 1  A0 00          ldy #0
0010F9r 1               @Page3:
0010F9r 1  B1 rr          lda (SrcPtr),y
0010FBr 1  99 00 07       sta SCREEN + $0300,y
0010FEr 1  B1 rr          lda (Ptr1),y
001100r 1  99 00 DB       sta COLRAM + $0300,y
001103r 1  C8             iny
001104r 1  C0 E8          cpy #232                      ; 1000 - 768
001106r 1  D0 F1          bne @Page3
001108r 1  60             rts
001109r 1               
001109r 1               ; -----------------------------------------------------------------------------
001109r 1               ;   HalReadInput — joystick port 2 and the keyboard, in one active-high mask
001109r 1               ;
001109r 1               ;   Port 1 shares its lines with the keyboard columns, so only port 2 is
001109r 1               ;   supported — but port 2 shares CIA1's port A with them as well, and that is
001109r 1               ;   not avoidable: a held direction pulls a column line low and looks to the
001109r 1               ;   scan below like every key in that column being down at once. Every C64
001109r 1               ;   game with both has this; the joystick is read FIRST, with all columns
001109r 1               ;   driven high, so at least the stick is never confused by the keyboard.
001109r 1               ;
001109r 1               ;   The KERNAL's IRQ scanner is off (see ColdStart), so the matrix is ours.
001109r 1               ; -----------------------------------------------------------------------------
001109r 1               HalReadInput:
001109r 1  A9 FF          lda #$FF                      ; CIA1 DDRA: the column lines drive
00110Br 1  8D 02 DC       sta $DC02
00110Er 1  A9 00          lda #$00                      ; CIA1 DDRB: the row lines are read
001110r 1  8D 03 DC       sta $DC03
001113r 1               
001113r 1  A9 FF          lda #$FF                      ; No column selected — a pressed stick is then
001115r 1  8D 00 DC       sta $DC00                     ;   the only thing that can pull a line low
001118r 1  AD 00 DC       lda $DC00                     ; Active low: bit0 U, 1 D, 2 L, 3 R, 4 fire
00111Br 1  49 FF          eor #$FF
00111Dr 1  29 1F          and #$1F
00111Fr 1  85 rr          sta Tmp0
001121r 1               
001121r 1  A9 00          lda #0
001123r 1  85 rr          sta Tmp1
001125r 1               
001125r 1  A5 rr          lda Tmp0
001127r 1  29 01          and #%00000001                  ; U
001129r 1  F0 06          beq @NoUp
00112Br 1  A5 rr          lda Tmp1
00112Dr 1  09 01          ora #INPUT_UP
00112Fr 1  85 rr          sta Tmp1
001131r 1               @NoUp:
001131r 1  A5 rr          lda Tmp0
001133r 1  29 02          and #%00000010                  ; D
001135r 1  F0 06          beq @NoDown
001137r 1  A5 rr          lda Tmp1
001139r 1  09 02          ora #INPUT_DOWN
00113Br 1  85 rr          sta Tmp1
00113Dr 1               @NoDown:
00113Dr 1  A5 rr          lda Tmp0
00113Fr 1  29 04          and #%00000100                  ; L
001141r 1  F0 06          beq @NoLeft
001143r 1  A5 rr          lda Tmp1
001145r 1  09 04          ora #INPUT_LEFT
001147r 1  85 rr          sta Tmp1
001149r 1               @NoLeft:
001149r 1  A5 rr          lda Tmp0
00114Br 1  29 08          and #%00001000                  ; R
00114Dr 1  F0 06          beq @NoRight
00114Fr 1  A5 rr          lda Tmp1
001151r 1  09 08          ora #INPUT_RIGHT
001153r 1  85 rr          sta Tmp1
001155r 1               @NoRight:
001155r 1  A5 rr          lda Tmp0
001157r 1  29 10          and #%00010000                  ; fire
001159r 1  F0 06          beq @NoFire
00115Br 1  A5 rr          lda Tmp1
00115Dr 1  09 10          ora #INPUT_FIRE
00115Fr 1  85 rr          sta Tmp1
001161r 1               @NoFire:
001161r 1               
001161r 1  20 rr rr       jsr ScanKeys
001164r 1  05 rr          ora Tmp1
001166r 1  60             rts
001167r 1               
001167r 1               ; -----------------------------------------------------------------------------
001167r 1               ;   ScanKeys — the keyboard matrix, as the same active-high mask
001167r 1               ;   Out: A = INPUT_* bits.  Modifies: A, X, Tmp2
001167r 1               ;
001167r 1               ;   CIA1 $DC00 drives the columns (one bit LOW selects one) and $DC01 reads
001167r 1               ;   the rows, active low. The two cursor keys come after the table because
001167r 1               ;   SHIFT turns them around, and that means knowing the SHIFT state first.
001167r 1               ; -----------------------------------------------------------------------------
001167r 1               KEY_SHIFT           = %01000000 ; Scratch inside this file only — INPUT_MASK
001167r 1                                               ;   strips it before the mask leaves here
001167r 1               
001167r 1               ScanKeys:
001167r 1  A9 00          lda #0
001169r 1  85 rr          sta Tmp2
00116Br 1  A2 00          ldx #0
00116Dr 1               @Key:
00116Dr 1  BD rr rr       lda KeyTable,x
001170r 1  F0 19          beq @Cursors                  ; $00 selects every column at once — the
001172r 1  8D 00 DC       sta $DC00                     ;   terminator, because it is no column mask
001175r 1  AD 01 DC       lda $DC01
001178r 1  49 FF          eor #$FF                      ; Active low in, active high out
00117Ar 1  3D rr rr       and KeyTable+1,x
00117Dr 1  F0 07          beq @Next
00117Fr 1  A5 rr          lda Tmp2
001181r 1  1D rr rr       ora KeyTable+2,x
001184r 1  85 rr          sta Tmp2
001186r 1               @Next:
001186r 1  E8             inx
001187r 1  E8             inx
001188r 1  E8             inx
001189r 1  D0 E2          bne @Key                      ; Always — the table is far shorter than 256
00118Br 1               
00118Br 1                 ; --- the two cursor keys, which SHIFT turns around (SPEC 11.2) ------------
00118Br 1                 ;   Unshifted they are RIGHT and DOWN, shifted LEFT and UP, which is exactly
00118Br 1                 ;   the four the game wants and the reason for reading the matrix rather
00118Br 1                 ;   than letting the KERNAL turn a keystroke into one character.
00118Br 1               @Cursors:
00118Br 1  A9 FE          lda #%11111110                ; Column 0 — CRSR L/R shares it with RETURN
00118Dr 1  8D 00 DC       sta $DC00                     ;   and the function keys
001190r 1  AD 01 DC       lda $DC01
001193r 1  29 04          and #%00000100                ; Row 2
001195r 1  D0 0F          bne @NoLeftRight              ; Still high, so not pressed
001197r 1  A2 08          ldx #INPUT_RIGHT
001199r 1  A5 rr          lda Tmp2
00119Br 1  29 40          and #KEY_SHIFT
00119Dr 1  F0 02          beq @LeftRight
00119Fr 1  A2 04          ldx #INPUT_LEFT
0011A1r 1               @LeftRight:
0011A1r 1  8A             txa
0011A2r 1  05 rr          ora Tmp2
0011A4r 1  85 rr          sta Tmp2
0011A6r 1               @NoLeftRight:
0011A6r 1               
0011A6r 1  A9 FE          lda #%11111110                ; Column 0 again — CRSR U/D is its last row
0011A8r 1  8D 00 DC       sta $DC00
0011ABr 1  AD 01 DC       lda $DC01
0011AEr 1  29 80          and #%10000000                ; Row 7
0011B0r 1  D0 0F          bne @NoUpDown
0011B2r 1  A2 02          ldx #INPUT_DOWN
0011B4r 1  A5 rr          lda Tmp2
0011B6r 1  29 40          and #KEY_SHIFT
0011B8r 1  F0 02          beq @UpDown
0011BAr 1  A2 01          ldx #INPUT_UP
0011BCr 1               @UpDown:
0011BCr 1  8A             txa
0011BDr 1  05 rr          ora Tmp2
0011BFr 1  85 rr          sta Tmp2
0011C1r 1               @NoUpDown:
0011C1r 1               
0011C1r 1  A5 rr          lda Tmp2
0011C3r 1  29 3F          and #INPUT_MASK               ; Drop KEY_SHIFT — it is not an input
0011C5r 1  60             rts
0011C6r 1               
0011C6r 1               ; -----------------------------------------------------------------------------
0011C6r 1               ;   KeyTable — column mask, row mask, input bit.  Terminated by $00.
0011C6r 1               ;
0011C6r 1               ;   These are C64 matrix positions, which are NOT the VIC-20's with the axes
0011C6r 1               ;   renamed: the two machines wire genuinely different keys to the same
0011C6r 1               ;   (row, column). Only W and D sit on a symmetric position, which is why they
0011C6r 1               ;   were the two that worked when this table still held the VIC-20's numbers.
0011C6r 1               ; -----------------------------------------------------------------------------
0011C6r 1               KeyTable:
0011C6r 1  FD 02 01       .byte %11111101, %00000010, INPUT_UP      ; W        col 1, row 1
0011C9r 1  FD 04 04       .byte %11111101, %00000100, INPUT_LEFT    ; A        col 1, row 2
0011CCr 1  FD 20 02       .byte %11111101, %00100000, INPUT_DOWN    ; S        col 1, row 5
0011CFr 1  FB 04 08       .byte %11111011, %00000100, INPUT_RIGHT   ; D        col 2, row 2
0011D2r 1  7F 40 10       .byte %01111111, %01000000, INPUT_FIRE    ; Q        col 7, row 6
0011D5r 1  DF 02 20       .byte %11011111, %00000010, INPUT_PAUSE   ; P        col 5, row 1
0011D8r 1  7F 10 01       .byte %01111111, %00010000, INPUT_UP      ; SPACE    col 7, row 4
0011DBr 1  FE 02 10       .byte %11111110, %00000010, INPUT_FIRE    ; RETURN   col 0, row 1
0011DEr 1  FD 80 40       .byte %11111101, %10000000, KEY_SHIFT     ; LSHIFT   col 1, row 7
0011E1r 1  BF 10 40       .byte %10111111, %00010000, KEY_SHIFT     ; RSHIFT   col 6, row 4
0011E4r 1  00             .byte $00
0011E5r 1               
0011E5r 1               ; -----------------------------------------------------------------------------
0011E5r 1               ;   HalDetectRegion — PAL has 312 raster lines, NTSC 263
0011E5r 1               ;   Both overflow $D012, so sample it only while $D011 bit 7 (raster bit 8) is
0011E5r 1               ;   set: PAL climbs to $37 up there, NTSC only to about $06.
0011E5r 1               ; -----------------------------------------------------------------------------
0011E5r 1               HalDetectRegion:
0011E5r 1  A9 00          lda #0
0011E7r 1  85 rr          sta Tmp0                      ; Highest high-page line seen
0011E9r 1  A2 00          ldx #0
0011EBr 1  A0 00          ldy #0
0011EDr 1               @Sample:
0011EDr 1  AD 11 D0       lda VIC_CTRL1
0011F0r 1  10 09          bpl @Next                     ; Raster bit 8 clear — not the range we want
0011F2r 1  AD 12 D0       lda VIC_RASTER
0011F5r 1  C5 rr          cmp Tmp0
0011F7r 1  90 02          bcc @Next
0011F9r 1  85 rr          sta Tmp0
0011FBr 1               @Next:
0011FBr 1  C8             iny
0011FCr 1  D0 EF          bne @Sample
0011FEr 1  E8             inx
0011FFr 1  E0 40          cpx #64                       ; 16384 samples — comfortably over one frame
001201r 1  D0 EA          bne @Sample
001203r 1               
001203r 1  A5 rr          lda Tmp0
001205r 1  C9 20          cmp #$20
001207r 1  90 03          bcc @Ntsc
001209r 1  A9 01          lda #1                        ; PAL
00120Br 1  60             rts
00120Cr 1               @Ntsc:
00120Cr 1  A9 00          lda #0
00120Er 1  60             rts
00120Fr 1               
00120Fr 1               ; -----------------------------------------------------------------------------
00120Fr 1               ;   HalColorFlash — the fireball's detonation (SPEC 4.6, 14)
00120Fr 1               ;   In:  A = colour key ($40..$68), or TINT_NONE.  Modifies: A, TintColor
00120Fr 1               ;
00120Fr 1               ;   Colour here is per CELL, so there is no single byte to poke: the flash is
00120Fr 1               ;   HalPlotCell substituting white for any tile of TintColor as it draws it,
00120Fr 1               ;   and the animation re-marking every cell that has to change. Storing the
00120Fr 1               ;   colour is therefore the whole routine, and the transition HalColorFlash
00120Fr 1               ;   promises to handle costs nothing — the previous colour stops being
00120Fr 1               ;   substituted the moment this byte changes, and its cells are re-marked by
00120Fr 1               ;   the same pass that marks the new one (anim.asm, hal.inc).
00120Fr 1               ;
00120Fr 1               ;   The AC6502 does it in one VDP write instead. Same frame count, same look,
00120Fr 1               ;   completely different mechanism — which is exactly what SPEC 4.6 predicted.
00120Fr 1               ; -----------------------------------------------------------------------------
00120Fr 1               HalColorFlash:
00120Fr 1  8D rr rr       sta TintColor
001212r 1  60             rts
001213r 1               
001213r 1               ; -----------------------------------------------------------------------------
001213r 1               ;   HalSfx — TODO: SID at $D400. Shares a driver with the AC6502's $9800.
001213r 1               ; -----------------------------------------------------------------------------
001213r 1               HalSfx:
001213r 1  60             rts
001214r 1               
001214r 1               ; =============================================================================
001214r 1               ;   Data
001214r 1               ; =============================================================================
001214r 1               
001214r 1               .segment "RODATA"
000000r 1               
000000r 1               .include "../data/tilecolor-c64.inc"
000000r 2               ; =============================================================================
000000r 2               ;   tilecolor-c64.inc — C64 tile -> colour RAM table
000000r 2               ; =============================================================================
000000r 2               ;   Generated from SPEC.md section 4.3 and Appendix A. Spec-derived data, not
000000r 2               ;   artwork: edit this file by hand, it is never overwritten by an editor
000000r 2               ;   export. Tile groups 16-31 (tiles 128-255) are the margin artwork and their
000000r 2               ;   colours are the artist's to choose.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               
000000r 2               ;   256 bytes, indexed by tile number. Render is:
000000r 2               ;       SCREEN,x = tile   /   COLRAM,x = TileColor,tile
000000r 2               ;   C64: all 16 colours available. Groups 0-15 match the VIC-20
000000r 2               ;   table except where the VIC has no equivalent (gray).
000000r 2               
000000r 2               TileColorC64:
000000r 2  01 01 01 01    .res 8, $01                      ; tiles   0-7    group 0  UI / well frame        white
000004r 2  01 01 01 01  
000008r 2  0F 0F 0F 0F    .res 8, $0F                      ; tiles   8-15   group 1  UI accents             gray
00000Cr 2  0F 0F 0F 0F  
000010r 2  01 01 01 01    .res 8, $01                      ; tiles  16-23   group 2  Font  0 1 2 3 4 5 6 7  white
000014r 2  01 01 01 01  
000018r 2  01 01 01 01    .res 8, $01                      ; tiles  24-31   group 3  Font  8 9 A B C D E F  white
00001Cr 2  01 01 01 01  
000020r 2  01 01 01 01    .res 8, $01                      ; tiles  32-39   group 4  Font  G H I J K L M N  white
000024r 2  01 01 01 01  
000028r 2  01 01 01 01    .res 8, $01                      ; tiles  40-47   group 5  Font  O P Q R S T U V  white
00002Cr 2  01 01 01 01  
000030r 2  01 01 01 01    .res 8, $01                      ; tiles  48-55   group 6  Font  W X Y Z . x ! -  white
000034r 2  01 01 01 01  
000038r 2  01 01 01 01    .res 8, $01                      ; tiles  56-63   group 7  VFX                    white
00003Cr 2  01 01 01 01  
000040r 2  02 02 02 02    .res 8, $02                      ; tiles  64-71   group 8  POTION 0  RED
000044r 2  02 02 02 02  
000048r 2  07 07 07 07    .res 8, $07                      ; tiles  72-79   group 9  POTION 1  YELLOW
00004Cr 2  07 07 07 07  
000050r 2  05 05 05 05    .res 8, $05                      ; tiles  80-87   group 10 POTION 2  GREEN
000054r 2  05 05 05 05  
000058r 2  03 03 03 03    .res 8, $03                      ; tiles  88-95   group 11 POTION 3  CYAN
00005Cr 2  03 03 03 03  
000060r 2  06 06 06 06    .res 8, $06                      ; tiles  96-103  group 12 POTION 4  BLUE
000064r 2  06 06 06 06  
000068r 2  04 04 04 04    .res 8, $04                      ; tiles 104-111  group 13 POTION 5  PURPLE
00006Cr 2  04 04 04 04  
000070r 2  01 01 01 01    .res 8, $01                      ; tiles 112-119  group 14 POTION 6  WILD / prism white
000074r 2  01 01 01 01  
000078r 2  02 02 02 02    .res 8, $02                      ; tiles 120-127  group 15 Wall / stone           red
00007Cr 2  02 02 02 02  
000080r 2  0F 0F 0F 0F    .res 8, $0F                      ; tiles 128-135  group 16 artwork
000084r 2  0F 0F 0F 0F  
000088r 2  09 09 09 09    .res 8, $09                      ; tiles 136-143  group 17 artwork
00008Cr 2  09 09 09 09  
000090r 2  0C 0C 0C 0C    .res 8, $0C                      ; tiles 144-151  group 18 artwork
000094r 2  0C 0C 0C 0C  
000098r 2  08 08 08 08    .res 8, $08                      ; tiles 152-159  group 19 artwork
00009Cr 2  08 08 08 08  
0000A0r 2  0B 0B 0B 0B    .res 8, $0B                      ; tiles 160-167  group 20 artwork
0000A4r 2  0B 0B 0B 0B  
0000A8r 2  0D 0D 0D 0D    .res 8, $0D                      ; tiles 168-175  group 21 artwork
0000ACr 2  0D 0D 0D 0D  
0000B0r 2  0A 0A 0A 0A    .res 8, $0A                      ; tiles 176-183  group 22 artwork
0000B4r 2  0A 0A 0A 0A  
0000B8r 2  03 03 03 03    .res 8, $03                      ; tiles 184-191  group 23 artwork
0000BCr 2  03 03 03 03  
0000C0r 2  07 07 07 07    .res 8, $07                      ; tiles 192-199  group 24 artwork
0000C4r 2  07 07 07 07  
0000C8r 2  0E 0E 0E 0E    .res 8, $0E                      ; tiles 200-207  group 25 artwork
0000CCr 2  0E 0E 0E 0E  
0000D0r 2  04 04 04 04    .res 8, $04                      ; tiles 208-215  group 26 artwork
0000D4r 2  04 04 04 04  
0000D8r 2  05 05 05 05    .res 8, $05                      ; tiles 216-223  group 27 artwork
0000DCr 2  05 05 05 05  
0000E0r 2  02 02 02 02    .res 8, $02                      ; tiles 224-231  group 28 artwork
0000E4r 2  02 02 02 02  
0000E8r 2  01 01 01 01    .res 8, $01                      ; tiles 232-239  group 29 artwork
0000ECr 2  01 01 01 01  
0000F0r 2  0F 0F 0F 0F    .res 8, $0F                      ; tiles 240-247  group 30 artwork
