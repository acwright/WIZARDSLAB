000156r 1               .include "../src/tables.inc"
000156r 2               ; =============================================================================
000156r 2               ;   tables.inc — Wizards Lab, spec-derived lookup tables
000156r 2               ; =============================================================================
000156r 2               ;   Straight out of SPEC.md sections 5.3, 9, 10, 14 and 16. Hand-authored,
000156r 2               ;   never overwritten by an editor export. Included once, from the RODATA
000156r 2               ;   segment.
000156r 2               ;
000156r 2               ;   Score values above 99 do not fit in a byte, so every scoring table is a
000156r 2               ;   pair of parallel arrays — low BCD byte and high BCD byte — indexed by the
000156r 2               ;   same value.
000156r 2               ; =============================================================================
000156r 2               
000156r 2               ; --- Gravity, frames per row (SPEC 10.2) -------------------------------------
000156r 2               ;   Indexed by (level - 1), clamped to LEVEL_SPEED_CAP - 1.
000156r 2               ;   PAL is round(NTSC * 50/60), so wall-clock speed matches across regions.
000156r 2               
000156r 2               SpeedNTSC:
000156r 2  30 2B 26 22    .byte  48, 43, 38, 34, 30, 26, 23, 20   ; levels  1- 8   0.800s .. 0.333s
00015Ar 2  1E 1A 17 14  
00015Er 2  11 0F 0D 0B    .byte  17, 15, 13, 11,  9,  8,  7,  6   ; levels  9-16   0.283s .. 0.100s
000162r 2  09 08 07 06  
000166r 2               
000166r 2               SpeedPAL:
000166r 2  28 24 20 1C    .byte  40, 36, 32, 28, 25, 22, 19, 17   ; levels  1- 8   0.800s .. 0.340s
00016Ar 2  19 16 13 11  
00016Er 2  0E 0D 0B 09    .byte  14, 13, 11,  9,  8,  7,  6,  5   ; levels  9-16   0.280s .. 0.100s
000172r 2  08 07 06 05  
000176r 2               
000176r 2               ; --- Frame counts that differ by region (SPEC 5.6, 11.3, 14) -----------------
000176r 2               ;   Indexed by Region: 0 = NTSC, 1 = PAL. PAL is round(NTSC * 50/60) wherever
000176r 2               ;   the difference is worth a frame, so a piece takes the same number of
000176r 2               ;   SECONDS to lock on both machines rather than the same number of frames.
000176r 2               ;
000176r 2               ;   Two bytes each rather than one table of pairs, because every read is
000176r 2               ;   `ldx Region / lda Name,x` and a pair table would need the index doubled.
000176r 2               
000176r 2               LockDelay:                              ; SPEC 5.6
000176r 2  10 0E          .byte 16, 14
000178r 2               AreDelay:                               ; Entry delay after a cascade settles
000178r 2  0C 0A          .byte 12, 10
00017Ar 2               DasInitial:                             ; SPEC 11.3 — first repeat
00017Ar 2  0C 0A          .byte 12, 10
00017Cr 2               DasRepeat:                              ; ...and every one after it
00017Cr 2  04 03          .byte  4,  3
00017Er 2               SoftDropRate:                           ; Frames per row while DOWN is held.
00017Er 2  03 02          .byte  3,  2                          ;   Never used when gravity is faster.
000180r 2               BlinkHalf:                              ; SPEC 14 — half of the 30 / 25 frame
000180r 2  0F 0D          .byte 15, 13                          ;   blink period, which is what a
000182r 2                                                       ;   blinking field actually counts
000182r 2               GlowFrames:                             ; SPEC 14 — the GLOW window: the match
000182r 2  06 05          .byte  6,  5                          ;   glow and the bolt's beams
000184r 2               FlashFrames:                            ; ...and what the window grows to when
000184r 2  08 07          .byte  8,  7                          ;   a fireball fired, because its flash
000186r 2                                                       ;   is the longer of the two and both
000186r 2                                                       ;   are showing at once (constants.inc)
000186r 2               BannerFrames:                           ; SPEC 14 — how long LEVEL UP and
000186r 2  2D 26          .byte 45, 38                          ;   CHAIN xN stay in the message band
000188r 2               SecondFrames:                           ; One second, which is the unit the
000188r 2  3C 32          .byte 60, 50                          ;   game-over timeout is counted in
00018Ar 2                                                       ;   (SPEC 13.4). The only entry here
00018Ar 2                                                       ;   that is not a duration out of
00018Ar 2                                                       ;   SPEC 14 but the frame rate itself
00018Ar 2               
00018Ar 2               ; --- The two removal animations (SPEC 14, Appendix A.3) ----------------------
00018Ar 2               ;   One ring, run in both directions. Indexed by AnimStep, which advances every
00018Ar 2               ;   VFX_FRAMES frames.
00018Ar 2               ;
00018Ar 2               ;   Potions, reagents, the bomb blast and the star all open OUTWARD and are
00018Ar 2               ;   gone in SHATTER_STEPS frames; the fourth entry only ever comes up when a
00018Ar 2               ;   marked prism is blipping out beside them and holding the window open, and
00018Ar 2               ;   it blanks the cell rather than leaving the last ring frame sitting there
00018Ar 2               ;   for four more frames.
00018Ar 2               
00018Ar 2               VfxShatter:
00018Ar 2  38 39 3A 00    .byte VFX_REMOVE1, VFX_REMOVE2, VFX_REMOVE3, TILE_EMPTY
00018Er 2               
00018Er 2               ;   The prism closes INWARD, and does not pass through the glow (SPEC A.3 —
00018Er 2               ;   group 14 has no glyph +6). Five frames, so a step that clears one runs
00018Er 2               ;   BLIP_STEPS rather than SHATTER_STEPS.
00018Er 2               
00018Er 2               VfxBlip:
00018Er 2  74 75 39 38    .byte PRISM_BLIP, PRISM_BLIP + 1, VFX_REMOVE2, VFX_REMOVE1, FONT_DOT
000192r 2  34           
000193r 2               
000193r 2               ; --- Per-tile value for MATCH removals (SPEC 9.1) ----------------------------
000193r 2               ;   Indexed by (chain - 1), clamped to 7.   20 50 100 200 300 400 500 600
000193r 2               TileValueLo:
000193r 2  20 50 00 00    .byte $20, $50, $00, $00, $00, $00, $00, $00
000197r 2  00 00 00 00  
00019Br 2               TileValueHi:
00019Br 2  00 00 01 02    .byte $00, $00, $01, $02, $03, $04, $05, $06
00019Fr 2  03 04 05 06  
0001A3r 2               
0001A3r 2               ; --- Per-tile value for EFFECT removals (SPEC 9.2) ---------------------------
0001A3r 2               ;   Indexed by (chain - 1), clamped to 7.   30 60 120 240 350 450 550 650
0001A3r 2               EffectValueLo:
0001A3r 2  30 60 20 40    .byte $30, $60, $20, $40, $50, $50, $50, $50
0001A7r 2  50 50 50 50  
0001ABr 2               EffectValueHi:
0001ABr 2  00 00 01 02    .byte $00, $00, $01, $02, $03, $04, $05, $06
0001AFr 2  03 04 05 06  
0001B3r 2               
0001B3r 2               ; --- Run length bonus (SPEC 9.3) ---------------------------------------------
0001B3r 2               ;   Indexed by (length - 3), clamped to 4.  0 100 300 600 1000
0001B3r 2               LengthBonusLo:
0001B3r 2  00 00 00 00    .byte $00, $00, $00, $00, $00
0001B7r 2  00           
0001B8r 2               LengthBonusHi:
0001B8r 2  00 01 03 06    .byte $00, $01, $03, $06, $10
0001BCr 2  10           
0001BDr 2               
0001BDr 2               ; --- Simultaneous run bonus (SPEC 9.4) ---------------------------------------
0001BDr 2               ;   Indexed by (runs - 1), clamped to 4.    0 200 500 1000 2000
0001BDr 2               MultiBonusLo:
0001BDr 2  00 00 00 00    .byte $00, $00, $00, $00, $00
0001C1r 2  00           
0001C2r 2               MultiBonusHi:
0001C2r 2  00 02 05 10    .byte $00, $02, $05, $10, $20
0001C6r 2  20           
0001C7r 2               
0001C7r 2               ; --- Level -> reagent probability band (SPEC 5.3) ----------------------------
0001C7r 2               ;   Indexed by (level - 1), clamped to 15. Bands are 1-3, 4-6, 7-9, 10-12, 13+.
0001C7r 2               LevelBand:
0001C7r 2  00 00 00 01    .byte 0, 0, 0, 1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 4
0001CBr 2  01 01 02 02  
0001CFr 2  02 03 03 03  
0001D7r 2               
0001D7r 2               ; --- Chance a piece carries a reagent, out of 256 (SPEC 5.3) -----------------
0001D7r 2               ;   Indexed by band.                        15%  22%  27%  32%  36%
0001D7r 2               PSpecial:
0001D7r 2  26 38 45 52    .byte  38,  56,  69,  82,  92
0001DBr 2  5C           
0001DCr 2               
0001DCr 2               ; --- Reagent type, cumulative thresholds out of 256 (SPEC 5.3) ---------------
0001DCr 2               ;   Four thresholds per band; a roll at or above the last one is a Prism.
0001DCr 2               ;       roll <  [0] -> Fireball
0001DCr 2               ;       roll <  [1] -> Bolt
0001DCr 2               ;       roll <  [2] -> Bomb
0001DCr 2               ;       roll <  [3] -> Star
0001DCr 2               ;       else        -> Prism
0001DCr 2               ReagentThresholds:
0001DCr 2  4D 8A C3 EC    .byte  77, 138, 195, 236             ; band 0   levels  1-3
0001E0r 2  4D 8D C0 EE    .byte  77, 141, 192, 238             ; band 1   levels  4-6
0001E4r 2  52 92 C5 EE    .byte  82, 146, 197, 238             ; band 2   levels  7-9
0001E8r 2  4F 8D C3 EE    .byte  79, 141, 195, 238             ; band 3   levels 10-12
0001ECr 2  4F 8F C7 F0    .byte  79, 143, 199, 240             ; band 4   levels 13+
0001F0r 2               
0001F0r 2               ; --- Reagent trigger bonuses, indexed by glyph (SPEC 9.5) --------------------
0001F0r 2               ;   Glyph 0 potion and 4 star award nothing here (the star multiplies instead).
0001F0r 2               TriggerBonusLo:
0001F0r 2  00 00 00 00    .byte $00, $00, $00, $00, $00, $00, $00, $00
0001F4r 2  00 00 00 00  
0001F8r 2               TriggerBonusHi:
0001F8r 2  00 05 03 03    .byte $00, $05, $03, $03, $00, $00, $00, $00
0001FCr 2  00 00 00 00  
000200r 2               
000200r 2               ; --- The twelve sound effects (SPEC 16) --------------------------------------
000200r 2               ;   An effect is a list of STEPS and a step is three bytes: how many FRAMES it
000200r 2               ;   lasts, its TIMBRE, and its NOTE in semitones above C3 (constants.inc). A
000200r 2               ;   zero frame count ends the list. Nothing here is a register value: a note
000200r 2               ;   means the same pitch on both sound chips and each platform turns it into
000200r 2               ;   whatever its own hardware wants (audio.asm, hal.inc).
000200r 2               ;
000200r 2               ;   SPEC 16 gives each effect a CHARACTER and not a tune — "short blip",
000200r 2               ;   "dull thunk", "descending noise sweep" — and the notes below are the
000200r 2               ;   reading of it. What is not a choice is the range: the VIC-I's oscillator
000200r 2               ;   value runs out of resolution above C5, where consecutive semitones start
000200r 2               ;   landing on the same number, so everything melodic is WRITTEN inside C3-C5
000200r 2               ;   and lifted by its timbre instead. TIMBRE_BRIGHT is already an octave up.
000200r 2               ;
000200r 2               ;   SfxStepIdx is a byte offset into SfxSteps, so this table has to stay under
000200r 2               ;   256 bytes. It is 144.
000200r 2               
000200r 2               SfxOffsets:                             ; Indexed by (SFX_* id - 1)
000200r 2  00             .byte SfxMove     - SfxSteps
000201r 2  04             .byte SfxRotate   - SfxSteps
000202r 2  0B             .byte SfxLock     - SfxSteps
000203r 2  12             .byte SfxMatch    - SfxSteps
000204r 2  19             .byte SfxFireball - SfxSteps
000205r 2  29             .byte SfxBolt     - SfxSteps
000206r 2  2D             .byte SfxBomb     - SfxSteps
000207r 2  34             .byte SfxStar     - SfxSteps
000208r 2  41             .byte SfxPrism    - SfxSteps
000209r 2  54             .byte SfxLevelUp  - SfxSteps
00020Ar 2  61             .byte SfxHighScore- SfxSteps
00020Br 2  77             .byte SfxGameOver - SfxSteps
00020Cr 2               
00020Cr 2               SfxSteps:
00020Cr 2               
00020Cr 2               SfxMove:                                ; 1 — short blip                2 frames
00020Cr 2  02 03 13       .byte  2, TIMBRE_BRIGHT, OCT_4 + SEMI_G
00020Fr 2  00             .byte  0
000210r 2               
000210r 2               SfxRotate:                              ; 2 — rising two-step           6 frames
000210r 2  03 03 0C       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_C
000213r 2  03 03 13       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_G
000216r 2  00             .byte  0
000217r 2               
000217r 2               SfxLock:                                ; 3 — dull thunk                6 frames
000217r 2  02 04 0C       .byte  2, TIMBRE_NOISE,  OCT_4 + SEMI_C
00021Ar 2  04 01 0C       .byte  4, TIMBRE_SOFT,   OCT_4 + SEMI_C
00021Dr 2  00             .byte  0
00021Er 2               
00021Er 2               SfxMatch:                               ; 4 — bright chime              9 frames
00021Er 2  03 03 0C       .byte  3, TIMBRE_BRIGHT, OCT_4 + SEMI_C   ; ...and the whole thing is
000221r 2  06 03 10       .byte  6, TIMBRE_BRIGHT, OCT_4 + SEMI_E   ;   transposed up by the chain
000224r 2  00             .byte  0                                  ;   (SPEC 16, audio.asm)
000225r 2               
000225r 2               SfxFireball:                            ; 5 — descending noise sweep   10 frames
000225r 2  02 04 24       .byte  2, TIMBRE_NOISE,  OCT_6 + SEMI_C
000228r 2  02 04 1F       .byte  2, TIMBRE_NOISE,  OCT_5 + SEMI_G
00022Br 2  02 04 1A       .byte  2, TIMBRE_NOISE,  OCT_5 + SEMI_D
00022Er 2  02 04 15       .byte  2, TIMBRE_NOISE,  OCT_4 + SEMI_A
000231r 2  02 04 10       .byte  2, TIMBRE_NOISE,  OCT_4 + SEMI_E
000234r 2  00             .byte  0
000235r 2               
000235r 2               SfxBolt:                                ; 6 — fast noise crack          3 frames
000235r 2  03 04 21       .byte  3, TIMBRE_NOISE,  OCT_5 + SEMI_A
000238r 2  00             .byte  0
000239r 2               
000239r 2               SfxBomb:                                ; 7 — low noise thump          10 frames
000239r 2  02 04 0E       .byte  2, TIMBRE_NOISE,  OCT_4 + SEMI_D
00023Cr 2  08 04 04       .byte  8, TIMBRE_NOISE,  OCT_3 + SEMI_E
00023Fr 2  00             .byte  0
000240r 2               
000240r 2               SfxStar:                                ; 8 — sparkle arpeggio          8 frames
000240r 2  02 03 0C       .byte  2, TIMBRE_BRIGHT, OCT_4 + SEMI_C
000243r 2  02 03 10       .byte  2, TIMBRE_BRIGHT, OCT_4 + SEMI_E
000246r 2  02 03 13       .byte  2, TIMBRE_BRIGHT, OCT_4 + SEMI_G
000249r 2  02 03 18       .byte  2, TIMBRE_BRIGHT, OCT_5 + SEMI_C
00024Cr 2  00             .byte  0
00024Dr 2               
00024Dr 2               SfxPrism:                               ; 9 — shimmer                  12 frames
00024Dr 2  02 02 18       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_C   ; The one effect that wants an edge
000250r 2  02 02 1C       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_E   ;   to it rather than a bell: a
000253r 2  02 02 18       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_C   ;   sawtooth beating between two
000256r 2  02 02 1C       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_E   ;   notes six times in a fifth of
000259r 2  02 02 18       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_C   ;   a second
00025Cr 2  02 02 1C       .byte  2, TIMBRE_BUZZ,   OCT_5 + SEMI_E
00025Fr 2  00             .byte  0
000260r 2               
000260r 2               SfxLevelUp:                             ; 10 — fanfare                 25 frames
000260r 2  05 03 0C       .byte  5, TIMBRE_BRIGHT, OCT_4 + SEMI_C
000263r 2  05 03 10       .byte  5, TIMBRE_BRIGHT, OCT_4 + SEMI_E
000266r 2  05 03 13       .byte  5, TIMBRE_BRIGHT, OCT_4 + SEMI_G
000269r 2  0A 03 18       .byte 10, TIMBRE_BRIGHT, OCT_5 + SEMI_C
00026Cr 2  00             .byte  0
00026Dr 2               
00026Dr 2               SfxHighScore:                           ; 11 — longer fanfare          40 frames
00026Dr 2  04 03 0C       .byte  4, TIMBRE_BRIGHT, OCT_4 + SEMI_C
000270r 2  04 03 10       .byte  4, TIMBRE_BRIGHT, OCT_4 + SEMI_E
000273r 2  04 03 13       .byte  4, TIMBRE_BRIGHT, OCT_4 + SEMI_G
000276r 2  04 03 18       .byte  4, TIMBRE_BRIGHT, OCT_5 + SEMI_C
000279r 2  04 03 13       .byte  4, TIMBRE_BRIGHT, OCT_4 + SEMI_G
00027Cr 2  04 03 18       .byte  4, TIMBRE_BRIGHT, OCT_5 + SEMI_C
00027Fr 2  10 03 1C       .byte 16, TIMBRE_BRIGHT, OCT_5 + SEMI_E
000282r 2  00             .byte  0
000283r 2               
000283r 2               SfxGameOver:                            ; 12 — descending minor run    58 frames
000283r 2  06 01 15       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_A
000286r 2  06 01 13       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_G
000289r 2  06 01 11       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_F
00028Cr 2  06 01 10       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_E
00028Fr 2  06 01 0E       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_D
000292r 2  06 01 0C       .byte  6, TIMBRE_SOFT,   OCT_4 + SEMI_C
000295r 2  06 01 0B       .byte  6, TIMBRE_SOFT,   OCT_3 + SEMI_B
000298r 2  10 01 09       .byte 16, TIMBRE_SOFT,   OCT_3 + SEMI_A
00029Br 2  00             .byte  0
00029Cr 2               
00029Cr 1               .include "../src/strings.inc"
00029Cr 2               ; =============================================================================
00029Cr 2               ;   strings.inc — Wizards Lab, tile-encoded text
00029Cr 2               ; =============================================================================
00029Cr 2               ;   Strings are stored as TILE numbers, not ASCII, terminated by TEXT_END, so
00029Cr 2               ;   TextDraw is a copy with no translation at run time (see text.asm). The
00029Cr 2               ;   translation happens here instead, at assembly time, in TileStr.
00029Cr 2               ;
00029Cr 2               ;   Hand-authored, never overwritten by an editor export (D3). Included once,
00029Cr 2               ;   from each platform's RODATA segment.
00029Cr 2               ; =============================================================================
00029Cr 2               
00029Cr 2               ; -----------------------------------------------------------------------------
00029Cr 2               ;   TileChar / TileStr — ASCII source, tile bytes out
00029Cr 2               ;   The font is forty glyphs in one run from FONT_BASE:
00029Cr 2               ;       0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ . x ! ~
00029Cr 2               ;   and a space is TILE_BLANK. Anything else is not in the tileset and is an
00029Cr 2               ;   assembly error rather than a wrong glyph on the screen.
00029Cr 2               ; -----------------------------------------------------------------------------
00029Cr 2               .macro TileChar c
00029Cr 2                 .if c = ' '
00029Cr 2                   .byte TILE_BLANK
00029Cr 2                 .elseif (c >= '0') .and (c <= '9')
00029Cr 2                   .byte FONT_DIGIT_0 + (c - '0')
00029Cr 2                 .elseif (c >= 'A') .and (c <= 'Z')
00029Cr 2                   .byte FONT_LETTER_A + (c - 'A')
00029Cr 2                 .elseif c = '.'
00029Cr 2                   .byte FONT_DOT
00029Cr 2                 .elseif c = 'x'
00029Cr 2                   .byte FONT_TIMES
00029Cr 2                 .elseif c = '!'
00029Cr 2                   .byte FONT_BANG
00029Cr 2                 .elseif c = '~'
00029Cr 2                   .byte FONT_TILDE
00029Cr 2                 .else
00029Cr 2                   .error "strings.inc: no tile for this character"
00029Cr 2                 .endif
00029Cr 2               .endmacro
00029Cr 2               
00029Cr 2               .macro TileStr s
00029Cr 2                 .repeat .strlen(s), I
00029Cr 2                   TileChar {.strat(s, I)}
00029Cr 2                 .endrepeat
00029Cr 2                 .byte TEXT_END
00029Cr 2               .endmacro
00029Cr 2               
00029Cr 2               ; -----------------------------------------------------------------------------
00029Cr 2               ;   Banners — SPEC 12.2, 13.3
00029Cr 2               ;   Even length, so (PANEL_W - length) / 2 centres exactly. The band is 18
00029Cr 2               ;   cells of backdrop between two shelf tiles either side, so a banner has 18
00029Cr 2               ;   to play with before it starts overwriting the artwork.
00029Cr 2               ;
00029Cr 2               ;   MsgPaused matches the play screen image byte for byte on purpose: the
00029Cr 2               ;   artwork ships with the band already reading `~~ PAUSED ~~` (see SPEC 12.1),
00029Cr 2               ;   so entering play clears the band and pausing draws this straight back.
00029Cr 2               ; -----------------------------------------------------------------------------
00029Cr 2               MsgPaused:
00029Cr 2  37 37 00 29    TileStr "~~ PAUSED ~~"                 ; 12 cells, centres at panel column 5
0002A0r 2  1A 2E 2C 1E  
0002A4r 2  1D 00 37 37  
0002A9r 2               
0002A9r 2               MsgLevelUp:
0002A9r 2  37 37 00 25    TileStr "~~ LEVEL UP ~~"               ; 14 cells, centres at panel column 4
0002ADr 2  1E 2F 1E 25  
0002B1r 2  00 2E 29 00  
0002B8r 2               
0002B8r 2               ; `GAME OVER` is nine characters, so a symmetric ornament around it is always
0002B8r 2               ; an ODD length and would sit half a cell left of centre. The bang makes it
0002B8r 2               ; even and is the reason it is there; SPEC 13.4 records the wording.
0002B8r 2               MsgGameOver:
0002B8r 2  37 37 00 20    TileStr "~~ GAME OVER! ~~"             ; 16 cells, centres at panel column 3
0002BCr 2  1A 26 1E 00  
0002C0r 2  28 2F 1E 2B  
0002C9r 2               
0002C9r 2               ; The chain banner carries a number, and TextDraw copies bytes rather than
0002C9r 2               ; formatting them, so the digit is a placeholder that CascadeSettle overwrites
0002C9r 2               ; with one RenderMark at CHAIN_DIGIT_X (constants.inc). Keeping the length at
0002C9r 2               ; MSG_CHAIN_LEN is what makes that column a constant instead of a measurement.
0002C9r 2               MsgChain:
0002C9r 2  37 37 00 1C    TileStr "~~ CHAIN x0 ~~"               ; 14 cells; the `0` is panel column 14
0002CDr 2  21 1A 22 27  
0002D1r 2  00 35 10 00  
0002D8r 2               
0002D8r 2               ; -----------------------------------------------------------------------------
0002D8r 2               ;   The title screen's prompt (SPEC 13.1)
0002D8r 2               ;   Not a banner: it is ten cells of the DRAWN title image, and the only reason
0002D8r 2               ;   the string exists at all is that blinking it means putting it back. It must
0002D8r 2               ;   match data/screen-title-*.bin at PROMPT_X, PROMPT_Y byte for byte, or the
0002D8r 2               ;   first blink would redraw the screen slightly differently from the way the
0002D8r 2               ;   artist drew it.
0002D8r 2               ; -----------------------------------------------------------------------------
0002D8r 2               MsgPressFire:
0002D8r 2  29 2B 1E 2C    TileStr "PRESS FIRE"                   ; PROMPT_LEN cells (constants.inc)
0002DCr 2  2C 00 1F 22  
0002E0r 2  2B 1E FF     
0002E3r 2               
0002E3r 1               
0002E3r 1               ; --- Screen row start addresses ----------------------------------------------
0002E3r 1               RowLo:
0002E3r 1  00 28 50 78    .repeat SCR_ROWS, i
0002E7r 1  A0 C8 F0 18  
0002EBr 1  40 68 90 B8  
0002FCr 1                   .byte <(SCREEN + i * SCR_COLS)
0002FCr 1                 .endrepeat
0002FCr 1               RowHi:
0002FCr 1  04 04 04 04    .repeat SCR_ROWS, i
000300r 1  04 04 04 05  
000304r 1  05 05 05 05  
000315r 1                   .byte >(SCREEN + i * SCR_COLS)
000315r 1                 .endrepeat
000315r 1               
000315r 1               .segment "TILES"
000000r 1               
000000r 1               ; --- PLACEHOLDER ART — see data/README.md ------------------------------------
000000r 1  00 00 00 00  Tileset:      .incbin "../data/tileset.bin"
000004r 1  00 00 00 00  
000008r 1  00 00 7E AB  
000800r 1  00 00 00 00  TitleScreen:  .incbin "../data/screen-title-c64.bin"
000804r 1  00 00 00 00  
000808r 1  00 00 00 00  
000BE8r 1  01 01 01 01  TitleColor:   .incbin "../data/screen-title-c64-color.bin"
000BECr 1  01 01 01 01  
000BF0r 1  01 01 01 01  
000FD0r 1  7F 7F 7F 7F  PlayScreen:   .incbin "../data/screen-play-c64.bin"
000FD4r 1  7F 7F 7F 7F  
000FD8r 1  7F 7E 7E 7E  
0013B8r 1  02 02 02 02  PlayColor:    .incbin "../data/screen-play-c64-color.bin"
0013BCr 1  02 02 02 02  
0013C0r 1  02 02 02 02  
0013B8r 1               
