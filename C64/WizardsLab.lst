0001B7r 2  00           
0001B8r 2               LengthBonusHi:
0001B8r 2  00 01 03 06    .byte $00, $01, $03, $06, $10
0001BCr 2  10           
0001BDr 2               
0001BDr 2               ; --- Simultaneous run bonus (SPEC 9.4) ---------------------------------------
0001BDr 2               ;   Indexed by (runs - 1), clamped to 4.    0 200 500 1000 2000
0001BDr 2               MultiBonusLo:
0001BDr 2  00 00 00 00    .byte $00, $00, $00, $00, $00
0001C1r 2  00           
0001C2r 2               MultiBonusHi:
0001C2r 2  00 02 05 10    .byte $00, $02, $05, $10, $20
0001C6r 2  20           
0001C7r 2               
0001C7r 2               ; --- Level -> reagent probability band (SPEC 5.3) ----------------------------
0001C7r 2               ;   Indexed by (level - 1), clamped to 15. Bands are 1-3, 4-6, 7-9, 10-12, 13+.
0001C7r 2               LevelBand:
0001C7r 2  00 00 00 01    .byte 0, 0, 0, 1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 4
0001CBr 2  01 01 02 02  
0001CFr 2  02 03 03 03  
