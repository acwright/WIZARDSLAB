000156r 2               
000156r 1               .include "../src/tables.inc"
000156r 2               ; =============================================================================
000156r 2               ;   tables.inc — Wizards Lab, spec-derived lookup tables
000156r 2               ; =============================================================================
000156r 2               ;   Straight out of SPEC.md sections 5.3, 9, 10, 14 and 16. Hand-authored,
000156r 2               ;   never overwritten by an editor export. Included once, from the RODATA
000156r 2               ;   segment.
000156r 2               ;
000156r 2               ;   Score values above 99 do not fit in a byte, so every scoring table is a
000156r 2               ;   pair of parallel arrays — low BCD byte and high BCD byte — indexed by the
000156r 2               ;   same value.
000156r 2               ; =============================================================================
000156r 2               
000156r 2               ; --- Gravity, frames per row (SPEC 10.2) -------------------------------------
000156r 2               ;   Indexed by (level - 1), clamped to LEVEL_SPEED_CAP - 1.
000156r 2               ;   PAL is round(NTSC * 50/60), so wall-clock speed matches across regions.
000156r 2               
000156r 2               SpeedNTSC:
000156r 2  30 2B 26 22    .byte  48, 43, 38, 34, 30, 26, 23, 20   ; levels  1- 8   0.800s .. 0.333s
00015Ar 2  1E 1A 17 14  
00015Er 2  11 0F 0D 0B    .byte  17, 15, 13, 11,  9,  8,  7,  6   ; levels  9-16   0.283s .. 0.100s
000162r 2  09 08 07 06  
000166r 2               
000166r 2               SpeedPAL:
000166r 2  28 24 20 1C    .byte  40, 36, 32, 28, 25, 22, 19, 17   ; levels  1- 8   0.800s .. 0.340s
00016Ar 2  19 16 13 11  
00016Er 2  0E 0D 0B 09    .byte  14, 13, 11,  9,  8,  7,  6,  5   ; levels  9-16   0.280s .. 0.100s
000172r 2  08 07 06 05  
000176r 2               
000176r 2               ; --- Frame counts that differ by region (SPEC 5.6, 11.3, 14) -----------------
000176r 2               ;   Indexed by Region: 0 = NTSC, 1 = PAL. PAL is round(NTSC * 50/60) wherever
000176r 2               ;   the difference is worth a frame, so a piece takes the same number of
000176r 2               ;   SECONDS to lock on both machines rather than the same number of frames.
000176r 2               ;
000176r 2               ;   Two bytes each rather than one table of pairs, because every read is
000176r 2               ;   `ldx Region / lda Name,x` and a pair table would need the index doubled.
000176r 2               
000176r 2               LockDelay:                              ; SPEC 5.6
000176r 2  10 0E          .byte 16, 14
000178r 2               AreDelay:                               ; Entry delay after a cascade settles
000178r 2  0C 0A          .byte 12, 10
00017Ar 2               DasInitial:                             ; SPEC 11.3 — first repeat
00017Ar 2  0C 0A          .byte 12, 10
00017Cr 2               DasRepeat:                              ; ...and every one after it
00017Cr 2  04 03          .byte  4,  3
00017Er 2               SoftDropRate:                           ; Frames per row while DOWN is held.
00017Er 2  03 02          .byte  3,  2                          ;   Never used when gravity is faster.
000180r 2               BlinkHalf:                              ; SPEC 14 — half of the 30 / 25 frame
000180r 2  0F 0D          .byte 15, 13                          ;   blink period, which is what a
000182r 2                                                       ;   blinking field actually counts
000182r 2               GlowFrames:                             ; SPEC 14 — the GLOW window: the match
000182r 2  06 05          .byte  6,  5                          ;   glow and the bolt's beams
000184r 2               FlashFrames:                            ; ...and what the window grows to when
000184r 2  08 07          .byte  8,  7                          ;   a fireball fired, because its flash
000186r 2                                                       ;   is the longer of the two and both
000186r 2                                                       ;   are showing at once (constants.inc)
000186r 2               BannerFrames:                           ; SPEC 14 — how long LEVEL UP and
000186r 2  2D 26          .byte 45, 38                          ;   CHAIN xN stay in the message band
000188r 2               SecondFrames:                           ; One second, which is the unit the
000188r 2  3C 32          .byte 60, 50                          ;   game-over timeout is counted in
00018Ar 2                                                       ;   (SPEC 13.4). The only entry here
00018Ar 2                                                       ;   that is not a duration out of
00018Ar 2                                                       ;   SPEC 14 but the frame rate itself
00018Ar 2               
00018Ar 2               ; --- The two removal animations (SPEC 14, Appendix A.3) ----------------------
00018Ar 2               ;   One ring, run in both directions. Indexed by AnimStep, which advances every
00018Ar 2               ;   VFX_FRAMES frames.
00018Ar 2               ;
00018Ar 2               ;   Potions, reagents, the bomb blast and the star all open OUTWARD and are
00018Ar 2               ;   gone in SHATTER_STEPS frames; the fourth entry only ever comes up when a
00018Ar 2               ;   marked prism is blipping out beside them and holding the window open, and
00018Ar 2               ;   it blanks the cell rather than leaving the last ring frame sitting there
00018Ar 2               ;   for four more frames.
00018Ar 2               
00018Ar 2               VfxShatter:
00018Ar 2  38 39 3A 00    .byte VFX_REMOVE1, VFX_REMOVE2, VFX_REMOVE3, TILE_EMPTY
00018Er 2               
00018Er 2               ;   The prism closes INWARD, and does not pass through the glow (SPEC A.3 —
00018Er 2               ;   group 14 has no glyph +6). Five frames, so a step that clears one runs
00018Er 2               ;   BLIP_STEPS rather than SHATTER_STEPS.
00018Er 2               
00018Er 2               VfxBlip:
00018Er 2  74 75 39 38    .byte PRISM_BLIP, PRISM_BLIP + 1, VFX_REMOVE2, VFX_REMOVE1, FONT_DOT
000192r 2  34           
000193r 2               
000193r 2               ; --- Per-tile value for MATCH removals (SPEC 9.1) ----------------------------
000193r 2               ;   Indexed by (chain - 1), clamped to 7.   20 50 100 200 300 400 500 600
000193r 2               TileValueLo:
000193r 2  20 50 00 00    .byte $20, $50, $00, $00, $00, $00, $00, $00
000197r 2  00 00 00 00  
00019Br 2               TileValueHi:
00019Br 2  00 00 01 02    .byte $00, $00, $01, $02, $03, $04, $05, $06
00019Fr 2  03 04 05 06  
